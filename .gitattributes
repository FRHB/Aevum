# 1. Force GitHub to recognize Blazor components as C# instead of HTML
*.razor linguist-language=C#

# 2. Hide static HTML files from the language statistics
*.html linguist-detectable=false

# 3. Mark CSS (like Tailwind outputs or Bootstrap) as generated/third-party
*.css linguist-vendored

# 4. Hide JavaScript dependencies and third-party libraries
*.js linguist-vendored
wwwroot/lib/** linguist-vendored

# 5. Ignore JSON config files (like appsettings.json or launchSettings.json)
*.json linguist-vendored

# Force all Blazor components to be counted as C#
*.razor linguist-language=C#
