@page "/customer/portal"
@using System.Globalization
@using AevumStudio.Models

<PageTitle>@GetHeaderTitle() · Aevum Studio</PageTitle>

<div class="dashboard-layout">

    @* ==================== A. SIDEBAR NAVIGATION (LEFT PANEL) ==================== *@
    <aside class="sidebar">
        <!-- Brand Header -->
        <div class="sidebar-header">
            <div class="brand-icon-box">
                <i class="bi bi-camera-reels-fill"></i>
            </div>
            <div class="brand-text-wrapper">
                <span class="brand-title">Aevum Studio</span>
            </div>
        </div>

        <!-- Navigation Group Links -->
        <div class="sidebar-nav-container">
            <!-- 1. MAIN -->
            <div class="nav-group-label">MAIN</div>
            <nav class="nav-group mb-3">
                <button class="@NavClass("dashboard")" @onclick='() => SetActiveTab("dashboard")'>
                    <span>Dashboard</span>
                </button>
            </nav>

            <!-- 2. SERVICES -->
            <div class="nav-group-label">SERVICES</div>
            <nav class="nav-group mb-3">
                <button class="@NavClass("svc-photography")" @onclick='() => SetActiveTab("svc-photography")'>
                    <span>Photography</span>
                </button>
                <button class="@NavClass("svc-videography")" @onclick='() => SetActiveTab("svc-videography")'>
                    <span>Videography</span>
                </button>
                <button class="@NavClass("svc-editing")" @onclick='() => SetActiveTab("svc-editing")'>
                    <span>Editing &amp; Post</span>
                </button>
            </nav>

            <!-- 3. MY ACTIVITY -->
            <div class="nav-group-label">MY ACTIVITY</div>
            <nav class="nav-group mb-3">
                <button class="@NavClass("bookings")" @onclick='() => SetActiveTab("bookings")'>
                    <span>My Bookings</span>
                    <span class="nav-badge">3</span>
                </button>
                <button class="@NavClass("gallery")" @onclick='() => SetActiveTab("gallery")'>
                    <span>Gallery &amp; Downloads</span>
                </button>
            </nav>

            <!-- 4. ACCOUNT -->
            <div class="nav-group-label">ACCOUNT</div>
            <nav class="nav-group">
                <button class="@NavClass("profile")" @onclick='() => SetActiveTab("profile")'>
                    <span>Profile Settings</span>
                </button>
            </nav>
        </div>

        <!-- User Profile Footer Block -->
        <div class="sidebar-footer">
            <div class="user-profile-box">
                <div class="avatar-circle">
                    @AvatarInitials
                </div>
                <div class="user-info-text overflow-hidden">
                    <div class="user-name text-truncate">@profile.DisplayName</div>
                    <div class="user-email text-truncate">@profile.Email</div>
                </div>
            </div>
        </div>
    </aside>

    @* ==================== MAIN CONTENT AREA ==================== *@
    <main class="main-wrapper">
        <!-- B. Top Header Bar -->
        <header class="top-header">
            <div class="header-text-group">
                <h1 class="header-title">@GetHeaderTitle()</h1>
                @if (activeTab == "profile")
                {
                    <div class="header-subtitle">
                        Manage your account information, role privileges, and security settings
                    </div>
                }
                else
                {
                    <div class="header-date">
                        @DateTime.Now.ToString("dddd, MMMM dd, yyyy", CultureInfo.InvariantCulture)
                    </div>
                }
            </div>
            @if (activeTab != "profile")
            {
                <div class="header-action-group">
                    <button class="btn btn-primary-cta" @onclick='() => SetActiveTab("svc-photography")'>
                        <i class="bi bi-plus-lg"></i>
                        <span>Book a Session</span>
                    </button>
                </div>
            }
        </header>

        <!-- Main Body -->
        <div class="content-body">
            @switch (activeTab)
            {
                case "dashboard":
                    @* ==================== C. METRIC STAT CARDS GRID ==================== *@
                    <section class="stat-cards-grid">
                        <div class="row g-3 g-xl-4">
                            <!-- Stat 1: Upcoming Bookings -->
                            <div class="col-12 col-sm-6 col-xl-3">
                                <div class="stat-card">
                                    <div class="stat-icon-wrapper stat-icon-blue">
                                        <i class="bi bi-calendar3"></i>
                                    </div>
                                    <div class="stat-content">
                                        <span class="stat-label">Upcoming Bookings</span>
                                        <span class="stat-number">@upcomingBookings.Count</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Stat 2: Albums Ready -->
                            <div class="col-12 col-sm-6 col-xl-3">
                                <div class="stat-card">
                                    <div class="stat-icon-wrapper stat-icon-purple">
                                        <i class="bi bi-camera"></i>
                                    </div>
                                    <div class="stat-content">
                                        <span class="stat-label">Albums Ready</span>
                                        <span class="stat-number">@albums.Count</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Stat 3: Pending Requests -->
                            <div class="col-12 col-sm-6 col-xl-3">
                                <div class="stat-card">
                                    <div class="stat-icon-wrapper stat-icon-amber">
                                        <i class="bi bi-clock-history"></i>
                                    </div>
                                    <div class="stat-content">
                                        <span class="stat-label">Pending Requests</span>
                                        <span class="stat-number">@bookings.Count(b => b.Status == BookingStatus.Pending)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Stat 4: Files to Download -->
                            <div class="col-12 col-sm-6 col-xl-3">
                                <div class="stat-card">
                                    <div class="stat-icon-wrapper stat-icon-indigo">
                                        <i class="bi bi-cloud-arrow-down"></i>
                                    </div>
                                    <div class="stat-content">
                                        <span class="stat-label">Files to Download</span>
                                        <span class="stat-number">@albums.Sum(a => a.FileCount)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    @* ==================== D. MAIN CONTENT SPLIT LAYOUT ==================== *@
                    <section class="content-split-section">
                        <div class="row g-4">
                            <!-- Left / Main Panel: Recent Bookings Table -->
                            <div class="col-12 col-xl-8">
                                <div class="dashboard-panel">
                                    <div class="panel-header">
                                        <div>
                                            <h2 class="panel-title">Recent Bookings</h2>
                                            <span class="panel-subtitle">Upcoming studio sessions and schedule status</span>
                                        </div>
                                        <button class="btn-panel-link" @onclick='() => SetActiveTab("bookings")'>
                                            <span>View All</span>
                                            <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>

                                    <div class="bookings-table-wrapper">
                                        <!-- Column Headers -->
                                        <div class="bookings-table-header">
                                            <div class="col-header-session">Client / Session</div>
                                            <div class="col-header-service">Service</div>
                                            <div class="col-header-date">Date &amp; Time</div>
                                            <div class="col-header-status text-end">Status</div>
                                        </div>

                                        <!-- Rows -->
                                        <div class="bookings-table-body">
                                            @if (upcomingBookings.Any())
                                            {
                                                @foreach (var b in upcomingBookings.Take(4))
                                                {
                                                    <BookingRow Item="b" />
                                                }
                                            }
                                            else
                                            {
                                                <div class="p-4 text-center text-muted">
                                                    <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>
                                                    No upcoming bookings scheduled.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Panel: Quick Actions & Recent Albums -->
                            <div class="col-12 col-xl-4 d-flex flex-column gap-4">
                                <!-- 1. Quick Actions Card List -->
                                <div class="dashboard-panel">
                                    <div class="panel-header mb-3">
                                        <div>
                                            <h2 class="panel-title">Quick Actions</h2>
                                            <span class="panel-subtitle">Studio shortcuts &amp; requests</span>
                                        </div>
                                    </div>
                                    <div class="quick-actions-list">
                                        <button class="quick-action-btn" @onclick='() => SetActiveTab("svc-photography")'>
                                            <div class="quick-action-left">
                                                <div class="quick-action-icon icon-blue">
                                                    <i class="bi bi-calendar-plus"></i>
                                                </div>
                                                <div class="quick-action-text">
                                                    <div class="quick-action-title">Book New Session</div>
                                                    <div class="quick-action-desc">Studio portrait, brand, or commercial</div>
                                                </div>
                                            </div>
                                            <i class="bi bi-chevron-right quick-action-arrow"></i>
                                        </button>

                                        <button class="quick-action-btn" @onclick='() => SetActiveTab("gallery")'>
                                            <div class="quick-action-left">
                                                <div class="quick-action-icon icon-purple">
                                                    <i class="bi bi-images"></i>
                                                </div>
                                                <div class="quick-action-text">
                                                    <div class="quick-action-title">Browse Galleries</div>
                                                    <div class="quick-action-desc">Download final high-resolution assets</div>
                                                </div>
                                            </div>
                                            <i class="bi bi-chevron-right quick-action-arrow"></i>
                                        </button>

                                        <button class="quick-action-btn" @onclick='() => SetActiveTab("profile")'>
                                            <div class="quick-action-left">
                                                <div class="quick-action-icon icon-amber">
                                                    <i class="bi bi-person-gear"></i>
                                                </div>
                                                <div class="quick-action-text">
                                                    <div class="quick-action-title">Account Preferences</div>
                                                    <div class="quick-action-desc">Manage notifications &amp; contact info</div>
                                                </div>
                                            </div>
                                            <i class="bi bi-chevron-right quick-action-arrow"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- 2. Recent Albums / Gallery Preview -->
                                <div class="dashboard-panel">
                                    <div class="panel-header mb-3">
                                        <div>
                                            <h2 class="panel-title">Recent Albums</h2>
                                            <span class="panel-subtitle">Delivered photography galleries</span>
                                        </div>
                                        <button class="btn-panel-link" @onclick='() => SetActiveTab("gallery")'>
                                            <span>View Gallery</span>
                                            <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                    <div class="recent-albums-list">
                                        @foreach (var a in albums.Take(3))
                                        {
                                            <div class="recent-album-item">
                                                <div class="recent-album-thumb" style="background-color: @a.Tone">
                                                    <i class="bi bi-camera-fill"></i>
                                                </div>
                                                <div class="recent-album-info overflow-hidden">
                                                    <div class="album-title text-truncate">@a.Title</div>
                                                    <div class="album-meta">
                                                        <span>@a.FileCount files</span>
                                                        <span class="dot-separator">•</span>
                                                        <span>@a.DeliveredOn.ToString("MMM dd", CultureInfo.InvariantCulture)</span>
                                                    </div>
                                                </div>
                                                <button class="btn-icon-download" title="Download album" @onclick='() => SetActiveTab("gallery")'>
                                                    <i class="bi bi-download"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    break;

                case "bookings":
                    <section class="dashboard-panel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                            <div>
                                <h2 class="panel-title fs-5 mb-1">All Bookings</h2>
                                <span class="panel-subtitle">Complete schedule and historical log of all studio appointments</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="filter-pill-btn @(bookingFilter == "all" ? "active" : "")" @onclick='() => bookingFilter = "all"'>
                                    All (@bookings.Count)
                                </button>
                                <button class="filter-pill-btn @(bookingFilter == "confirmed" ? "active" : "")" @onclick='() => bookingFilter = "confirmed"'>
                                    Confirmed (@bookings.Count(b => b.Status == BookingStatus.Confirmed))
                                </button>
                                <button class="filter-pill-btn @(bookingFilter == "pending" ? "active" : "")" @onclick='() => bookingFilter = "pending"'>
                                    Pending (@bookings.Count(b => b.Status == BookingStatus.Pending))
                                </button>
                                <button class="filter-pill-btn @(bookingFilter == "completed" ? "active" : "")" @onclick='() => bookingFilter = "completed"'>
                                    Completed (@bookings.Count(b => b.Status == BookingStatus.Completed))
                                </button>
                            </div>
                        </div>

                        <div class="bookings-table-wrapper">
                            <div class="bookings-table-header">
                                <div class="col-header-session">Client / Session</div>
                                <div class="col-header-service">Service</div>
                                <div class="col-header-date">Date &amp; Time</div>
                                <div class="col-header-status text-end">Status</div>
                            </div>
                            <div class="bookings-table-body">
                                @{
                                    var filteredBookings = bookings
                                        .Where(b => bookingFilter == "all" ||
                                                    (bookingFilter == "confirmed" && b.Status == BookingStatus.Confirmed) ||
                                                    (bookingFilter == "pending" && b.Status == BookingStatus.Pending) ||
                                                    (bookingFilter == "completed" && b.Status == BookingStatus.Completed))
                                        .OrderBy(x => x.Start)
                                        .ToList();
                                }
                                @if (filteredBookings.Any())
                                {
                                    @foreach (var b in filteredBookings)
                                    {
                                        <BookingRow Item="b" />
                                    }
                                }
                                else
                                {
                                    <div class="p-4 text-center text-muted">
                                        No bookings matching this filter.
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                    break;

                case "gallery":
                    <section class="d-flex flex-column gap-3">
                        <div class="dashboard-panel">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h2 class="panel-title mb-1">Delivered Galleries</h2>
                                    <span class="panel-subtitle">Review, share, and download your high-resolution studio assets</span>
                                </div>
                                <div class="badge bg-light text-dark border p-2 px-3 rounded-pill fw-semibold">
                                    <i class="bi bi-cloud-check text-success me-1"></i>
                                    @albums.Sum(a => a.FileCount) total files available
                                </div>
                            </div>
                        </div>

                        <div class="row g-4">
                            @foreach (var a in albums)
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <div class="gallery-card">
                                        <div class="gallery-cover" style="background-color: @a.Tone">
                                            <i class="bi bi-camera-fill text-white opacity-50"></i>
                                            <div class="gallery-cover-badge">
                                                <i class="bi bi-image me-1"></i> @a.FileCount photos
                                            </div>
                                        </div>
                                        <div class="gallery-body">
                                            <h3 class="fs-6 fw-bold text-dark mb-1">@a.Title</h3>
                                            <div class="small text-muted mb-3">
                                                Delivered on @a.DeliveredOn.ToString("MMMM dd, yyyy", CultureInfo.InvariantCulture)
                                            </div>
                                            <button class="btn btn-outline-dark btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                                                <i class="bi bi-download"></i>
                                                <span>Download Full Album</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                    break;

                case "svc-photography":
                case "svc-videography":
                case "svc-editing":
                    <section class="dashboard-panel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
                            <div>
                                <h2 class="panel-title fs-5 mb-1">@GetHeaderTitle() Studio Packages</h2>
                                <span class="panel-subtitle">Bespoke production, specialized equipment, and dedicated post-processing</span>
                            </div>
                            <button class="btn btn-primary-cta" @onclick='() => SetActiveTab("bookings")'>
                                <i class="bi bi-calendar-plus me-1"></i> Request a Booking
                            </button>
                        </div>

                        <div class="row g-4">
                            <div class="col-12 col-md-4">
                                <div class="service-feature-card">
                                    <div class="stat-icon-wrapper stat-icon-blue mb-3">
                                        <i class="bi bi-stars"></i>
                                    </div>
                                    <h3 class="fs-6 fw-bold text-dark mb-2">Essential Studio</h3>
                                    <p class="text-secondary small mb-3">Ideal for individual portraits, headshots, and editorial portfolios.</p>
                                    <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-4">
                                        <li><i class="bi bi-check2 text-success me-2"></i> 2 Hours Studio Access</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i> 20 Master Retouched Files</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i> 48-Hour Web Preview</li>
                                    </ul>
                                    <button class="btn btn-outline-dark btn-sm w-100" @onclick='() => SetActiveTab("bookings")'>Select Package</button>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="service-feature-card">
                                    <div class="stat-icon-wrapper stat-icon-purple mb-3">
                                        <i class="bi bi-lightning-charge"></i>
                                    </div>
                                    <h3 class="fs-6 fw-bold text-dark mb-2">Brand &amp; Campaign</h3>
                                    <p class="text-secondary small mb-3">Designed for lifestyle brands, commercial campaigns, and lookbooks.</p>
                                    <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-4">
                                        <li><i class="bi bi-check2 text-success me-2"></i> Full Day Production</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i> Dedicated Creative Director</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i> Unlimited Commercial License</li>
                                    </ul>
                                    <button class="btn btn-dark btn-sm w-100" @onclick='() => SetActiveTab("bookings")'>Select Package</button>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="service-feature-card">
                                    <div class="stat-icon-wrapper stat-icon-amber mb-3">
                                        <i class="bi bi-gem"></i>
                                    </div>
                                    <h3 class="fs-6 fw-bold text-dark mb-2">Custom Tailored</h3>
                                    <p class="text-secondary small mb-3">Multi-day destination shoots, specialized sets, and large crews.</p>
                                    <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-4">
                                        <li><i class="bi bi-check2 text-success me-2"></i> Bespoke Scope &amp; Rigging</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i> Drone &amp; Cinema Cameras</li>
                                        <li><i class="bi bi-check2 text-success me-2"></i> Expedited Turnaround</li>
                                    </ul>
                                    <button class="btn btn-outline-dark btn-sm w-100" @onclick='() => SetActiveTab("bookings")'>Inquire Custom</button>
                                </div>
                            </div>
                        </div>
                    </section>
                    break;

                case "profile":
                    <section class="dashboard-panel profile-card p-0">
                        <!-- A. Header Banner / Profile Summary Header -->
                        <div class="profile-header-banner">
                            <div class="profile-avatar-container">
                                <div class="profile-avatar">
                                    @AvatarInitials
                                </div>
                            </div>
                            <div class="profile-header-info">
                                <h2 class="profile-user-name">@profile.DisplayName</h2>
                                <div class="profile-badges-row">
                                    <span class="profile-id-badge">User ID: @profile.UserId</span>
                                    <span class="profile-status-pill">@profile.Role</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card Body Form -->
                        <div class="profile-card-body">
                            <EditForm Model="profile" OnValidSubmit="SaveProfile" FormName="profile-form">
                                <!-- 1. Personal Information Section -->
                                <div class="profile-form-section">
                                    <h3 class="profile-section-title">Personal Information</h3>
                                    <div class="row g-3 profile-form-grid">
                                        <div class="col-12 col-md-4">
                                            <label class="form-label" for="firstName">First Name</label>
                                            <InputText id="firstName" class="form-control" @bind-Value="profile.FirstName" placeholder="Sarah" />
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <label class="form-label" for="middleName">Middle Name</label>
                                            <InputText id="middleName" class="form-control" @bind-Value="profile.MiddleName" placeholder="L." />
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <label class="form-label" for="lastName">Last Name</label>
                                            <InputText id="lastName" class="form-control" @bind-Value="profile.LastName" placeholder="Jenkins" />
                                        </div>
                                    </div>
                                </div>

                                <hr class="profile-divider" />

                                <!-- 2. Contact Information Section -->
                                <div class="profile-form-section">
                                    <h3 class="profile-section-title">Contact Information</h3>
                                    <div class="row g-3 profile-form-grid">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label" for="email">Email Address</label>
                                            <InputText id="email" type="email" class="form-control" @bind-Value="profile.Email" placeholder="sarah.jenkins@example.com" />
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label" for="phone">Phone Number</label>
                                            <InputText id="phone" class="form-control" @bind-Value="profile.Phone" placeholder="+1 (555) 123-4567" />
                                        </div>
                                    </div>
                                </div>

                                <hr class="profile-divider" />

                                <!-- 3. Security & Password Section -->
                                <div class="profile-form-section">
                                    <h3 class="profile-section-title">Security &amp; Password</h3>
                                    <div class="row g-3 profile-form-grid">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label" for="newPassword">New Password</label>
                                            <InputText id="newPassword" type="password" class="form-control" @bind-Value="profile.NewPassword" placeholder="••••••••" />
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label" for="confirmPassword">Confirm Password</label>
                                            <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="profile.ConfirmPassword" placeholder="••••••••" />
                                        </div>
                                    </div>
                                </div>

                                <!-- C. Action Controls -->
                                <div class="profile-actions-bar">
                                    @if (savedMessage is not null)
                                    {
                                        <span class="text-success small fw-semibold me-3" role="status">
                                            <i class="bi bi-check-circle-fill me-1"></i> @savedMessage
                                        </span>
                                    }
                                    <button type="submit" class="btn btn-primary-cta profile-save-btn">
                                        Save Changes
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    </section>
                    break;
            }
        </div>
    </main>

</div>

@code {
    private string activeTab = "dashboard";
    private string bookingFilter = "all";
    private string? savedMessage;
    private CustomerProfile profile = new();

    // Sample data – maintaining model alignment with realistic session hours
    private readonly List<Booking> bookings = new()
    {
        new(1, "Portrait Session",   "Photography",   DateTime.Today.AddDays(7).AddHours(10),  "Studio A",   BookingStatus.Confirmed),
        new(2, "Brand Video Shoot",  "Videography",   DateTime.Today.AddDays(14).AddHours(13).AddMinutes(30), "On location", BookingStatus.Pending),
        new(3, "Photo Retouching",   "Editing & Post", DateTime.Today.AddDays(22).AddHours(9), "Remote",     BookingStatus.Confirmed),
        new(4, "Family Session",     "Photography",   DateTime.Today.AddDays(-30).AddHours(11), "Studio B",   BookingStatus.Completed),
        new(5, "Commercial Lookbook","Photography",   DateTime.Today.AddDays(35).AddHours(14), "Studio A",   BookingStatus.Pending),
    };

    private readonly List<GalleryAlbum> albums = new()
    {
        new(1, "Family Session",  24, DateTime.Today.AddDays(-21), "#d9cfc1"),
        new(2, "Product Shots",   16, DateTime.Today.AddDays(-45), "#b9c4bd"),
        new(3, "Event Highlights", 8, DateTime.Today.AddDays(-60), "#bfc3d1"),
    };

    private List<Booking> upcomingBookings =>
        bookings.Where(b => b.Start >= DateTime.Today && b.Status != BookingStatus.Cancelled)
                .OrderBy(b => b.Start).ToList();

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        savedMessage = null;
    }

    private string NavClass(string tab) =>
        activeTab == tab ? "nav-item-btn active" : "nav-item-btn";

    private string GetHeaderTitle() => activeTab switch
    {
        "dashboard"       => "Dashboard",
        "svc-photography" => "Photography",
        "svc-videography" => "Videography",
        "svc-editing"     => "Editing & Post",
        "bookings"        => "My Bookings",
        "gallery"         => "Gallery & Downloads",
        "profile"         => "Profile Settings",
        _                 => "Dashboard"
    };

    private string AvatarInitials
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(profile.FirstName) && !string.IsNullOrWhiteSpace(profile.LastName))
            {
                return $"{char.ToUpper(profile.FirstName.Trim()[0])}{char.ToUpper(profile.LastName.Trim()[0])}";
            }
            return Initials(profile.FullName);
        }
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

    private void SaveProfile() => savedMessage = "Profile updated successfully.";
}
