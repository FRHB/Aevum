@using System.Globalization
@using AevumStudio.Models

<div class="booking-row">
    <!-- 1. Client / Session -->
    <div class="booking-col booking-col-session">
        <div class="session-avatar">
            <i class="@GetServiceIcon(Item.Service)"></i>
        </div>
        <div class="session-meta">
            <span class="session-title" title="@Item.Title">@Item.Title</span>
            <span class="session-subtext">
                <i class="bi bi-geo-alt"></i>@Item.Location
            </span>
        </div>
    </div>

    <!-- 2. Service -->
    <div class="booking-col booking-col-service">
        <span class="service-pill">@Item.Service</span>
    </div>

    <!-- 3. Date & Time -->
    <div class="booking-col booking-col-date">
        <div class="date-container">
            <span class="date-primary">@Item.Start.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</span>
            <span class="date-secondary">
                <i class="bi bi-clock"></i>@Item.Start.ToString("h:mm tt", CultureInfo.InvariantCulture)
            </span>
        </div>
    </div>

    <!-- 4. Status -->
    <div class="booking-col booking-col-status">
        <span class="@PillClass">
            <span class="status-dot"></span>
            @Item.Status
        </span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Booking Item { get; set; } = default!;

    private string PillClass => Item.Status switch
    {
        BookingStatus.Confirmed => "status-pill status-confirmed",
        BookingStatus.Pending   => "status-pill status-pending",
        BookingStatus.Completed => "status-pill status-completed",
        BookingStatus.Cancelled => "status-pill status-cancelled",
        _                       => "status-pill"
    };

    private static string GetServiceIcon(string service) => service.ToLowerInvariant() switch
    {
        var s when s.Contains("photo") => "bi bi-camera-fill",
        var s when s.Contains("video") => "bi bi-camera-reels-fill",
        var s when s.Contains("edit")  => "bi bi-sliders2",
        _                              => "bi bi-calendar-event-fill"
    };
}
