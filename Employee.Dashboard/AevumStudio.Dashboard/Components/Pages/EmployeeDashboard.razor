@page "/"
@page "/employee/dashboard"
@rendermode InteractiveServer

<PageTitle>Dashboard Overview – Aevum Studio</PageTitle>

<div class="dashboard-wrapper">
    <!-- Sidebar Navigation -->
    <aside class="dashboard-sidebar">
        <!-- Logo Branding Header -->
        <div class="brand-header">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="4" />
                    <line x1="4.93" y1="4.93" x2="9.17" y2="9.17" />
                    <line x1="14.83" y1="14.83" x2="19.07" y2="19.07" />
                    <line x1="14.83" y1="9.17" x2="19.07" y2="4.93" />
                    <line x1="4.93" y1="19.07" x2="9.17" y2="14.83" />
                </svg>
            </div>
            <span class="brand-name">Aevum Studio</span>
        </div>

        <!-- Navigation Links -->
        <nav class="sidebar-nav" aria-label="Main Navigation">
            <!-- MANAGEMENT Section -->
            <div class="nav-section-title">MANAGEMENT</div>

            <!-- Overview (Active) -->
            <a class="nav-item active" href="/employee/dashboard">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                </span>
                <span class="nav-text">Overview</span>
            </a>

            <!-- My Schedule (Expandable Dropdown) -->
            <div class="nav-dropdown-group">
                <button type="button" class="nav-item nav-dropdown-btn @(IsMenuExpanded("Schedule") ? "expanded" : "")" @onclick='() => ToggleDropdown("Schedule")'>
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                    </span>
                    <span class="nav-text">My Schedule</span>
                    <svg class="chevron-icon @(IsMenuExpanded("Schedule") ? "rotated" : "")" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                @if (IsMenuExpanded("Schedule"))
                {
                    <ul class="sub-menu">
                        <!-- Dropdown panel/sub-menu container left empty as requested -->
                    </ul>
                }
            </div>

            <!-- Assigned Bookings (Expandable Dropdown) -->
            <div class="nav-dropdown-group">
                <button type="button" class="nav-item nav-dropdown-btn @(IsMenuExpanded("Bookings") ? "expanded" : "")" @onclick='() => ToggleDropdown("Bookings")'>
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                            <rect x="8" y="2" width="8" height="4" rx="1" />
                            <path d="m9 14 2 2 4-4" />
                        </svg>
                    </span>
                    <span class="nav-text">Assigned Bookings</span>
                    <svg class="chevron-icon @(IsMenuExpanded("Bookings") ? "rotated" : "")" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                @if (IsMenuExpanded("Bookings"))
                {
                    <ul class="sub-menu">
                        <!-- Dropdown panel/sub-menu container left empty as requested -->
                    </ul>
                }
            </div>

            <!-- Clients -->
            <a class="nav-item" href="#" @onclick='() => ShowToast("Opening clients directory")' @onclick:preventDefault>
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </span>
                <span class="nav-text">Clients</span>
            </a>

            <!-- RESOURCES & LOGISTICS Section -->
            <div class="nav-section-title">RESOURCES &amp; LOGISTICS</div>

            <!-- My Equipment (Expandable Dropdown) -->
            <div class="nav-dropdown-group">
                <button type="button" class="nav-item nav-dropdown-btn @(IsMenuExpanded("Equipment") ? "expanded" : "")" @onclick='() => ToggleDropdown("Equipment")'>
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                            <circle cx="12" cy="13" r="4" />
                        </svg>
                    </span>
                    <span class="nav-text">My Equipment</span>
                    <svg class="chevron-icon @(IsMenuExpanded("Equipment") ? "rotated" : "")" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                @if (IsMenuExpanded("Equipment"))
                {
                    <ul class="sub-menu">
                        <!-- Dropdown panel/sub-menu container left empty as requested -->
                    </ul>
                }
            </div>

            <!-- ACCOUNT Section -->
            <div class="nav-section-title">ACCOUNT</div>

            <!-- Profile -->
            <a class="nav-item" href="/employee/profile">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                <span class="nav-text">Profile</span>
            </a>
        </nav>

        <!-- Current User Profile Footer -->
        <div class="user-profile-footer">
            <div class="user-avatar">MR</div>
            <div class="user-info">
                <span class="user-name">Miguel Reyes</span>
                <span class="user-role">Photographer</span>
            </div>
        </div>
    </aside>

    <!-- Main Dashboard Content -->
    <main class="dashboard-main">
        <!-- Top Header & Clock Action Area -->
        <header class="dashboard-header">
            <div class="header-titles">
                <h1 class="page-title">Dashboard Overview</h1>
                <p class="page-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
            </div>
            <div class="header-actions">
                <div class="clock-card">
                    <span class="clock-indicator @(isClockedIn ? "active" : "")"></span>
                    <div class="clock-meta">
                        <span class="clock-status">@(isClockedIn ? $"Clocked in at {clockInTime}" : "Not clocked in")</span>
                        <span class="clock-shift">Shift 9:00 AM – 6:00 PM</span>
                    </div>
                    <button type="button" class="btn-clock @(isClockedIn ? "btn-clock-out" : "btn-clock-in")" @onclick="ToggleClock">
                        @if (isClockedIn)
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <rect x="9" y="9" width="6" height="6" />
                            </svg>
                            <span>Clock out</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                            <span>Clock in</span>
                        }
                    </button>
                </div>
            </div>
        </header>

        <!-- Top Metric Cards (4 Grid Columns) -->
        <section class="metric-cards-grid" aria-label="Key Performance Indicators">
            <!-- Appointments Today -->
            <div class="metric-card">
                <div class="metric-icon-wrap icon-cyan">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                        <path d="m9 16 2 2 4-4" />
                    </svg>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Appointments Today</span>
                    <strong class="metric-value">3</strong>
                </div>
            </div>

            <!-- Assigned This Week / Active Status -->
            <div class="metric-card">
                <div class="metric-icon-wrap icon-indigo">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Assigned This Week</span>
                    <strong class="metric-value">9</strong>
                </div>
            </div>

            <!-- Equipment Checked Out -->
            <div class="metric-card">
                <div class="metric-icon-wrap icon-amber">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                        <circle cx="12" cy="13" r="4" />
                    </svg>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Equipment Checked Out</span>
                    <strong class="metric-value">4</strong>
                </div>
            </div>

            <!-- Hours This Week -->
            <div class="metric-card">
                <div class="metric-icon-wrap icon-purple">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </div>
                <div class="metric-content">
                    <span class="metric-label">Hours This Week</span>
                    <strong class="metric-value">26.5</strong>
                </div>
            </div>
        </section>

        <!-- Main Content 2-Column Grid -->
        <div class="content-grid">
            <!-- Left Column: Recent Bookings Table & Today's Checklist -->
            <div class="primary-column">
                <!-- Recent Bookings / My Assignments Table Card -->
                <section class="card table-card">
                    <div class="card-header">
                        <h2 class="card-title">Recent Bookings</h2>
                        <a href="#" class="card-action-link" @onclick='() => ShowToast("Opening all assignments...")' @onclick:preventDefault>View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>CLIENT</th>
                                    <th>SERVICE</th>
                                    <th>DATE &amp; TIME</th>
                                    <th>STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="client-name">Sarah Jenkins</td>
                                    <td>Express Headshot</td>
                                    <td class="date-time">Today, 2:00 PM</td>
                                    <td><span class="status-pill status-confirmed">Confirmed</span></td>
                                </tr>
                                <tr>
                                    <td class="client-name">Mark Uy</td>
                                    <td>Full Studio Session</td>
                                    <td class="date-time">Today, 4:30 PM</td>
                                    <td><span class="status-pill status-pending">Pending</span></td>
                                </tr>
                                <tr>
                                    <td class="client-name">Anna Cruz</td>
                                    <td>Corporate Package</td>
                                    <td class="date-time">Tomorrow, 10:00 AM</td>
                                    <td><span class="status-pill status-confirmed">Confirmed</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- Today’s Checklist Card -->
                <section class="card checklist-card">
                    <div class="card-header">
                        <h2 class="card-title">Today’s Checklist</h2>
                        <span class="checklist-summary">
                            @checklistItems.Count(t => t.IsCompleted) of @checklistItems.Count completed
                        </span>
                    </div>
                    <ul class="checklist">
                        @foreach (var task in checklistItems)
                        {
                            <li class="checklist-item @(task.IsCompleted ? "completed" : "")">
                                <label class="checkbox-container" for="task_@task.Id">
                                    <input type="checkbox" id="task_@task.Id" @bind="task.IsCompleted" />
                                    <span class="checkmark"></span>
                                    <span class="task-label">@task.Description</span>
                                </label>
                                <span class="task-time">@task.Time</span>
                            </li>
                        }
                    </ul>
                </section>
            </div>

            <!-- Right Column: Quick Actions & Equipment Status -->
            <div class="secondary-column">
                <!-- Quick Actions Card -->
                <section class="card quick-actions-card">
                    <div class="card-header">
                        <h2 class="card-title">Quick Actions</h2>
                    </div>
                    <div class="quick-actions-list">
                        <button type="button" class="quick-action-btn" @onclick='() => ShowToast("Opening your schedule...")'>
                            <span class="qa-icon">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2" />
                                    <line x1="16" y1="2" x2="16" y2="6" />
                                    <line x1="8" y1="2" x2="8" y2="6" />
                                    <line x1="3" y1="10" x2="21" y2="10" />
                                </svg>
                            </span>
                            <span class="qa-text">My Schedule</span>
                            <span class="qa-chevron">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            </span>
                        </button>

                        <button type="button" class="quick-action-btn" @onclick='() => ShowToast("Equipment request started...")'>
                            <span class="qa-icon">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                                    <circle cx="12" cy="13" r="4" />
                                </svg>
                            </span>
                            <span class="qa-text">Request Equipment</span>
                            <span class="qa-chevron">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            </span>
                        </button>

                        <button type="button" class="quick-action-btn" @onclick='() => ShowToast("Time-off form opened...")'>
                            <span class="qa-icon">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 6 12 12 16 14" />
                                </svg>
                            </span>
                            <span class="qa-text">Request Time Off</span>
                            <span class="qa-chevron">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            </span>
                        </button>

                        <button type="button" class="quick-action-btn" @onclick='() => ShowToast("Opening clients directory...")'>
                            <span class="qa-icon">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                </svg>
                            </span>
                            <span class="qa-text">View Clients</span>
                            <span class="qa-chevron">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            </span>
                        </button>
                    </div>
                </section>

                <!-- Equipment Tracking Card -->
                <section class="card equipment-tracking-card">
                    <div class="card-header">
                        <h2 class="card-title">Equipment Tracking</h2>
                        <a href="#" class="card-action-link" @onclick='() => ShowToast("Opening equipment tracker...")' @onclick:preventDefault>Track</a>
                    </div>
                    <ul class="equipment-list">
                        <li class="equipment-item">
                            <span class="equipment-name">Canon EOS R5</span>
                            <span class="equipment-status-badge">Return 6:00 PM</span>
                        </li>
                        <li class="equipment-item">
                            <span class="equipment-name">Godox AD600 Strobe</span>
                            <span class="equipment-status-badge">Studio A</span>
                        </li>
                        <li class="equipment-item">
                            <span class="equipment-name">85mm f/1.2 Lens</span>
                            <span class="equipment-status-badge">Return 6:00 PM</span>
                        </li>
                        <li class="equipment-item">
                            <span class="equipment-name">Backdrop Stand</span>
                            <span class="equipment-status-badge">Studio A</span>
                        </li>
                    </ul>
                </section>
            </div>
        </div>
    </main>

    <!-- Interactive Toast Message -->
    <div class="toast-notification @(showToast ? "visible" : "")" role="status" aria-live="polite">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        <span>@toastMessage</span>
    </div>
</div>
