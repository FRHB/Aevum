@page "/employee/profile"
@rendermode InteractiveServer

<PageTitle>Account Profile – Aevum Studio</PageTitle>

<div class="dashboard-wrapper">
    <!-- Sidebar Navigation -->
    <aside class="dashboard-sidebar">
        <!-- Logo Branding Header -->
        <div class="brand-header">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="4" />
                    <line x1="4.93" y1="4.93" x2="9.17" y2="9.17" />
                    <line x1="14.83" y1="14.83" x2="19.07" y2="19.07" />
                    <line x1="14.83" y1="9.17" x2="19.07" y2="4.93" />
                    <line x1="4.93" y1="19.07" x2="9.17" y2="14.83" />
                </svg>
            </div>
            <span class="brand-name">Aevum Studio</span>
        </div>

        <!-- Navigation Links -->
        <nav class="sidebar-nav" aria-label="Main Navigation">
            <!-- MANAGEMENT Section -->
            <div class="nav-section-title">MANAGEMENT</div>

            <!-- Overview -->
            <a class="nav-item" href="/employee/dashboard">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                </span>
                <span class="nav-text">Overview</span>
            </a>

            <!-- My Schedule (Expandable Dropdown) -->
            <div class="nav-dropdown-group">
                <button type="button" class="nav-item nav-dropdown-btn @(IsMenuExpanded("Schedule") ? "expanded" : "")" @onclick='() => ToggleDropdown("Schedule")'>
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                    </span>
                    <span class="nav-text">My Schedule</span>
                    <svg class="chevron-icon @(IsMenuExpanded("Schedule") ? "rotated" : "")" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                @if (IsMenuExpanded("Schedule"))
                {
                    <ul class="sub-menu">
                        <!-- Dropdown panel/sub-menu container -->
                    </ul>
                }
            </div>

            <!-- Assigned Bookings (Expandable Dropdown) -->
            <div class="nav-dropdown-group">
                <button type="button" class="nav-item nav-dropdown-btn @(IsMenuExpanded("Bookings") ? "expanded" : "")" @onclick='() => ToggleDropdown("Bookings")'>
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                            <rect x="8" y="2" width="8" height="4" rx="1" />
                            <path d="m9 14 2 2 4-4" />
                        </svg>
                    </span>
                    <span class="nav-text">Assigned Bookings</span>
                    <svg class="chevron-icon @(IsMenuExpanded("Bookings") ? "rotated" : "")" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                @if (IsMenuExpanded("Bookings"))
                {
                    <ul class="sub-menu">
                        <!-- Dropdown panel/sub-menu container -->
                    </ul>
                }
            </div>

            <!-- Clients -->
            <a class="nav-item" href="#" @onclick='() => ShowToast("Opening clients directory")' @onclick:preventDefault>
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </span>
                <span class="nav-text">Clients</span>
            </a>

            <!-- RESOURCES & LOGISTICS Section -->
            <div class="nav-section-title">RESOURCES &amp; LOGISTICS</div>

            <!-- My Equipment (Expandable Dropdown) -->
            <div class="nav-dropdown-group">
                <button type="button" class="nav-item nav-dropdown-btn @(IsMenuExpanded("Equipment") ? "expanded" : "")" @onclick='() => ToggleDropdown("Equipment")'>
                    <span class="nav-icon">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                            <circle cx="12" cy="13" r="4" />
                        </svg>
                    </span>
                    <span class="nav-text">My Equipment</span>
                    <svg class="chevron-icon @(IsMenuExpanded("Equipment") ? "rotated" : "")" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
                @if (IsMenuExpanded("Equipment"))
                {
                    <ul class="sub-menu">
                        <!-- Dropdown panel/sub-menu container -->
                    </ul>
                }
            </div>

            <!-- ACCOUNT Section -->
            <div class="nav-section-title">ACCOUNT</div>

            <!-- Profile (Active) -->
            <a class="nav-item active" href="/employee/profile">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                <span class="nav-text">Profile</span>
            </a>
        </nav>

        <!-- Current User Profile Footer -->
        <div class="user-profile-footer">
            <div class="user-avatar">@(GetInitials())</div>
            <div class="user-info">
                <span class="user-name">@employeeProfile.EmployeeFirstName @employeeProfile.EmployeeLastName</span>
                <span class="user-role">@employeeProfile.EmployeeRole</span>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="dashboard-main">
        <div class="profile-page-container">
            <!-- Header Section -->
            <header class="profile-header-container">
                <h1 class="page-title">Account Profile</h1>
                <p class="profile-page-subtitle">Manage your account information, role privileges, and security settings</p>
            </header>

            <!-- Unified Single Profile Card -->
            <section class="profile-card-container" aria-label="Employee Profile Information">
                <!-- Banner / Header Area -->
                <div class="profile-banner-header"></div>

                <!-- Profile Identity Bar (Overlapping Header) -->
                <div class="profile-identity-row">
                    <div class="profile-avatar-box">
                        @(GetInitials())
                    </div>
                    <div class="profile-identity-info">
                        <h2 class="profile-full-name">@employeeProfile.EmployeeFirstName @employeeProfile.EmployeeLastName</h2>
                        <div class="profile-subinfo-row">
                            <span class="profile-id-label">ID: <span class="profile-id-value">@employeeProfile.EmployeeID</span></span>
                            <span class="profile-status-pill">@employeeProfile.EmployeeStatus</span>
                        </div>
                    </div>
                </div>

                <!-- Form Body -->
                <form class="profile-form-body" @onsubmit="HandleSave">
                    <!-- Section 1: Personal Information -->
                    <div class="profile-form-section">
                        <h3 class="profile-section-heading">Personal Information</h3>
                        <div class="profile-grid-three">
                            <div class="profile-input-group">
                                <label class="profile-input-label" for="firstNameInput">FIRST NAME</label>
                                <input id="firstNameInput" type="text" class="profile-input-field" @bind="employeeProfile.EmployeeFirstName" required />
                            </div>
                            <div class="profile-input-group">
                                <label class="profile-input-label" for="middleNameInput">MIDDLE NAME</label>
                                <input id="middleNameInput" type="text" class="profile-input-field" @bind="employeeProfile.EmployeeMiddleName" />
                            </div>
                            <div class="profile-input-group">
                                <label class="profile-input-label" for="lastNameInput">LAST NAME</label>
                                <input id="lastNameInput" type="text" class="profile-input-field" @bind="employeeProfile.EmployeeLastName" required />
                            </div>
                        </div>
                    </div>

                    <div class="profile-divider"></div>

                    <!-- Section 2: Contact Information -->
                    <div class="profile-form-section">
                        <h3 class="profile-section-heading">Contact Information</h3>
                        <div class="profile-input-group">
                            <label class="profile-input-label" for="emailInput">EMAIL ADDRESS</label>
                            <input id="emailInput" type="email" class="profile-input-field" @bind="employeeProfile.EmployeeEmail" required />
                        </div>
                    </div>

                    <div class="profile-divider"></div>

                    <!-- Section 3: Security -->
                    <div class="profile-form-section">
                        <h3 class="profile-section-heading">Security</h3>
                        <div class="profile-grid-two">
                            <div class="profile-input-group">
                                <label class="profile-input-label" for="newPasswordInput">NEW PASSWORD</label>
                                <input id="newPasswordInput" type="password" class="profile-input-field" @bind="newPassword" placeholder="••••••••" />
                            </div>
                            <div class="profile-input-group">
                                <label class="profile-input-label" for="confirmPasswordInput">CONFIRM PASSWORD</label>
                                <input id="confirmPasswordInput" type="password" class="profile-input-field" @bind="confirmPassword" placeholder="••••••••" />
                            </div>
                        </div>
                    </div>

                    <!-- Footer Action Bar -->
                    <div class="profile-divider footer-divider"></div>
                    <div class="profile-footer-row">
                        @if (!string.IsNullOrEmpty(statusFeedback))
                        {
                            <span class="profile-feedback-text @(isError ? "feedback-error" : "feedback-success")">@statusFeedback</span>
                        }
                        <button type="submit" class="btn-save-changes">Save Changes</button>
                    </div>
                </form>
            </section>
        </div>
    </main>

    <!-- Interactive Toast Notification -->
    <div class="toast-notification @(showToast ? "visible" : "")" role="status" aria-live="polite">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        <span>@toastMessage</span>
    </div>
</div>

@code {
    private string statusFeedback = "Changes saved.";
    private bool isError = false;

    private void HandleSave()
    {
        isError = false;

        // If a new password was provided, validate and update via SaveProfile
        if (!string.IsNullOrWhiteSpace(newPassword) || !string.IsNullOrWhiteSpace(confirmPassword))
        {
            SaveProfile();
            if (!string.IsNullOrEmpty(passwordError))
            {
                statusFeedback = passwordError;
                isError = true;
                return;
            }
        }

        SaveProfileDetails();
        statusFeedback = !string.IsNullOrEmpty(passwordSuccess) ? "Changes saved." : "Changes saved.";
        _ = currentPassword;
        isError = false;
    }
}
