{
  "Infisical": {
    "ClientId": "",
    "ClientSecret": "",
    "ProjectId": "",
    "Environment": "dev"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BaseUrl": "http://photoaevum.tryasp.net",
  "Session": {
    "TimeoutMinutes": 15
  },
  "ApiBaseUrl": "http://api-photoaevum.tryasp.net/",
  "Api": {
    "BaseUrl": "http://api-photoaevum.tryasp.net/"
  },
  "XenditSettings": {
    "PublicKey": "",
    "DownpaymentPercentage": 0.15,
    "HoldDurationMinutes": 30
  },
  "CloudflareR2": {
    "AccessKey": "",
    "SecretKey": "",
    "AccountId": "",
    "ServiceUrl": "",
    "Buckets": {
      "Portfolio": "portfolio",
      "Services": "services",
      "Archive": "archive",
      "Dropbox": "dropbox"
    }
  },
  "Bi": {
    "EntityLabels": {
      "Appointment": "Event Booking",
      "Crew": "Photographer/Crew",
      "Client": "Customer",
      "Service": "Service/Package"
    },
    "Kpis": {
      "Sales": [
        { "Id": "sales-gross-revenue", "Label": "Total Revenue (Gross)", "SourceField": "TotalRevenue", "Format": "C", "Tone": "positive" },
        { "Id": "sales-average-value", "Label": "Average Sale Value", "SourceField": "AverageSaleValue", "Format": "C", "Tone": "neutral" },
        { "Id": "sales-outstanding-invoices", "Label": "Outstanding Invoices", "SourceField": "PendingAmount", "Format": "C", "Tone": "warning" },
        { "Id": "sales-completed-transactions", "Label": "Completed Transactions", "SourceField": "CompletedCount", "Format": "N0", "Tone": "neutral" }
      ],
      "Analytics": [
        { "Id": "analytics-total-bookings", "Label": "Total Bookings", "SourceField": "TotalBookings", "Format": "N0", "Tone": "primary" },
        { "Id": "analytics-completion-rate", "Label": "Completion Rate", "SourceField": "SessionCompletionRate", "Format": "P1", "Tone": "positive" },
        { "Id": "analytics-logged-hours", "Label": "Logged Crew Hours", "SourceField": "LoggedCrewHours", "Format": "N1", "Tone": "info" },
        { "Id": "analytics-equipment-holds", "Label": "Equipment Holds", "SourceField": "EquipmentMaintenanceHolds", "Format": "N0", "Tone": "warning" }
      ],
      "Reports": [
        { "Id": "report-gross-value", "Label": "Gross Booking Value", "SourceField": "GrossBookingValue", "Format": "C", "Tone": "primary" },
        { "Id": "report-capacity", "Label": "Studio Capacity", "SourceField": "CapacityUtilizationPercent", "Format": "P1", "Tone": "neutral" },
        { "Id": "report-efficiency", "Label": "Staff Efficiency", "SourceField": "TotalLoggedHours", "Format": "N1", "Tone": "info" },
        { "Id": "report-retention", "Label": "Client Retention", "SourceField": "RetentionPercent", "Format": "P1", "Tone": "positive" }
      ]
    }
  }
}