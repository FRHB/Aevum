@page "/portfolio"
@page "/staff/portfolio"
@layout EmployeeLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Employee, Office Clerk, Admin, SystemAdmin, Super Admin")]
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IPortfolioService PortfolioService

<PageTitle>Studio Featured Portfolio | Photo Aevum Studio</PageTitle>

<div class="space-y-6 pb-12 max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-gray-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">
                <span>Showcase</span>
                <span>/</span>
                <span class="text-gray-900 font-bold">Featured Portfolio</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Studio Portfolio Showcases</h1>
            <p class="text-sm text-gray-500 mt-1">
                Artisan photography, master compositions, and official studio showcases curated by administration.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/#portfolio" target="_blank" class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-900 hover:bg-black text-white text-xs font-semibold uppercase tracking-wider rounded-lg shadow-sm transition-all">
                <span>View Public Gallery ↗</span>
            </a>
        </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-3">
        <button type="button"
                @onclick='() => _selectedCategory = "All"'
                class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-colors @(_selectedCategory == "All" ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
            All Collections (@_featuredPortfolios.Count)
        </button>
        @foreach (var cat in _categories)
        {
            var count = _featuredPortfolios.Count(p => string.Equals(p.CategoryID, cat.CategoryID, StringComparison.OrdinalIgnoreCase));
            if (count > 0)
            {
                <button type="button"
                        @onclick="() => _selectedCategory = cat.CategoryID"
                        class="px-3.5 py-1.5 text-xs font-semibold rounded-full transition-colors @(_selectedCategory == cat.CategoryID ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    @cat.CategoryName (@count)
                </button>
            }
        }
    </div>

    <!-- Gallery Grid -->
    @if (_isLoading)
    {
        <div class="p-16 text-center text-gray-400 text-sm">
            <div class="animate-spin inline-block w-6 h-6 border-2 border-current border-t-transparent text-gray-900 rounded-full mb-2"></div>
            <p>Loading studio portfolio showcases...</p>
        </div>
    }
    else if (FilteredPortfolios.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-gray-200 p-12 text-center shadow-xs">
            <div class="w-12 h-12 rounded-full bg-gray-100 text-gray-500 flex items-center justify-center mx-auto mb-3 text-xl">🖼️</div>
            <h3 class="text-base font-bold text-gray-900">No Featured Portfolios Available</h3>
            <p class="text-xs text-gray-500 mt-1">Featured collections curated by studio administration will appear here.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var port in FilteredPortfolios)
            {
                <div class="bg-white rounded-2xl border border-gray-200 shadow-xs hover:shadow-md transition-shadow overflow-hidden flex flex-col group cursor-pointer"
                     @onclick="() => _activeGallery = port">
                    <!-- Highlight Image -->
                    <div class="relative h-60 bg-slate-950 overflow-hidden">
                        <img src="@port.HighlightImageUrl"
                             alt="@port.PortfolioName"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                             onerror="this.src='images/AevumLogo.jpg';" />

                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-black/20"></div>

                        <div class="absolute top-3 left-3">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-400 text-slate-950 shadow-md">
                                ★ Featured
                            </span>
                        </div>

                        <div class="absolute top-3 right-3">
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-black/60 backdrop-blur-sm text-white">
                                📷 @(port.Images?.Count ?? 0)
                            </span>
                        </div>

                        <div class="absolute bottom-4 left-4 right-4 text-white">
                            <span class="text-[10px] uppercase font-bold tracking-wider text-amber-400 block mb-0.5">@port.CategoryName</span>
                            <h3 class="font-bold text-lg leading-snug drop-shadow-sm">@port.PortfolioName</h3>
                        </div>
                    </div>

                    <!-- Details -->
                    <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                        <p class="text-xs text-gray-600 line-clamp-3 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(port.PortfolioDescription) ? "Curated photography showcase from the artisan Photo Aevum Studio." : port.PortfolioDescription)
                        </p>

                        <!-- Thumbnail Strip -->
                        @if ((port.Images?.Count ?? 0) > 1)
                        {
                            <div class="flex items-center gap-2 overflow-x-auto py-1">
                                @foreach (var thumb in (port.Images ?? new()).Take(5))
                                {
                                    <div class="w-12 h-12 rounded-lg overflow-hidden border border-gray-200 shrink-0">
                                        <img src="@thumb.Url" alt="Thumb" class="w-full h-full object-cover hover:opacity-80" />
                                    </div>
                                }
                            </div>
                        }

                        <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                            <span class="text-gray-400">Added @port.CreatedAt.ToString("MMM d, yyyy")</span>
                            <span class="font-bold text-gray-900 group-hover:underline flex items-center gap-1">
                                View Full Album &rarr;
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Lightbox Modal -->
@if (_activeGallery != null)
{
    <div class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 w-full max-w-4xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-base text-gray-900">@_activeGallery.PortfolioName</h3>
                    <p class="text-xs text-gray-500">@_activeGallery.CategoryName &bull; @(_activeGallery.Images?.Count ?? 0) photo(s)</p>
                </div>
                <button type="button" @onclick="() => _activeGallery = null" class="text-gray-400 hover:text-gray-700 text-lg">✕</button>
            </div>

            <div class="p-6 overflow-y-auto flex-1">
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                    @foreach (var img in (_activeGallery.Images ?? new()))
                    {
                        <div class="rounded-xl overflow-hidden border border-gray-200 aspect-square bg-gray-100 shadow-sm group">
                            <img src="@img.Url" alt="Photo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PortfolioFolderModel> _featuredPortfolios = new();
    private List<PortfolioCategoryModel> _categories = new();
    private bool _isLoading = true;
    private string _selectedCategory = "All";
    private PortfolioFolderModel? _activeGallery;

    private List<PortfolioFolderModel> FilteredPortfolios => _featuredPortfolios
        .Where(p => _selectedCategory == "All" || string.Equals(p.CategoryID, _selectedCategory, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _categories = await PortfolioService.GetCategoriesAsync();
            _featuredPortfolios = await PortfolioService.GetFeaturedPortfoliosAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
