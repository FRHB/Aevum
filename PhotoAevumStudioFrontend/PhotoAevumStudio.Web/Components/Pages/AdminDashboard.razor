@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserService UserService
@inject IEmployeeService EmployeeService
@inject ITimesheetService TimesheetService
@inject IScheduleService ScheduleService
@inject IConsultationClient ConsultationApi
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Admin Dashboard | Photo Aevum Studio</PageTitle>

<header class="aev-page-header">
    <div>
        <h1 class="aev-page-header__title">Dashboard Overview</h1>
        <p class="aev-page-header__subtitle">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</p>
    </div>
    @* ── Admin Clock In / Clock Out Widget ─────────────────────────────── *@
    <div class="flex items-center gap-3 shrink-0">
        @if (_adminClockStatus.IsClockedIn)
        {
            <div class="hidden sm:flex items-center gap-2 text-xs text-slate-500 font-medium">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                    ON DUTY
                </span>
                <span>Since @(_adminClockStatus.ClockIn?.ToString("hh:mm tt") ?? "—")</span>
                <span class="text-slate-400">•</span>
                <span>@_adminClockStatus.ElapsedHours.ToString("0.#")h elapsed</span>
            </div>
            <button type="button"
                    @onclick="HandleAdminClockOut"
                    disabled="@_adminIsPunching"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-rose-600 hover:bg-rose-700 disabled:opacity-60 text-white rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm transition-all active:scale-95">
                <span>⏹</span>
                <span>@(_adminIsPunching ? "Recording…" : "Clock Out")</span>
            </button>
        }
        else
        {
            <div class="hidden sm:flex items-center gap-2 text-xs text-slate-500 font-medium">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-500 border border-slate-200">
                    ⚪ OFF DUTY
                </span>
            </div>
            <button type="button"
                    @onclick="HandleAdminClockIn"
                    disabled="@_adminIsPunching"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-60 text-white rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm transition-all active:scale-95">
                <span>▶</span>
                <span>@(_adminIsPunching ? "Recording…" : "Clock In")</span>
            </button>
        }
        @if (!string.IsNullOrWhiteSpace(_adminClockError))
        {
            <span class="text-xs text-rose-600 font-medium">@_adminClockError</span>
        }
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(_actionSuccessMessage))
{
    <div class="mb-4 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-semibold flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold text-base">✓</span>
            <span>@_actionSuccessMessage</span>
        </div>
        <button type="button" @onclick="() => _actionSuccessMessage = null" class="text-emerald-700 hover:text-emerald-900 text-xs font-bold">Dismiss</button>
    </div>
}

@* ── Stacked Concurrent Events & Live Progress (Verify Cash) ───────────────── *@
<LiveEventsOverviewPanel ManagerId="@_adminId" ManagerName="@_adminName" OnCashVerified="LoadPendingRemittancesAsync" />

@* ── Relevant Statistics (KPIs) ───────────────────────────────────────────── *@
<section class="aev-stat-grid" aria-label="Executive KPI statistics">
    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--teal" aria-hidden="true">📅</div>
        <div>
            <p class="aev-stat-card__label">Today's Schedule</p>
            <h2 class="aev-stat-card__value">@_appointmentsToday</h2>
            <p class="text-[11px] text-slate-400 mt-0.5">@_bookingsThisWeek this week</p>
        </div>
    </article>

    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--blue" aria-hidden="true">👥</div>
        <div>
            <p class="aev-stat-card__label">On-Duty Staff</p>
            <h2 class="aev-stat-card__value">@_clockedInStaffCount <span class="text-xs text-slate-400 font-normal">/ @_activeEmployees</span></h2>
            <p class="text-[11px] text-slate-400 mt-0.5">@_onLeaveStaffCount on leave / day off</p>
        </div>
    </article>

    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--violet" aria-hidden="true">📹</div>
        <div>
            <p class="aev-stat-card__label">Active Consultations</p>
            <h2 class="aev-stat-card__value">@_activeConsultations</h2>
            <p class="text-[11px] text-slate-400 mt-0.5">Inquiries in negotiation</p>
        </div>
    </article>
</section>

@* ── Current & Upcoming Events Widget ──────────────────────────────────────── *@
<section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6" aria-label="Current and upcoming events">
    <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-slate-50 to-white flex items-center justify-between">
        <div>
            <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                <span>⚡</span> Current &amp; Upcoming Events Overview
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
                Real-time tracking of active studio sessions, client video consultations, and upcoming schedule slots.
            </p>
        </div>
        <a href="/admin/calendar/events" class="text-xs font-semibold text-teal-700 hover:text-teal-900 hover:underline">
            Open Calendar of Events &rarr;
        </a>
    </div>

    <div class="p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        @* Happening Now Panel *@
        <div class="lg:col-span-5 bg-gradient-to-br from-slate-50 to-slate-100/70 border border-slate-200 rounded-xl p-5 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Live Status</span>
                    @if (_liveEvent != null)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 animate-pulse">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> HAPPENING NOW
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-200 text-slate-600">
                            ☕ Studio Between Sessions
                        </span>
                    }
                </div>

                @if (_liveEvents.Any())
                {
                    <div class="space-y-3">
                        @foreach (var liveEv in _liveEvents)
                        {
                            <div class="space-y-2 p-3 rounded-lg bg-white/80 border border-slate-200/80">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <h3 class="text-base font-bold text-gray-900 leading-tight">@liveEv.ClientName</h3>
                                        <p class="text-xs font-semibold text-teal-700 mt-0.5">@liveEv.ServiceType</p>
                                    </div>
                                    <span class="px-2 py-0.5 rounded-md text-[11px] font-bold @(liveEv.IsConsultation ? "bg-purple-100 text-purple-800" : "bg-blue-100 text-blue-800")">
                                        @(liveEv.IsConsultation ? "Video Consultation" : "Studio Shoot")
                                    </span>
                                </div>

                                <div class="text-xs text-slate-600 space-y-1">
                                    <div class="flex items-center justify-between">
                                        <span class="text-slate-400">Scheduled Time:</span>
                                        <span class="font-bold text-slate-900">@liveEv.FormattedTimeRange</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-slate-400">Assigned Staff:</span>
                                        <span class="font-medium text-slate-800">@liveEv.AssignedPhotographer</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(liveEv.ClientPhone) || !string.IsNullOrWhiteSpace(liveEv.ClientEmail))
                                    {
                                        <div class="flex items-center justify-between">
                                            <span class="text-slate-400">Contact:</span>
                                            <span class="font-mono text-[11px] text-slate-700">@(liveEv.ClientPhone ?? liveEv.ClientEmail)</span>
                                        </div>
                                    }
                                </div>

                                @if (liveEv.IsConsultation && !string.IsNullOrWhiteSpace(liveEv.MeetingLink))
                                {
                                    <div class="pt-1">
                                        <a href="@liveEv.MeetingLink"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold shadow-xs transition-colors">
                                            <span>📹 Launch Google Meet Consultation</span>
                                            <span>↗</span>
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-4 text-center">
                        <div class="w-12 h-12 rounded-full bg-slate-200/80 flex items-center justify-center mx-auto text-xl mb-2">📸</div>
                        <h3 class="text-sm font-semibold text-gray-800">No Session Currently in Progress</h3>
                        <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto">
                            The studio is ready for upcoming bookings. Check the upcoming sessions roster to prepare crew and studio bays.
                        </p>
                    </div>
                }
            </div>

            <div class="mt-4 pt-3 border-t border-slate-200/80 flex items-center justify-between text-[11px]">
                <span class="text-slate-400">Date: @DateTime.Today.ToString("MMM d, yyyy")</span>
                <a href="/admin/calendar/events" class="text-teal-700 hover:underline font-semibold">View Live Calendar &rarr;</a>
            </div>
        </div>

        @* Upcoming Sessions List *@
        <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center justify-between">
                    <span>Upcoming Scheduled Sessions</span>
                    <span class="text-[10px] font-normal text-slate-400">
                        @(_liveEvents.Any()
                            ? $"{_liveEvents.Count} active in execution"
                            : (_upcomingEvents.Any() ? "Closest upcoming event" : "No upcoming events"))
                    </span>
                </h3>

                @if (_liveEvents.Any() && !_upcomingEvents.Any())
                {
                    <div class="p-8 text-center text-xs text-emerald-700 bg-emerald-50/60 rounded-xl border border-dashed border-emerald-200">
                        ⚡ @_liveEvents.Count event@(_liveEvents.Count == 1 ? "" : "s") currently in execution in the Live Status panel.
                    </div>
                }
                else if (!_upcomingEvents.Any())
                {
                    <div class="p-8 text-center text-xs text-gray-400 bg-slate-50 rounded-xl border border-dashed border-gray-200">
                        ✨ No upcoming events scheduled for the rest of today or upcoming days.
                    </div>
                }
                else
                {
                    <div class="space-y-2.5">
                        @foreach (var ev in _upcomingEvents)
                        {
                            var isToday = ev.Date.Date == DateTime.Today;
                            <div class="p-3 rounded-lg border border-gray-200 hover:border-teal-300 hover:bg-teal-50/20 transition-all flex items-center justify-between gap-3 bg-white">
                                <div class="flex items-center gap-3">
                                    <div class="text-center px-2 py-1.5 rounded-md @(isToday ? "bg-amber-100 text-amber-900 border border-amber-200" : "bg-slate-100 text-slate-700")">
                                        <span class="block text-[10px] font-bold uppercase leading-none">@(isToday ? "Today" : ev.Date.ToString("ddd"))</span>
                                        <span class="block text-xs font-extrabold leading-none mt-1">@ev.Date.ToString("MMM d")</span>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-xs text-gray-900">@ev.ClientName</span>
                                            <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold @(ev.IsConsultation ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
                                                @(ev.IsConsultation ? "Consultation" : "Shoot")
                                            </span>
                                        </div>
                                        <p class="text-[11px] text-gray-500 line-clamp-1 mt-0.5">
                                            @ev.ServiceType &bull; <span class="font-medium text-gray-700">@ev.FormattedTimeRange</span>
                                        </p>
                                    </div>
                                </div>

                                <div class="text-right shrink-0">
                                    <span class="block text-[10px] text-gray-400">Staff</span>
                                    <span class="block text-[11px] font-medium text-gray-800">@ev.AssignedPhotographer</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-gray-400">Total active events in pipeline: @_allEvents.Count(e => e.Status != "Cancelled")</span>
                <a href="/admin/calendar/events" class="font-semibold text-teal-700 hover:text-teal-900 hover:underline">
                    View full studio schedule &rarr;
                </a>
            </div>
        </div>
    </div>
</section>

@* ── Staff Timesheet & Attendance (Today) ────────────────────────────────── *@
<section class="aev-card mb-6" aria-label="Staff timesheet and attendance today">
    <header class="aev-card__header">
        <div>
            <h2 class="aev-card__heading">Staff Timesheet &amp; Attendance (Today)</h2>
            <p class="text-xs text-slate-400 mt-0.5">Live clock-in status and duty hours for active photographers &amp; clerks</p>
        </div>
        <a href="/admin/timesheet" class="aev-card__action-link">Open Full Timesheets Portal &rarr;</a>
    </header>
    <div class="aev-table-wrap">
        <table class="aev-table">
            <thead>
                <tr>
                    <th>Staff Member</th>
                    <th>Role / Department</th>
                    <th>Attendance Status</th>
                    <th>Clock In</th>
                    <th>Hours Logged</th>
                </tr>
            </thead>
            <tbody>
                @if (_todayAttendance.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-slate-400 text-xs">
                            No staff attendance records logged for today yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var att in PagedAttendance)
                    {
                        <tr>
                            <td class="font-semibold text-slate-800">@att.EmployeeName</td>
                            <td class="text-xs text-slate-500">@att.EmployeeStudioId</td>
                            <td>
                                <span class="aev-badge @(att.IsOnLeaveToday ? "aev-badge--amber" : att.IsClockedIn ? "aev-badge--green" : "aev-badge--gray")">
                                    @(att.IsOnLeaveToday ? "On Leave" : att.IsClockedIn ? "On Duty" : "Off Duty")
                                </span>
                            </td>
                            <td class="font-mono text-xs text-slate-600">@(att.ClockIn?.ToString("hh:mm tt") ?? "—")</td>
                            <td class="font-mono text-xs font-semibold text-teal-700">@att.TotalHours.ToString("0.0") hrs</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <TablePagination TotalItems="_todayAttendance.Count" PageSize="10" @bind-CurrentPage="_attendancePage" ItemLabel="staff" />
    </div>
</section>

@* ── Staff Leave Requests (Submitted by Employees) ─────────────────────────── *@
<section class="aev-card mb-6" aria-label="Pending staff leave requests">
    <header class="aev-card__header">
        <div>
            <h2 class="aev-card__heading">Staff Leave Requests</h2>
            <p class="text-xs text-slate-400 mt-0.5">Review employee leave requests; approved leaves block booking assignments automatically</p>
        </div>
        <a href="/admin/calendar/events" class="aev-card__action-link">Staff Schedule &amp; Days Off &rarr;</a>
    </header>
    <div class="aev-table-wrap">
        <table class="aev-table">
            <thead>
                <tr>
                    <th>Staff Member</th>
                    <th>Leave Type</th>
                    <th>Dates</th>
                    <th>Description</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (_pendingLeaves.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-slate-400 text-xs">
                            No pending leave requests awaiting approval.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var lv in PagedPendingLeaves)
                    {
                        <tr>
                            <td>
                                <div class="font-semibold text-slate-800">@lv.EmployeeName</div>
                                <div class="text-[11px] font-mono text-slate-400">@lv.EmployeeStudioId</div>
                            </td>
                            <td class="text-xs font-semibold text-slate-700">@lv.LeaveType</td>
                            <td class="font-mono text-xs text-slate-600">@lv.StartDate.ToString("MMM d") – @lv.EndDate.ToString("MMM d, yyyy")</td>
                            <td class="text-xs text-slate-500 max-w-xs truncate">@(string.IsNullOrWhiteSpace(lv.Reason) ? "—" : lv.Reason)</td>
                            <td class="text-right whitespace-nowrap">
                                <button type="button"
                                        disabled="@_isProcessingLeave"
                                        @onclick="() => HandleApproveLeaveAsync(lv)"
                                        class="px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-bold mr-1 disabled:opacity-50">
                                    Approve
                                </button>
                                <button type="button"
                                        disabled="@_isProcessingLeave"
                                        @onclick="() => HandleRejectLeaveAsync(lv)"
                                        class="px-2.5 py-1 rounded bg-rose-600 hover:bg-rose-700 text-white text-[11px] font-bold disabled:opacity-50">
                                    Reject
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <TablePagination TotalItems="_pendingLeaves.Count" PageSize="10" @bind-CurrentPage="_leavesPage" ItemLabel="requests" />
    </div>
</section>

@* ── Recent Bookings & Quick Actions ───────────────────────────────────────── *@
<div class="aev-content-row">
    <section class="aev-card aev-card--wide" aria-label="Recent bookings">
        <header class="aev-card__header">
            <h2 class="aev-card__heading">Recent Bookings</h2>
            <a href="/admin/calendar/events" class="aev-card__action-link">View All</a>
        </header>
        <div class="aev-table-wrap">
            <table class="aev-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Service</th>
                        <th>Date &amp; Time</th>
                        <th>Deposit (15%)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_recentBookings.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-6 text-slate-400">
                                No bookings found in the database.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var booking in PagedRecentBookings)
                        {
                            <tr>
                                <td>@booking.CustomerName</td>
                                <td>@booking.EventName</td>
                                <td>@booking.EventDate.ToString("MMM d, yyyy") &bull; @(DateTime.Today.Add(booking.EventTime).ToString("h:mm tt"))</td>
                                <td class="text-teal-700 font-semibold text-xs">₱@booking.DepositAmount.ToString("N2")</td>
                                <td>
                                    <span class="aev-badge @(booking.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) || booking.Status.Equals("Scheduled", StringComparison.OrdinalIgnoreCase) ? "aev-badge--green" : "aev-badge--amber")">
                                        @booking.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <TablePagination TotalItems="_recentBookings.Count" PageSize="10" @bind-CurrentPage="_bookingsPage" ItemLabel="bookings" />
        </div>
    </section>

    <section class="aev-card" aria-label="Quick actions">
        <header class="aev-card__header">
            <h2 class="aev-card__heading">Quick Actions</h2>
        </header>
        <div class="aev-quick-actions">
            <a href="/admin/approvals" class="aev-quick-action">
                <span class="aev-quick-action__icon" aria-hidden="true">💵</span>
                <span>Review Remittances</span>
                <span class="aev-quick-action__arrow" aria-hidden="true">›</span>
            </a>
            <a href="/admin/services/main" class="aev-quick-action">
                <span class="aev-quick-action__icon" aria-hidden="true">🗂</span>
                <span>Manage Main Services</span>
                <span class="aev-quick-action__arrow" aria-hidden="true">›</span>
            </a>
            <a href="/admin/calendar/events" class="aev-quick-action">
                <span class="aev-quick-action__icon" aria-hidden="true">📅</span>
                <span>Calendar of Events</span>
                <span class="aev-quick-action__arrow" aria-hidden="true">›</span>
            </a>
            <a href="/admin/employees" class="aev-quick-action">
                <span class="aev-quick-action__icon" aria-hidden="true">👤</span>
                <span>Manage Staff</span>
                <span class="aev-quick-action__arrow" aria-hidden="true">›</span>
            </a>
            <a href="/admin/timesheet" class="aev-quick-action">
                <span class="aev-quick-action__icon" aria-hidden="true">⏱️</span>
                <span>Staff Timesheets</span>
                <span class="aev-quick-action__arrow" aria-hidden="true">›</span>
            </a>
            <a href="/admin/negotiations" class="aev-quick-action">
                <span class="aev-quick-action__icon" aria-hidden="true">💬</span>
                <span>Client Inquiries &amp; Calls</span>
                <span class="aev-quick-action__arrow" aria-hidden="true">›</span>
            </a>
            <a href="/admin/faqs" class="aev-quick-action">
                <span class="aev-quick-action__icon" aria-hidden="true">❓</span>
                <span>FAQ Management</span>
                <span class="aev-quick-action__arrow" aria-hidden="true">›</span>
            </a>
        </div>
    </section>
</div>

@code {
    private int _appointmentsToday;
    private int _activeEmployees;
    private int _bookingsThisWeek;
    private int _clockedInStaffCount;
    private int _onLeaveStaffCount;
    private int _activeConsultations;
    private decimal _totalBookedDeposits;
    private int _totalActiveBookings;

    private List<EventBookingModel> _allEvents = new();
    private List<EventBookingModel> _liveEvents = new();
    private EventBookingModel? _liveEvent => _liveEvents.FirstOrDefault();
    private List<EventBookingModel> _upcomingEvents = new();

    private IReadOnlyList<TodayAttendanceSummaryDto> _todayAttendance = Array.Empty<TodayAttendanceSummaryDto>();
    private List<LeaveItemViewModel> _pendingLeaves = new();
    private bool _isProcessingLeave = false;
    private IReadOnlyList<BookingRowDto> _recentBookings = Array.Empty<BookingRowDto>();
    private int _attendancePage = 1;
    private int _leavesPage = 1;
    private int _bookingsPage = 1;
    private List<TodayAttendanceSummaryDto> PagedAttendance => TablePagination.Paginate(_todayAttendance, _attendancePage, 10);
    private List<LeaveItemViewModel> PagedPendingLeaves => TablePagination.Paginate(_pendingLeaves, _leavesPage, 10);
    private List<BookingRowDto> PagedRecentBookings => TablePagination.Paginate(_recentBookings, _bookingsPage, 10);
    private List<PaymentSummaryModel> _pendingRemittances = new();
    private decimal _pendingRemittancesSum => _pendingRemittances.Sum(r => r.Amount);


    private bool _isApproving = false;
    private string? _actionSuccessMessage;
    private string _adminId = "Admin";
    private string _adminName = "System Administrator";

    // ── Admin Clock In/Out State ─────────────────────────────────────────
    private ClockStatusViewModel _adminClockStatus = new();
    private bool _adminIsPunching = false;
    private string? _adminClockError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                _adminId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value ?? "Admin";
                _adminName = user.FindFirst("full_name")?.Value ?? user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity.Name ?? "System Administrator";
            }
        }
        catch { }

        // 1. Dispatch independent async API queries in parallel via Task.WhenAll
        var statsTask = SafeGetStatsAsync();
        var attendanceTask = SafeGetAttendanceAsync();
        var remittancesTask = LoadPendingRemittancesAsync();
        var leavesTask = LoadPendingLeavesAsync();

        // 2. Bookings & Revenue
        try
        {
            var allBookings = UserService.GetBookings();
            _recentBookings = allBookings.Take(5).ToList();
            var activeBookings = allBookings.Where(b => !string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)).ToList();
            _totalActiveBookings = activeBookings.Count;
            _totalBookedDeposits = activeBookings.Sum(b => b.DepositAmount);
        }
        catch
        {
            _recentBookings = Array.Empty<BookingRowDto>();
            _totalActiveBookings = 0;
            _totalBookedDeposits = 0;
        }

        // 3. Events & Consultations (ScheduleService)
        try
        {
            _allEvents = ScheduleService.GetEventBookings();
            _activeConsultations = _allEvents.Count(e =>
                e.IsConsultation &&
                !e.IsAppointmentBooked &&
                !e.IsCompleted &&
                !string.Equals(e.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(e.Status, "Deal_Lost", StringComparison.OrdinalIgnoreCase));

            var today = DateTime.Today;
            var nowTime = DateTime.Now.TimeOfDay;

            static bool IsExecutingStatus(EventBookingModel e) =>
                e.Status.Equals("Ongoing", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("On Going", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("In Execution", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Ready", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Preparation", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Preparing", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Dispatch", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Post Event", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Event Done", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Payment Verification (Cash)", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Paid Cash Pending Verification", StringComparison.OrdinalIgnoreCase) ||
                e.Status.Equals("Pending Verification", StringComparison.OrdinalIgnoreCase);

            static bool IsInactiveOrFinished(EventBookingModel e) =>
                e.IsCompleted ||
                string.Equals(e.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(e.Status, "Expired", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(e.Status, "Deal_Lost", StringComparison.OrdinalIgnoreCase);

            _liveEvents = _allEvents
                .Where(e => !IsInactiveOrFinished(e))
                .Where(e => IsExecutingStatus(e) || (e.Date.Date == today && nowTime >= e.StartTime && nowTime < e.EffectiveEndTime))
                .OrderBy(e => e.Date.Date)
                .ThenBy(e => e.StartTime)
                .ToList();

            _upcomingEvents = _liveEvents.Any()
                ? new List<EventBookingModel>()
                : _allEvents
                    .Where(e => !IsInactiveOrFinished(e))
                    .Where(e => (e.Date.Date == today && e.StartTime > nowTime) || (e.Date.Date > today))
                    .OrderBy(e => e.Date.Date)
                    .ThenBy(e => e.StartTime)
                    .Take(1)
                    .ToList();
        }
        catch
        {
            _allEvents = new();
            _activeConsultations = 0;
            _liveEvents = new();
            _upcomingEvents = new();
        }

        // 4. Await parallel async tasks
        var adminClockTask = SafeGetAdminClockStatusAsync();
        await Task.WhenAll(statsTask, attendanceTask, remittancesTask, leavesTask, adminClockTask);
    }

    private async Task LoadPendingLeavesAsync()
    {
        try
        {
            _pendingLeaves = (await EmployeeService.GetPendingLeavesAsync()).ToList();
        }
        catch
        {
            _pendingLeaves = new();
        }
    }

    private async Task HandleApproveLeaveAsync(LeaveItemViewModel lv)
    {
        _isProcessingLeave = true;
        _actionSuccessMessage = null;
        try
        {
            var ok = await EmployeeService.ApproveLeaveAsync(lv.Id);
            if (ok)
            {
                ScheduleService.InvalidateCache();
                _actionSuccessMessage = $"Approved {lv.LeaveType} for {lv.EmployeeName} ({lv.StartDate:MMM d} – {lv.EndDate:MMM d, yyyy}). Booking assignments during this period are now blocked.";
                await Task.WhenAll(LoadPendingLeavesAsync(), SafeGetAttendanceAsync());
            }
        }
        finally
        {
            _isProcessingLeave = false;
        }
    }

    private async Task HandleRejectLeaveAsync(LeaveItemViewModel lv)
    {
        _isProcessingLeave = true;
        _actionSuccessMessage = null;
        try
        {
            var ok = await EmployeeService.RejectLeaveAsync(lv.Id, "Declined by Studio Admin from Dashboard.");
            if (ok)
            {
                ScheduleService.InvalidateCache();
                _actionSuccessMessage = $"Rejected {lv.LeaveType} request for {lv.EmployeeName}.";
                await LoadPendingLeavesAsync();
            }
        }
        finally
        {
            _isProcessingLeave = false;
        }
    }

    private async Task SafeGetStatsAsync()
    {
        try
        {
            var stats = await EmployeeService.GetDashboardStatsAsync();
            _appointmentsToday = stats.AppointmentsToday;
            _activeEmployees = stats.ActiveEmployees;
            _bookingsThisWeek = stats.BookedThisWeek;
        }
        catch
        {
            _appointmentsToday = 0;
            _activeEmployees = 0;
            _bookingsThisWeek = 0;
        }
    }

    private async Task SafeGetAttendanceAsync()
    {
        try
        {
            _todayAttendance = await EmployeeService.GetTodayAttendanceAsync();
            _clockedInStaffCount = _todayAttendance.Count(a => a.IsClockedIn);
            _onLeaveStaffCount = _todayAttendance.Count(a => a.IsOnLeaveToday || a.IsDayOffToday);
        }
        catch
        {
            _todayAttendance = Array.Empty<TodayAttendanceSummaryDto>();
            _clockedInStaffCount = 0;
            _onLeaveStaffCount = 0;
        }
    }

    private async Task LoadPendingRemittancesAsync()
    {
        try
        {
            var res = await ConsultationApi.GetPendingRemittancesAsync();
            if (res.IsSuccess && res.Value != null)
            {
                _pendingRemittances = res.Value.ToList();
                return;
            }
        }
        catch { }

        _pendingRemittances = UserService.GetPendingCashRemittances();
    }

    private async Task HandleApproveRemittance(PaymentSummaryModel rem)
    {
        _isApproving = true;
        _actionSuccessMessage = null;

        try
        {
            var req = new AdminApproveRemittanceModel
            {
                AdminId = _adminId,
                AdminName = _adminName,
                Notes = $"Approved cash remittance from Admin Dashboard on {DateTime.Now:g}"
            };

            var res = await ConsultationApi.ApproveRemittanceAsync(rem.Id, req);
            if (!res.IsSuccess)
            {
                UserService.ApproveCashRemittance(rem.Id, _adminId);
            }

            _actionSuccessMessage = $"Cash remittance of ₱{rem.Amount:N2} (Payment #{rem.Id}) for Employee {rem.EmployeeName ?? rem.EmployeeId} approved and cleared successfully.";
            await LoadPendingRemittancesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _actionSuccessMessage = $"Approval processed with note: {ex.Message}";
        }
        finally
        {
            _isApproving = false;
        }
    }

    // ── Admin Clock In/Out ───────────────────────────────────────────────
    private async Task SafeGetAdminClockStatusAsync()
    {
        try
        {
            _adminClockStatus = await TimesheetService.GetClockStatusAsync(_adminId);
        }
        catch
        {
            _adminClockStatus = new ClockStatusViewModel { EmployeeStudioId = _adminId };
        }
    }

    private async Task HandleAdminClockIn()
    {
        _adminIsPunching = true;
        _adminClockError = null;
        try
        {
            var ok = await TimesheetService.ClockInAsync(_adminId, notes: null, employeeName: _adminName);
            if (ok)
            {
                await SafeGetAdminClockStatusAsync();
                StateHasChanged();
            }
            else
            {
                _adminClockError = "Clock-in failed. You may already be clocked in.";
            }
        }
        catch (Exception ex)
        {
            _adminClockError = ex.Message;
        }
        finally
        {
            _adminIsPunching = false;
        }
    }

    private async Task HandleAdminClockOut()
    {
        _adminIsPunching = true;
        _adminClockError = null;
        try
        {
            var ok = await TimesheetService.ClockOutAsync(_adminId, notes: null, employeeName: _adminName);
            if (ok)
            {
                await SafeGetAdminClockStatusAsync();
                StateHasChanged();
            }
            else
            {
                _adminClockError = "Clock-out failed. No active shift found.";
            }
        }
        catch (Exception ex)
        {
            _adminClockError = ex.Message;
        }
        finally
        {
            _adminIsPunching = false;
        }
    }
}
