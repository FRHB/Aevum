@page "/AdminDashboard"
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>Admin Dashboard | Photo Aevum Studio</PageTitle>

<div class="mb-10">
    <h1 class="text-3xl md:text-5xl font-bold text-gray-900 tracking-tighter mb-2">Dashboard Overview</h1>
    <p class="text-gray-500 font-light text-lg">@DateTime.Today.ToString("dddd, MMMM d")</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center flex-shrink-0">
            <i data-lucide="calendar-check" class="w-6 h-6"></i>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500 mb-1">Appointments Today</p>
            <h3 class="text-2xl font-bold text-neutral-900 mb-0.5 leading-none">4</h3>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
            <i data-lucide="users" class="w-6 h-6"></i>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500 mb-1">Active Employees</p>
            <h3 class="text-2xl font-bold text-neutral-900 mb-0.5 leading-none">12</h3>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
    <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
        <div class="px-6 py-5 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-lg font-bold text-neutral-900">Recent Bookings</h2>
            <a href="/Schedules" class="text-sm font-medium text-teal-600 hover:text-teal-700">View All</a>
        </div>
        <div class="overflow-x-auto flex-1">
            <table class="w-full text-left text-sm">
                <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-xs font-semibold border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-4">Client</th>
                        <th class="px-6 py-4">Service</th>
                        <th class="px-6 py-4">Date & Time</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-neutral-900">Sarah Jenkins</td>
                        <td class="px-6 py-4 text-gray-600">Express Headshot</td>
                        <td class="px-6 py-4 text-gray-600">Today, 2:00 PM</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col">
        <div class="px-6 py-5 border-b border-gray-200">
            <h2 class="text-lg font-bold text-neutral-900">Quick Actions</h2>
        </div>
        <div class="p-6 space-y-4 flex-1">
            <a href="/Services" class="w-full py-3 px-4 flex items-center justify-between text-left bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 transition-colors group">
                <span class="flex items-center gap-3 font-medium text-gray-700">
                    <i data-lucide="layers" class="w-5 h-5 text-gray-400 group-hover:text-teal-600 transition-colors"></i> Manage Services
                </span>
                <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            </a>
            <a href="/Equipment" class="w-full py-3 px-4 flex items-center justify-between text-left bg-gray-50 border border-gray-200 rounded-lg hover:bg-gray-100 transition-colors group">
                <span class="flex items-center gap-3 font-medium text-gray-700">
                    <i data-lucide="package" class="w-5 h-5 text-gray-400 group-hover:text-teal-600 transition-colors"></i> Track Equipment
                </span>
                <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            </a>
        </div>
    </div>
</div>