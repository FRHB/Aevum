@page "/admin"
@page "/Admin/Dashboard"
@layout AdminLayout
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Models

@inject IEmployeeService EmployeeService 
@implements IDisposable

<PageTitle>Admin Dashboard | Photo Aevum Studio</PageTitle>

<section class="bg-gray-50 min-h-screen py-12">
    <!-- Dashboard content goes here -->
</section>

<section class="bg-gray-50 min-h-screen py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- DASHBOARD HEADER -->
        <div class="mb-10">
            <h1 class="text-3xl md:text-5xl font-bold text-gray-900 tracking-tighter mb-2">Dashboard</h1>
            <p class="text-gray-500 font-light">@DateTime.Today.ToString("dddd, MMMM d")</p>
        </div>

        <!-- 1. STAT WIDGETS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            @if (stats is null)
            {
                @for (var i = 0; i < 4; i++)
                {
                    <div class="image-placeholder h-32 bg-gray-100" aria-hidden="true"></div>
                }
            }
            else
            {
                @foreach (var (label, value, note) in StatCards())
                {
                    <div class="service-card bg-white p-6">
                        <p class="text-sm text-gray-500 mb-3">@label</p>
                        <p class="text-4xl font-bold tracking-tighter text-gray-900 mb-1">@value</p>
                        <p class="text-xs text-gray-400">@note</p>
                    </div>
                }
            }
        </div>

        <!-- 2. AVAILABILITY TABLE -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Available times</h2>
                <p class="text-gray-500 font-light text-sm">Next 7 days. Open slots are outlined; booked slots are struck through.</p>
            </div>
            <a href="/admin/employees" class="text-sm font-bold text-gray-900 uppercase tracking-wider hover:underline">Manage employees</a>
        </div>

        <div class="bg-white border border-gray-200 overflow-x-auto mb-12">
            @if (week is null)
            {
                <div class="p-6 space-y-4" aria-hidden="true">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="image-placeholder h-10 bg-gray-100"></div>
                    }
                </div>
            }
            else
            {
                <table class="w-full text-left text-sm">
                    <thead class="border-b border-gray-200 text-gray-500">
                        <tr>
                            <th scope="col" class="px-6 py-4 font-medium whitespace-nowrap">Date</th>
                            <th scope="col" class="px-6 py-4 font-medium">Times</th>
                            <th scope="col" class="px-6 py-4 font-medium text-right whitespace-nowrap">Open / Booked</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var day in week)
                        {
                            <tr>
                                <th scope="row" class="px-6 py-4 font-semibold text-gray-900 whitespace-nowrap align-top">
                                    @day.Date.ToString("ddd, MMM d")
                                    @if (day.Date == DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <span class="ml-2 bg-gray-900 text-white text-xs font-bold px-2 py-0.5">Today</span>
                                    }
                                </th>
                                <td class="px-6 py-4">
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var slot in day.Slots)
                                        {
                                            <span class="px-3 py-1 text-xs @(slot.IsAvailable
                                                ? "border border-gray-900 text-gray-900"
                                                : "bg-gray-100 text-gray-400 line-through")">
                                                @slot.Start.ToString("h:mm tt")
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap align-top text-gray-900">
                                    <span class="font-semibold">@day.OpenCount</span>
                                    <span class="text-gray-400"> / @day.BookedCount</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- 3. ADVANCED DASHBOARD MODULES -->
        <div class="dashboard-container">
            <div class="dashboard-grid">

                <!-- SCHEDULES MODULE -->
                <section class="dashboard-card">
                    <div>
                        <div class="card-header">
                            <h2>Upcoming Schedules</h2>
                            <span class="badge">Timeline</span>
                        </div>
                        <div class="card-body-space">
                            @if (DashboardData?.Schedules != null && DashboardData.Schedules.Any())
                            {
                                @foreach (var schedule in DashboardData.Schedules)
                                {
                                    <div class="sub-card" @key="schedule.Id">
                                        <div>
                                            <p class="sub-title">@schedule.Title</p>
                                            <p class="sub-desc">@schedule.ClientName</p>
                                        </div>
                                        <span class="time-badge">@schedule.StartTime.ToString("MMM dd, HH:mm")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="sub-card">
                                    <div>
                                        <p class="sub-title">System Architecture Review</p>
                                        <p class="sub-desc">Client: Acme Corp</p>
                                    </div>
                                    <span class="time-badge">Oct 01, 10:00</span>
                                </div>
                                <div class="sub-card">
                                    <div>
                                        <p class="sub-title">Database Migration Check</p>
                                        <p class="sub-desc">Client: Globex Ltd</p>
                                    </div>
                                    <span class="time-badge">Oct 02, 14:30</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/Admin/Schedules" class="footer-link">View full calendar &rarr;</a>
                    </div>
                </section>

                <!-- EMPLOYEES MODULE -->
                <section class="dashboard-card">
                    <div>
                        <div class="card-header">
                            <h2>Staff Members</h2>
                            <span class="badge">Active Team</span>
                        </div>
                        <div class="card-body-space">
                            @if (DashboardData?.Employees != null && DashboardData.Employees.Any())
                            {
                                @foreach (var emp in DashboardData.Employees)
                                {
                                    <div class="employee-row" @key="emp.Id">
                                        <div class="employee-info">
                                            <div class="avatar">@emp.Initials</div>
                                            <div>
                                                <p class="sub-title">@emp.FullName</p>
                                                <p class="sub-desc">@emp.Role</p>
                                            </div>
                                        </div>
                                        <span class="status-pill @(emp.IsActive ? "pill-active" : "pill-away")">
                                            @(emp.IsActive ? "Active" : "Away")
                                        </span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="employee-row">
                                    <div class="employee-info">
                                        <div class="avatar">JD</div>
                                        <div>
                                            <p class="sub-title">Jane Doe</p>
                                            <p class="sub-desc">Senior Architect</p>
                                        </div>
                                    </div>
                                    <span class="status-pill pill-active">Active</span>
                                </div>
                                <div class="employee-row">
                                    <div class="employee-info">
                                        <div class="avatar">JS</div>
                                        <div>
                                            <p class="sub-title">John Smith</p>
                                            <p class="sub-desc">Backend Engineer</p>
                                        </div>
                                    </div>
                                    <span class="status-pill pill-away">Away</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/Admin/Employees" class="footer-link">Manage directory &rarr;</a>
                    </div>
                </section>

                <!-- SERVICES MODULE -->
                <section class="dashboard-card">
                    <div>
                        <div class="card-header">
                            <h2>Core Services</h2>
                            <span class="badge">Offerings</span>
                        </div>
                        <div class="card-body-space">
                            @if (DashboardData?.Services != null && DashboardData.Services.Any())
                            {
                                @foreach (var service in DashboardData.Services)
                                {
                                    <div class="service-row" @key="service.Id">
                                        <div>
                                            <p class="sub-title">@service.Name</p>
                                            <p class="sub-desc">@service.Duration minutes</p>
                                        </div>
                                        <span class="price-text">$@service.Price</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="service-row">
                                    <div>
                                        <p class="sub-title">Cloud Architecture Consultation</p>
                                        <p class="sub-desc">60 minutes</p>
                                    </div>
                                    <span class="price-text">$150</span>
                                </div>
                                <div class="service-row">
                                    <div>
                                        <p class="sub-title">Performance Optimization Audit</p>
                                        <p class="sub-desc">90 minutes</p>
                                    </div>
                                    <span class="price-text">$250</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/Admin/Services" class="footer-link">View catalog &rarr;</a>
                    </div>
                </section>

                <!-- EQUIPMENT TRACKER MODULE -->
                <section class="dashboard-card equipment-card-span">
                    <div>
                        <div class="card-header">
                            <h2>Equipment Tracker</h2>
                            <span class="badge">Hardware Inventory</span>
                        </div>

                        <div class="table-container">
                            <table class="inventory-table">
                                <thead>
                                    <tr>
                                        <th>Item Name</th>
                                        <th>Serial No.</th>
                                        <th>Assigned To</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (DashboardData?.EquipmentList != null && DashboardData.EquipmentList.Any())
                                    {
                                        @foreach (var item in DashboardData.EquipmentList)
                                        {
                                            <tr @key="item.Id">
                                                <td class="font-medium">@item.Name</td>
                                                <td class="text-secondary">@item.SerialNumber</td>
                                                <td class="text-secondary">@item.AssignedEmployee</td>
                                                <td>
                                                    <span class="status-pill @(item.Status == "Available" ? "pill-active" : "pill-purple")">
                                                        @item.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td class="font-medium">MacBook Pro 16"</td>
                                            <td class="text-secondary">SN-998234-X</td>
                                            <td class="text-secondary">Jane Doe</td>
                                            <td>
                                                <span class="status-pill pill-purple">In Use</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="font-medium">Dell UltraSharp Monitor</td>
                                            <td class="text-secondary">SN-442109-B</td>
                                            <td class="text-secondary">Unassigned</td>
                                            <td>
                                                <span class="status-pill pill-active">Available</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="/Admin/Equipment" class="footer-link">Manage inventory &rarr;</a>
                    </div>
                </section>

            </div>
        </div>

    </div>
</section>

@code {
    [Parameter]
    public AdminDashboardViewModel? DashboardData { get; set; }

    private DashboardStatsViewModel? stats;
    private IReadOnlyList<DayAvailabilityViewModel>? week;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        
        // Changed to use the renamed injected service
        var statsTask = EmployeeService.GetDashboardStatsAsync(_cts.Token);
        var weekTask = EmployeeService.GetAvailabilityAsync(7, _cts.Token);
        
        await Task.WhenAll(statsTask, weekTask);
        
        stats = statsTask.Result;
        week = weekTask.Result;

        if (DashboardData == null)
        {
            DashboardData = new AdminDashboardViewModel();
        }
    }

    private IEnumerable<(string Label, string Value, string Note)> StatCards()
    {
        yield return ("Appointments today", stats!.AppointmentsToday.ToString(), "Booked sessions on today's schedule");
        yield return ("Active employees", stats.ActiveEmployees.ToString(), "Available for new bookings");
        yield return ("Open slots this week", stats.OpenSlotsThisWeek.ToString(), "Times clients can still book");
        yield return ("Booked this week", stats.BookedThisWeek.ToString(), "Confirmed appointments, next 7 days");
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}