@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserService UserService
@inject IEmployeeService EmployeeService
@inject IScheduleService ScheduleService
@inject IConsultationClient ConsultationApi
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Admin Dashboard | Photo Aevum Studio</PageTitle>

<header class="aev-page-header">
    <div>
        <h1 class="aev-page-header__title">Dashboard Overview</h1>
        <p class="aev-page-header__subtitle">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(_actionSuccessMessage))
{
    <div class="mb-4 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-semibold flex items-center justify-between shadow-xs">
        <div class="flex items-center gap-2">
            <span class="text-emerald-600 font-bold text-base">✓</span>
            <span>@_actionSuccessMessage</span>
        </div>
        <button type="button" @onclick="() => _actionSuccessMessage = null" class="text-emerald-700 hover:text-emerald-900 text-xs font-bold">Dismiss</button>
    </div>
}

@* ── Relevant Statistics (KPIs) ───────────────────────────────────────────── *@
<section class="aev-stat-grid" aria-label="Executive KPI statistics">
    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--teal" aria-hidden="true">📅</div>
        <div>
            <p class="aev-stat-card__label">Today's Schedule</p>
            <h2 class="aev-stat-card__value">@_appointmentsToday</h2>
            <p class="text-[11px] text-slate-400 mt-0.5">@_bookingsThisWeek this week</p>
        </div>
    </article>

    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--blue" aria-hidden="true">👥</div>
        <div>
            <p class="aev-stat-card__label">On-Duty Staff</p>
            <h2 class="aev-stat-card__value">@_clockedInStaffCount <span class="text-xs text-slate-400 font-normal">/ @_activeEmployees</span></h2>
            <p class="text-[11px] text-slate-400 mt-0.5">@_onLeaveStaffCount on leave / day off</p>
        </div>
    </article>

    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--violet" aria-hidden="true">📹</div>
        <div>
            <p class="aev-stat-card__label">Active Consultations</p>
            <h2 class="aev-stat-card__value">@_activeConsultations</h2>
            <p class="text-[11px] text-slate-400 mt-0.5">Inquiries in negotiation</p>
        </div>
    </article>

    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--amber" aria-hidden="true">💵</div>
        <div>
            <p class="aev-stat-card__label">Cash to Reconcile</p>
            <h2 class="aev-stat-card__value text-amber-600">@_pendingRemittances.Count</h2>
            <p class="text-[11px] text-slate-400 mt-0.5">₱@_pendingRemittancesSum.ToString("N0") awaiting review</p>
        </div>
    </article>

    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--teal" aria-hidden="true">💰</div>
        <div>
            <p class="aev-stat-card__label">Booked Deposits</p>
            <h2 class="aev-stat-card__value text-emerald-700">₱@_totalBookedDeposits.ToString("N0")</h2>
            <p class="text-[11px] text-slate-400 mt-0.5">@_totalActiveBookings confirmed sessions</p>
        </div>
    </article>
</section>

@* ── Current & Upcoming Events Widget ──────────────────────────────────────── *@
<section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6" aria-label="Current and upcoming events">
    <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-slate-50 to-white flex items-center justify-between">
        <div>
            <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                <span>⚡</span> Current &amp; Upcoming Events Overview
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
                Real-time tracking of active studio sessions, client video consultations, and upcoming schedule slots.
            </p>
        </div>
        <a href="/admin/calendar/events" class="text-xs font-semibold text-teal-700 hover:text-teal-900 hover:underline">
            Open Calendar of Events &rarr;
        </a>
    </div>

    <div class="p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        @* Happening Now Panel *@
        <div class="lg:col-span-5 bg-gradient-to-br from-slate-50 to-slate-100/70 border border-slate-200 rounded-xl p-5 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Live Status</span>
                    @if (_liveEvent != null)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 animate-pulse">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> HAPPENING NOW
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-200 text-slate-600">
                            ☕ Studio Between Sessions
                        </span>
                    }
                </div>

                @if (_liveEvent != null)
                {
                    <div class="space-y-3">
                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="text-base font-bold text-gray-900 leading-tight">@_liveEvent.ClientName</h3>
                                <p class="text-xs font-semibold text-teal-700 mt-0.5">@_liveEvent.ServiceType</p>
                            </div>
                            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold @(_liveEvent.IsConsultation ? "bg-purple-100 text-purple-800" : "bg-blue-100 text-blue-800")">
                                @(_liveEvent.IsConsultation ? "Video Consultation" : "Studio Shoot")
                            </span>
                        </div>

                        <div class="text-xs text-slate-600 space-y-1 bg-white/80 p-3 rounded-lg border border-slate-200/60">
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Scheduled Time:</span>
                                <span class="font-bold text-slate-900">@_liveEvent.FormattedTimeRange</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Assigned Staff:</span>
                                <span class="font-medium text-slate-800">@_liveEvent.AssignedPhotographer</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_liveEvent.ClientPhone) || !string.IsNullOrWhiteSpace(_liveEvent.ClientEmail))
                            {
                                <div class="flex items-center justify-between">
                                    <span class="text-slate-400">Contact:</span>
                                    <span class="font-mono text-[11px] text-slate-700">@(_liveEvent.ClientPhone ?? _liveEvent.ClientEmail)</span>
                                </div>
                            }
                        </div>

                        @if (_liveEvent.IsConsultation && !string.IsNullOrWhiteSpace(_liveEvent.MeetingLink))
                        {
                            <div class="pt-2">
                                <a href="@_liveEvent.MeetingLink"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold shadow-xs transition-colors">
                                    <span>📹 Launch Google Meet Consultation</span>
                                    <span>↗</span>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-4 text-center">
                        <div class="w-12 h-12 rounded-full bg-slate-200/80 flex items-center justify-center mx-auto text-xl mb-2">📸</div>
                        <h3 class="text-sm font-semibold text-gray-800">No Session Currently in Progress</h3>
                        <p class="text-xs text-slate-500 mt-1 max-w-xs mx-auto">
                            The studio is ready for upcoming bookings. Check the upcoming sessions roster to prepare crew and studio bays.
                        </p>
                    </div>
                }
            </div>

            <div class="mt-4 pt-3 border-t border-slate-200/80 flex items-center justify-between text-[11px]">
                <span class="text-slate-400">Date: @DateTime.Today.ToString("MMM d, yyyy")</span>
                <a href="/admin/calendar/events" class="text-teal-700 hover:underline font-semibold">View Live Calendar &rarr;</a>
            </div>
        </div>

        @* Upcoming Sessions List *@
        <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center justify-between">
                    <span>Upcoming Scheduled Sessions</span>
                    <span class="text-[10px] font-normal text-slate-400">Next @Math.Min(4, _upcomingEvents.Count) events</span>
                </h3>

                @if (!_upcomingEvents.Any())
                {
                    <div class="p-8 text-center text-xs text-gray-400 bg-slate-50 rounded-xl border border-dashed border-gray-200">
                        ✨ No upcoming events scheduled for the rest of today or tomorrow.
                    </div>
                }
                else
                {
                    <div class="space-y-2.5">
                        @foreach (var ev in _upcomingEvents)
                        {
                            var isToday = ev.Date.Date == DateTime.Today;
                            <div class="p-3 rounded-lg border border-gray-200 hover:border-teal-300 hover:bg-teal-50/20 transition-all flex items-center justify-between gap-3 bg-white">
                                <div class="flex items-center gap-3">
                                    <div class="text-center px-2 py-1.5 rounded-md @(isToday ? "bg-amber-100 text-amber-900 border border-amber-200" : "bg-slate-100 text-slate-700")">
                                        <span class="block text-[10px] font-bold uppercase leading-none">@(isToday ? "Today" : ev.Date.ToString("ddd"))</span>
                                        <span class="block text-xs font-extrabold leading-none mt-1">@ev.Date.ToString("MMM d")</span>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-xs text-gray-900">@ev.ClientName</span>
                                            <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold @(ev.IsConsultation ? "bg-purple-100 text-purple-700" : "bg-blue-100 text-blue-700")">
                                                @(ev.IsConsultation ? "Consultation" : "Shoot")
                                            </span>
                                        </div>
                                        <p class="text-[11px] text-gray-500 line-clamp-1 mt-0.5">
                                            @ev.ServiceType &bull; <span class="font-medium text-gray-700">@ev.FormattedTimeRange</span>
                                        </p>
                                    </div>
                                </div>

                                <div class="text-right shrink-0">
                                    <span class="block text-[10px] text-gray-400">Staff</span>
                                    <span class="block text-[11px] font-medium text-gray-800">@ev.AssignedPhotographer</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <span class="text-gray-400">Total active events in pipeline: @_allEvents.Count(e => e.Status != "Cancelled")</span>
                <a href="/admin/calendar/events" class="font-semibold text-teal-700 hover:text-teal-900 hover:underline">
                    View full studio schedule &rarr;
                </a>
            </div>
        </div>
    </div>
</section>

@* ── Timesheet & Today's Attendance View ───────────────────────────────────── *@
<section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6" aria-label="Staff timesheet and attendance">
    <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-blue-50/50 to-white flex items-center justify-between">
        <div>
            <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                <span>⏱️</span> Staff Timesheet &amp; Attendance (Today)
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
                Real-time employee clock-in punches, duty hours logged, and active leave status.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> @_clockedInStaffCount On Duty Now
            </span>
            <a href="/admin/timesheet" class="text-xs font-semibold text-teal-700 hover:text-teal-900 hover:underline">
                Open Full Timesheets Portal &rarr;
            </a>
        </div>
    </div>

    @if (!_todayAttendance.Any())
    {
        <div class="p-8 text-center text-xs text-gray-400 bg-gray-50/50">
            ✨ No employee punch logs recorded for today yet.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase font-semibold text-[10px]">
                    <tr>
                        <th class="py-3 px-4">Employee</th>
                        <th class="py-3 px-4">Studio ID</th>
                        <th class="py-3 px-4">Attendance Status</th>
                        <th class="py-3 px-4">Clock-In Time</th>
                        <th class="py-3 px-4">Hours Logged</th>
                        <th class="py-3 px-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var att in _todayAttendance)
                    {
                        <tr class="hover:bg-blue-50/20 transition-colors">
                            <td class="py-3 px-4 font-semibold text-gray-900">
                                @att.EmployeeName
                            </td>
                            <td class="py-3 px-4 font-mono text-[11px] text-gray-500">
                                @att.EmployeeStudioId
                            </td>
                            <td class="py-3 px-4">
                                @if (att.IsClockedIn)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> On Duty
                                    </span>
                                }
                                else if (att.IsOnLeaveToday)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                        🏖️ On Leave (@(att.ActiveLeaveType ?? "Approved"))
                                    </span>
                                }
                                else if (att.IsDayOffToday)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 text-slate-600">
                                        🗓️ Scheduled Day Off
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-500">
                                        ⚪ Off Duty / Not Clocked In
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4 text-gray-700">
                                @(att.ClockIn.HasValue ? att.ClockIn.Value.ToString("hh:mm tt") : "--")
                            </td>
                            <td class="py-3 px-4 font-bold text-gray-900">
                                @(att.TotalHours > 0 ? $"{att.TotalHours:0.1} hrs" : (att.IsClockedIn ? "Active" : "--"))
                            </td>
                            <td class="py-3 px-4 text-right">
                                <a href="/admin/timesheet" class="text-teal-700 hover:text-teal-900 font-semibold hover:underline">
                                    Manage Punch &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@* ── Admin Action Panel: Cash Remittance Approvals ─────────────────── *@
<section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-amber-50/50 to-white flex items-center justify-between">
        <div>
            <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                <span>💵</span> Cash Remittance Verification &amp; Approval Action Panel
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
                Inspect cash payments collected by employees on-site. Approving updates employee ledger to Cleared and logs audit verification.
            </p>
        </div>
        <a href="/admin/approvals" class="text-xs font-semibold text-teal-700 hover:text-teal-900 hover:underline">
            View Approvals Portal &rarr;
        </a>
    </div>

    @if (!_pendingRemittances.Any())
    {
        <div class="p-8 text-center text-xs text-gray-400 bg-gray-50/50">
            ✨ No employee cash collections currently require approval. All balances are reconciled.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase font-semibold text-[10px]">
                    <tr>
                        <th class="py-3 px-4">Payment ID</th>
                        <th class="py-3 px-4">Employee (Collector)</th>
                        <th class="py-3 px-4">Event / Client</th>
                        <th class="py-3 px-4">Amount</th>
                        <th class="py-3 px-4">Customer Status</th>
                        <th class="py-3 px-4">Remittance Status</th>
                        <th class="py-3 px-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var rem in _pendingRemittances)
                    {
                        <tr class="hover:bg-amber-50/30 transition-colors">
                            <td class="py-3 px-4 font-mono font-medium text-gray-900">#@rem.Id</td>
                            <td class="py-3 px-4">
                                <span class="font-bold text-gray-900 block">@(rem.EmployeeName ?? rem.EmployeeId ?? "Staff")</span>
                                <span class="text-[10px] text-gray-400">ID: @(rem.EmployeeId ?? "N/A")</span>
                            </td>
                            <td class="py-3 px-4 text-gray-600">@(rem.EventAppointmentId ?? $"Booking #{rem.BookingId}")</td>
                            <td class="py-3 px-4 font-bold text-gray-900">₱@rem.Amount.ToString("N2")</td>
                            <td class="py-3 px-4">
                                <span class="bg-green-100 text-green-800 text-[10px] font-bold px-2 py-0.5 rounded-full">
                                    ✓ Cleared
                                </span>
                            </td>
                            <td class="py-3 px-4">
                                <span class="bg-amber-100 text-amber-900 border border-amber-300 text-[10px] font-bold px-2 py-0.5 rounded-full">
                                    ⏳ Pending Admin Approval
                                </span>
                            </td>
                            <td class="py-3 px-4 text-right">
                                <button type="button"
                                        @onclick="() => HandleApproveRemittance(rem)"
                                        disabled="@_isApproving"
                                        class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-xs font-bold shadow-xs transition-colors">
                                    Approve Cash Remittance
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@* ── Dynamic FAQ Management (Add/Edit directly from Dashboard) ─────────────── *@
<section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6" aria-label="FAQ Management">
    <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-teal-50/50 to-white flex items-center justify-between">
        <div>
            <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                <span>❓</span> Frequently Asked Questions (FAQ) Management
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">
                Dynamically add, edit, reorder, and publish FAQs displayed to clients on the landing page.
            </p>
        </div>
        <button type="button"
                @onclick="OpenAddFaqModal"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold rounded-lg shadow-xs transition-colors">
            <span>+ Add FAQ</span>
        </button>
    </div>

    @if (!_faqs.Any())
    {
        <div class="p-8 text-center text-xs text-gray-400 bg-gray-50/50">
            No FAQs defined yet. Click "+ Add FAQ" above to create your first published question.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase font-semibold text-[10px]">
                    <tr>
                        <th class="py-3 px-4 w-12 text-center">#</th>
                        <th class="py-3 px-4 w-28">Category</th>
                        <th class="py-3 px-4">Question &amp; Answer</th>
                        <th class="py-3 px-4 w-24">Status</th>
                        <th class="py-3 px-4 w-32 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var faq in _faqs)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="py-3 px-4 text-center font-mono font-bold text-gray-500">
                                @faq.DisplayOrder
                            </td>
                            <td class="py-3 px-4">
                                <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-[10px] font-semibold">
                                    @faq.Category
                                </span>
                            </td>
                            <td class="py-3 px-4">
                                <p class="font-bold text-gray-900 text-xs">@faq.Question</p>
                                <p class="text-gray-500 text-[11px] line-clamp-1 mt-0.5 font-light">@faq.Answer</p>
                            </td>
                            <td class="py-3 px-4">
                                @if (faq.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                        ✓ Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-500">
                                        Hidden
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4 text-right space-x-1">
                                <button type="button"
                                        @onclick="() => OpenEditFaqModal(faq)"
                                        class="px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 text-[11px] font-bold transition-colors">
                                    Edit
                                </button>
                                <button type="button"
                                        @onclick="() => HandleToggleFaqStatus(faq)"
                                        title="@(faq.IsActive ? "Hide FAQ" : "Show FAQ")"
                                        class="px-2 py-1 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 text-[11px] font-medium transition-colors">
                                    @(faq.IsActive ? "Hide" : "Show")
                                </button>
                                <button type="button"
                                        @onclick="() => HandleDeleteFaq(faq.Id)"
                                        class="px-2 py-1 rounded bg-rose-50 hover:bg-rose-100 text-rose-700 text-[11px] font-bold transition-colors">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

