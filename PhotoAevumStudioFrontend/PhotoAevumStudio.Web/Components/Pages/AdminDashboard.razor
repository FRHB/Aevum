@* ── FAQ Add/Edit Modal ────────────────────────────────────────────────────── *@
@if (_isFaqModalOpen)
{
    <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 animate-in fade-in duration-150">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200 bg-slate-50 flex items-center justify-between">
                <div>
                    <h3 class="text-base font-bold text-gray-900">
                        @(_editingFaq.Id == 0 ? "Add New FAQ" : $"Edit FAQ #{_editingFaq.Id}")
                    </h3>
                    <p class="text-xs text-gray-500 mt-0.5">Define questions and answers for the client landing page.</p>
                </div>
                <button type="button" @onclick="() => _isFaqModalOpen = false" class="text-gray-400 hover:text-gray-600 font-bold text-lg">×</button>
            </div>

            <div class="p-6 space-y-4">
                @if (!string.IsNullOrWhiteSpace(_faqModalError))
                {
                    <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-lg font-medium">
                        @_faqModalError
                    </div>
                }

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Question</label>
                    <input type="text"
                           @bind="_editingFaq.Question"
                           placeholder="e.g., What should I wear to my studio portrait session?"
                           class="w-full px-3 py-2 text-xs border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Category</label>
                        <input type="text"
                               @bind="_editingFaq.Category"
                               placeholder="e.g. Booking, Pricing, Bay Policies"
                               class="w-full px-3 py-2 text-xs border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Display Order</label>
                        <input type="number"
                               @bind="_editingFaq.DisplayOrder"
                               min="1"
                               class="w-full px-3 py-2 text-xs border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Answer</label>
                    <textarea rows="4"
                              @bind="_editingFaq.Answer"
                              placeholder="Provide clear, concise guidance for clients visiting your website..."
                              class="w-full px-3 py-2 text-xs border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none"></textarea>
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="faqIsActive" @bind="_editingFaq.IsActive" class="rounded text-teal-600 focus:ring-teal-500" />
                    <label for="faqIsActive" class="text-xs text-gray-700 font-medium">
                        Publish immediately to client website landing page
                    </label>
                </div>
            </div>

            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex items-center justify-end gap-2">
                <button type="button"
                        @onclick="() => _isFaqModalOpen = false"
                        class="px-4 py-2 text-xs font-semibold text-gray-600 hover:text-gray-800 rounded-lg">
                    Cancel
                </button>
                <button type="button"
                        @onclick="HandleSaveFaq"
                        disabled="@_isSavingFaq"
                        class="px-4 py-2 bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold rounded-lg shadow-xs transition-colors">
                    @(_isSavingFaq ? "Saving..." : "Save FAQ")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private int _appointmentsToday;
    private int _activeEmployees;
    private int _bookingsThisWeek;
    private int _clockedInStaffCount;
    private int _onLeaveStaffCount;
    private int _activeConsultations;
    private decimal _totalBookedDeposits;
    private int _totalActiveBookings;

    private List<EventBookingModel> _allEvents = new();
    private EventBookingModel? _liveEvent;
    private List<EventBookingModel> _upcomingEvents = new();

    private IReadOnlyList<TodayAttendanceSummaryDto> _todayAttendance = Array.Empty<TodayAttendanceSummaryDto>();
    private IReadOnlyList<BookingRowDto> _recentBookings = Array.Empty<BookingRowDto>();
    private List<PaymentSummaryModel> _pendingRemittances = new();
    private decimal _pendingRemittancesSum => _pendingRemittances.Sum(r => r.Amount);

    private List<FaqItem> _faqs = new();
    private bool _isFaqModalOpen = false;
    private FaqItem _editingFaq = new();
    private string? _faqModalError;
    private bool _isSavingFaq = false;

    private bool _isApproving = false;
    private string? _actionSuccessMessage;
    private string _adminId = "Admin";
    private string _adminName = "System Administrator";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                _adminId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value ?? "Admin";
                _adminName = user.FindFirst("full_name")?.Value ?? user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity.Name ?? "System Administrator";
            }
        }
        catch { }

        // 1. Dispatch independent async API queries in parallel via Task.WhenAll
        var statsTask = SafeGetStatsAsync();
        var attendanceTask = SafeGetAttendanceAsync();
        var remittancesTask = LoadPendingRemittancesAsync();

        // 2. Bookings & Revenue
        try
        {
            var allBookings = UserService.GetBookings();
            _recentBookings = allBookings.Take(5).ToList();
            var activeBookings = allBookings.Where(b => !string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)).ToList();
            _totalActiveBookings = activeBookings.Count;
            _totalBookedDeposits = activeBookings.Sum(b => b.DepositAmount);
        }
        catch
        {
            _recentBookings = Array.Empty<BookingRowDto>();
            _totalActiveBookings = 0;
            _totalBookedDeposits = 0;
        }

        // 3. Events & Consultations (ScheduleService)
        try
        {
            _allEvents = ScheduleService.GetEventBookings();
            _activeConsultations = _allEvents.Count(e => e.IsConsultation && !string.Equals(e.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) && !string.Equals(e.Status, "Deal_Lost", StringComparison.OrdinalIgnoreCase));

            var today = DateTime.Today;
            var nowTime = DateTime.Now.TimeOfDay;

            _liveEvent = _allEvents.FirstOrDefault(e =>
                e.Date.Date == today &&
                nowTime >= e.StartTime &&
                nowTime < e.EndTime &&
                !string.Equals(e.Status, "Cancelled", StringComparison.OrdinalIgnoreCase));

            _upcomingEvents = _allEvents
                .Where(e => (e.Date.Date == today && e.StartTime > nowTime) || (e.Date.Date > today))
                .Where(e => !string.Equals(e.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                .OrderBy(e => e.Date.Date)
                .ThenBy(e => e.StartTime)
                .Take(4)
                .ToList();
        }
        catch
        {
            _allEvents = new();
            _activeConsultations = 0;
            _liveEvent = null;
            _upcomingEvents = new();
        }

        // 4. Dynamic FAQs
        LoadFaqs();

        // 5. Await parallel async tasks
        await Task.WhenAll(statsTask, attendanceTask, remittancesTask);
    }

    private async Task SafeGetStatsAsync()
    {
        try
        {
            var stats = await EmployeeService.GetDashboardStatsAsync();
            _appointmentsToday = stats.AppointmentsToday;
            _activeEmployees = stats.ActiveEmployees;
            _bookingsThisWeek = stats.BookedThisWeek;
        }
        catch
        {
            _appointmentsToday = 0;
            _activeEmployees = 0;
            _bookingsThisWeek = 0;
        }
    }

    private async Task SafeGetAttendanceAsync()
    {
        try
        {
            _todayAttendance = await EmployeeService.GetTodayAttendanceAsync();
            _clockedInStaffCount = _todayAttendance.Count(a => a.IsClockedIn);
            _onLeaveStaffCount = _todayAttendance.Count(a => a.IsOnLeaveToday || a.IsDayOffToday);
        }
        catch
        {
            _todayAttendance = Array.Empty<TodayAttendanceSummaryDto>();
            _clockedInStaffCount = 0;
            _onLeaveStaffCount = 0;
        }
    }

    private void LoadFaqs()
    {
        try
        {
            _faqs = UserService.GetFaqs(includeInactive: true).OrderBy(f => f.DisplayOrder).ToList();
        }
        catch
        {
            _faqs = new();
        }
    }

    private void OpenAddFaqModal()
    {
        _editingFaq = new FaqItem
        {
            Id = 0,
            Category = "General",
            DisplayOrder = _faqs.Count + 1,
            IsActive = true
        };
        _faqModalError = null;
        _isFaqModalOpen = true;
    }

    private void OpenEditFaqModal(FaqItem faq)
    {
        _editingFaq = new FaqItem
        {
            Id = faq.Id,
            Question = faq.Question,
            Answer = faq.Answer,
            Category = faq.Category,
            DisplayOrder = faq.DisplayOrder,
            IsActive = faq.IsActive
        };
        _faqModalError = null;
        _isFaqModalOpen = true;
    }

    private void HandleSaveFaq()
    {
        if (string.IsNullOrWhiteSpace(_editingFaq.Question))
        {
            _faqModalError = "Please enter a question.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editingFaq.Answer))
        {
            _faqModalError = "Please enter an answer.";
            return;
        }

        _isSavingFaq = true;
        try
        {
            var success = UserService.SaveFaq(_editingFaq);
            if (success)
            {
                _actionSuccessMessage = $"FAQ \"{_editingFaq.Question}\" saved successfully.";
                _isFaqModalOpen = false;
                LoadFaqs();
            }
            else
            {
                _faqModalError = "Failed to save FAQ. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _faqModalError = $"Error saving FAQ: {ex.Message}";
        }
        finally
        {
            _isSavingFaq = false;
        }
    }

    private void HandleToggleFaqStatus(FaqItem faq)
    {
        try
        {
            faq.IsActive = !faq.IsActive;
            UserService.SaveFaq(faq);
            _actionSuccessMessage = $"FAQ #{faq.Id} is now {(faq.IsActive ? "active on the landing page" : "hidden")}.";
            LoadFaqs();
        }
        catch (Exception ex)
        {
            _actionSuccessMessage = $"Error updating status: {ex.Message}";
        }
    }

    private void HandleDeleteFaq(int id)
    {
        try
        {
            var success = UserService.DeleteFaq(id);
            if (success)
            {
                _actionSuccessMessage = $"FAQ #{id} deleted successfully.";
                LoadFaqs();
            }
        }
        catch (Exception ex)
        {
            _actionSuccessMessage = $"Error deleting FAQ: {ex.Message}";
        }
    }

    private async Task LoadPendingRemittancesAsync()
    {
        try
        {
            var res = await ConsultationApi.GetPendingRemittancesAsync();
            if (res.IsSuccess && res.Value != null)
            {
                _pendingRemittances = res.Value.ToList();
                return;
            }
        }
        catch { }

        _pendingRemittances = UserService.GetPendingCashRemittances();
    }

    private async Task HandleApproveRemittance(PaymentSummaryModel rem)
    {
        _isApproving = true;
        _actionSuccessMessage = null;

        try
        {
            var req = new AdminApproveRemittanceModel
            {
                AdminId = _adminId,
                AdminName = _adminName,
                Notes = $"Approved cash remittance from Admin Dashboard on {DateTime.Now:g}"
            };

            var res = await ConsultationApi.ApproveRemittanceAsync(rem.Id, req);
            if (!res.IsSuccess)
            {
                UserService.ApproveCashRemittance(rem.Id, _adminId);
            }

            _actionSuccessMessage = $"Cash remittance of ₱{rem.Amount:N2} (Payment #{rem.Id}) for Employee {rem.EmployeeName ?? rem.EmployeeId} approved and cleared successfully.";
            await LoadPendingRemittancesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _actionSuccessMessage = $"Approval processed with note: {ex.Message}";
        }
        finally
        {
            _isApproving = false;
        }
    }
}
