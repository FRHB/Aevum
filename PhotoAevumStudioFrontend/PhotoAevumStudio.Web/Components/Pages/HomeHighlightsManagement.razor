@page "/admin/highlights"
@page "/admin/portfolio/highlights"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, SystemAdmin, Super Admin, Office Clerk")]
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IPortfolioService PortfolioService

<PageTitle>Home Hero Highlights Management | Photo Aevum Studio</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                <span>Portfolio</span>
                <span>/</span>
                <span class="text-slate-900 font-bold">Hero Highlights</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Home Page Image Highlights</h1>
            <p class="text-sm text-slate-500 mt-0.5">Control the showcase images and availability card displayed on the studio home page hero slider.</p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button"
                    @onclick="OpenAddModal"
                    class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-900 hover:bg-black text-white rounded-lg text-xs font-semibold uppercase tracking-wider shadow-sm transition-colors cursor-pointer">
                <span>+ Add Highlight Slide</span>
            </button>
            <a href="/#home" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-100 transition-colors">
                <span>View Live Site ↗</span>
            </a>
        </div>
    </div>

    <!-- Alert / Notification -->
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl flex items-center justify-between shadow-xs animate-in fade-in duration-200">
            <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0 text-xs font-bold">✓</span>
                <p class="text-xs font-medium text-emerald-950">@_statusMessage</p>
            </div>
            <button type="button" @onclick="() => _statusMessage = null" class="text-emerald-700 hover:text-emerald-950 p-1 text-sm font-bold">&times;</button>
        </div>
    }

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Slides</span>
                <span class="p-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs">🖼️</span>
            </div>
            <p class="text-2xl font-bold text-slate-900 mt-2">@_highlights.Count</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Configured hero slides</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Active on Home</span>
                <span class="p-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-xs">●</span>
            </div>
            <p class="text-2xl font-bold text-slate-900 mt-2">@_highlights.Count(h => h.IsActive)</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Currently in rotation</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Transition Speed</span>
                <span class="p-1.5 rounded-lg bg-amber-50 text-amber-700 text-xs">⏱️</span>
            </div>
            <p class="text-2xl font-bold text-slate-900 mt-2">5.0s</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Continuous smooth crossfade</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Next Schedule</span>
                <span class="p-1.5 rounded-lg bg-blue-50 text-blue-700 text-xs">📅</span>
            </div>
            <p class="text-2xl font-bold text-slate-900 mt-2">Floating Card</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Overlaid on hero highlight</p>
        </div>
    </div>

    <!-- Highlights List -->
    <div class="bg-white rounded-xl shadow-xs border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 bg-slate-50/70 border-b border-slate-200 flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Configured Highlight Images</h2>
            <span class="text-xs text-slate-500">Ordered by display priority</span>
        </div>

        @if (_isLoading)
        {
            <div class="p-16 text-center text-slate-400 text-xs">
                <span class="inline-block w-6 h-6 border-2 border-slate-300 border-t-slate-900 rounded-full animate-spin mb-2"></span>
                <p>Loading highlight slides...</p>
            </div>
        }
        else if (_highlights.Count == 0)
        {
            <div class="p-12 text-center">
                <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center mx-auto mb-3 text-xl">📸</div>
                <h3 class="text-sm font-bold text-slate-900">No Hero Highlights Configured</h3>
                <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto mb-4">Click "Add Highlight Slide" above to feature photographs on the studio home page.</p>
                <button type="button" @onclick="OpenAddModal" class="px-4 py-2 bg-slate-900 text-white text-xs font-semibold rounded-lg hover:bg-black transition-colors">
                    Add First Highlight Slide
                </button>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var hl in _highlights)
                {
                    <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/60 transition-colors">
                        <div class="flex items-center gap-4">
                            <!-- Image Thumbnail Preview -->
                            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden bg-slate-900 shrink-0 border border-slate-200 shadow-xs relative group">
                                <img src="@hl.ImageUrl" alt="@hl.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='images/AevumLogo.jpg';" />
                                @if (hl.IsActive)
                                {
                                    <span class="absolute top-1.5 left-1.5 w-2 h-2 rounded-full bg-emerald-400 ring-2 ring-black/40"></span>
                                }
                            </div>

                            <!-- Details -->
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200">
                                        @hl.HighlightID
                                    </span>
                                    <span class="text-[11px] font-semibold text-slate-400">Order: @hl.DisplayOrder</span>
                                    @if (hl.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500 border border-slate-200">
                                            Paused
                                        </span>
                                    }
                                </div>
                                <h3 class="text-base font-bold text-slate-900">@hl.Title</h3>
                                <p class="text-xs text-slate-500 line-clamp-1">
                                    @(string.IsNullOrWhiteSpace(hl.Subtitle) ? "Studio highlight slide" : hl.Subtitle)
                                </p>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center gap-2 self-end sm:self-center">
                            <button type="button"
                                    @onclick="() => ToggleActiveAsync(hl)"
                                    class="px-3 py-1.5 rounded-lg text-xs font-semibold border transition-colors cursor-pointer @(hl.IsActive ? "bg-amber-50 text-amber-700 border-amber-200 hover:bg-amber-100" : "bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100")">
                                @(hl.IsActive ? "Pause Slide" : "Activate Slide")
                            </button>

                            <button type="button"
                                    @onclick="() => OpenEditModal(hl)"
                                    class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold rounded-lg transition-colors cursor-pointer">
                                Edit
                            </button>

                            <button type="button"
                                    @onclick="() => DeleteHighlightAsync(hl)"
                                    class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold rounded-lg transition-colors cursor-pointer">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal: Add / Edit Highlight -->
@if (_isModalOpen)
{
    <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 animate-in fade-in duration-150"
         @onclick="CloseModal">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-in zoom-in-95 duration-150"
             @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h3 class="font-bold text-base text-slate-900">@(_editingHighlight == null ? "Add Hero Highlight Slide" : "Edit Highlight Slide")</h3>
                    <p class="text-xs text-slate-500">Configure image and details for the home page hero slider.</p>
                </div>
                <button type="button" @onclick="CloseModal" class="w-8 h-8 rounded-full text-slate-400 hover:text-slate-900 hover:bg-slate-100 flex items-center justify-center transition-colors font-bold">&times;</button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Title</label>
                    <input type="text"
                           @bind="_formModel.Title"
                           placeholder="e.g. Editorial Fashion Shot"
                           class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900" />
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Subtitle / Description (Optional)</label>
                    <input type="text"
                           @bind="_formModel.Subtitle"
                           placeholder="e.g. Studio Bay 1 • Natural Light & High Fashion"
                           class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Display Order</label>
                        <input type="number"
                               @bind="_formModel.DisplayOrder"
                               class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900" />
                    </div>

                    <div class="flex flex-col justify-end">
                        <label class="flex items-center gap-2 cursor-pointer pb-2.5">
                            <input type="checkbox" @bind="_formModel.IsActive" class="w-4 h-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900" />
                            <span class="text-xs font-semibold text-slate-700">Active on Home Page</span>
                        </label>
                    </div>
                </div>

                <!-- Image Configuration -->
                <div class="space-y-2 pt-2 border-t border-slate-100">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Highlight Image</label>
                    
                    <div class="flex gap-2 mb-2">
                        <button type="button"
                                @onclick="() => _useUpload = true"
                                class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors @(_useUpload ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                            📁 Upload File
                        </button>
                        <button type="button"
                                @onclick="() => _useUpload = false"
                                class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors @(!_useUpload ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                            🔗 Image URL
                        </button>
                    </div>

                    @if (_useUpload)
                    {
                        <div class="border-2 border-dashed border-slate-200 rounded-xl p-4 text-center hover:border-slate-400 transition-colors bg-slate-50/50">
                            <InputFile OnChange="HandleFileSelected" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-900 file:text-white hover:file:bg-black cursor-pointer" />
                            <p class="text-[11px] text-slate-400 mt-2">JPEG, PNG, WebP up to 10MB</p>
                        </div>
                    }
                    else
                    {
                        <input type="text"
                               @bind="_formModel.ImageUrl"
                               placeholder="https://images.unsplash.com/photo-..."
                               class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900" />
                    }

                    <!-- Preview -->
                    @if (!string.IsNullOrWhiteSpace(_previewUrl) || !string.IsNullOrWhiteSpace(_formModel.ImageUrl))
                    {
                        <div class="mt-3 relative h-36 rounded-xl overflow-hidden bg-slate-900 border border-slate-200">
                            <img src="@(!string.IsNullOrWhiteSpace(_previewUrl) ? _previewUrl : _formModel.ImageUrl)"
                                 alt="Preview"
                                 class="w-full h-full object-cover"
                                 onerror="this.src='images/AevumLogo.jpg';" />
                            <div class="absolute bottom-2 left-2 bg-black/70 backdrop-blur-xs text-white text-[10px] font-bold px-2 py-0.5 rounded">
                                Image Preview
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-end gap-3 bg-slate-50/50">
                <button type="button" @onclick="CloseModal" class="px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-100 text-xs font-semibold rounded-lg transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button"
                        @onclick="SaveHighlightAsync"
                        disabled="@_isSaving"
                        class="px-5 py-2 bg-slate-900 hover:bg-black text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-sm transition-colors cursor-pointer disabled:opacity-50">
                    @(_isSaving ? "Saving..." : "Save Highlight")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<HomeHighlightModel> _highlights = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _statusMessage;

    // Modal state
    private bool _isModalOpen = false;
    private HomeHighlightModel? _editingHighlight;
    private HomeHighlightModel _formModel = new();
    private bool _useUpload = true;
    private byte[]? _uploadedBytes;
    private string? _uploadedMime;
    private string? _previewUrl;

    protected override async Task OnInitializedAsync()
    {
        await LoadHighlightsAsync();
    }

    private async Task LoadHighlightsAsync()
    {
        _isLoading = true;
        try
        {
            _highlights = await PortfolioService.GetHomeHighlightsAsync(activeOnly: false);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _editingHighlight = null;
        _formModel = new HomeHighlightModel
        {
            Title = string.Empty,
            Subtitle = string.Empty,
            ImageUrl = string.Empty,
            DisplayOrder = _highlights.Count + 1,
            IsActive = true
        };
        _uploadedBytes = null;
        _uploadedMime = null;
        _previewUrl = null;
        _useUpload = true;
        _isModalOpen = true;
    }

    private void OpenEditModal(HomeHighlightModel hl)
    {
        _editingHighlight = hl;
        _formModel = new HomeHighlightModel
        {
            HighlightID = hl.HighlightID,
            Title = hl.Title,
            Subtitle = hl.Subtitle,
            ImageUrl = hl.ImageUrl,
            ImageFileName = hl.ImageFileName,
            DisplayOrder = hl.DisplayOrder,
            IsActive = hl.IsActive
        };
        _uploadedBytes = null;
        _uploadedMime = null;
        _previewUrl = hl.ImageUrl;
        _useUpload = string.IsNullOrWhiteSpace(hl.ImageUrl) || hl.ImageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase);
        _isModalOpen = true;
    }

    private void CloseModal()
    {
        _isModalOpen = false;
        _editingHighlight = null;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _uploadedBytes = ms.ToArray();
            _uploadedMime = file.ContentType;
            _previewUrl = $"data:{_uploadedMime};base64,{Convert.ToBase64String(_uploadedBytes)}";
            _formModel.ImageUrl = _previewUrl;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error loading image: {ex.Message}";
        }
    }

    private async Task SaveHighlightAsync()
    {
        if (string.IsNullOrWhiteSpace(_formModel.Title))
        {
            _statusMessage = "Please provide a title for the highlight slide.";
            return;
        }

        _isSaving = true;
        try
        {
            var saved = await PortfolioService.SaveHomeHighlightAsync(_formModel, _uploadedBytes, _uploadedMime);
            if (saved != null)
            {
                _statusMessage = $"Highlight \"{saved.Title}\" ({saved.HighlightID}) saved successfully.";
                _isModalOpen = false;
                await LoadHighlightsAsync();
            }
            else
            {
                _statusMessage = "Could not save highlight. Please check database connectivity.";
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleActiveAsync(HomeHighlightModel hl)
    {
        var ok = await PortfolioService.ToggleHomeHighlightActiveAsync(hl.HighlightID);
        if (ok)
        {
            hl.IsActive = !hl.IsActive;
            _statusMessage = hl.IsActive
                ? $"\"{hl.Title}\" is now active on the home page."
                : $"\"{hl.Title}\" is paused from the hero rotation.";
        }
    }

    private async Task DeleteHighlightAsync(HomeHighlightModel hl)
    {
        var ok = await PortfolioService.DeleteHomeHighlightAsync(hl.HighlightID);
        if (ok)
        {
            _highlights.Remove(hl);
            _statusMessage = $"Highlight \"{hl.Title}\" deleted successfully.";
        }
    }
}
