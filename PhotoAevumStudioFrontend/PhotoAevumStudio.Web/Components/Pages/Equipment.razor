@page "/admin/equipment"
@page "/Dashboard/Equipment"
@inherits EquipmentBase
@using YourNamespace.ViewModels

<div class="dashboard-layout d-flex min-vh-100">
    <!-- Persistent Left Navigation Bar -->
    <nav class="sidebar bg-navy text-white p-3" style="width: 260px; background-color: #0f172a;">
        <h4 class="brand mb-4 text-white font-weight-bold">Operations</h4>
        <ul class="nav flex-column">
            <li class="nav-item mb-2"><a href="/Dashboard" class="nav-link text-white-50">Dashboard</a></li>
            <li class="nav-item mb-2"><a href="/Dashboard/Schedules" class="nav-link text-white-50">Schedules</a></li>
            <li class="nav-item mb-2"><a href="/Dashboard/Services" class="nav-link text-white-50">Services</a></li>
            <li class="nav-item mb-2"><a href="/Dashboard/Equipment" class="nav-link text-white active fw-bold bg-teal rounded">Equipment</a></li>
            <li class="nav-item mb-2"><a href="/Dashboard/Employees" class="nav-link text-white-50">Employees</a></li>
        </ul>
    </nav>

    <!-- Main Content Panel -->
    <main class="main-content p-4 bg-light flex-grow-1">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Equipment</h2>
                <p class="text-muted">Manage company inventory, hardware, tools, and operational gear.</p>
            </div>
            <button class="btn btn-primary" @onclick="OpenAddEquipmentModal">+ Add Equipment</button>
        </div>

        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Equipment ID</th>
                        <th>Serial ID</th>
                        <th>Equipment Name</th>
                        <th>Kind</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (EquipmentList != null)
                    {
                        @foreach (var eq in EquipmentList)
                        {
                            <tr>
                                <td>EQ-@eq.Id</td>
                                <td><code>@eq.SerialNumber</code></td>
                                <td><strong>@eq.Name</strong></td>
                                <td>@eq.Kind</td>
                                <td>
                                    @if (eq.Status == "Available")
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else if (eq.Status == "In Use")
                                    {
                                        <span class="badge bg-warning text-dark">In Use</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Maintenance</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
