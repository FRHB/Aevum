@page "/my/gallery/{GalleryId}"
@layout CustomerLayout
@attribute [Authorize(Roles = "Customer")]

<PageTitle>Private Gallery</PageTitle>

<div class="max-w-6xl mx-auto py-10 px-6">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold">Graduation Shoot</h1>
            <p class="text-gray-500 mt-1">Select your favorites for retouching or download the full resolution files.</p>
        </div>
        <div class="flex gap-3">
            <button class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-md font-semibold text-sm hover:bg-gray-50">
                <i data-lucide="heart" class="w-4 h-4 inline mr-2"></i> Submit Favorites (3/10)
            </button>
            <button class="bg-teal-600 text-white px-4 py-2 rounded-md font-semibold text-sm hover:bg-teal-700">
                <i data-lucide="download" class="w-4 h-4 inline mr-2"></i> Download All
            </button>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Mock Images -->
        @for(int i = 1; i <= 8; i++)
        {
            var photoId = i;
            <div class="relative group aspect-[4/5] bg-gray-200 rounded-lg overflow-hidden border border-gray-200">
                <!-- Watermarked placeholder -->
                <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-gray-400 font-bold text-2xl opacity-20 transform -rotate-45 select-none">AEVUM STUDIO</span>
                </div>
                
                <!-- Overlay Actions -->
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between p-4">
                    <div class="flex justify-end">
                        <button class="text-white hover:text-red-500 transition-colors" @onclick="() => ToggleFavorite(photoId)">
                            <i data-lucide="heart" class="w-6 h-6 @(Favorites.Contains(photoId) ? "fill-red-500 text-red-500" : "")"></i>
                        </button>
                    </div>
                    <div class="flex justify-between items-end">
                        <span class="text-white text-xs font-mono">IMG_@(photoId.ToString("0000")).CR3</span>
                        <button class="text-white hover:text-teal-400 transition-colors">
                            <i data-lucide="message-square" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string GalleryId { get; set; } = string.Empty;

    private HashSet<int> Favorites = new();

    private void ToggleFavorite(int id)
    {
        if (Favorites.Contains(id))
            Favorites.Remove(id);
        else
            Favorites.Add(id);
    }
}
