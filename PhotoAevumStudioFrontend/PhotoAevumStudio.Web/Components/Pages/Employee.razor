@page "/admin/employees"
@layout AdminLayout
@rendermode InteractiveServer

<div class="flex justify-between items-center mb-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Directory</h1>
        <p class="text-gray-500 mt-1">Manage staff roles and access levels.</p>
    </div>
    <button @onclick="() => isWizardOpen = true" class="btn btn--primary flex items-center gap-2">
        <i data-lucide="user-plus" class="w-4 h-4"></i> Add Staff
    </button>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-6 text-gray-500">Employee list populated here.</div>
</div>

<AddEmployeeWizard @bind-IsOpen="isWizardOpen" />

@code {
    private bool isWizardOpen = false;
}