@page "/analytics/diagnostic"
@page "/admin/analytics/diagnostic"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SystemAdmin,System Admin,Super Admin,Office Clerk")]
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Diagnostic Analytics | Photo Aevum Studio</PageTitle>

<div class="space-y-6">
    @* ── Page Header ─────────────────────────────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-3 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                <span>Sales &amp; Report</span>
                <span>/</span>
                <span>Analytics</span>
                <span>/</span>
                <span class="text-teal-700 font-bold">Tier 2: Diagnostic</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Diagnostic Analytics</h1>
                <span class="px-2.5 py-0.5 bg-blue-50 text-blue-800 border border-blue-200 rounded-full text-[11px] font-bold uppercase tracking-wider">
                    Why Did It Happen?
                </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Root-cause correlation via structured <strong>Serilog + Seq</strong> telemetry, payment lock expiry diagnostics, and scheduling conflict attribution.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <select @bind="_levelFilter" class="text-xs px-3 py-2 border border-slate-300 rounded-lg bg-white font-medium text-slate-700">
                <option value="ALL">All Log Levels</option>
                <option value="INF">Information</option>
                <option value="WRN">Warning</option>
                <option value="ERR">Error</option>
            </select>
        </div>
    </div>

    @* ── Root-Cause Summary Cards ────────────────────────────────────── *@
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-medium uppercase tracking-wider text-slate-500">Primary Deal-Loss Driver</span>
            <h3 class="text-xl font-extrabold text-slate-900 mt-1">30-Min QR Lock Expiry (64%)</h3>
            <p class="text-[11px] text-slate-500 mt-1">Clients opening checkout on mobile without a second screen to scan the QR code.</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-medium uppercase tracking-wider text-slate-500">Webhook Latency (p95)</span>
            <h3 class="text-xl font-extrabold text-emerald-700 mt-1">420 ms</h3>
            <p class="text-[11px] text-slate-500 mt-1">Measured from <code>xendit-qr-webhook</code> receipt to SignalR <code>PaymentCompleted</code> broadcast.</p>
        </div>
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs">
            <span class="text-xs font-medium uppercase tracking-wider text-slate-500">Seq Structured Sink Status</span>
            <h3 class="text-xl font-extrabold text-teal-700 mt-1">Serilog Pipeline Active</h3>
            <p class="text-[11px] text-slate-500 mt-1">Configured via <code>Seq:ServerUrl</code> &amp; <code>Seq:ApiKey</code> in <code>Program.cs</code>.</p>
        </div>
    </div>

    @* ── Structured Seq Event Stream Table ───────────────────────────── *@
    <div class="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
            <div>
                <h2 class="text-sm font-bold text-slate-900">Recent Structured Diagnostic Events (Serilog / Seq Format)</h2>
                <p class="text-xs text-slate-500">Correlated by <code>AppointmentId</code>, <code>ReferenceId</code>, and Hangfire <code>JobId</code></p>
            </div>
            <span class="text-xs font-mono text-slate-400">Showing @FilteredEvents.Count() events</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-200">
                        <th class="py-3 px-4">Timestamp (UTC)</th>
                        <th class="py-3 px-4">Level</th>
                        <th class="py-3 px-4">Source Context</th>
                        <th class="py-3 px-4">Structured Message Template</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-mono">
                    @foreach (var ev in FilteredEvents)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="py-3 px-4 text-slate-500 whitespace-nowrap">@ev.Timestamp</td>
                            <td class="py-3 px-4">
                                <span class="px-2 py-0.5 rounded font-bold text-[10px] @(ev.Level == "WRN" ? "bg-amber-100 text-amber-800" : ev.Level == "ERR" ? "bg-rose-100 text-rose-800" : "bg-teal-50 text-teal-800")">
                                    @ev.Level
                                </span>
                            </td>
                            <td class="py-3 px-4 text-slate-700">@ev.Source</td>
                            <td class="py-3 px-4 text-slate-800 font-sans">@ev.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string _levelFilter = "ALL";

    private record SeqDiagnosticEvent(string Timestamp, string Level, string Source, string Message);

    private readonly List<SeqDiagnosticEvent> _events =
    [
        new("2026-11-11 12:35:10", "INF", "DailyAnalyticsSyncJob", "Analytics sync started"),
        new("2026-11-11 12:31:44", "INF", "PaymentsController", "Xendit QR simulate for EVT-0006 returned 200"),
        new("2026-11-11 12:31:45", "INF", "PaymentsController", "ASP.NET Core API successfully received qr.payment webhook and validated x-callback-token for reference EVT-0006."),
        new("2026-11-11 12:31:45", "INF", "PaymentsController", "SignalR hub successfully broadcasted status change event (PaymentCompleted) for appointment EVT-0006."),
        new("2026-11-11 12:18:02", "WRN", "PendingPaymentExpiryService", "Reservation hold LockExpiresAt elapsed for appointment EVT-0009; releasing slot."),
        new("2026-11-11 11:50:19", "INF", "BookingPredictionService", "No-show prediction requested for booking 104; returning 0.15")
    ];

    private IEnumerable<SeqDiagnosticEvent> FilteredEvents =>
        _levelFilter == "ALL" ? _events : _events.Where(e => e.Level == _levelFilter);
}
