@page "/payments/{AppointmentId}"
@layout CustomerLayout
@using Microsoft.AspNetCore.Authorization
@using PhotoAevumStudio.Web.Services
@using QRCoder
@using ZXingBlazor.Components
@implements IAsyncDisposable
@inject IConsultationClient ConsultationApi
@inject IScheduleService ScheduleService
@inject PaymentHubClient PaymentHub
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Customer,Admin,SystemAdmin,System Admin,Super Admin,Employee,Office Clerk")]

<PageTitle>Reservation Payment - Photo Aevum Studio</PageTitle>

<div class="max-w-xl mx-auto py-10 px-6">
    <a href="/my/bookings" class="text-teal-600 hover:underline font-semibold text-sm">&larr; Back to My Bookings</a>

    @if (_loading)
    {
        <p class="mt-8 text-sm text-slate-500">Loading payment details&hellip;</p>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="mt-8 rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-800 space-y-3" role="alert">
            <p>@_loadError</p>
            <button type="button" @onclick="RetryLoadAsync"
                    class="px-4 py-2 rounded-lg bg-slate-900 hover:bg-black text-white text-xs font-bold">
                Try Again
            </button>
        </div>
    }
    else if (_info is null)
    {
        <div class="mt-8 rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-800">
            We couldn't find that booking.
        </div>
    }
    else if (IsAlreadyPaid(_info) || _paid)
    {
        <div class="mt-8 rounded-2xl border border-emerald-200 bg-emerald-50 p-8 text-center shadow-sm" role="status">
            <div class="text-5xl mb-3">&#10003;</div>
            <h1 class="text-2xl font-black text-emerald-900">Payment Completed</h1>
            <p class="mt-2 text-sm text-emerald-800">
                @(_info.IsFinalPayment
                    ? $"Your final balance payment for {_info.EventName} (#{_info.AppointmentId}) is verified (Payment Verification (QR:Paid)). Event marked Completed, and confirmation emails have been sent to you and the Team Leader."
                    : $"Your reservation fee for {_info.EventName} (#{_info.AppointmentId}) has been received. Your date and time are now locked in.")
            </p>
            <p class="mt-3 text-xs text-slate-600">
                @_info.EventDate.ToString("MMMM dd, yyyy") at @DateTime.Today.Add(_info.EventTime).ToString("h:mm tt")
            </p>
            <div class="mt-5 flex flex-wrap justify-center gap-2.5">
                <button type="button" @onclick="DownloadAgreementPdfAsync" disabled="@_docBusy"
                        class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 text-xs font-bold">
                    ⬇ Signed Agreement PDF
                </button>
                <button type="button" @onclick="() => DownloadReceiptPdfAsync(_info.IsFinalPayment ? FinalReceiptType : Stage1ReceiptType)" disabled="@_docBusy"
                        class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold">
                    ⬇ @(_info.IsFinalPayment ? "Final Consolidated Receipt PDF" : "Reservation Receipt PDF")
                </button>
            </div>
            <a href="/my/bookings" class="inline-block mt-6 px-5 py-2.5 rounded-xl bg-emerald-700 text-white text-sm font-bold">View My Bookings</a>
        </div>
    }
    else if (_info.EventStatus == "Cancelled" || _info.EventStatus == "Expired" || _info.EventStatus == "Deal_Lost" || _expired)
    {
        <div class="mt-8 rounded-2xl border border-red-200 bg-red-50 p-8 text-center shadow-sm" role="alert">
            <h1 class="text-2xl font-black text-red-900">Reservation Expired</h1>
            <p class="mt-2 text-sm text-red-800">
                The reservation fee for <strong>@_info.EventName</strong> (#@_info.AppointmentId) was not received in time,
                so the booking hold elapsed.
            </p>
            @if (!string.IsNullOrWhiteSpace(_paymentError))
            {
                <p class="mt-3 text-xs rounded-lg px-3 py-2 bg-white/80 text-red-800 border border-red-200">@_paymentError</p>
            }
            @if (!_info.IsFinalPayment && _info.EventStatus is not ("Cancelled" or "Expired" or "Deal_Lost"))
            {
                <button type="button" @onclick="RequestExtensionAsync" disabled="@_busy"
                        class="mt-5 px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 disabled:opacity-50 text-white text-xs font-bold">
                    @(_busy ? "Extending Hold…" : "Request 30-Min Hold Extension")
                </button>
            }
        </div>
    }
    else if (!_info.IsFinalPayment && !_info.ContractAccepted)
    {
        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm space-y-5">
            <div>
                <span class="px-2.5 py-0.5 rounded bg-slate-900 text-white text-[10px] font-bold uppercase tracking-wider">Step 1 of 2 &bull; Review &amp; Accept Agreement</span>
                <h1 class="text-xl font-black text-slate-900 mt-2">Photo Studio Services Agreement &amp; Terms</h1>
                <p class="text-xs text-slate-500 mt-1">
                    Please review your booking contract and our Standard Terms &amp; Conditions (@(_docsBundle?.TermsVersion?.VersionCode ?? "v1.0")) before unlocking the Reservation Fee QR payment.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_docError))
            {
                <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between gap-2">
                    <span>@_docError</span>
                    @if (_docsBundle is null)
                    {
                        <button type="button" @onclick="RetryLoadAsync" class="px-2.5 py-1 rounded bg-rose-700 text-white text-[11px] font-bold shrink-0">
                            Reload
                        </button>
                    }
                </div>
            }

            <div class="flex gap-2 border-b border-slate-200">
                <button type="button" @onclick='() => _docTab = "agreement"'
                        class="px-3 py-2 text-xs font-bold border-b-2 @(_docTab == "agreement" ? "border-slate-900 text-slate-900" : "border-transparent text-slate-500")">
                    Services Agreement
                </button>
                <button type="button" @onclick='() => _docTab = "terms"'
                        class="px-3 py-2 text-xs font-bold border-b-2 @(_docTab == "terms" ? "border-slate-900 text-slate-900" : "border-transparent text-slate-500")">
                    Standard Terms (@(_docsBundle?.TermsVersion?.VersionCode ?? "v1.0"))
                </button>
            </div>

            <div class="max-h-96 overflow-y-auto border border-slate-200 rounded-xl p-4 bg-slate-50/40">
                @if (_docTab == "agreement")
                {
                    @((MarkupString)(_docsBundle?.Contract?.RenderedContractHtml ?? "<p class='text-xs text-slate-500'>Agreement preview unavailable. Click Reload above or proceed below.</p>"))
                }
                else
                {
                    @((MarkupString)(_docsBundle?.TermsVersion?.TermsBodyHtml ?? "<p class='text-xs text-slate-500'>Standard Terms unavailable.</p>"))
                }
            </div>

            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 space-y-2.5 text-xs">
                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input type="checkbox" @bind="_agreeAgreement" class="mt-0.5" />
                    <span>I have reviewed and agree to the <strong>Photo Studio Services Agreement</strong> (Reservation Fee: <strong>₱@_info.Amount.ToString("N2")</strong>).</span>
                </label>
                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input type="checkbox" @bind="_agreeTerms" class="mt-0.5" />
                    <span>I have read and accept the <strong>Standard Terms and Conditions (@(_docsBundle?.TermsVersion?.VersionCode ?? "v1.0"))</strong>.</span>
                </label>
            </div>

            <button type="button"
                    @onclick="AcceptAgreementAndProceedAsync"
                    disabled="@(_docBusy || !_agreeAgreement || !_agreeTerms)"
                    class="w-full py-3 rounded-xl bg-slate-900 hover:bg-black disabled:opacity-50 text-white text-sm font-bold transition-colors">
                @(_docBusy ? "Recording Electronic Acceptance..." : "Accept Agreement & Proceed to Reservation Payment →")
            </button>
        </div>
    }
    else
    {
        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm text-center">
            <h1 class="text-2xl font-black text-slate-900">@(_info.IsFinalPayment ? "Pay Your Final Balance" : "Pay Your Reservation Fee")</h1>
            <p class="mt-1 text-xs text-slate-500">@_info.EventName &bull; #@_info.AppointmentId</p>
            <p class="mt-1 text-xs text-slate-500">
                @_info.EventDate.ToString("MMMM dd, yyyy") at @DateTime.Today.Add(_info.EventTime).ToString("h:mm tt")
            </p>

            <div class="mt-5 text-3xl font-black text-slate-900">&#8369;@_info.Amount.ToString("N2")</div>

            @if (!string.IsNullOrEmpty(_qrSvg))
            {
                <div class="mx-auto mt-5 w-64 h-64 p-2 bg-white border border-slate-200 rounded-xl" aria-label="Payment QR code">
                    @((MarkupString)_qrSvg)
                </div>
            }
            else
            {
                <p class="mt-5 text-sm text-red-700">The QR code is not available. Please contact the studio.</p>
            }

            <p class="mt-4 text-xs text-slate-600">
                Scan this QR code with another device (or click <strong>Confirm Payment</strong> below) to settle your @(_info.IsFinalPayment ? "final balance" : "reservation fee"). This page updates automatically once received.
            </p>

            @if (!_info.IsFinalPayment && _info.LockExpiresAt != null)
            {
                <div class="mt-4 inline-block px-4 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-900">
                    <div class="text-[10px] uppercase font-bold tracking-wider text-amber-700">Time slot held for</div>
                    <div class="font-mono text-lg font-black" aria-live="off">@_countdown</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_paymentError))
            {
                <p class="mt-4 text-xs rounded-lg px-3 py-2 bg-red-50 text-red-700 border border-red-200" role="alert">@_paymentError</p>
            }

            <div class="mt-6 flex flex-col gap-2.5">
                <button type="button" @onclick="ConfirmPaymentAsync" disabled="@_busy"
                        class="w-full py-3.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 disabled:opacity-50 text-white text-sm font-black shadow-sm transition-colors">
                    @(_busy ? "Processing & Confirming Payment…" : "Confirm Payment")
                </button>
                <button type="button" @onclick="RefreshStatusAsync" disabled="@_busy"
                        class="w-full py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 disabled:opacity-50 text-slate-700 text-xs font-bold transition-colors">
                    Refresh Payment Status
                </button>
            </div>

            @if (!_hubConnected)
            {
                <p class="mt-3 text-[11px] text-slate-400">Live updates are reconnecting&hellip; you can also click Refresh Payment Status after paying on another device.</p>
            }

            @if (_isMockQr && Env.IsDevelopment())
            {
                <div class="mt-4">
                    <button class="px-4 py-2 rounded-lg border border-dashed border-slate-400 text-xs font-semibold text-slate-600"
                            @onclick="SimulatePaymentAsync" disabled="@_busy">
                        Simulate payment (development only)
                    </button>
                </div>
            }

            @if (Env.IsDevelopment())
            {
                <div class="mt-5 border-t border-slate-100 pt-4">
                    <button type="button"
                            class="px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-xs font-bold shadow-sm transition-colors"
                            @onclick="() => _showScanner = !_showScanner" disabled="@_scanBusy">
                        @(_showScanner ? "Hide Laptop Webcam Scanner" : "Test Scan via Laptop Webcam")
                    </button>

                    @if (_showScanner)
                    {
                        <div class="mt-4 mx-auto max-w-sm overflow-hidden rounded-xl border border-slate-200 bg-slate-900 p-2">
                            <BarcodeReader ScanResult="OnScanResult" Title="Scan the QR code" />
                        </div>
                    }

                    @if (_scanBusy)
                    {
                        <div class="mt-3 flex items-center justify-center gap-2 text-xs text-slate-600" role="status">
                            <span class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-teal-600 border-t-transparent"></span>
                            Simulating QR payment with Xendit&hellip;
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_scanMessage))
                    {
                        <p class="mt-3 text-xs rounded-lg px-3 py-2 @(_scanFailed ? "bg-red-50 text-red-700 border border-red-200" : "bg-emerald-50 text-emerald-800 border border-emerald-200")" role="status">
                            @_scanMessage
                        </p>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string AppointmentId { get; set; } = string.Empty;

    private const string Stage1ReceiptType = "ReservationAcknowledgment";
    private const string FinalReceiptType = "FinalConsolidated";

    private QrPaymentInfoDto? _info;
    private BookingDocumentsBundleDto? _docsBundle;
    private string? _qrSvg;
    private string? _qrConfirmUrl;
    private bool _loading = true;
    private bool _paid;
    private bool _expired;
    private bool _busy;
    private bool _docBusy;
    private bool _agreeAgreement;
    private bool _agreeTerms;
    private string _docTab = "agreement";
    private string? _docError;
    private string? _loadError;
    private string? _paymentError;
    private bool _hubConnected;
    private bool _isMockQr;
    private string _countdown = "--:--";
    private System.Threading.Timer? _timer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Token-protected API calls and the SignalR connection need the interactive circuit (not prerender).
        if (!firstRender) return;

        await LoadAsync();
        _loading = false;
        StateHasChanged();

        if (IsAwaitingPayment(_info))
        {
            try
            {
                await PaymentHub.StartAsync(AppointmentId,
                    onPaymentCompleted: () => InvokeAsync(async () => { ScheduleService.InvalidateCache(); await LoadAsync(); _paid = true; StateHasChanged(); }),
                    onBookingExpired: () => InvokeAsync(async () => { ScheduleService.InvalidateCache(); await LoadAsync(); _expired = true; StateHasChanged(); }));
                _hubConnected = true;
            }
            catch
            {
                _hubConnected = false; // page still works; the customer can refresh after paying
            }
            StateHasChanged();
        }
    }

    private string BaseAppointmentId => AppointmentId.EndsWith("-FINAL", StringComparison.OrdinalIgnoreCase)
        ? AppointmentId[..^"-FINAL".Length]
        : AppointmentId;

    private static bool IsAwaitingPayment(QrPaymentInfoDto? info)
    {
        if (info is null) return false;
        return string.Equals(info.EventStatus, "Pending Payment", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Pending", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Awaiting_Downpayment", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Rescheduled", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAlreadyPaid(QrPaymentInfoDto? info)
    {
        if (info is null) return false;
        if (info.IsFinalPayment)
        {
            return string.Equals(info.EventStatus, "Completed", StringComparison.OrdinalIgnoreCase)
                || string.Equals(info.EventStatus, "Complete", StringComparison.OrdinalIgnoreCase)
                || string.Equals(info.EventStatus, "Shot", StringComparison.OrdinalIgnoreCase)
                || string.Equals(info.EventStatus, "Delivered", StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(info.EventStatus, "Confirmed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Preparation", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Preparing", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Dispatch", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Ongoing", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "On Going", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "In Execution", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Ready", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Event Done", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Post Event", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Shot", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Complete", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Delivered", StringComparison.OrdinalIgnoreCase);
    }

    private async Task RetryLoadAsync()
    {
        _loading = true;
        _loadError = null;
        _docError = null;
        StateHasChanged();
        await LoadAsync();
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        var res = await ConsultationApi.GetQrPaymentAsync(AppointmentId);
        if (!res.IsSuccess)
        {
            _info = null;
            if (res.Error?.Kind == ApiErrorKind.Unauthorized)
            {
                var returnPath = $"/payments/{Uri.EscapeDataString(AppointmentId)}";
                Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnPath)}");
                return;
            }
            if (res.Error?.Kind is ApiErrorKind.Network or ApiErrorKind.Server)
            {
                _loadError = res.Error.Message;
            }
            return;
        }

        _info = res.Value;
        _qrSvg = null;
        _qrConfirmUrl = null;
        _isMockQr = false;

        if (_info != null)
        {
            var docsRes = await ConsultationApi.GetBookingDocumentsAsync(BaseAppointmentId);
            if (docsRes.IsSuccess && docsRes.Value != null)
            {
                _docsBundle = docsRes.Value;
            }
            else if (!_info.IsFinalPayment && !_info.ContractAccepted && !docsRes.IsSuccess)
            {
                _docError = docsRes.Error?.Message ?? "Unable to load agreement details.";
            }
        }

        if (IsAwaitingPayment(_info) && (_info!.IsFinalPayment || _info.ContractAccepted))
        {
            var configuredBase = Config["BaseUrl"]?.Trim();
            var isCurrentLocal = Nav.BaseUri.Contains("localhost", StringComparison.OrdinalIgnoreCase) ||
                                 Nav.BaseUri.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase);
            var effectiveBase = !isCurrentLocal
                ? Nav.BaseUri
                : (!string.IsNullOrWhiteSpace(configuredBase) &&
                   !configuredBase.Contains("localhost", StringComparison.OrdinalIgnoreCase) &&
                   !configuredBase.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase)
                    ? configuredBase
                    : Nav.BaseUri);

            _qrConfirmUrl = QrPaymentLinks.BuildConfirmUrl(effectiveBase, Nav.BaseUri, AppointmentId);

            using var generator = new QRCodeGenerator();
            using var data = generator.CreateQrCode(_qrConfirmUrl, QRCodeGenerator.ECCLevel.M);
            _qrSvg = new SvgQRCode(data).GetGraphic(6);
            _isMockQr = _info.QrString is null ||
                        _info.QrString.StartsWith("MOCK-QRPH", StringComparison.Ordinal) ||
                        _info.QrString.Contains("/checkout/confirm/", StringComparison.OrdinalIgnoreCase);
            StartCountdown();
        }
        else
        {
            if (IsAlreadyPaid(_info))
            {
                _paid = true;
                ScheduleService.InvalidateCache();
            }
            _timer?.Dispose();
        }
    }

    private void StartCountdown()
    {
        _timer?.Dispose();
        UpdateCountdown();
        _timer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            UpdateCountdown();
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void UpdateCountdown()
    {
        if (_info?.LockExpiresAt is null) { _countdown = "--:--"; return; }
        var diff = DateTime.SpecifyKind(_info.LockExpiresAt.Value, DateTimeKind.Utc) - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero)
        {
            _countdown = "00:00";
            _expired = true;
            _timer?.Dispose();
            return;
        }
        _expired = false;
        _countdown = $"{(int)diff.TotalMinutes:D2}:{diff.Seconds:D2}";
    }

    private async Task ConfirmPaymentAsync()
    {
        if (_busy || _info is null) return;
        _busy = true;
        _paymentError = null;
        StateHasChanged();

        try
        {
            var res = await ConsultationApi.SimulateQrPaymentAsync(AppointmentId);
            if (!res.IsSuccess)
            {
                // If live Xendit mode rejects simulation, check whether payment has already cleared on Xendit.
                var verify = await ConsultationApi.VerifyDownpaymentAsync(BaseAppointmentId);
                if (verify.IsSuccess && string.Equals(verify.Value?.DownpaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                {
                    ScheduleService.InvalidateCache();
                    await LoadAsync();
                    _paid = true;
                    return;
                }

                _paymentError = res.Error?.Message ?? "Payment confirmation failed. Please try again.";
                return;
            }

            for (var i = 0; i < 6; i++)
            {
                await LoadAsync();
                if (IsAlreadyPaid(_info))
                {
                    _paid = true;
                    ScheduleService.InvalidateCache();
                    break;
                }
                await Task.Delay(500);
            }

            if (!_paid)
            {
                _paymentError = "Payment was submitted and is awaiting confirmation. Click Refresh Payment Status in a moment.";
            }
        }
        catch (Exception ex)
        {
            _paymentError = "Payment confirmation failed: " + ex.Message;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task RefreshStatusAsync()
    {
        if (_busy) return;
        _busy = true;
        _paymentError = null;
        try
        {
            await LoadAsync();
            if (!IsAlreadyPaid(_info))
            {
                await ConsultationApi.VerifyDownpaymentAsync(BaseAppointmentId);
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task RequestExtensionAsync()
    {
        if (_busy) return;
        _busy = true;
        _paymentError = null;
        try
        {
            var res = await ConsultationApi.RequestExtensionAsync(BaseAppointmentId);
            if (res.IsSuccess && res.Value)
            {
                _expired = false;
                await LoadAsync();
            }
            else
            {
                _paymentError = res.Error?.Message ?? "Unable to extend the reservation hold.";
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task SimulatePaymentAsync()
    {
        if (_busy) return;
        _busy = true;
        _paymentError = null;
        try
        {
            var res = await ConsultationApi.SimulateWebhookPaymentAsync(AppointmentId, "QR Ph");
            if (!res.IsSuccess)
            {
                var qrRes = await ConsultationApi.SimulateQrPaymentAsync(AppointmentId);
                if (!qrRes.IsSuccess)
                    _paymentError = qrRes.Error?.Message ?? res.Error?.Message ?? "Simulation failed.";
            }
            ScheduleService.InvalidateCache();
            if (!_hubConnected || !IsAlreadyPaid(_info)) { await LoadAsync(); }
        }
        finally { _busy = false; }
    }

    private bool _showScanner;
    private bool _scanBusy;
    private bool _scanFailed;
    private string? _scanMessage;

    // Dev-only: invoked by the ZXing webcam reader when a QR code is decoded.
    private Task OnScanResult(string result) => OnQrScannedAsync(result);

    private async Task OnQrScannedAsync(string scanned)
    {
        if (_scanBusy || string.IsNullOrWhiteSpace(scanned)) return;

        // If the scanned QR encodes a /checkout/confirm/{AppointmentId} URL, redirect directly to the confirmation page.
        if (QrPaymentLinks.TryGetConfirmPath(scanned, out var confirmApptId, out var relativeConfirmPath))
        {
            _showScanner = false;
            Nav.NavigateTo("/" + relativeConfirmPath.TrimStart('/'));
            return;
        }

        _scanBusy = true;
        _scanFailed = false;
        _scanMessage = null;
        StateHasChanged();
        try
        {
            var externalId = ExtractExternalId(scanned);
            var res = await ConsultationApi.SimulateQrPaymentAsync(externalId);
            _scanFailed = !res.IsSuccess;
            _scanMessage = res.IsSuccess
                ? "QR scanned and payment simulated. Updating your booking confirmation..."
                : (res.Error?.Message ?? "Xendit simulation failed. Check the API log for details.");
            if (res.IsSuccess)
            {
                _showScanner = false;
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _scanFailed = true;
            _scanMessage = "Simulation request failed: " + ex.Message;
        }
        finally
        {
            _scanBusy = false;
            StateHasChanged();
        }
    }

    // Accepts a /checkout/confirm/{id} URL, a MOCK-QRPH|{ref}|{amount} string, a JSON payload, or a bare reference id.
    // A real Xendit EMV QR string carries no reference, so fall back to this page's booking reference.
    private string ExtractExternalId(string scanned)
    {
        var data = scanned.Trim();
        if (QrPaymentLinks.TryGetConfirmPath(data, out var confirmId, out _))
            return confirmId;
        if (Uri.TryCreate(data, UriKind.Absolute, out var scannedUri))
        {
            var lastSegment = Uri.UnescapeDataString(scannedUri.AbsolutePath.Trim('/').Split('/').LastOrDefault() ?? string.Empty);
            if (!string.IsNullOrWhiteSpace(lastSegment)) return lastSegment;
        }
        if (data.StartsWith("MOCK-QRPH|", StringComparison.Ordinal))
        {
            var parts = data.Split('|');
            if (parts.Length > 1 && !string.IsNullOrWhiteSpace(parts[1])) return parts[1];
        }
        if (data.StartsWith('{'))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(data);
                foreach (var name in new[] { "reference_id", "external_id" })
                    if (doc.RootElement.TryGetProperty(name, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String)
                        return v.GetString()!;
            }
            catch (System.Text.Json.JsonException) { /* not JSON: fall through */ }
        }
        return data.StartsWith("000201", StringComparison.Ordinal) ? AppointmentId : data;
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        await PaymentHub.StopAsync();
    }

    private async Task AcceptAgreementAndProceedAsync()
    {
        _docBusy = true;
        _docError = null;
        var res = await ConsultationApi.AcceptContractAsync(BaseAppointmentId, new AcceptContractRequest
        {
            AgreeToServicesAgreement = _agreeAgreement,
            AgreeToStandardTerms = _agreeTerms,
            TermsVersionId = _docsBundle?.TermsVersion?.TermsVersionId
        });
        _docBusy = false;

        if (!res.IsSuccess)
        {
            _docError = res.Error?.Message ?? "Failed to record contract acceptance.";
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task DownloadAgreementPdfAsync()
    {
        _docBusy = true;
        var res = await ConsultationApi.DownloadContractPdfAsync(BaseAppointmentId);
        _docBusy = false;
        if (res.IsSuccess && res.Value != null)
        {
            await JS.InvokeVoidAsync("aevumDownloadBase64", $"Services-Agreement-{BaseAppointmentId}.pdf", Convert.ToBase64String(res.Value), "application/pdf");
        }
    }

    private async Task DownloadReceiptPdfAsync(string receiptType)
    {
        _docBusy = true;
        var res = await ConsultationApi.DownloadReceiptPdfAsync(BaseAppointmentId, receiptType);
        _docBusy = false;
        if (res.IsSuccess && res.Value != null)
        {
            await JS.InvokeVoidAsync("aevumDownloadBase64", $"{receiptType}-{BaseAppointmentId}.pdf", Convert.ToBase64String(res.Value), "application/pdf");
        }
    }
