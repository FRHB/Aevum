@page "/payments/{AppointmentId}"
@layout CustomerLayout
@using Microsoft.AspNetCore.Authorization
@using PhotoAevumStudio.Web.Services
@using QRCoder
@using ZXingBlazor.Components
@implements IAsyncDisposable
@inject IConsultationClient ConsultationApi
@inject PaymentHubClient PaymentHub
@inject IWebHostEnvironment Env
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Customer,Admin,SystemAdmin,System Admin,Super Admin,Employee,Office Clerk")]

<PageTitle>Reservation Payment - Photo Aevum Studio</PageTitle>

<div class="max-w-xl mx-auto py-10 px-6">
    <a href="/my/bookings" class="text-teal-600 hover:underline font-semibold text-sm">&larr; Back to My Bookings</a>

    @if (_loading)
    {
        <p class="mt-8 text-sm text-slate-500">Loading payment details&hellip;</p>
    }
    else if (_info is null)
    {
        <div class="mt-8 rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-800">
            We couldn't find that booking.
        </div>
    }
    else if (_info.EventStatus == "Confirmed" || _paid)
    {
        <div class="mt-8 rounded-2xl border border-emerald-200 bg-emerald-50 p-8 text-center shadow-sm" role="status">
            <div class="text-5xl mb-3">&#10003;</div>
            <h1 class="text-2xl font-black text-emerald-900">Payment Completed</h1>
            <p class="mt-2 text-sm text-emerald-800">
                Your reservation fee for <strong>@_info.EventName</strong> (#@_info.AppointmentId) has been received.
                Your date and time are now locked in.
            </p>
            <p class="mt-3 text-xs text-slate-600">
                @_info.EventDate.ToString("MMMM dd, yyyy") at @DateTime.Today.Add(_info.EventTime).ToString("h:mm tt")
            </p>
            <a href="/my/bookings" class="inline-block mt-6 px-5 py-2.5 rounded-xl bg-emerald-700 text-white text-sm font-bold">View My Bookings</a>
        </div>
    }
    else if (_info.EventStatus == "Cancelled" || _info.EventStatus == "Expired" || _expired)
    {
        <div class="mt-8 rounded-2xl border border-red-200 bg-red-50 p-8 text-center shadow-sm" role="alert">
            <h1 class="text-2xl font-black text-red-900">Reservation Expired</h1>
            <p class="mt-2 text-sm text-red-800">
                The reservation fee for <strong>@_info.EventName</strong> (#@_info.AppointmentId) was not received in time,
                so the booking was cancelled and the time slot released. Please contact the studio to book again.
            </p>
        </div>
    }
    else
    {
        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm text-center">
            <h1 class="text-2xl font-black text-slate-900">Pay Your Reservation Fee</h1>
            <p class="mt-1 text-xs text-slate-500">@_info.EventName &bull; #@_info.AppointmentId</p>
            <p class="mt-1 text-xs text-slate-500">
                @_info.EventDate.ToString("MMMM dd, yyyy") at @DateTime.Today.Add(_info.EventTime).ToString("h:mm tt")
            </p>

            <div class="mt-5 text-3xl font-black text-slate-900">&#8369;@_info.Amount.ToString("N2")</div>

            @if (!string.IsNullOrEmpty(_qrSvg))
            {
                <div class="mx-auto mt-5 w-64 h-64 p-2 bg-white border border-slate-200 rounded-xl" aria-label="Payment QR code">
                    @((MarkupString)_qrSvg)
                </div>
            }
            else
            {
                <p class="mt-5 text-sm text-red-700">The QR code is not available. Please contact the studio.</p>
            }

            <p class="mt-4 text-xs text-slate-600">
                Open GCash, Maya or any QR&nbsp;Ph-enabled e-wallet and scan this code. This page updates automatically once the payment is received.
            </p>

            <div class="mt-4 inline-block px-4 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-900">
                <div class="text-[10px] uppercase font-bold tracking-wider text-amber-700">Time slot held for</div>
                <div class="font-mono text-lg font-black" aria-live="off">@_countdown</div>
            </div>

            @if (!_hubConnected)
            {
                <p class="mt-3 text-[11px] text-slate-400">Live updates are reconnecting&hellip; you can also refresh this page after paying.</p>
            }

            @if (_isMockQr)
            {
                <div class="mt-5">
                    <button class="px-4 py-2 rounded-lg border border-dashed border-slate-400 text-xs font-semibold text-slate-600"
                            @onclick="SimulatePaymentAsync" disabled="@_busy">
                        Simulate payment (development only)
                    </button>
                </div>
            }

            @if (Env.IsDevelopment())
            {
                <div class="mt-5 border-t border-slate-100 pt-4">
                    <button type="button"
                            class="px-4 py-2 rounded-xl bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-xs font-bold shadow-sm transition-colors"
                            @onclick="() => _showScanner = !_showScanner" disabled="@_scanBusy">
                        @(_showScanner ? "Hide Laptop Webcam Scanner" : "Test Scan via Laptop Webcam")
                    </button>

                    @if (_showScanner)
                    {
                        <div class="mt-4 mx-auto max-w-sm overflow-hidden rounded-xl border border-slate-200 bg-slate-900 p-2">
                            <BarcodeReader ScanResult="OnQrScannedAsync" Title="Scan the QR code" />
                        </div>
                    }

                    @if (_scanBusy)
                    {
                        <div class="mt-3 flex items-center justify-center gap-2 text-xs text-slate-600" role="status">
                            <span class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-teal-600 border-t-transparent"></span>
                            Simulating QR payment with Xendit&hellip;
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_scanMessage))
                    {
                        <p class="mt-3 text-xs rounded-lg px-3 py-2 @(_scanFailed ? "bg-red-50 text-red-700 border border-red-200" : "bg-emerald-50 text-emerald-800 border border-emerald-200")" role="status">
                            @_scanMessage
                        </p>
                    }
                </div>
            }        </div>
    }
</div>

@code {
    [Parameter] public string AppointmentId { get; set; } = string.Empty;

    private QrPaymentInfoDto? _info;
    private string? _qrSvg;
    private bool _loading = true;
    private bool _paid;
    private bool _expired;
    private bool _busy;
    private bool _hubConnected;
    private bool _isMockQr;
    private string _countdown = "--:--";
    private System.Threading.Timer? _timer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Token-protected API calls and the SignalR connection need the interactive circuit (not prerender).
        if (!firstRender) return;

        await LoadAsync();
        _loading = false;
        StateHasChanged();

        if (_info is { EventStatus: "Pending Payment" })
        {
            try
            {
                await PaymentHub.StartAsync(AppointmentId,
                    onPaymentCompleted: () => InvokeAsync(async () => { await LoadAsync(); _paid = true; StateHasChanged(); }),
                    onBookingExpired: () => InvokeAsync(async () => { await LoadAsync(); _expired = true; StateHasChanged(); }));
                _hubConnected = true;
            }
            catch
            {
                _hubConnected = false; // page still works; the customer can refresh after paying
            }
            StateHasChanged();
        }
    }
    private async Task LoadAsync()
    {
        var res = await ConsultationApi.GetQrPaymentAsync(AppointmentId);
        _info = res.IsSuccess ? res.Value : null;
        _qrSvg = null;
        _isMockQr = false;

        if (_info is { EventStatus: "Pending Payment", QrString: { Length: > 0 } qr })
        {
            using var generator = new QRCodeGenerator();
            using var data = generator.CreateQrCode(qr, QRCodeGenerator.ECCLevel.M);
            _qrSvg = new SvgQRCode(data).GetGraphic(6);
            _isMockQr = qr.StartsWith("MOCK-QRPH", StringComparison.Ordinal);
            StartCountdown();
        }
        else
        {
            _timer?.Dispose();
        }
    }

    private void StartCountdown()
    {
        _timer?.Dispose();
        UpdateCountdown();
        _timer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            UpdateCountdown();
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private void UpdateCountdown()
    {
        if (_info?.LockExpiresAt is null) { _countdown = "--:--"; return; }
        var diff = DateTime.SpecifyKind(_info.LockExpiresAt.Value, DateTimeKind.Utc) - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero)
        {
            _countdown = "00:00";
            _timer?.Dispose();
            return;
        }
        _countdown = $"{(int)diff.TotalMinutes:D2}:{diff.Seconds:D2}";
    }

    private async Task SimulatePaymentAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            // Dev-only: the API rejects this once a live Xendit key is configured. Success arrives via SignalR.
            await ConsultationApi.SimulateWebhookPaymentAsync(AppointmentId, "QR Ph");
            if (!_hubConnected) { await LoadAsync(); }
        }
        finally { _busy = false; }
    }

    private bool _showScanner;
    private bool _scanBusy;
    private bool _scanFailed;
    private string? _scanMessage;

    // Dev-only: invoked by the ZXing webcam reader when a QR code is decoded.
    private async Task OnQrScannedAsync(string scanned)
    {
        if (_scanBusy || string.IsNullOrWhiteSpace(scanned)) return;
        _scanBusy = true;
        _scanFailed = false;
        _scanMessage = null;
        StateHasChanged();
        try
        {
            var externalId = ExtractExternalId(scanned);
            var res = await ConsultationApi.SimulateQrPaymentAsync(externalId);
            _scanFailed = !res.IsSuccess;
            _scanMessage = res.IsSuccess
                ? "QR scanned and payment simulated. Please wait for the ngrok webhook to confirm this reservation."
                : "Xendit simulation failed. Check the API log for details.";
            if (res.IsSuccess) _showScanner = false;
        }
        catch (Exception ex)
        {
            _scanFailed = true;
            _scanMessage = "Simulation request failed: " + ex.Message;
        }
        finally
        {
            _scanBusy = false;
            StateHasChanged();
        }
    }

    // Accepts a MOCK-QRPH|{ref}|{amount} string, a JSON payload, or a bare reference id.
    // A real Xendit EMV QR string carries no reference, so fall back to this page's booking reference.
    private string ExtractExternalId(string scanned)
    {
        var data = scanned.Trim();
        if (data.StartsWith("MOCK-QRPH|", StringComparison.Ordinal))
        {
            var parts = data.Split('|');
            if (parts.Length > 1 && !string.IsNullOrWhiteSpace(parts[1])) return parts[1];
        }
        if (data.StartsWith('{'))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(data);
                foreach (var name in new[] { "reference_id", "external_id" })
                    if (doc.RootElement.TryGetProperty(name, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String)
                        return v.GetString()!;
            }
            catch (System.Text.Json.JsonException) { /* not JSON: fall through */ }
        }
        return data.StartsWith("000201", StringComparison.Ordinal) ? AppointmentId : data;
    }
    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        await PaymentHub.StopAsync();
    }
}
