@using System.ComponentModel.DataAnnotations
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IServicesApiClient ServicesApi
@inject ILogger<CategoryWizardModal> Logger

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6 overflow-y-auto animate-in fade-in duration-150"
         role="dialog" aria-modal="true" aria-labelledby="category-modal-title">

        <div class="relative w-full max-w-xl bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden flex flex-col max-h-[90vh]">
            
            @* ── Modal Header ────────────────────────────────────────────────────────── *@
            <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-white shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gray-900 text-white flex items-center justify-center font-bold text-sm shadow-xs">
                        <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                        </svg>
                    </div>
                    <div>
                        <h2 id="category-modal-title" class="text-lg sm:text-xl font-bold text-gray-900">@(IsEditMode ? "Edit Service Category" : "Add New Service Category")</h2>
                        <p class="text-xs text-gray-500">@(IsEditMode ? "Update category classification for master services and package offerings" : "Define classification group for master services and package offerings")</p>
                    </div>
                </div>
                <button type="button" 
                        @onclick="HandleClose" 
                        disabled="@isSaving"
                        class="text-gray-400 hover:text-gray-700 p-2 rounded-lg hover:bg-gray-100 transition-colors"
                        aria-label="Close modal">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @* ── Stepper Navigation Bar (2 Steps) ───────────────────────────────────── *@
            <div class="px-6 pt-4 pb-3 bg-gray-50/70 border-b border-gray-100 shrink-0">
                <nav aria-label="Wizard Steps" class="flex items-center justify-between">
                    
                    @* Step 1: Details *@
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all
                            @(currentStep > 1 ? "bg-emerald-600 text-white shadow-xs" : currentStep == 1 ? "bg-gray-900 text-white shadow-xs ring-4 ring-gray-100" : "bg-gray-200 text-gray-500")">
                            @(currentStep > 1 ? "✓" : "1")
                        </span>
                        <div class="text-left">
                            <p class="text-xs font-semibold @(currentStep == 1 ? "text-gray-900" : "text-gray-500")">Step 1</p>
                            <p class="text-[11px] text-gray-400">Category Details</p>
                        </div>
                    </div>

                    <div class="flex-1 h-0.5 mx-4 @(currentStep > 1 ? "bg-emerald-500" : "bg-gray-200") transition-colors"></div>

                    @* Step 2: Overview & Save *@
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all
                            @(currentStep == 2 ? "bg-gray-900 text-white shadow-xs ring-4 ring-gray-100" : "bg-gray-200 text-gray-500")">
                            2
                        </span>
                        <div class="text-left">
                            <p class="text-xs font-semibold @(currentStep == 2 ? "text-gray-900" : "text-gray-500")">Step 2</p>
                            <p class="text-[11px] text-gray-400">Overview &amp; Save</p>
                        </div>
                    </div>

                </nav>
            </div>

            @* ── Modal Body Content ─────────────────────────────────────────────────── *@
            <div class="p-6 overflow-y-auto flex-1 space-y-5">

                @* Validation / Error Banner *@
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="p-3.5 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl flex items-start gap-3 text-xs" role="alert">
                        <svg class="w-4 h-4 text-rose-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <div class="flex-1">
                            <span class="font-bold">Error:</span> @errorMessage
                        </div>
                        <button type="button" @onclick="() => errorMessage = null" class="text-rose-500 hover:text-rose-700 font-bold">&times;</button>
                    </div>
                }

                @* ══════════════════════════════════════════════════════════════════════
                   WIZARD PAGE 1: DETAILS
                   ══════════════════════════════════════════════════════════════════════ *@
                @if (currentStep == 1)
                {
                    <div class="space-y-4 animate-in fade-in duration-150">
                        <div class="bg-gray-50/50 p-4 rounded-xl border border-gray-100">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Category Classification</h3>
                            <p class="text-xs text-gray-400">Define the category name and description used across service management and customer booking filters.</p>
                        </div>

                        @if (IsEditMode && !string.IsNullOrWhiteSpace(model.GeneratedId))
                        {
                            <div class="p-3 bg-gray-50/80 border border-gray-200 rounded-xl flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500">Service Category ID (Auto-Assigned)</span>
                                    <p class="font-mono text-sm font-bold text-gray-900">@model.GeneratedId</p>
                                </div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                    Read-Only System ID
                                </span>
                            </div>
                        }

                        @* Field: Service Category Name (Text) *@
                        <div>
                            <label for="cat-name" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                                Service Category Name <span class="text-rose-500">*</span>
                            </label>
                            <input id="cat-name"
                                   type="text"
                                   @bind="model.Name"
                                   placeholder="e.g., Maternity & Newborn Photography"
                                   class="w-full px-3.5 py-2.5 text-sm bg-white border @(nameError != null ? "border-rose-400 focus:ring-rose-500" : "border-gray-300 focus:ring-gray-900") rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all shadow-xs" />
                            @if (nameError != null)
                            {
                                <p class="text-xs text-rose-600 mt-1 font-medium">@nameError</p>
                            }
                        </div>

                        @* Field: Service Category Description (TextArea) *@
                        <div>
                            <label for="cat-desc" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                                Service Category Description <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="cat-desc"
                                      rows="4"
                                      @bind="model.Description"
                                      placeholder="Describe the scope of services classified under this category..."
                                      class="w-full px-3.5 py-2.5 text-sm bg-white border @(descError != null ? "border-rose-400 focus:ring-rose-500" : "border-gray-300 focus:ring-gray-900") rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all resize-none shadow-xs"></textarea>
                            @if (descError != null)
                            {
                                <p class="text-xs text-rose-600 mt-1 font-medium">@descError</p>
                            }
                        </div>
                    </div>
                }

                @* ══════════════════════════════════════════════════════════════════════
                   WIZARD PAGE 2: OVERVIEW & SAVE
                   ══════════════════════════════════════════════════════════════════════ *@
                @if (currentStep == 2)
                {
                    <div class="space-y-4 animate-in fade-in duration-150">
                        
                        @* Auto-Generated ID Alert Card *@
                        <div class="bg-gradient-to-r from-gray-900 to-gray-800 text-white rounded-xl p-4 shadow-sm flex items-center justify-between">
                            <div>
                                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
                                    </svg>
                                    System-Assigned Category ID (Strictly Read-Only)
                                </span>
                                <p class="text-xs text-gray-300 mt-0.5">
                                    Auto-generated sequential category identifier assigned by the database backend.
                                </p>
                            </div>
                            <div class="text-right">
                                @if (isGeneratingId)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs text-gray-300">
                                        <svg class="animate-spin w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                        </svg>
                                        Generating...
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-block px-3 py-1.5 bg-white/10 border border-white/20 rounded-lg font-mono text-sm font-bold text-emerald-300 tracking-wider">
                                        @model.GeneratedId
                                    </span>
                                }
                            </div>
                        </div>

                        @* Read-only Overview Card *@
                        <div class="bg-gray-50/70 rounded-xl border border-gray-200 overflow-hidden text-xs divide-y divide-gray-200">
                            
                            <div class="p-3.5 flex justify-between items-center bg-white">
                                <span class="font-medium text-gray-500 uppercase tracking-wider text-[11px]">Category Name</span>
                                <span class="font-bold text-gray-900 text-sm">@model.Name</span>
                            </div>

                            <div class="p-3.5">
                                <span class="block font-medium text-gray-500 uppercase tracking-wider text-[11px] mb-1">Description</span>
                                <p class="text-gray-700 leading-relaxed bg-white p-3 rounded-lg border border-gray-100">
                                    @model.Description
                                </p>
                            </div>

                        </div>
                    </div>
                }

            </div>

            @* ── Modal Footer Controls ──────────────────────────────────────────────── *@
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between shrink-0">
                <div>
                    @if (currentStep > 1)
                    {
                        <button type="button" 
                                @onclick="PrevStep" 
                                disabled="@isSaving"
                                class="px-4 py-2.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-semibold rounded-lg transition-colors cursor-pointer">
                            &larr; Back
                        </button>
                    }
                    else
                    {
                        <button type="button" 
                                @onclick="HandleClose" 
                                disabled="@isSaving"
                                class="px-4 py-2.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-semibold rounded-lg transition-colors cursor-pointer">
                            Cancel
                        </button>
                    }
                </div>

                <div>
                    @if (currentStep == 1)
                    {
                        <button type="button" 
                                @onclick="NextStep"
                                class="inline-flex items-center gap-1.5 px-6 py-2.5 bg-gray-900 hover:bg-black text-white text-xs font-semibold rounded-lg shadow-sm hover:shadow transition-all cursor-pointer">
                            <span>Next Step</span>
                            <span>&rarr;</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" 
                                @onclick="HandleSaveAsync" 
                                disabled="@(isSaving || isGeneratingId)"
                                class="inline-flex items-center gap-2 px-7 py-2.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-bold rounded-lg shadow-sm hover:shadow transition-all disabled:opacity-60 cursor-pointer">
                            @if (isSaving)
                            {
                                <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                </svg>
                                <span>Saving Category...</span>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Save Category</span>
                            }
                        </button>
                    }
                </div>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<string> OnCategorySaved { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public ServiceCategoryItem? EditItem { get; set; }

    private int currentStep = 1;
    private bool isSaving = false;
    private bool isGeneratingId = false;
    private string? errorMessage;

    private string? nameError;
    private string? descError;

    private CategoryWizardModel model = new();
    private bool wasOpen = false;
    private string? _lastEditCode = null;

    protected override void OnParametersSet()
    {
        if (IsOpen && (!wasOpen || (IsEditMode && _lastEditCode != EditItem?.Code)))
        {
            wasOpen = true;
            _lastEditCode = EditItem?.Code;
            ResetWizard();
            if (IsEditMode && EditItem != null)
            {
                model.GeneratedId = EditItem.Code;
                model.Name = EditItem.Name;
                model.Description = EditItem.Description;
            }
        }
        else if (!IsOpen)
        {
            wasOpen = false;
            _lastEditCode = null;
        }
    }

    public void ResetWizard()
    {
        currentStep = 1;
        isSaving = false;
        isGeneratingId = false;
        errorMessage = null;
        nameError = null;
        descError = null;
        model = new CategoryWizardModel();
    }

    private async Task HandleClose()
    {
        if (isSaving) return;
        ResetWizard();
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task NextStep()
    {
        errorMessage = null;
        if (!ValidateStep1())
            return;

        currentStep = 2;
        await PrepareOverviewStepAsync();
    }

    private void PrevStep()
    {
        errorMessage = null;
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private bool ValidateStep1()
    {
        nameError = null;
        descError = null;
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(model.Name))
        {
            nameError = "Category name is required.";
            isValid = false;
        }
        else if (model.Name.Trim().Length < 2)
        {
            nameError = "Category name must be at least 2 characters.";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(model.Description))
        {
            descError = "Category description is required.";
            isValid = false;
        }

        return isValid;
    }

    private async Task PrepareOverviewStepAsync()
    {
        if (IsEditMode && EditItem != null)
        {
            model.GeneratedId = EditItem.Code;
            return;
        }

        if (string.IsNullOrWhiteSpace(model.GeneratedId))
        {
            try
            {
                isGeneratingId = true;
                model.GeneratedId = await ServicesApi.GetNextCategoryIdAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to preview next Category ID.");
                model.GeneratedId = "CAT-0001";
            }
            finally
            {
                isGeneratingId = false;
            }
        }
    }

    private async Task HandleSaveAsync()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            if (IsEditMode && EditItem != null)
            {
                var (success, error) = await ServicesApi.UpdateCategoryAsync(model.GeneratedId, model.Name, model.Description);
                if (!success)
                {
                    errorMessage = error ?? "Failed to update category. Please try again.";
                    return;
                }

                var savedId = model.GeneratedId;
                ResetWizard();
                await OnCategorySaved.InvokeAsync(savedId);
                await HandleClose();
                return;
            }

            var (createSuccess, createError, createdId) = await ServicesApi.CreateCategoryAsync(model);
            if (!createSuccess)
            {
                errorMessage = createError ?? "Failed to save category. Please try again.";
                return;
            }

            var newSavedId = createdId ?? model.GeneratedId;
            ResetWizard();
            await OnCategorySaved.InvokeAsync(newSavedId);
            await HandleClose();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error saving category: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
