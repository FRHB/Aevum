@using PhotoAevumStudio.Web.Models

@if (IsOpen && Employee != null)
{
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
         role="dialog" aria-modal="true" aria-labelledby="staff-overview-title"
         @onclick="CloseAsync">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-xl w-full overflow-hidden"
             @onclick:stopPropagation="true">
            <!-- Profile Header Banner -->
            <div class="relative bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 px-6 pt-5 pb-12 text-white">
                <div class="flex items-center justify-between">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-white/15 text-slate-100 border border-white/15">
                        STAFF ID · @Employee.EmployeeId
                    </span>
                    <button type="button"
                            @onclick="CloseAsync"
                            aria-label="Close staff profile"
                            class="text-slate-300 hover:text-white text-sm font-bold px-2 py-1 rounded-lg hover:bg-white/10 transition-colors cursor-pointer">
                        ✕
                    </button>
                </div>
            </div>

            <!-- Overlapping Profile Avatar & Identity -->
            <div class="px-6 -mt-8 pb-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
                <div class="flex items-end gap-4">
                    <div class="w-16 h-16 rounded-2xl bg-slate-900 text-white font-bold text-lg flex items-center justify-center uppercase ring-4 ring-white shadow-md shrink-0">
                        @Employee.Initials
                    </div>
                    <div class="pt-2">
                        <h3 id="staff-overview-title" class="text-lg font-bold text-slate-900 leading-tight">@Employee.FullName</h3>
                        <p class="text-xs text-slate-500 mt-0.5">
                            @(string.IsNullOrWhiteSpace(Employee.Department) ? "General" : Employee.Department) · @(Employee.Specializations?.FirstOrDefault() ?? "Studio Staff")
                        </p>
                    </div>
                </div>
                <span class="inline-flex items-center gap-1.5 self-start sm:self-end px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    @Employee.Status
                </span>
            </div>

            <div class="p-6 space-y-4 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 bg-slate-50 rounded-xl p-4 border border-slate-200">
                    <div>
                        <span class="text-slate-500 text-[11px] uppercase tracking-wider font-semibold block">Email Address</span>
                        <span class="font-semibold text-slate-900 break-all mt-0.5 block">@(string.IsNullOrWhiteSpace(Employee.Email) ? "—" : Employee.Email)</span>
                    </div>
                    <div>
                        <span class="text-slate-500 text-[11px] uppercase tracking-wider font-semibold block">Department</span>
                        <span class="font-semibold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Employee.Department) ? "General" : Employee.Department)</span>
                    </div>
                    <div>
                        <span class="text-slate-500 text-[11px] uppercase tracking-wider font-semibold block">Scheduled Days Off</span>
                        <span class="font-semibold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Employee.DaysOff) ? "Sunday" : Employee.DaysOff)</span>
                    </div>
                    <div>
                        <span class="text-slate-500 text-[11px] uppercase tracking-wider font-semibold block">Birth Date / Year</span>
                        <span class="font-semibold text-slate-900 mt-0.5 block">
                            @(Employee.BirthDate != null ? Employee.BirthDate.Value.ToString("MMM dd, yyyy") : (Employee.BirthYear != null ? Employee.BirthYear.ToString() : "—"))
                        </span>
                    </div>
                    <div class="sm:col-span-2">
                        <span class="text-slate-500 text-[11px] uppercase tracking-wider font-semibold block">Address</span>
                        <span class="font-semibold text-slate-900 mt-0.5 block">@(string.IsNullOrWhiteSpace(Employee.Address) ? "No address recorded" : Employee.Address)</span>
                    </div>
                </div>

                <div>
                    <span class="text-slate-500 font-semibold uppercase tracking-wider text-[11px] block mb-1.5">Specializations</span>
                    @if (Employee.Specializations != null && Employee.Specializations.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var spec in Employee.Specializations)
                            {
                                <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-800 border border-slate-200 font-medium">@spec</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-slate-400 italic">No specialization assigned</span>
                    }
                </div>

                @if (CanResetPassword && _confirmReset)
                {
                    <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 space-y-2">
                        <p class="font-semibold">
                            Reset @Employee.FullName's password back to their initial creation password?
                        </p>
                        <p class="text-[11px] text-amber-800">
                            An email notification will be dispatched and the staff member will be forced to change their password on next login.
                        </p>
                        <div class="flex justify-end gap-2 pt-1">
                            <button type="button"
                                    @onclick="() => _confirmReset = false"
                                    disabled="@IsResettingPassword"
                                    class="px-3 py-1.5 rounded-lg border border-amber-300 bg-white text-amber-900 font-semibold cursor-pointer">
                                Cancel
                            </button>
                            <button type="button"
                                    @onclick="ConfirmResetPasswordAsync"
                                    disabled="@IsResettingPassword"
                                    class="px-3.5 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-semibold cursor-pointer disabled:opacity-50">
                                @(IsResettingPassword ? "Resetting..." : "Confirm Reset Password")
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between gap-2">
                <div>
                    @if (CanResetPassword && !_confirmReset)
                    {
                        <button type="button"
                                @onclick="() => _confirmReset = true"
                                disabled="@IsResettingPassword"
                                title="Reset Password"
                                aria-label="Reset Password"
                                class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-amber-600 hover:bg-amber-700 text-white shadow-2xs transition-colors cursor-pointer disabled:opacity-50">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                            </svg>
                        </button>
                    }
                </div>
                <button type="button"
                        @onclick="CloseAsync"
                        class="px-4 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EmployeeViewModel? Employee { get; set; }
    [Parameter] public bool CanResetPassword { get; set; }
    [Parameter] public bool IsResettingPassword { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EmployeeViewModel> OnResetPassword { get; set; }

    private bool _confirmReset;

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _confirmReset = false;
        }
    }

    private async Task CloseAsync()
    {
        _confirmReset = false;
        await OnClose.InvokeAsync();
    }

    private async Task ConfirmResetPasswordAsync()
    {
        if (Employee == null || !CanResetPassword) return;
        await OnResetPassword.InvokeAsync(Employee);
        _confirmReset = false;
    }
}
