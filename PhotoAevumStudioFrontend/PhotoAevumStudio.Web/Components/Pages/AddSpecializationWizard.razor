@using System.ComponentModel.DataAnnotations
@using PhotoAevumStudio.Web.Models
@attribute [Authorize(Roles = "Admin")]

@if (IsOpen)
{
    <!-- Modal Backdrop -->
    <div class="fixed inset-0 z-50 bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6 overflow-y-auto animate-in fade-in duration-150"
         role="dialog" aria-modal="true" aria-labelledby="wizard-modal-title">
        
        <!-- Modal Card Container -->
        <div class="relative w-full max-w-xl bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden flex flex-col max-h-[92vh]">
            
            <!-- Modal Header -->
            <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-white sticky top-0 z-10">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gray-900 text-white flex items-center justify-center font-bold text-sm shadow-sm">
                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                        </svg>
                    </div>
                    <div>
                        <h2 id="wizard-modal-title" class="text-xl font-bold text-gray-900">Add New Specialization</h2>
                        <p class="text-xs text-gray-500">Master lookup catalogue configuration</p>
                    </div>
                </div>
                <button type="button" @onclick="HandleClose" disabled="@isSaving"
                        class="text-gray-400 hover:text-gray-600 rounded-lg p-1.5 hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-gray-900"
                        aria-label="Close dialog">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Stepper Progress Bar -->
            <div class="px-6 py-4 bg-gray-50/70 border-b border-gray-100">
                <ol class="flex items-center justify-between w-full">
                    @for (int i = 1; i <= TotalSteps; i++)
                    {
                        var stepNumber = i;
                        var isCompleted = stepNumber < currentStep;
                        var isCurrent = stepNumber == currentStep;
                        
                        <li class="flex items-center @(stepNumber < TotalSteps ? "w-full" : "")">
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all duration-200
                                    @(isCurrent ? "bg-gray-900 text-white shadow-sm ring-2 ring-gray-900/20" : 
                                      isCompleted ? "bg-emerald-600 text-white" : "bg-gray-200 text-gray-600")">
                                    @if (isCompleted)
                                    {
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                        </svg>
                                    }
                                    else
                                    {
                                        @stepNumber
                                    }
                                </span>
                                <span class="text-xs font-medium hidden sm:inline @(isCurrent ? "text-gray-900 font-bold" : isCompleted ? "text-gray-700" : "text-gray-400")">
                                    @StepTitles[stepNumber - 1]
                                </span>
                            </div>

                            @if (stepNumber < TotalSteps)
                            {
                                <div class="flex-1 mx-3 h-0.5 @(stepNumber < currentStep ? "bg-emerald-500" : "bg-gray-200")"></div>
                            }
                        </li>
                    }
                </ol>
            </div>

            <!-- Modal Body / EditForm -->
            <div class="p-6 overflow-y-auto flex-1">
                <EditForm EditContext="@editContext">
                    <DataAnnotationsValidator />

                    @* ==========================================
                       STEP 1: Specialization Details
                       ========================================== *@
                    @if (currentStep == 1)
                    {
                        <div class="space-y-5 animate-in fade-in duration-200">
                            <div>
                                <span class="inline-block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-1">Step 1 of 3</span>
                                <h3 class="text-lg font-bold text-gray-900">Specialization Details</h3>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    Enter the official title and operational scope for this skill classification.
                                </p>
                            </div>

                            <!-- Specialization Name (Required) -->
                            <div>
                                <label for="spec-name" class="block text-sm font-semibold text-gray-800 mb-1.5">
                                    Specialization Name <span class="text-red-500">*</span>
                                </label>
                                <InputText id="spec-name" 
                                           @bind-Value="model.Name" 
                                           placeholder="e.g., Drone Operator, Lead Colorist, Wedding Lead"
                                           class="w-full px-3.5 py-2.5 text-sm bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition-all shadow-sm" />
                                <ValidationMessage For="@(() => model.Name)" class="text-xs text-red-600 mt-1 font-medium" />
                                <p class="text-[11px] text-gray-400 mt-1">This name will appear as a selectable badge across the platform.</p>
                            </div>

                            <!-- Description (Optional) -->
                            <div>
                                <div class="flex justify-between items-center mb-1.5">
                                    <label for="spec-desc" class="block text-sm font-semibold text-gray-800">
                                        Description <span class="text-gray-400 font-normal text-xs">(Optional)</span>
                                    </label>
                                    <span class="text-[11px] text-gray-400">@((model.Description ?? string.Empty).Length)/300</span>
                                </div>
                                <InputTextArea id="spec-desc" 
                                               rows="3" 
                                               @bind-Value="model.Description" 
                                               placeholder="Describe key responsibilities, required gear competence, or studio event scope..."
                                               class="w-full px-3.5 py-2.5 text-sm bg-white border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition-all shadow-sm resize-none" />
                                <ValidationMessage For="@(() => model.Description)" class="text-xs text-red-600 mt-1 font-medium" />
                            </div>

                            <!-- Step 1 Info Callout -->
                            <div class="p-3.5 bg-gray-50 border border-gray-200 rounded-xl flex items-start gap-3">
                                <div class="text-gray-500 text-sm mt-0.5">💡</div>
                                <div class="text-xs text-gray-600 leading-relaxed">
                                    Specializations are studio-wide definitions. In the next steps you will assign a primary department and a distinct UI color tag.
                                </div>
                            </div>
                        </div>
                    }

                    @* ==========================================
                       STEP 2: Display Settings & Category
                       ========================================== *@
                    @if (currentStep == 2)
                    {
                        <div class="space-y-6 animate-in fade-in duration-200">
                            <div>
                                <span class="inline-block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-1">Step 2 of 3</span>
                                <h3 class="text-lg font-bold text-gray-900">Display Settings & Department</h3>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    Categorize the skill and choose a color scheme for visual badges.
                                </p>
                            </div>

                            <!-- Department/Category Dropdown -->
                            <div>
                                <label for="spec-dept" class="block text-sm font-semibold text-gray-800 mb-1.5">
                                    Department / Category <span class="text-red-500">*</span>
                                </label>
                                <InputSelect id="spec-dept" 
                                             @bind-Value="model.Department"
                                             class="w-full px-3.5 py-2.5 text-sm bg-white border border-gray-300 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition-all shadow-sm">
                                    <option value="Photography">Photography</option>
                                    <option value="Videography">Videography</option>
                                    <option value="Post-Processing">Post-Processing & Editing</option>
                                    <option value="Studio Staff">Studio Staff & Operations</option>
                                    <option value="Creative Direction">Creative Direction</option>
                                    <option value="Lighting & Sound">Lighting & Sound</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => model.Department)" class="text-xs text-red-600 mt-1 font-medium" />
                            </div>

                            <!-- UI Color Tag Picker -->
                            <div>
                                <label class="block text-sm font-semibold text-gray-800 mb-2">
                                    UI Color Tag <span class="text-red-500">*</span>
                                </label>
                                
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                                    @foreach (var colorOption in ColorOptions)
                                    {
                                        var isSelected = model.ColorTag.Equals(colorOption.Key, StringComparison.OrdinalIgnoreCase);
                                        var classes = SpecializationColorHelper.GetClasses(colorOption.Key);

                                        <button type="button" 
                                                @onclick="() => model.ColorTag = colorOption.Key"
                                                class="flex items-center gap-2.5 p-2.5 rounded-xl border text-left transition-all duration-150 @(isSelected ? "border-gray-900 bg-gray-50 shadow-sm ring-2 ring-gray-900/10" : "border-gray-200 hover:border-gray-300 bg-white")">
                                            <span class="w-4 h-4 rounded-full @classes.DotClass shrink-0 shadow-xs"></span>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-xs font-semibold text-gray-900 truncate">@colorOption.Label</p>
                                                <p class="text-[10px] text-gray-500 truncate">@colorOption.Usage</p>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <svg class="w-4 h-4 text-gray-900 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                                </svg>
                                            }
                                        </button>
                                    }
                                </div>
                                <ValidationMessage For="@(() => model.ColorTag)" class="text-xs text-red-600 mt-1 font-medium" />
                            </div>

                            <!-- Live Tag Preview Card -->
                            <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl">
                                <span class="text-[11px] font-semibold text-gray-500 uppercase tracking-wider block mb-2">Live Badge Preview</span>
                                <div class="flex items-center gap-3">
                                    @{
                                        var previewClasses = SpecializationColorHelper.GetClasses(model.ColorTag);
                                    }
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold @previewClasses.BadgeClass">
                                        <span class="w-2 h-2 rounded-full @previewClasses.DotClass"></span>
                                        @(string.IsNullOrWhiteSpace(model.Name) ? "Sample Specialization" : model.Name)
                                    </span>
                                    <span class="text-xs text-gray-500">
                                        in <span class="font-medium text-gray-700">@model.Department</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    }

                    @* ==========================================
                       STEP 3: Overview & Save
                       ========================================== *@
                    @if (currentStep == 3)
                    {
                        <div class="space-y-5 animate-in fade-in duration-200">
                            <div>
                                <span class="inline-block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-1">Step 3 of 3</span>
                                <h3 class="text-lg font-bold text-gray-900">Overview & Confirmation</h3>
                                <p class="text-xs text-gray-500 mt-0.5">
                                    Review the specialization specification before saving it to the database.
                                </p>
                            </div>

                            <!-- CRITICAL DATABASE RULE NOTICE -->
                            <div class="p-4 bg-amber-50/90 border border-amber-200 rounded-xl text-amber-900 flex items-start gap-3 shadow-xs">
                                <div class="text-amber-600 text-base mt-0.5">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div class="text-xs leading-relaxed">
                                    <strong class="font-bold block text-amber-950 mb-0.5">Critical Database Master Rule:</strong>
                                    Saving this wizard will <span class="underline font-semibold">ONLY</span> insert a new record into the master <code class="font-mono bg-amber-100 px-1 py-0.5 rounded text-[11px]">Specializations</code> lookup table. It will <span class="font-bold text-amber-950">NOT</span> alter or assign any employee profile automatically.
                                </div>
                            </div>

                            <!-- Summary Card -->
                            <div class="border border-gray-200 rounded-xl overflow-hidden divide-y divide-gray-100 text-sm bg-white shadow-xs">
                                <div class="flex items-center justify-between px-4 py-3 bg-gray-50/60">
                                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Specialization Title</span>
                                    <span class="font-bold text-gray-900">@model.Name</span>
                                </div>
                                <div class="flex items-center justify-between px-4 py-3">
                                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Department</span>
                                    <span class="font-medium text-gray-800">@model.Department</span>
                                </div>
                                <div class="flex items-center justify-between px-4 py-3 bg-gray-50/60">
                                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">UI Badge Preview</span>
                                    <div>
                                        @{
                                            var finalClasses = SpecializationColorHelper.GetClasses(model.ColorTag);
                                        }
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold @finalClasses.BadgeClass">
                                            <span class="w-2 h-2 rounded-full @finalClasses.DotClass"></span>
                                            @model.Name
                                        </span>
                                    </div>
                                </div>
                                <div class="px-4 py-3">
                                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1">Description</span>
                                    <p class="text-xs text-gray-700 leading-relaxed italic">
                                        @(string.IsNullOrWhiteSpace(model.Description) ? "No description provided." : model.Description)
                                    </p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(saveErrorMessage))
                            {
                                <div class="p-3 bg-red-50 border border-red-200 rounded-lg text-xs text-red-700 font-medium" role="alert">
                                    @saveErrorMessage
                                </div>
                            }
                        </div>
                    }
                </EditForm>
            </div>

            <!-- Modal Footer Controls -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
                <div>
                    @if (currentStep > 1)
                    {
                        <button type="button" @onclick="HandlePrevStep" disabled="@isSaving"
                                class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-semibold rounded-lg shadow-xs transition-colors disabled:opacity-50">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                            Back
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="HandleClose" disabled="@isSaving"
                                class="px-4 py-2.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-semibold rounded-lg shadow-xs transition-colors disabled:opacity-50">
                            Cancel
                        </button>
                    }
                </div>

                <div class="flex items-center gap-3">
                    @if (currentStep < TotalSteps)
                    {
                        <button type="button" @onclick="HandleNextStep"
                                class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-gray-900 hover:bg-black text-white text-xs font-semibold rounded-lg shadow-sm transition-all duration-150 active:scale-95">
                            Next
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="HandleSaveAsync" disabled="@isSaving"
                                class="inline-flex items-center gap-2 px-6 py-2.5 bg-gray-900 hover:bg-black text-white text-xs font-semibold rounded-lg shadow-sm transition-all duration-150 disabled:opacity-60 active:scale-95">
                            @if (isSaving)
                            {
                                <svg class="animate-spin -ml-1 mr-1 h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Saving to Master DB...</span>
                            }
                            else
                            {
                                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Save Specialization</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<SpecializationLookupItem> OnSpecializationCreated { get; set; }

    private const int TotalSteps = 3;
    private static readonly string[] StepTitles = { "Details", "Category & Display", "Overview & Save" };

    private int currentStep = 1;
    private bool isSaving = false;
    private string? saveErrorMessage;

    private SpecializationModel model = new();
    private EditContext editContext = null!;
    private ValidationMessageStore messageStore = null!;

    private record ColorChoice(string Key, string Label, string Usage);

    private static readonly List<ColorChoice> ColorOptions = new()
    {
        new("Blue", "Studio Blue", "Default / Camera"),
        new("Emerald", "Emerald Green", "Creative / Stylist"),
        new("Purple", "Studio Purple", "Videography / Aerial"),
        new("Amber", "Warm Amber", "Lighting / Electrical"),
        new("Rose", "Rose Red", "Staff / Coordinator"),
        new("Indigo", "Deep Indigo", "Post-Processing"),
        new("Cyan", "Cyan Modern", "Technical / Digital")
    };

    protected override void OnInitialized()
    {
        ResetWizard();
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && currentStep == 1 && string.IsNullOrWhiteSpace(model.Name))
        {
            ResetWizard();
        }
    }

    private void ResetWizard()
    {
        currentStep = 1;
        isSaving = false;
        saveErrorMessage = null;
        model = new SpecializationModel();
        editContext = new EditContext(model);
        messageStore = new ValidationMessageStore(editContext);
    }

    private void HandleNextStep()
    {
        saveErrorMessage = null;

        if (currentStep == 1)
        {
            // Validate Step 1 fields (Name is mandatory)
            var nameField = editContext.Field(nameof(model.Name));
            editContext.NotifyFieldChanged(nameField);
            
            messageStore.Clear(nameField);
            if (string.IsNullOrWhiteSpace(model.Name))
            {
                messageStore.Add(nameField, "Specialization name is required.");
                editContext.NotifyValidationStateChanged();
                return;
            }
            if (model.Name.Length < 2)
            {
                messageStore.Add(nameField, "Specialization name must be at least 2 characters.");
                editContext.NotifyValidationStateChanged();
                return;
            }

            currentStep = 2;
        }
        else if (currentStep == 2)
        {
            // Validate Step 2 fields
            if (string.IsNullOrWhiteSpace(model.Department) || string.IsNullOrWhiteSpace(model.ColorTag))
            {
                return;
            }
            currentStep = 3;
        }
    }

    private void HandlePrevStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
            saveErrorMessage = null;
        }
    }

    private async Task HandleClose()
    {
        if (isSaving) return;
        ResetWizard();
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSaveAsync()
    {
        // Complete form validation
        if (!editContext.Validate())
        {
            currentStep = 1; // Return to first invalid step
            return;
        }

        try
        {
            isSaving = true;
            saveErrorMessage = null;

            // =========================================================================
            // CRITICAL DATABASE RULE ENFORCEMENT:
            // The created item is strictly a master lookup item (table: dbo.EmployeeSpecialization
            // / master Specializations table).
            // It is NEVER inserted into employee joint tables (dbo.EmployeeJointSpecialization).
            // =========================================================================
            var newMasterItem = new SpecializationLookupItem
            {
                Id = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant(),
                Name = model.Name.Trim(),
                Description = model.Description?.Trim(),
                Department = model.Department,
                ColorTag = model.ColorTag,
                CreatedAt = DateTime.UtcNow
            };

            // Simulate slight async network delay or service call
            await Task.Delay(400);

            // Notify parent component to update master catalog
            await OnSpecializationCreated.InvokeAsync(newMasterItem);

            // Close dialog
            await HandleClose();
        }
        catch (Exception ex)
        {
            saveErrorMessage = $"An error occurred while creating the specialization: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
