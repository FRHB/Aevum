@page "/admin/portfolio/features"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, SystemAdmin, Super Admin, Office Clerk")]
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IPortfolioService PortfolioService

<PageTitle>Featured Portfolio Showcases | Photo Aevum Studio</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                <span>Portfolio</span>
                <span>/</span>
                <span class="text-slate-900 font-bold">Featured Showcases</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Featured Studio Showcases</h1>
            <p class="text-sm text-slate-500 mt-0.5">Curated visual portfolios currently displayed on the studio home page and client portfolios.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/admin/portfolio/images" class="inline-flex items-center gap-1.5 px-4 py-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-100 transition-colors">
                <span>📁 Manage All Folders</span>
            </a>
            <a href="/#portfolio" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-900 hover:bg-black text-white rounded-lg text-xs font-semibold uppercase tracking-wider shadow-sm transition-colors">
                <span>View Live Site ↗</span>
            </a>
        </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2">
        <button type="button"
                @onclick='() => _selectedCategory = "All"'
                class="px-3.5 py-1.5 text-xs font-semibold rounded-lg transition-colors @(_selectedCategory == "All" ? "bg-slate-900 text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")">
            All Featured (@_featuredPortfolios.Count)
        </button>
        @foreach (var cat in _categories)
        {
            var count = _featuredPortfolios.Count(p => string.Equals(p.CategoryID, cat.CategoryID, StringComparison.OrdinalIgnoreCase));
            if (count > 0)
            {
                <button type="button"
                        @onclick="() => _selectedCategory = cat.CategoryID"
                        class="px-3.5 py-1.5 text-xs font-semibold rounded-lg transition-colors @(_selectedCategory == cat.CategoryID ? "bg-slate-900 text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")">
                    @cat.CategoryName (@count)
                </button>
            }
        }
    </div>

    <!-- Gallery Cards -->
    @if (_isLoading)
    {
        <div class="p-16 text-center text-slate-400 text-xs">
            <span class="inline-block w-6 h-6 border-2 border-slate-400/30 border-t-slate-900 rounded-full animate-spin mb-2"></span>
            <p>Loading featured showcases...</p>
        </div>
    }
    else if (FilteredPortfolios.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm">
            <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-500 flex items-center justify-center mx-auto mb-3 text-2xl">★</div>
            <h3 class="text-sm font-bold text-slate-900">No Featured Portfolios Yet</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                Navigate to <a href="/admin/portfolio/images" class="font-bold underline text-slate-800">Portfolio Images</a> and flip the "Featured" toggle on any album to display it here.
            </p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var port in FilteredPortfolios)
            {
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all overflow-hidden flex flex-col group">
                    <!-- Highlight Image -->
                    <div class="relative h-64 bg-slate-950 overflow-hidden cursor-pointer" @onclick="() => _activeGallery = port">
                        <img src="@port.HighlightImageUrl"
                             alt="@port.PortfolioName"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                             onerror="this.src='images/AevumLogo.jpg';" />

                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-black/20"></div>

                        <div class="absolute top-3 left-3">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-400 text-slate-950 shadow-md">
                                ★ Featured
                            </span>
                        </div>

                        <div class="absolute top-3 right-3">
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-black/60 backdrop-blur-sm text-white">
                                📷 @(port.Images?.Count ?? 0)
                            </span>
                        </div>

                        <div class="absolute bottom-4 left-4 right-4 text-white">
                            <span class="text-[10px] uppercase font-bold tracking-wider text-amber-400 block mb-0.5">@port.CategoryName</span>
                            <h3 class="font-bold text-lg leading-snug drop-shadow-sm">@port.PortfolioName</h3>
                        </div>
                    </div>

                    <!-- Details -->
                    <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                        <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(port.PortfolioDescription) ? "Curated photography showcase from the artisan Photo Aevum Studio." : port.PortfolioDescription)
                        </p>

                        <!-- Thumbnail Strip -->
                        @if ((port.Images?.Count ?? 0) > 1)
                        {
                            <div class="flex items-center gap-2 overflow-x-auto py-1">
                                @foreach (var thumb in port.Images.Take(5))
                                {
                                    <div class="w-12 h-12 rounded-lg overflow-hidden border border-slate-200 shrink-0 cursor-pointer" @onclick="() => _activeGallery = port">
                                        <img src="@thumb.Url" alt="Thumb" class="w-full h-full object-cover hover:opacity-80" />
                                    </div>
                                }
                            </div>
                        }

                        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="text-slate-400">Added @port.CreatedAt.ToString("MMM d, yyyy")</span>
                            <button type="button"
                                    @onclick="() => _activeGallery = port"
                                    class="font-bold text-slate-900 hover:underline flex items-center gap-1">
                                View Full Album &rarr;
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Lightbox Modal -->
@if (_activeGallery != null)
{
    <div class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-4xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-base text-slate-900">@_activeGallery.PortfolioName</h3>
                    <p class="text-xs text-slate-500">@_activeGallery.CategoryName &bull; @(_activeGallery.Images?.Count ?? 0) photo(s)</p>
                </div>
                <button type="button" @onclick="() => _activeGallery = null" class="text-slate-400 hover:text-slate-700 text-lg">✕</button>
            </div>

            <div class="p-6 overflow-y-auto flex-1">
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                    @foreach (var img in _activeGallery.Images)
                    {
                        <div class="rounded-xl overflow-hidden border border-slate-200 aspect-square bg-slate-100 shadow-sm group">
                            <img src="@img.Url" alt="Photo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PortfolioFolderModel> _featuredPortfolios = new();
    private List<PortfolioCategoryModel> _categories = new();
    private bool _isLoading = true;
    private string _selectedCategory = "All";
    private PortfolioFolderModel? _activeGallery;

    private List<PortfolioFolderModel> FilteredPortfolios => _featuredPortfolios
        .Where(p => _selectedCategory == "All" || string.Equals(p.CategoryID, _selectedCategory, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _categories = await PortfolioService.GetCategoriesAsync();
            _featuredPortfolios = await PortfolioService.GetFeaturedPortfoliosAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
