@page "/admin/upload-event-customer"
@page "/staff/upload-event-customer"
@layout SidebarLayout
@attribute [Authorize(Roles = "Admin,SystemAdmin,Employee,Office Clerk")]
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject ICustomerDropboxClient DropboxClient
@inject IUserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject DropboxBackgroundUploadService UploadService
@inject IJSRuntime JS

<PageTitle>Upload Event Customer | Photo Aevum Studio</PageTitle>

<header class="aev-page-header">
    <div>
        <h1 class="aev-page-header__title">Upload Event Customer</h1>
        <p class="aev-page-header__subtitle">
            Click any completed event pill-box below to upload a ZIP archive directly to that customer&apos;s isolated Cloudflare R2 Dropbox.
        </p>
    </div>
    <button type="button"
            @onclick="LoadContainersAsync"
            disabled="@_loading"
            class="px-4 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 shadow-sm transition-colors">
        @(_loading ? "Refreshing..." : "Refresh Events")
    </button>
</header>

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="mb-5 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between">
        <span>@_successMessage</span>
        <button type="button" @onclick="() => _successMessage = null" class="text-emerald-700 hover:text-emerald-900">Dismiss</button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="mb-5 px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between">
        <span>@_errorMessage</span>
        <button type="button" @onclick="() => _errorMessage = null" class="text-rose-700 hover:text-rose-900">Dismiss</button>
    </div>
}

<section class="bg-white border border-slate-200 rounded-2xl p-4 mb-6 shadow-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
        <button type="button"
                @onclick='() => _statusFilter = "All"'
                class="px-3 py-1.5 rounded-full text-xs font-bold border transition-colors @(_statusFilter == "All" ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
            All (@_containers.Count)
        </button>
        <button type="button"
                @onclick='() => _statusFilter = "Waiting"'
                class="px-3 py-1.5 rounded-full text-xs font-bold border transition-colors @(_statusFilter == "Waiting" ? "bg-amber-600 text-white border-amber-600" : "bg-white text-slate-600 border-slate-200 hover:bg-amber-50")">
            Waiting (@_containers.Count(c => c.IsWaitingForUpload))
        </button>
        <button type="button"
                @onclick='() => _statusFilter = "Uploaded"'
                class="px-3 py-1.5 rounded-full text-xs font-bold border transition-colors @(_statusFilter == "Uploaded" ? "bg-teal-700 text-white border-teal-700" : "bg-white text-slate-600 border-slate-200 hover:bg-teal-50")">
            Uploaded (@_containers.Count(c => c.HasFile))
        </button>
        <button type="button"
                @onclick='() => _statusFilter = "Expired"'
                class="px-3 py-1.5 rounded-full text-xs font-bold border transition-colors @(_statusFilter == "Expired" ? "bg-slate-600 text-white border-slate-600" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-100")">
            Expired (@_containers.Count(c => c.IsEffectivelyExpired))
        </button>
    </div>

    <div class="w-full sm:w-72">
        <input type="search"
               @bind="_searchQuery"
               @bind:event="oninput"
               placeholder="Search event, ID, or customer..."
               class="w-full px-3.5 py-2 rounded-full border border-slate-200 text-xs focus:outline-none focus:border-teal-600" />
    </div>
</section>

@if (_loading)
{
    <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center shadow-sm">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-teal-600 border-t-transparent mb-3"></div>
        <p class="text-sm text-slate-500">Loading completed event containers...</p>
    </div>
}
else if (!FilteredContainers.Any())
{
    <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 mb-1">No Completed Event Containers</h2>
        <p class="text-sm text-slate-500">
            Completed events will appear here automatically as pill-box containers ready for customer ZIP uploads.
        </p>
    </div>
}
else
{
    <div class="space-y-3" role="list" aria-label="Completed event upload containers">
        @foreach (var item in FilteredContainers)
        {
            var activeJob = UploadService.GetActiveJobForEvent(item.EventAppointmentId);
            var isRowUploading = activeJob != null && activeJob.IsActive;
            var isExpired = item.IsEffectivelyExpired;
            var pillStateClass = isExpired
                ? "is-expired"
                : (item.HasFile ? "is-uploaded" : "is-waiting");

            <button type="button"
                    role="listitem"
                    @key="item.DropboxId"
                    disabled="@isExpired"
                    @onclick="() => OpenUploadModal(item)"
                    class="aev-event-pillbox @pillStateClass @(isRowUploading ? "is-uploading" : string.Empty)">
                <div class="aev-event-pillbox__left">
                    <span class="aev-event-pillbox__id">#@item.EventAppointmentId</span>
                    <div class="min-w-0 text-left">
                        <div class="text-sm font-extrabold @(isExpired ? "text-slate-500" : "text-slate-900") truncate">@item.EventName</div>
                        <div class="text-xs text-slate-500 flex flex-wrap items-center gap-x-2 gap-y-0.5 mt-0.5">
                            <span>Customer: <strong class="@(isExpired ? "text-slate-500" : "text-slate-700")">@(string.IsNullOrWhiteSpace(item.CustomerName) ? item.CustomerId : item.CustomerName)</strong></span>
                            @if (!string.IsNullOrWhiteSpace(item.CustomerEmail))
                            {
                                <span>&bull; @item.CustomerEmail</span>
                            }
                            <span>&bull; @item.EventDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="aev-event-pillbox__right">
                    @if (isExpired)
                    {
                        <span class="aev-pill-badge aev-pill-badge--expired">
                            Expired &mdash; Unavailable
                        </span>
                        <span class="aev-pill-action is-unavailable">
                            Unavailable
                        </span>
                    }
                    else
                    {
                        @if (isRowUploading && activeJob != null)
                        {
                            <span class="aev-pill-badge aev-pill-badge--uploading" title="@activeJob.FileName">
                                @(activeJob.IsFinalizing ? "Finalizing in R2" : "Uploading in Background")
                            </span>
                        }
                        else if (item.HasFile)
                        {
                            <span class="aev-pill-badge aev-pill-badge--uploaded" title="@item.OriginalFileName (@item.FormattedFileSize)">
                                ✓ ZIP Uploaded (@item.FormattedFileSize)
                            </span>
                        }
                        else
                        {
                            <span class="aev-pill-badge aev-pill-badge--waiting">
                                ⏳ Waiting for Upload
                            </span>
                        }
                        <span class="aev-pill-badge aev-pill-badge--days">
                            @item.EffectiveCountdownLabel
                        </span>
                        @if (isRowUploading && activeJob != null)
                        {
                            var rowPct = activeJob.Percent;
                            var rowDashOffset = CircleCircumferenceSm * (1.0 - Math.Clamp(rowPct, 0, 100) / 100.0);
                            <span class="aev-pill-upload-circle"
                                  role="progressbar"
                                  aria-label="ZIP upload progress for #@item.EventAppointmentId"
                                  aria-valuenow="@rowPct"
                                  aria-valuemin="0"
                                  aria-valuemax="100">
                                <span class="aev-circle-progress aev-circle-progress--sm">
                                    <svg class="aev-circle-progress__svg" viewBox="0 0 36 36" aria-hidden="true">
                                        <circle class="aev-circle-progress__track" cx="18" cy="18" r="15" />
                                        <circle class="aev-circle-progress__fill @(activeJob.IsFinalizing ? "is-finalizing" : string.Empty)"
                                                cx="18" cy="18" r="15"
                                                stroke-dasharray="@CircleCircumferenceSmStr"
                                                stroke-dashoffset="@rowDashOffset.ToString("0.##", CultureInfo.InvariantCulture)" />
                                    </svg>
                                    <span class="aev-circle-progress__sm-text">@rowPct%</span>
                                </span>
                                <span class="aev-pill-upload-circle__label">
                                    @(activeJob.IsFinalizing ? "Finalizing" : "Uploading")
                                </span>
                            </span>
                        }
                        else
                        {
                            <span class="aev-pill-action">
                                @(item.HasFile ? "Replace ZIP" : "Upload ZIP") &rarr;
                            </span>
                        }
                    }
                </div>
            </button>
        }
    </div>
}

@if (_selectedContainer != null)
{
    var activeModalJob = UploadService.GetActiveJobForEvent(_selectedContainer.EventAppointmentId);
    var latestModalJob = UploadService.GetLatestJobForEvent(_selectedContainer.EventAppointmentId);
    var modalUploading = (activeModalJob != null && activeModalJob.IsActive) || _isUploading;
    if (activeModalJob != null && activeModalJob.IsActive)
    {
        _uploadPercent = activeModalJob.Percent;
        _uploadTotalBytes = activeModalJob.TotalBytes;
        Interlocked.Exchange(ref _uploadBytesSent, activeModalJob.BytesSent);
    }
    var modalErrorText = !string.IsNullOrWhiteSpace(_modalError)
        ? _modalError
        : (latestModalJob?.Status == DropboxUploadJobStatus.Failed ? latestModalJob.ErrorMessage : null);

    <div class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4"
         @onclick="CloseUploadModal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="dropboxUploadModalTitle">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-lg overflow-hidden"
             @onclick:stopPropagation="true">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <div>
                    <span class="font-mono text-[11px] font-bold px-2 py-0.5 rounded bg-slate-900 text-white">#@_selectedContainer.EventAppointmentId</span>
                    <h2 id="dropboxUploadModalTitle" class="text-base font-extrabold text-slate-900 mt-1">
                        Upload Customer ZIP Archive
                    </h2>
                </div>
                <button type="button" @onclick="CloseUploadModal" class="text-slate-400 hover:text-slate-700 text-lg font-bold" title="Close modal">✕</button>
            </div>

            <div class="p-6 space-y-4">
                <div class="rounded-xl bg-slate-50 border border-slate-200 p-4 text-xs space-y-1.5">
                    <div><span class="text-slate-500">Event:</span> <strong class="text-slate-900">@_selectedContainer.EventName</strong></div>
                    <div>
                        <span class="text-slate-500">Isolated Customer:</span>
                        <strong class="text-slate-900">@(string.IsNullOrWhiteSpace(_selectedContainer.CustomerName) ? _selectedContainer.CustomerId : _selectedContainer.CustomerName)</strong>
                        <span class="font-mono text-[11px] text-slate-500">(@_selectedContainer.CustomerId)</span>
                    </div>
                    <div><span class="text-slate-500">Event Date:</span> <strong class="text-slate-900">@_selectedContainer.EventDate.ToString("MMMM dd, yyyy")</strong></div>
                    @if (_selectedContainer.HasFile)
                    {
                        <div>
                            <span class="text-slate-500">30-Day Retention Expiry:</span>
                            <strong class="text-teal-700">@_selectedContainer.EffectiveCountdownLabel</strong>
                            @if (_selectedContainer.ExpiresAt.HasValue)
                            {
                                <span>(expires @_selectedContainer.ExpiresAt.Value.ToString("MMM dd, yyyy"))</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div>
                            <span class="text-slate-500">Image Delivery Window:</span>
                            <strong class="text-amber-700">@_selectedContainer.DeliveryBusinessDays business days (@_selectedContainer.EffectiveCountdownLabel)</strong>
                        </div>
                        <div>
                            <span class="text-slate-500">Retention Policy:</span>
                            <strong class="text-slate-700">30-day retention starts after upload</strong>
                        </div>
                    }
                </div>

                @if (_selectedContainer.HasFile)
                {
                    <div class="rounded-xl bg-teal-50 border border-teal-200 px-3.5 py-2.5 text-xs text-teal-900">
                        Current file: <strong>@_selectedContainer.OriginalFileName</strong> (@_selectedContainer.FormattedFileSize). Uploading a new ZIP will replace it.
                    </div>
                }

                @if (!modalUploading)
                {
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-2">Select Photo Archive (.zip, max 500 MB)</label>
                        <label for="zipUploadInput" class="aev-zip-dropzone">
                            <InputFile id="zipUploadInput"
                                       OnChange="OnZipSelected"
                                       accept=".zip,application/zip,application/x-zip-compressed"
                                       style="display:none;" />
                            <div class="text-center space-y-1">
                                <div class="text-sm font-bold text-slate-800">
                                    @(_selectedFile != null ? _selectedFile.Name : "Click to choose a .zip file")
                                </div>
                                <div class="text-xs text-slate-500">
                                    @(_selectedFile != null ? FormatBytes(_selectedFile.Size) : "Strictly isolated to this customer's Cloudflare R2 folder")
                                </div>
                            </div>
                        </label>
                    </div>
                }

                @if (modalUploading)
                {
                    var sentBytes = Interlocked.Read(ref _uploadBytesSent);
                    var finalizingR2 = activeModalJob?.IsFinalizing == true || (_uploadTotalBytes > 0 && sentBytes >= _uploadTotalBytes);
                    var displayFileName = activeModalJob?.FileName ?? _selectedFile?.Name ?? "archive.zip";
                    var dashOffsetLg = CircleCircumferenceLg * (1.0 - Math.Clamp(_uploadPercent, 0, 100) / 100.0);

                    <div class="aev-upload-progress-card" aria-live="polite">
                        <div class="aev-upload-progress aev-circle-progress aev-circle-progress--lg"
                             role="progressbar"
                             aria-label="ZIP archive upload progress"
                             aria-valuenow="@_uploadPercent"
                             aria-valuemin="0"
                             aria-valuemax="100">
                            <svg class="aev-circle-progress__svg" viewBox="0 0 88 88" aria-hidden="true">
                                <circle class="aev-circle-progress__track" cx="44" cy="44" r="38" />
                                <circle class="aev-upload-progress__fill aev-circle-progress__fill @(finalizingR2 ? "is-finalizing" : string.Empty)"
                                        cx="44" cy="44" r="38"
                                        stroke-dasharray="@CircleCircumferenceLgStr"
                                        stroke-dashoffset="@dashOffsetLg.ToString("0.##", CultureInfo.InvariantCulture)" />
                            </svg>
                            <div class="aev-circle-progress__center">
                                <span class="aev-circle-progress__percent">@_uploadPercent%</span>
                                <span class="aev-circle-progress__sub">@(finalizingR2 ? "R2" : "ZIP")</span>
                            </div>
                        </div>

                        <div class="min-w-0 flex-1 space-y-1">
                            <div class="text-xs font-bold text-slate-800">
                                @(finalizingR2 ? "Finalizing upload in Cloudflare R2..." : "Uploading ZIP archive...")
                            </div>
                            <div class="text-[11px] text-slate-500">
                                @FormatBytes(sentBytes) of @FormatBytes(_uploadTotalBytes)
                            </div>
                            <div class="text-[11px] text-slate-400 truncate" title="@displayFileName">@displayFileName</div>
                            <div class="text-[11px] text-teal-700 font-semibold pt-0.5">
                                Upload runs in the background — you can close this window or browse other pages.
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(modalErrorText))
                {
                    <div class="px-3.5 py-2.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold">
                        @modalErrorText
                    </div>
                }
            </div>

            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-end gap-3">
                @if (modalUploading && activeModalJob != null)
                {
                    <button type="button"
                            @onclick="() => CancelActiveModalUploadAsync(activeModalJob.JobId)"
                            class="px-4 py-2 rounded-lg border border-rose-200 bg-white text-xs font-bold text-rose-700 hover:bg-rose-50">
                        Cancel Upload
                    </button>
                    <button type="button"
                            @onclick="CloseUploadModal"
                            class="px-5 py-2 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold transition-colors">
                        Continue in Background
                    </button>
                }
                else
                {
                    <button type="button"
                            @onclick="CloseUploadModal"
                            class="px-4 py-2 rounded-lg border border-slate-200 bg-white text-xs font-bold text-slate-700 hover:bg-slate-100">
                        Cancel
                    </button>
                    <button type="button"
                            @onclick="UploadSelectedZipAsync"
                            disabled="@(modalUploading || _selectedFile == null)"
                            class="px-5 py-2 rounded-lg bg-slate-900 hover:bg-teal-700 disabled:opacity-50 text-white text-xs font-bold transition-colors">
                        Upload ZIP to R2
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private const long MaxZipSizeBytes = 500L * 1024 * 1024;
    private const double CircleRadiusSm = 15.0;
    private const double CircleRadiusLg = 38.0;
    private static readonly double CircleCircumferenceSm = 2.0 * Math.PI * CircleRadiusSm;
    private static readonly double CircleCircumferenceLg = 2.0 * Math.PI * CircleRadiusLg;
    private static readonly string CircleCircumferenceSmStr = CircleCircumferenceSm.ToString("0.##", CultureInfo.InvariantCulture);
    private static readonly string CircleCircumferenceLgStr = CircleCircumferenceLg.ToString("0.##", CultureInfo.InvariantCulture);

    private List<CustomerDropboxFolderItem> _containers = new();
    private CustomerDropboxFolderItem? _selectedContainer;
    private IBrowserFile? _selectedFile;
    private bool _loading = true;
    private bool _isUploading;
    private bool _disposed;
    private long _uploadBytesSent;
    private long _uploadTotalBytes;
    private int _uploadPercent;
    private int _lastReportedPercent = -1;
    private long _lastProgressTick;
    private string _statusFilter = "All";
    private string _searchQuery = string.Empty;
    private string? _successMessage;
    private string? _errorMessage;
    private string? _modalError;
    private readonly HashSet<string> _announcedCompletedJobIds = new(StringComparer.Ordinal);

    private IEnumerable<CustomerDropboxFolderItem> FilteredContainers
    {
        get
        {
            IEnumerable<CustomerDropboxFolderItem> q = _containers;

            if (_statusFilter == "Waiting")
                q = q.Where(c => c.IsWaitingForUpload);
            else if (_statusFilter == "Uploaded")
                q = q.Where(c => c.HasFile);
            else if (_statusFilter == "Expired")
                q = q.Where(c => c.IsEffectivelyExpired);

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var term = _searchQuery.Trim();
                q = q.Where(c =>
                    c.EventAppointmentId.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    c.EventName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    c.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    c.CustomerEmail.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    c.CustomerId.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return q;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UploadService.OnJobsChanged += HandleBackgroundJobsChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var isAdmin = EmployeeRoleHelper.IsAdmin(user) || EmployeeRoleHelper.IsSystemAdmin(user);
            var isClerk = EmployeeRoleHelper.IsOfficeClerk(user, UserService);
            if (!isAdmin && !isClerk)
            {
                Nav.NavigateTo("/staff");
                return;
            }
        }

        await LoadContainersAsync();
        SyncCompletedJobsIntoContainers();
    }

    private async Task LoadContainersAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var res = await DropboxClient.GetAdminEventContainersAsync();
            if (res.IsSuccess && res.Value != null)
            {
                _containers = res.Value.ToList();
                SyncCompletedJobsIntoContainers();
            }
            else
            {
                _errorMessage = res.Error?.Message ?? "Failed to load completed event containers.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenUploadModal(CustomerDropboxFolderItem item)
    {
        if (item.IsEffectivelyExpired) return;
        _selectedContainer = item;
        _selectedFile = null;
        _modalError = null;
        var activeJob = UploadService.GetActiveJobForEvent(item.EventAppointmentId);
        if (activeJob != null && activeJob.IsActive)
        {
            _uploadTotalBytes = activeJob.TotalBytes;
            Interlocked.Exchange(ref _uploadBytesSent, activeJob.BytesSent);
            _uploadPercent = activeJob.Percent;
        }
        else
        {
            ResetUploadProgress();
        }
    }

    private void CloseUploadModal()
    {
        _selectedContainer = null;
        _selectedFile = null;
        _modalError = null;
        _isUploading = false;
        ResetUploadProgress();
    }

    private void OnZipSelected(InputFileChangeEventArgs e)
    {
        _modalError = null;
        var file = e.File;
        if (file == null) return;

        if (!Path.GetExtension(file.Name).Equals(".zip", StringComparison.OrdinalIgnoreCase))
        {
            _selectedFile = null;
            _modalError = "Please select a valid .zip archive file.";
            return;
        }

        if (file.Size <= 0 || file.Size > MaxZipSizeBytes)
        {
            _selectedFile = null;
            _modalError = "ZIP file must be between 1 byte and 500 MB.";
            return;
        }

        _selectedFile = file;
        ResetUploadProgress();
    }

    private async Task UploadSelectedZipAsync()
    {
        if (_selectedContainer == null || _selectedFile == null || _isUploading) return;

        _isUploading = true;
        _modalError = null;
        _successMessage = null;
        _uploadTotalBytes = _selectedFile.Size;
        Interlocked.Exchange(ref _uploadBytesSent, 0);
        _uploadPercent = 0;
        _lastReportedPercent = 0;
        Interlocked.Exchange(ref _lastProgressTick, Environment.TickCount64);

        try
        {
            var (started, error, _) = await UploadService.StartBackgroundUploadAsync(
                _selectedContainer,
                _selectedFile.Name,
                _selectedFile.Size,
                _selectedFile.ContentType,
                "zipUploadInput",
                JS);

            if (!started)
            {
                _modalError = error ?? "Could not start ZIP upload.";
            }
            else
            {
                _selectedFile = null;
            }
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task CancelActiveModalUploadAsync(string jobId)
    {
        await UploadService.CancelJobAsync(jobId, JS);
        _isUploading = false;
        ResetUploadProgress();
    }

    private void HandleBackgroundJobsChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            SyncCompletedJobsIntoContainers();
            StateHasChanged();
        });
    }

    private void SyncCompletedJobsIntoContainers()
    {
        foreach (var job in UploadService.Jobs)
        {
            if (job.Status == DropboxUploadJobStatus.Completed && job.CompletedItem != null)
            {
                var item = job.CompletedItem;
                var idx = _containers.FindIndex(c => c.EventAppointmentId == item.EventAppointmentId);
                if (idx >= 0) _containers[idx] = item;
                else _containers.Insert(0, item);

                if (_announcedCompletedJobIds.Add(job.JobId))
                {
                    _successMessage = $"Uploaded '{item.OriginalFileName}' for #{item.EventAppointmentId} ({item.CustomerName}). Isolated to customer {item.CustomerId}.";
                    if (_selectedContainer != null &&
                        string.Equals(_selectedContainer.EventAppointmentId, item.EventAppointmentId, StringComparison.OrdinalIgnoreCase))
                    {
                        CloseUploadModal();
                    }
                }
            }
        }
    }

    // Retained for ProgressReportingStream fallback / unit-test compatibility.
    private Stream WrapProgressStream(Stream inner) => new ProgressReportingStream(inner, OnUploadProgress);

    private void OnUploadProgress(long bytesSent)
    {
        if (_disposed || !_isUploading) return;

        var total = _uploadTotalBytes;
        var clampedSent = total > 0 ? Math.Min(bytesSent, total) : bytesSent;
        var percent = CalculateUploadPercent(clampedSent, total);

        var nowTick = Environment.TickCount64;
        var prevTick = Interlocked.Read(ref _lastProgressTick);
        var reachedEnd = total > 0 && clampedSent >= total;

        if (!reachedEnd && percent == _lastReportedPercent && nowTick - prevTick < 250)
            return;

        if (!reachedEnd && nowTick - prevTick < 100)
            return;

        Interlocked.Exchange(ref _lastProgressTick, nowTick);
        _lastReportedPercent = percent;
        Interlocked.Exchange(ref _uploadBytesSent, clampedSent);
        _uploadPercent = percent;

        _ = RefreshProgressUiAsync();
    }

    private async Task RefreshProgressUiAsync()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private void ResetUploadProgress()
    {
        Interlocked.Exchange(ref _uploadBytesSent, 0);
        _uploadTotalBytes = 0;
        _uploadPercent = 0;
        _lastReportedPercent = -1;
        Interlocked.Exchange(ref _lastProgressTick, 0);
    }

    internal static int CalculateUploadPercent(long bytesSent, long totalBytes)
    {
        if (totalBytes <= 0 || bytesSent <= 0) return 0;
        if (bytesSent >= totalBytes) return 100;
        return (int)Math.Clamp(bytesSent * 100L / totalBytes, 0L, 100L);
    }

    public void Dispose()
    {
        _disposed = true;
        UploadService.OnJobsChanged -= HandleBackgroundJobsChanged;
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.##} {units[unit]}";
    }
}
