@page "/admin/approvals"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Booking Approvals</PageTitle>

<div class="px-8 py-5">
    <h1 class="text-2xl font-bold text-neutral-900 mb-4">Pending Bookings</h1>
    <p class="text-gray-500 mb-6">Review, assign staff/equipment, and confirm pending customer bookings.</p>
    
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase text-xs font-semibold">
                <tr>
                    <th class="px-6 py-4">Booking ID</th>
                    <th class="px-6 py-4">Client</th>
                    <th class="px-6 py-4">Requested Session</th>
                    <th class="px-6 py-4">Date & Time</th>
                    <th class="px-6 py-4">Payment Flag</th>
                    <th class="px-6 py-4 text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 font-medium text-gray-900">#BK-9021</td>
                    <td class="px-6 py-4">Jane Doe</td>
                    <td class="px-6 py-4 text-gray-500">Portrait Session</td>
                    <td class="px-6 py-4 text-gray-500">Oct 12, 10:00 AM</td>
                    <td class="px-6 py-4">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" class="form-checkbox h-4 w-4 text-teal-600 rounded border-gray-300" />
                            <span class="text-xs font-medium text-gray-600">Settled (In-Studio)</span>
                        </label>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button class="bg-teal-600 text-white px-4 py-2 rounded-md font-medium text-xs hover:bg-teal-700">Approve</button>
                        <button class="bg-red-100 text-red-700 px-4 py-2 rounded-md font-medium text-xs hover:bg-red-200 ml-2">Decline</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
