@page "/admin/approvals"
@layout AdminLayout
@using PhotoAevumStudio.Web.Services
@using PhotoAevumStudio.Web.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserService UserService
@inject IConsultationClient ConsultationApi
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Booking &amp; Payment Approvals</PageTitle>

<div class="px-8 py-5 max-w-7xl mx-auto space-y-8">
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold text-base">✓</span>
                <span>@successMessage</span>
            </div>
            <button type="button" @onclick="() => successMessage = null" class="text-emerald-700 hover:text-emerald-900 text-xs">Dismiss</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-sm font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <span class="text-rose-600 font-bold text-base">⚠</span>
                <span>@errorMessage</span>
            </div>
            <button type="button" @onclick="() => errorMessage = null" class="text-rose-700 hover:text-rose-900 text-xs">Dismiss</button>
        </div>
    }

    @* ── Admin Action Panel: Cash Remittance Verification ────────────── *@
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gradient-to-r from-amber-50/50 to-white flex items-center justify-between">
            <div>
                <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                    <span>💵</span> Employee Cash Remittance Approvals
                </h2>
                <p class="text-xs text-gray-500 mt-0.5">
                    Review cash collected by employees on-site. Approving updates the employee's ledger from Pending to Cleared and writes to the audit log.
                </p>
            </div>
            <span class="text-xs font-bold px-3 py-1 bg-amber-100 text-amber-800 rounded-full border border-amber-200">
                @PendingRemittances.Count Pending Approval
            </span>
        </div>

        <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase text-xs font-semibold">
                <tr>
                    <th class="px-6 py-4">Ref / Payment ID</th>
                    <th class="px-6 py-4">Collecting Employee</th>
                    <th class="px-6 py-4">Booking / Event</th>
                    <th class="px-6 py-4">Amount</th>
                    <th class="px-6 py-4">Customer Status</th>
                    <th class="px-6 py-4">Remittance Status</th>
                    <th class="px-6 py-4 text-right">Admin Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (!PendingRemittances.Any())
                {
                    <tr>
                        <td colspan="7" class="px-6 py-10 text-center text-gray-500 text-xs">
                            ✨ No pending cash remittances require admin approval at this time. All employee collections are reconciled.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var rem in PendingRemittances)
                    {
                        <tr class="hover:bg-amber-50/30 transition-colors">
                            <td class="px-6 py-4 font-mono font-medium text-gray-900 text-xs">
                                #@rem.Id
                                @if (!string.IsNullOrWhiteSpace(rem.ExternalReference))
                                {
                                    <span class="block text-[10px] text-gray-400">@rem.ExternalReference</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <strong class="text-gray-900 text-xs block">@(rem.EmployeeName ?? rem.EmployeeId ?? "Staff")</strong>
                                <span class="text-[10px] text-gray-400">ID: @(rem.EmployeeId ?? "N/A")</span>
                            </td>
                            <td class="px-6 py-4 text-gray-600 text-xs">
                                @(rem.EventAppointmentId ?? $"Booking #{rem.BookingId}")
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm font-extrabold text-gray-900">₱@rem.Amount.ToString("N2")</span>
                                <span class="block text-[10px] text-gray-400">Cash Channel</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-[11px] font-bold text-green-700 bg-green-100 px-2 py-0.5 rounded-full inline-flex items-center gap-1">
                                    ✓ Cleared
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-[11px] font-bold text-amber-800 bg-amber-100 border border-amber-300 px-2 py-0.5 rounded-full inline-flex items-center gap-1">
                                    ⏳ Pending Admin Approval
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button type="button"
                                        @onclick="() => HandleApproveRemittance(rem)"
                                        disabled="@isProcessingRemittance"
                                        class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-1.5 rounded-lg font-bold text-xs shadow-xs transition-colors">
                                    Approve Cash Remittance
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ── Booking Schedule Approvals ─────────────────────────────────── *@
    <div>
        <h1 class="text-2xl font-bold text-neutral-900 mb-1">Pending Bookings</h1>
        <p class="text-gray-500 mb-4 text-sm">Review, assign staff/equipment, and confirm pending customer bookings.</p>
        
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <table class="w-full text-left text-sm border-collapse">
                <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase text-xs font-semibold">
                    <tr>
                        <th class="px-6 py-4">Booking ID</th>
                        <th class="px-6 py-4">Client</th>
                        <th class="px-6 py-4">Requested Session</th>
                        <th class="px-6 py-4">Date &amp; Time</th>
                        <th class="px-6 py-4">15% Deposit</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (!PendingBookings.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                                No pending bookings require approval at this time.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var booking in PendingBookings)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 font-medium text-gray-900">#@booking.BookingId</td>
                                <td class="px-6 py-4">@booking.ClientName</td>
                                <td class="px-6 py-4 text-gray-500">@booking.ServiceTitle</td>
                                <td class="px-6 py-4 text-gray-500">@booking.EventDateTime.ToString("MMM dd, hh:mm tt")</td>
                                <td class="px-6 py-4 text-teal-700 font-semibold text-xs">₱@booking.DepositAmount.ToString("N2")</td>
                                <td class="px-6 py-4">
                                    <span class="text-xs font-medium text-amber-700 bg-amber-100 px-2.5 py-1 rounded-full">@booking.Status</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button @onclick='() => UpdateStatus(booking.BookingId, "Confirmed")' class="bg-teal-600 text-white px-4 py-2 rounded-md font-medium text-xs hover:bg-teal-700">Approve</button>
                                    <button @onclick='() => UpdateStatus(booking.BookingId, "Declined")' class="bg-red-100 text-red-700 px-4 py-2 rounded-md font-medium text-xs hover:bg-red-200 ml-2">Decline</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<BookingRow> PendingBookings = new();
    private List<PaymentSummaryModel> PendingRemittances = new();
    private bool isProcessingRemittance = false;
    private string? successMessage;
    private string? errorMessage;
    private string adminUserId = "Admin";
    private string adminUserName = "System Administrator";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                adminUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value ?? "Admin";
                adminUserName = user.FindFirst("full_name")?.Value ?? user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity.Name ?? "System Administrator";
            }
        }
        catch { }

        await ReloadDataAsync();
    }

    private async Task ReloadDataAsync()
    {
        LoadPendingBookings();
        await LoadPendingRemittancesAsync();
    }

    private void LoadPendingBookings()
    {
        PendingBookings = UserService.GetBookings()
            .Where(b => string.Equals(b.Status, "Pending", StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task LoadPendingRemittancesAsync()
    {
        try
        {
            var res = await ConsultationApi.GetPendingRemittancesAsync();
            if (res.IsSuccess && res.Value != null)
            {
                PendingRemittances = res.Value.ToList();
                return;
            }
        }
        catch { }

        // Fallback to direct DB query if API not connected in local circuit
        PendingRemittances = UserService.GetPendingCashRemittances();
    }

    private async Task HandleApproveRemittance(PaymentSummaryModel rem)
    {
        isProcessingRemittance = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var req = new AdminApproveRemittanceModel
            {
                AdminId = adminUserId,
                AdminName = adminUserName,
                Notes = $"Approved cash collection on {DateTime.Now:g} by Admin {adminUserName}"
            };

            var apiRes = await ConsultationApi.ApproveRemittanceAsync(rem.Id, req);
            if (!apiRes.IsSuccess)
            {
                // Fallback direct DB approval
                UserService.ApproveCashRemittance(rem.Id, adminUserId);
            }

            successMessage = $"Successfully approved cash remittance of ₱{rem.Amount:N2} for Employee {rem.EmployeeName ?? rem.EmployeeId}. Status changed to Cleared.";
            await LoadPendingRemittancesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error approving remittance: {ex.Message}";
        }
        finally
        {
            isProcessingRemittance = false;
        }
    }

    private void UpdateStatus(string bookingId, string status)
    {
        UserService.UpdateBookingStatus(bookingId, status);
        LoadPendingBookings();
    }
}
