@page "/admin/equipments"
@page "/equipments"
@layout AdminLayout
@using PhotoAevumStudio.Web.Services
@inject IUserService UserService
@rendermode InteractiveServer

<PageTitle>Equipments - PhotoAevum</PageTitle>

<div class="flex justify-between items-center mb-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Equipments</h1>
        <p class="text-gray-500 mt-1">Catalogue of studio cameras, lenses, stands, and lighting hardware.</p>
    </div>
</div>

@if (!EquipmentList.Any())
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
        <div class="max-w-md mx-auto text-gray-500">
            <p class="text-base font-medium text-gray-700 mb-1">No Equipments Found</p>
            <p class="text-sm">There are currently no equipment records in the database.</p>
        </div>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-left text-sm">
            <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase text-xs font-semibold">
                <tr>
                    <th class="px-6 py-4">Equipment ID</th>
                    <th class="px-6 py-4">Name</th>
                    <th class="px-6 py-4">Category</th>
                    <th class="px-6 py-4">Quantity</th>
                    <th class="px-6 py-4">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in EquipmentList)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 font-mono text-xs text-gray-500">@item.Id</td>
                        <td class="px-6 py-4 font-medium text-gray-900">@item.Name</td>
                        <td class="px-6 py-4 text-gray-500">@item.Category</td>
                        <td class="px-6 py-4 text-gray-500">@item.Quantity</td>
                        <td class="px-6 py-4">
                            <span class="px-2.5 py-1 rounded-full text-xs font-medium @(item.Status == "Available" ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<EquipmentRow> EquipmentList = new();

    protected override void OnInitialized()
    {
        EquipmentList = UserService.GetEquipmentRows();
    }
}
