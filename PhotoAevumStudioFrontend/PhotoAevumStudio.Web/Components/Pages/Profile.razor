@page "/profile"
@page "/admin/profile"
@page "/settings"
@page "/admin/settings"
@layout AdminLayout
@rendermode InteractiveServer
@using System.Security.Claims
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService
@inject IAuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Staff ID Card & Account Center | Photo Aevum Studio</PageTitle>

@if (isLoading)
{
    <div class="profile-page-wrapper">
        <div class="id-card-container loading-card">
            <p class="muted-text">Loading profile data...</p>
        </div>
    </div>
}
else
{
    <div class="profile-page-wrapper">
        <!-- Actual Staff ID Card Container -->
        <div class="id-card-container">
            
            <!-- Top Identity Banner -->
            <div class="id-card-header">
                <div class="profile-summary">
                    <div class="avatar">@CurrentUser.Initials</div>
                    <div class="profile-titles">
                        <h1>@CurrentUser.FullName</h1>
                        <p>@CurrentUser.JobTitle <span></span> @CurrentUser.Department</p>
                    </div>
                </div>
                <div class="badge-tag">
                    STAFF ID · @CurrentUser.Id
                </div>
            </div>

            <!-- Attributes & Details Body -->
            <div class="id-card-body">
                <div class="section-title">Account Attributes & Information</div>

                <!-- Bulleted Attributes List -->
                <ul class="attributes-list">
                    <li class="attribute-item">
                        <div class="attr-content">
                            <span class="attr-label">Email Address</span>
                            <span class="attr-value">@CurrentUser.Email</span>
                        </div>
                    </li>

                    <li class="attribute-item">
                        <div class="attr-content">
                            <span class="attr-label">Role Assignment</span>
                            <span class="attr-value">@CurrentUser.Role</span>
                        </div>
                    </li>

                    <li class="attribute-item">
                        <div class="attr-content">
                            <span class="attr-label">Member Since</span>
                            <span class="attr-value">@(string.IsNullOrWhiteSpace(CurrentUser.MemberSince) ? "March 2024" : CurrentUser.MemberSince)</span>
                        </div>
                    </li>

                    <li class="attribute-item">
                        <div class="attr-content">
                            <span class="attr-label">Account Status</span>
                            <span class="attr-value status-indicator">
                                <span class="status-dot"></span> @(string.IsNullOrWhiteSpace(CurrentUser.Status) ? "Active" : CurrentUser.Status)
                            </span>
                        </div>
                    </li>
                </ul>

                <!-- Interactive Actions Section with Logo Buttons -->
                <div class="actions-section">
                    <div>
                        <div class="section-title section-title--tight">Quick Management Actions</div>
                        <p class="actions-subtitle">Click an icon below to trigger popup management controls.</p>
                    </div>

                    <!-- Logo Buttons -->
                    <div class="actions-grid">
                        <!-- Permissions Logo Button -->
                        <button type="button" class="logo-btn" id="openPermissionsBtn" data-tooltip="Manage Permissions" @onclick="OpenPermissionsModal">
                            <i class="fa-solid fa-user-shield"></i>
                        </button>

                        <!-- Password Logo Button -->
                        <button type="button" class="logo-btn" id="openPasswordBtn" data-tooltip="Security & Password" @onclick="OpenPasswordModal">
                            <i class="fa-solid fa-key"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card Footer -->
            <div class="id-card-footer">
                <span>PhotoAevum Studio · Account Center</span>
                <span class="footer-secured"><i class="fa-solid fa-lock"></i> Session secured</span>
            </div>
        </div>
    </div>
}

<!-- POPUP MODAL 1: Permissions Management -->
<div class="modal-overlay @(showPermsModal ? "active" : "")" id="permissionsModal" @onclick="ClosePermissionsModal">
    <div class="modal-card" @onclick:stopPropagation="true">
        <div class="modal-header">
            <div class="modal-title">
                <i class="fa-solid fa-user-shield"></i>
                <h3>Permissions & Module Access</h3>
            </div>
            <button type="button" class="close-btn" id="closePermsModal" @onclick="ClosePermissionsModal">&times;</button>
        </div>

        <p class="modal-description">
            Authorize or revoke active studio modules for this administrator account.
        </p>

        <div id="permissionsList">
            @foreach (var perm in UserPermissions)
            {
                <div class="permission-item">
                    <div class="perm-info">
                        <i class="fa-solid @perm.IconClass"></i>
                        <span class="perm-name">@perm.Name</span>
                    </div>
                    <label class="switch">
                        <!-- 'disabled' attribute prevents the user from clicking/changing the toggle -->
                        <input type="checkbox" checked="@perm.IsGranted" disabled>
                        <span class="slider"></span>
                    </label>
                </div>
            }
        </div>

        <!-- REMOVED: <button class="modal-action-btn" id="savePermissionsBtn">Save Access Settings</button> -->
    </div>
</div>

<!-- POPUP MODAL 2: Password Management -->
<div class="modal-overlay @(showPassModal ? "active" : "")" id="passwordModal" @onclick="ClosePasswordModal">
    <div class="modal-card" @onclick:stopPropagation="true">
        <div class="modal-header">
            <div class="modal-title">
                <i class="fa-solid fa-key"></i>
                <h3>Security & Password</h3>
            </div>
            <button type="button" class="close-btn" id="closePassModal" @onclick="ClosePasswordModal">&times;</button>
        </div>

        <p class="modal-description">
            Enter your current password to set a new one.
        </p>

        @if (!string.IsNullOrWhiteSpace(passwordErrorMessage))
        {
            <div class="form-error">
                <i class="fa-solid fa-circle-exclamation"></i> @passwordErrorMessage
            </div>
        }

        <form id="passwordForm" @onsubmit="HandleUpdatePassword" @onsubmit:preventDefault="true">
            <div class="form-group">
                <label>Current Password</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password" class="form-input" placeholder="••••••••••••" @bind="passwordForm.CurrentPassword" required />
                </div>
            </div>

            <div class="form-group">
                <label>New Password</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-shield-halved"></i>
                    <input type="password" class="form-input" placeholder="At least 8 characters" @bind="passwordForm.NewPassword" required />
                </div>
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-check-double"></i>
                    <input type="password" class="form-input" placeholder="Re-enter new password" @bind="passwordForm.ConfirmPassword" required />
                </div>
            </div>

            <button type="submit" class="modal-action-btn" id="updatePasswordBtn" disabled="@isUpdatingPassword">
                @(isUpdatingPassword ? "Updating Password..." : "Update Password")
            </button>
        </form>
    </div>
</div>

<!-- Toast Feedback -->
<div class="toast @(showToast ? "show" : "")" id="toast">
    <i class="fa-solid fa-circle-check"></i>
    <span id="toastMsg">@toastMessage</span>
</div>

@code {
    [Parameter]
    public AppUser CurrentUser { get; set; } = new();

    [Parameter]
    public List<Permission> UserPermissions { get; set; } = new();

    private bool isLoading = true;
    private bool showPermsModal = false;
    private bool showPassModal = false;
    private bool showToast = false;
    private string toastMessage = string.Empty;
    private bool isUpdatingPassword = false;
    private string passwordErrorMessage = string.Empty;
    private PasswordUpdateModel passwordForm = new();

    protected override async Task OnInitializedAsync()
    {
        await EnsureUserDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureUserDataAsync();
    }

    private async Task EnsureUserDataAsync()
    {
        if (CurrentUser != null && !string.IsNullOrWhiteSpace(CurrentUser.Id))
        {
            isLoading = false;
            if (UserPermissions == null || UserPermissions.Count == 0)
            {
                InitializeDefaultPermissions();
            }
            return;
        }

        isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var id = user.FindFirst("studio_id")?.Value
                         ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                         ?? user.FindFirst("sub")?.Value
                         ?? user.FindFirst("uid")?.Value
                         ?? string.Empty;

                var email = user.FindFirst(ClaimTypes.Email)?.Value
                            ?? user.FindFirst("email")?.Value
                            ?? string.Empty;

                var role = user.FindFirst(ClaimTypes.Role)?.Value
                           ?? user.FindFirst("role")?.Value
                           ?? "Administrator";

                var fullName = user.FindFirst("full_name")?.Value
                               ?? user.FindFirst(ClaimTypes.Name)?.Value
                               ?? user.FindFirst("name")?.Value
                               ?? "Staff User";

                bool isSuper = role.Contains("Super", StringComparison.OrdinalIgnoreCase)
                               || id.StartsWith("SADM-", StringComparison.OrdinalIgnoreCase);

                CurrentUser = new AppUser
                {
                    Id = id,
                    FullName = fullName,
                    Email = email,
                    Role = role,
                    JobTitle = isSuper ? "Root Super Administrator" : (role == "Admin" ? "Studio Administrator" : role),
                    Department = "PhotoAevum Studio",
                    Status = "Active",
                    MemberSince = "March 2024"
                };

                if (!string.IsNullOrWhiteSpace(id))
                {
                    var admin = UserService.GetAdminById(id);
                    if (admin != null)
                    {
                        if (!string.IsNullOrWhiteSpace(admin.Name)) CurrentUser.FullName = admin.Name;
                        if (!string.IsNullOrWhiteSpace(admin.Email)) CurrentUser.Email = admin.Email;
                        if (!string.IsNullOrWhiteSpace(admin.Role)) CurrentUser.Role = admin.Role;
                        CurrentUser.JobTitle = (admin.IsSuperAdmin || isSuper) ? "Root Super Administrator" : "Studio Administrator";
                        CurrentUser.Department = "Administration & Studio Management";
                    }
                    else
                    {
                        var employee = UserService.GetEmployeeById(id);
                        if (employee != null)
                        {
                            if (!string.IsNullOrWhiteSpace(employee.Name)) CurrentUser.FullName = employee.Name;
                            if (!string.IsNullOrWhiteSpace(employee.Email)) CurrentUser.Email = employee.Email;
                            if (!string.IsNullOrWhiteSpace(employee.Department)) CurrentUser.Department = employee.Department;
                            if (!string.IsNullOrWhiteSpace(employee.Position)) CurrentUser.JobTitle = employee.Position;
                            CurrentUser.Role = "Employee";
                        }
                        else
                        {
                            var customer = UserService.GetCustomerById(id);
                            if (customer != null)
                            {
                                if (!string.IsNullOrWhiteSpace(customer.Name)) CurrentUser.FullName = customer.Name;
                                if (!string.IsNullOrWhiteSpace(customer.Email)) CurrentUser.Email = customer.Email;
                                CurrentUser.Role = "Customer";
                                CurrentUser.JobTitle = "Client Account";
                                CurrentUser.Department = "PhotoAevum Client";
                                CurrentUser.MemberSince = customer.JoinDate.ToString("MMMM yyyy");
                            }
                        }
                    }
                }
            }
            else
            {
                CurrentUser ??= new AppUser
                {
                    Id = "ADM-0142",
                    FullName = "Alex Mercado",
                    Email = "alex.mercado@photoaevum.studio",
                    JobTitle = "Studio Administrator",
                    Department = "PhotoAevum Studio",
                    Role = "Administrator",
                    Status = "Active",
                    MemberSince = "March 2024"
                };
            }

            if (UserPermissions == null || UserPermissions.Count == 0)
            {
                InitializeDefaultPermissions();
            }
        }
        catch
        {
            CurrentUser ??= new AppUser
            {
                Id = "ADM-0142",
                FullName = "Alex Mercado",
                Email = "alex.mercado@photoaevum.studio",
                JobTitle = "Studio Administrator",
                Department = "PhotoAevum Studio",
                Role = "Administrator",
                Status = "Active",
                MemberSince = "March 2024"
            };
            InitializeDefaultPermissions();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void InitializeDefaultPermissions()
    {
        UserPermissions = new List<Permission>
        {
            new Permission { Name = "Events Calendar", IconClass = "fa-calendar-days", IsGranted = true, Description = "Access studio bookings, event schedules, and shoot timelines." },
            new Permission { Name = "Services Catalog", IconClass = "fa-list-check", IsGranted = true, Description = "Manage photo packages, service add-ons, and studio pricing." },
            new Permission { Name = "Employees & Staff", IconClass = "fa-users", IsGranted = true, Description = "View personnel assignments, shift rosters, and staff directories." },
            new Permission { Name = "Equipment Inventory", IconClass = "fa-boxes-stacked", IsGranted = true, Description = "Track cameras, lenses, lighting gear, and maintenance logs." }
        };
    }

    private void OpenPermissionsModal() => showPermsModal = true;
    private void ClosePermissionsModal() => showPermsModal = false;

    private void OpenPasswordModal()
    {
        passwordForm = new();
        passwordErrorMessage = string.Empty;
        showPassModal = true;
    }

    private void ClosePasswordModal() => showPassModal = false;

    private async Task DisplayToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();
        await Task.Delay(3000);
        showToast = false;
        StateHasChanged();
    }

    private async Task HandleUpdatePassword()
    {
        isUpdatingPassword = true;
        passwordErrorMessage = "";
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(passwordForm.CurrentPassword) ||
            string.IsNullOrWhiteSpace(passwordForm.NewPassword) ||
            string.IsNullOrWhiteSpace(passwordForm.ConfirmPassword))
        {
            passwordErrorMessage = "All password fields are required.";
            isUpdatingPassword = false;
            return;
        }

        if (passwordForm.NewPassword.Length < 8)
        {
            passwordErrorMessage = "New password must be at least 8 characters long.";
            isUpdatingPassword = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(passwordForm.NewPassword, @"[A-Za-z]"))
        {
            passwordErrorMessage = "Password must contain at least one letter.";
            isUpdatingPassword = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(passwordForm.NewPassword, @"[0-9]"))
        {
            passwordErrorMessage = "Password must contain at least one digit.";
            isUpdatingPassword = false;
            return;
        }

        if (passwordForm.NewPassword != passwordForm.ConfirmPassword)
        {
            passwordErrorMessage = "New passwords do not match.";
            isUpdatingPassword = false;
            return;
        }

        if (passwordForm.NewPassword == passwordForm.CurrentPassword)
        {
            passwordErrorMessage = "New password must be different from current password.";
            isUpdatingPassword = false;
            return;
        }

        var result = await AuthService.ChangeInitialPasswordAsync(
            CurrentUser.Id,
            passwordForm.CurrentPassword,
            passwordForm.NewPassword,
            passwordForm.ConfirmPassword);

        if (result.Success)
        {
            ClosePasswordModal();
            await DisplayToast("Account password updated successfully!");
        }
        else
        {
            passwordErrorMessage = result.Error ?? "Failed to update password. Please verify current password.";
        }

        isUpdatingPassword = false;
    }

    // ── Backward compatibility helpers for FormsAndSecurityTests ────────────
    internal static string GetRoleBadgeClass(string role, bool isSuperAdmin)
    {
        if (isSuperAdmin || role.Contains("Super", StringComparison.OrdinalIgnoreCase))
            return "aev-badge--violet";
        if (role.Equals("Admin", StringComparison.OrdinalIgnoreCase) || role.Contains("Admin", StringComparison.OrdinalIgnoreCase))
            return "aev-badge--blue";
        if (role.Equals("Employee", StringComparison.OrdinalIgnoreCase) || role.Contains("Staff", StringComparison.OrdinalIgnoreCase))
            return "aev-badge--teal";
        return "aev-badge--amber";
    }

    internal static string GetInitials(string name, string id)
    {
        if (string.IsNullOrWhiteSpace(name))
            return !string.IsNullOrWhiteSpace(id) && id.Length >= 2 ? id[..2].ToUpperInvariant() : "U";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        return char.ToUpperInvariant(name[0]).ToString();
    }

    public class UserProfileModel
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string Status { get; set; } = "Active";
        public string Department { get; set; } = string.Empty;
        public string Position { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public bool IsSuperAdmin { get; set; }
        public DateTime? MemberSince { get; set; }
    }

    public class PasswordUpdateModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
