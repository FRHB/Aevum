@page "/admin/employees/specialization"
@page "/admin/specialization"
@page "/admin/specializations"
@page "/specialization"
@page "/specializations"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SystemAdmin,System Admin,Super Admin,Office Clerk")]
@inject IUserService UserService
@inject AuthenticationStateProvider AuthStateProvider
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<PageTitle>Specializations Management | Photo Aevum Studio</PageTitle>

<div class="space-y-6">
    <!-- Page Header & Action Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">
                <span>Employees Module</span>
                <span>/</span>
                <span class="text-gray-900">Specializations</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Specializations Management</h1>
            <p class="text-sm text-gray-500 mt-1">
                Monitor team skill distributions, search staff specializations, and manage the master lookup registry.
            </p>
        </div>

        @if (!_isOfficeClerk)
        {
        <div class="flex items-center gap-3">
            <button type="button" 
                    @onclick="OpenDepartmentModal"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-white hover:bg-gray-50 text-gray-900 border border-gray-300 text-sm font-semibold rounded-lg shadow-2xs hover:shadow transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 cursor-pointer">
                <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span>+ Add New Department</span>
            </button>
            <button type="button" 
                    @onclick="OpenWizard"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-900 hover:bg-black text-white text-sm font-semibold rounded-lg shadow-sm hover:shadow transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 cursor-pointer">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                <span>+ Add New Specialization</span>
            </button>
        </div>
        }
    </div>

    <!-- Alert / Toast Banner for Updates -->
    @if (!string.IsNullOrWhiteSpace(notificationMessage))
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl flex items-center justify-between shadow-xs animate-in fade-in duration-200">
            <div class="flex items-center gap-3">
                <span class="w-7 h-7 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                </span>
                <div>
                    <p class="text-xs font-bold text-emerald-950">Master Registry Updated</p>
                    <p class="text-xs text-emerald-800">@notificationMessage</p>
                </div>
            </div>
            <button type="button" @onclick="() => notificationMessage = null" class="text-emerald-700 hover:text-emerald-950 p-1 text-sm font-bold cursor-pointer">&times;</button>
        </div>
    }

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Master Specializations</span>
                <span class="p-1.5 rounded-lg bg-blue-50 text-blue-700">🏷️</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">@masterSpecializations.Count</p>
            <p class="text-[11px] text-gray-400 mt-0.5">Catalog entries in database</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Staff</span>
                <span class="p-1.5 rounded-lg bg-gray-100 text-gray-700">👥</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">@employees.Count</p>
            <p class="text-[11px] text-gray-400 mt-0.5">Active directory members</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Photographers</span>
                <span class="p-1.5 rounded-lg bg-purple-50 text-purple-700">📷</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">
                @employees.Count(e => e.Specializations.Any(s => s.Contains("Photo", StringComparison.OrdinalIgnoreCase)))
            </p>
            <p class="text-[11px] text-gray-400 mt-0.5">Primary shoot operators</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Post-Processing</span>
                <span class="p-1.5 rounded-lg bg-emerald-50 text-emerald-700">🎨</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">
                @employees.Count(e => e.Specializations.Any(s => s.Contains("Edit", StringComparison.OrdinalIgnoreCase) || s.Contains("Color", StringComparison.OrdinalIgnoreCase) || s.Contains("Retouch", StringComparison.OrdinalIgnoreCase)))
            </p>
            <p class="text-[11px] text-gray-400 mt-0.5">Editing & lab specialists</p>
        </div>
    </div>

    <!-- View Tabs: Catalog Registry vs Staff Assignments -->
    <div class="flex items-center gap-2 border-b border-gray-200 pb-2">
        <button type="button" 
                @onclick='() => activeTab = "catalog"'
                class="px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer @(activeTab == "catalog" ? "bg-gray-900 text-white shadow-xs" : "bg-white text-gray-600 hover:bg-gray-100 border border-gray-200")">
            Master Specializations Registry (@masterSpecializations.Count)
        </button>
        <button type="button" 
                @onclick='() => activeTab = "staff"'
                class="px-4 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer @(activeTab == "staff" ? "bg-gray-900 text-white shadow-xs" : "bg-white text-gray-600 hover:bg-gray-100 border border-gray-200")">
            Staff Assignments (@employees.Count)
        </button>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- TAB 1: MASTER SPECIALIZATIONS REGISTRY TABLE                           -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    @if (activeTab == "catalog")
    {
        <!-- Search & Filter Controls for Catalog -->
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs space-y-3">
            <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
                <div class="relative flex-1 min-w-[240px]">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <input type="text"
                           @bind="catalogSearchQuery"
                           @bind:event="oninput"
                           placeholder="Search specialization by title, ID, or description..."
                           class="w-full pl-10 pr-10 py-2.5 text-sm bg-gray-50/70 border border-gray-200 rounded-lg text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition-all" />
                    @if (!string.IsNullOrWhiteSpace(catalogSearchQuery))
                    {
                        <button type="button" 
                                @onclick="() => catalogSearchQuery = string.Empty"
                                class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-700 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>

                <div class="flex flex-wrap sm:flex-nowrap items-center gap-3">
                    <div class="relative min-w-[180px]">
                        <select @bind="selectedDepartmentFilter"
                                class="w-full px-3 py-2.5 text-sm bg-gray-50/70 border border-gray-200 rounded-lg text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent cursor-pointer transition-all">
                            <option value="ALL">All Departments</option>
                            @foreach (var dept in UniqueDepartments)
                            {
                                <option value="@dept">@dept</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(catalogSearchQuery) || selectedDepartmentFilter != "ALL")
                    {
                        <button type="button" 
                                @onclick="ResetCatalogFilters"
                                class="px-3 py-2.5 text-xs font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors whitespace-nowrap cursor-pointer">
                            Reset Filters
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Master Registry Table -->
        <div class="bg-white rounded-xl shadow-xs border border-gray-200 overflow-hidden">
            <div class="px-6 py-3.5 bg-gray-50/50 border-b border-gray-200 flex items-center justify-between text-xs text-gray-500 font-medium">
                <div>
                    Showing <span class="font-bold text-gray-900">@FilteredMasterSpecializations.Count()</span> of <span class="font-bold text-gray-900">@masterSpecializations.Count</span> specializations in catalog
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/80 border-b border-gray-200 text-[11px] font-semibold uppercase tracking-wider text-gray-500">
                            <th scope="col" class="py-3.5 px-6">ID</th>
                            <th scope="col" class="py-3.5 px-6">Specialization Title</th>
                            <th scope="col" class="py-3.5 px-6">Department</th>
                            <th scope="col" class="py-3.5 px-6">Description</th>
                            <th scope="col" class="py-3.5 px-6">Tag</th>
                            <th scope="col" class="py-3.5 px-6 text-center">Staff Count</th>
                            <th scope="col" class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @if (FilteredMasterSpecializations.Any())
                        {
                            @foreach (var spec in FilteredMasterSpecializations)
                            {
                                var classes = SpecializationColorHelper.GetClasses(spec.ColorTag);
                                var staffCount = GetStaffCountForSpecialization(spec.Name);

                                <tr class="hover:bg-gray-50/60 transition-colors duration-100">
                                    <td class="py-4 px-6 font-mono text-xs font-semibold text-gray-700">
                                        <span class="bg-gray-100 px-2 py-0.5 rounded text-[11px]">@spec.Id</span>
                                    </td>
                                    <td class="py-4 px-6 font-semibold text-gray-900">
                                        @spec.Name
                                    </td>
                                    <td class="py-4 px-6 text-xs text-gray-600 font-medium">
                                        @(string.IsNullOrWhiteSpace(spec.Department) ? "General" : spec.Department)
                                    </td>
                                    <td class="py-4 px-6 text-xs text-gray-500 max-w-xs truncate" title="@spec.Description">
                                        @(string.IsNullOrWhiteSpace(spec.Description) ? "—" : spec.Description)
                                    </td>
                                    <td class="py-4 px-6">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border @classes.BadgeClass shadow-2xs">
                                            <span class="w-1.5 h-1.5 rounded-full @classes.DotClass"></span>
                                            @(string.IsNullOrWhiteSpace(spec.ColorTag) ? "Blue" : spec.ColorTag)
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-center text-xs font-semibold text-gray-700">
                                        @staffCount
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        @if (!_isOfficeClerk)
                                        {
                                        <button type="button" 
                                                @onclick="() => ConfirmDeleteSpecialization(spec)"
                                                class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold text-rose-600 hover:text-rose-900 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer"
                                                title="Delete Specialization">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                            Delete
                                        </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="py-12 px-6 text-center">
                                    <div class="max-w-sm mx-auto space-y-2">
                                        <h4 class="text-sm font-bold text-gray-900">No specializations found in catalog</h4>
                                        <p class="text-xs text-gray-500">
                                            @(masterSpecializations.Count == 0
                                                ? "No specializations have been registered yet. Click '+ Add New Specialization' to create one."
                                                : "No items match your search filter criteria.")
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- TAB 2: STAFF ASSIGNMENTS TABLE                                         -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    @if (activeTab == "staff")
    {
        <!-- Search & Filter Controls for Staff -->
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs space-y-3">
            <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
                <div class="relative flex-1 min-w-[240px]">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <input type="text"
                           @bind="staffSearchQuery"
                           @bind:event="oninput"
                           placeholder="Search employee by name, ID, or email..."
                           class="w-full pl-10 pr-10 py-2.5 text-sm bg-gray-50/70 border border-gray-200 rounded-lg text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition-all" />
                    @if (!string.IsNullOrWhiteSpace(staffSearchQuery))
                    {
                        <button type="button" 
                                @onclick="() => staffSearchQuery = string.Empty"
                                class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-700 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>

                <div class="flex flex-wrap sm:flex-nowrap items-center gap-3">
                    <div class="relative min-w-[200px]">
                        <select @bind="selectedSpecializationFilter"
                                class="w-full px-3 py-2.5 text-sm bg-gray-50/70 border border-gray-200 rounded-lg text-gray-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent cursor-pointer transition-all">
                            <option value="ALL">All Specializations (@masterSpecializations.Count)</option>
                            @foreach (var spec in masterSpecializations)
                            {
                                <option value="@spec.Name">@spec.Name (@GetStaffCountForSpecialization(spec.Name))</option>
                            }
                        </select>
                    </div>

                    <button type="button" 
                            @onclick="ToggleArchivedStaff"
                            class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-semibold rounded-lg border transition-all cursor-pointer @(showArchivedStaff ? "bg-amber-100 text-amber-900 border-amber-300 font-bold" : "bg-white text-gray-700 hover:bg-gray-100 border-gray-200")">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                        </svg>
                        <span>@(showArchivedStaff ? "Viewing Archived Staff" : "View Archived Staff")</span>
                    </button>

                    @if (!string.IsNullOrWhiteSpace(staffSearchQuery) || selectedSpecializationFilter != "ALL")
                    {
                        <button type="button" 
                                @onclick="ResetStaffFilters"
                                class="px-3 py-2.5 text-xs font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors whitespace-nowrap cursor-pointer">
                            Reset Filters
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Data Table: Employees & Assigned Specializations -->
        <div class="bg-white rounded-xl shadow-xs border border-gray-200 overflow-hidden">
            <div class="px-6 py-3.5 bg-gray-50/50 border-b border-gray-200 flex items-center justify-between text-xs text-gray-500 font-medium">
                <div>
                    Showing <span class="font-bold text-gray-900">@FilteredEmployees.Count()</span> of <span class="font-bold text-gray-900">@employees.Count</span> @(showArchivedStaff ? "archived staff" : "active staff")
                </div>
                @if (showArchivedStaff)
                {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        Archived Directory View
                    </span>
                }
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/80 border-b border-gray-200 text-[11px] font-semibold uppercase tracking-wider text-gray-500">
                            <th scope="col" class="py-3.5 px-6">Employee</th>
                            <th scope="col" class="py-3.5 px-6">Contact & Role</th>
                            <th scope="col" class="py-3.5 px-6">Assigned Specializations</th>
                            <th scope="col" class="py-3.5 px-6">Status</th>
                            <th scope="col" class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @if (FilteredEmployees.Any())
                        {
                            @foreach (var emp in FilteredEmployees)
                            {
                                <tr class="hover:bg-gray-50/60 transition-colors duration-100">
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-gray-900 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-xs">
                                                @emp.Initials
                                            </div>
                                            <div>
                                                <div class="font-semibold text-gray-900">@emp.FullName</div>
                                                <div class="font-mono text-[11px] text-gray-400">@emp.EmployeeId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6">
                                        <div class="text-xs text-gray-700 font-medium">@emp.Email</div>
                                        <div class="text-[11px] text-gray-400 mt-0.5">@emp.Role</div>
                                    </td>
                                    <td class="py-4 px-6">
                                        @if (emp.Specializations.Any())
                                        {
                                            <div class="flex flex-wrap gap-1.5 max-w-md">
                                                @foreach (var specName in emp.Specializations)
                                                {
                                                    var specMeta = GetSpecializationMeta(specName);
                                                    var classes = SpecializationColorHelper.GetClasses(specMeta?.ColorTag);

                                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border @classes.BadgeClass shadow-2xs">
                                                        <span class="w-1.5 h-1.5 rounded-full @classes.DotClass"></span>
                                                        @specName
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400 italic">No specializations assigned</span>
                                        }
                                    </td>
                                    <td class="py-4 px-6">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold @(emp.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-gray-100 text-gray-600 border border-gray-200")">
                                            <span class="w-1.5 h-1.5 rounded-full @(emp.IsActive ? "bg-emerald-500" : "bg-gray-400")"></span>
                                            @emp.Status
                                        </span>
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <a href="/profile" class="text-xs font-semibold text-gray-600 hover:text-gray-900 hover:underline">
                                            View Profile &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="py-12 px-6 text-center">
                                    <div class="max-w-sm mx-auto space-y-2">
                                        <h4 class="text-sm font-bold text-gray-900">No employees or specializations found</h4>
                                        <p class="text-xs text-gray-500">
                                            @(employees.Count == 0
                                                ? "No employee records exist in the database yet. You can see registered specializations under the 'Master Specializations Registry' tab."
                                                : "No team members matched your current filter criteria.")
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Add Specialization Wizard Modal -->
<AddSpecializationWizard @bind-IsOpen="isWizardOpen"
                         OnSpecializationCreated="HandleSpecializationCreated" />

<!-- Add Department Modal -->
@if (isDepartmentModalOpen)
{
    <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-gray-100 max-w-md w-full p-6 space-y-4 animate-in fade-in duration-150">
            <div class="flex items-center justify-between pb-2 border-b border-gray-100">
                <div class="flex items-center gap-2.5">
                    <span class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-sm">
                        🏢
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Add New Department</h3>
                        <p class="text-xs text-gray-500">Create an organizational department entry</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseDepartmentModal" class="text-gray-400 hover:text-gray-700 text-lg cursor-pointer">&times;</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(departmentErrorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-800 text-xs rounded-lg font-medium">
                    @departmentErrorMessage
                </div>
            }

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Department Name <span class="text-rose-500">*</span></label>
                    <input type="text"
                           @bind="newDepartment.DepartmentName"
                           placeholder="e.g. Administration & Studio Management"
                           class="w-full px-3.5 py-2 text-sm bg-gray-50 border border-gray-200 rounded-lg text-gray-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 transition-all" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Description</label>
                    <textarea rows="3"
                              @bind="newDepartment.DepartmentDescription"
                              placeholder="Department roles, duties, or operational scope..."
                              class="w-full px-3.5 py-2 text-sm bg-gray-50 border border-gray-200 rounded-lg text-gray-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 transition-all resize-none"></textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-gray-100">
                <button type="button"
                        @onclick="CloseDepartmentModal"
                        class="px-4 py-2 text-xs font-semibold text-gray-600 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button"
                        @onclick="SaveDepartmentAsync"
                        disabled="@(string.IsNullOrWhiteSpace(newDepartment.DepartmentName) || isSavingDepartment)"
                        class="px-4 py-2 text-xs font-semibold text-white bg-gray-900 hover:bg-black disabled:opacity-50 disabled:cursor-not-allowed rounded-lg shadow-xs transition-colors cursor-pointer">
                    @(isSavingDepartment ? "Saving..." : "Save Department")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (specToDelete != null)
{
    <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-gray-100 max-w-md w-full p-6 space-y-4">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-lg font-bold">
                    🗑️
                </span>
                <div>
                    <h3 class="text-base font-bold text-gray-900">Delete Specialization</h3>
                    <p class="text-xs text-gray-500">Remove category from master registry</p>
                </div>
            </div>
            <p class="text-sm text-gray-600">
                Are you sure you want to delete <strong class="text-gray-900">@specToDelete.Name</strong> (<span class="font-mono text-xs">@specToDelete.Id</span>)? This will also unassign it from any linked employees.
            </p>
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" 
                        @onclick="() => specToDelete = null"
                        class="px-4 py-2 text-xs font-semibold text-gray-600 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button" 
                        @onclick="ExecuteDeleteSpecialization"
                        class="px-4 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shadow-xs transition-colors cursor-pointer">
                    Delete Specialization
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "catalog";
    private bool isWizardOpen = false;
    private bool isDepartmentModalOpen = false;
    private bool isSavingDepartment = false;
    private string? departmentErrorMessage;
    private DepartmentModel newDepartment = new();
    private List<DepartmentModel> departments = new();
    private bool showArchivedStaff = false;

    private string catalogSearchQuery = string.Empty;
    private string staffSearchQuery = string.Empty;
    private string selectedSpecializationFilter = "ALL";
    private string selectedDepartmentFilter = "ALL";
    private string? notificationMessage;

    private SpecializationLookupItem? specToDelete;

    private List<EmployeeSpecializationDto> employees = new();
    private List<SpecializationLookupItem> masterSpecializations = new();

    private IEnumerable<string> UniqueDepartments => departments
        .Select(d => d.DepartmentName)
        .Union(masterSpecializations.Select(s => string.IsNullOrWhiteSpace(s.Department) ? "General" : s.Department))
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct()
        .OrderBy(d => d);

    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }
    private bool _isOfficeClerk;

    protected override async Task OnInitializedAsync()
    {
        ClaimsPrincipal? user = null;
        if (AuthState != null) user = (await AuthState).User;
        else user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _isOfficeClerk = EmployeeRoleHelper.IsOfficeClerk(user, UserService);
    }

    protected override void OnInitialized()
    {
        LoadFromDatabase();
    }

    private void LoadFromDatabase()
    {
        departments = UserService.GetDepartments().ToList();
        masterSpecializations = UserService.GetSpecializationLookups().ToList();
        employees = showArchivedStaff
            ? UserService.GetArchivedEmployeeSpecializations().ToList()
            : UserService.GetEmployeeSpecializations(includeArchived: false).ToList();
    }

    private void ToggleArchivedStaff()
    {
        showArchivedStaff = !showArchivedStaff;
        LoadFromDatabase();
    }

    private void OpenDepartmentModal()
    {
        newDepartment = new DepartmentModel();
        departmentErrorMessage = null;
        isSavingDepartment = false;
        isDepartmentModalOpen = true;
    }

    private void CloseDepartmentModal()
    {
        isDepartmentModalOpen = false;
    }

    private async Task SaveDepartmentAsync()
    {
        if (string.IsNullOrWhiteSpace(newDepartment.DepartmentName)) return;
        try
        {
            isSavingDepartment = true;
            departmentErrorMessage = null;
            var created = UserService.AddDepartment(newDepartment);
            notificationMessage = $"Department \"{created.DepartmentName}\" ({created.DepartmentId}) was successfully added.";
            CloseDepartmentModal();
            LoadFromDatabase();
            activeTab = "catalog";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            departmentErrorMessage = ex.Message;
        }
        finally
        {
            isSavingDepartment = false;
        }
    }

    private void OpenWizard() => isWizardOpen = true;

    private void ResetCatalogFilters()
    {
        catalogSearchQuery = string.Empty;
        selectedDepartmentFilter = "ALL";
    }

    private void ResetStaffFilters()
    {
        staffSearchQuery = string.Empty;
        selectedSpecializationFilter = "ALL";
    }

    private int GetStaffCountForSpecialization(string specializationName) =>
        employees.Count(e => e.Specializations.Any(s => s.Equals(specializationName, StringComparison.OrdinalIgnoreCase)));

    private SpecializationLookupItem? GetSpecializationMeta(string name) =>
        masterSpecializations.FirstOrDefault(m => m.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<SpecializationLookupItem> FilteredMasterSpecializations
    {
        get
        {
            var result = masterSpecializations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(catalogSearchQuery))
            {
                var q = catalogSearchQuery.Trim();
                result = result.Where(s =>
                    s.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    s.Id.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (s.Description != null && s.Description.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    (s.Department != null && s.Department.Contains(q, StringComparison.OrdinalIgnoreCase)));
            }

            if (selectedDepartmentFilter != "ALL")
            {
                result = result.Where(s =>
                    (string.IsNullOrWhiteSpace(s.Department) ? "General" : s.Department)
                    .Equals(selectedDepartmentFilter, StringComparison.OrdinalIgnoreCase));
            }

            return result;
        }
    }

    private IEnumerable<EmployeeSpecializationDto> FilteredEmployees
    {
        get
        {
            var result = employees.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(staffSearchQuery))
            {
                var q = staffSearchQuery.Trim();
                result = result.Where(e =>
                    e.FullName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    e.EmployeeId.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    e.Email.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(selectedSpecializationFilter) && selectedSpecializationFilter != "ALL")
            {
                result = result.Where(e => e.Specializations.Any(s =>
                    s.Equals(selectedSpecializationFilter, StringComparison.OrdinalIgnoreCase)));
            }

            return result;
        }
    }

    private void HandleSpecializationCreated(SpecializationLookupItem newSpec)
    {
        LoadFromDatabase();
        activeTab = "catalog";
        notificationMessage = $"Specialization \"{newSpec.Name}\" ({newSpec.Id}) was successfully saved and added to the master registry.";
        StateHasChanged();
    }

    private void ConfirmDeleteSpecialization(SpecializationLookupItem spec)
    {
        specToDelete = spec;
    }

    private void ExecuteDeleteSpecialization()
    {
        if (specToDelete == null) return;
        var name = specToDelete.Name;
        var id = specToDelete.Id;
        specToDelete = null;

        var success = UserService.DeleteSpecialization(id);
        if (success)
        {
            notificationMessage = $"Specialization \"{name}\" ({id}) was successfully deleted from the master registry.";
            LoadFromDatabase();
        }
        else
        {
            notificationMessage = $"Failed to delete specialization \"{name}\". Please try again.";
        }
    }
}
