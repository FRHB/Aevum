@page "/my/profile"
@page "/my/settings"
@layout CustomerLayout
@rendermode InteractiveServer
@using System.Security.Claims
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService
@inject IAuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Customer Profile | Photo Aevum Studio</PageTitle>

@* ── Page header ─────────────────────────────────────────────────── *@
<header class="aev-page-header">
    <div>
        <h1 class="aev-page-header__title">Customer Profile</h1>
        <p class="aev-page-header__subtitle">Manage your personal details, booking account, and security settings</p>
    </div>
    <div class="profile-header-badge">
        <span class="aev-badge aev-badge--amber">
            Customer Account
        </span>
    </div>
</header>

@if (isLoading)
{
    <div class="aev-card profile-loading-card">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="aev-muted-text mt-3">Loading profile data...</p>
    </div>
}
else if (string.IsNullOrWhiteSpace(profile.Id))
{
    <div class="aev-card p-8 text-center empty-state-card">
        <div class="empty-icon">👤</div>
        <h2 class="text-lg font-semibold text-gray-800 mb-1">No Active Customer Profile Found</h2>
        <p class="text-sm text-gray-500 mb-4">Please sign in to access your customer profile and booking records.</p>
        <a href="/login" class="btn btn--primary">Sign In</a>
    </div>
}
else
{
    <div class="customer-profile-container">
        @* ── Left Column: Account Details Card ────────────────────────── *@
        <section class="aev-card profile-info-card" aria-label="Customer Account Details">
            <header class="aev-card__header">
                <div class="header-title-group">
                    <span class="section-icon">📋</span>
                    <div>
                        <h2 class="aev-card__heading">Account Information</h2>
                        <span class="section-subtitle">Verified studio client profile</span>
                    </div>
                </div>
                <span class="aev-badge aev-badge--teal">@profile.Status</span>
            </header>

            <div class="profile-card-body">
                @* Hero Avatar & Identity Summary *@
                <div class="profile-hero">
                    <div class="profile-avatar customer-avatar" aria-hidden="true">
                        @GetInitials(profile.Name, profile.Id)
                    </div>
                    <div class="profile-hero-text">
                        <h3 class="profile-name">@profile.Name</h3>
                        <p class="profile-email">@profile.Email</p>
                        <span class="profile-id-chip">Customer ID: @profile.Id</span>
                    </div>
                </div>

                @* Aligned Data Grid *@
                <div class="profile-fields-list">
                    <div class="profile-row">
                        <div class="profile-row__label">Customer ID</div>
                        <div class="profile-row__value" id="profile-id">@profile.Id</div>
                    </div>

                    <div class="profile-row">
                        <div class="profile-row__label">Full Name</div>
                        <div class="profile-row__value" id="profile-name">@profile.Name</div>
                    </div>

                    <div class="profile-row">
                        <div class="profile-row__label">Account Type</div>
                        <div class="profile-row__value" id="profile-role">
                            <span class="badge-role">@profile.Role</span>
                        </div>
                    </div>

                    <div class="profile-row">
                        <div class="profile-row__label">Email Address</div>
                        <div class="profile-row__value" id="profile-email">@profile.Email</div>
                    </div>

                    <div class="profile-row">
                        <div class="profile-row__label">Phone Number</div>
                        <div class="profile-row__value" id="profile-phone">
                            @(!string.IsNullOrWhiteSpace(profile.Phone) ? profile.Phone : "Not specified")
                        </div>
                    </div>

                    <div class="profile-row">
                        <div class="profile-row__label">Member Since</div>
                        <div class="profile-row__value" id="profile-joined">
                            @(profile.MemberSince.HasValue ? profile.MemberSince.Value.ToString("MMMM d, yyyy") : "Active Member")
                        </div>
                    </div>

                    <div class="profile-row">
                        <div class="profile-row__label">Account Status</div>
                        <div class="profile-row__value status-active" id="profile-status">
                            <span class="status-indicator"></span> @profile.Status
                        </div>
                    </div>
                </div>

                <div class="profile-quick-actions mt-4 pt-3 border-top">
                    <a href="/my/bookings" class="btn btn-outline-secondary btn-sm">
                        <span>📅</span> View My Bookings
                    </a>
                    <a href="/schedule" class="btn btn--primary btn-sm">
                        <span>✨</span> Book New Session
                    </a>
                </div>
            </div>
        </section>

        @* ── Right Column: Security / Change Password Card ────────────── *@
        <section class="aev-card profile-settings-card" aria-label="Security Settings">
            <header class="aev-card__header">
                <div class="header-title-group">
                    <span class="section-icon">🔒</span>
                    <div>
                        <h2 class="aev-card__heading">Security Settings</h2>
                        <span class="section-subtitle">Manage your account credentials</span>
                    </div>
                </div>
                <span class="aev-badge aev-badge--blue">Password</span>
            </header>

            <div class="profile-card-body">
                <p class="settings-intro">
                    Ensure your account stays secure by using a strong password with at least 8 characters, letters, and numbers.
                </p>

                @if (!string.IsNullOrEmpty(passwordSuccessMessage))
                {
                    <div class="alert alert-success alert-dismissible" role="status">
                        <span class="alert-icon">✓</span>
                        <span>@passwordSuccessMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(passwordErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        <span class="alert-icon">⚠️</span>
                        <span>@passwordErrorMessage</span>
                    </div>
                }

                <EditForm Model="@passwordForm" OnValidSubmit="HandleUpdatePassword">
                    <div class="form-group mb-3">
                        <label for="cust-current-password" class="form-label">Current Password</label>
                        <PasswordInput Id="cust-current-password"
                                       Name="currentPassword"
                                       Autocomplete="current-password"
                                       @bind-Value="passwordForm.CurrentPassword"
                                       Placeholder="Enter your current password"
                                       Disabled="@isUpdatingPassword" />
                    </div>

                    <div class="form-group mb-3">
                        <label for="cust-new-password" class="form-label">New Password</label>
                        <PasswordInput Id="cust-new-password"
                                       Name="newPassword"
                                       Autocomplete="new-password"
                                       @bind-Value="passwordForm.NewPassword"
                                       Placeholder="Enter new password (min. 8 characters)"
                                       Disabled="@isUpdatingPassword" />
                    </div>

                    <div class="form-group mb-4">
                        <label for="cust-confirm-password" class="form-label">Confirm New Password</label>
                        <PasswordInput Id="cust-confirm-password"
                                       Name="confirmPassword"
                                       Autocomplete="new-password"
                                       @bind-Value="passwordForm.ConfirmPassword"
                                       Placeholder="Re-enter your new password"
                                       Disabled="@isUpdatingPassword" />
                    </div>

                    <button type="submit" class="btn btn--primary w-100" disabled="@isUpdatingPassword">
                        @if (isUpdatingPassword)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Updating password...</span>
                        }
                        else
                        {
                            <span>Update Password</span>
                        }
                    </button>
                </EditForm>
            </div>
        </section>
    </div>
}

@code {
    private CustomerProfileModel profile = new();
    private PasswordUpdateModel passwordForm = new();
    private bool isLoading = true;
    private bool isUpdatingPassword = false;
    private string passwordErrorMessage = "";
    private string passwordSuccessMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserDataAsync();
    }

    private async Task LoadUserDataAsync()
    {
        isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var claimId = user.FindFirst("studio_id")?.Value
                          ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("sub")?.Value
                          ?? user.Identity?.Name
                          ?? string.Empty;

            var claimEmail = user.FindFirst(ClaimTypes.Email)?.Value
                            ?? user.FindFirst("email")?.Value
                            ?? (user.Identity?.Name?.Contains("@") == true ? user.Identity.Name : string.Empty);

            var claimName = user.FindFirst("full_name")?.Value
                           ?? user.FindFirst("name")?.Value
                           ?? user.FindFirst(ClaimTypes.Name)?.Value
                           ?? string.Empty;

            var claimRole = user.FindFirst(ClaimTypes.Role)?.Value
                           ?? user.FindFirst("role")?.Value
                           ?? string.Empty;

            profile.Id = claimId;
            profile.Email = claimEmail;
            profile.Name = claimName;
            profile.Role = !string.IsNullOrWhiteSpace(claimRole) ? claimRole : "Customer";
            profile.Status = "Active";

            if (!string.IsNullOrWhiteSpace(profile.Id))
            {
                var customer = UserService.GetCustomerById(profile.Id);
                if (customer != null)
                {
                    if (string.IsNullOrWhiteSpace(profile.Name)) profile.Name = customer.Name;
                    if (string.IsNullOrWhiteSpace(profile.Email)) profile.Email = customer.Email;
                    profile.Phone = customer.Phone;
                    profile.MemberSince = customer.JoinDate;
                }
            }

            if (string.IsNullOrWhiteSpace(profile.Name) && !string.IsNullOrWhiteSpace(profile.Id))
            {
                profile.Name = !string.IsNullOrWhiteSpace(profile.Email)
                    ? profile.Email.Split('@')[0]
                    : profile.Id;
            }
        }
        catch
        {
            // Defensive error handling
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdatePassword()
    {
        isUpdatingPassword = true;
        passwordErrorMessage = "";
        passwordSuccessMessage = "";
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(passwordForm.CurrentPassword) ||
            string.IsNullOrWhiteSpace(passwordForm.NewPassword) ||
            string.IsNullOrWhiteSpace(passwordForm.ConfirmPassword))
        {
            passwordErrorMessage = "All password fields are required.";
            isUpdatingPassword = false;
            return;
        }

        if (passwordForm.NewPassword.Length < 8)
        {
            passwordErrorMessage = "New password must be at least 8 characters long.";
            isUpdatingPassword = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(passwordForm.NewPassword, @"[A-Za-z]"))
        {
            passwordErrorMessage = "Password must contain at least one letter.";
            isUpdatingPassword = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(passwordForm.NewPassword, @"[0-9]"))
        {
            passwordErrorMessage = "Password must contain at least one digit.";
            isUpdatingPassword = false;
            return;
        }

        if (passwordForm.NewPassword != passwordForm.ConfirmPassword)
        {
            passwordErrorMessage = "New passwords do not match.";
            isUpdatingPassword = false;
            return;
        }

        if (passwordForm.NewPassword == passwordForm.CurrentPassword)
        {
            passwordErrorMessage = "New password must be different from current password.";
            isUpdatingPassword = false;
            return;
        }

        var result = await AuthService.ChangeInitialPasswordAsync(
            profile.Id,
            passwordForm.CurrentPassword,
            passwordForm.NewPassword,
            passwordForm.ConfirmPassword);

        if (result.Success)
        {
            passwordSuccessMessage = "Password successfully updated!";
            passwordForm = new();
        }
        else
        {
            passwordErrorMessage = result.Error ?? "Failed to update password. Please check your current password.";
        }

        isUpdatingPassword = false;
    }

    private static string GetInitials(string name, string id)
    {
        if (string.IsNullOrWhiteSpace(name))
            return !string.IsNullOrWhiteSpace(id) && id.Length >= 2 ? id[..2].ToUpperInvariant() : "C";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        return char.ToUpperInvariant(name[0]).ToString();
    }

    public class CustomerProfileModel
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = "Customer";
        public string Status { get; set; } = "Active";
        public string Phone { get; set; } = string.Empty;
        public DateTime? MemberSince { get; set; }
    }

    public class PasswordUpdateModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
