            <div class="p-6 overflow-y-auto space-y-4 text-xs">
                @if (!string.IsNullOrWhiteSpace(finishModalError))
                {
                    <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 font-semibold">
                        @finishModalError
                    </div>
                }

                @* Event Context Card *@
                <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="font-mono font-bold text-slate-500">#@selectedFinishEvent.Id</span>
                        <span class="font-bold text-slate-800">@selectedFinishEvent.ServiceType</span>
                    </div>
                    <div class="text-sm font-black text-slate-900">@selectedFinishEvent.ClientName</div>
                    <div class="text-slate-500">Date: @selectedFinishEvent.Date.ToString("MMMM dd, yyyy") &bull; @selectedFinishEvent.FormattedTimeRange</div>
                    <div class="text-slate-500">Venue: @(!string.IsNullOrWhiteSpace(selectedFinishEvent.StudioSpaceName) ? selectedFinishEvent.StudioSpaceName : "Main Studio Room")</div>
                </div>

                @* Overtime & Add-on Surcharges Section *@
                <div class="bg-amber-50/50 rounded-xl border border-amber-200 p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-amber-900 uppercase tracking-wider text-[11px]">Billable Overtime &amp; Surcharges</span>
                        <span class="text-[10px] text-amber-700 font-semibold">Rate: ₱1,500.00 / hr</span>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Extra Overtime Hours</label>
                            <input type="number" step="0.5" min="0" max="12" @bind="extraHours" @bind:after="RecalculateSettlement"
