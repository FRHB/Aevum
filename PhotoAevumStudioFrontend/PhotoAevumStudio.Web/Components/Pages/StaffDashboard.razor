@page "/staff"
@layout EmployeeLayout
@using PhotoAevumStudio.Web.Services
@using PhotoAevumStudio.Web.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using QRCoder
@implements IAsyncDisposable
@inject IUserService UserService
@inject IEmployeeService Employees
@inject IEquipmentService EquipmentService
@inject IScheduleService ScheduleService
@inject IConsultationClient ConsultationApi
@inject AuthenticationStateProvider AuthStateProvider
@inject PaymentHubClient PaymentHub
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@attribute [Authorize(Roles = "Employee,Office Clerk,Admin,SystemAdmin")]
@rendermode InteractiveServer

<PageTitle>Staff Dashboard | Photo Aevum Studio</PageTitle>

@* ── Page header ─────────────────────────────────────────────────── *@
<header class="aev-page-header">
    <div>
        <h1 class="aev-page-header__title">
            @(isCreative ? "My Staff Dashboard" : "Studio Staff Overview")
        </h1>
        <p class="aev-page-header__subtitle">
            @DateTime.Today.ToString("dddd, MMMM d, yyyy") 
            @if (isCreative && !string.IsNullOrWhiteSpace(employeeName))
            {
                <span class="text-teal-700 font-medium">&bull; Welcome, @employeeName</span>
            }
            else if (isClerk)
            {
                <span class="text-indigo-700 font-medium">&bull; Office Clerk Portal</span>
            }
        </p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
        @if (IsOfficeClerkLeaveMode)
        {
            <span class="px-3 py-1.5 rounded-lg bg-teal-50 border border-teal-200 text-teal-900 text-[11px] font-bold">
                Remaining Paid Leaves: @($"{leaveBalanceSummary.TotalRemainingPaidDays:0.0}") days (VL: @($"{leaveBalanceSummary.VacationLeaveRemaining:0.0}") left &bull; SL: @($"{leaveBalanceSummary.SickLeaveRemaining:0.0}") left)
            </span>
        }
        <button type="button"
                @onclick="OpenLeaveModal"
                class="px-4 py-2 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-lg shadow-xs transition-colors">
            Request for Leave
        </button>
    </div>
</header>

@* ── TEAM LEADER / CREW TOP PILL-BOX CONTAINER (ACTIVE / LATEST EVENT) ── *@
@if (!isClerk && (teamLeaderEvents.Any() || _recentlyCompletedTeamLeadEvent != null))
{
    <TeamLeaderActiveEventPill ActiveEvents="@teamLeaderEvents"
                               RecentlyCompletedEvent="@_recentlyCompletedTeamLeadEvent"
                               EmployeeId="@employeeId"
                               EmployeeName="@employeeName"
                               @bind-SelectedEventId="_selectedActiveTeamLeadEventId"
                               StudioEquipments="@_studioEquipments"
                               StaffBookings="@_staffBookings"
                               StaffEquipmentReservations="@_staffEquipmentReservations"
                               OnDismissCompleted="HandleDismissCompletedTeamLeadAsync"
                               OnWorkflowUpdated="HandleTeamLeadPillWorkflowUpdatedAsync" />
}

@if (!string.IsNullOrWhiteSpace(teamLeaderActionMessage))
{
    <div class="mb-4 px-3.5 py-2.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between gap-2">
        <span>✓ @teamLeaderActionMessage</span>
        <button type="button" @onclick="() => teamLeaderActionMessage = null" class="text-emerald-700 font-bold">✕</button>
    </div>
}

@* ── OFFICE CLERK: STACKED CONCURRENT EVENTS & VERIFY CASH ────────── *@
@if (isClerk)
{
    <LiveEventsOverviewPanel ManagerId="@employeeId" ManagerName="@employeeName" OnCashVerified="RefreshStatus" />
}

@if (!teamLeaderEvents.Any() && !string.IsNullOrWhiteSpace(teamLeaderErrorMessage))
{
    <div class="mb-4 px-3.5 py-2.5 rounded-lg bg-red-50 border border-red-200 text-red-700 text-xs font-semibold flex items-center justify-between gap-2">
        <span>⚠ @teamLeaderErrorMessage</span>
        <button type="button" @onclick="() => RefreshTeamLeaderEventsInternalAsync(surfaceError: true)" class="px-2.5 py-1 rounded border border-red-300 bg-white hover:bg-red-50 text-red-800 text-[11px] font-bold">
            Retry
        </button>
    </div>
}
else if (!string.IsNullOrWhiteSpace(teamLeaderErrorMessage))
{
    <div class="mb-4 px-3.5 py-2.5 rounded-lg bg-red-50 border border-red-200 text-red-700 text-xs font-semibold flex items-center justify-between gap-2">
        <span>⚠ @teamLeaderErrorMessage</span>
        <button type="button" @onclick="() => teamLeaderErrorMessage = null" class="text-red-700 font-bold">✕</button>
    </div>
}

@* ── Live Clock In / Clock Out Time Tracker Card ─────────────────── *@
<section class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                @if (clockStatus.IsClockedIn)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                        ON DUTY
                    </span>
                    <span class="text-xs text-slate-500">Clocked in at @(clockStatus.ClockIn?.ToString("hh:mm tt") ?? "earlier today")</span>
                }
                else if (clockStatus.IsOnLeaveToday)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900">
                        🩺 ON APPROVED LEAVE (@clockStatus.ActiveLeaveType)
                    </span>
                }
                else if (clockStatus.IsDayOffToday)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-800 border border-blue-200">
                        🏖️ SCHEDULED DAY OFF
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                        ⚪ OFF DUTY
                    </span>
                }
            </div>
            <h2 class="text-xl font-extrabold text-slate-900">Attendance &amp; Time Tracker</h2>
            <p class="text-xs text-slate-500 mt-0.5">
                @if (clockStatus.IsClockedIn)
                {
                    <span>Current Shift Duration: <strong class="text-slate-800">@clockStatus.ElapsedHours.ToString("0.#") hours</strong> elapsed.</span>
                }
                else
                {
                    <span>Record your punch times for scheduled studio appointments and shift roster.</span>
                }
            </p>
        </div>

        <div class="flex items-center gap-3">
            @if (clockStatus.IsClockedIn)
            {
                <button type="button"
                        @onclick="HandleClockOut"
                        disabled="@isPunching"
                        class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm transition-all flex items-center gap-2">
                    <span>⏹</span>
                    <span>@(isPunching ? "Punching..." : "Clock Out")</span>
                </button>
            }
            else if (!clockStatus.IsOnLeaveToday)
            {
                <button type="button"
                        @onclick="HandleClockIn"
                        disabled="@isPunching"
                        class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm transition-all flex items-center gap-2">
                    <span>▶</span>
                    <span>@(isPunching ? "Punching..." : "Clock In")</span>
                </button>
            }
        </div>
    </div>
</section>

@* ── Stat cards ───────────────────────────────────────────────────── *@
<section class="aev-stat-grid" aria-label="My summary">
    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--teal" aria-hidden="true">📅</div>
        <div>
            <p class="aev-stat-card__label">@(isCreative ? "My Upcoming Shoots" : "Upcoming Shoots")</p>
            <h2 class="aev-stat-card__value">@UpcomingShootsCount</h2>
        </div>
    </article>
    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--blue" aria-hidden="true">✓</div>
        <div>
            <p class="aev-stat-card__label">@(isCreative ? "My Completed (Week)" : "Completed (Week)")</p>
            <h2 class="aev-stat-card__value">@CompletedThisWeekCount</h2>
        </div>
    </article>
    @if (!isCreative || teamLeaderEvents.Any(e => e.IsTeamLeader))
    {
        <article class="aev-stat-card">
            <div class="aev-stat-card__icon aev-stat-card__icon--amber" aria-hidden="true">📷</div>
            <div>
                <p class="aev-stat-card__label">@(isCreative ? "Assigned Equipment" : "Gear Checked Out")</p>
                <h2 class="aev-stat-card__value">@GearCheckedOutCount</h2>
            </div>
        </article>
    }
</section>

@* ── UPCOMING EVENTS ASSIGNED TO ME (For Photographer/Editor/Videographer & Staff) ── *@
<section class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-3 border-b border-slate-100 mb-4">
        <div>
            <h2 class="text-base font-bold text-slate-900">
                @(isCreative ? "Upcoming Events Assigned to You" : "Upcoming Studio Events & Shoots")
            </h2>
            <p class="text-xs text-slate-500">
                @(isCreative 
                    ? "Schedule of production sessions, photography calls, and shoot assignments designated specifically for your roster."
                    : "Studio-wide events and scheduled client production sessions.")
            </p>
        </div>
        <a href="/staff/calendar/master" class="text-xs font-semibold text-slate-800 hover:text-black hover:underline flex items-center gap-1">
            <span>View Full Calendar &rarr;</span>
        </a>
    </div>

    @if (!displayedEvents.Any())
    {
        <div class="py-10 text-center">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2 text-xl">
                📷
            </div>
            <h3 class="text-sm font-bold text-slate-800">
                @(isCreative ? "No Upcoming Events Assigned to You" : "No Upcoming Events Scheduled")
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">
                @(isCreative ? "You have no upcoming shoot assignments at this time. Check back later or check with the Office Clerk." : "All upcoming sessions have concluded or none are booked.")
            </p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="text-slate-500 border-b border-slate-100">
                        <th class="py-2.5 font-semibold">Date &amp; Time</th>
                        <th class="py-2.5 font-semibold">Client / Production</th>
                        <th class="py-2.5 font-semibold">Service</th>
                        <th class="py-2.5 font-semibold">Location / Space</th>
                        @if (!isCreative)
                        {
                            <th class="py-2.5 font-semibold">Assigned Crew</th>
                        }
                        <th class="py-2.5 font-semibold text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var ev in PagedEvents)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="py-3 font-mono font-bold text-slate-800">
                                <div>@ev.Date.ToString("ddd, MMM d")</div>
                                <div class="text-[11px] font-normal text-slate-500">@ev.FormattedTimeRange</div>
                            </td>
                            <td class="py-3">
                                <div class="font-bold text-slate-900">@ev.ClientName</div>
                                @if (!string.IsNullOrWhiteSpace(ev.ClientEmail))
                                {
                                    <div class="text-[11px] text-slate-400">@ev.ClientEmail</div>
                                }
                            </td>
                            <td class="py-3">
                                <span class="px-2 py-0.5 rounded font-medium bg-slate-100 text-slate-700">@ev.ServiceType</span>
                            </td>
                            <td class="py-3 text-slate-600">
                                <span>@(!string.IsNullOrWhiteSpace(ev.StudioSpaceName) ? ev.StudioSpaceName : "Main Studio")</span>
                            </td>
                            @if (!isCreative)
                            {
                                <td class="py-3 font-medium text-slate-700">
                                    📷 @ev.AssignedPhotographer
                                </td>
                            }
                            <td class="py-3 text-right">
                                @{
                                    var tlMatch = teamLeaderEvents.FirstOrDefault(t => string.Equals(t.EventAppointmentId, ev.Id, StringComparison.OrdinalIgnoreCase));
                                    var isTlForRow = tlMatch != null ? tlMatch.IsTeamLeader : IsTeamLeaderForBooking(ev);
                                }
                                <div class="inline-flex flex-wrap items-center justify-end gap-1.5">
                                    @if (isCreative && isTlForRow)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 text-teal-800 border border-teal-200">
                                            ★ Team Leader
                                        </span>
                                    }
                                    else if (isCreative && tlMatch != null)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                            Crew (View Only)
                                        </span>
                                    }
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @GetEventStatusPillClass(ev.Status)">
                                        @FormatRegularEmployeeEventStatus(ev.Status)
                                    </span>
                                    @if (isCreative && tlMatch != null && isTlForRow)
                                    {
                                        @if (!TeamLeaderMonitorSelector.IsOngoingOrInProcess(tlMatch))
                                        {
                                            <button type="button"
                                                    disabled="@isUpdatingTeamLeaderStage"
                                                    @onclick="() => StartTeamLeaderEventIntoTopPillAsync(tlMatch)"
                                                    class="px-2.5 py-1 rounded-full bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-[11px] font-bold shadow-xs transition-all">
                                                ▶ Start Event
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="/staff/team-lead-monitor"
                                               class="px-2.5 py-1 rounded-full bg-teal-50 hover:bg-teal-100 border border-teal-300 text-teal-900 text-[11px] font-bold transition-all">
                                                Open Monitor &rarr;
                                            </a>
                                        }
                                    }
                                    else if (isCreative && tlMatch != null)
                                    {
                                        <button type="button"
                                                @onclick="() => FocusTeamLeaderTopPill(tlMatch.EventAppointmentId)"
                                                class="px-2.5 py-1 rounded-full bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-800 text-[11px] font-bold transition-all">
                                            Monitor in Pill ↑
                                        </button>
                                    }
                                    else if (isCreative && isTlForRow)
                                    {
                                        <a href="/staff/team-lead-monitor"
                                           class="px-2.5 py-1 rounded-full bg-teal-700 hover:bg-teal-800 text-white text-[11px] font-bold shadow-xs transition-all">
                                            Open Monitor &rarr;
                                        </a>
                                    }
                                    @if (!isCreative && ev.Status != "Completed" && ev.Status != "Complete")
                                    {
                                        <button type="button"
                                                @onclick="() => OpenEventFinishModal(ev)"
                                                class="px-2.5 py-1 bg-slate-900 hover:bg-black text-white text-[11px] font-bold rounded-md shadow-xs transition-all">
                                            Event Finish &rarr;
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <TablePagination TotalItems="displayedEvents.Count" PageSize="10" @bind-CurrentPage="eventsPage" ItemLabel="events" />
        </div>
    }
</section>

@* ── Navigation cards ─────────────────────────────────────────────── *@
<div class="aev-content-row aev-content-row--wrap">
    @if (isCreative)
    {
        <a href="/staff/calendar/master" class="aev-nav-card">
            <span class="aev-nav-card__icon" aria-hidden="true">📅</span>
            <h2 class="aev-nav-card__title">My Schedule (Read-Only)</h2>
            <p class="aev-nav-card__desc">View your assigned shoot dates, times, and live progress.</p>
        </a>

        <a href="/staff/featured-services" class="aev-nav-card">
            <span class="aev-nav-card__icon" aria-hidden="true">★</span>
            <h2 class="aev-nav-card__title">Featured Services</h2>
            <p class="aev-nav-card__desc">Browse signature studio offerings and featured packages.</p>
        </a>

        <a href="/portfolio" class="aev-nav-card">
            <span class="aev-nav-card__icon" aria-hidden="true">🖼️</span>
            <h2 class="aev-nav-card__title">Studio Portfolio</h2>
            <p class="aev-nav-card__desc">Explore curated studio photography showcases.</p>
        </a>
    }
    else
    {
        <a href="/staff/assignments" class="aev-nav-card">
            <span class="aev-nav-card__icon" aria-hidden="true">🎬</span>
            <h2 class="aev-nav-card__title">My Assignments</h2>
            <p class="aev-nav-card__desc">View upcoming shoots, call times, and shot lists.</p>
        </a>

        <a href="/staff/pipeline" class="aev-nav-card">
            <span class="aev-nav-card__icon" aria-hidden="true">🔄</span>
            <h2 class="aev-nav-card__title">Delivery Pipeline</h2>
            <p class="aev-nav-card__desc">Track post-processing: Culling, Editing, Uploading.</p>
        </a>

        <a href="/staff/gear" class="aev-nav-card">
            <span class="aev-nav-card__icon" aria-hidden="true">📷</span>
            <h2 class="aev-nav-card__title">Gear Checklist</h2>
            <p class="aev-nav-card__desc">Check out / return equipment and file damage reports.</p>
        </a>
    }
</div>

@* ── Cash Collections & Remittance Ledger (Clerk / Team Leader Only) ── *@
@if (isClerk || teamLeaderEvents.Any(e => e.IsTeamLeader))
{
<section class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mt-6">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
        <div>
            <h2 class="text-base font-bold text-slate-900">💵 Cash Collections &amp; Remittance Ledger</h2>
            <p class="text-xs text-slate-500">Track on-site cash payments received from customers and pending admin verification.</p>
        </div>
        <span class="text-xs font-semibold px-2.5 py-1 bg-amber-50 text-amber-800 border border-amber-200 rounded-lg">
            @(myCashRemittances.Count(r => r.EmployeeRemittanceStatus == "PendingAdminApproval")) Pending Clearance
        </span>
    </div>

    @if (!myCashRemittances.Any())
    {
        <div class="p-6 text-center text-xs text-slate-400 bg-slate-50 rounded-lg border border-dashed border-slate-200">
            No on-site cash collections recorded yet.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-xs text-left">
                <thead class="text-slate-400 uppercase font-semibold text-[10px] border-b">
                    <tr>
                        <th class="py-2 px-3">Date</th>
                        <th class="py-2 px-3">Booking / Event</th>
                        <th class="py-2 px-3">Amount Collected</th>
                        <th class="py-2 px-3">Customer View</th>
                        <th class="py-2 px-3">Employee Remittance State</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var rem in PagedCashRemittances)
                    {
                        <tr>
                            <td class="py-2.5 px-3 text-slate-600">@rem.CreatedAt.ToLocalTime().ToString("MMM d, yyyy • h:mm tt")</td>
                            <td class="py-2.5 px-3 font-semibold text-slate-800">@(rem.EventAppointmentId ?? $"#{rem.BookingId}")</td>
                            <td class="py-2.5 px-3 font-bold text-slate-900">₱@rem.Amount.ToString("N2")</td>
                            <td class="py-2.5 px-3">
                                <span class="bg-green-100 text-green-800 px-2 py-0.5 rounded-full font-bold text-[10px]">
                                    Cleared (Confirmed)
                                </span>
                            </td>
                            <td class="py-2.5 px-3">
                                @if (rem.EmployeeRemittanceStatus == "Cleared")
                                {
                                    <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded-full font-bold text-[10px]">
                                        ✓ Cleared &amp; Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 border border-amber-300 px-2.5 py-0.5 rounded-full font-bold text-[10px]">
                                        ⏳ Pending Admin Clearance
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <TablePagination TotalItems="myCashRemittances.Count" PageSize="10" @bind-CurrentPage="remittancesPage" ItemLabel="remittances" />
        </div>
    }
</section>
}

@* ── Leave Requests Section ───────────────────────────────────────── *@
<section class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mt-6">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-100 mb-4">
        <div>
            <h2 class="text-base font-bold text-slate-900">Leave Requests &amp; Time Off</h2>
            @if (IsOfficeClerkLeaveMode)
            {
                <p class="text-xs text-slate-500">File a request for Vacation Leave, Sick Leave, Leave Without Pay, or Statutory Leave.</p>
            }
            else
            {
                <p class="text-xs text-slate-500">File a request for Shoot Unavailability / Time Off or eligible Special Statutory Leave.</p>
            }
        </div>
        <button type="button" @onclick="OpenLeaveModal" class="px-3 py-1.5 bg-slate-900 hover:bg-black text-white text-xs font-semibold rounded-lg shadow-xs">
            + File Leave Request
        </button>
    </div>

    @if (IsOfficeClerkLeaveMode)
    {
        <div class="mb-4 p-3 rounded-xl bg-teal-50/80 border border-teal-200 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="font-bold text-teal-950">
                Remaining Paid Leaves: @($"{leaveBalanceSummary.TotalRemainingPaidDays:0.0}") days (VL: @($"{leaveBalanceSummary.VacationLeaveRemaining:0.0}") left &bull; SL: @($"{leaveBalanceSummary.SickLeaveRemaining:0.0}") left)
            </div>
            <div class="text-[11px] text-teal-800 font-medium">
                Fixed Monthly Clerk &bull; Scheduled Days Off: <span class="font-bold">@leaveBalanceSummary.DaysOff</span> &bull; VL carries DOLE Art. 95 year-end cash conversion
            </div>
        </div>
    }
    else
    {
        <div class="mb-4 p-3 rounded-xl bg-slate-50 border border-slate-200 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div class="font-bold text-slate-800">
                Per-Event Crew (Unpaid Time-Off) &bull; Shoot Unavailability blocks event dispatch on selected dates
            </div>
            <div class="text-[11px] text-slate-500">
                Scheduled Days Off: <span class="font-semibold text-slate-700">@leaveBalanceSummary.DaysOff</span>
            </div>
        </div>
    }

    @if (myLeaves.Count == 0)
    {
        <p class="text-xs text-slate-400 py-3 italic">No leave requests filed yet.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="text-slate-500 border-b border-slate-100">
                        <th class="py-2">Type</th>
                        <th class="py-2">Dates</th>
                        <th class="py-2">Countable Workdays</th>
                        <th class="py-2">Reason</th>
                        <th class="py-2">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var l in PagedLeaves)
                    {
                        var rowWorkdays = l.CountableDays ?? LeaveWorkdayHelper.CalculateCountableWorkdays(employeeId, l.StartDate, l.EndDate, l.IsHalfDay, leaveBalanceSummary.DaysOff).CountableDays;
                        <tr>
                            <td class="py-2.5 font-bold text-slate-800">@l.LeaveType</td>
                            <td class="py-2.5 font-mono text-slate-600">@l.StartDate.ToString("MMM d") – @l.EndDate.ToString("MMM d, yyyy")</td>
                            <td class="py-2.5 font-semibold text-slate-700">@($"{rowWorkdays:0.0}") workdays</td>
                            <td class="py-2.5 text-slate-500 italic">@(l.Reason ?? "None provided")</td>
                            <td class="py-2.5">
                                @if (l.Status == "Approved")
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Approved</span>
                                }
                                else if (l.Status == "Rejected")
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800" title="@l.RejectionReason">Rejected</span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Pending Review</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <TablePagination TotalItems="myLeaves.Count" PageSize="10" @bind-CurrentPage="leavesPage" ItemLabel="leave requests" />
        </div>
    }
</section>

<!-- Leave Request Modal -->
@if (isLeaveModalOpen)
{
    var modalWorkdays = CurrentModalWorkdaysPreview;
    var overlappingAssignedEvents = CurrentModalOverlappingEvents;
    decimal selectedTypeRemaining = SelectedPaidLeaveRemaining;
    decimal projectedRemaining = Math.Max(0m, selectedTypeRemaining - modalWorkdays.CountableDays);
    bool isPaidCreditLeave = newLeaveType is "Vacation Leave" or "Sick Leave";
    bool requiresMedCert = newLeaveType == "Sick Leave" && modalWorkdays.CountableDays > 2.0m;

    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" @onclick="() => isLeaveModalOpen = false">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md p-6" @onclick:stopPropagation="true">
            <h3 class="text-sm font-bold text-slate-900 mb-1">Request Employee Leave</h3>
            <p class="text-xs text-slate-500 mb-4">
                @(IsOfficeClerkLeaveMode
                    ? "Requires approval by a Studio Admin before taking effect."
                    : "Requires approval by an Office Clerk or Studio Admin before taking effect.")
            </p>

            @if (!string.IsNullOrWhiteSpace(leaveError))
            {
                <div class="p-2 mb-3 bg-rose-50 text-rose-700 text-xs rounded">@leaveError</div>
            }

            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold mb-1">Leave Type</label>
                    <select @bind="newLeaveType" class="w-full p-2 border rounded-lg">
                        @if (IsOfficeClerkLeaveMode)
                        {
                            <option value="Vacation Leave">Vacation Leave (VL — Paid, Cash Convertible)</option>
                            <option value="Sick Leave">Sick Leave (SL — Paid)</option>
                            <option value="Leave Without Pay">Leave Without Pay (LWOP — Unpaid Overflow)</option>
                            <option value="Maternity Leave">Maternity Leave (Statutory — 105d)</option>
                            <option value="Paternity Leave">Paternity Leave (Statutory — 7d)</option>
                            <option value="Solo Parent Leave">Solo Parent Leave (Statutory — 7d)</option>
                            <option value="VAWC Leave">VAWC Leave (Statutory — 10d)</option>
                        }
                        else
                        {
                            <option value="Shoot Unavailability / Time Off">Shoot Unavailability / Time Off (Unpaid Schedule Block)</option>
                            <option value="Maternity Leave">Maternity Leave (Statutory — 105d)</option>
                            <option value="Paternity Leave">Paternity Leave (Statutory — 7d)</option>
                            <option value="Solo Parent Leave">Solo Parent Leave (Statutory — 7d)</option>
                            <option value="VAWC Leave">VAWC Leave (Statutory — 10d)</option>
                        }
                    </select>
                </div>

                @if (IsOfficeClerkLeaveMode)
                {
                    <div class="p-2.5 rounded-lg bg-teal-50 border border-teal-200 text-teal-900 space-y-1">
                        <div class="flex items-center justify-between font-bold">
                            <span>Remaining Paid Leaves: @($"{leaveBalanceSummary.TotalRemainingPaidDays:0.0}") days</span>
                            <span>VL: @($"{leaveBalanceSummary.VacationLeaveRemaining:0.0}") left &bull; SL: @($"{leaveBalanceSummary.SickLeaveRemaining:0.0}") left</span>
                        </div>
                        @if (isPaidCreditLeave)
                        {
                            <div class="flex items-center justify-between text-[11px] text-teal-800 pt-1 border-t border-teal-200/70">
                                <span>Remaining Paid Leave for @(newLeaveType == "Vacation Leave" ? "VL" : "SL"): <strong>@($"{selectedTypeRemaining:0.0}") days</strong></span>
                                <span>Projected Remaining After Request: <strong>@($"{projectedRemaining:0.0}") days</strong></span>
                            </div>
                        }
                    </div>
                }

                @if (newLeaveType == "Shoot Unavailability / Time Off")
                {
                    <div class="p-2.5 rounded-lg bg-sky-50 border border-sky-200 text-sky-900 font-medium" role="status">
                        Unpaid schedule block — prevents event dispatch on selected dates.
                    </div>
                }

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-semibold mb-1">Start Date</label>
                        <input type="date" @bind="newLeaveStart" class="w-full p-2 border rounded-lg" />
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">End Date</label>
                        <input type="date" @bind="newLeaveEnd" class="w-full p-2 border rounded-lg" />
                    </div>
                </div>

                <div class="flex items-center justify-between bg-slate-50 border border-slate-200 rounded-lg px-3 py-2">
                    <div>
                        <span class="font-semibold text-slate-800">Countable Workdays: @($"{modalWorkdays.CountableDays:0.0}") days</span>
                        <span class="text-[11px] text-slate-500 block">
                            (@modalWorkdays.CalendarDays calendar days &bull; excludes @leaveBalanceSummary.DaysOff &amp; PH holidays)
                        </span>
                    </div>
                    <label class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-700 cursor-pointer">
                        <input type="checkbox" @bind="newLeaveIsHalfDay" class="rounded border-slate-300" />
                        Half-Day (0.5d)
                    </label>
                </div>

                @if (requiresMedCert)
                {
                    <div class="p-2.5 rounded-lg bg-amber-50 border border-amber-300 space-y-1.5">
                        <label class="block font-bold text-amber-900">
                            Medical Certificate Attachment Required (&gt; 2 consecutive countable days) <span class="text-rose-600">*</span>
                        </label>
                        <input type="text"
                               @bind="newLeaveAttachmentName"
                               placeholder="Enter Medical Certificate filename or reference (e.g., MedCert_SL.pdf)"
                               class="w-full p-2 bg-white border border-amber-300 rounded-lg text-slate-900" />
                    </div>
                }

                @if (overlappingAssignedEvents.Count > 0)
                {
                    <div class="p-2.5 rounded-lg bg-amber-50 border border-amber-300 text-amber-900 space-y-1" role="alert">
                        <div class="font-bold">⚠️ Schedule Conflict Warning (@overlappingAssignedEvents.Count assigned event@(overlappingAssignedEvents.Count == 1 ? "" : "s"))</div>
                        <p class="text-[11px]">You have active shoot/event assignments overlapping these dates:</p>
                        <ul class="list-disc list-inside text-[11px] font-medium">
                            @foreach (var ev in overlappingAssignedEvents.Take(3))
                            {
                                <li>@ev.Date.ToString("MMM d, yyyy") — @(string.IsNullOrWhiteSpace(ev.ServiceType) ? ev.ClientName : ev.ServiceType) (@ev.Status)</li>
                            }
                        </ul>
                    </div>
                }

                <div>
                    <label class="block font-semibold mb-1">Description</label>
                    <textarea @bind="newLeaveReason" rows="3" class="w-full p-2 border rounded-lg" placeholder="Describe the reason for your leave request..."></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-5 pt-3 border-t">
                <button type="button" @onclick="() => isLeaveModalOpen = false" class="px-3 py-1.5 border rounded text-xs">Cancel</button>
                <button type="button" @onclick="SubmitLeave" disabled="@isSubmittingLeave" class="px-4 py-1.5 bg-slate-900 text-white rounded text-xs font-bold">
                    @(isSubmittingLeave ? "Submitting..." : "Submit Request")
                </button>
            </div>
        </div>
    </div>
}


@* ── TEAM LEADER ON-SITE EVENT FINISH & SETTLEMENT MODAL ────────────────── *@
@if (isFinishModalOpen && selectedFinishEvent != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-xl max-h-[90vh] flex flex-col overflow-hidden">
            
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
                <div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-400 text-slate-950 uppercase tracking-wider">Team Leader POS</span>
                    <h2 class="text-base font-black text-slate-900 mt-1">Conclude Event &amp; Final Settlement</h2>
                </div>
                <button type="button" @onclick="() => isFinishModalOpen = false" class="text-slate-400 hover:text-slate-700 p-2">✕</button>
