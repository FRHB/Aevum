    private async Task SubmitLeave()
    {
        if (newLeaveEnd < newLeaveStart)
        {
            leaveError = "End Date cannot be before Start Date.";
            return;
        }

        var preview = CurrentModalWorkdaysPreview;
        if (preview.CountableDays <= 0m)
        {
            leaveError = $"Selected dates contain 0 countable workdays (all dates fall on {leaveBalanceSummary.DaysOff} or holidays).";
            return;
        }

        if (newLeaveType == "Sick Leave" && preview.CountableDays > 2.0m && string.IsNullOrWhiteSpace(newLeaveAttachmentName))
        {
            leaveError = "Medical Certificate attachment reference is required for Sick Leave exceeding 2 consecutive countable workdays.";
            return;
        }

        if (IsOfficeClerkLeaveMode && (newLeaveType == "Vacation Leave" || newLeaveType == "Sick Leave"))
        {
            decimal avail = SelectedPaidLeaveRemaining;
            if (preview.CountableDays > avail)
            {
                leaveError = $"Insufficient {newLeaveType} credits ({avail:0.0}d left for {preview.CountableDays:0.0}d requested). File overflow days as Leave Without Pay (LWOP).";
                return;
            }
        }

        isSubmittingLeave = true;
        leaveError = null;

        try
        {
            var ok = await Employees.RequestLeaveAsync(
                newLeaveType,
                DateOnly.FromDateTime(newLeaveStart),
                DateOnly.FromDateTime(newLeaveEnd),
                newLeaveReason,
                string.IsNullOrWhiteSpace(employeeId) ? null : employeeId,
                newLeaveIsHalfDay,
                string.IsNullOrWhiteSpace(newLeaveAttachmentName) ? null : newLeaveAttachmentName.Trim());

            if (ok)
            {
                isLeaveModalOpen = false;
                newLeaveReason = string.Empty;
                newLeaveAttachmentName = string.Empty;
                newLeaveIsHalfDay = false;
                await RefreshStatus();
            }
            else
            {
                leaveError = "Failed to submit leave request. Please check inputs.";
            }
        }
        finally
        {
            isSubmittingLeave = false;
        }
    }
