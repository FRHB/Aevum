@code {
    private List<PaymentSummaryModel> myCashRemittances = new();
    private List<TeamLeaderEventDto> teamLeaderEvents = new();
    private static readonly string[] TeamLeaderStages = { "Preparing", "On Going", "Post Event", "Pending Payment" };
    private string? teamLeaderActionMessage;
    private string? teamLeaderErrorMessage;
    private bool isUpdatingTeamLeaderStage = false;
    private readonly HashSet<string> _subscribedHubRefs = new(StringComparer.OrdinalIgnoreCase);

    // Event Finish & Settlement State
    private bool isFinishModalOpen = false;
    private EventBookingModel? selectedFinishEvent;
    private decimal extraHours = 0m;
    private decimal hourlyRate = 1500m;
    private decimal extraSurcharges = 0m;
    private string overtimeNotes = string.Empty;
    private decimal baseRemainingBalance = 0m;
    private decimal totalSurcharges = 0m;
    private decimal finalDueAmount = 0m;
    private string selectedPaymentMethod = "Cash_OnHand";
    private bool isSubmittingSettlement = false;
    private string? finishModalError;

    private void OpenEventFinishModal(EventBookingModel ev)
    {
        selectedFinishEvent = ev;
        extraHours = 0m;
        hourlyRate = 1500m;
        extraSurcharges = 0m;
        overtimeNotes = string.Empty;
        baseRemainingBalance = Math.Round(ev.EstimatedPrice * 0.85m, 2);
        selectedPaymentMethod = "Cash_OnHand";
        finishModalError = null;
        RecalculateSettlement();
        isFinishModalOpen = true;
    }

    private void OpenTeamLeaderSettlementModal(TeamLeaderEventDto tlEv, string defaultMethod = "Cash_OnHand")
    {
        selectedFinishEvent = new EventBookingModel
        {
            Id = tlEv.EventAppointmentId,
            ServiceType = tlEv.EventName,
            ClientName = tlEv.CustomerName,
            ClientEmail = tlEv.CustomerEmail,
            Date = tlEv.EventDate.ToDateTime(TimeOnly.MinValue),
            StartTime = tlEv.EventTime.ToTimeSpan(),
            EndTime = tlEv.EventTime.ToTimeSpan().Add(TimeSpan.FromHours(3)),
            Status = tlEv.EventStatus,
            EstimatedPrice = tlEv.TotalAmount
        };
        extraHours = 0m;
        hourlyRate = 1500m;
        extraSurcharges = 0m;
        overtimeNotes = string.Empty;
        baseRemainingBalance = tlEv.FinalBalanceAmount > 0
            ? tlEv.FinalBalanceAmount
            : Math.Round(tlEv.TotalAmount * 0.85m, 2);
        selectedPaymentMethod = defaultMethod;
        finishModalError = null;
        RecalculateSettlement();
        isFinishModalOpen = true;
    }

    private void RecalculateSettlement()
    {
        totalSurcharges = Math.Round((extraHours * hourlyRate) + extraSurcharges, 2);
        finalDueAmount = baseRemainingBalance + totalSurcharges;
    }

    private async Task SubmitEventSettlementAsync()
    {
        if (selectedFinishEvent == null) return;
        isSubmittingSettlement = true;
        finishModalError = null;
        teamLeaderActionMessage = null;
        teamLeaderErrorMessage = null;

        try
        {
            var req = new CompleteEventRequest
            {
                EventAppointmentId = selectedFinishEvent.Id,
                ExtraHours = extraHours,
                HourlyRate = hourlyRate,
                SurchargeAmount = totalSurcharges,
                OvertimeNotes = overtimeNotes,
                PaymentMethod = selectedPaymentMethod,
                TeamLeaderEmployeeId = employeeId,
                Notes = $"Event settlement submitted by {employeeName} ({employeeId})."
            };

            var res = await ConsultationApi.CompleteEventAsync(selectedFinishEvent.Id, req);
            if (!res.IsSuccess || res.Value == null)
            {
                finishModalError = res.Error?.Message ?? "Failed to record final settlement. Please try again.";
                return;
            }

            ScheduleService.InvalidateCache();
            isFinishModalOpen = false;
            teamLeaderActionMessage = selectedPaymentMethod == "Xendit_QR"
                ? $"QR payment code generated on Team Leader panel and final payment email sent to {res.Value.CustomerEmail}."
                : $"Cash settlement of ₱{res.Value.FinalBalanceAmount:N2} logged. Status: Pending Verification.";

            await RefreshTeamLeaderEventsAsync();
            await SubscribeActiveQrHubAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            finishModalError = ex.Message;
        }
        finally
        {
            isSubmittingSettlement = false;
        }
    }

    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }

    private ClaimsPrincipal? currentUser;
    private bool isClerk;
    private bool isCreative;
    private string employeeName = string.Empty;
    private string employeeId = string.Empty;

    private int UpcomingShootsCount;
    private int CompletedThisWeekCount;
    private int GearCheckedOutCount;

    private List<EventBookingModel> displayedEvents = new();

    private ClockStatusViewModel clockStatus = new();
    private List<LeaveItemViewModel> myLeaves = new();
    private bool isPunching = false;

    private bool isLeaveModalOpen = false;
    private bool isSubmittingLeave = false;
    private string? leaveError;
    private string newLeaveType = "Sick Leave";
    private DateTime newLeaveStart = DateTime.Today;
    private DateTime newLeaveEnd = DateTime.Today;
    private string newLeaveReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            currentUser = state.User;
        }

        isClerk = EmployeeRoleHelper.IsOfficeClerk(currentUser, UserService);
        isCreative = EmployeeRoleHelper.IsPhotographerOrCreative(currentUser, UserService);
        employeeId = EmployeeRoleHelper.GetCurrentEmployeeId(currentUser);
        employeeName = EmployeeRoleHelper.GetCurrentEmployeeName(currentUser, UserService);

        // Load all bookings from ScheduleService and UserService
        var scheduleBookings = ScheduleService.GetEventBookings();

        if (isCreative)
        {
            // Requirement 4: Overview: Only show upcoming events assigned to them
            displayedEvents = scheduleBookings
                .Where(b => EmployeeRoleHelper.IsEventAssignedToEmployee(b, employeeName, employeeId) && b.Date.Date >= DateTime.Today && !string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                .OrderBy(b => b.Date)
                .ThenBy(b => b.StartTime)
                .ToList();

            UpcomingShootsCount = displayedEvents.Count;

            CompletedThisWeekCount = scheduleBookings.Count(b => 
                EmployeeRoleHelper.IsEventAssignedToEmployee(b, employeeName, employeeId) &&
                string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase) &&
                b.Date >= DateTime.Today.AddDays(-7));

            var reservations = ScheduleService.GetEquipmentReservations();
            GearCheckedOutCount = reservations.Count(r => 
                !string.IsNullOrWhiteSpace(employeeName) &&
                r.TechnicianInCharge.Contains(employeeName, StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            // Full access (Office Clerk / Admin)
            displayedEvents = scheduleBookings
                .Where(b => b.Date.Date >= DateTime.Today && !string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                .OrderBy(b => b.Date)
                .ThenBy(b => b.StartTime)
                .ToList();

            UpcomingShootsCount = displayedEvents.Count;

            CompletedThisWeekCount = scheduleBookings.Count(b => 
                string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase) &&
                b.Date >= DateTime.Today.AddDays(-7));

            GearCheckedOutCount = UserService.GetEquipmentRows().Count(e => !string.Equals(e.Status, "Available", StringComparison.OrdinalIgnoreCase));
        }

        await RefreshStatus();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshTeamLeaderEventsAsync();
        await SubscribeActiveQrHubAsync();
        StateHasChanged();
    }

    private async Task RefreshStatus()
    {
        var clockTask = Employees.GetClockStatusAsync();
        var leavesTask = Employees.GetMyLeavesAsync();
        var ledgerTask = SafeLoadEmployeeLedgerAsync();
        var tlTask = RefreshTeamLeaderEventsAsync();

        await Task.WhenAll(clockTask, leavesTask, ledgerTask, tlTask);

        clockStatus = await clockTask;
        myLeaves = (await leavesTask).ToList();
    }

    private async Task RefreshTeamLeaderEventsAsync()
    {
        try
        {
            var tlRes = await ConsultationApi.GetTeamLeaderEventsAsync(employeeId);
            if (tlRes.IsSuccess && tlRes.Value != null)
            {
                teamLeaderEvents = tlRes.Value.ToList();
            }
        }
        catch
        {
        }
    }

    private async Task HandleTeamLeaderStageClickAsync(TeamLeaderEventDto tlEv, string stage)
    {
        if (string.Equals(stage, "Pending Payment", StringComparison.OrdinalIgnoreCase))
        {
            OpenTeamLeaderSettlementModal(tlEv, "Cash_OnHand");
            return;
        }

        isUpdatingTeamLeaderStage = true;
        teamLeaderActionMessage = null;
        teamLeaderErrorMessage = null;
        try
        {
            var res = await ConsultationApi.UpdateTeamLeaderEventStatusAsync(tlEv.EventAppointmentId, new UpdateTeamLeaderStatusRequest
            {
                Status = stage,
                EmployeeId = employeeId
            });
            if (res.IsSuccess && res.Value != null)
            {
                tlEv.EventStatus = res.Value.EventStatus;
                ScheduleService.InvalidateCache();
                teamLeaderActionMessage = $"Event #{tlEv.EventAppointmentId} updated to '{res.Value.EventStatus}'.";
            }
            else
            {
                teamLeaderErrorMessage = res.Error?.Message ?? "Failed to update event stage.";
            }
        }
        catch (Exception ex)
        {
            teamLeaderErrorMessage = ex.Message;
        }
        finally
        {
            isUpdatingTeamLeaderStage = false;
        }
    }

    private async Task SimulateTeamLeaderQrPaidAsync(string finalRefId)
    {
        isUpdatingTeamLeaderStage = true;
        teamLeaderActionMessage = null;
        teamLeaderErrorMessage = null;
        try
        {
            var res = await ConsultationApi.SimulateQrPaymentAsync(finalRefId);
            if (res.IsSuccess)
            {
                ScheduleService.InvalidateCache();
                await RefreshTeamLeaderEventsAsync();
                teamLeaderActionMessage = $"Final QR payment verified & Paid for {finalRefId}. Team Leader email notification dispatched.";
            }
            else
            {
                teamLeaderErrorMessage = res.Error?.Message ?? "Could not simulate final QR payment.";
            }
        }
        catch (Exception ex)
        {
            teamLeaderErrorMessage = ex.Message;
        }
        finally
        {
            isUpdatingTeamLeaderStage = false;
        }
    }

    private async Task SubscribeActiveQrHubAsync()
    {
        foreach (var ev in teamLeaderEvents)
        {
            var refId = ev.FinalPaymentReferenceId;
            if (string.IsNullOrWhiteSpace(refId) || _subscribedHubRefs.Contains(refId))
                continue;
            if (string.Equals(ev.FinalPaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                continue;

            _subscribedHubRefs.Add(refId);
            try
            {
                await PaymentHub.StartAsync(
                    refId,
                    onPaymentCompleted: () => InvokeAsync(async () =>
                    {
                        ScheduleService.InvalidateCache();
                        await RefreshTeamLeaderEventsAsync();
                        teamLeaderActionMessage = $"Customer final QR payment confirmed for #{ev.EventAppointmentId}!";
                        StateHasChanged();
                    }),
                    onBookingExpired: () => Task.CompletedTask);
                break;
            }
            catch
            {
            }
        }
    }

    private static string GetTeamLeaderStatusBadgeClass(TeamLeaderEventDto ev)
    {
        if (string.Equals(ev.FinalPaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase)
            || string.Equals(ev.EventStatus, "Shot", StringComparison.OrdinalIgnoreCase))
            return "bg-emerald-100 text-emerald-800";
        if (string.Equals(ev.EventStatus, "Pending Verification", StringComparison.OrdinalIgnoreCase)
            || string.Equals(ev.FinalPaymentStatus, "Pending Verification", StringComparison.OrdinalIgnoreCase)
            || string.Equals(ev.EventStatus, "Pending Payment", StringComparison.OrdinalIgnoreCase))
            return "bg-amber-100 text-amber-800";
        if (string.Equals(ev.EventStatus, "On Going", StringComparison.OrdinalIgnoreCase))
            return "bg-teal-100 text-teal-800";
        if (string.Equals(ev.EventStatus, "Post Event", StringComparison.OrdinalIgnoreCase))
            return "bg-purple-100 text-purple-800";
        if (string.Equals(ev.EventStatus, "Preparing", StringComparison.OrdinalIgnoreCase))
            return "bg-sky-100 text-sky-800";
        return "bg-slate-100 text-slate-700";
    }

    private string ResolveQrConfirmUrl(string referenceId)
    {
        var configuredBase = Config["BaseUrl"]?.Trim();
        var effectiveBase = (!string.IsNullOrWhiteSpace(configuredBase) &&
                             !configuredBase.Contains("localhost", StringComparison.OrdinalIgnoreCase) &&
                             !configuredBase.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase))
            ? configuredBase
            : (Nav.BaseUri.Contains("localhost", StringComparison.OrdinalIgnoreCase) || Nav.BaseUri.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase)
                ? (string.IsNullOrWhiteSpace(configuredBase) ? Nav.BaseUri : configuredBase)
                : Nav.BaseUri);
        return QrPaymentLinks.BuildConfirmUrl(effectiveBase, Nav.BaseUri, referenceId);
    }

    private static string BuildQrSvg(string payload)
    {
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(payload, QRCodeGenerator.ECCLevel.M);
        return new SvgQRCode(data).GetGraphic(5);
    }

