                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Additional Surcharges (₱)</label>
                            <input type="number" step="100" min="0" @bind="extraSurcharges" @bind:after="RecalculateSettlement"
                                   class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-bold" />
                        </div>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Reason for Overtime / Add-ons</label>
                        <input type="text" @bind="overtimeNotes" placeholder="e.g. Extended reception shoot + 2 extra roll proofs"
                               class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs" />
                    </div>
                </div>

                @* Balance Breakdown *@
                <div class="bg-slate-900 text-white rounded-xl p-4 flex items-center justify-between">
                    <div>
                        <div class="text-[10px] uppercase font-bold text-slate-400">Base Remaining Balance</div>
                        <div class="font-mono text-sm font-bold text-slate-300">₱@baseRemainingBalance.ToString("N2")</div>
                        <div class="text-[10px] text-amber-400 mt-1">+ Overtime &amp; Surcharges: ₱@totalSurcharges.ToString("N2")</div>
                    </div>
                    <div class="text-right">
                        <div class="text-[10px] uppercase font-bold text-emerald-400">Total Settlement Due</div>
                        <div class="font-mono text-xl font-black text-emerald-400">₱@finalDueAmount.ToString("N2")</div>
                    </div>
                </div>

                @* Payment Method Selection *@
                <div class="space-y-2">
                    <span class="block font-bold text-slate-700 text-[11px] uppercase tracking-wider">Select Payment Method</span>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button"
                                @onclick='() => selectedPaymentMethod = "Cash_OnHand"'
                                class="p-3 rounded-xl border text-left font-bold transition-all @(selectedPaymentMethod == "Cash_OnHand" ? "border-slate-900 bg-slate-50 ring-1 ring-slate-900" : "border-slate-200 hover:border-slate-300")">
                            <div class="text-xs text-slate-900">💵 Cash On Hand</div>
                            <div class="text-[10px] font-normal text-slate-500 mt-0.5">Collect cash on site</div>
                        </button>
                        <button type="button"
                                @onclick='() => selectedPaymentMethod = "Xendit_QR"'
                                class="p-3 rounded-xl border text-left font-bold transition-all @(selectedPaymentMethod == "Xendit_QR" ? "border-slate-900 bg-slate-50 ring-1 ring-slate-900" : "border-slate-200 hover:border-slate-300")">
                            <div class="text-xs text-slate-900">📱 Dynamic Xendit QR</div>
                            <div class="text-[10px] font-normal text-slate-500 mt-0.5">GCash / Maya / QR Ph scan</div>
                        </button>
                    </div>
                </div>

                @if (selectedPaymentMethod == "Cash_OnHand")
                {
                    <div class="p-3.5 rounded-xl border border-amber-200 bg-amber-50/70 text-xs text-amber-900 space-y-1">
                        <div class="font-bold flex items-center gap-1.5">
                            <span>ℹ️</span> Cash Payment &rarr; Payment Verification (Cash)
                        </div>
                        <p class="text-[11px] leading-relaxed">
                            Logging cash collected on-site sets payment verification status to <span class="font-bold text-amber-900 bg-amber-200 px-1.5 py-0.5 rounded">Payment Verification (Cash)</span> until Admin verifies and clears the cash remittance.
                        </p>
                    </div>
                }

                @if (selectedPaymentMethod == "Xendit_QR")
                {
                    var previewConfirmUrl = ResolveQrConfirmUrl($"{selectedFinishEvent.Id}-FINAL");
                    <div class="p-4 rounded-xl border border-teal-200 bg-teal-50/50 text-center space-y-2">
                        <div class="text-xs font-bold text-teal-900">QR Final Payment Preview &amp; Customer Email</div>
                        <div class="w-36 h-36 mx-auto bg-white border border-teal-200 rounded-lg p-2 shadow-xs flex items-center justify-center overflow-hidden [&_svg]:w-full [&_svg]:h-full [&_svg]:block">
                            @((MarkupString)BuildQrSvg(previewConfirmUrl))
                        </div>
                        <p class="text-[11px] text-slate-600">
                            Confirming generates the live Xendit QR on your Ongoing Event panel and sends the final payment email to the customer. You will be emailed once paid.
                        </p>
                        <div class="text-[11px] text-teal-700 font-mono font-bold">Amount: ₱@finalDueAmount.ToString("N2")</div>
                    </div>
                }

            </div>

            <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
                <button type="button" @onclick="() => isFinishModalOpen = false" class="px-4 py-2 border rounded-lg text-xs font-semibold">
                    Cancel
                </button>
                <button type="button"
                        @onclick="SubmitEventSettlementAsync"
                        disabled="@isSubmittingSettlement"
                        class="px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow-sm transition-all">
                    @(isSubmittingSettlement
                        ? "Processing Settlement..."
                        : selectedPaymentMethod == "Xendit_QR"
                            ? $"Generate QR & Email Customer (₱{finalDueAmount:N2})"
                            : $"Cash Received (₱{finalDueAmount:N2})")
                </button>
            </div>

        </div>
    </div>
}


@code {
    private List<PaymentSummaryModel> myCashRemittances = new();
    private int eventsPage = 1;
    private int remittancesPage = 1;
    private int leavesPage = 1;
    private List<EventBookingModel> PagedEvents => TablePagination.Paginate(displayedEvents, eventsPage, 10);
    private List<PaymentSummaryModel> PagedCashRemittances => TablePagination.Paginate(myCashRemittances, remittancesPage, 10);
    private List<LeaveItemViewModel> PagedLeaves => TablePagination.Paginate(myLeaves, leavesPage, 10);
    private List<TeamLeaderEventDto> teamLeaderEvents = new();
    private TeamLeaderEventDto? _recentlyCompletedTeamLeadEvent;
    private string? _selectedActiveTeamLeadEventId;
    private List<EquipmentItemModel> _studioEquipments = new();
    private List<EventBookingModel> _staffBookings = new();
    private List<EquipmentReservationModel> _staffEquipmentReservations = new();
    private string? teamLeaderActionMessage;
    private string? teamLeaderErrorMessage;
    private bool isUpdatingTeamLeaderStage = false;
    private readonly HashSet<string> _subscribedHubRefs = new(StringComparer.OrdinalIgnoreCase);
    private System.Threading.Timer? _postEventAutoTimer;

    // Event Finish & Settlement State
    private bool isFinishModalOpen = false;
    private EventBookingModel? selectedFinishEvent;
    private decimal extraHours = 0m;
    private decimal hourlyRate = 1500m;
    private decimal extraSurcharges = 0m;
    private string overtimeNotes = string.Empty;
    private decimal baseRemainingBalance = 0m;
    private decimal totalSurcharges = 0m;
    private decimal finalDueAmount = 0m;
    private string selectedPaymentMethod = "Cash_OnHand";
    private bool isSubmittingSettlement = false;
    private string? finishModalError;

    private void OpenEventFinishModal(EventBookingModel ev)
    {
        selectedFinishEvent = ev;
        extraHours = 0m;
        hourlyRate = 1500m;
        extraSurcharges = 0m;
        overtimeNotes = string.Empty;
        var matchedTl = teamLeaderEvents.FirstOrDefault(t => string.Equals(t.EventAppointmentId, ev.Id, StringComparison.OrdinalIgnoreCase));
        baseRemainingBalance = matchedTl is { FinalBalanceAmount: > 0 } ? matchedTl.FinalBalanceAmount : Math.Round(ev.EstimatedPrice * 0.85m, 2);
        selectedPaymentMethod = "Cash_OnHand";
        finishModalError = null;
        RecalculateSettlement();
        isFinishModalOpen = true;
    }

    private void RecalculateSettlement()
    {
        totalSurcharges = Math.Round((extraHours * hourlyRate) + extraSurcharges, 2);
        finalDueAmount = baseRemainingBalance + totalSurcharges;
    }

    private async Task SubmitEventSettlementAsync()
    {
        if (selectedFinishEvent == null) return;
        isSubmittingSettlement = true;
        finishModalError = null;
        teamLeaderActionMessage = null;
        teamLeaderErrorMessage = null;

        try
        {
            var req = new CompleteEventRequest
            {
                EventAppointmentId = selectedFinishEvent.Id,
                ExtraHours = extraHours,
                HourlyRate = hourlyRate,
                SurchargeAmount = totalSurcharges,
                OvertimeNotes = overtimeNotes,
                PaymentMethod = selectedPaymentMethod,
                TeamLeaderEmployeeId = employeeId,
                Notes = $"Event settlement submitted by {employeeName} ({employeeId})."
            };

            var res = await ConsultationApi.CompleteEventAsync(selectedFinishEvent.Id, req);
            if (!res.IsSuccess || res.Value == null)
            {
                finishModalError = res.Error?.Message ?? "Failed to record final settlement. Please try again.";
                return;
            }

            ScheduleService.InvalidateCache();
            isFinishModalOpen = false;
            teamLeaderActionMessage = selectedPaymentMethod == "Xendit_QR"
                ? $"QR payment code generated (Status: Payment Verification (QR:Pending Payment)) and final payment email sent to {res.Value.CustomerEmail}."
                : $"Cash settlement of ₱{res.Value.FinalBalanceAmount:N2} logged. Status: Payment Verification (Cash).";

            await RefreshTeamLeaderEventsAsync();
            await SubscribeActiveQrHubAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            finishModalError = ex.Message;
        }
        finally
        {
            isSubmittingSettlement = false;
        }
    }

    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }

    private ClaimsPrincipal? currentUser;
    private bool isClerk;
    private bool isCreative;
    private string employeeName = string.Empty;
    private string employeeId = string.Empty;

    private int UpcomingShootsCount;
    private int CompletedThisWeekCount;
    private int GearCheckedOutCount;

    private List<EventBookingModel> displayedEvents = new();

    private ClockStatusViewModel clockStatus = new();
    private List<LeaveItemViewModel> myLeaves = new();
    private EmployeeLeaveBalanceSummaryViewModel leaveBalanceSummary = new()
    {
        TotalAllocatedPaidDays = 10.0m,
        TotalRemainingPaidDays = 10.0m,
        VacationLeaveRemaining = 5.0m,
        SickLeaveRemaining = 5.0m,
        DaysOff = "Sunday"
    };
    private bool isPunching = false;

    private bool isLeaveModalOpen = false;
    private bool isSubmittingLeave = false;
    private string? leaveError;
    private string newLeaveType = "Vacation Leave";
    private DateTime newLeaveStart = DateTime.Today;
    private DateTime newLeaveEnd = DateTime.Today;
    private bool newLeaveIsHalfDay = false;
    private string newLeaveAttachmentName = string.Empty;
    private string newLeaveReason = string.Empty;

    private bool IsOfficeClerkLeaveMode =>
        isClerk || LeaveWorkdayHelper.IsOfficeClerkEmployee(employeeId);

    private decimal SelectedPaidLeaveRemaining => newLeaveType switch
    {
        "Vacation Leave" => leaveBalanceSummary.VacationLeaveRemaining,
        "Sick Leave" => leaveBalanceSummary.SickLeaveRemaining,
        _ => 0m
    };

    private CountableWorkdaysPreviewViewModel CurrentModalWorkdaysPreview =>
        LeaveWorkdayHelper.CalculateCountableWorkdays(
            string.IsNullOrWhiteSpace(employeeId) ? "EMP-003" : employeeId,
            DateOnly.FromDateTime(newLeaveStart.Date),
            DateOnly.FromDateTime(newLeaveEnd.Date),
            newLeaveIsHalfDay,
            leaveBalanceSummary.DaysOff);

    private List<EventBookingModel> CurrentModalOverlappingEvents =>
        newLeaveEnd.Date < newLeaveStart.Date
            ? new List<EventBookingModel>()
            : displayedEvents
                .Where(ev => ev.Date.Date >= newLeaveStart.Date
                          && ev.Date.Date <= newLeaveEnd.Date
                          && !string.Equals(ev.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)
                          && (isCreative || EmployeeRoleHelper.IsEventAssignedToEmployee(ev, employeeName, employeeId)))
                .OrderBy(ev => ev.Date)
                .ToList();

    private void OpenLeaveModal()
    {
        leaveError = null;
        newLeaveType = IsOfficeClerkLeaveMode ? "Vacation Leave" : "Shoot Unavailability / Time Off";
        newLeaveIsHalfDay = false;
        newLeaveAttachmentName = string.Empty;
        isLeaveModalOpen = true;
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            currentUser = state.User;
        }

        isClerk = EmployeeRoleHelper.IsOfficeClerk(currentUser, UserService);
        isCreative = EmployeeRoleHelper.IsPhotographerOrCreative(currentUser, UserService);
        employeeId = EmployeeRoleHelper.GetCurrentEmployeeId(currentUser);
        employeeName = EmployeeRoleHelper.GetCurrentEmployeeName(currentUser, UserService);

        // Load all bookings from ScheduleService and UserService
        ScheduleService.InvalidateCache();
        LoadDisplayedEventsFromSchedule();

        await RefreshStatus();
    }

    private void LoadDisplayedEventsFromSchedule()
    {
        var scheduleBookings = ScheduleService.GetEventBookings();

        if (isCreative)
        {
            // Requirement 4: Overview: Only show confirmed/paid upcoming & ongoing events assigned to them
            displayedEvents = scheduleBookings
                .Where(b => EmployeeRoleHelper.IsEventAssignedToEmployee(b, employeeName, employeeId)
                            && !b.IsConsultation
                            && !b.IsPendingPayment
                            && !b.IsCompleted
                            && b.Date.Date >= DateTime.Today
                            && !string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)
                            && !string.Equals(b.Status, "Expired", StringComparison.OrdinalIgnoreCase))
                .OrderBy(b => b.Date)
                .ThenBy(b => b.StartTime)
                .ToList();

            UpcomingShootsCount = displayedEvents.Count;

            CompletedThisWeekCount = scheduleBookings.Count(b =>
                EmployeeRoleHelper.IsEventAssignedToEmployee(b, employeeName, employeeId) &&
                string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase) &&
                b.Date >= DateTime.Today.AddDays(-7));

            var reservations = ScheduleService.GetEquipmentReservations();
            GearCheckedOutCount = reservations.Count(r =>
                !string.IsNullOrWhiteSpace(employeeName) &&
                r.TechnicianInCharge.Contains(employeeName, StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            // Full access (Office Clerk / Admin)
            displayedEvents = scheduleBookings
                .Where(b => b.Date.Date >= DateTime.Today && !string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                .OrderBy(b => b.Date)
                .ThenBy(b => b.StartTime)
                .ToList();

            UpcomingShootsCount = displayedEvents.Count;

            CompletedThisWeekCount = scheduleBookings.Count(b =>
                string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase) &&
                b.Date >= DateTime.Today.AddDays(-7));

            GearCheckedOutCount = UserService.GetEquipmentRows().Count(e => !string.Equals(e.Status, "Available", StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        EquipmentService.OnChange += HandleEquipmentStateChanged;
        PaymentHub.OnEventStatusChanged += HandleHubEventStatusChangedAsync;
        await LoadStudioEquipmentsAsync();
        await RefreshTeamLeaderEventsInternalAsync(surfaceError: true);
        await SubscribeActiveQrHubAsync();
        _postEventAutoTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                await RefreshTeamLeaderEventsInternalAsync(surfaceError: false);
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        StateHasChanged();
    }

    private bool IsTeamLeaderForBooking(EventBookingModel ev)
    {
        if (ev == null || string.IsNullOrWhiteSpace(employeeId)) return false;
        if (ev.AssignedCrew != null && ev.AssignedCrew.Count > 0)
        {
            var leader = ev.AssignedCrew.FirstOrDefault(c => c.IsTeamLeader) ?? ev.AssignedCrew.FirstOrDefault();
            return leader != null && string.Equals(leader.EmployeeId?.Trim(), employeeId.Trim(), StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    private async Task LoadStudioEquipmentsAsync()
    {
        try
        {
            var list = await EquipmentService.GetEquipmentsAsync();
            _studioEquipments = list
                .Where(e => !string.Equals(e.EquipmentStatus, "Maintenance", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(e.EquipmentStatus, "Retired", StringComparison.OrdinalIgnoreCase))
                .ToList();

            var (bookings, reservations) = await Task.Run(() =>
                (ScheduleService.GetEventBookings(), ScheduleService.GetEquipmentReservations()));
            _staffBookings = bookings;
            _staffEquipmentReservations = reservations;
        }
        catch
        {
        }
    }

    private async Task RefreshStatus()
    {
        var targetEmpId = string.IsNullOrWhiteSpace(employeeId)
            ? (isClerk ? "EMP-003" : "EMP-002")
            : employeeId;

        var clockTask = Employees.GetClockStatusAsync();
        var leavesTask = Employees.GetMyLeavesAsync();
        var balanceTask = Employees.GetLeaveBalancesAsync(targetEmpId, 2026);
        var ledgerTask = SafeLoadEmployeeLedgerAsync();
        var tlTask = RefreshTeamLeaderEventsAsync();

        await Task.WhenAll(clockTask, leavesTask, balanceTask, ledgerTask, tlTask);

        clockStatus = await clockTask;
        myLeaves = (await leavesTask).ToList();
        var bal = await balanceTask;
        if (bal != null)
        {
            leaveBalanceSummary = bal;
            if (IsOfficeClerkLeaveMode && leaveBalanceSummary.Balances.Count == 0)
            {
                leaveBalanceSummary.IsTitleIExempt = false;
                leaveBalanceSummary.PayBasis = "FixedMonthly";
                leaveBalanceSummary.TotalAllocatedPaidDays = 10.0m;
                leaveBalanceSummary.VacationLeaveRemaining = 5.0m;
                leaveBalanceSummary.SickLeaveRemaining = 5.0m;
                leaveBalanceSummary.TotalRemainingPaidDays = 10.0m;
            }
        }
        if (!IsOfficeClerkLeaveMode && newLeaveType is "Sick Leave" or "Vacation Leave" or "Leave Without Pay")
        {
            newLeaveType = "Shoot Unavailability / Time Off";
        }
    }

    private Task RefreshTeamLeaderEventsAsync() => RefreshTeamLeaderEventsInternalAsync(surfaceError: false);

    private async Task RefreshTeamLeaderEventsInternalAsync(bool surfaceError)
    {
        try
        {
            var previousEvents = teamLeaderEvents.ToList();
            var tlRes = await ConsultationApi.GetTeamLeaderEventsAsync(employeeId);
            if (tlRes.IsSuccess && tlRes.Value != null)
            {
                if (surfaceError) teamLeaderErrorMessage = null;
                teamLeaderEvents = TeamLeaderMonitorSelector.SelectUpcomingAndOngoing(tlRes.Value).ToList();

                var finished = previousEvents.FirstOrDefault(prev =>
                    TeamLeaderMonitorSelector.IsOngoingOrInProcess(prev) &&
                    !teamLeaderEvents.Any(cur => string.Equals(cur.EventAppointmentId, prev.EventAppointmentId, StringComparison.OrdinalIgnoreCase)));
                if (finished != null)
                {
                    var latestRes = await ConsultationApi.GetAppointmentByIdAsync(finished.EventAppointmentId);
                    if (latestRes.IsSuccess && latestRes.Value != null && TeamLeaderMonitorSelector.IsCompletedOrInactive(latestRes.Value))
                    {
                        var d = latestRes.Value;
                        _recentlyCompletedTeamLeadEvent = new TeamLeaderEventDto
                        {
                            EventAppointmentId = d.EventAppointmentId,
                            CustomerId = d.CustomerId,
                            CustomerName = d.CustomerName,
                            CustomerEmail = d.CustomerEmail,
                            CustomerPhone = finished.CustomerPhone,
                            EventName = d.EventName,
                            EventDescription = d.EventDescription,
                            EventDate = d.EventDate,
                            EventTime = d.EventTime,
                            EventEndTime = d.EventEndTime,
                            DurationMinutes = d.DurationMinutes,
                            EventLocation = d.EventLocation,
                            EventStatus = d.EventStatus,
                            TotalAmount = d.TotalAmount,
                            DownpaymentAmount = d.DownpaymentAmount,
                            FinalBalanceAmount = d.FinalBalanceAmount,
                            DownpaymentStatus = d.DownpaymentStatus,
                            FinalPaymentMethod = d.FinalPaymentMethod,
                            FinalPaymentStatus = d.FinalPaymentStatus,
                            FinalPaymentReferenceId = d.FinalPaymentReferenceId,
                            FinalPaymentPaidAt = d.FinalPaymentPaidAt,
                            AssignedEmployees = d.AssignedEmployees,
                            AssignedEquipment = d.AssignedEquipment,
                            SelectedServices = d.SelectedServices,
                            IsTeamLeader = finished.IsTeamLeader
                        };
                        _selectedActiveTeamLeadEventId = d.EventAppointmentId;
                    }
                }
            }
            else if (surfaceError && !tlRes.IsSuccess)
            {
                teamLeaderErrorMessage = tlRes.Error?.Message ?? "Unable to load Team Leader monitor events.";
            }
        }
        catch (Exception ex)
        {
            if (surfaceError)
                teamLeaderErrorMessage = ex.Message;
        }
    }

    private async Task StartTeamLeaderEventIntoTopPillAsync(TeamLeaderEventDto tlEv)
    {
        if (!tlEv.IsTeamLeader) return;
        isUpdatingTeamLeaderStage = true;
        teamLeaderActionMessage = null;
        teamLeaderErrorMessage = null;
        try
        {
            var res = await ConsultationApi.UpdateTeamLeaderEventStatusAsync(tlEv.EventAppointmentId, new UpdateTeamLeaderStatusRequest
            {
                Status = "Preparation",
                EmployeeId = employeeId
            });
            if (res.IsSuccess && res.Value != null)
            {
                _selectedActiveTeamLeadEventId = tlEv.EventAppointmentId;
                ScheduleService.InvalidateCache();
                await Task.WhenAll(LoadStudioEquipmentsAsync(), RefreshTeamLeaderEventsAsync());
                teamLeaderActionMessage = $"Event #{tlEv.EventAppointmentId} started! Preparation & Equipment Dispatch opened at top of your overview.";
            }
            else
            {
                teamLeaderErrorMessage = res.Error?.Message ?? "Failed to start event preparation.";
            }
        }
        catch (Exception ex)
        {
            teamLeaderErrorMessage = ex.Message;
        }
        finally
        {
            isUpdatingTeamLeaderStage = false;
        }
    }

    private void FocusTeamLeaderTopPill(string appointmentId)
    {
        _selectedActiveTeamLeadEventId = appointmentId;
        teamLeaderActionMessage = $"Focused Event #{appointmentId} in the top overview pill box.";
    }

    private async Task HandleTeamLeadPillWorkflowUpdatedAsync()
    {
        await Task.WhenAll(LoadStudioEquipmentsAsync(), RefreshTeamLeaderEventsAsync(), SafeLoadEmployeeLedgerAsync());
        await SubscribeActiveQrHubAsync();
    }

    private Task HandleDismissCompletedTeamLeadAsync(string id)
    {
        if (_recentlyCompletedTeamLeadEvent != null &&
            string.Equals(_recentlyCompletedTeamLeadEvent.EventAppointmentId, id, StringComparison.OrdinalIgnoreCase))
        {
            _recentlyCompletedTeamLeadEvent = null;
        }
        if (string.Equals(_selectedActiveTeamLeadEventId, id, StringComparison.OrdinalIgnoreCase))
        {
            _selectedActiveTeamLeadEventId = null;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleHubEventStatusChangedAsync(EventStatusChangedMessage msg) => InvokeAsync(async () =>
    {
        ScheduleService.InvalidateCache();
        LoadDisplayedEventsFromSchedule();
        await Task.WhenAll(LoadStudioEquipmentsAsync(), RefreshTeamLeaderEventsAsync(), SafeLoadEmployeeLedgerAsync(), RefreshStatus());
        await SubscribeActiveQrHubAsync();
        if (string.Equals(msg.EventStatus, "Completed", StringComparison.OrdinalIgnoreCase))
        {
            teamLeaderActionMessage = $"Event #{msg.AppointmentId} updated to Success / Completed across all platforms.";
        }
        else if (string.Equals(msg.EventStatus, "RosterUpdated", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(msg.EventStatus, "Updated", StringComparison.OrdinalIgnoreCase))
        {
            teamLeaderActionMessage = msg.AppointmentId == "*"
                ? "Staff attendance / leave status updated."
                : $"Your crew / Team Leader assignment for #{msg.AppointmentId} has been updated.";
        }
        StateHasChanged();
    });

    private async Task SubscribeActiveQrHubAsync()
    {
        try
        {
            await PaymentHub.EnsureLiveMonitorStartedAsync();
            if (!string.IsNullOrWhiteSpace(employeeId))
            {
                await PaymentHub.EnsureStaffMonitorStartedAsync(employeeId);
            }
        }
        catch
        {
        }

        foreach (var ev in teamLeaderEvents)
        {
            var refId = ev.FinalPaymentReferenceId;
            if (string.IsNullOrWhiteSpace(refId) || _subscribedHubRefs.Contains(refId))
                continue;
            if (string.Equals(ev.FinalPaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase)
                || string.Equals(ev.FinalPaymentStatus, "Payment Verification (QR:Paid)", StringComparison.OrdinalIgnoreCase))
                continue;

            _subscribedHubRefs.Add(refId);
            try
            {
                await PaymentHub.JoinBookingGroupAsync(refId);
            }
            catch
            {
            }
        }
    }

    private static string FormatRegularEmployeeEventStatus(string? status) => (status ?? "Confirmed") switch
    {
        var s when s.Equals("Preparing", StringComparison.OrdinalIgnoreCase) || s.Equals("Preparation", StringComparison.OrdinalIgnoreCase) || s.Equals("Dispatch", StringComparison.OrdinalIgnoreCase) => "Preparing",
        var s when s.Equals("On Going", StringComparison.OrdinalIgnoreCase) || s.Equals("Ongoing", StringComparison.OrdinalIgnoreCase) => "Ongoing",
        var s when s.Equals("Post Event", StringComparison.OrdinalIgnoreCase) || s.Equals("Event Done", StringComparison.OrdinalIgnoreCase) => "Event Done",
        var s when s.Equals("Pending Verification", StringComparison.OrdinalIgnoreCase) || s.Equals("Paid Cash Pending Verification", StringComparison.OrdinalIgnoreCase) || s.Equals("Payment Verification (Cash)", StringComparison.OrdinalIgnoreCase) => "Payment Verification (Cash)",
        var s when s.Equals("Shot", StringComparison.OrdinalIgnoreCase) || s.Equals("Complete", StringComparison.OrdinalIgnoreCase) || s.Equals("Completed", StringComparison.OrdinalIgnoreCase) => "Completed",
        var s => s
    };

    private static string GetEventStatusPillClass(string? status)
    {
        var display = FormatRegularEmployeeEventStatus(status);
        return display switch
        {
            "Completed" or "Confirmed" => "bg-emerald-100 text-emerald-800",
            "Ongoing" => "bg-teal-100 text-teal-800",
            "Preparing" => "bg-sky-100 text-sky-800",
            "Event Done" => "bg-purple-100 text-purple-800",
            _ => "bg-amber-100 text-amber-800"
        };
    }

    private string ResolveQrConfirmUrl(string referenceId)
    {
        var configuredBase = Config["BaseUrl"]?.Trim();
        var effectiveBase = (!string.IsNullOrWhiteSpace(configuredBase) &&
                             !configuredBase.Contains("localhost", StringComparison.OrdinalIgnoreCase) &&
                             !configuredBase.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase))
            ? configuredBase
            : (Nav.BaseUri.Contains("localhost", StringComparison.OrdinalIgnoreCase) || Nav.BaseUri.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase)
                ? (string.IsNullOrWhiteSpace(configuredBase) ? Nav.BaseUri : configuredBase)
                : Nav.BaseUri);
        return QrPaymentLinks.BuildConfirmUrl(effectiveBase, Nav.BaseUri, referenceId);
    }

    private static string BuildQrSvg(string payload)
    {
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(payload, QRCodeGenerator.ECCLevel.M);
        return new SvgQRCode(data).GetGraphic(
            5,
            System.Drawing.Color.Black,
            System.Drawing.Color.White,
            drawQuietZones: true,
            sizingMode: SvgQRCode.SizingMode.ViewBoxAttribute);
    }

