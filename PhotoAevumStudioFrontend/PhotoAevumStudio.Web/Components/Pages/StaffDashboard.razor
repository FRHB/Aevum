@page "/staff"
@layout EmployeeLayout
@using PhotoAevumStudio.Web.Services
@using PhotoAevumStudio.Web.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using QRCoder
@implements IAsyncDisposable
@inject IUserService UserService
@inject IEmployeeService Employees
@inject IScheduleService ScheduleService
@inject IConsultationClient ConsultationApi
@inject AuthenticationStateProvider AuthStateProvider
@inject PaymentHubClient PaymentHub
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@attribute [Authorize(Roles = "Employee,Office Clerk,Admin,SystemAdmin")]
@rendermode InteractiveServer

<PageTitle>Staff Dashboard | Photo Aevum Studio</PageTitle>

@* ── Page header ─────────────────────────────────────────────────── *@
<header class="aev-page-header">
    <div>
        <h1 class="aev-page-header__title">
            @(isCreative ? "My Staff Dashboard" : "Studio Staff Overview")
        </h1>
        <p class="aev-page-header__subtitle">
            @DateTime.Today.ToString("dddd, MMMM d, yyyy") 
            @if (isCreative && !string.IsNullOrWhiteSpace(employeeName))
            {
                <span class="text-teal-700 font-medium">&bull; Welcome, @employeeName</span>
            }
            else if (isClerk)
            {
                <span class="text-indigo-700 font-medium">&bull; Office Clerk Portal</span>
            }
        </p>
    </div>
</header>

@* ── Live Clock In / Clock Out Time Tracker Card ─────────────────── *@
<section class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                @if (clockStatus.IsClockedIn)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                        ON DUTY
                    </span>
                    <span class="text-xs text-slate-500">Clocked in at @(clockStatus.ClockIn?.ToString("hh:mm tt") ?? "earlier today")</span>
                }
                else if (clockStatus.IsOnLeaveToday)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900">
                        🩺 ON APPROVED LEAVE (@clockStatus.ActiveLeaveType)
                    </span>
                }
                else if (clockStatus.IsDayOffToday)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-800 border border-blue-200">
                        🏖️ SCHEDULED DAY OFF
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                        ⚪ OFF DUTY
                    </span>
                }
            </div>
            <h2 class="text-xl font-extrabold text-slate-900">Attendance &amp; Time Tracker</h2>
            <p class="text-xs text-slate-500 mt-0.5">
                @if (clockStatus.IsClockedIn)
                {
                    <span>Current Shift Duration: <strong class="text-slate-800">@clockStatus.ElapsedHours.ToString("0.#") hours</strong> elapsed.</span>
                }
                else
                {
                    <span>Record your punch times for scheduled studio appointments and shift roster.</span>
                }
            </p>
        </div>

        <div class="flex items-center gap-3">
            @if (clockStatus.IsClockedIn)
            {
                <button type="button"
                        @onclick="HandleClockOut"
                        disabled="@isPunching"
                        class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm transition-all flex items-center gap-2">
                    <span>⏹</span>
                    <span>@(isPunching ? "Punching..." : "Clock Out")</span>
                </button>
            }
            else if (!clockStatus.IsOnLeaveToday)
            {
                <button type="button"
                        @onclick="HandleClockIn"
                        disabled="@isPunching"
                        class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm transition-all flex items-center gap-2">
                    <span>▶</span>
                    <span>@(isPunching ? "Punching..." : "Clock In")</span>
                </button>
            }
        </div>
    </div>
</section>

@* ── Stat cards ───────────────────────────────────────────────────── *@
<section class="aev-stat-grid" aria-label="My summary">
    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--teal" aria-hidden="true">📅</div>
        <div>
            <p class="aev-stat-card__label">@(isCreative ? "My Upcoming Shoots" : "Upcoming Shoots")</p>
            <h2 class="aev-stat-card__value">@UpcomingShootsCount</h2>
        </div>
    </article>
    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--blue" aria-hidden="true">✓</div>
        <div>
            <p class="aev-stat-card__label">@(isCreative ? "My Completed (Week)" : "Completed (Week)")</p>
            <h2 class="aev-stat-card__value">@CompletedThisWeekCount</h2>
        </div>
    </article>
    <article class="aev-stat-card">
        <div class="aev-stat-card__icon aev-stat-card__icon--amber" aria-hidden="true">📷</div>
        <div>
            <p class="aev-stat-card__label">@(isCreative ? "Assigned Equipment" : "Gear Checked Out")</p>
            <h2 class="aev-stat-card__value">@GearCheckedOutCount</h2>
        </div>
    </article>
</section>

@* ── TEAM LEADER ONGOING EVENT WORKFLOW ───────────────────────────── *@
@if (teamLeaderEvents.Any())
{
    <section class="bg-white rounded-xl border border-teal-200 shadow-sm p-6 mb-6" aria-label="Team Leader Ongoing Events">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-3 border-b border-slate-100 mb-4">
            <div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-teal-100 text-teal-800 mb-1">
                    Team Leader Control
                </span>
                <h2 class="text-base font-extrabold text-slate-900">Ongoing Event Workflow &amp; Final Payment</h2>
                <p class="text-xs text-slate-500">Track event progress (Preparing &rarr; On Going &rarr; Post Event &rarr; Pending Payment) and collect Cash or QR settlement.</p>
            </div>
            <button type="button" @onclick="RefreshTeamLeaderEventsAsync" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-xs font-semibold text-slate-700">
                Refresh Status
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(teamLeaderActionMessage))
        {
            <div class="mb-4 px-3.5 py-2.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold">
                @teamLeaderActionMessage
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(teamLeaderErrorMessage))
        {
            <div class="mb-4 px-3.5 py-2.5 rounded-lg bg-red-50 border border-red-200 text-red-700 text-xs font-semibold">
                @teamLeaderErrorMessage
            </div>
        }

        <div class="space-y-4">
            @foreach (var tlEv in teamLeaderEvents)
            {
                var isCashPendingVerif = string.Equals(tlEv.EventStatus, "Pending Verification", StringComparison.OrdinalIgnoreCase)
                                         || string.Equals(tlEv.FinalPaymentStatus, "Pending Verification", StringComparison.OrdinalIgnoreCase);
                var isFinalPaid = string.Equals(tlEv.FinalPaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase)
                                  || string.Equals(tlEv.EventStatus, "Shot", StringComparison.OrdinalIgnoreCase);
                var isQrPending = !isFinalPaid && !isCashPendingVerif
                                  && string.Equals(tlEv.FinalPaymentMethod, "Xendit_QR", StringComparison.OrdinalIgnoreCase)
                                  && !string.IsNullOrWhiteSpace(tlEv.FinalPaymentReferenceId);
                var finalRefId = string.IsNullOrWhiteSpace(tlEv.FinalPaymentReferenceId) ? $"{tlEv.EventAppointmentId}-FINAL" : tlEv.FinalPaymentReferenceId;

                <article class="rounded-xl border @(isFinalPaid ? "border-emerald-200 bg-emerald-50/30" : isCashPendingVerif ? "border-amber-200 bg-amber-50/30" : "border-slate-200 bg-slate-50/60") p-5 space-y-4">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-mono text-[11px] font-bold px-2 py-0.5 rounded bg-slate-900 text-white">#@tlEv.EventAppointmentId</span>
                                <h3 class="text-sm font-extrabold text-slate-900">@tlEv.EventName</h3>
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold @GetTeamLeaderStatusBadgeClass(tlEv)">
                                    @(isFinalPaid ? "Paid (Shot)" : tlEv.EventStatus)
                                </span>
                            </div>
                            <div class="text-xs text-slate-600 mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
                                <span>Client: <strong class="text-slate-800">@tlEv.CustomerName</strong> @(!string.IsNullOrWhiteSpace(tlEv.CustomerEmail) ? $"({tlEv.CustomerEmail})" : "")</span>
                                <span>Schedule: <strong>@tlEv.EventDate.ToString("MMM dd, yyyy")</strong> at @DateTime.Today.Add(tlEv.EventTime.ToTimeSpan()).ToString("h:mm tt")</span>
                                <span>Final Balance Due: <strong class="text-slate-900 font-mono">₱@tlEv.FinalBalanceAmount.ToString("N2")</strong></span>
                            </div>
                        </div>
                    </div>

                    @if (!isCashPendingVerif && !isFinalPaid)
                    {
                        <div>
                            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Ongoing Event Status</div>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                                @foreach (var stage in TeamLeaderStages)
                                {
                                    var isActive = string.Equals(tlEv.EventStatus, stage, StringComparison.OrdinalIgnoreCase);
                                    var btnClass = isActive
                                        ? "bg-teal-700 text-white border-teal-700 shadow-xs"
                                        : "bg-white text-slate-700 border-slate-200 hover:border-teal-400 hover:bg-teal-50/50";
                                    <button type="button"
                                            disabled="@isUpdatingTeamLeaderStage"
                                            @onclick="() => HandleTeamLeaderStageClickAsync(tlEv, stage)"
                                            class="px-3 py-2 rounded-lg border text-xs font-bold transition-all text-center @btnClass">
                                        @stage
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (isCashPendingVerif)
                    {
                        <div class="p-4 rounded-xl border border-amber-300 bg-amber-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                            <div>
                                <div class="text-xs font-extrabold text-amber-950">Pending Verification (Cash Settlement Logged)</div>
                                <p class="text-[11px] text-amber-900 mt-0.5">
                                    Cash payment of <strong>₱@tlEv.FinalBalanceAmount.ToString("N2")</strong> was recorded on-site. Status will clear once Admin verifies remittance.
                                </p>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-amber-200 text-amber-950 text-xs font-extrabold shrink-0">Pending Verification</span>
                        </div>
                    }
                    else if (isQrPending)
                    {
                        var confirmUrl = ResolveQrConfirmUrl(finalRefId);
                        var isMock = string.IsNullOrWhiteSpace(tlEv.FinalQrString)
                                     || tlEv.FinalQrString.StartsWith("MOCK-QRPH", StringComparison.Ordinal)
                                     || tlEv.FinalQrString.Contains("/checkout/confirm/", StringComparison.OrdinalIgnoreCase);
                        <div class="p-4 rounded-xl border border-teal-200 bg-white grid grid-cols-1 md:grid-cols-[160px_1fr] gap-4 items-center">
                            <div class="w-40 h-40 mx-auto p-2 bg-white border border-slate-200 rounded-xl shadow-xs" aria-label="Team Leader Final Payment QR Code">
                                @((MarkupString)BuildQrSvg(confirmUrl))
                            </div>
                            <div class="space-y-2 text-xs">
                                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-900 font-bold text-[11px]">
                                    QR Payment Generated &amp; Customer Emailed
                                </div>
                                <div class="font-bold text-slate-900 text-sm">Awaiting Customer Final Balance Scan (₱@tlEv.FinalBalanceAmount.ToString("N2"))</div>
                                <p class="text-slate-600">
                                    A final payment request email was sent to <strong>@(string.IsNullOrWhiteSpace(tlEv.CustomerEmail) ? "the customer" : tlEv.CustomerEmail)</strong> (Ref: <span class="font-mono">@finalRefId</span>). Once paid, you will be notified automatically via email.
                                </p>
                                <div class="flex flex-wrap items-center gap-2 pt-1">
                                    <a href="/payments/@finalRefId" target="_blank" class="px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-800 font-bold">
                                        Open Payment Page ↗
                                    </a>
                                    @if (Env.IsDevelopment() || isMock)
                                    {
                                        <button type="button"
                                                disabled="@isUpdatingTeamLeaderStage"
                                                @onclick="() => SimulateTeamLeaderQrPaidAsync(finalRefId)"
                                                class="px-3 py-1.5 rounded-lg border border-dashed border-teal-600 text-teal-800 hover:bg-teal-50 font-bold">
                                            Simulate Customer QR Paid (Dev)
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else if (isFinalPaid)
                    {
                        <div class="p-4 rounded-xl border border-emerald-300 bg-emerald-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                            <div>
                                <div class="text-xs font-extrabold text-emerald-950">Final Payment Settled &amp; Paid</div>
                                <p class="text-[11px] text-emerald-900 mt-0.5">
                                    Final balance of <strong>₱@tlEv.FinalBalanceAmount.ToString("N2")</strong> via @(tlEv.FinalPaymentMethod == "Xendit_QR" ? "QR Payment" : "Cash") is verified. Team Leader notification sent.
                                </p>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-emerald-200 text-emerald-950 text-xs font-extrabold shrink-0">Paid</span>
                        </div>
                    }
                    else if (string.Equals(tlEv.EventStatus, "Pending Payment", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="p-3.5 rounded-xl border border-amber-200 bg-white flex flex-wrap items-center justify-between gap-2">
                            <span class="text-xs font-semibold text-slate-700">Choose how the customer will settle the remaining balance:</span>
                            <div class="flex items-center gap-2">
                                <button type="button"
                                        @onclick='() => OpenTeamLeaderSettlementModal(tlEv, "Cash_OnHand")'
                                        class="px-3.5 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold">
                                    💵 Cash Payment
                                </button>
                                <button type="button"
                                        @onclick='() => OpenTeamLeaderSettlementModal(tlEv, "Xendit_QR")'
                                        class="px-3.5 py-1.5 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold">
                                    📱 QR Payment (Email &amp; Generate QR)
                                </button>
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
    </section>
}

@* ── UPCOMING EVENTS ASSIGNED TO ME (For Photographer/Editor/Videographer & Staff) ── *@
<section class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-3 border-b border-slate-100 mb-4">
        <div>
            <h2 class="text-base font-bold text-slate-900">
                @(isCreative ? "Upcoming Events Assigned to You" : "Upcoming Studio Events & Shoots")
            </h2>
            <p class="text-xs text-slate-500">
                @(isCreative 
                    ? "Schedule of production sessions, photography calls, and shoot assignments designated specifically for your roster."
                    : "Studio-wide events and scheduled client production sessions.")
            </p>
        </div>
        <a href="/staff/calendar/master" class="text-xs font-semibold text-slate-800 hover:text-black hover:underline flex items-center gap-1">
            <span>View Full Calendar &rarr;</span>
        </a>
    </div>

    @if (!displayedEvents.Any())
    {
        <div class="py-10 text-center">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-2 text-xl">
                📷
            </div>
            <h3 class="text-sm font-bold text-slate-800">
                @(isCreative ? "No Upcoming Events Assigned to You" : "No Upcoming Events Scheduled")
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">
                @(isCreative ? "You have no upcoming shoot assignments at this time. Check back later or check with the Office Clerk." : "All upcoming sessions have concluded or none are booked.")
            </p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="text-slate-500 border-b border-slate-100">
                        <th class="py-2.5 font-semibold">Date &amp; Time</th>
                        <th class="py-2.5 font-semibold">Client / Production</th>
                        <th class="py-2.5 font-semibold">Service</th>
                        <th class="py-2.5 font-semibold">Location / Space</th>
                        @if (!isCreative)
                        {
                            <th class="py-2.5 font-semibold">Assigned Crew</th>
                        }
                        <th class="py-2.5 font-semibold text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var ev in displayedEvents)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="py-3 font-mono font-bold text-slate-800">
                                <div>@ev.Date.ToString("ddd, MMM d")</div>
                                <div class="text-[11px] font-normal text-slate-500">@ev.FormattedTimeRange</div>
                            </td>
                            <td class="py-3">
                                <div class="font-bold text-slate-900">@ev.ClientName</div>
                                @if (!string.IsNullOrWhiteSpace(ev.ClientEmail))
                                {
                                    <div class="text-[11px] text-slate-400">@ev.ClientEmail</div>
                                }
                            </td>
                            <td class="py-3">
                                <span class="px-2 py-0.5 rounded font-medium bg-slate-100 text-slate-700">@ev.ServiceType</span>
                            </td>
                            <td class="py-3 text-slate-600">
                                <span>@(!string.IsNullOrWhiteSpace(ev.StudioSpaceName) ? ev.StudioSpaceName : "Main Studio")</span>
                            </td>
                            @if (!isCreative)
                            {
                                <td class="py-3 font-medium text-slate-700">
                                    📷 @ev.AssignedPhotographer
                                </td>
                            }
                            <td class="py-3 text-right">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold @(ev.Status == "Confirmed" ? "bg-emerald-100 text-emerald-800" : (ev.Status == "Completed" ? "bg-slate-100 text-slate-700" : "bg-amber-100 text-amber-800"))">
                                    @ev.Status
                                </span>
                                @if (ev.Status != "Completed")
                                {
                                    <button type="button"
                                            @onclick="() => OpenEventFinishModal(ev)"
                                            class="ml-2 px-2.5 py-1 bg-slate-900 hover:bg-black text-white text-[11px] font-bold rounded-md shadow-xs transition-all">
                                        Event Finish &rarr;
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@* ── Navigation cards ─────────────────────────────────────────────── *@
<div class="aev-content-row aev-content-row--wrap">

    <a href="/staff/assignments" class="aev-nav-card">
        <span class="aev-nav-card__icon" aria-hidden="true">🎬</span>
        <h2 class="aev-nav-card__title">My Assignments</h2>
        <p class="aev-nav-card__desc">View upcoming shoots, call times, and shot lists.</p>
    </a>

    <a href="/staff/pipeline" class="aev-nav-card">
        <span class="aev-nav-card__icon" aria-hidden="true">🔄</span>
        <h2 class="aev-nav-card__title">Delivery Pipeline</h2>
        <p class="aev-nav-card__desc">Track post-processing: Culling, Editing, Uploading.</p>
    </a>

    <a href="/staff/gear" class="aev-nav-card">
        <span class="aev-nav-card__icon" aria-hidden="true">📷</span>
        <h2 class="aev-nav-card__title">Gear Checklist</h2>
        <p class="aev-nav-card__desc">Check out / return equipment and file damage reports.</p>
    </a>

</div>

@* ── Cash Collections & Remittance Ledger ───────────────────────────── *@
<section class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mt-6">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
        <div>
            <h2 class="text-base font-bold text-slate-900">💵 Cash Collections &amp; Remittance Ledger</h2>
            <p class="text-xs text-slate-500">Track on-site cash payments received from customers and pending admin verification.</p>
        </div>
        <span class="text-xs font-semibold px-2.5 py-1 bg-amber-50 text-amber-800 border border-amber-200 rounded-lg">
            @(myCashRemittances.Count(r => r.EmployeeRemittanceStatus == "PendingAdminApproval")) Pending Clearance
        </span>
    </div>

    @if (!myCashRemittances.Any())
    {
        <div class="p-6 text-center text-xs text-slate-400 bg-slate-50 rounded-lg border border-dashed border-slate-200">
            No on-site cash collections recorded yet.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-xs text-left">
                <thead class="text-slate-400 uppercase font-semibold text-[10px] border-b">
                    <tr>
                        <th class="py-2 px-3">Date</th>
                        <th class="py-2 px-3">Booking / Event</th>
                        <th class="py-2 px-3">Amount Collected</th>
                        <th class="py-2 px-3">Customer View</th>
                        <th class="py-2 px-3">Employee Remittance State</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var rem in myCashRemittances)
                    {
                        <tr>
                            <td class="py-2.5 px-3 text-slate-600">@rem.CreatedAt.ToLocalTime().ToString("MMM d, yyyy • h:mm tt")</td>
                            <td class="py-2.5 px-3 font-semibold text-slate-800">@(rem.EventAppointmentId ?? $"#{rem.BookingId}")</td>
                            <td class="py-2.5 px-3 font-bold text-slate-900">₱@rem.Amount.ToString("N2")</td>
                            <td class="py-2.5 px-3">
                                <span class="bg-green-100 text-green-800 px-2 py-0.5 rounded-full font-bold text-[10px]">
                                    Cleared (Confirmed)
                                </span>
                            </td>
                            <td class="py-2.5 px-3">
                                @if (rem.EmployeeRemittanceStatus == "Cleared")
                                {
                                    <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded-full font-bold text-[10px]">
                                        ✓ Cleared &amp; Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 border border-amber-300 px-2.5 py-0.5 rounded-full font-bold text-[10px]">
                                        ⏳ Pending Admin Clearance
                                    </span>
