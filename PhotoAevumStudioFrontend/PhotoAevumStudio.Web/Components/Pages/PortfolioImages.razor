@page "/admin/portfolio/images"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, SystemAdmin, Super Admin, Office Clerk")]
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@inject IPortfolioService PortfolioService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Portfolio Images &amp; Albums | Photo Aevum Studio</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                <span>Portfolio</span>
                <span>/</span>
                <span class="text-slate-900 font-bold">Portfolio Images</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Portfolio Albums &amp; Imagery</h1>
            <p class="text-sm text-slate-500 mt-0.5">Manage portfolio folders, highlight photography, and showcase feature toggles.</p>
        </div>

        @if (!_isReadOnly)
        {
            <button type="button"
                    @onclick="OpenAddWizard"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-slate-900 hover:bg-black text-white text-xs font-semibold uppercase tracking-wider rounded-lg shadow-sm transition-all focus:ring-2 focus:ring-slate-900 focus:ring-offset-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                Add New Portfolio
            </button>
        }
    </div>

    <!-- Notification Toast -->
    @if (!string.IsNullOrWhiteSpace(_notification))
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center justify-between text-xs text-emerald-800 shadow-sm animate-in fade-in duration-200">
            <div class="flex items-center gap-2.5">
                <span class="text-base">✓</span>
                <span>@_notification</span>
            </div>
            <button type="button" @onclick="() => _notification = null" class="text-emerald-600 hover:text-emerald-900">✕</button>
        </div>
    }

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-800 text-lg font-bold">🗂️</div>
            <div>
                <p class="text-xs text-slate-500 font-medium">Total Portfolios</p>
                <p class="text-xl font-bold text-slate-900">@_portfolios.Count</p>
            </div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center text-amber-600 text-lg font-bold">★</div>
            <div>
                <p class="text-xs text-slate-500 font-medium">Featured Showcases</p>
                <p class="text-xl font-bold text-slate-900">@_portfolios.Count(p => p.IsFeatured)</p>
            </div>
        </div>
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600 text-lg font-bold">📸</div>
            <div>
                <p class="text-xs text-slate-500 font-medium">Total Images</p>
                <p class="text-xl font-bold text-slate-900">@_portfolios.Sum(p => p.Images?.Count ?? 0)</p>
            </div>
        </div>
    </div>

    <!-- Category Filters and Search Toolbar -->
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    @onclick='() => _selectedCategory = "All"'
                    class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors @(_selectedCategory == "All" ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                All (@_portfolios.Count)
            </button>
            @foreach (var cat in _categories)
            {
                var count = _portfolios.Count(p => string.Equals(p.CategoryID, cat.CategoryID, StringComparison.OrdinalIgnoreCase));
                <button type="button"
                        @onclick="() => _selectedCategory = cat.CategoryID"
                        class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors @(_selectedCategory == cat.CategoryID ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                    @cat.CategoryName (@count)
                </button>
            }
        </div>

        <div class="relative w-full md:w-72">
            <input type="text"
                   @bind="_searchQuery"
                   @bind:event="oninput"
                   placeholder="Search portfolio name..."
                   class="w-full pl-9 pr-4 py-2 text-xs rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-slate-900 focus:border-slate-900" />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
    </div>

    <!-- Portfolio Cards Grid -->
    @if (_isLoading)
    {
        <div class="p-16 text-center text-slate-400 text-xs">
            <span class="inline-block w-6 h-6 border-2 border-slate-400/30 border-t-slate-900 rounded-full animate-spin mb-2"></span>
            <p>Loading portfolio folders...</p>
        </div>
    }
    else if (FilteredPortfolios.Count == 0)
    {
        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-2xl">🖼️</div>
            <h3 class="text-sm font-bold text-slate-900">No Portfolio Folders Found</h3>
            <p class="text-xs text-slate-500 mt-1">Get started by clicking "+ Add New Portfolio" above.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var port in FilteredPortfolios)
            {
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all overflow-hidden flex flex-col group">
                    <!-- Top Highlight Image Container -->
                    <div class="relative h-56 bg-slate-900 overflow-hidden cursor-pointer" @onclick="() => OpenDetailsPanel(port)">
                        <img src="@port.HighlightImageUrl"
                             alt="@port.PortfolioName"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                             onerror="this.src='images/AevumLogo.jpg';" />

                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-black/30"></div>

                        <!-- Top Legend Badge: Featured -->
                        <div class="absolute top-3 left-3 flex items-center gap-1.5">
                            @if (port.IsFeatured)
                            {
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-400 text-slate-950 shadow-md">
                                    ★ Featured
                                </span>
                            }
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-black/60 backdrop-blur-sm text-white">
                                @port.CategoryName
                            </span>
                        </div>

                        <!-- Images Count Pill -->
                        <div class="absolute top-3 right-3">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-black/60 backdrop-blur-sm text-white">
                                📷 @port.Images.Count
                            </span>
                        </div>

                        <!-- Bottom Title Overlay -->
                        <div class="absolute bottom-3 left-3 right-3 text-white">
                            <h3 class="font-bold text-base tracking-tight leading-tight drop-shadow-sm">@port.PortfolioName</h3>
                            <p class="text-[11px] text-amber-300 font-mono font-bold mt-0.5">@port.PortfolioId</p>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-4 flex-1 flex flex-col justify-between space-y-4">
                        <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(port.PortfolioDescription) ? "No description provided for this portfolio album." : port.PortfolioDescription)
                        </p>

                        <!-- Bottom Controls: Toggle Switch & Actions -->
                        <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <label class="relative inline-flex items-center cursor-pointer select-none">
                                    <input type="checkbox"
                                           checked="@port.IsFeatured"
                                           @onchange="() => HandleToggleFeature(port)"
                                           class="sr-only peer"
                                           disabled="@_isReadOnly" />
                                    <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-amber-500"></div>
                                    <span class="ml-2 text-xs font-semibold @(port.IsFeatured ? "text-amber-700 font-bold" : "text-slate-500")">
                                        @(port.IsFeatured ? "Featured" : "Regular")
                                    </span>
                                </label>
                            </div>

                            <div class="flex items-center gap-2">
                                <button type="button"
                                        @onclick="() => OpenDetailsPanel(port)"
                                        class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors"
                                        title="View portfolio details">
                                    👁️
                                </button>
                                @if (!_isReadOnly)
                                {
                                    <button type="button"
                                            @onclick="() => OpenEditWizard(port)"
                                            class="p-1.5 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors"
                                            title="Edit portfolio in wizard">
                                        ✏️
                                    </button>
                                    <button type="button"
                                            @onclick="() => HandleDeletePortfolio(port)"
                                            class="p-1.5 rounded-lg text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition-colors"
                                            title="Delete portfolio folder">
                                        🗑️
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ════════════════════════════════════════════════════════════════════════ -->
<!-- FLOATING PANEL / DETAILS & EDIT DRAWER MODAL                            -->
<!-- ════════════════════════════════════════════════════════════════════════ -->
@if (_activeDetailPortfolio != null)
{
    <div class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-4xl overflow-hidden flex flex-col max-h-[92vh]">
            <!-- Drawer Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/75">
                <div class="flex items-center gap-3">
                    <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-slate-900 text-white">
                        @_activeDetailPortfolio.PortfolioId
                    </span>
                    <div>
                        <h3 class="font-bold text-base text-slate-900 leading-tight">
                            @_activeDetailPortfolio.PortfolioName
                        </h3>
                        <p class="text-xs text-slate-500">
                            @_activeDetailPortfolio.CategoryName &bull; @_activeDetailPortfolio.Images.Count photo(s) &bull; Added @_activeDetailPortfolio.CreatedAt.ToString("MMM d, yyyy")
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    @if (!_isReadOnly)
                    {
                        <button type="button"
                                @onclick="() => { var p = _activeDetailPortfolio; CloseDetailsPanel(); OpenEditWizard(p); }"
                                class="px-3.5 py-1.5 text-xs font-semibold bg-slate-900 hover:bg-black text-white rounded-lg shadow-sm transition-all flex items-center gap-1.5">
                            <span>✏️ Edit Album</span>
                        </button>
                    }
                    <button type="button" @onclick="CloseDetailsPanel" class="text-slate-400 hover:text-slate-700 text-xl font-bold ml-2">✕</button>
                </div>
            </div>

            <!-- Drawer Body -->
            <div class="p-6 overflow-y-auto flex-1 space-y-6">
                <!-- METADATA OVERVIEW -->
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs">
                    <div class="space-y-1">
                        <span class="font-bold text-slate-900 block text-sm">@_activeDetailPortfolio.PortfolioName</span>
                        <p class="text-slate-600">
                            @(string.IsNullOrWhiteSpace(_activeDetailPortfolio.PortfolioDescription) ? "No description provided." : _activeDetailPortfolio.PortfolioDescription)
                        </p>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                        <label class="relative inline-flex items-center cursor-pointer select-none">
                            <input type="checkbox"
                                   checked="@_activeDetailPortfolio.IsFeatured"
                                   @onchange="() => HandleToggleFeature(_activeDetailPortfolio)"
                                   class="sr-only peer"
                                   disabled="@_isReadOnly" />
                            <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-amber-500"></div>
                            <span class="ml-2 text-xs font-semibold @(_activeDetailPortfolio.IsFeatured ? "text-amber-700 font-bold" : "text-slate-500")">
                                @(_activeDetailPortfolio.IsFeatured ? "Featured" : "Regular")
                            </span>
                        </label>
                    </div>
                </div>

                <!-- PHOTO GALLERY GRID -->
                <div>
                    <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500 mb-3">Album Photographs (@_activeDetailPortfolio.Images.Count)</h4>
                    @if (_activeDetailPortfolio.Images.Count == 0)
                    {
                        <p class="text-slate-400 text-xs py-6 text-center">No images currently uploaded for this portfolio.</p>
                    }
                    else
                    {
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                            @foreach (var img in _activeDetailPortfolio.Images)
                            {
                                <div class="group relative rounded-xl overflow-hidden border border-slate-200 aspect-square bg-slate-100 shadow-sm cursor-pointer"
                                     @onclick="() => _lightboxImageUrl = img.Url">
                                    <img src="@img.Url" alt="Photo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" />
                                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold">
                                        View Full
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Lightbox Popup -->
@if (!string.IsNullOrEmpty(_lightboxImageUrl))
{
    <div class="fixed inset-0 z-60 bg-black/90 backdrop-blur-md flex items-center justify-center p-4" @onclick="() => _lightboxImageUrl = null">
        <div class="relative max-w-5xl max-h-[90vh]">
            <img src="@_lightboxImageUrl" alt="Full photo" class="max-w-full max-h-[85vh] rounded-xl object-contain shadow-2xl" />
            <button type="button" @onclick="() => _lightboxImageUrl = null" class="absolute -top-10 right-0 text-white font-bold text-xl hover:text-slate-300">✕ Close</button>
        </div>
    </div>
}

<!-- ════════════════════════════════════════════════════════════════════════ -->
<!-- MODAL: 3-STEP ADD NEW PORTFOLIO WIZARD                                 -->
<!-- ════════════════════════════════════════════════════════════════════════ -->
@if (_isWizardOpen)
{
    <div class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Wizard Header -->
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 class="text-base font-bold text-slate-900">@(_isEditingPortfolio ? "Edit Portfolio Folder" : "Add New Portfolio Folder")</h2>
                    <p class="text-xs text-slate-500">Step @_wizardStep of 3 &bull; @_wizardStepTitles[_wizardStep - 1]</p>
                </div>
                <button type="button" @onclick="() => _isWizardOpen = false" class="text-slate-400 hover:text-slate-700 text-lg">✕</button>
            </div>

            <!-- Stepper Progress Bar -->
            <div class="px-6 py-3 bg-white border-b border-slate-100">
                <div class="flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold @(_wizardStep >= 1 ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-400")">1</span>
                        <span class="font-medium @(_wizardStep == 1 ? "text-slate-900 font-bold" : "text-slate-500")">Details</span>
                    </div>
                    <div class="flex-1 h-0.5 mx-3 @(_wizardStep > 1 ? "bg-slate-900" : "bg-slate-200")"></div>
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold @(_wizardStep >= 2 ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-400")">2</span>
                        <span class="font-medium @(_wizardStep == 2 ? "text-slate-900 font-bold" : "text-slate-500")">Choose Images</span>
                    </div>
                    <div class="flex-1 h-0.5 mx-3 @(_wizardStep > 2 ? "bg-slate-900" : "bg-slate-200")"></div>
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold @(_wizardStep == 3 ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-400")">3</span>
                        <span class="font-medium @(_wizardStep == 3 ? "text-slate-900 font-bold" : "text-slate-500")">Overview &amp; Save</span>
                    </div>
                </div>
            </div>

            <!-- Wizard Content -->
            <div class="p-6 overflow-y-auto flex-1">
                @if (!string.IsNullOrEmpty(_wizardError))
                {
                    <div class="p-3 mb-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-xs font-medium">@_wizardError</div>
                }

                @* ── PAGE 1: DETAILS ───────────────────────────────────────────── *@
                @if (_wizardStep == 1)
                {
                    <div class="space-y-4 text-xs">
                        @if (_isEditingPortfolio && !string.IsNullOrWhiteSpace(_editingPortfolioId))
                        {
                            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Portfolio ID (System-Assigned)</span>
                                    <p class="font-mono text-sm font-bold text-slate-900">@_editingPortfolioId</p>
                                </div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                    Strictly Read-Only
                                </span>
                            </div>
                        }

                        <div>
                            <label class="block font-semibold uppercase tracking-wider text-slate-700 mb-1.5">Portfolio Name <span class="text-rose-500">*</span></label>
                            <input type="text" @bind="_newPortfolioName" placeholder="e.g. Celestial Golden Hour Editorial" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-xs focus:ring-1 focus:ring-slate-900 focus:outline-none" />
                        </div>

                        <div>
                            <label class="block font-semibold uppercase tracking-wider text-slate-700 mb-1.5">Portfolio Category <span class="text-rose-500">*</span></label>
                            <select @bind="_newPortfolioCategory" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-xs bg-white focus:ring-1 focus:ring-slate-900 focus:outline-none">
                                <option value="">-- Select a Category --</option>
                                @foreach (var c in _categories)
                                {
                                    <option value="@c.CategoryID">@c.CategoryName (@c.CategoryID)</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block font-semibold uppercase tracking-wider text-slate-700 mb-1.5">Portfolio Description <span class="text-slate-400 font-normal lowercase">(optional)</span></label>
                            <textarea @bind="_newPortfolioDesc" rows="4" placeholder="Describe the shoot concept, artisan lighting techniques, and aesthetic vision..." class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-xs focus:ring-1 focus:ring-slate-900 focus:outline-none resize-none"></textarea>
                        </div>

                        <div class="pt-2">
                            <label class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" @bind="_newPortfolioIsFeatured" class="rounded border-slate-300 text-slate-900 focus:ring-slate-900 w-4 h-4" />
                                <span class="font-semibold text-slate-800">Feature this portfolio immediately on public showcase</span>
                            </label>
                        </div>
                    </div>
                }

                @* ── PAGE 2: CHOOSE IMAGES (MULTIPLE) ────────────────────────── *@
                @if (_wizardStep == 2)
                {
                    <div class="space-y-4 text-xs">
                        @if (_isEditingPortfolio && _existingImages.Count > 0)
                        {
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-bold text-slate-900">Current Album Photos (@_existingImages.Count)</span>
                                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200">Existing Media</span>
                                </div>
                                <div class="grid grid-cols-3 sm:grid-cols-4 gap-3 max-h-48 overflow-y-auto p-1 mb-3 border border-slate-200 rounded-xl bg-slate-50/50">
                                    @for (int i = 0; i < _existingImages.Count; i++)
                                    {
                                        var img = _existingImages[i];
                                        <div class="relative group rounded-lg overflow-hidden border border-slate-200 bg-slate-100 aspect-square">
                                            <img src="@img.Url" alt="Existing photo" class="w-full h-full object-cover" />
                                            @if (i == 0)
                                            {
                                                <span class="absolute bottom-1 left-1 bg-black/70 text-white text-[9px] font-bold px-1.5 py-0.5 rounded">
                                                    Highlight
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div>
                            <label class="block font-semibold uppercase tracking-wider text-slate-700 mb-1.5">@(_isEditingPortfolio ? "Upload Additional Images" : "Upload Images *")</label>
                            <div class="border-2 border-dashed border-slate-300 rounded-xl p-6 text-center hover:border-slate-500 transition-colors bg-slate-50/50">
                                <InputFile OnChange="HandleFileSelection" multiple accept="image/*" class="hidden" id="multi-file-input" />
                                <label for="multi-file-input" class="cursor-pointer block">
                                    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-2 text-xl text-slate-600">📁</div>
                                    <span class="text-xs font-bold text-slate-900 hover:underline">Click to browse multiple photos</span>
                                    <p class="text-[11px] text-slate-500 mt-1">Accepts JPG, PNG, WEBP, AVIF up to 10MB each</p>
                                </label>
                            </div>
                        </div>

                        <!-- Previews Grid -->
                        @if (_selectedImages.Count > 0)
                        {
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-bold text-slate-900">Selected Photos (@_selectedImages.Count)</span>
                                    <button type="button" @onclick="() => _selectedImages.Clear()" class="text-rose-600 hover:text-rose-800 font-semibold">Clear All</button>
                                </div>
                                <div class="grid grid-cols-3 sm:grid-cols-4 gap-3 max-h-64 overflow-y-auto p-1">
                                    @for (int i = 0; i < _selectedImages.Count; i++)
                                    {
                                        var idx = i;
                                        var item = _selectedImages[i];
                                        <div class="relative group rounded-lg overflow-hidden border border-slate-200 bg-slate-100 aspect-square">
                                            <img src="@item.PreviewUrl" alt="Upload preview" class="w-full h-full object-cover" />
                                            @if (idx == 0)
                                            {
                                                <span class="absolute bottom-1 left-1 bg-black/70 text-white text-[9px] font-bold px-1.5 py-0.5 rounded">
                                                    Highlight
                                                </span>
                                            }
                                            <button type="button"
                                                    @onclick="() => RemoveSelectedImage(idx)"
                                                    class="absolute top-1 right-1 w-5 h-5 rounded-full bg-black/70 hover:bg-rose-600 text-white flex items-center justify-center text-[10px] transition-colors"
                                                    title="Remove photo">
                                                ✕
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* ── PAGE 3: OVERVIEW & CONFIRMATION ──────────────────────────── *@
                @if (_wizardStep == 3)
                {
                    <div class="space-y-4 text-xs">
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 divide-y divide-slate-200">
                            @if (_isEditingPortfolio && !string.IsNullOrWhiteSpace(_editingPortfolioId))
                            {
                                <div class="flex justify-between items-center pb-2.5">
                                    <span class="font-semibold text-slate-500 uppercase tracking-wider text-[11px]">Portfolio ID</span>
                                    <span class="font-mono font-bold text-slate-900 bg-white px-2 py-0.5 rounded border border-slate-200 text-xs">@_editingPortfolioId (Read-Only)</span>
                                </div>
                            }
                            <div class="flex justify-between items-center py-2.5">
                                <span class="font-semibold text-slate-500 uppercase tracking-wider text-[11px]">Portfolio Title</span>
                                <span class="font-bold text-slate-900 text-sm">@_newPortfolioName</span>
                            </div>
                            <div class="flex justify-between items-center py-2.5">
                                <span class="font-semibold text-slate-500 uppercase tracking-wider text-[11px]">Category</span>
                                <span class="font-bold text-slate-800">@GetCategoryName(_newPortfolioCategory)</span>
                            </div>
                            <div class="flex justify-between items-center py-2.5">
                                <span class="font-semibold text-slate-500 uppercase tracking-wider text-[11px]">Featured Status</span>
                                <span class="font-bold @(_newPortfolioIsFeatured ? "text-amber-600" : "text-slate-600")">
                                    @(_newPortfolioIsFeatured ? "★ Featured" : "Regular Album")
                                </span>
                            </div>
                            <div class="flex justify-between items-center pt-2.5">
                                <span class="font-semibold text-slate-500 uppercase tracking-wider text-[11px]">Total Album Photos</span>
                                <span class="font-bold text-slate-900">@(_isEditingPortfolio ? $"{_existingImages.Count + _selectedImages.Count} photo(s) ({_existingImages.Count} existing, {_selectedImages.Count} new)" : $"{_selectedImages.Count} file(s)")</span>
                            </div>
                        </div>

                        <div>
                            <span class="font-bold text-slate-900 block mb-2">Highlight Cover Photo Preview:</span>
                            @if (_selectedImages.Count > 0)
                            {
                                <div class="rounded-xl overflow-hidden border border-slate-200 h-44 bg-slate-100">
                                    <img src="@_selectedImages[0].PreviewUrl" alt="Cover preview" class="w-full h-full object-cover" />
                                </div>
                            }
                            else if (_existingImages.Count > 0)
                            {
                                <div class="rounded-xl overflow-hidden border border-slate-200 h-44 bg-slate-100">
                                    <img src="@_existingImages[0].Url" alt="Cover preview" class="w-full h-full object-cover" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Wizard Footer Buttons -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                <div>
                    @if (_wizardStep > 1)
                    {
                        <button type="button" @onclick="() => _wizardStep--" class="px-4 py-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-100">
                            Back
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="() => _isWizardOpen = false" class="px-4 py-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-100">
                            Cancel
                        </button>
                    }
                </div>

                <div>
                    @if (_wizardStep < 3)
                    {
                        <button type="button" @onclick="HandleNextStep" class="px-5 py-2 bg-slate-900 hover:bg-black text-white rounded-lg text-xs font-semibold uppercase tracking-wider shadow-sm">
                            Next &rarr;
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="HandleCompleteWizard" disabled="@_isSaving" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold uppercase tracking-wider shadow-sm flex items-center gap-2 disabled:opacity-50">
                            @if (_isSaving)
                            {
                                <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                                <span>Saving Portfolio...</span>
                            }
                            else
                            {
                                <span>@(_isEditingPortfolio ? "Save Changes" : "Save Portfolio")</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _currentUser;
    private bool _isReadOnly;

    private List<PortfolioFolderModel> _portfolios = new();
    private List<PortfolioCategoryModel> _categories = new();
    private bool _isLoading = true;
    private string _selectedCategory = "All";
    private string _searchQuery = string.Empty;
    private string? _notification;

    // Floating details drawer
    private PortfolioFolderModel? _activeDetailPortfolio;
    private string? _lightboxImageUrl;

    // Wizard state
    private bool _isWizardOpen;
    private bool _isEditingPortfolio;
    private string _editingPortfolioId = string.Empty;
    private bool _editingOriginalFeatured;
    private List<PortfolioImageModel> _existingImages = new();
    private int _wizardStep = 1;
    private static readonly string[] _wizardStepTitles = { "Details", "Choose Images", "Overview & Save" };
    private string? _wizardError;
    private bool _isSaving;

    private string _newPortfolioName = string.Empty;
    private string _newPortfolioCategory = string.Empty;
    private string _newPortfolioDesc = string.Empty;
    private bool _newPortfolioIsFeatured = false;

    private record UploadItem(string FileName, string ContentType, byte[] Data, string PreviewUrl);
    private List<UploadItem> _selectedImages = new();

    private List<PortfolioFolderModel> FilteredPortfolios => _portfolios
        .Where(p => (_selectedCategory == "All" || string.Equals(p.CategoryID, _selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
                    (string.IsNullOrWhiteSpace(_searchQuery) ||
                     (!string.IsNullOrEmpty(p.PortfolioName) && p.PortfolioName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                     (p.PortfolioDescription != null && p.PortfolioDescription.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null) _currentUser = (await AuthState).User;
        else if (AuthStateProvider != null) _currentUser = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _isReadOnly = EmployeeRoleHelper.IsOfficeClerk(_currentUser, UserService);

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _categories = await PortfolioService.GetCategoriesAsync();
            _portfolios = await PortfolioService.GetPortfoliosAsync();
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetCategoryName(string? catId) =>
        string.IsNullOrWhiteSpace(catId) ? "General" : (_categories.FirstOrDefault(c => string.Equals(c.CategoryID, catId, StringComparison.OrdinalIgnoreCase))?.CategoryName ?? catId);

    private void OpenAddWizard()
    {
        _isEditingPortfolio = false;
        _editingPortfolioId = string.Empty;
        _editingOriginalFeatured = false;
        _existingImages.Clear();
        _wizardStep = 1;
        _wizardError = null;
        _newPortfolioName = string.Empty;
        _newPortfolioCategory = _categories.FirstOrDefault()?.CategoryID ?? string.Empty;
        _newPortfolioDesc = string.Empty;
        _newPortfolioIsFeatured = false;
        _selectedImages.Clear();
        _isWizardOpen = true;
    }

    private void OpenEditWizard(PortfolioFolderModel p)
    {
        _isEditingPortfolio = true;
        _editingPortfolioId = p.PortfolioId;
        _editingOriginalFeatured = p.IsFeatured;
        _newPortfolioName = p.PortfolioName;
        _newPortfolioCategory = p.CategoryID;
        _newPortfolioDesc = p.PortfolioDescription ?? string.Empty;
        _newPortfolioIsFeatured = p.IsFeatured;
        _existingImages = p.Images != null ? new List<PortfolioImageModel>(p.Images) : new();
        _selectedImages.Clear();
        _wizardStep = 1;
        _wizardError = null;
        _isWizardOpen = true;
    }

    private void OpenDetailsPanel(PortfolioFolderModel p)
    {
        _activeDetailPortfolio = p;
    }

    private void CloseDetailsPanel()
    {
        _activeDetailPortfolio = null;
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        _wizardError = null;
        const long maxFileSize = 10 * 1024 * 1024;

        foreach (var file in e.GetMultipleFiles(20))
        {
            try
            {
                using var stream = file.OpenReadStream(maxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var data = ms.ToArray();
                var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
                var previewUrl = $"data:{contentType};base64,{Convert.ToBase64String(data)}";

                _selectedImages.Add(new UploadItem(file.Name, contentType, data, previewUrl));
            }
            catch (Exception ex)
            {
                _wizardError = $"Error reading file '{file.Name}': {ex.Message}";
            }
        }
    }

    private void RemoveSelectedImage(int index)
    {
        if (index >= 0 && index < _selectedImages.Count)
        {
            _selectedImages.RemoveAt(index);
        }
    }

    private void HandleNextStep()
    {
        _wizardError = null;
        if (_wizardStep == 1)
        {
            if (string.IsNullOrWhiteSpace(_newPortfolioName))
            {
                _wizardError = "Portfolio Name is required.";
                return;
            }
            if (string.IsNullOrWhiteSpace(_newPortfolioCategory))
            {
                _wizardError = "Please select a Category.";
                return;
            }
            _wizardStep = 2;
        }
        else if (_wizardStep == 2)
        {
            if (_isEditingPortfolio)
            {
                if (_existingImages.Count == 0 && _selectedImages.Count == 0)
                {
                    _wizardError = "Portfolio must have at least one photo.";
                    return;
                }
            }
            else
            {
                if (_selectedImages.Count == 0)
                {
                    _wizardError = "Please choose at least one image.";
                    return;
                }
            }
            _wizardStep = 3;
        }
    }

    private async Task HandleCompleteWizard()
    {
        _isSaving = true;
        _wizardError = null;

        if (_isEditingPortfolio)
        {
            try
            {
                var newImagesTuples = _selectedImages.Select(i => (i.FileName, i.ContentType, i.Data)).ToList();
                var ok = await PortfolioService.UpdatePortfolioAsync(
                    _editingPortfolioId,
                    _newPortfolioName,
                    _newPortfolioDesc,
                    _newPortfolioCategory,
                    newImagesTuples.Count > 0 ? newImagesTuples : null);

                if (ok)
                {
                    if (_newPortfolioIsFeatured != _editingOriginalFeatured)
                    {
                        await PortfolioService.ToggleFeatureAsync(_editingPortfolioId);
                    }

                    _isWizardOpen = false;
                    _wizardStep = 1;
                    var savedId = _editingPortfolioId;
                    var savedName = _newPortfolioName;
                    _selectedImages.Clear();
                    _existingImages.Clear();
                    _newPortfolioName = string.Empty;
                    _newPortfolioCategory = string.Empty;
                    _newPortfolioDesc = string.Empty;
                    _newPortfolioIsFeatured = false;
                    _notification = $"Portfolio '{savedName}' ({savedId}) updated successfully!";
                    await LoadData();
                    if (_activeDetailPortfolio?.PortfolioId == savedId)
                    {
                        _activeDetailPortfolio = _portfolios.FirstOrDefault(p => p.PortfolioId == savedId);
                    }
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    _wizardError = "Failed to update portfolio. Please check your inputs.";
                }
            }
            catch (Exception ex)
            {
                _wizardError = ex.Message;
            }
            finally
            {
                _isSaving = false;
            }
            return;
        }

        try
        {
            var imagesList = _selectedImages.Select(i => (i.FileName, i.ContentType, i.Data)).ToList();
            var res = await PortfolioService.CreatePortfolioAsync(
                _newPortfolioName,
                _newPortfolioDesc,
                _newPortfolioCategory,
                _newPortfolioIsFeatured,
                imagesList);

            if (res != null)
            {
                // Instant exit wizard setup
                _isWizardOpen = false;
                _wizardStep = 1;
                _selectedImages.Clear();
                _newPortfolioName = string.Empty;
                _newPortfolioCategory = string.Empty;
                _newPortfolioDesc = string.Empty;
                _newPortfolioIsFeatured = false;
                _selectedCategory = "All";
                _searchQuery = string.Empty;

                // Show success message and refresh table
                _notification = $"Portfolio '{res.PortfolioName}' ({res.PortfolioId}) created successfully with {res.Images?.Count ?? 0} photo(s)!";
                await LoadData();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                _wizardError = "Failed to save portfolio. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _wizardError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task HandleToggleFeature(PortfolioFolderModel port)
    {
        if (_isReadOnly) return;
        var oldState = port.IsFeatured;
        port.IsFeatured = !oldState; // Optimistic update

        var ok = await PortfolioService.ToggleFeatureAsync(port.PortfolioId);
        if (!ok)
        {
            port.IsFeatured = oldState; // Revert
        }
        else
        {
            _notification = $"Portfolio '{port.PortfolioName}' ({port.PortfolioId}) status updated to {(port.IsFeatured ? "Featured" : "Regular")}.";
        }
    }

    private async Task HandleDeletePortfolio(PortfolioFolderModel port)
    {
        if (_isReadOnly) return;
        var ok = await PortfolioService.DeletePortfolioAsync(port.PortfolioId);
        if (ok)
        {
            _portfolios.Remove(port);
            if (_activeDetailPortfolio?.PortfolioId == port.PortfolioId)
            {
                _activeDetailPortfolio = null;
            }
            _notification = $"Portfolio '{port.PortfolioName}' ({port.PortfolioId}) deleted.";
        }
    }
}
