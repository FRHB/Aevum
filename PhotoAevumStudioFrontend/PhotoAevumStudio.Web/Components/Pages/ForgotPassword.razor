@page "/forgot-password"
@layout EmptyLayout
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject NavigationManager NavManager
@inject IAuthService AuthService

<PageTitle>Forgot Password | Photo Aevum Studio</PageTitle>

<div class="forgot-page-wrapper">
    <div class="forgot-card">
        <div class="logo-wrapper">
            <img src="images/AevumLogo.jpg" alt="Aevum Studio Logo" class="aevum-logo" />
        </div>

        <h2 class="forgot-header">Password Recovery</h2>
        <p class="forgot-subtitle">
            @if (step == 1)
            {
                <span>Enter your registered email address to receive a secure verification code.</span>
            }
            else if (step == 2)
            {
                <span>Enter the 6-digit verification code sent to <strong>@email</strong>.</span>
            }
            else
            {
                <span>Verification successful. Enter your new password below.</span>
            }
        </p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <span class="alert-icon">⚠️</span> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success" role="status">
                <span class="alert-icon">✓</span> @successMessage
            </div>
        }

        @* ── Step 1: Request Code ────────────────────────────────────────── *@
        @if (step == 1)
        {
            <EditForm Model="@step1Model" OnValidSubmit="HandleSendVerificationCode">
                <div class="input-group">
                    <label for="recovery-email">Registered Email Address</label>
                    <input type="email"
                           id="recovery-email"
                           class="minimal-input"
                           @bind="step1Model.Email"
                           placeholder="e.g. user@photoaevum.studio"
                           required
                           disabled="@isSubmitting" />
                </div>

                <button type="submit" class="submit-button" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Sending Code...</span>
                    }
                    else
                    {
                        <span>Send Verification Code</span>
                    }
                </button>
            </EditForm>
        }

        @* ── Step 2: Enter Verification Code ────────────────────────────── *@
        @if (step == 2)
        {
            <EditForm Model="@step2Model" OnValidSubmit="HandleVerifyCode">
                <div class="input-group">
                    <label for="verification-code">6-Digit Verification Code</label>
                    <input type="text"
                           id="verification-code"
                           class="minimal-input text-center tracking-widest text-lg font-mono"
                           maxlength="6"
                           @bind="step2Model.Code"
                           placeholder="123456"
                           required
                           disabled="@isSubmitting" />
                </div>

                <div class="resend-container">
                    <button type="button" class="btn-link" @onclick="HandleResendCode" disabled="@isSubmitting">
                        Didn't receive code? Resend
                    </button>
                </div>

                <button type="submit" class="submit-button" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Verifying...</span>
                    }
                    else
                    {
                        <span>Verify Code</span>
                    }
                </button>
            </EditForm>
        }

        @* ── Step 3: Reset Password ─────────────────────────────────────── *@
        @if (step == 3)
        {
            <EditForm Model="@step3Model" OnValidSubmit="HandleResetPassword">
                <div class="input-group">
                    <label for="new-password">New Password</label>
                    <PasswordInput Id="new-password"
                                   Name="newPassword"
                                   Autocomplete="new-password"
                                   @bind-Value="step3Model.NewPassword"
                                   Placeholder="Minimum 8 characters"
                                   Disabled="@isSubmitting" />
                </div>

                <div class="input-group">
                    <label for="confirm-password">Confirm New Password</label>
                    <PasswordInput Id="confirm-password"
                                   Name="confirmPassword"
                                   Autocomplete="new-password"
                                   @bind-Value="step3Model.ConfirmPassword"
                                   Placeholder="Re-enter new password"
                                   Disabled="@isSubmitting" />
                </div>

                <button type="submit" class="submit-button" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Updating Password...</span>
                    }
                    else
                    {
                        <span>Reset Password</span>
                    }
                </button>
            </EditForm>
        }

        <div class="back-to-login">
            <a href="/login" class="back-link">← Back to Login</a>
        </div>
    </div>
</div>

@code {
    private int step = 1;
    private string email = "";
    private string verifiedCode = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool isSubmitting = false;

    private Step1Form step1Model = new();
    private Step2Form step2Model = new();
    private Step3Form step3Model = new();

    private async Task HandleSendVerificationCode()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(step1Model.Email) || !step1Model.Email.Contains('@'))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        isSubmitting = true;
        email = step1Model.Email.Trim();

        var sent = await AuthService.SendVerificationCodeAsync(email);
        isSubmitting = false;

        if (sent)
        {
            step = 2;
            successMessage = "Verification code sent to your email!";
        }
        else
        {
            errorMessage = "Could not send verification code. Please check that the account exists.";
        }
    }

    private async Task HandleResendCode()
    {
        errorMessage = "";
        isSubmitting = true;
        var sent = await AuthService.SendVerificationCodeAsync(email);
        isSubmitting = false;

        if (sent)
        {
            successMessage = "A new verification code has been dispatched.";
        }
        else
        {
            errorMessage = "Failed to resend code. Please try again shortly.";
        }
    }

    private async Task HandleVerifyCode()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(step2Model.Code) || step2Model.Code.Trim().Length < 4)
        {
            errorMessage = "Please enter the verification code.";
            return;
        }

        isSubmitting = true;
        var code = step2Model.Code.Trim();

        var isValid = await AuthService.VerifyCodeAsync(email, code);
        isSubmitting = false;

        if (isValid)
        {
            verifiedCode = code;
            step = 3;
            successMessage = "Identity verified! You may now set your new password.";
        }
        else
        {
            errorMessage = "Invalid or expired verification code. Please check and try again.";
        }
    }

    private async Task HandleResetPassword()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(step3Model.NewPassword) || step3Model.NewPassword.Length < 8)
        {
            errorMessage = "Password must be at least 8 characters long.";
            return;
        }

        if (step3Model.NewPassword != step3Model.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isSubmitting = true;
        var reset = await AuthService.ResetPasswordAsync(email, verifiedCode, step3Model.NewPassword);
        isSubmitting = false;

        if (reset)
        {
            successMessage = "Password successfully reset! Redirecting to login in 2 seconds...";
            await Task.Delay(2000);
            NavManager.NavigateTo("/login");
        }
        else
        {
            errorMessage = "Password reset failed. Please ensure the code is still valid.";
        }
    }

    public class Step1Form { public string Email { get; set; } = ""; }
    public class Step2Form { public string Code { get; set; } = ""; }
    public class Step3Form
    {
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
