@page "/forgot-password"
@attribute [AllowAnonymous]
@layout EmptyLayout
@implements IDisposable
@using System.Text.RegularExpressions
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject NavigationManager NavManager
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Forgot Password | Photo Aevum Studio</PageTitle>

<div class="forgot-page-wrapper">
    <div class="forgot-card">
        <div class="logo-wrapper">
            <img src="images/AevumLogo.jpg" alt="Aevum Studio Logo" class="aevum-logo" />
        </div>

        <div class="customer-badge-container">
            <span class="customer-badge">Customer Account Recovery</span>
        </div>

        <h2 class="forgot-header">Password Recovery</h2>

        @if (isRestrictedStaffSession)
        {
            <p class="forgot-subtitle">
                Forgot Password is only available for customer accounts.
            </p>
            <div class="alert alert-danger" role="alert">
                <span class="alert-icon" aria-hidden="true">⚠️</span>
                <span>Staff and Admin accounts cannot use customer password recovery. Please contact a System Administrator or use Change Password from your profile.</span>
            </div>
            <div class="back-to-login">
                <a href="/login" class="back-link">← Back to Login</a>
            </div>
        }
        else
        {
            <p class="forgot-subtitle">
                Enter the email address connected to your customer account to receive a 6-digit verification code.
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <span class="alert-icon" aria-hidden="true">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success" role="status">
                    <svg class="alert-svg-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>@successMessage</span>
                </div>
            }

            @* ── Step 1 on the page: Enter Customer Email ────────────────── *@
            <EditForm Model="@step1Model" OnValidSubmit="HandleSendVerificationCode">
                <div class="input-group">
                    <label for="recovery-email">Customer Email Address</label>
                    <input type="email"
                           id="recovery-email"
                           class="minimal-input"
                           @bind="step1Model.Email"
                           placeholder="you@example.com"
                           autocomplete="email"
                           required
                           disabled="@(isSubmitting || isModalOpen)" />
                </div>

                <button type="submit" class="submit-button" disabled="@(isSubmitting || isModalOpen)">
                    @if (isSubmitting && !isModalOpen)
                    {
                        <span>Sending Code...</span>
                    }
                    else
                    {
                        <span>Send Verification Code</span>
                    }
                </button>
            </EditForm>

            <div class="back-to-login">
                <a href="/login" class="back-link">← Back to Login</a>
            </div>
        }
    </div>
</div>

@* ── Step 2 & Step 3 Modal Dialog ─────────────────────────────────────── *@
@if (isModalOpen && !isRestrictedStaffSession)
{
    <div class="fp-modal-backdrop" aria-hidden="true"></div>

    <div class="fp-modal-panel"
         role="dialog"
         aria-modal="true"
         aria-labelledby="fp-modal-title">
        <button type="button"
                class="fp-modal-close"
                @onclick="HandleCloseModal"
                disabled="@isSubmitting"
                aria-label="Close modal"
                title="Close">
            ✕
        </button>

        <div class="fp-modal-badge-row">
            <span class="customer-badge">Customer Account Recovery</span>
        </div>

        <ol class="fp-stepper" aria-label="Password recovery steps">
            <li class="fp-stepper__item @(modalStep == 2 && !passwordUpdated ? "is-current" : "is-done")">
                <span class="fp-stepper__dot">@(modalStep > 2 || passwordUpdated ? "✓" : "1")</span>
                <span class="fp-stepper__label">Verify Code</span>
            </li>
            <li class="fp-stepper__item @(passwordUpdated ? "is-done" : modalStep == 3 ? "is-current" : "")">
                <span class="fp-stepper__dot">@(passwordUpdated ? "✓" : "2")</span>
                <span class="fp-stepper__label">New Password</span>
            </li>
        </ol>

        @if (passwordUpdated)
        {
            <h3 id="fp-modal-title" class="fp-modal-title">Password Updated</h3>
            <p class="fp-modal-subtitle">
                Your customer account password has been updated.
            </p>

            <div class="fp-success-box" role="status">
                <div class="fp-success-box__icon" aria-hidden="true">✓</div>
                <p class="fp-success-box__text">@modalSuccessMessage</p>
            </div>

            <a href="/login" role="button" class="submit-button fp-login-cta">
                Back to Login
            </a>
        }
        else if (modalStep == 2)
        {
            <h3 id="fp-modal-title" class="fp-modal-title">Enter Verification Code</h3>
            <p class="fp-modal-subtitle">
                Enter the 6-digit verification number for <strong>@email</strong>.
            </p>

            @if (!string.IsNullOrEmpty(modalErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <span class="alert-icon" aria-hidden="true">⚠️</span>
                    <span>@modalErrorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(modalSuccessMessage))
            {
                <div class="alert alert-success" role="status">
                    <svg class="alert-svg-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>@modalSuccessMessage</span>
                </div>
            }

            <EditForm Model="@step2Model" OnValidSubmit="HandleVerifyCode">
                <div class="input-group">
                    <label for="verification-code">6-Digit Verification Number</label>
                    <input type="text"
                           id="verification-code"
                           class="minimal-input fp-code-input"
                           maxlength="6"
                           inputmode="numeric"
                           pattern="[0-9]{6}"
                           autocomplete="one-time-code"
                           value="@step2Model.Code"
                           @oninput="OnCodeInput"
                           placeholder="123456"
                           required
                           disabled="@isSubmitting" />
                </div>

                <div class="fp-modal-actions-row">
                    <button type="button"
                            class="btn-link"
                            @onclick="HandleCloseModal"
                            disabled="@isSubmitting">
                        Change Email
                    </button>
                    <button type="button"
                            class="btn-link fp-resend-btn"
                            @onclick="HandleResendCode"
                            disabled="@(isSubmitting || resendCooldownSeconds > 0)">
                        @if (resendCooldownSeconds > 0)
                        {
                            <span>Resend code in @(resendCooldownSeconds)s</span>
                        }
                        else
                        {
                            <span>Resend Code</span>
                        }
                    </button>
                </div>

                <button type="submit" class="submit-button" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Verifying...</span>
                    }
                    else
                    {
                        <span>Verify Code</span>
                    }
                </button>
            </EditForm>
        }
        else if (modalStep == 3)
        {
            <h3 id="fp-modal-title" class="fp-modal-title">Set New Password</h3>
            <p class="fp-modal-subtitle">
                Verification successful. Update the password for <strong>@email</strong>.
            </p>

            @if (!string.IsNullOrEmpty(modalErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <span class="alert-icon" aria-hidden="true">⚠️</span>
                    <span>@modalErrorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(modalSuccessMessage))
            {
                <div class="alert alert-success" role="status">
                    <svg class="alert-svg-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>@modalSuccessMessage</span>
                </div>
            }

            <EditForm Model="@step3Model" OnValidSubmit="HandleResetPassword">
                <div class="input-group">
                    <label for="new-password">New Password</label>
                    <PasswordInput Id="new-password"
                                   Name="newPassword"
                                   Autocomplete="new-password"
                                   MaxLength="30"
                                   @bind-Value="step3Model.NewPassword"
                                   Placeholder="8–30 characters"
                                   Disabled="@isSubmitting" />
                    <PasswordRequirementsChecklist Password="@step3Model.NewPassword" CssClass="mt-2" />
                </div>

                <div class="input-group">
                    <label for="confirm-password">Confirm New Password</label>
                    <PasswordInput Id="confirm-password"
                                   Name="confirmPassword"
                                   Autocomplete="new-password"
                                   MaxLength="30"
                                   @bind-Value="step3Model.ConfirmPassword"
                                   Placeholder="Re-enter new password"
                                   Disabled="@isSubmitting" />
                </div>

                <button type="submit" class="submit-button" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Updating Password...</span>
                    }
                    else
                    {
                        <span>Update Password</span>
                    }
                </button>

                <div class="fp-modal-footer-links">
                    <button type="button"
                            class="btn-link"
                            @onclick="HandleBackToVerification"
                            disabled="@isSubmitting">
                        Need a new verification code?
                    </button>
                    <span class="fp-link-sep" aria-hidden="true">·</span>
                    <button type="button"
                            class="btn-link"
                            @onclick="HandleCloseModal"
                            disabled="@isSubmitting">
                        Change Email
                    </button>
                </div>
            </EditForm>
        }
    </div>
}

@code {
    internal bool isModalOpen = false;
    internal int modalStep = 2;
    internal string email = "";
    internal string verifiedCode = "";
    internal string errorMessage = "";
    internal string successMessage = "";
    internal string modalErrorMessage = "";
    internal string modalSuccessMessage = "";
    internal bool isSubmitting = false;
    internal bool passwordUpdated = false;
    internal bool isRestrictedStaffSession = false;
    internal int resendCooldownSeconds = 0;

    private CancellationTokenSource? _cooldownCts;

    internal Step1Form step1Model = new();
    internal Step2Form step2Model = new();
    internal Step3Form step3Model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true && !user.IsInRole("Customer"))
            {
                if (user.IsInRole("Admin") || user.IsInRole("SystemAdmin") || user.IsInRole("Super Admin")
                    || user.IsInRole("Employee") || user.IsInRole("Office Clerk"))
                {
                    isRestrictedStaffSession = true;
                }
            }
        }
        catch
        {
            // Ignore auth state inspection failures on public route
        }
    }

    internal async Task HandleSendVerificationCode()
    {
        errorMessage = "";
        successMessage = "";

        var trimmedEmail = step1Model.Email?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(trimmedEmail) || !System.Net.Mail.MailAddress.TryCreate(trimmedEmail, out _))
        {
            errorMessage = "Please enter a valid customer email address.";
            return;
        }

        isSubmitting = true;
        var normalizedEmail = trimmedEmail.ToLowerInvariant();

        var (sent, error) = await AuthService.RequestPasswordResetCodeAsync(normalizedEmail);
        isSubmitting = false;

        if (sent)
        {
            email = normalizedEmail;
            verifiedCode = string.Empty;
            step2Model = new Step2Form();
            step3Model = new Step3Form();
            passwordUpdated = false;
            modalErrorMessage = string.Empty;
            modalSuccessMessage = "If an active customer account is registered with that email, a 6-digit verification code has been sent. Please enter it below.";
            modalStep = 2;
            isModalOpen = true;
            StartResendCooldown(60);
        }
        else
        {
            errorMessage = error ?? "Could not send verification code. Please ensure this email belongs to an active customer account.";
        }
    }

    internal async Task HandleResendCode()
    {
        if (isSubmitting || resendCooldownSeconds > 0 || string.IsNullOrWhiteSpace(email))
        {
            return;
        }

        modalErrorMessage = "";
        modalSuccessMessage = "";
        isSubmitting = true;
        var (sent, error) = await AuthService.RequestPasswordResetCodeAsync(email);
        isSubmitting = false;

        if (sent)
        {
            step2Model = new Step2Form();
            modalSuccessMessage = "A new 6-digit verification code has been sent if your customer account is active.";
            StartResendCooldown(60);
        }
        else
        {
            modalErrorMessage = error ?? "Failed to resend code. Please try again shortly.";
            if (!string.IsNullOrWhiteSpace(error))
            {
                var match = Regex.Match(error, @"(\d+)\s*seconds", RegexOptions.IgnoreCase);
                if (match.Success && int.TryParse(match.Groups[1].Value, out var remaining) && remaining > 0)
                {
                    StartResendCooldown(remaining);
                }
            }
        }
    }

    internal void HandleCloseModal()
    {
        if (isSubmitting)
        {
            return;
        }

        StopResendCooldown();
        isModalOpen = false;
        modalStep = 2;
        verifiedCode = "";
        modalErrorMessage = "";
        modalSuccessMessage = "";
        step2Model = new Step2Form();
        step3Model = new Step3Form();

        if (passwordUpdated)
        {
            passwordUpdated = false;
            successMessage = $"Password updated successfully for {email}. You can now sign in with your new password.";
            email = "";
            step1Model = new Step1Form();
        }
    }

    internal void HandleBackToVerification()
    {
        if (isSubmitting)
        {
            return;
        }

        modalStep = 2;
        verifiedCode = "";
        step2Model = new Step2Form();
        step3Model = new Step3Form();
        modalErrorMessage = "";
        modalSuccessMessage = "";
    }

    internal async Task HandleVerifyCode()
    {
        modalErrorMessage = "";
        modalSuccessMessage = "";

        var code = step2Model.Code?.Trim() ?? string.Empty;
        if (!Regex.IsMatch(code, @"^\d{6}$"))
        {
            modalErrorMessage = "Please enter the 6-digit verification code sent to your email.";
            return;
        }

        isSubmitting = true;
        var (isValid, error) = await AuthService.VerifyPasswordResetCodeAsync(email, code);
        isSubmitting = false;

        if (isValid)
        {
            verifiedCode = code;
            step3Model = new Step3Form();
            modalStep = 3;
            modalSuccessMessage = "Verification successful! You may now set your new password.";
        }
        else
        {
            modalErrorMessage = error ?? "Invalid or expired verification code. Please check and try again.";
        }
    }

    internal async Task HandleResetPassword()
    {
        if (modalStep != 3 || string.IsNullOrWhiteSpace(verifiedCode))
        {
            modalStep = 2;
            modalErrorMessage = "Please verify your 6-digit code first.";
            return;
        }

        modalErrorMessage = "";
        modalSuccessMessage = "";

        var newPw = step3Model.NewPassword ?? string.Empty;
        var policyError = PasswordPolicyHelper.GetValidationError(newPw);
        if (policyError is not null)
        {
            modalErrorMessage = policyError;
            return;
        }

        if (newPw != step3Model.ConfirmPassword)
        {
            modalErrorMessage = "Passwords do not match.";
            return;
        }

        isSubmitting = true;
        var (reset, error) = await AuthService.ResetCustomerPasswordAsync(email, verifiedCode, newPw);
        isSubmitting = false;

        if (reset)
        {
            passwordUpdated = true;
            verifiedCode = string.Empty;
            step3Model = new Step3Form();
            StopResendCooldown();
            modalSuccessMessage = $"Your password has been updated for {email}. You can now sign in with your new password.";
        }
        else
        {
            modalErrorMessage = error ?? "Password update failed. Please ensure the verification code is still valid.";
        }
    }

    private void OnCodeInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        step2Model.Code = new string(raw.Where(char.IsDigit).Take(6).ToArray());
    }

    private void StartResendCooldown(int seconds = 60)
    {
        StopResendCooldown();
        resendCooldownSeconds = Math.Max(0, seconds);
        if (resendCooldownSeconds == 0)
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _cooldownCts = cts;
        _ = RunCooldownTimerAsync(cts.Token);
    }

    private async Task RunCooldownTimerAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (resendCooldownSeconds > 0 && await timer.WaitForNextTickAsync(token))
            {
                resendCooldownSeconds = Math.Max(0, resendCooldownSeconds - 1);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on timer reset or component disposal.
        }
        catch (ObjectDisposedException)
        {
            // Expected if component is disposed mid-tick.
        }
    }

    private void StopResendCooldown()
    {
        if (_cooldownCts is not null)
        {
            _cooldownCts.Cancel();
            _cooldownCts.Dispose();
            _cooldownCts = null;
        }
        resendCooldownSeconds = 0;
    }

    internal void TriggerStateHasChanged() => StateHasChanged();

    public void Dispose()
    {
        StopResendCooldown();
    }

    public class Step1Form { public string Email { get; set; } = ""; }
    public class Step2Form { public string Code { get; set; } = ""; }
    public class Step3Form
    {
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
