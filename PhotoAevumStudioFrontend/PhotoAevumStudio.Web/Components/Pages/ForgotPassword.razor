@page "/forgot-password"
@attribute [AllowAnonymous]
@layout EmptyLayout
@using System.Text.RegularExpressions
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject NavigationManager NavManager
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Forgot Password | Photo Aevum Studio</PageTitle>

<div class="forgot-page-wrapper">
    <div class="forgot-card">
        <div class="logo-wrapper">
            <img src="images/AevumLogo.jpg" alt="Aevum Studio Logo" class="aevum-logo" />
        </div>

        <div class="customer-badge-container">
            <span class="customer-badge">Customer Account Recovery</span>
        </div>

        <h2 class="forgot-header">Password Recovery</h2>

        @if (isRestrictedStaffSession)
        {
            <p class="forgot-subtitle">
                Forgot Password is only available for customer accounts.
            </p>
            <div class="alert alert-danger" role="alert">
                <span class="alert-icon">⚠️</span>
                <span>Staff and Admin accounts cannot use customer password recovery. Please contact a System Administrator or use Change Password from your profile.</span>
            </div>
            <div class="back-to-login">
                <a href="/login" class="back-link">← Back to Login</a>
            </div>
        }
        else
        {
            <p class="forgot-subtitle">
                @if (step == 1)
                {
                    <span>Enter the email address connected to your customer account to receive a 6-digit verification code.</span>
                }
                else if (step == 2)
                {
                    <span>Enter the 6-digit verification code sent to <strong>@email</strong>.</span>
                }
                else
                {
                    <span>Verification successful. Update the password for <strong>@email</strong> below.</span>
                }
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <span class="alert-icon">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success" role="status">
                    <svg class="alert-svg-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>@successMessage</span>
                </div>
            }

            @* ── Step 1: Request Code (Customer Email) ──────────────────────── *@
            @if (step == 1)
            {
                <EditForm Model="@step1Model" OnValidSubmit="HandleSendVerificationCode">
                    <div class="input-group">
                        <label for="recovery-email">Customer Email Address</label>
                        <input type="email"
                               id="recovery-email"
                               class="minimal-input"
                               @bind="step1Model.Email"
                               placeholder="you@example.com"
                               autocomplete="email"
                               required
                               disabled="@isSubmitting" />
                    </div>

                    <button type="submit" class="submit-button" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Sending Code...</span>
                        }
                        else
                        {
                            <span>Send Verification Code</span>
                        }
                    </button>
                </EditForm>
            }

            @* ── Step 2: Wait for & Verify 6-Digit Code ─────────────────────── *@
            @if (step == 2)
            {
                <EditForm Model="@step2Model" OnValidSubmit="HandleVerifyCode">
                    <div class="input-group">
                        <label for="verification-code">6-Digit Verification Code</label>
                        <input type="text"
                               id="verification-code"
                               class="minimal-input text-center tracking-widest text-lg font-mono"
                               maxlength="6"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               @bind="step2Model.Code"
                               placeholder="123456"
                               required
                               disabled="@isSubmitting" />
                    </div>

                    <div class="step2-actions-row">
                        <button type="button" class="btn-link" @onclick="HandleChangeEmail" disabled="@isSubmitting">
                            Use a different email
                        </button>
                        <button type="button" class="btn-link" @onclick="HandleResendCode" disabled="@isSubmitting">
                            Didn't receive code? Resend
                        </button>
                    </div>

                    <button type="submit" class="submit-button" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Verifying...</span>
                        }
                        else
                        {
                            <span>Verify Code</span>
                        }
                    </button>
                </EditForm>
            }

            @* ── Step 3: Update Account Password ────────────────────────────── *@
            @if (step == 3 && !passwordUpdated)
            {
                <EditForm Model="@step3Model" OnValidSubmit="HandleResetPassword">
                    <div class="input-group">
                        <label for="new-password">New Password</label>
                        <PasswordInput Id="new-password"
                                       Name="newPassword"
                                       Autocomplete="new-password"
                                       MaxLength="30"
                                       @bind-Value="step3Model.NewPassword"
                                       Placeholder="8–30 characters"
                                       Disabled="@isSubmitting" />
                        <PasswordRequirementsChecklist Password="@step3Model.NewPassword" CssClass="mt-2" />
                    </div>

                    <div class="input-group">
                        <label for="confirm-password">Confirm New Password</label>
                        <PasswordInput Id="confirm-password"
                                       Name="confirmPassword"
                                       Autocomplete="new-password"
                                       MaxLength="30"
                                       @bind-Value="step3Model.ConfirmPassword"
                                       Placeholder="Re-enter new password"
                                       Disabled="@isSubmitting" />
                    </div>

                    <button type="submit" class="submit-button" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Updating Password...</span>
                        }
                        else
                        {
                            <span>Update Password</span>
                        }
                    </button>
                </EditForm>
            }

            @if (passwordUpdated)
            {
                <button type="button" class="submit-button" @onclick='() => NavManager.NavigateTo("/login")'>
                    Go to Login
                </button>
            }

            <div class="back-to-login">
                <a href="/login" class="back-link">← Back to Login</a>
            </div>
        }
    </div>
</div>

@code {
    private int step = 1;
    private string email = "";
    private string verifiedCode = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool isSubmitting = false;
    private bool passwordUpdated = false;
    private bool isRestrictedStaffSession = false;

    private Step1Form step1Model = new();
    private Step2Form step2Model = new();
    private Step3Form step3Model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true && !user.IsInRole("Customer"))
            {
                if (user.IsInRole("Admin") || user.IsInRole("SystemAdmin") || user.IsInRole("Super Admin")
                    || user.IsInRole("Employee") || user.IsInRole("Office Clerk"))
                {
                    isRestrictedStaffSession = true;
                }
            }
        }
        catch
        {
            // Ignore auth state inspection failures on public route
        }
    }

    private async Task HandleSendVerificationCode()
    {
        errorMessage = "";
        successMessage = "";

        var trimmedEmail = step1Model.Email?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(trimmedEmail) || !System.Net.Mail.MailAddress.TryCreate(trimmedEmail, out _))
        {
            errorMessage = "Please enter a valid customer email address.";
            return;
        }

        isSubmitting = true;
        var normalizedEmail = trimmedEmail.ToLowerInvariant();

        var (sent, error) = await AuthService.RequestPasswordResetCodeAsync(normalizedEmail);
        isSubmitting = false;

        if (sent)
        {
            email = normalizedEmail;
            verifiedCode = string.Empty;
            step2Model = new Step2Form();
            step = 2;
            successMessage = "Verification code sent to your email! Please enter the 6-digit code below.";
        }
        else
        {
            errorMessage = error ?? "Could not send verification code. Please ensure this email belongs to an active customer account.";
        }
    }

    private async Task HandleResendCode()
    {
        errorMessage = "";
        successMessage = "";
        isSubmitting = true;
        var (sent, error) = await AuthService.RequestPasswordResetCodeAsync(email);
        isSubmitting = false;

        if (sent)
        {
            successMessage = "A new 6-digit verification code has been sent to your email.";
        }
        else
        {
            errorMessage = error ?? "Failed to resend code. Please try again shortly.";
        }
    }

    private void HandleChangeEmail()
    {
        errorMessage = "";
        successMessage = "";
        verifiedCode = "";
        step2Model = new Step2Form();
        step = 1;
    }

    private async Task HandleVerifyCode()
    {
        errorMessage = "";
        successMessage = "";

        var code = step2Model.Code?.Trim() ?? string.Empty;
        if (!Regex.IsMatch(code, @"^\d{6}$"))
        {
            errorMessage = "Please enter the 6-digit verification code sent to your email.";
            return;
        }

        isSubmitting = true;
        var (isValid, error) = await AuthService.VerifyPasswordResetCodeAsync(email, code);
        isSubmitting = false;

        if (isValid)
        {
            verifiedCode = code;
            step3Model = new Step3Form();
            step = 3;
            successMessage = "Identity verified! You may now update your account password.";
        }
        else
        {
            errorMessage = error ?? "Invalid or expired verification code. Please check and try again.";
        }
    }

    private async Task HandleResetPassword()
    {
        errorMessage = "";
        successMessage = "";

        var newPw = step3Model.NewPassword ?? string.Empty;
        var policyError = PasswordPolicyHelper.GetValidationError(newPw);
        if (policyError is not null)
        {
            errorMessage = policyError;
            return;
        }

        if (newPw != step3Model.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isSubmitting = true;
        var (reset, error) = await AuthService.ResetCustomerPasswordAsync(email, verifiedCode, newPw);
        isSubmitting = false;

        if (reset)
        {
            passwordUpdated = true;
            verifiedCode = string.Empty;
            step3Model = new Step3Form();
            successMessage = $"Password updated successfully for {email}! Redirecting to login...";
            StateHasChanged();
            await Task.Delay(2000);
            NavManager.NavigateTo("/login");
        }
        else
        {
            errorMessage = error ?? "Password update failed. Please ensure the verification code is still valid.";
        }
    }

    public class Step1Form { public string Email { get; set; } = ""; }
    public class Step2Form { public string Code { get; set; } = ""; }
    public class Step3Form
    {
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
