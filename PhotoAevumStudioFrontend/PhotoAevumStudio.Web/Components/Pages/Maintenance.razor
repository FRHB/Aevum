@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _currentUser;
    private bool _isReadOnly = true;

    private List<MaintenanceLogModel> maintenanceLogs = new();
    private List<MaintenanceScheduleModel> maintenanceSchedules = new();
    private List<EquipmentItemModel> equipmentList = new();

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isLogModalOpen = false;
    private bool isResolveModalOpen = false;
    private bool isUpdateModalOpen = false;
    private string logSubStatusChoice = MaintenanceScheduleStatuses.SubUnderRepair;

    private MaintenanceScheduleModel? updateTargetSchedule;
    private string updateScheduleStatus = MaintenanceScheduleStatuses.InMaintenance;
    private string updateSubStatusChoice = MaintenanceScheduleStatuses.SubUnderRepair;
    private string updateScheduleSubStatus = MaintenanceScheduleStatuses.SubUnderRepair;
    private string updateScheduleNotes = string.Empty;
    private string? updateModalError;

    private string searchQuery = string.Empty;
    private string selectedServiceFilter = "ALL";
    private string selectedStatusFilter = "ALL";
    private int currentPage = 1;
    private List<MaintenanceLogModel> PagedLogs => TablePagination.Paginate(FilteredLogs, currentPage, 10);

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }

    private void OnServiceFilterChanged(ChangeEventArgs e)
    {
        selectedServiceFilter = e.Value?.ToString() ?? "ALL";
        currentPage = 1;
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        selectedStatusFilter = e.Value?.ToString() ?? "ALL";
        currentPage = 1;
    }

    private string? notificationMessage;
    private string? formErrorMessage;

    private NewMaintenanceFormModel maintenanceForm = new();
    private MaintenanceLogModel? resolveTargetLog;
    private string resolveNotes = string.Empty;

    private MaintenanceLogModel? detailsModalLog;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            _currentUser = state.User;
        }
        else if (AuthStateProvider != null)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUser = state.User;
        }
        _isReadOnly = !EmployeeRoleHelper.IsOfficeClerk(_currentUser, UserService) && !EmployeeRoleHelper.IsAdmin(_currentUser) && !EmployeeRoleHelper.IsSystemAdmin(_currentUser);
        if (_isReadOnly)
        {
            Nav.NavigateTo("/staff");
            return;
        }

        EquipmentService.OnChange += HandleExternalStateChange;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        maintenanceLogs = (await EquipmentService.GetMaintenanceLogsAsync()).ToList();
        maintenanceSchedules = (await EquipmentService.GetMaintenanceSchedulesAsync()).ToList();
        equipmentList = (await EquipmentService.GetEquipmentsAsync()).ToList();
        isLoading = false;
    }

    private string GetCurrentActorId() =>
        _currentUser?.FindFirst("studio_id")?.Value
        ?? _currentUser?.FindFirst(ClaimTypes.NameIdentifier)?.Value
        ?? "ADM-001";

    private void HandleExternalStateChange()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private bool IsFiltered => 
        !string.IsNullOrWhiteSpace(searchQuery) || 
        selectedServiceFilter != "ALL" || 
        selectedStatusFilter != "ALL";

    private void ResetFilters()
    {
        searchQuery = string.Empty;
        selectedServiceFilter = "ALL";
        selectedStatusFilter = "ALL";
        currentPage = 1;
    }

    private IEnumerable<MaintenanceLogModel> FilteredLogs
    {
        get
        {
            var query = maintenanceLogs.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                query = query.Where(m =>
                    m.EquipmentName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    m.EntityID.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(m.SerialNo) && m.SerialNo.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    m.ActorID.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    m.ActionDetails.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedServiceFilter != "ALL")
            {
                query = query.Where(m => m.ActionDetails.Contains($"[{selectedServiceFilter}", StringComparison.OrdinalIgnoreCase));
            }

            if (selectedStatusFilter != "ALL")
            {
                query = query.Where(m => m.EquipmentStatus.Equals(selectedStatusFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private bool IsItemCurrentlyInMaintenance(string equipmentId)
    {
        var item = equipmentList.FirstOrDefault(e => e.EquipmentID.Equals(equipmentId, StringComparison.OrdinalIgnoreCase));
        return item != null && item.IsMaintenance;
    }

    private void OpenLogMaintenanceModal()
    {
        maintenanceForm = new NewMaintenanceFormModel
        {
            EquipmentID = equipmentList.FirstOrDefault(e => e.IsAvailable && !e.IsDispatched)?.EquipmentID ?? string.Empty,
            ServiceType = "Repair",
            SubStatus = MaintenanceScheduleStatuses.SubUnderRepair,
            ActorID = GetCurrentActorId(),
            SetUnderMaintenance = true
        };
        logSubStatusChoice = MaintenanceScheduleStatuses.SubUnderRepair;
        formErrorMessage = null;
        isLogModalOpen = true;
    }

    private void OnLogSubStatusChoiceChanged(ChangeEventArgs e)
    {
        logSubStatusChoice = e.Value?.ToString() ?? MaintenanceScheduleStatuses.SubUnderRepair;
        maintenanceForm.SubStatus = logSubStatusChoice == "CUSTOM" ? string.Empty : logSubStatusChoice;
    }

    private void CloseLogModal()
    {
        isLogModalOpen = false;
        formErrorMessage = null;
    }

    private async Task HandleSubmitMaintenance()
    {
        if (string.IsNullOrEmpty(maintenanceForm.EquipmentID) || string.IsNullOrWhiteSpace(maintenanceForm.IssueDetails))
        {
            formErrorMessage = "Please select equipment and provide maintenance diagnosis details.";
            return;
        }

        isSubmitting = true;
        formErrorMessage = null;

        var (success, error) = await EquipmentService.LogMaintenanceAsync(
            maintenanceForm.EquipmentID,
            maintenanceForm.ServiceType,
            maintenanceForm.IssueDetails,
            maintenanceForm.ActorID,
            maintenanceForm.SetUnderMaintenance,
            maintenanceForm.SubStatus);

        isSubmitting = false;

        if (success)
        {
            isLogModalOpen = false;
            notificationMessage = $"Maintenance log successfully recorded in dbo.HistoryLog for equipment '{maintenanceForm.EquipmentID}'.";
            await LoadDataAsync();
        }
        else
        {
            formErrorMessage = error ?? "Failed to save maintenance log.";
        }
    }

    private void OpenResolveModal(MaintenanceLogModel log)
    {
        resolveTargetLog = log;
        resolveNotes = string.Empty;
        isResolveModalOpen = true;
    }

    private async Task ConfirmResolveMaintenance()
    {
        if (resolveTargetLog == null || string.IsNullOrWhiteSpace(resolveNotes))
            return;

        var (success, _) = await EquipmentService.ResolveMaintenanceAsync(
            resolveTargetLog.EntityID,
            resolveNotes,
            GetCurrentActorId());

        isResolveModalOpen = false;

        if (success)
        {
            notificationMessage = $"Equipment '{resolveTargetLog.EquipmentName}' restored to 'Available'. Resolution audit log recorded in dbo.HistoryLog.";
            await LoadDataAsync();
        }
    }

    private void OpenUpdateScheduleModal(MaintenanceScheduleModel schedule)
    {
        updateTargetSchedule = schedule;
        updateScheduleStatus = string.IsNullOrWhiteSpace(schedule.Status)
            ? MaintenanceScheduleStatuses.InMaintenance
            : schedule.Status;
        var currentSub = string.IsNullOrWhiteSpace(schedule.SubStatus)
            ? MaintenanceScheduleStatuses.SubUnderRepair
            : schedule.SubStatus;
        updateScheduleSubStatus = currentSub;
        updateSubStatusChoice = MaintenanceScheduleStatuses.DefaultSubStatuses.Contains(currentSub, StringComparer.OrdinalIgnoreCase)
            ? MaintenanceScheduleStatuses.DefaultSubStatuses.First(s => s.Equals(currentSub, StringComparison.OrdinalIgnoreCase))
            : "CUSTOM";
        updateScheduleNotes = schedule.ResolutionNotes ?? string.Empty;
        updateModalError = null;
        isUpdateModalOpen = true;
    }

    private void CloseUpdateScheduleModal()
    {
        isUpdateModalOpen = false;
        updateTargetSchedule = null;
        updateModalError = null;
    }

    private void OnUpdateSubStatusChoiceChanged(ChangeEventArgs e)
    {
        updateSubStatusChoice = e.Value?.ToString() ?? MaintenanceScheduleStatuses.SubUnderRepair;
        updateScheduleSubStatus = updateSubStatusChoice == "CUSTOM" ? string.Empty : updateSubStatusChoice;
    }

    private async Task ConfirmUpdateScheduleAsync()
    {
        if (updateTargetSchedule == null)
            return;

        if (updateScheduleStatus == MaintenanceScheduleStatuses.InMaintenance && string.IsNullOrWhiteSpace(updateScheduleSubStatus))
        {
            updateModalError = "Please choose or enter a work sub-status.";
            return;
        }

        isSubmitting = true;
        updateModalError = null;

        var subToSend = updateScheduleStatus == MaintenanceScheduleStatuses.InMaintenance
            ? updateScheduleSubStatus.Trim()
            : null;

        var (success, error) = await EquipmentService.UpdateMaintenanceScheduleAsync(
            updateTargetSchedule.MaintenanceScheduleID,
            updateTargetSchedule.EquipmentID,
            updateScheduleStatus,
            subToSend,
            updateScheduleNotes,
            GetCurrentActorId());

        isSubmitting = false;

        if (success)
        {
            var equipmentLabel = updateTargetSchedule.EquipmentName;
            isUpdateModalOpen = false;
            updateTargetSchedule = null;
            notificationMessage = updateScheduleStatus == MaintenanceScheduleStatuses.Available
                ? $"Equipment '{equipmentLabel}' resolved and restored to 'Available'."
                : updateScheduleStatus == MaintenanceScheduleStatuses.NeedsReplacement
                    ? $"Equipment '{equipmentLabel}' marked as 'Needs Replacement'."
                    : $"Maintenance schedule for '{equipmentLabel}' updated ({subToSend}).";
            await LoadDataAsync();
        }
        else
        {
            updateModalError = error ?? "Failed to update maintenance schedule.";
        }
    }

    private void ViewDetails(MaintenanceLogModel log)
    {
        detailsModalLog = log;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "MN";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }

    public void Dispose()
    {
        EquipmentService.OnChange -= HandleExternalStateChange;
    }
}
