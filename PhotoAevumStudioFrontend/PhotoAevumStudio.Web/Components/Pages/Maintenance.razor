<!-- MODAL: UPDATE MAINTENANCE SCHEDULE                                        -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
@if (isUpdateModalOpen && updateTargetSchedule != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="relative bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-150">
            <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-sm text-white">Update Maintenance Schedule</h3>
                    <p class="text-[11px] text-slate-300">Update work status or resolve equipment condition</p>
                </div>
                <button type="button" @onclick="CloseUpdateScheduleModal" class="text-slate-300 hover:text-white font-bold">&times;</button>
            </div>

            <div class="p-6 space-y-4 text-xs">
                @if (!string.IsNullOrEmpty(updateModalError))
                {
                    <div class="p-3 bg-rose-50 border border-rose-200 text-rose-800 rounded-lg text-xs">
                        @updateModalError
                    </div>
                }

                <div>
                    <span class="text-slate-400 uppercase text-[10px] font-bold">Equipment</span>
                    <p class="text-sm font-bold text-slate-900">@updateTargetSchedule.EquipmentName</p>
                    <p class="font-mono text-slate-500">ID: @updateTargetSchedule.EquipmentID @(!string.IsNullOrEmpty(updateTargetSchedule.SerialNo) ? $"| SN: {updateTargetSchedule.SerialNo}" : "")</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Resolution / Status <span class="text-rose-500">*</span>
                    </label>
                    <select @bind="updateScheduleStatus"
                            class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 bg-white text-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900">
                        <option value="@MaintenanceScheduleStatuses.InMaintenance">In Maintenance</option>
                        <option value="@MaintenanceScheduleStatuses.Available">Available (Restore availability)</option>
                        <option value="@MaintenanceScheduleStatuses.NeedsReplacement">Needs Replacement (Unfixable)</option>
                    </select>
                </div>

                @if (updateScheduleStatus == MaintenanceScheduleStatuses.InMaintenance)
                {
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                            Work Sub-Status <span class="text-rose-500">*</span>
                        </label>
                        <select value="@updateSubStatusChoice" @onchange="OnUpdateSubStatusChoiceChanged"
                                class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 bg-white text-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900">
                            @foreach (var sub in MaintenanceScheduleStatuses.DefaultSubStatuses)
                            {
                                <option value="@sub">@sub</option>
                            }
                            <option value="CUSTOM">Other (Custom sub-status...)</option>
                        </select>
                        @if (updateSubStatusChoice == "CUSTOM")
                        {
                            <input type="text"
                                   @bind="updateScheduleSubStatus"
                                   placeholder="Enter custom work sub-status"
                                   class="mt-2 w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-slate-900" />
                        }
                    </div>
                }

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Update Notes
                    </label>
                    <textarea @bind="updateScheduleNotes"
                              rows="3"
                              placeholder="Optional diagnostic progress, repair details, or replacement reason..."
                              class="w-full px-3 py-2 text-xs rounded-lg border border-slate-300 focus:outline-none focus:ring-1 focus:ring-slate-900"></textarea>
                </div>
            </div>

            <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-3">
                <button type="button"
                        @onclick="CloseUpdateScheduleModal"
                        class="px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-900">
                    Cancel
                </button>
                <button type="button"
                        @onclick="ConfirmUpdateScheduleAsync"
                        disabled="@isSubmitting"
                        class="px-5 py-2 bg-slate-900 hover:bg-black text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-sm transition-all disabled:opacity-50">
                    @(isSubmitting ? "Saving..." : "Save Update")
                </button>
            </div>
        </div>
    </div>
}

