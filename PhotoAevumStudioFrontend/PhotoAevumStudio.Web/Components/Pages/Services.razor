@page "/admin/services"
@page "/Dashboard/Services"
@inherits ServicesBase
@using YourNamespace.ViewModels;

<div class="dashboard-layout d-flex min-vh-100">
    <!-- Persistent Left Navigation Bar -->
    <nav class="sidebar bg-navy text-white p-3" style="width: 260px; background-color: #0f172a;">
        <h4 class="brand mb-4 text-white font-weight-bold">Operations</h4>
        <ul class="nav flex-column">
            <li class="nav-item mb-2"><a href="/Dashboard" class="nav-link text-white-50">Dashboard</a></li>
            <li class="nav-item mb-2"><a href="/Dashboard/Schedules" class="nav-link text-white-50">Schedules</a></li>
            <li class="nav-item mb-2"><a href="/Dashboard/Services" class="nav-link text-white active fw-bold bg-teal rounded">Services</a></li>
            <li class="nav-item mb-2"><a href="/Dashboard/Equipment" class="nav-link text-white-50">Equipment</a></li>
            <li class="nav-item mb-2"><a href="/Dashboard/Employees" class="nav-link text-white-50">Employees</a></li>
        </ul>
    </nav>

    <!-- Main Content Panel -->
    <main class="main-content p-4 bg-light flex-grow-1">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Services</h2>
                <p class="text-muted">Company's full service catalog and pricing options.</p>
            </div>
            <button class="btn btn-primary" @onclick="OpenAddServiceModal">+ Add Service</button>
        </div>

        <div class="card shadow-sm border-0 rounded-3 p-3 bg-white">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Service Name</th>
                        <th>Type / Kind</th>
                        <th>Duration</th>
                        <th>Price</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ServicesList != null)
                    {
                        @foreach (var item in ServicesList)
                        {
                            <tr>
                                <td>SRV-@item.Id</td>
                                <td><strong>@item.Name</strong></td>
                                <td>@item.Kind</td>
                                <td>@item.Duration mins</td>
                                <td>$@item.Price.ToString("N2")</td>
                                <td><span class="badge bg-success">Active</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
