@page "/admin/services"
@layout AdminLayout
@rendermode InteractiveServer

<div class="flex justify-between items-center mb-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Services</h1>
        <p class="text-gray-500 mt-1">Manage studio offerings and combo packages.</p>
    </div>
    <button @onclick="() => isWizardOpen = true" class="btn btn--primary flex items-center gap-2">
        <i data-lucide="plus" class="w-4 h-4"></i> Add Service
    </button>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="w-full text-left text-sm">
        <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase text-xs font-semibold">
            <tr>
                <th class="px-6 py-4">Service Name</th>
                <th class="px-6 py-4">Type</th>
                <th class="px-6 py-4">Duration</th>
                <th class="px-6 py-4 text-right">Price</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var service in ServicesList)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 font-medium text-gray-900">@service.Name</td>
                    <td class="px-6 py-4 text-gray-500">@service.Kind</td>
                    <td class="px-6 py-4 text-gray-500">@service.Duration mins</td>
                    <td class="px-6 py-4 text-right font-semibold text-gray-900">₱@service.Price.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<AddServicesWizard @bind-IsOpen="isWizardOpen" />

@code {
    private bool isWizardOpen = false;

    protected List<ServiceItem> ServicesList { get; set; } = new()
    {
        new ServiceItem { Id = 1041, Name = "Portrait Session", Kind = "Portrait", Duration = 60, Price = 5000.00m },
        new ServiceItem { Id = 1042, Name = "Event Coverage", Kind = "Event", Duration = 240, Price = 15000.00m },
        new ServiceItem { Id = 1043, Name = "Studio Session Combo", Kind = "Studio Session", Duration = 120, Price = 8000.00m }
    };

    public class ServiceItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Kind { get; set; } = string.Empty;
        public int Duration { get; set; }
        public decimal Price { get; set; }
    }
}