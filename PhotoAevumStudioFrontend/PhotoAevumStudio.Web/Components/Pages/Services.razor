@page "/services"
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IUserService UserService
@inject IServicesApiClient ServicesApi
@inject NavigationManager NavigationManager

<PageTitle>Featured Studio Services | Photo Aevum Studio</PageTitle>

@* ── Minimalist Sticky Sub-Header ────────────────────────────────────────── *@
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        @* Studio Brand Logo & Title *@
        <a href="/" class="flex items-center gap-3 group">
            <img src="images/AevumLogo.jpg" alt="Photo Aevum Logo" class="h-9 w-auto rounded-full transition-transform group-hover:scale-105" />
            <span class="font-bold text-lg tracking-tight uppercase tracking-widest text-slate-900">Photo Aevum Studio</span>
        </a>

        @* Header Actions *@
        <div class="flex items-center gap-3">
            <a href="/"
               class="inline-flex items-center gap-2 border border-slate-300 text-slate-700 hover:border-slate-900 hover:text-slate-900 px-4 py-2 rounded-none font-medium text-xs uppercase tracking-wider transition-colors bg-white">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Back to Home</span>
            </a>
            <a href="/schedule"
               class="hidden sm:inline-flex items-center gap-1.5 bg-slate-900 hover:bg-black text-white px-5 py-2 rounded-none font-medium text-xs uppercase tracking-wider transition-colors">
                <span>Book Session</span>
                <span aria-hidden="true">&rarr;</span>
            </a>
        </div>
    </div>
</header>

@* ── Main Services Content Canvas ────────────────────────────────────────── *@
<div class="bg-[#FAF9F6] min-h-screen text-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">

        @* ── Breadcrumb Navigation ────────────────────────────────────────── *@
        <nav class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-8" aria-label="Breadcrumb">
            <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
            <span class="text-slate-400">/</span>
            <span class="text-slate-500">Catalog</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-900 font-bold">Featured Services</span>
        </nav>

        @* ── Minimalist Hero Header ────────────────────────────────────────── *@
        <header class="mb-12 sm:mb-16">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-slate-900 text-white text-[11px] font-semibold uppercase tracking-widest rounded-none mb-6">
                <span class="text-amber-400">★</span>
                <span>Curated Studio Signature Offerings</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-tight mb-4 uppercase tracking-widest">
                Featured Services
            </h1>
            <p class="text-base sm:text-lg text-slate-600 font-light max-w-2xl leading-relaxed">
                Discover our signature photography sessions, multi-service package bundles, and creative enhancements with transparent pricing and zero hidden fees.
            </p>
        </header>

        @* ── Category Filter Tabs ──────────────────────────────────────────── *@
        <div class="flex flex-wrap items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200">
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Featured service category">
                @foreach (var kind in FeaturedKinds)
                {
                    var k = kind;
                    var isSelected = _kindFilter == k;
                    <button type="button"
                            role="tab"
                            aria-selected="@(isSelected ? "true" : "false")"
                            @onclick="() => _kindFilter = k"
                            class="px-4 py-2 text-xs font-bold uppercase tracking-wider border transition-all @(isSelected ? "bg-slate-900 text-white border-slate-900 shadow-xs" : "bg-white text-slate-600 border-slate-300 hover:border-slate-900")">
                        @k <span class="opacity-70 ml-1">(@GetCount(k))</span>
                    </button>
                }
            </div>

            <div class="text-xs text-slate-500 font-medium">
                Showing <strong>@VisibleServices.Count()</strong> featured @(_kindFilter == "All" ? "services & bundles" : _kindFilter.ToLower() + "s")
            </div>
        </div>

        @* ── Service Cards Grid ───────────────────────────────────────────── *@
        @if (_loading)
        {
            <div class="py-24 text-center">
                <span class="inline-block w-8 h-8 border-2 border-slate-300 border-t-slate-900 rounded-full animate-spin mb-3"></span>
                <p class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Loading curated studio services...</p>
            </div>
        }
        else if (!VisibleServices.Any())
        {
            <div class="p-16 text-center bg-white border border-slate-200 rounded-xl shadow-xs">
                <span class="text-4xl block mb-2">📸</span>
                <h3 class="text-lg font-bold text-slate-900">No Featured Services Found</h3>
                <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
                    @(_pool.Count == 0 
                        ? "Curated services will be listed here once starred in studio administration." 
                        : "No featured items match the selected category. Please choose another tab above.")
                </p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var card in VisibleServices)
                {
                    <article class="bg-white border border-slate-200 p-6 flex flex-col justify-between hover:shadow-xl transition-all duration-300 rounded-xl group">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500">@card.Kind</span>
                                <span class="bg-amber-400 text-slate-950 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-xs">
                                    ★ Featured
                                </span>
                            </div>

                            <h3 class="text-xl font-black text-slate-900 tracking-tight mb-2 group-hover:text-amber-600 transition-colors">
                                @card.Title
                            </h3>
                            
                            <div class="text-2xl font-black font-mono text-slate-900 mb-4 tracking-tight">
                                @card.PriceText
                            </div>

                            <p class="text-slate-600 font-light text-xs leading-relaxed mb-6 line-clamp-3">
                                @card.Description
                            </p>
                        </div>

                        <div class="pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
                            <span class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold truncate mr-2">
                                @card.Meta
                            </span>
                            <a href="/schedule" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-900 uppercase tracking-wider hover:translate-x-0.5 transition-transform whitespace-nowrap">
                                <span>Book Now</span>
                                <span>&rarr;</span>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }

        @* ── Custom Shoot Consultation Banner ────────────────────────────── *@
        <div class="mt-16 p-8 bg-slate-900 text-white rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-6 shadow-lg">
            <div>
                <span class="text-xs uppercase tracking-widest font-bold text-amber-400 block mb-1">Custom Inquiries</span>
                <h3 class="text-xl font-bold">Have unique production requirements?</h3>
                <p class="text-xs text-slate-400 mt-1 max-w-md font-light">
                    Book an online consultation with our Office Clerk desk to customize equipment, creative crew, and studio packages.
                </p>
            </div>
            <a href="/schedule" class="bg-white hover:bg-slate-100 text-slate-950 font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-none transition-colors whitespace-nowrap">
                Schedule Consultation &rarr;
            </a>
        </div>

    </div>
</div>

@code {
    private bool _loading = true;
    private string _kindFilter = "All";
    private List<FeaturedServiceCard> _pool = new();
    private static readonly string[] FeaturedKinds = { "All", "Main Service", "Package", "Add-On" };

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _pool = await LoadFeaturedPoolAsync();
        }
        catch
        {
            _pool = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<FeaturedServiceCard> VisibleServices =>
        _kindFilter == "All" ? _pool : _pool.Where(c => c.Kind == _kindFilter);

    private int GetCount(string kind) =>
        kind == "All" ? _pool.Count : _pool.Count(c => c.Kind == kind);

    private async Task<List<FeaturedServiceCard>> LoadFeaturedPoolAsync()
    {
        var mainCodes = await ServicesApi.GetFeaturedCodesAsync(FeaturedEntityTypes.Main);
        var packageCodes = await ServicesApi.GetFeaturedCodesAsync(FeaturedEntityTypes.Package);
        var addOnCodes = await ServicesApi.GetFeaturedCodesAsync(FeaturedEntityTypes.AddOn);

        var list = new List<FeaturedServiceCard>();

        list.AddRange(UserService.GetMainServices()
            .Where(s => s.IsActive && mainCodes.Contains(s.Code))
            .Select(s => new FeaturedServiceCard(
                s.Code, "Main Service", s.Title,
                s.BasePrice > 0 ? $"₱{s.BasePrice:N0}" : "Custom Quote",
                !string.IsNullOrWhiteSpace(s.Description) ? s.Description! : "Professional photography session executed in our premium studio bay.",
                $"{s.Duration} • {s.Category}")));

        list.AddRange(UserService.GetPackageServices()
            .Where(p => p.IsActive && packageCodes.Contains(p.Code))
            .Select(p => new FeaturedServiceCard(
                p.Code, "Package", p.Title, p.Price,
                !string.IsNullOrWhiteSpace(p.Description) ? p.Description! : "A curated bundle of studio services at a package rate.",
                !string.IsNullOrWhiteSpace(p.SavingsNote) ? p.SavingsNote! : p.BundleCategory)));

        list.AddRange(UserService.GetAdditionalServices()
            .Where(a => a.IsActive && addOnCodes.Contains(a.Code))
            .Select(a => new FeaturedServiceCard(
                a.Code, "Add-On", a.Title, a.PriceText,
                !string.IsNullOrWhiteSpace(a.Description) ? a.Description! : "Enhance your session with this optional extra.",
                a.TypeCategory)));

        return list;
    }
}
