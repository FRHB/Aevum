@page "/checkout/confirm/{AppointmentId}"
@layout MainLayout
@using System.Net.Http.Json
@using PhotoAevumStudio.Web.Models
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@rendermode InteractiveServer

@* Mock Xendit payment page. Opened by scanning the reservation QR (phone or laptop webcam), so it is anonymous:
   the visitor may have no login session. It only uses the anonymous summary + simulate endpoints. *@

<PageTitle>Confirm Payment - Photo Aevum Studio</PageTitle>

<div class="min-h-screen bg-slate-50 py-8 px-4">
    <div class="max-w-md mx-auto">
        <div class="flex items-center gap-3 mb-6">
            <img src="images/AevumLogo.jpg" alt="Photo Aevum Studio" class="h-10 w-10 rounded-full shadow-sm" />
            <div>
                <h1 class="text-lg font-bold text-slate-900 leading-tight">Photo Aevum Studio</h1>
                <p class="text-xs text-slate-500">Xendit QR Payment (Test Mode)</p>
            </div>
        </div>

        @if (_loading)
        {
            <p class="text-sm text-slate-500" role="status">Loading payment details&hellip;</p>
        }
        else if (_info is null)
        {
            <div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-800" role="alert">
                We couldn't find that reservation (#@AppointmentId). Please re-scan the QR code.
            </div>
        }
        else if (_paid || _info.EventStatus == "Confirmed")
        {
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-8 text-center shadow-sm" role="status">
                <div class="text-5xl mb-3">&#10003;</div>
                <h2 class="text-2xl font-black text-emerald-900">Payment Successful</h2>
                <p class="mt-2 text-sm text-emerald-800">
                    Your reservation fee for <strong>@_info.EventName</strong> (#@_info.AppointmentId) has been received.
                </p>
                <a href="/my/bookings" class="inline-block mt-6 px-5 py-2.5 rounded-xl bg-emerald-700 text-white text-sm font-bold">View My Bookings</a>
            </div>
        }
        else if (_info.EventStatus is "Cancelled" or "Expired")
        {
            <div class="rounded-2xl border border-red-200 bg-red-50 p-8 text-center shadow-sm" role="alert">
                <h2 class="text-xl font-black text-red-900">Reservation Expired</h2>
                <p class="mt-2 text-sm text-red-800">
                    The reservation fee for <strong>@_info.EventName</strong> (#@_info.AppointmentId) was not received in time and the slot was released.
                </p>
            </div>
        }
        else
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-xl font-black text-slate-900">Reservation Fee</h2>
                <dl class="mt-4 space-y-2 text-sm">
                    <div class="flex justify-between"><dt class="text-slate-500">Booking</dt><dd class="font-semibold text-slate-800">@_info.EventName</dd></div>
                    <div class="flex justify-between"><dt class="text-slate-500">Reference</dt><dd class="font-mono font-semibold text-slate-800">#@_info.AppointmentId</dd></div>
                    <div class="flex justify-between"><dt class="text-slate-500">Date</dt><dd class="font-semibold text-slate-800">@_info.EventDate.ToString("MMMM dd, yyyy") at @DateTime.Today.Add(_info.EventTime).ToString("h:mm tt")</dd></div>
                </dl>

                <div class="mt-5 rounded-xl bg-slate-50 border border-slate-200 p-4 text-center">
                    <div class="text-xs uppercase tracking-wider font-bold text-slate-500">Amount to pay</div>
                    <div class="mt-1 text-3xl font-black text-slate-900">&#8369;@_info.Amount.ToString("N2")</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="mt-4 text-xs rounded-lg px-3 py-2 bg-red-50 text-red-700 border border-red-200" role="alert">@_error</p>
                }

                <button type="button" @onclick="ConfirmAsync" disabled="@_busy"
                        class="mt-5 w-full py-3.5 rounded-xl bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-sm font-black shadow-sm transition-colors">
                    @(_busy ? "Processing payment…" : "Confirm Payment")
                </button>
                <p class="mt-3 text-[11px] text-center text-slate-400">Test mode only: no real money is charged.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string AppointmentId { get; set; } = string.Empty;

    private QrPaymentInfoDto? _info;
    private bool _loading = true;
    private bool _busy;
    private bool _paid;
    private string? _error;

    private HttpClient Api => HttpFactory.CreateClient("AevumApi.Anonymous");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            using var res = await Api.GetAsync($"api/payments/qr/{Uri.EscapeDataString(AppointmentId)}/public");
            _info = res.IsSuccessStatusCode ? await res.Content.ReadFromJsonAsync<QrPaymentInfoDto>() : null;
        }
        catch
        {
            _info = null;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            using var res = await Api.PostAsync($"api/payments/simulate-qr/{Uri.EscapeDataString(AppointmentId)}", null);
            if (!res.IsSuccessStatusCode)
            {
                _error = await ReadMessageAsync(res) ?? "Payment could not be completed. Please try again.";
                return;
            }

            // Xendit confirms asynchronously via webhook; wait briefly for the booking to flip to Confirmed.
            for (var i = 0; i < 10 && !_paid; i++)
            {
                await Task.Delay(1500);
                await LoadAsync();
                _paid = _info?.EventStatus == "Confirmed";
                StateHasChanged();
            }

            if (_paid)
            {
                await Task.Delay(3000);
                Nav.NavigateTo("/my/bookings");
            }
            else
            {
                _error = "Payment sent. Confirmation is still pending; check My Bookings in a moment.";
            }
        }
        catch (Exception ex)
        {
            _error = "Payment request failed: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static async Task<string?> ReadMessageAsync(HttpResponseMessage res)
    {
        try
        {
            using var doc = await System.Text.Json.JsonDocument.ParseAsync(await res.Content.ReadAsStreamAsync());
            return doc.RootElement.TryGetProperty("message", out var m) ? m.GetString() : null;
        }
        catch { return null; }
    }
}
