@page "/checkout/confirm/{AppointmentId}"
@layout MainLayout
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IHttpClientFactory HttpFactory
@inject IScheduleService ScheduleService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

@* Mock/Test-mode Xendit payment page. Opened by scanning the reservation QR (phone, another device, or laptop webcam),
   so it works anonymously without requiring a login session on the scanning device. *@

<PageTitle>Confirm Payment - Photo Aevum Studio</PageTitle>

<div class="min-h-screen bg-slate-50 py-8 px-4">
    <div class="max-w-md mx-auto">
        <div class="flex items-center gap-3 mb-6">
            <img src="images/AevumLogo.jpg" alt="Photo Aevum Studio" class="h-10 w-10 rounded-full shadow-sm" />
            <div>
                <h1 class="text-lg font-bold text-slate-900 leading-tight">Photo Aevum Studio</h1>
                <p class="text-xs text-slate-500">Xendit QR Payment (Test Mode)</p>
            </div>
        </div>

        @if (_loading)
        {
            <p class="text-sm text-slate-500" role="status">Loading payment details&hellip;</p>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-800 space-y-3" role="alert">
                <p>@_loadError</p>
                <button type="button" @onclick="RetryLoadAsync"
                        class="px-4 py-2 rounded-lg bg-slate-900 text-white text-xs font-bold">
                    Try Again
                </button>
            </div>
        }
        else if (_info is null)
        {
            <div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-800" role="alert">
                We couldn't find that reservation (#@AppointmentId). Please re-scan the QR code.
            </div>
        }
        else if (_paid || IsAlreadyPaid(_info))
        {
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-8 text-center shadow-sm" role="status">
                <div class="text-5xl mb-3">&#10003;</div>
                <h2 class="text-2xl font-black text-emerald-900">Payment Successful</h2>
                <p class="mt-2 text-sm text-emerald-800">
                    @(_info.IsFinalPayment
                        ? $"Your final balance payment for {_info.EventName} (#{_info.AppointmentId}) is verified (Payment Verification (QR:Paid)). Event marked Completed, and confirmation emails have been sent to both you and the Team Leader."
                        : $"Your reservation fee for {_info.EventName} (#{_info.AppointmentId}) has been received.")
                </p>
                <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-2.5">
                    @if (_isAuthenticated)
                    {
                        <a href="/my/bookings" class="inline-block px-5 py-2.5 rounded-xl bg-emerald-700 text-white text-sm font-bold">View My Bookings</a>
                    }
                    else
                    {
                        <a href="/login?returnUrl=%2Fmy%2Fbookings" class="inline-block px-5 py-2.5 rounded-xl bg-emerald-700 text-white text-sm font-bold">Sign In to View Bookings</a>
                        <a href="/" class="inline-block px-5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-700 text-sm font-bold">Back to Home</a>
                    }
                </div>
            </div>
        }
        else if (_info.EventStatus is "Cancelled" or "Expired" or "Deal_Lost" || IsHoldExpired(_info))
        {
            <div class="rounded-2xl border border-red-200 bg-red-50 p-8 text-center shadow-sm" role="alert">
                <h2 class="text-xl font-black text-red-900">Reservation Expired</h2>
                <p class="mt-2 text-sm text-red-800">
                    The reservation fee for <strong>@_info.EventName</strong> (#@_info.AppointmentId) was not received in time and the slot was released.
                </p>
            </div>
        }
        else
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-xl font-black text-slate-900">@(_info.IsFinalPayment ? "Final Balance Settlement" : "Reservation Fee")</h2>
                <dl class="mt-4 space-y-2 text-sm">
                    <div class="flex justify-between"><dt class="text-slate-500">Booking</dt><dd class="font-semibold text-slate-800">@_info.EventName</dd></div>
                    <div class="flex justify-between"><dt class="text-slate-500">Reference</dt><dd class="font-mono font-semibold text-slate-800">#@_info.AppointmentId</dd></div>
                    <div class="flex justify-between"><dt class="text-slate-500">Date</dt><dd class="font-semibold text-slate-800">@_info.EventDate.ToString("MMMM dd, yyyy") at @DateTime.Today.Add(_info.EventTime).ToString("h:mm tt")</dd></div>
                </dl>

                <div class="mt-5 rounded-xl bg-slate-50 border border-slate-200 p-4 text-center">
                    <div class="text-xs uppercase tracking-wider font-bold text-slate-500">Amount to pay</div>
                    <div class="mt-1 text-3xl font-black text-slate-900">&#8369;@_info.Amount.ToString("N2")</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="mt-4 text-xs rounded-lg px-3 py-2 bg-red-50 text-red-700 border border-red-200" role="alert">@_error</p>
                }

                <button type="button" @onclick="ConfirmAsync" disabled="@_busy"
                        class="mt-5 w-full py-3.5 rounded-xl bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-sm font-black shadow-sm transition-colors">
                    @(_busy ? "Processing payment…" : "Confirm Payment")
                </button>
                <p class="mt-3 text-[11px] text-center text-slate-400">Test mode only: no real money is charged.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string AppointmentId { get; set; } = string.Empty;

    private QrPaymentInfoDto? _info;
    private bool _loading = true;
    private bool _busy;
    private bool _paid;
    private bool _isAuthenticated;
    private string? _error;
    private string? _loadError;

    private HttpClient Api => HttpFactory.CreateClient("AevumApi.Anonymous");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        }
        catch
        {
            _isAuthenticated = false;
        }

        await LoadAsync();
        _loading = false;
        StateHasChanged();
    }

    private async Task RetryLoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        await LoadAsync();
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            using var res = await Api.GetAsync($"api/payments/qr/{Uri.EscapeDataString(AppointmentId)}/public");
            if (res.IsSuccessStatusCode)
            {
                _info = await res.Content.ReadFromJsonAsync<QrPaymentInfoDto>();
            }
            else if (res.StatusCode == HttpStatusCode.NotFound)
            {
                _info = null;
            }
            else
            {
                _info = null;
                _loadError = await ReadMessageAsync(res) ?? "Could not load payment details right now. Please try again.";
            }
        }
        catch
        {
            _info = null;
            _loadError = "Unable to reach the payment server. Please check your connection and try again.";
        }
    }

    private static bool IsHoldExpired(QrPaymentInfoDto info) =>
        !info.IsFinalPayment &&
        info.LockExpiresAt.HasValue &&
        DateTime.SpecifyKind(info.LockExpiresAt.Value, DateTimeKind.Utc) <= DateTime.UtcNow;

    private static bool IsAlreadyPaid(QrPaymentInfoDto? info)
    {
        if (info is null) return false;
        if (info.IsFinalPayment)
        {
            return string.Equals(info.EventStatus, "Completed", StringComparison.OrdinalIgnoreCase)
                || string.Equals(info.EventStatus, "Complete", StringComparison.OrdinalIgnoreCase)
                || string.Equals(info.EventStatus, "Shot", StringComparison.OrdinalIgnoreCase)
                || string.Equals(info.EventStatus, "Delivered", StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(info.EventStatus, "Confirmed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Preparation", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Preparing", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Dispatch", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Ongoing", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "On Going", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "In Execution", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Ready", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Event Done", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Post Event", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Shot", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Complete", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(info.EventStatus, "Delivered", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ConfirmAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            using var res = await Api.PostAsync($"api/payments/simulate-qr/{Uri.EscapeDataString(AppointmentId)}", null);
            if (!res.IsSuccessStatusCode)
            {
                var apiMsg = await ReadMessageAsync(res);
                _error = !string.IsNullOrWhiteSpace(apiMsg)
                    ? apiMsg
                    : (res.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden
                        ? "Payment authorization failed. Please refresh and try again."
                        : "Payment could not be completed right now. Please try again.");
                return;
            }

            // Wait briefly for the booking to flip to Confirmed or Completed (for Final Balance).
            for (var i = 0; i < 10 && !_paid; i++)
            {
                await LoadAsync();
                _paid = IsAlreadyPaid(_info);
                if (_paid) break;
                await Task.Delay(1000);
            }

            StateHasChanged();
            if (_paid)
            {
                ScheduleService.InvalidateCache();
                if (_isAuthenticated)
                {
                    await Task.Delay(2500);
                    Nav.NavigateTo("/my/bookings");
                }
            }
            else
            {
                _error = "Payment sent. Confirmation is still pending; check My Bookings in a moment.";
            }
        }
        catch (Exception ex)
        {
            _error = "Payment request failed: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static async Task<string?> ReadMessageAsync(HttpResponseMessage res)
    {
        try
        {
            var raw = await res.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(raw)) return null;
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            foreach (var prop in new[] { "message", "detail", "title" })
            {
                if (doc.RootElement.TryGetProperty(prop, out var m) && m.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var val = m.GetString();
                    if (!string.IsNullOrWhiteSpace(val)) return val;
                }
            }
            return null;
        }
        catch { return null; }
    }
}
