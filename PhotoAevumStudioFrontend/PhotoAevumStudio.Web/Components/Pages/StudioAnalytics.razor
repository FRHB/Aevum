@page "/analytics"
@page "/admin/analytics"
@page "/analytics/{Stage}"
@page "/admin/analytics/{Stage}"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SystemAdmin,System Admin,Super Admin,Office Clerk")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IAnalyticsClient AnalyticsClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Studio Analytics | Photo Aevum Studio</PageTitle>

<div class="aev-analytics-shell space-y-6">
    @* ── Top Header & Shared Controls ──────────────────────────────────────── *@
    <div class="flex flex-col xl:flex-row xl:items-center xl:justify-between gap-4 pb-5 border-b border-slate-800">
        <div>
            <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1">
                <span>Sales &amp; Report</span>
                <span class="text-slate-600">/</span>
                <span>Studio Analytics</span>
                <span class="text-slate-600">/</span>
                <span class="text-teal-400">@GetStageDisplayName(_activeStage)</span>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-50 tracking-tight">Studio Analytics</h1>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-teal-500/15 text-teal-300 border border-teal-500/30">
                    @GetStageQuestion(_activeStage)
                </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
                Operational intelligence across bookings, crew timesheets, leaves, consultations, and camera/lighting inventory.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button type="button" @onclick="LoadAnalyticsAsync" disabled="@_isLoading"
                    class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-slate-200 disabled:opacity-50 transition-colors">
                <span>@(_isLoading ? "Refreshing…" : "Refresh")</span>
            </button>
            <button type="button" @onclick="ExportCsvAsync" disabled="@(_isExporting || _overview is null)"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-teal-600 hover:bg-teal-500 disabled:opacity-50 text-xs font-bold text-slate-950 shadow-sm transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>@(_isExporting ? "Exporting…" : "Export CSV")</span>
            </button>
        </div>
    </div>

    @* ── Shared Filter Bar ─────────────────────────────────────────────────── *@
    <div class="aev-analytics-card p-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Preset Window</label>
                <select value="@_selectedPreset" @onchange="OnPresetChangedAsync" class="aev-filter-input w-full">
                    <option value="30d">Last 30 Days</option>
                    <option value="90d">Last 90 Days</option>
                    <option value="ytd">Year to Date</option>
                    <option value="all">All History (24M)</option>
                    <option value="custom">Custom Range</option>
                </select>
            </div>

            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Start Date</label>
                <input type="date" value="@_startDate.ToString("yyyy-MM-dd")" @onchange="OnStartDateChangedAsync" class="aev-filter-input w-full" />
            </div>

            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">End Date</label>
                <input type="date" value="@_endDate.ToString("yyyy-MM-dd")" @onchange="OnEndDateChangedAsync" class="aev-filter-input w-full" />
            </div>

            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Booking Status</label>
                <select value="@_statusFilter" @onchange="OnStatusFilterChangedAsync" class="aev-filter-input w-full">
                    <option value="All">All Statuses</option>
                    <option value="Completed">Completed / Delivered</option>
                    <option value="Confirmed">Confirmed / Active</option>
                    <option value="Pending">Pending / Hold</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="Expired">Expired</option>
                </select>
            </div>

            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Service Category</label>
                <select value="@_categoryFilter" @onchange="OnCategoryFilterChangedAsync" class="aev-filter-input w-full">
                    <option value="All">All Categories</option>
                    @if (_overview?.AvailableServiceCategories is not null)
                    {
                        @foreach (var cat in _overview.AvailableServiceCategories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Time Bucket</label>
                <div class="grid grid-cols-2 gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800">
                    <button type="button" @onclick='() => SetGranularityAsync("month")'
                            class="py-1.5 text-xs font-semibold rounded-md transition-colors @(_granularity == "month" ? "bg-teal-600 text-slate-950 font-bold" : "text-slate-400 hover:text-slate-200")">
                        Monthly
                    </button>
                    <button type="button" @onclick='() => SetGranularityAsync("week")'
                            class="py-1.5 text-xs font-semibold rounded-md transition-colors @(_granularity == "week" ? "bg-teal-600 text-slate-950 font-bold" : "text-slate-400 hover:text-slate-200")">
                        Weekly
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_bannerMessage))
    {
        <div class="px-4 py-3 rounded-xl border text-xs font-semibold flex items-center justify-between @(_bannerIsError ? "bg-rose-950/60 border-rose-500/40 text-rose-200" : "bg-emerald-950/60 border-emerald-500/40 text-emerald-200")">
            <span>@_bannerMessage</span>
            <button type="button" @onclick="() => _bannerMessage = null" class="text-slate-300 hover:text-white font-bold ml-4">✕</button>
        </div>
    }

    @* ── Main Two-Column Workspace: Left-Rail Navigation + Stage Panel ─────── *@
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        @* Left Rail *@
        <aside class="lg:col-span-3 space-y-4 lg:sticky lg:top-4">
            <div class="aev-analytics-card p-3 space-y-1.5">
                <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    Analytics Stages
                </div>

                <button type="button" @onclick='() => SelectStage("descriptive")'
                        class="aev-stage-btn @(_activeStage == "descriptive" ? "is-active" : "")">
                    <span class="aev-stage-num">01</span>
                    <div class="min-w-0 flex-1">
                        <div class="text-xs font-bold">Descriptive</div>
                        <div class="text-[11px] text-slate-400">What happened</div>
                    </div>
                </button>

                <button type="button" @onclick='() => SelectStage("diagnostic")'
                        class="aev-stage-btn @(_activeStage == "diagnostic" ? "is-active" : "")">
                    <span class="aev-stage-num">02</span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-bold">Diagnostic</span>
                            @if (_overview?.Diagnostic.Drivers.Count > 0)
                            {
                                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-sky-300">@_overview.Diagnostic.Drivers.Count</span>
                            }
                        </div>
                        <div class="text-[11px] text-slate-400">Why it happened</div>
                    </div>
                </button>

                <button type="button" @onclick='() => SelectStage("predictive")'
                        class="aev-stage-btn @(_activeStage == "predictive" ? "is-active" : "")">
                    <span class="aev-stage-num">03</span>
                    <div class="min-w-0 flex-1">
                        <div class="text-xs font-bold">Predictive</div>
                        <div class="text-[11px] text-slate-400">What will happen</div>
                    </div>
                </button>

                <button type="button" @onclick='() => SelectStage("prescriptive")'
                        class="aev-stage-btn @(_activeStage == "prescriptive" ? "is-active" : "")">
                    <span class="aev-stage-num">04</span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-bold">Prescriptive</span>
                            @if (_overview is not null)
                            {
                                var triggered = _overview.Prescriptive.Recommendations.Count(r => r.IsSignalTriggered && !r.IsAlreadyApplied);
                                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded @(triggered > 0 ? "bg-amber-500/20 text-amber-300" : "bg-slate-800 text-slate-400")">
                                    @triggered
                                </span>
                            }
                        </div>
                        <div class="text-[11px] text-slate-400">What should we do</div>
                    </div>
                </button>
            </div>

            @if (_overview is not null)
            {
                <div class="aev-analytics-card p-4 space-y-2.5 text-xs">
                    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Active Window Snapshot</div>
                    <div class="flex justify-between text-slate-300">
                        <span class="text-slate-400">Current</span>
                        <span class="font-mono text-[11px]">@_overview.StartDate.ToString("MMM d") – @_overview.EndDate.ToString("MMM d, yyyy")</span>
                    </div>
                    <div class="flex justify-between text-slate-300">
                        <span class="text-slate-400">Prior Compare</span>
                        <span class="font-mono text-[11px]">@_overview.PriorStartDate.ToString("MMM d") – @_overview.PriorEndDate.ToString("MMM d, yyyy")</span>
                    </div>
                    <div class="flex justify-between text-slate-300">
                        <span class="text-slate-400">Sample Density</span>
                        <span class="font-semibold @(_overview.HasAnyData ? (_overview.IsLowData ? "text-amber-300" : "text-emerald-300") : "text-slate-400")">
                            @(!_overview.HasAnyData ? "Empty" : (_overview.IsLowData ? "Low Data" : "Healthy"))
                        </span>
                    </div>
                    <div class="pt-2 border-t border-slate-800 text-[10px] text-slate-500 font-mono">
                        Synced @_overview.GeneratedAtUtc.ToLocalTime().ToString("MMM d, HH:mm:ss")
                    </div>
                </div>
            }
        </aside>

        @* Right Main Content *@
        <section class="lg:col-span-9 space-y-6">
            @if (_isLoading && _overview is null)
            {
                <div class="aev-analytics-card p-12 text-center space-y-3">
                    <div class="inline-block w-8 h-8 border-2 border-teal-400 border-t-transparent rounded-full animate-spin"></div>
                    <p class="text-sm font-semibold text-slate-300">Aggregating studio bookings, crew timesheets, leaves, and gear records…</p>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="aev-analytics-card p-8 text-center space-y-3 border-rose-500/40">
                    <div class="text-rose-400 font-bold text-sm">Unable to Load Studio Analytics</div>
                    <p class="text-xs text-slate-400 max-w-md mx-auto">@_loadError</p>
                    <button type="button" @onclick="LoadAnalyticsAsync"
                            class="px-4 py-2 rounded-lg bg-teal-600 hover:bg-teal-500 text-slate-950 text-xs font-bold">
                        Retry Query
                    </button>
                </div>
            }
            else if (_overview is not null)
            {
                @* ════════════════════════════════════════════════════════════════
                   STAGE 1: DESCRIPTIVE ("What happened")
                   ════════════════════════════════════════════════════════════════ *@
                @if (_activeStage == "descriptive")
                {
                    var d = _overview.Descriptive;

                    @* KPI Grid *@
                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                        <article class="aev-analytics-card p-4 border-t-2 border-t-teal-500">
                            <div class="flex items-center justify-between text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                                <span>Total Bookings</span>
                                @if (d.BookingsDeltaPct.HasValue)
                                {
                                    <span class="font-mono font-bold @(d.BookingsDeltaPct >= 0 ? "text-emerald-400" : "text-rose-400")">
                                        @(d.BookingsDeltaPct >= 0 ? "↑" : "↓") @Math.Abs(d.BookingsDeltaPct.Value).ToString("0.0")%
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-500 font-mono">No prior</span>
                                }
                            </div>
                            <div class="text-3xl font-extrabold text-slate-50 mt-2 aev-tabular">@d.TotalBookings</div>
                            <p class="text-[11px] text-slate-400 mt-1.5">
                                @d.EventAppointmentsCount event shoots · @d.ConsultationBookingsCount consultations
                            </p>
                        </article>

                        <article class="aev-analytics-card p-4 border-t-2 border-t-emerald-500">
                            <div class="flex items-center justify-between text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                                <span>Completion Rate</span>
                                @if (d.CompletionRateDeltaPts.HasValue)
                                {
                                    <span class="font-mono font-bold @(d.CompletionRateDeltaPts >= 0 ? "text-emerald-400" : "text-rose-400")">
                                        @(d.CompletionRateDeltaPts >= 0 ? "+" : "")@d.CompletionRateDeltaPts.Value.ToString("0.0") pts
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-500 font-mono">Fulfillment</span>
                                }
                            </div>
                            <div class="text-3xl font-extrabold text-slate-50 mt-2 aev-tabular">@d.SessionCompletionRate.ToString("0.0")%</div>
                            <p class="text-[11px] text-slate-400 mt-1.5">
                                @d.CompletedDeliveredCount done · @d.ConfirmedActiveCount active · @d.PendingHoldCount pending · @d.CancelledExpiredCount lost
                            </p>
                        </article>

                        <article class="aev-analytics-card p-4 border-t-2 border-t-sky-500">
                            <div class="flex items-center justify-between text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                                <span>Logged Crew Hours</span>
                                @if (d.CrewHoursDeltaPct.HasValue)
                                {
                                    <span class="font-mono font-bold @(d.CrewHoursDeltaPct >= 0 ? "text-sky-400" : "text-amber-400")">
                                        @(d.CrewHoursDeltaPct >= 0 ? "↑" : "↓") @Math.Abs(d.CrewHoursDeltaPct.Value).ToString("0.0")%
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-500 font-mono">Timesheets</span>
                                }
                            </div>
                            <div class="text-3xl font-extrabold text-slate-50 mt-2 aev-tabular">@d.LoggedCrewHours.ToString("0.0") <span class="text-base font-semibold text-slate-400">hrs</span></div>
                            <p class="text-[11px] text-slate-400 mt-1.5">
                                @d.TimesheetEntriesCount shifts · @d.ActiveCrewLoggedCount crew · @d.DayOffShiftsCount day-off shifts
                            </p>
                        </article>

                        <article class="aev-analytics-card p-4 border-t-2 border-t-amber-500">
                            <div class="flex items-center justify-between text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                                <span>Equipment Holds</span>
                                <span class="font-mono font-bold @(d.EquipmentMaintenanceHolds > 0 ? "text-amber-400" : "text-emerald-400")">
                                    @(d.EquipmentMaintenanceHolds > 0 ? "Attention" : "Ready")
                                </span>
                            </div>
                            <div class="text-3xl font-extrabold text-slate-50 mt-2 aev-tabular">@d.EquipmentMaintenanceHolds <span class="text-base font-semibold text-slate-400">/ @d.TotalEquipmentCount</span></div>
                            <p class="text-[11px] text-slate-400 mt-1.5">
                                @d.EquipmentInMaintenanceCount maint · @d.EquipmentNeedsReplacementCount replace · @d.EquipmentAssignmentsInPeriod gear dispatches
                            </p>
                        </article>
                    </div>

                    @if (!_overview.HasAnyData || _overview.IsLowData)
                    {
                        <div class="aev-analytics-card p-4 border-amber-500/40 bg-amber-950/20 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                            <div>
                                <div class="text-xs font-bold text-amber-300">
                                    @(!_overview.HasAnyData ? "No Bookings Found in Selected Range" : "Low-Data Window Detected")
                                </div>
                                <p class="text-xs text-slate-300 mt-0.5">
                                    @(!_overview.HasAnyData
                                        ? "Zero EventAppointment, Consultation, or Timesheet records matched your current filters."
                                        : $"Only {d.TotalBookings} booking(s) matched this window — percentages and trends may shift sharply with small counts.")
                                </p>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <button type="button" @onclick="ExpandToAllHistoryAsync"
                                        class="px-3 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-200 text-xs font-semibold">
                                    Expand to All History
                                </button>
                                <button type="button" @onclick="ResetFiltersAsync"
                                        class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-semibold">
                                    Reset Filters
                                </button>
                            </div>
                        </div>
                    }

                    @* Chart + Ranked Top Services *@
                    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
                        <div class="xl:col-span-7 aev-analytics-card p-5 space-y-4">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <div>
                                    <h2 class="text-sm font-bold text-slate-100">Booking Volume Over Time</h2>
                                    <p class="text-xs text-slate-400">
                                        Grouped by @(_granularity == "week" ? "ISO Week" : "Calendar Month") across EventAppointments &amp; Consultations
                                    </p>
                                </div>
                                <div class="flex flex-wrap items-center gap-3 text-[10px] font-semibold text-slate-300">
                                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-teal-400"></span>Completed</span>
                                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-sky-400"></span>Confirmed</span>
                                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-amber-400"></span>Pending</span>
                                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-rose-500"></span>Cancelled/Exp</span>
                                </div>
                            </div>

                            @if (d.VolumeSeries.Count == 0 || d.VolumeSeries.All(p => p.TotalBookings == 0))
                            {
                                <div class="aev-analytics-subcard p-10 text-center text-xs text-slate-400">
                                    No booking activity recorded for the selected date range and filter combination.
                                </div>
                            }
                            else
                            {
                                var maxTotal = Math.Max(1, d.VolumeSeries.Max(p => p.TotalBookings));
                                var chartHeight = 190;
                                var barSlotWidth = Math.Max(28, Math.Min(64, 540 / Math.Max(1, d.VolumeSeries.Count)));
                                var svgWidth = Math.Max(420, d.VolumeSeries.Count * barSlotWidth + 48);

                                <div class="overflow-x-auto pb-2">
                                    <svg viewBox="0 0 @svgWidth @(chartHeight + 38)" class="w-full min-w-[420px] h-56 select-none" role="img" aria-label="Booking volume bar chart">
                                        @for (int g = 0; g <= 4; g++)
                                        {
                                            var gy = 16 + (chartHeight - 16) * g / 4.0;
                                            var tickVal = Math.Round(maxTotal * (4 - g) / 4.0, 0);
                                            <line x1="32" y1="@gy.ToString("0.0", CultureInfo.InvariantCulture)" x2="@(svgWidth - 8)" y2="@gy.ToString("0.0", CultureInfo.InvariantCulture)" stroke="#1e293b" stroke-dasharray="3 3" />
                                            @:<text x="26" y="@((gy + 3).ToString("0.0", CultureInfo.InvariantCulture))" text-anchor="end" fill="#64748b" font-size="9" font-family="monospace">@tickVal</text>
                                        }

                                        @for (int i = 0; i < d.VolumeSeries.Count; i++)
                                        {
                                            var pt = d.VolumeSeries[i];
                                            var cx = 36 + i * barSlotWidth + barSlotWidth * 0.5;
                                            var bw = Math.Max(10, Math.Min(30, barSlotWidth * 0.58));
                                            var bx = cx - bw / 2.0;
                                            var usableH = chartHeight - 16.0;

                                            double hComp = (double)pt.CompletedCount / maxTotal * usableH;
                                            double hConf = (double)pt.ConfirmedCount / maxTotal * usableH;
                                            double hPend = (double)pt.PendingCount / maxTotal * usableH;
                                            double hCanc = (double)pt.CancelledOrExpiredCount / maxTotal * usableH;

                                            double yCursor = chartHeight;

                                            if (hComp > 0)
                                            {
                                                yCursor -= hComp;
                                                <rect x="@bx.ToString("0.0", CultureInfo.InvariantCulture)" y="@yCursor.ToString("0.0", CultureInfo.InvariantCulture)" width="@bw.ToString("0.0", CultureInfo.InvariantCulture)" height="@hComp.ToString("0.0", CultureInfo.InvariantCulture)" fill="#2dd4bf" rx="2">
                                                    <title>@pt.Label: @pt.CompletedCount Completed</title>
                                                </rect>
                                            }
                                            if (hConf > 0)
                                            {
                                                yCursor -= hConf;
                                                <rect x="@bx.ToString("0.0", CultureInfo.InvariantCulture)" y="@yCursor.ToString("0.0", CultureInfo.InvariantCulture)" width="@bw.ToString("0.0", CultureInfo.InvariantCulture)" height="@hConf.ToString("0.0", CultureInfo.InvariantCulture)" fill="#38bdf8" rx="2">
                                                    <title>@pt.Label: @pt.ConfirmedCount Confirmed/Active</title>
                                                </rect>
                                            }
                                            if (hPend > 0)
                                            {
                                                yCursor -= hPend;
                                                <rect x="@bx.ToString("0.0", CultureInfo.InvariantCulture)" y="@yCursor.ToString("0.0", CultureInfo.InvariantCulture)" width="@bw.ToString("0.0", CultureInfo.InvariantCulture)" height="@hPend.ToString("0.0", CultureInfo.InvariantCulture)" fill="#fbbf24" rx="2">
                                                    <title>@pt.Label: @pt.PendingCount Pending</title>
                                                </rect>
                                            }
                                            if (hCanc > 0)
                                            {
                                                yCursor -= hCanc;
                                                <rect x="@bx.ToString("0.0", CultureInfo.InvariantCulture)" y="@yCursor.ToString("0.0", CultureInfo.InvariantCulture)" width="@bw.ToString("0.0", CultureInfo.InvariantCulture)" height="@hCanc.ToString("0.0", CultureInfo.InvariantCulture)" fill="#f43f5e" rx="2">
                                                    <title>@pt.Label: @pt.CancelledOrExpiredCount Cancelled/Expired</title>
                                                </rect>
                                            }

                                            if (pt.TotalBookings > 0)
                                            {
                                                @:<text x="@cx.ToString("0.0", CultureInfo.InvariantCulture)" y="@((yCursor - 4).ToString("0.0", CultureInfo.InvariantCulture))" text-anchor="middle" fill="#cbd5e1" font-size="9" font-weight="700" font-family="monospace">@pt.TotalBookings</text>
                                            }

                                            var showLabel = d.VolumeSeries.Count <= 12 || i % 2 == 0 || i == d.VolumeSeries.Count - 1;
                                            if (showLabel)
                                            {
                                                @:<text x="@cx.ToString("0.0", CultureInfo.InvariantCulture)" y="@(chartHeight + 16)" text-anchor="middle" fill="#94a3b8" font-size="9">@pt.Label</text>
                                            }
                                        }
                                    </svg>
                                </div>
                            }
                        </div>

                        <div class="xl:col-span-5 aev-analytics-card p-5 space-y-4">
                            <div>
                                <h2 class="text-sm font-bold text-slate-100">Ranked Top Services &amp; Packages</h2>
                                <p class="text-xs text-slate-400">Most booked services, combo packages, and add-ons in window</p>
                            </div>

                            @if (d.TopServices.Count == 0)
                            {
                                <div class="aev-analytics-subcard p-8 text-center text-xs text-slate-400">
                                    No service line items recorded in this filter window.
                                </div>
                            }
                            else
                            {
                                <div class="space-y-3">
                                    @for (int idx = 0; idx < d.TopServices.Count; idx++)
                                    {
                                        var svc = d.TopServices[idx];
                                        <div class="aev-analytics-subcard p-3 space-y-1.5">
                                            <div class="flex items-center justify-between gap-2 text-xs">
                                                <div class="flex items-center gap-2 min-w-0">
                                                    <span class="font-mono text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-800 text-teal-300">#@(idx + 1)</span>
                                                    <span class="font-semibold text-slate-100 truncate" title="@svc.Name">@svc.Name</span>
                                                </div>
                                                <span class="font-mono text-xs font-bold text-slate-200 shrink-0 aev-tabular">
                                                    @svc.BookingCount (@svc.SharePct.ToString("0.0")%)
                                                </span>
                                            </div>
                                            <div class="flex items-center justify-between text-[10px] text-slate-400">
                                                <span>@svc.Kind · @svc.CategoryName</span>
                                                <span>Qty: @svc.TotalQuantity</span>
                                            </div>
                                            <div class="w-full h-1.5 bg-slate-900 rounded-full overflow-hidden">
                                                <div class="h-full bg-gradient-to-r from-teal-500 to-sky-400 rounded-full"
                                                     style="width: @Math.Max(4, svc.SharePct).ToString("0.#", CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ════════════════════════════════════════════════════════════════
                   STAGE 2: DIAGNOSTIC ("Why it happened")
                   ════════════════════════════════════════════════════════════════ *@
                @if (_activeStage == "diagnostic")
                {
                    var diag = _overview.Diagnostic;
                    var selectedDriver = diag.Drivers.FirstOrDefault(x => x.DriverId == _selectedDriverId)
                                         ?? diag.Drivers.FirstOrDefault();

                    @* Period-over-period banner *@
                    <div class="aev-analytics-card p-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                        <div>
                            <div class="text-[10px] font-bold uppercase tracking-wider text-sky-400">Period-Over-Period Operational Comparison</div>
                            <h2 class="text-base font-bold text-slate-100 mt-0.5">
                                @diag.CurrentPeriodLabel <span class="text-slate-500 font-normal">vs</span> @diag.PriorPeriodLabel
                            </h2>
                        </div>
                        <div class="flex flex-wrap items-center gap-4">
                            <div class="text-right">
                                <div class="text-[10px] uppercase text-slate-400">Current</div>
                                <div class="text-xl font-extrabold text-slate-50 aev-tabular">@diag.CurrentTotalBookings</div>
                            </div>
                            <div class="text-slate-600 text-lg">/</div>
                            <div class="text-right">
                                <div class="text-[10px] uppercase text-slate-400">Prior</div>
                                <div class="text-xl font-extrabold text-slate-300 aev-tabular">@diag.PriorTotalBookings</div>
                            </div>
                            @if (diag.BookingsChangePct.HasValue)
                            {
                                <span class="px-3 py-1 rounded-full text-xs font-mono font-bold @(diag.BookingsChangePct >= 0 ? "bg-emerald-500/15 text-emerald-300 border border-emerald-500/30" : "bg-rose-500/15 text-rose-300 border border-rose-500/30")">
                                    @(diag.BookingsChangePct >= 0 ? "+" : "")@diag.BookingsChangePct.Value.ToString("0.0")%
                                </span>
                            }
                        </div>
                    </div>

                    @* Status Shifts 5-Column Strip *@
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                        @foreach (var s in diag.StatusShifts)
                        {
                            <div class="aev-analytics-card p-3.5">
                                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">@s.StatusGroup</div>
                                <div class="flex items-baseline justify-between mt-1.5">
                                    <span class="text-2xl font-extrabold text-slate-50 aev-tabular">@s.CurrentCount</span>
                                    <span class="text-[11px] font-mono font-bold @(s.Delta == 0 ? "text-slate-400" : s.Delta > 0 ? "text-sky-300" : "text-amber-300")">
                                        @(s.Delta > 0 ? $"+{s.Delta}" : s.Delta.ToString())
                                    </span>
                                </div>
                                <div class="text-[10px] text-slate-400 mt-1">Prior: @s.PriorCount · @s.ShareOfCurrentPct.ToString("0.0")%</div>
                            </div>
                        }
                    </div>

                    @* Interactive Drivers + Finding Detail Panel *@
                    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
                        <div class="xl:col-span-5 space-y-3">
                            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 px-1">
                                Select an Operational Driver
                            </div>
                            @foreach (var driver in diag.Drivers)
                            {
                                var isSelected = selectedDriver?.DriverId == driver.DriverId;
                                <button type="button" @onclick="() => _selectedDriverId = driver.DriverId"
                                        class="aev-driver-btn @(isSelected ? "is-selected" : "")">
                                    <div class="flex items-center justify-between gap-2 mb-1.5">
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">@driver.Category</span>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase @GetSeverityBadgeClass(driver.Severity)">
                                            @driver.Severity
                                        </span>
                                    </div>
                                    <div class="text-sm font-bold text-slate-100">@driver.Title</div>
                                    <div class="text-xs font-mono text-sky-300 mt-1">@driver.HeadlineMetric</div>
                                    <div class="flex items-center justify-between gap-2 mt-2 text-[11px] text-slate-400">
                                        <span>@driver.DeltaLabel</span>
                                        <span class="text-sky-400 font-semibold">@(isSelected ? "Inspecting →" : "Inspect")</span>
                                    </div>
                                </button>
                            }
                        </div>

                        <div class="xl:col-span-7 aev-analytics-card p-5 space-y-4">
                            @if (selectedDriver is not null)
                            {
                                <div class="flex flex-wrap items-start justify-between gap-3 pb-3 border-b border-slate-800">
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-[10px] font-bold uppercase tracking-wider text-sky-400">@selectedDriver.Category</span>
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase @GetSeverityBadgeClass(selectedDriver.Severity)">
                                                @selectedDriver.Severity
                                            </span>
                                        </div>
                                        <h3 class="text-lg font-extrabold text-slate-50 mt-1">@selectedDriver.Title</h3>
                                    </div>
                                    <span class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-200 font-mono text-xs font-semibold">
                                        @selectedDriver.DeltaLabel
                                    </span>
                                </div>

                                <div class="aev-analytics-subcard p-4 space-y-2">
                                    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Diagnostic Finding</div>
                                    <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">@selectedDriver.DetailedFinding</p>
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-xs font-bold text-slate-200">Affected Studio Records &amp; Dates</span>
                                        <span class="text-[11px] font-mono text-slate-400">@selectedDriver.AffectedItems.Count item(s)</span>
                                    </div>

                                    @if (selectedDriver.AffectedItems.Count == 0)
                                    {
                                        <div class="aev-analytics-subcard p-6 text-center text-xs text-slate-400">
                                            No affected records surfaced for this driver in the active period.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="overflow-x-auto border border-slate-800 rounded-xl">
                                            <table class="w-full text-left border-collapse text-xs">
                                                <thead>
                                                    <tr class="bg-slate-950/70 text-[10px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
                                                        <th class="py-2.5 px-3">Ref</th>
                                                        <th class="py-2.5 px-3">Record</th>
                                                        <th class="py-2.5 px-3">Date</th>
                                                        <th class="py-2.5 px-3">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-800/80">
                                                    @foreach (var item in selectedDriver.AffectedItems)
                                                    {
                                                        <tr class="hover:bg-slate-800/40">
                                                            <td class="py-2.5 px-3 font-mono text-[11px] text-teal-300 whitespace-nowrap">@item.ReferenceId</td>
                                                            <td class="py-2.5 px-3">
                                                                <div class="font-semibold text-slate-100">@item.Title</div>
                                                                <div class="text-[11px] text-slate-400">@item.ContextDetail</div>
                                                            </td>
                                                            <td class="py-2.5 px-3 text-slate-300 whitespace-nowrap">@item.DateLabel</td>
                                                            <td class="py-2.5 px-3 whitespace-nowrap">
                                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-200 border border-slate-700">
                                                                    @item.Status
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ════════════════════════════════════════════════════════════════
                   STAGE 3: PREDICTIVE ("What will happen")
                   ════════════════════════════════════════════════════════════════ *@
                @if (_activeStage == "predictive")
                {
                    var pred = _overview.Predictive;
                    var scenarioModel = pred.Scenarios.FirstOrDefault(s => s.Key == _activeScenario)
                                        ?? pred.Scenarios.FirstOrDefault();

                    <div class="aev-analytics-card p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <div class="text-[10px] font-bold uppercase tracking-wider text-violet-400">Forward Capacity &amp; Demand Horizon</div>
                            <h2 class="text-base font-bold text-slate-100 mt-0.5">Next @pred.HorizonMonths Months Booking Projection</h2>
                            <p class="text-xs text-slate-400 mt-0.5">
                                Toggle demand scenarios to compare expected crew workload and uncertainty bands.
                            </p>
                        </div>

                        <div class="inline-flex p-1 rounded-xl bg-slate-950 border border-slate-800 gap-1">
                            @foreach (var sc in pred.Scenarios)
                            {
                                var active = sc.Key == _activeScenario;
                                <button type="button" @onclick="() => _activeScenario = sc.Key"
                                        class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-colors @(active ? "bg-violet-500 text-slate-950" : "text-slate-300 hover:text-white hover:bg-slate-800")">
                                    @sc.Label
                                </button>
                            }
                        </div>
                    </div>

                    @if (scenarioModel is not null)
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <article class="aev-analytics-card p-4 border-t-2 border-t-violet-500">
                                <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Projected Bookings (@scenarioModel.Label)</div>
                                <div class="text-3xl font-extrabold text-slate-50 mt-2 aev-tabular">@scenarioModel.ProjectedBookingsTotal</div>
                                <p class="text-[11px] text-slate-400 mt-1.5">
                                    Est. @scenarioModel.EstimatedCrewHoursTotal.ToString("0.0") crew hours needed · @scenarioModel.Multiplier.ToString("0.00")× factor
                                </p>
                            </article>

                            <article class="aev-analytics-card p-4 border-t-2 border-t-sky-500">
                                <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Peak Projected Period</div>
                                <div class="text-2xl font-extrabold text-slate-50 mt-2">@scenarioModel.PeakPeriodLabel</div>
                                <p class="text-[11px] text-slate-400 mt-1.5">
                                    ~@scenarioModel.PeakPeriodProjectedBookings projected sessions in peak month
                                </p>
                            </article>

                            <article class="aev-analytics-card p-4 border-t-2 border-t-amber-500">
                                <div class="flex items-center justify-between text-[11px] font-semibold uppercase tracking-wider text-slate-400">
                                    <span>Model Error &amp; Confidence</span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(pred.ConfidenceLevel == "Good" ? "bg-emerald-500/20 text-emerald-300" : pred.ConfidenceLevel == "Moderate" ? "bg-sky-500/20 text-sky-300" : "bg-amber-500/20 text-amber-300")">
                                        @pred.ConfidenceLevel
                                    </span>
                                </div>
                                <div class="text-2xl font-extrabold text-slate-50 mt-2 aev-tabular">
                                    @(pred.ModelErrorMae.HasValue ? $"±{pred.ModelErrorMae.Value:0.00} MAE" : $"{pred.HistoricalMonthsCount} mo sample")
                                </div>
                                <p class="text-[11px] text-slate-400 mt-1.5">
                                    Based on @pred.HistoricalBookingsCount non-cancelled bookings across @pred.HistoricalMonthsCount active month(s)
                                </p>
                            </article>
                        </div>

                        @* Forecast Range Chart *@
                        <div class="aev-analytics-card p-5 space-y-4">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <div>
                                    <h3 class="text-sm font-bold text-slate-100">Historical Trend &amp; Forecast Uncertainty Band</h3>
                                    <p class="text-xs text-slate-400">Solid bars = historical monthly demand · Shaded violet band = lower/upper forecast range</p>
                                </div>
                                <div class="flex items-center gap-4 text-[10px] font-semibold text-slate-300">
                                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-slate-500"></span>Historical</span>
                                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-violet-400"></span>Projected (@scenarioModel.Label)</span>
                                    <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-xs bg-teal-400"></span>Already Booked</span>
                                </div>
                            </div>

                            @{
                                var series = scenarioModel.Series;
                                var maxY = Math.Max(4.0, series.Max(p => Math.Max(p.UpperBound, p.HistoricalBookings ?? 0)) * 1.15);
                                int count = series.Count;
                                int w = 640;
                                int h = 210;
                                int padL = 36;
                                int padR = 16;
                                int padT = 18;
                                int padB = 34;
                                double plotW = w - padL - padR;
                                double plotH = h - padT - padB;
                                double stepX = count > 1 ? plotW / (count - 1) : plotW;

                                double XFor(int i) => padL + i * stepX;
                                double YFor(double v) => padT + plotH - (Math.Clamp(v, 0, maxY) / maxY * plotH);

                                var forecastIndices = series.Select((p, idx) => (p, idx)).Where(x => !x.p.IsHistorical || x.idx == series.TakeWhile(s => s.IsHistorical).Count() - 1).ToList();
                                var upperPoly = string.Join(" ", forecastIndices.Select(x => $"{XFor(x.idx).ToString("0.0", CultureInfo.InvariantCulture)},{YFor(x.p.UpperBound).ToString("0.0", CultureInfo.InvariantCulture)}"));
                                var lowerPoly = string.Join(" ", forecastIndices.AsEnumerable().Reverse().Select(x => $"{XFor(x.idx).ToString("0.0", CultureInfo.InvariantCulture)},{YFor(x.p.LowerBound).ToString("0.0", CultureInfo.InvariantCulture)}"));
                                var bandPoints = string.IsNullOrWhiteSpace(upperPoly) ? "" : $"{upperPoly} {lowerPoly}";
                                var linePoints = string.Join(" ", forecastIndices.Select(x => $"{XFor(x.idx).ToString("0.0", CultureInfo.InvariantCulture)},{YFor(x.p.ProjectedBookings).ToString("0.0", CultureInfo.InvariantCulture)}"));
                            }

                            <div class="overflow-x-auto">
                                <svg viewBox="0 0 @w @h" class="w-full min-w-[460px] h-56 select-none" role="img" aria-label="Predictive bookings forecast chart">
                                    @for (int g = 0; g <= 4; g++)
                                    {
                                        var val = maxY * (4 - g) / 4.0;
                                        var y = padT + plotH * g / 4.0;
                                        <line x1="@padL" y1="@y.ToString("0.0", CultureInfo.InvariantCulture)" x2="@(w - padR)" y2="@y.ToString("0.0", CultureInfo.InvariantCulture)" stroke="#1e293b" stroke-dasharray="3 3" />
                                        @:<text x="@(padL - 6)" y="@((y + 3).ToString("0.0", CultureInfo.InvariantCulture))" text-anchor="end" fill="#64748b" font-size="9" font-family="monospace">@val.ToString("0")</text>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(bandPoints))
                                    {
                                        <polygon points="@bandPoints" fill="rgba(167, 139, 250, 0.22)" />
                                    }

                                    @for (int i = 0; i < count; i++)
                                    {
                                        var pt = series[i];
                                        var cx = XFor(i);
                                        if (pt.IsHistorical)
                                        {
                                            var barY = YFor(pt.HistoricalBookings ?? 0);
                                            var barH = Math.Max(2, padT + plotH - barY);
                                            <rect x="@((cx - 10).ToString("0.0", CultureInfo.InvariantCulture))" y="@barY.ToString("0.0", CultureInfo.InvariantCulture)" width="20" height="@barH.ToString("0.0", CultureInfo.InvariantCulture)" fill="#475569" rx="3">
                                                <title>@pt.Label: @pt.HistoricalBookings historical booking(s)</title>
                                            </rect>
                                        }
                                        else if ((pt.ConfirmedOnBooksCount ?? 0) > 0)
                                        {
                                            var confY = YFor(pt.ConfirmedOnBooksCount!.Value);
                                            var confH = Math.Max(2, padT + plotH - confY);
                                            <rect x="@((cx - 8).ToString("0.0", CultureInfo.InvariantCulture))" y="@confY.ToString("0.0", CultureInfo.InvariantCulture)" width="16" height="@confH.ToString("0.0", CultureInfo.InvariantCulture)" fill="rgba(45, 212, 191, 0.55)" rx="3">
                                                <title>@pt.Label: @pt.ConfirmedOnBooksCount confirmed on books</title>
                                            </rect>
                                        }
                                        @:<text x="@cx.ToString("0.0", CultureInfo.InvariantCulture)" y="@(h - 10)" text-anchor="middle" fill="#94a3b8" font-size="9">@pt.Label</text>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(linePoints))
                                    {
                                        <polyline points="@linePoints" fill="none" stroke="#a78bfa" stroke-width="2.5" stroke-dasharray="5 3" />
                                    }

                                    @foreach (var x in forecastIndices.Where(x => !x.p.IsHistorical))
                                    {
                                        var cx = XFor(x.idx);
                                        var cy = YFor(x.p.ProjectedBookings);
                                        <circle cx="@cx.ToString("0.0", CultureInfo.InvariantCulture)" cy="@cy.ToString("0.0", CultureInfo.InvariantCulture)" r="4.5" fill="#c4b5fd" stroke="#0f172a" stroke-width="1.5">
                                            <title>@x.p.Label: @x.p.ProjectedBookings.ToString("0.0") projected (range @x.p.LowerBound.ToString("0.0")–@x.p.UpperBound.ToString("0.0"))</title>
                                        </circle>
                                        @:<text x="@cx.ToString("0.0", CultureInfo.InvariantCulture)" y="@((cy - 9).ToString("0.0", CultureInfo.InvariantCulture))" text-anchor="middle" fill="#e9d5ff" font-size="9.5" font-weight="700" font-family="monospace">@x.p.ProjectedBookings.ToString("0.0")</text>
                                    }
                                </svg>
                            </div>

                            @* Future Month Cards *@
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                @foreach (var fp in scenarioModel.Series.Where(s => !s.IsHistorical))
                                {
                                    <div class="aev-analytics-subcard p-3.5 space-y-1">
                                        <div class="flex items-center justify-between text-xs font-bold text-slate-100">
                                            <span>@fp.Label</span>
                                            <span class="font-mono text-violet-300">@fp.ProjectedBookings.ToString("0.0") bookings</span>
                                        </div>
                                        <div class="text-[11px] text-slate-400">
                                            Range: <span class="font-mono text-slate-200">@fp.LowerBound.ToString("0.0") – @fp.UpperBound.ToString("0.0")</span>
                                        </div>
                                        <div class="flex items-center justify-between text-[11px] text-slate-400">
                                            <span>On books: <strong class="text-teal-300">@(fp.ConfirmedOnBooksCount ?? 0)</strong></span>
                                            <span>Est. load: <strong class="text-slate-200">@fp.EstimatedCapacityPct.ToString("0")%</strong></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="aev-analytics-card p-4 space-y-2 border-slate-800 text-xs">
                            <div class="font-bold text-slate-200">Confidence &amp; Transparency Note</div>
                            <p class="text-amber-200/90">@pred.ConfidenceNote</p>
                            <p class="text-slate-400">@pred.MethodologyNote</p>
                        </div>
                    }
                }

                @* ════════════════════════════════════════════════════════════════
                   STAGE 4: PRESCRIPTIVE ("What should we do")
                   ════════════════════════════════════════════════════════════════ *@
                @if (_activeStage == "prescriptive")
                {
                    var presc = _overview.Prescriptive;

                    <div class="aev-analytics-card p-5 space-y-4">
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                            <div>
                                <div class="text-[10px] font-bold uppercase tracking-wider text-amber-400">Actionable Studio Playbook</div>
                                <h2 class="text-base font-bold text-slate-100 mt-0.5">Recommended Operational Actions</h2>
                                <p class="text-xs text-slate-400">
                                    Generated from active holds, staff leaves, maintenance tickets, and slot distribution. Applying actions persists them to <code>dbo.StudioAnalyticsActions</code> and <code>dbo.AuditLogs</code>.
                                </p>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <span class="text-xs font-mono text-slate-300">@_selectedActionKeys.Count selected</span>
                                <button type="button"
                                        @onclick="ApplySelectedActionsAsync"
                                        disabled="@(_isApplying || _selectedActionKeys.Count == 0)"
                                        class="px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 disabled:opacity-40 text-slate-950 text-xs font-extrabold transition-colors">
                                    @(_isApplying ? "Persisting…" : "Apply Selected Actions")
                                </button>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                            <div class="md:col-span-12">
                                <input type="text" @bind="_actionOperatorNotes" maxlength="300"
                                       placeholder="Optional execution note for audit log (e.g., Assigned backup crew for Nov 28 wedding)…"
                                       class="aev-filter-input w-full" />
                            </div>
                        </div>

                        <div class="space-y-3">
                            @foreach (var rec in presc.Recommendations)
                            {
                                var isChecked = _selectedActionKeys.Contains(rec.ActionKey);
                                <label class="block aev-analytics-subcard p-4 cursor-pointer hover:border-slate-500 transition-colors @(isChecked ? "border-amber-400/70 bg-amber-950/20" : "")">
                                    <div class="flex items-start gap-3.5">
                                        <input type="checkbox"
                                               checked="@isChecked"
                                               @onchange="(e) => ToggleActionSelection(rec.ActionKey, (bool?)e.Value == true)"
                                               class="mt-1 h-4 w-4 rounded border-slate-600 bg-slate-900 text-amber-500 focus:ring-amber-500" />

                                        <div class="min-w-0 flex-1 space-y-2">
                                            <div class="flex flex-wrap items-center justify-between gap-2">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <span class="text-sm font-bold text-slate-100">@rec.Title</span>
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(rec.IsSignalTriggered ? "bg-amber-500/20 text-amber-300 border border-amber-500/30" : "bg-slate-800 text-slate-400 border border-slate-700")">
                                                        @rec.TriggerSignal
                                                    </span>
                                                </div>
                                                <div class="flex items-center gap-1.5">
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">@rec.Category</span>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold @GetEffortBadgeClass(rec.EffortTag)">@rec.EffortTag</span>
                                                </div>
                                            </div>

                                            <p class="text-xs text-slate-300 leading-relaxed">@rec.Description</p>

                                            <div class="flex flex-wrap items-center justify-between gap-2 pt-1 text-[11px]">
                                                <span class="text-teal-300 font-semibold">Impact: @rec.EstimatedImpact</span>
                                                @if (rec.IsAlreadyApplied && rec.LastAppliedAtUtc.HasValue)
                                                {
                                                    <span class="text-emerald-300 font-mono text-[10px]">
                                                        ✓ Applied @rec.LastAppliedAtUtc.Value.ToLocalTime().ToString("MMM d, HH:mm") by @rec.LastAppliedBy
                                                    </span>
                                                }
                                            </div>

                                            @if (rec.RelatedReferences.Count > 0)
                                            {
                                                <div class="flex flex-wrap items-center gap-1.5 pt-1">
                                                    @foreach (var refId in rec.RelatedReferences)
                                                    {
                                                        <span class="px-2 py-0.5 rounded bg-slate-950 border border-slate-800 font-mono text-[10px] text-slate-300">@refId</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>

                    @* Persisted Action Log *@
                    <div class="aev-analytics-card p-5 space-y-3">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-sm font-bold text-slate-100">Persisted Studio Action Log</h3>
                                <p class="text-xs text-slate-400">Recorded in <code>dbo.StudioAnalyticsActions</code> &amp; mirrored to <code>dbo.AuditLogs</code></p>
                            </div>
                            <span class="text-xs font-mono text-slate-400">@presc.AppliedHistory.Count logged</span>
                        </div>

                        @if (presc.AppliedHistory.Count == 0)
                        {
                            <div class="aev-analytics-subcard p-6 text-center text-xs text-slate-400">
                                No prescriptive recommendations have been applied yet. Select one or more actions above and click <strong>Apply Selected Actions</strong>.
                            </div>
                        }
                        else
                        {
                            <div class="overflow-x-auto border border-slate-800 rounded-xl">
                                <table class="w-full text-left border-collapse text-xs">
                                    <thead>
                                        <tr class="bg-slate-950/70 text-[10px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
                                            <th class="py-2.5 px-3">Applied At</th>
                                            <th class="py-2.5 px-3">Action</th>
                                            <th class="py-2.5 px-3">Effort / Impact</th>
                                            <th class="py-2.5 px-3">Operator</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-800/80">
                                        @foreach (var entry in presc.AppliedHistory)
                                        {
                                            <tr class="hover:bg-slate-800/40">
                                                <td class="py-2.5 px-3 font-mono text-[11px] text-slate-400 whitespace-nowrap">
                                                    @entry.AppliedAtUtc.ToLocalTime().ToString("MMM d, yyyy HH:mm")
                                                </td>
                                                <td class="py-2.5 px-3">
                                                    <div class="font-semibold text-slate-100">@entry.Title</div>
                                                    @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                                    {
                                                        <div class="text-[11px] text-slate-400 mt-0.5">Note: @entry.Notes</div>
                                                    }
                                                </td>
                                                <td class="py-2.5 px-3">
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold @GetEffortBadgeClass(entry.EffortTag)">@entry.EffortTag</span>
                                                    <div class="text-[11px] text-teal-300 mt-1">@entry.EstimatedImpact</div>
                                                </td>
                                                <td class="py-2.5 px-3 text-slate-300 whitespace-nowrap">@entry.AppliedByName</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            }
        </section>
    </div>
</div>

@code {
    [Parameter] public string? Stage { get; set; }

    private string _activeStage = "descriptive";
    private string _selectedPreset = "90d";
    private DateOnly _startDate = DateOnly.FromDateTime(DateTime.Today.AddDays(-89));
    private DateOnly _endDate = DateOnly.FromDateTime(DateTime.Today);
    private string _statusFilter = "All";
    private string _categoryFilter = "All";
    private string _granularity = "month";
    private string _activeScenario = "expected";

    private StudioAnalyticsOverviewModel? _overview;
    private bool _isLoading;
    private bool _isExporting;
    private bool _isApplying;
    private string? _loadError;
    private string? _bannerMessage;
    private bool _bannerIsError;

    private string? _selectedDriverId;
    private readonly HashSet<string> _selectedActionKeys = new(StringComparer.OrdinalIgnoreCase);
    private string _actionOperatorNotes = string.Empty;

    protected override void OnParametersSet()
    {
        var normalized = NormalizeStage(Stage);
        if (!string.Equals(_activeStage, normalized, StringComparison.OrdinalIgnoreCase))
        {
            _activeStage = normalized;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalyticsAsync();
    }

    private async Task LoadAnalyticsAsync()
    {
        _isLoading = true;
        _loadError = null;
        StateHasChanged();

        var res = await AnalyticsClient.GetOverviewAsync(
            _startDate,
            _endDate,
            _statusFilter,
            _categoryFilter,
            _granularity,
            _activeScenario);

        if (res.IsSuccess && res.Value is not null)
        {
            _overview = res.Value;
            if (string.IsNullOrWhiteSpace(_selectedDriverId) ||
                _overview.Diagnostic.Drivers.All(d => d.DriverId != _selectedDriverId))
            {
                _selectedDriverId = _overview.Diagnostic.Drivers.FirstOrDefault()?.DriverId;
            }
        }
        else
        {
            _loadError = res.Error?.Message ?? "Failed to retrieve Studio Analytics.";
        }

        _isLoading = false;
    }

    private void SelectStage(string stageKey)
    {
        _activeStage = NormalizeStage(stageKey);
        var currentPath = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        var prefix = currentPath.StartsWith("admin/") ? "/admin/analytics/" : "/analytics/";
        Nav.NavigateTo($"{prefix}{_activeStage}", replace: true);
    }

    private async Task OnPresetChangedAsync(ChangeEventArgs e)
    {
        _selectedPreset = e.Value?.ToString() ?? "90d";
        var today = DateOnly.FromDateTime(DateTime.Today);
        switch (_selectedPreset)
        {
            case "30d":
                _endDate = today;
                _startDate = today.AddDays(-29);
                break;
            case "90d":
                _endDate = today;
                _startDate = today.AddDays(-89);
                break;
            case "ytd":
                _endDate = today;
                _startDate = new DateOnly(today.Year, 1, 1);
                break;
            case "all":
                _endDate = today;
                _startDate = today.AddMonths(-23);
                break;
            default:
                return;
        }
        await LoadAnalyticsAsync();
    }

    private async Task OnStartDateChangedAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var parsed))
        {
            _startDate = parsed;
            _selectedPreset = "custom";
            await LoadAnalyticsAsync();
        }
    }

    private async Task OnEndDateChangedAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var parsed))
        {
            _endDate = parsed;
            _selectedPreset = "custom";
            await LoadAnalyticsAsync();
        }
    }

    private async Task OnStatusFilterChangedAsync(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "All";
        await LoadAnalyticsAsync();
    }

    private async Task OnCategoryFilterChangedAsync(ChangeEventArgs e)
    {
        _categoryFilter = e.Value?.ToString() ?? "All";
        await LoadAnalyticsAsync();
    }

    private async Task SetGranularityAsync(string granularity)
    {
        if (_granularity == granularity) return;
        _granularity = granularity;
        await LoadAnalyticsAsync();
    }

    private async Task ExpandToAllHistoryAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _selectedPreset = "all";
        _startDate = today.AddMonths(-23);
        _endDate = today;
        _statusFilter = "All";
        _categoryFilter = "All";
        await LoadAnalyticsAsync();
    }

    private async Task ResetFiltersAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _selectedPreset = "90d";
        _startDate = today.AddDays(-89);
        _endDate = today;
        _statusFilter = "All";
        _categoryFilter = "All";
        _granularity = "month";
        await LoadAnalyticsAsync();
    }

    private async Task ExportCsvAsync()
    {
        _isExporting = true;
        var res = await AnalyticsClient.ExportCsvAsync(
            _startDate,
            _endDate,
            _statusFilter,
            _categoryFilter,
            _granularity,
            _activeScenario);

        if (res.IsSuccess && !string.IsNullOrEmpty(res.Value))
        {
            var fileName = $"photo-aevum-studio-analytics-{_startDate:yyyyMMdd}-{_endDate:yyyyMMdd}.csv";
            await JS.InvokeVoidAsync("aevumAnalyticsDownload", fileName, res.Value, "text/csv;charset=utf-8;");
            _bannerIsError = false;
            _bannerMessage = $"Exported CSV report ({fileName}).";
        }
        else
        {
            _bannerIsError = true;
            _bannerMessage = res.Error?.Message ?? "Export failed.";
        }
        _isExporting = false;
    }

    private void ToggleActionSelection(string actionKey, bool isSelected)
    {
        if (isSelected)
            _selectedActionKeys.Add(actionKey);
        else
            _selectedActionKeys.Remove(actionKey);
    }

    private async Task ApplySelectedActionsAsync()
    {
        if (_overview is null || _selectedActionKeys.Count == 0) return;

        _isApplying = true;
        _bannerMessage = null;

        var selectedItems = _overview.Prescriptive.Recommendations
            .Where(r => _selectedActionKeys.Contains(r.ActionKey))
            .Select(r => new ApplyPrescriptiveActionItemModel(
                r.ActionKey,
                r.Title,
                r.Category,
                r.EffortTag,
                r.EstimatedImpact,
                r.TriggerSignal,
                r.RelatedReferences))
            .ToList();

        var req = new ApplyPrescriptiveActionsRequestModel(selectedItems, _actionOperatorNotes);
        var res = await AnalyticsClient.ApplyPrescriptiveActionsAsync(req);

        if (res.IsSuccess && res.Value is not null)
        {
            _selectedActionKeys.Clear();
            _actionOperatorNotes = string.Empty;
            _bannerIsError = false;
            _bannerMessage = res.Value.Message;
            await LoadAnalyticsAsync();
        }
        else
        {
            _bannerIsError = true;
            _bannerMessage = res.Error?.Message ?? "Failed to persist selected actions.";
        }

        _isApplying = false;
    }

    private static string NormalizeStage(string? stage) =>
        stage?.Trim().ToLowerInvariant() switch
        {
            "diagnostic" => "diagnostic",
            "predictive" => "predictive",
            "prescriptive" => "prescriptive",
            _ => "descriptive"
        };

    private static string GetStageDisplayName(string stage) => stage switch
    {
        "diagnostic" => "Stage 2 · Diagnostic",
        "predictive" => "Stage 3 · Predictive",
        "prescriptive" => "Stage 4 · Prescriptive",
        _ => "Stage 1 · Descriptive"
    };

    private static string GetStageQuestion(string stage) => stage switch
    {
        "diagnostic" => "Why did it happen?",
        "predictive" => "What will happen?",
        "prescriptive" => "What should we do?",
        _ => "What happened?"
    };

    private static string GetSeverityBadgeClass(string severity) => severity.ToLowerInvariant() switch
    {
        "high" => "bg-rose-500/20 text-rose-300 border border-rose-500/40",
        "medium" => "bg-amber-500/20 text-amber-300 border border-amber-500/40",
        "positive" => "bg-emerald-500/20 text-emerald-300 border border-emerald-500/40",
        _ => "bg-slate-800 text-slate-300 border border-slate-700"
    };

    private static string GetEffortBadgeClass(string effort) => effort.ToLowerInvariant() switch
    {
        var e when e.Contains("low") => "bg-emerald-500/15 text-emerald-300 border border-emerald-500/30",
        var e when e.Contains("high") => "bg-rose-500/15 text-rose-300 border border-rose-500/30",
        _ => "bg-amber-500/15 text-amber-300 border border-amber-500/30"
    };
}
