@page "/"
@page "/Home"
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IUserService UserService
@inject IServicesApiClient ServicesApi
@inject IPortfolioService PortfolioService
@inject NavigationManager NavManager

<PageTitle>Photo Aevum Studio | Book Your Session</PageTitle>

@* ── Auth portal modal (rendered inline so Blazor Server wires the events) *@
<AuthPortalModal IsVisible="_modalOpen" OnClose="CloseModal" />

@* ── Public Top Navigation Bar ────────────────────────────────────────────── *@
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">

        @* Brand *@
        <a href="/" class="flex items-center gap-3">
            <img src="images/AevumLogo.jpg" alt="Photo Aevum Logo" class="h-9 w-auto rounded-full" />
            <span class="font-bold text-lg tracking-tight uppercase tracking-widest text-gray-900">Photo Aevum Studio</span>
        </a>

        @* Desktop nav links *@
        <nav class="hidden md:flex items-center gap-8 text-xs font-semibold tracking-wider text-gray-600">
            <a href="#home" class="hover:text-gray-950 transition-colors">HOME</a>
            <a href="/services" class="hover:text-gray-950 transition-colors">SERVICES</a>
            <a href="#portfolio" @onclick="TogglePortfolio" @onclick:preventDefault class="hover:text-gray-950 transition-colors">PORTFOLIO</a>
            <a href="#faq" class="hover:text-gray-950 transition-colors">FAQ</a>
            <a href="#contact" class="hover:text-gray-950 transition-colors">CONTACT</a>
        </nav>

        @* CTA group *@
        <div class="flex items-center gap-3">
            <button @onclick="OpenModal"
                    class="hidden md:inline-flex items-center gap-1.5 border border-gray-300 text-gray-700 hover:border-gray-700 hover:text-gray-900 px-5 py-2.5 rounded-none font-medium text-xs uppercase tracking-wider transition-colors">
                <span aria-hidden="true">→</span> Login / Sign In
            </button>
            <a href="/schedule"
               class="bg-gray-900 hover:bg-black text-white px-5 py-2.5 rounded-none font-medium text-xs uppercase tracking-wider transition-colors">
                Book Online
            </a>
        </div>

    </div>
</header>

@* ── Hero Section ─────────────────────────────────────────────────────────── *@
<section id="home" class="relative pt-24 pb-32 lg:pt-36 lg:pb-40 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

            <div class="max-w-2xl">
                <h1 class="text-5xl lg:text-7xl font-bold tracking-tighter text-gray-900 leading-none mb-6">
                    Capture <br /> the moment.
                </h1>
                <p class="text-lg text-gray-500 mb-10 leading-relaxed max-w-lg font-light">
                    Professional photography and videography studio specializing in portraits, landscapes, and editorials. Secure your date effortlessly online.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/schedule"
                       class="bg-gray-900 hover:bg-black text-white px-8 py-4 rounded-none font-medium transition-colors text-sm uppercase tracking-wider flex items-center justify-center gap-2 group w-full sm:w-auto">
                        Schedule Appointment
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                    <a href="#services"
                       class="bg-transparent hover:bg-gray-100 text-gray-900 border border-gray-300 px-8 py-4 rounded-none font-medium transition-colors text-sm uppercase tracking-wider flex items-center justify-center w-full sm:w-auto text-center">
                        View Pricing
                    </a>
                </div>
            </div>

            <div class="relative w-full aspect-[4/5] lg:aspect-square bg-gray-200 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1604904612715-47bf9d9bc670?q=80&w=2000&auto=format&fit=crop"
                     alt="Editorial Fashion Shot"
                     class="object-cover w-full h-full grayscale hover:grayscale-0 transition-all duration-700" />

                @* Floating availability card *@
                <div class="absolute bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:bottom-6 sm:w-80 bg-white/95 backdrop-blur-md p-6 shadow-2xl border border-white/20">
                    <div class="flex items-center justify-between mb-4 pb-4 border-b border-gray-100">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Next Available</p>
                            <p class="font-semibold text-gray-900">
                                @(DatabaseServices.FirstOrDefault()?.Title ?? "Portrait Session")
                            </p>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center">
                            <span>📅</span>
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <p class="text-sm font-medium text-gray-900">@DateTime.Today.AddDays(1).ToString("MMM d, 10:00 AM")</p>
                        <a href="/schedule"
                           class="text-xs font-bold text-gray-900 uppercase tracking-wider hover:underline">
                            Book Now
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@* ── Services & Pricing Section (Loaded dynamically from Database) ────────── *@
<section id="services" class="py-24 md:py-32 bg-gray-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
            <div class="max-w-2xl">
                <h2 class="text-3xl md:text-5xl font-bold text-gray-900 tracking-tighter mb-4">Our Services</h2>
                <p class="text-lg text-gray-500 font-light">Explore our active studio services directly from the studio catalog. Transparent pricing, no hidden fees.</p>
            </div>

            <div class="hidden md:flex flex-col items-end gap-2">
                <a href="/schedule" class="inline-flex items-center justify-center border border-gray-300 text-gray-700 hover:border-gray-900 hover:text-gray-900 px-4 py-2 rounded-none font-medium text-xs uppercase tracking-wider transition-colors bg-white">
                    Book Any Service
                </a>
                <p class="text-sm font-medium text-gray-400 uppercase tracking-widest">01 / Services</p>
            </div>
        </div>

        @if (!DatabaseServices.Any())
        {
            <div class="p-12 text-center bg-white border border-gray-200 rounded-lg">
                <p class="text-gray-500 text-base">Loading live services from the database...</p>
            </div>
        }
        else
        {
            @* 3D Carousel Spotlight Container with Extended Span Space *@
            <div class="relative w-full h-[42rem] flex justify-center items-center mt-6 overflow-hidden">

                @* Prev Button *@
                <button type="button"
                        @onclick="PrevSlide"
                        aria-label="Previous service"
                        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-40 inline-flex items-center justify-center w-11 h-11 bg-white/95 backdrop-blur-md border border-gray-200 text-gray-800 hover:bg-gray-900 hover:text-white hover:border-gray-900 active:scale-95 rounded-full shadow-lg transition-all duration-200 group cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform duration-200 group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>

                @* Next Button *@
                <button type="button"
                        @onclick="NextSlide"
                        aria-label="Next service"
                        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-40 inline-flex items-center justify-center w-11 h-11 bg-white/95 backdrop-blur-md border border-gray-200 text-gray-800 hover:bg-gray-900 hover:text-white hover:border-gray-900 active:scale-95 rounded-full shadow-lg transition-all duration-200 group cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>

                @* Dynamic Service Cards from Database *@
                @for (int i = 0; i < CarouselItems.Count; i++)
                {
                    int index = i;
                    var svc = CarouselItems[index];
                    string serviceImg = !string.IsNullOrWhiteSpace(svc.ImageBase64) 
                        ? svc.ImageBase64 
                        : GetServiceFallbackImage(svc.Code, index);

                    <div @onclick="() => SetActive(index)"
                         class="absolute transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] cursor-pointer w-[18rem] sm:w-[21rem] md:w-[24rem] bg-white rounded-2xl border border-gray-200/80 p-5 @GetCardClass(index)">
                        @if (index == 0 || svc.IsFeatured)
                        {
                            <div class="absolute -top-3 right-6 bg-gray-900 text-white text-[11px] font-bold uppercase tracking-wider px-3.5 py-1 rounded-full shadow-md z-10 flex items-center gap-1.5 border border-white/20">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span>Featured</span>
                            </div>
                        }

                        @* High-Res Studio Image Container with Badges *@
                        <div class="aspect-4/3 sm:aspect-square bg-gray-950 rounded-xl mb-4 relative overflow-hidden group shadow-inner">
                            <img src="@serviceImg" alt="@svc.Title" class="object-cover w-full h-full transition-all duration-700 group-hover:scale-105">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/10"></div>
                            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs text-white/90">
                                <span class="px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md text-[11px] font-semibold uppercase tracking-wider border border-white/10">
                                    @svc.Category
                                </span>
                                <span class="px-2.5 py-1 rounded-md bg-white/20 backdrop-blur-md text-[11px] font-medium text-white">
                                    @svc.Duration
                                </span>
                            </div>
                        </div>

                        @* Detailed Service Information from Database *@
                        <div class="px-1 text-center">
                            <h3 class="text-xl md:text-2xl font-extrabold text-gray-900 mb-1.5 tracking-tight line-clamp-1">@svc.Title</h3>
                            
                            <div class="inline-flex items-baseline gap-1 my-1.5">
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Starting at</span>
                                <span class="text-2xl font-black text-gray-900 tracking-tight">
                                    @(svc.BasePrice > 0 ? $"₱{svc.BasePrice:N0}" : "Custom Quote")
                                </span>
                            </div>

                            <p class="text-gray-500 font-normal text-xs md:text-sm leading-relaxed mb-4 line-clamp-2 min-h-[2.5rem]">
                                @(!string.IsNullOrWhiteSpace(svc.Description) ? svc.Description : "Professional photography session executed in our premium studio bay.")
                            </p>

                            <a href="/schedule" class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-gray-900 hover:bg-black text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-sm hover:shadow transition-all duration-200">
                                <span>Schedule Session</span>
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                </svg>
                            </a>
                        </div>
                    </div>
                }

            </div>

            @* Pagination Dots *@
            @if (CarouselItems.Count > 1)
            {
                <div class="flex justify-center gap-3 mt-8">
                    @for (int i = 0; i < CarouselItems.Count; i++)
                    {
                        int dotIdx = i;
                        <button type="button"
                                @onclick="() => SetActive(dotIdx)"
                                aria-label="Go to service slide @(dotIdx + 1)"
                                class="w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer @(activeIndex == dotIdx ? "bg-gray-900 scale-125" : "bg-gray-300 hover:bg-gray-400")"></button>
                    }
                </div>
            }
        }

    </div>
</section>

@* ── FAQ Section ─────────────────────────────────────────────────────────── *@
<section id="faq" class="py-20 md:py-32 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 md:mb-16">
            <h2 class="text-3xl md:text-5xl font-bold text-gray-900 tracking-tighter mb-4">Frequently Asked Questions</h2>
            <p class="text-base md:text-lg text-gray-500 font-light">Everything you need to know before booking your session.</p>
        </div>

        <div class="space-y-4">
            <details class="bg-white border border-gray-200 group cursor-pointer" open="open">
                <summary class="flex justify-between items-center p-6 text-lg font-medium text-gray-900 select-none">
                    How do I book a session?
                    <span class="relative w-6 h-6 flex items-center justify-center">
                        <span class="absolute w-4 h-0.5 bg-gray-900 transition-transform group-open:rotate-180"></span>
                        <span class="absolute w-0.5 h-4 bg-gray-900 transition-transform group-open:rotate-90"></span>
                    </span>
                </summary>
                <div class="px-6 pb-6 text-gray-500 font-light leading-relaxed">
                    Booking is handled entirely online through our appointment system. Simply select your desired service above, choose an available date and time from the calendar, and complete the reservation to secure your spot.
                </div>
            </details>

            <details class="bg-white border border-gray-200 group cursor-pointer">
                <summary class="flex justify-between items-center p-6 text-lg font-medium text-gray-900 select-none">
                    Do you provide a makeup artist or stylist?
                    <span class="relative w-6 h-6 flex items-center justify-center">
                        <span class="absolute w-4 h-0.5 bg-gray-900 transition-transform group-open:rotate-180"></span>
                        <span class="absolute w-0.5 h-4 bg-gray-900 transition-transform group-open:rotate-90"></span>
                    </span>
                </summary>
                <div class="px-6 pb-6 text-gray-500 font-light leading-relaxed">
                    Standard packages do not include a dedicated makeup artist or stylist. However, we have a network of trusted professionals we can recommend, or you can request one as an add-on during booking.
                </div>
            </details>

            <details class="bg-white border border-gray-200 group cursor-pointer">
                <summary class="flex justify-between items-center p-6 text-lg font-medium text-gray-900 select-none">
                    When will I receive my photos?
                    <span class="relative w-6 h-6 flex items-center justify-center">
                        <span class="absolute w-4 h-0.5 bg-gray-900 transition-transform group-open:rotate-180"></span>
                        <span class="absolute w-0.5 h-4 bg-gray-900 transition-transform group-open:rotate-90"></span>
                    </span>
                </summary>
                <div class="px-6 pb-6 text-gray-500 font-light leading-relaxed">
                    You will receive an online proofing gallery within 48 hours of your shoot to select your favorites. Final retouched photos will be delivered via your private digital gallery within 7 business days.
                </div>
            </details>
        </div>
    </div>
</section>

@* ── Floating Pop-Up Portfolio Showcase Screen ──────────────────────────── *@
@if (_portfolioOpen)
{
    <div class="fixed inset-0 z-[70] bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6 md:p-8 animate-in fade-in duration-200"
         @onclick="ClosePortfolio">

        <div role="dialog"
             aria-modal="true"
             aria-label="Studio Featured Portfolios"
             class="bg-white rounded-3xl shadow-2xl border border-gray-100 w-full max-w-5xl max-h-[88vh] flex flex-col overflow-hidden animate-in zoom-in-95 duration-200 relative"
             @onclick:stopPropagation="true">

            @* Modal Header *@
            <div class="flex items-center justify-between px-6 sm:px-8 py-5 border-b border-gray-100 bg-white">
                <div class="flex items-center gap-3">
                    <span class="text-[11px] font-bold uppercase tracking-widest text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200">
                        ★ Featured Showcase
                    </span>
                    <h2 class="text-lg sm:text-xl font-black text-gray-900 tracking-tight">Studio Portfolio</h2>
                </div>
                <button @onclick="ClosePortfolio"
                        type="button"
                        aria-label="Close portfolio modal"
                        class="w-10 h-10 flex items-center justify-center text-gray-400 hover:text-gray-900 hover:bg-gray-100 rounded-full transition-colors text-base font-bold cursor-pointer">
                    ✕
                </button>
            </div>

            @if (_selectedPortfolio != null)
            {
                @* ── Album Photos View (Drill-down inside floating popup) ── *@
                <div class="px-6 sm:px-8 py-4 border-b border-gray-100 bg-gray-50/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <button type="button" @onclick="BackToPortfolioList"
                                class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-600 hover:text-black uppercase tracking-wider mb-1.5 transition-colors">
                            <span>&larr;</span> <span>Back to Featured Albums</span>
                        </button>
                        <h3 class="text-xl font-black text-gray-900 tracking-tight">@_selectedPortfolio.PortfolioName</h3>
                        @if (!string.IsNullOrWhiteSpace(_selectedPortfolio.PortfolioDescription))
                        {
                            <p class="text-xs text-gray-500 font-light mt-0.5 max-w-xl">@_selectedPortfolio.PortfolioDescription</p>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold text-gray-500 bg-white border border-gray-200 px-3 py-1 rounded-full">
                            📷 @_selectedPortfolio.Images.Count photos
                        </span>
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto p-6 sm:p-8">
                    @if (_selectedPortfolio.Images.Count == 0)
                    {
                        <div class="py-20 text-center text-gray-400">
                            <p class="text-3xl mb-2">🖼️</p>
                            <p class="text-xs font-medium">No photos uploaded to this album yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                            @for (int idx = 0; idx < _selectedPortfolio.Images.Count; idx++)
                            {
                                var photoIdx = idx;
                                var img = _selectedPortfolio.Images[photoIdx];
                                <div class="group relative aspect-square bg-gray-100 rounded-xl overflow-hidden border border-gray-200 cursor-pointer shadow-xs hover:shadow-lg transition-all"
                                     @onclick="() => OpenLightbox(photoIdx)">
                                    <img src="@img.Url"
                                         alt="@_selectedPortfolio.PortfolioName"
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                         onerror="this.src='images/AevumLogo.jpg';" />
                                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors flex items-center justify-center">
                                        <span class="text-white opacity-0 group-hover:opacity-100 text-xs font-bold bg-black/60 px-3 py-1.5 rounded-full backdrop-blur-xs transition-opacity">
                                            🔍 Expand
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @* ── Featured Albums Grid View (Inside floating popup) ── *@
                @if (_featuredCategories.Count > 1)
                {
                    <div class="px-6 sm:px-8 py-3 border-b border-gray-100 flex items-center gap-2 overflow-x-auto bg-gray-50/50">
                        <button type="button"
                                @onclick='() => _selectedCategoryFilter = "All"'
                                class="px-3.5 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-colors @(_selectedCategoryFilter == "All" ? "bg-gray-900 text-white" : "bg-white text-gray-600 border border-gray-200 hover:border-gray-400")">
                            All (@_featuredPortfolios.Count)
                        </button>
                        @foreach (var cat in _featuredCategories)
                        {
                            var catName = cat;
                            var cnt = _featuredPortfolios.Count(p => p.CategoryName.Equals(catName, StringComparison.OrdinalIgnoreCase) || p.CategoryID.Equals(catName, StringComparison.OrdinalIgnoreCase));
                            <button type="button"
                                    @onclick="() => _selectedCategoryFilter = catName"
                                    class="px-3.5 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-colors @(_selectedCategoryFilter == catName ? "bg-gray-900 text-white" : "bg-white text-gray-600 border border-gray-200 hover:border-gray-400")">
                                @catName (@cnt)
                            </button>
                        }
                    </div>
                }

                <div class="flex-1 overflow-y-auto p-6 sm:p-8">
                    @if (_portfolioLoading)
                    {
                        <div class="py-24 text-center text-gray-400 text-xs">
                            <span class="inline-block w-6 h-6 border-2 border-gray-300 border-t-gray-900 rounded-full animate-spin mb-2"></span>
                            <p>Loading featured portfolios...</p>
                        </div>
                    }
                    else if (!VisibleFeaturedPortfolios.Any())
                    {
                        <div class="py-24 text-center text-gray-400">
                            <p class="text-3xl mb-2">🎨</p>
                            <h3 class="text-sm font-bold text-gray-800">No Featured Portfolios</h3>
                            <p class="text-xs text-gray-500 mt-1">Curated studio showcases will appear here once featured.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
                            @foreach (var port in VisibleFeaturedPortfolios)
                            {
                                var p = port;
                                <article class="bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 group cursor-pointer flex flex-col"
                                         @onclick="() => OpenPortfolioAlbum(p)">
                                    <div class="relative h-44 bg-gray-950 overflow-hidden">
                                        <img src="@p.HighlightImageUrl"
                                             alt="@p.PortfolioName"
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                             onerror="this.src='images/AevumLogo.jpg';" />
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                                        
                                        <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
                                            <span class="bg-amber-400 text-slate-950 text-[9px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full shadow-md">
                                                ★ Featured
                                            </span>
                                        </div>
                                        
                                        <div class="absolute top-2.5 right-2.5">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-black/60 backdrop-blur-xs text-white">
                                                📷 @p.Images.Count
                                            </span>
                                        </div>

                                        <div class="absolute bottom-2.5 left-3 right-3 text-white">
                                            <span class="text-[9px] uppercase font-bold tracking-wider text-amber-400 block mb-0.5">@p.CategoryName</span>
                                            <h3 class="text-base font-bold tracking-tight text-white group-hover:text-amber-200 transition-colors line-clamp-1">
                                                @p.PortfolioName
                                            </h3>
                                        </div>
                                    </div>

                                    <div class="p-3.5 flex items-center justify-between mt-auto">
                                        <p class="text-xs text-gray-500 line-clamp-1 pr-2">
                                            @(!string.IsNullOrWhiteSpace(p.PortfolioDescription) ? p.PortfolioDescription : "Studio album showcase.")
                                        </p>
                                        <span class="inline-flex items-center gap-1 text-xs font-bold text-gray-900 group-hover:translate-x-1 transition-transform whitespace-nowrap">
                                            <span>View</span> <span>&rarr;</span>
                                        </span>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            }

        </div>
    </div>
}

@* ── Lightbox Modal for Fullscreen Photo Viewing ───────────────────────── *@
@if (_lightboxOpen && _selectedPortfolio != null && _lightboxIndex >= 0 && _lightboxIndex < _selectedPortfolio.Images.Count)
{
    var currentImg = _selectedPortfolio.Images[_lightboxIndex];
    <div class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-md flex flex-col justify-between p-4 sm:p-8 animate-in fade-in duration-200"
         @onclick="CloseLightbox">
        
        <!-- Lightbox Header -->
        <div class="flex items-center justify-between text-white z-10" @onclick:stopPropagation="true">
            <div>
                <span class="text-xs uppercase tracking-wider text-amber-400 font-bold block">@_selectedPortfolio.CategoryName</span>
                <h3 class="text-base sm:text-lg font-bold text-white">@_selectedPortfolio.PortfolioName</h3>
                <p class="text-xs text-gray-400">Photo @(_lightboxIndex + 1) of @_selectedPortfolio.Images.Count</p>
            </div>
            <button type="button"
                    @onclick="CloseLightbox"
                    class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors text-lg cursor-pointer">
                ✕
            </button>
        </div>

        <!-- Image with Next/Prev Controls -->
        <div class="relative flex-1 flex items-center justify-center my-4 overflow-hidden" @onclick:stopPropagation="true">
            @if (_selectedPortfolio.Images.Count > 1)
            {
                <button type="button"
                        @onclick="PrevLightboxPhoto"
                        class="absolute left-2 sm:left-4 z-20 w-12 h-12 rounded-full bg-black/60 hover:bg-black/90 text-white border border-white/20 flex items-center justify-center text-xl transition-all cursor-pointer">
                    ‹
                </button>
            }

            <img src="@currentImg.Url"
                 alt="@_selectedPortfolio.PortfolioName"
                 class="max-h-[75vh] max-w-[90vw] object-contain rounded-lg shadow-2xl transition-all duration-300"
                 onerror="this.src='images/AevumLogo.jpg';" />

            @if (_selectedPortfolio.Images.Count > 1)
            {
                <button type="button"
                        @onclick="NextLightboxPhoto"
                        class="absolute right-2 sm:right-4 z-20 w-12 h-12 rounded-full bg-black/60 hover:bg-black/90 text-white border border-white/20 flex items-center justify-center text-xl transition-all cursor-pointer">
                    ›
                </button>
            }
        </div>

        <!-- Lightbox Footer / Thumbnails -->
        <div class="flex justify-center gap-2 overflow-x-auto py-2 z-10" @onclick:stopPropagation="true">
            @for (int i = 0; i < _selectedPortfolio.Images.Count; i++)
            {
                var thumbIdx = i;
                var thumb = _selectedPortfolio.Images[thumbIdx];
                <button type="button"
                        @onclick="() => _lightboxIndex = thumbIdx"
                        class="w-12 h-12 rounded-md overflow-hidden border-2 transition-all flex-shrink-0 cursor-pointer @(_lightboxIndex == thumbIdx ? "border-amber-400 scale-105" : "border-transparent opacity-50 hover:opacity-100")">
                    <img src="@thumb.Url" alt="Thumbnail" class="w-full h-full object-cover" onerror="this.src='images/AevumLogo.jpg';" />
                </button>
            }
        </div>
    </div>
}

@code {
    private List<MainServiceItem> DatabaseServices = new();
    private List<MainServiceItem> CarouselItems = new();
    private int activeIndex = 0;

    protected override void OnInitialized()
    {
        try
        {
            DatabaseServices = UserService.GetMainServices().Where(s => s.IsActive).ToList();
            if (DatabaseServices.Any())
            {
                CarouselItems = DatabaseServices.Take(5).ToList();
                activeIndex = CarouselItems.Count > 1 ? 1 : 0;
            }
            else
            {
                // Fallback if database table is not yet seeded
                CarouselItems = new List<MainServiceItem>
                {
                    new() { Code = "SRV-001", Title = "Portrait Session", BasePrice = 250m, Duration = "1 Hr", Description = "1-hour studio or location shoot with retouched deliverables." },
                    new() { Code = "SRV-002", Title = "Brand & Editorial", BasePrice = 450m, Duration = "4 Hrs", Description = "Half-day session tailored for personal brands and influencers." },
                    new() { Code = "SRV-003", Title = "Express Headshot", BasePrice = 150m, Duration = "30 Min", Description = "Quick studio session ideal for executive headshots." }
                };
                activeIndex = 1;
            }
        }
        catch
        {
            CarouselItems = new List<MainServiceItem>();
        }
    }

    private void SetActive(int index)
    {
        if (index >= 0 && index < CarouselItems.Count)
            activeIndex = index;
    }

    private void NextSlide()
    {
        if (CarouselItems.Count > 0)
            activeIndex = (activeIndex + 1) % CarouselItems.Count;
    }

    private void PrevSlide()
    {
        if (CarouselItems.Count > 0)
            activeIndex = (activeIndex - 1 + CarouselItems.Count) % CarouselItems.Count;
    }

    private string GetCardClass(int cardIndex)
    {
        if (CarouselItems.Count == 0) return "hidden";

        int count = CarouselItems.Count;
        int diff = (cardIndex - activeIndex) % count;
        if (diff > count / 2) diff -= count;
        if (diff < -count / 2) diff += count;

        if (diff == 0)
        {
            return "z-30 scale-100 opacity-100 translate-x-0 shadow-2xl ring-1 ring-black/5 pointer-events-auto";
        }
        else if (diff == -1)
        {
            return "z-20 scale-85 opacity-70 hover:opacity-100 -translate-x-[22rem] sm:-translate-x-[26rem] md:-translate-x-[31rem] shadow-xl pointer-events-auto";
        }
        else if (diff == 1)
        {
            return "z-20 scale-85 opacity-70 hover:opacity-100 translate-x-[22rem] sm:translate-x-[26rem] md:translate-x-[31rem] shadow-xl pointer-events-auto";
        }
        else
        {
            return "z-10 scale-70 opacity-0 pointer-events-none translate-x-0";
        }
    }

    private static string GetServiceFallbackImage(string code, int index) => (index % 3) switch
    {
        0 => "https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?q=80&w=800&auto=format&fit=crop",
        1 => "https://images.unsplash.com/photo-1604904612715-47bf9d9bc670?q=80&w=800&auto=format&fit=crop",
        _ => "https://images.unsplash.com/photo-1542038784456-1ea8e935640e?q=80&w=800&auto=format&fit=crop"
    };

    private bool _modalOpen = false;
    private void OpenModal() => _modalOpen = true;
    private void CloseModal() => _modalOpen = false;



    // ── Portfolio sidebar (Featured Albums & Photos Only) ────────────
    private bool _portfolioOpen = false;
    private bool _portfolioLoading = false;
    private List<PortfolioFolderModel> _featuredPortfolios = new();
    private List<string> _featuredCategories = new();
    private string _selectedCategoryFilter = "All";
    private PortfolioFolderModel? _selectedPortfolio;

    // Lightbox Modal state
    private bool _lightboxOpen = false;
    private int _lightboxIndex = 0;

    private IEnumerable<PortfolioFolderModel> VisibleFeaturedPortfolios =>
        _selectedCategoryFilter == "All"
            ? _featuredPortfolios
            : _featuredPortfolios.Where(p =>
                string.Equals(p.CategoryName, _selectedCategoryFilter, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.CategoryID, _selectedCategoryFilter, StringComparison.OrdinalIgnoreCase));

    private async Task TogglePortfolio()
    {
        _portfolioOpen = !_portfolioOpen;
        if (_portfolioOpen)
        {
            await LoadFeaturedPortfoliosAsync();
        }
    }

    private void ClosePortfolio()
    {
        _portfolioOpen = false;
        _selectedPortfolio = null;
        _lightboxOpen = false;
    }

    private async Task LoadFeaturedPortfoliosAsync()
    {
        _portfolioLoading = true;
        try
        {
            _featuredPortfolios = await PortfolioService.GetPortfoliosAsync(featuredOnly: true);
            _featuredCategories = _featuredPortfolios
                .Select(p => p.CategoryName)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(c => c)
                .ToList();
        }
        catch
        {
            _featuredPortfolios = new();
            _featuredCategories = new();
        }
        finally
        {
            _portfolioLoading = false;
        }
    }

    private void OpenPortfolioAlbum(PortfolioFolderModel portfolio)
    {
        _selectedPortfolio = portfolio;
    }

    private void BackToPortfolioList()
    {
        _selectedPortfolio = null;
    }

    private void OpenLightbox(int index)
    {
        _lightboxIndex = index;
        _lightboxOpen = true;
    }

    private void CloseLightbox()
    {
        _lightboxOpen = false;
    }

    private void NextLightboxPhoto()
    {
        if (_selectedPortfolio?.Images.Count > 0)
        {
            _lightboxIndex = (_lightboxIndex + 1) % _selectedPortfolio.Images.Count;
        }
    }

    private void PrevLightboxPhoto()
    {
        if (_selectedPortfolio?.Images.Count > 0)
        {
            _lightboxIndex = (_lightboxIndex - 1 + _selectedPortfolio.Images.Count) % _selectedPortfolio.Images.Count;
        }
    }
}
