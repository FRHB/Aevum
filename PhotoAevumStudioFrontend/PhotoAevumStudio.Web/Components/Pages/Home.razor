@page "/"
@page "/Home"
@rendermode InteractiveServer

<PageTitle>Photo Aevum Studio | Book Your Session</PageTitle>

<section class="relative pt-24 pb-32 lg:pt-36 lg:pb-40 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            
            <div class="max-w-2xl">
                <h1 class="text-5xl lg:text-7xl font-bold tracking-tighter text-gray-900 leading-none mb-6">
                    Capture <br/> the moment.
                </h1>
                <p class="text-lg text-gray-500 mb-10 leading-relaxed max-w-lg font-light">
                    Professional photography and videography studio specializing in portraits, landscapes, and editorials. Secure your date effortlessly online.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <button class="bg-gray-900 hover:bg-black text-white px-8 py-4 rounded-none font-medium transition-colors text-sm uppercase tracking-wider flex items-center justify-center gap-2 group w-full sm:w-auto">
                        Schedule Appointment
                        <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                    <a href="#services" class="bg-transparent hover:bg-gray-100 text-gray-900 border border-gray-300 px-8 py-4 rounded-none font-medium transition-colors text-sm uppercase tracking-wider flex items-center justify-center w-full sm:w-auto text-center">
                        View Pricing
                    </a>
                </div>
            </div>

            <div class="relative w-full aspect-[4/5] lg:aspect-square bg-gray-200 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1604904612715-47bf9d9bc670?q=80&w=2000&auto=format&fit=crop" alt="Editorial Fashion Shot" class="object-cover w-full h-full grayscale hover:grayscale-0 transition-all duration-700">
                
                <div class="absolute bottom-6 left-6 right-6 sm:left-auto sm:right-6 sm:bottom-6 sm:w-80 bg-white/95 backdrop-blur-md p-6 shadow-2xl border border-white/20">
                    <div class="flex items-center justify-between mb-4 pb-4 border-b border-gray-100">
                        <div>
                            <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Next Available</p>
                            <p class="font-semibold text-gray-900">Portrait Session</p>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center">
                            <i data-lucide="calendar" class="w-5 h-5 text-gray-600"></i>
                        </div>
                    </div>
                    <div class="flex justify-between items-center">
                        <p class="text-sm font-medium text-gray-900">Oct 24, 10:00 AM</p>
                        <button class="text-xs font-bold text-gray-900 uppercase tracking-wider hover:underline">Book Now</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services & Pricing Section -->
<section id="services" class="py-24 md:py-32 bg-gray-50 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
            <div class="max-w-2xl">
                <h2 class="text-3xl md:text-5xl font-bold text-gray-900 tracking-tighter mb-4">Our Services</h2>
                <p class="text-lg text-gray-500 font-light">Click any card to bring it to the spotlight. Transparent pricing, no hidden fees.</p>
            </div>
            <p class="text-sm font-medium text-gray-400 uppercase tracking-widest hidden md:block">01 / Services</p>
        </div>

        <!-- 3D Carousel Spotlight Container -->
        <div class="relative w-full h-[36rem] flex justify-center items-center mt-12">
            
            <!-- Service 0: Portrait Session -->
            <div @onclick="() => SetActive(0)" 
                 class="absolute transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] cursor-pointer w-72 md:w-96 bg-white p-4 @GetCardClass(0)">
                <div class="aspect-square bg-gray-900 mb-6 relative overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?q=80&w=800&auto=format&fit=crop" alt="Portrait Session" class="object-cover w-full h-full opacity-90 transition-opacity duration-500">
                </div>
                <div class="px-2 pb-8 text-center">
                    <h3 class="text-2xl font-bold text-gray-900 mb-1 tracking-tight">Portrait Session</h3>
                    <p class="text-lg font-light text-gray-500 mb-4">From $250</p>
                    <p class="text-gray-500 font-light text-sm leading-relaxed mb-4 hidden md:block">1-hour studio or location shoot. Includes 15 retouched digital images and online gallery.</p>
                    <div class="flex justify-center gap-4 text-xs text-gray-400 uppercase tracking-wider font-medium">
                        <span>1 Hr</span><span>&bull;</span><span>1-2 Looks</span>
                    </div>
                </div>
            </div>

            <!-- Service 1: Brand & Editorial -->
            <div @onclick="() => SetActive(1)" 
                 class="absolute transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] cursor-pointer w-72 md:w-96 bg-white p-4 @GetCardClass(1)">
                <div class="absolute top-0 right-0 bg-gray-900 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 -mt-3 mr-8 shadow-sm z-10">Popular</div>
                <div class="aspect-square bg-gray-900 mb-6 relative overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1604904612715-47bf9d9bc670?q=80&w=800&auto=format&fit=crop" alt="Brand & Editorial" class="object-cover w-full h-full opacity-90 transition-opacity duration-500">
                </div>
                <div class="px-2 pb-8 text-center">
                    <h3 class="text-2xl font-bold text-gray-900 mb-1 tracking-tight">Brand & Editorial</h3>
                    <p class="text-lg font-light text-gray-500 mb-4">From $450</p>
                    <p class="text-gray-500 font-light text-sm leading-relaxed mb-4 hidden md:block">Half-day session tailored for personal brands, influencers, or small businesses. 30 retouched images.</p>
                    <div class="flex justify-center gap-4 text-xs text-gray-400 uppercase tracking-wider font-medium">
                        <span>4 Hrs</span><span>&bull;</span><span>Unlimited</span>
                    </div>
                </div>
            </div>

            <!-- Service 2: Mini Session -->
            <div @onclick="() => SetActive(2)" 
                 class="absolute transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] cursor-pointer w-72 md:w-96 bg-white p-4 @GetCardClass(2)">
                <div class="aspect-square bg-gray-900 mb-6 relative overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1542038784456-1ea8e935640e?q=80&w=800&auto=format&fit=crop" alt="Mini Session" class="object-cover w-full h-full opacity-90 transition-opacity duration-500">
                </div>
                <div class="px-2 pb-8 text-center">
                    <h3 class="text-2xl font-bold text-gray-900 mb-1 tracking-tight">Mini Session</h3>
                    <p class="text-lg font-light text-gray-500 mb-4">From $150</p>
                    <p class="text-gray-500 font-light text-sm leading-relaxed mb-4 hidden md:block">Quick 30-minute session ideal for professional headshots or a quick aesthetic update.</p>
                    <div class="flex justify-center gap-4 text-xs text-gray-400 uppercase tracking-wider font-medium">
                        <span>30 Min</span><span>&bull;</span><span>1 Look</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Pagination Dots -->
        <div class="flex justify-center gap-3 mt-8">
            <button @onclick="() => SetActive(0)" class="w-2.5 h-2.5 rounded-full transition-all duration-300 @(activeIndex == 0 ? "bg-gray-900 scale-125" : "bg-gray-300 hover:bg-gray-400")"></button>
            <button @onclick="() => SetActive(1)" class="w-2.5 h-2.5 rounded-full transition-all duration-300 @(activeIndex == 1 ? "bg-gray-900 scale-125" : "bg-gray-300 hover:bg-gray-400")"></button>
            <button @onclick="() => SetActive(2)" class="w-2.5 h-2.5 rounded-full transition-all duration-300 @(activeIndex == 2 ? "bg-gray-900 scale-125" : "bg-gray-300 hover:bg-gray-400")"></button>
        </div>

    </div>
</section>

<!-- FAQ Section -->
<section id="faq" class="py-20 md:py-32 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 md:mb-16">
            <h2 class="text-3xl md:text-5xl font-bold text-gray-900 tracking-tighter mb-4">Frequently Asked Questions</h2>
            <p class="text-base md:text-lg text-gray-500 font-light">Everything you need to know before booking your session.</p>
        </div>

        <div class="space-y-4">
            <details class="bg-white border border-gray-200 group cursor-pointer" open="open">
                <summary class="flex justify-between items-center p-6 text-lg font-medium text-gray-900 select-none">
                    How do I book a session?
                    <span class="relative w-6 h-6 flex items-center justify-center">
                        <span class="absolute w-4 h-0.5 bg-gray-900 transition-transform group-open:rotate-180"></span>
                        <span class="absolute w-0.5 h-4 bg-gray-900 transition-transform group-open:rotate-90"></span>
                    </span>
                </summary>
                <div class="px-6 pb-6 text-gray-500 font-light leading-relaxed">
                    Booking is handled entirely online through our appointment system. Simply select your desired service above, choose an available date and time from the calendar, and complete the checkout process to secure your spot.
                </div>
            </details>

            <details class="bg-white border border-gray-200 group cursor-pointer">
                <summary class="flex justify-between items-center p-6 text-lg font-medium text-gray-900 select-none">
                    Do you provide a makeup artist or stylist?
                    <span class="relative w-6 h-6 flex items-center justify-center">
                        <span class="absolute w-4 h-0.5 bg-gray-900 transition-transform group-open:rotate-180"></span>
                        <span class="absolute w-0.5 h-4 bg-gray-900 transition-transform group-open:rotate-90"></span>
                    </span>
                </summary>
                <div class="px-6 pb-6 text-gray-500 font-light leading-relaxed">
                    Standard packages do not include a dedicated makeup artist or stylist. However, we have a network of trusted professionals we can recommend, or we can arrange them for you for an additional fee when you book the Brand & Editorial package.
                </div>
            </details>

            <details class="bg-white border border-gray-200 group cursor-pointer">
                <summary class="flex justify-between items-center p-6 text-lg font-medium text-gray-900 select-none">
                    When will I receive my photos?
                    <span class="relative w-6 h-6 flex items-center justify-center">
                        <span class="absolute w-4 h-0.5 bg-gray-900 transition-transform group-open:rotate-180"></span>
                        <span class="absolute w-0.5 h-4 bg-gray-900 transition-transform group-open:rotate-90"></span>
                    </span>
                </summary>
                <div class="px-6 pb-6 text-gray-500 font-light leading-relaxed">
                    You will receive an online proofing gallery within 48 hours of your shoot to select your favorites. Once you've chosen your images, final retouched photos will be delivered via a private digital gallery within 7-10 business days.
                </div>
            </details>

            <details class="bg-white border border-gray-200 group cursor-pointer">
                <summary class="flex justify-between items-center p-6 text-lg font-medium text-gray-900 select-none">
                    What is your cancellation policy?
                    <span class="relative w-6 h-6 flex items-center justify-center">
                        <span class="absolute w-4 h-0.5 bg-gray-900 transition-transform group-open:rotate-180"></span>
                        <span class="absolute w-0.5 h-4 bg-gray-900 transition-transform group-open:rotate-90"></span>
                    </span>
                </summary>
                <div class="px-6 pb-6 text-gray-500 font-light leading-relaxed">
                    We require a 50% non-refundable retainer to secure your date. If you need to reschedule, please let us know at least 48 hours in advance, and we will apply your retainer to a future date within 6 months.
                </div>
            </details>
        </div>
    </div>
</section>

@code {
    private int activeIndex = 1; 

    private void SetActive(int index)
    {
        activeIndex = index;
    }

    private string GetCardClass(int cardIndex)
    {
        if (cardIndex == activeIndex)
        {
            return "z-30 scale-100 opacity-100 translate-x-0 shadow-2xl";
        }
        else if (cardIndex < activeIndex)
        {
            return "z-20 scale-75 md:scale-85 opacity-40 hover:opacity-75 -translate-x-28 md:-translate-x-64 shadow-lg";
        }
        else
        {
            return "z-20 scale-75 md:scale-85 opacity-40 hover:opacity-75 translate-x-28 md:translate-x-64 shadow-lg";
        }
    }
}