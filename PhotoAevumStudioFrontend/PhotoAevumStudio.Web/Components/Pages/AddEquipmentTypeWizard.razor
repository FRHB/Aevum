@using System.ComponentModel.DataAnnotations
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IEquipmentService EquipmentService

@if (IsOpen)
{
    <!-- Modal Backdrop -->
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6 overflow-y-auto animate-in fade-in duration-150"
         role="dialog"
         aria-modal="true"
         aria-labelledby="equipment-type-modal-title">

        <!-- Modal Surface Container -->
        <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-100 overflow-hidden flex flex-col">
            
            <!-- Modal Header -->
            <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-white">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-sm shadow-xs">
                        <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                        </svg>
                    </div>
                    <div>
                        <h2 id="equipment-type-modal-title" class="text-lg font-bold text-slate-900 leading-snug">
                            @(IsEditMode ? "Edit Equipment Type" : "Add Equipment Type")
                        </h2>
                        <p class="text-xs text-slate-500">@(IsEditMode ? "Update master category details for equipment inventory" : "Configure master categories for equipment inventory")</p>
                    </div>
                </div>

                <button type="button"
                        @onclick="CloseModalAsync"
                        disabled="@(isSubmitting || isGeneratingId)"
                        class="text-slate-400 hover:text-slate-600 rounded-lg p-1.5 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-900"
                        aria-label="Close dialog">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- 2-Step Progress Header -->
            <div class="px-6 py-3.5 bg-slate-50/80 border-b border-slate-100">
                <ol class="flex items-center justify-between w-full">
                    <!-- Step 1: Details -->
                    <li class="flex items-center w-full">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                                  @(currentStep == 1 
                                      ? "bg-slate-900 text-white ring-2 ring-slate-900/20" 
                                      : "bg-emerald-600 text-white")">
                                @(currentStep > 1 ? "✓" : "1")
                            </span>
                            <span class="text-xs font-semibold @(currentStep == 1 ? "text-slate-900 font-bold" : "text-emerald-700")">
                                Details Input
                            </span>
                        </div>
                        <div class="flex-1 mx-3 h-0.5 @(currentStep > 1 ? "bg-emerald-500" : "bg-slate-200")"></div>
                    </li>

                    <!-- Step 2: Overview & Save -->
                    <li class="flex items-center">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                                  @(currentStep == 2 
                                      ? "bg-slate-900 text-white ring-2 ring-slate-900/20" 
                                      : "bg-slate-200 text-slate-500")">
                                2
                            </span>
                            <span class="text-xs font-semibold @(currentStep == 2 ? "text-slate-900 font-bold" : "text-slate-400")">
                                Overview &amp; Save
                            </span>
                        </div>
                    </li>
                </ol>
            </div>

            <!-- Wizard Body -->
            <div class="p-6">
                <EditForm EditContext="@editContext">
                    <DataAnnotationsValidator />

                    <!-- ======================================================== -->
                    <!-- PAGE 1: DETAILS INPUT                                    -->
                    <!-- ======================================================== -->
                    @if (currentStep == 1)
                    {
                        <div class="space-y-4">
                            <div>
                                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Step 1 of 2</span>
                                <h3 class="text-sm font-bold text-slate-800 mt-0.5">Enter Equipment Category Name</h3>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    Provide the display name for this equipment category (e.g. Cinema Cameras, Prime Lenses, Wireless Audio).
                                </p>
                            </div>

                            @if (IsEditMode && !string.IsNullOrWhiteSpace(formModel.EquipmentTypeId))
                            {
                                <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between">
                                    <div>
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Equipment Type ID (System-Assigned)</span>
                                        <p class="font-mono text-sm font-bold text-slate-900">@formModel.EquipmentTypeId</p>
                                    </div>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                        Strictly Read-Only
                                    </span>
                                </div>
                            }

                            <div>
                                <label for="eq-type-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                                    Equipment Type Name <span class="text-rose-500">*</span>
                                </label>
                                <InputText id="eq-type-name"
                                           @bind-Value="formModel.EquipmentTypeName"
                                           class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 transition-shadow" />
                                <ValidationMessage For="@(() => formModel.EquipmentTypeName)" class="text-[11px] text-rose-600 mt-1.5 font-medium" />
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                                    UI Color Tag
                                </label>
                                <InputSelect @bind-Value="formModel.ColorTag"
                                             class="w-full px-3.5 py-2.5 text-xs rounded-lg border border-slate-300 bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900">
                                    <option value="Purple">Purple (Cameras &amp; Bodies)</option>
                                    <option value="Blue">Blue (Lenses &amp; Optics)</option>
                                    <option value="Amber">Amber (Lighting &amp; Strobes)</option>
                                    <option value="Emerald">Emerald (Modifiers &amp; Softboxes)</option>
                                    <option value="Rose">Rose (Audio &amp; Wireless Mics)</option>
                                    <option value="Slate">Slate (Grips &amp; C-Stands)</option>
                                    <option value="Cyan">Cyan (Gimbals &amp; Drones)</option>
                                </InputSelect>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-xs font-medium">
                                    @errorMessage
                                </div>
                            }
                        </div>
                    }

                    <!-- ======================================================== -->
                    <!-- PAGE 2: OVERVIEW & SAVE                                  -->
                    <!-- ======================================================== -->
                    @if (currentStep == 2)
                    {
                        <div class="space-y-4">
                            <div>
                                <span class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">Step 2 of 2</span>
                                <h3 class="text-sm font-bold text-slate-800 mt-0.5">Review &amp; Confirm Registration</h3>
                                <p class="text-xs text-slate-500 mt-0.5">
                                    The unique identifier has been automatically assigned by the system and is strictly read-only.
                                </p>
                            </div>

                            <!-- Overview Summary Card -->
                            <div class="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 bg-white shadow-xs">
                                
                                <!-- Read-Only ID Overview -->
                                <div class="p-4 bg-slate-50/70 flex items-center justify-between">
                                    <div>
                                        <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                            Equipment Type ID (System-Assigned)
                                        </span>
                                        <div class="flex items-center gap-2 mt-1.5">
                                            <span class="font-mono text-base font-extrabold text-slate-900 bg-white px-3 py-1 rounded-md border border-slate-200 shadow-2xs tracking-wide">
                                                @formModel.EquipmentTypeId
                                            </span>
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                                </svg>
                                                Strictly Read-Only
                                            </span>
                                        </div>
                                    </div>
                                    <span class="text-xs text-slate-400 font-mono">dbo.EquipmentType</span>
                                </div>

                                <!-- Read-Only Name Overview -->
                                <div class="p-4 flex items-center justify-between">
                                    <div>
                                        <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                            Category Display Name
                                        </span>
                                        <p class="text-sm font-bold text-slate-800 mt-1">
                                            @formModel.EquipmentTypeName
                                        </p>
                                    </div>
                                    <button type="button" 
                                            @onclick="HandlePrevStep"
                                            class="text-xs font-semibold text-slate-600 hover:text-slate-900 underline hover:no-underline">
                                        Edit Name
                                    </button>
                                </div>

                                <!-- Color Tag Indicator -->
                                <div class="p-4 flex items-center justify-between">
                                    <span class="text-xs text-slate-500 font-medium">Assigned UI Tag</span>
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                        @formModel.ColorTag
                                    </span>
                                </div>
                            </div>

                            <!-- Database Foreign Key Notice -->
                            <div class="p-3 bg-amber-50/80 border border-amber-200/80 rounded-lg flex items-start gap-2.5">
                                <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <p class="text-[11px] text-amber-900 leading-relaxed">
                                    Upon saving, this category immediately becomes selectable across the Equipment inventory catalog and binds foreign key constraints.
                                </p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-xs font-medium">
                                    @errorMessage
                                </div>
                            }
                        </div>
                    }
                </EditForm>
            </div>

            <!-- Modal Footer Navigation -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                <div>
                    @if (currentStep == 1)
                    {
                        <button type="button"
                                @onclick="CloseModalAsync"
                                disabled="@(isSubmitting || isGeneratingId)"
                                class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="HandlePrevStep"
                                disabled="@(isSubmitting || isGeneratingId)"
                                class="inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg shadow-xs transition-colors disabled:opacity-50">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                            Back
                        </button>
                    }
                </div>

                <div class="flex items-center gap-2">
                    @if (currentStep == 1)
                    {
                        <button type="button"
                                @onclick="HandleNextStepAsync"
                                disabled="@isGeneratingId"
                                class="inline-flex items-center gap-2 px-5 py-2 bg-slate-900 hover:bg-black text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-sm transition-all focus:ring-2 focus:ring-slate-900 focus:ring-offset-1 disabled:opacity-60 active:scale-95">
                            @if (isGeneratingId)
                            {
                                <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                                <span>Allocating ID...</span>
                            }
                            else
                            {
                                <span>Next</span>
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            }
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="HandleSaveAsync"
                                disabled="@isSubmitting"
                                class="inline-flex items-center gap-2 px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold uppercase tracking-wider rounded-lg shadow-sm transition-all focus:ring-2 focus:ring-emerald-600 focus:ring-offset-1 disabled:opacity-60 active:scale-95">
                            @if (isSubmitting)
                            {
                                <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>@(IsEditMode ? "Save Changes" : "Save Equipment Type")</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<string> OnEquipmentTypeSaved { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public EquipmentTypeModel? EditType { get; set; }

    private int currentStep = 1;
    private bool isGeneratingId = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    private EquipmentTypeWizardFormModel formModel = new();
    private EditContext editContext = default!;

    private bool wasOpen = false;

    protected override void OnInitialized()
    {
        ResetWizard();
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen)
        {
            wasOpen = true;
            ResetWizard();
            if (IsEditMode && EditType != null)
            {
                formModel.EquipmentTypeId = EditType.EquipmentTypeID;
                formModel.EquipmentTypeName = EditType.EquipmentTypeName;
                formModel.ColorTag = EditType.ColorTag ?? "Blue";
                editContext = new EditContext(formModel);
            }
        }
        else if (!IsOpen)
        {
            wasOpen = false;
        }
    }

    private void ResetWizard()
    {
        currentStep = 1;
        formModel = new EquipmentTypeWizardFormModel();
        editContext = new EditContext(formModel);
        errorMessage = null;
        isGeneratingId = false;
        isSubmitting = false;
    }

    private async Task CloseModalAsync()
    {
        ResetWizard();
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleNextStepAsync()
    {
        errorMessage = null;

        var nameField = editContext.Field(nameof(formModel.EquipmentTypeName));
        editContext.NotifyFieldChanged(nameField);

        if (!editContext.Validate())
        {
            return;
        }

        if (IsEditMode && !string.IsNullOrWhiteSpace(formModel.EquipmentTypeId))
        {
            currentStep = 2;
            return;
        }

        // Generate or retrieve sequential custom ID
        if (string.IsNullOrWhiteSpace(formModel.EquipmentTypeId))
        {
            isGeneratingId = true;
            try
            {
                var nextId = await EquipmentService.GetNextEquipmentTypeIdAsync();
                if (!string.IsNullOrWhiteSpace(nextId))
                {
                    formModel.EquipmentTypeId = nextId;
                    currentStep = 2;
                }
                else
                {
                    errorMessage = "Server returned an empty identifier. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Unable to allocate custom ID: {ex.Message}";
            }
            finally
            {
                isGeneratingId = false;
            }
        }
        else
        {
            currentStep = 2;
        }
    }

    private void HandlePrevStep()
    {
        errorMessage = null;
        currentStep = 1;
    }

    private async Task HandleSaveAsync()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            if (IsEditMode)
            {
                var (success, error) = await EquipmentService.UpdateEquipmentTypeAsync(
                    formModel.EquipmentTypeId,
                    formModel.EquipmentTypeName,
                    formModel.ColorTag);

                if (success)
                {
                    var savedName = formModel.EquipmentTypeName;
                    await CloseModalAsync();
                    await OnEquipmentTypeSaved.InvokeAsync(savedName);
                }
                else
                {
                    errorMessage = error ?? "Failed to update equipment type.";
                }
            }
            else
            {
                var (success, error) = await EquipmentService.AddEquipmentTypeAsync(
                    formModel.EquipmentTypeId,
                    formModel.EquipmentTypeName,
                    formModel.ColorTag);

                if (success)
                {
                    var createdName = formModel.EquipmentTypeName;
                    await CloseModalAsync();
                    await OnEquipmentTypeSaved.InvokeAsync(createdName);
                }
                else
                {
                    errorMessage = error ?? "Failed to save equipment type.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class EquipmentTypeWizardFormModel
    {
        [Required(ErrorMessage = "Equipment Type Name is required.")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Category name must be between 2 and 100 characters.")]
        public string EquipmentTypeName { get; set; } = string.Empty;

        public string EquipmentTypeId { get; set; } = string.Empty;

        public string ColorTag { get; set; } = "Blue";
    }
}
