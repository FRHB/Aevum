@* ============================================================
   AdminUserList.razor  –  Task 2.3: UI Enforcement Guidance
   
   This component demonstrates how to integrate the Admin entity
   model into a data table and enforce SADM-### delete protection
   at the UI layer.

   Drop this inside any admin page with:
       <AdminUserList RequestingUserId="@_currentAdminId" />
   ============================================================ *@

@using PhotoAevumStudio.Web.Models
@inject IUserService UserService

<section class="aev-card" aria-label="Admin user list">
    <header class="aev-card__header">
        <h2 class="aev-card__heading">Admin Accounts</h2>
    </header>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert" role="alert">@_errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="aev-alert-banner" role="status">@_successMessage</div>
    }

    <div class="aev-table-wrap">
        <table class="aev-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in _admins)
                {
                    <tr>
                        <td>
                            @admin.Id
                            @if (admin.IsSuperAdmin)
                            {
                                @* Visual badge – reinforces the UI lock *@
                                <span class="aev-badge aev-badge--violet" title="Root Super Admin – cannot be deleted">Root</span>
                            }
                        </td>
                        <td>@admin.Name</td>
                        <td>@admin.Email</td>
                        <td>@admin.Role</td>
                        <td>
                            @* ── Task 2.3 core snippet ────────────────────────────────────
                               The Delete button is disabled/hidden when:
                               1. The row targets an SADM-### account (admin.IsSuperAdmin).
                               2. OR the requesting user is NOT an SADM (insufficient privilege).
                               Both conditions match the service-layer business rules in UserService.
                               ──────────────────────────────────────────────────────────────── *@

                            @if (admin.IsSuperAdmin)
                            {
                                @* Completely hide the button for the Super Admin row *@
                                <span class="aev-muted-text" title="Super Admin cannot be deleted">Protected</span>
                            }
                            else
                            {
                                @* Show the button, but disable it if requesting user lacks SADM privilege *@
                                <button class="btn btn--ghost btn--sm"
                                        disabled="@(!RequestingUserId.StartsWith("SADM-", StringComparison.OrdinalIgnoreCase))"
                                        @onclick="() => TryDeleteAdmin(admin.Id)"
                                        title="@(RequestingUserId.StartsWith("SADM-") ? "Delete admin" : "Only SADM can delete admins")">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    /// <summary>
    /// The ID of the currently logged-in user making the request.
    /// Bind this from your AevumAuthenticationStateProvider claim when ready.
    /// Example: state.User.FindFirst("sub")?.Value ?? string.Empty
    /// </summary>
    [Parameter] public string RequestingUserId { get; set; } = string.Empty;

    private IReadOnlyList<Admin> _admins = Array.Empty<Admin>();
    private string _errorMessage   = string.Empty;
    private string _successMessage = string.Empty;

    protected override void OnInitialized()
    {
        _admins = UserService.GetAdmins();
    }

    private void TryDeleteAdmin(string targetId)
    {
        _errorMessage   = string.Empty;
        _successMessage = string.Empty;

        try
        {
            UserService.DeleteAdmin(targetId, RequestingUserId);
            _admins = UserService.GetAdmins(); // Refresh list
            _successMessage = $"Admin '{targetId}' has been removed.";
        }
        catch (InvalidOperationException ex)
        {
            // Surface the service-layer rule message directly
            _errorMessage = ex.Message;
        }
        catch (KeyNotFoundException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
