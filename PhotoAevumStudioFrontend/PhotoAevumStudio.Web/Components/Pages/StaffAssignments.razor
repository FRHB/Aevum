@page "/staff/assignments"
@layout EmployeeLayout
@using PhotoAevumStudio.Web.Services
@inject IUserService UserService
@attribute [Authorize(Roles = "Employee")]

<PageTitle>My Assignments</PageTitle>

<div class="max-w-4xl mx-auto py-10 px-6">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">My Assignments</h1>
        <a href="/staff" class="text-teal-600 hover:underline">Back to Dashboard</a>
    </div>

    @if (!Assignments.Any())
    {
        <div class="bg-white border border-gray-200 rounded-xl p-12 text-center shadow-sm">
            <h2 class="text-lg font-semibold text-gray-800 mb-1">No Active Assignments</h2>
            <p class="text-sm text-gray-500">There are currently no studio assignments scheduled in the database.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var item in Assignments)
            {
                <div class="bg-white border rounded-xl p-6 shadow-sm">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h2 class="text-xl font-bold">#@item.BookingId - @item.ServiceTitle</h2>
                            <p class="text-gray-500">Client: @item.ClientName</p>
                        </div>
                        <div class="flex flex-col items-end gap-1">
                            <span class="bg-yellow-100 text-yellow-800 text-xs font-bold px-3 py-1 rounded-full">@item.Status</span>
                            <span class="@(item.EmployeeRemittanceStatus == "Cleared" ? "bg-emerald-100 text-emerald-800 border-emerald-200" : "bg-amber-100 text-amber-900 border-amber-300") border text-[11px] font-bold px-2.5 py-0.5 rounded-full">
                                Cash Remittance: @(item.EmployeeRemittanceStatus == "Cleared" ? "Cleared" : "Pending Admin Clearance")
                            </span>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 mb-4">
                        <div><strong>Call Time:</strong> @item.EventDateTime.AddMinutes(-30).ToString("MMM dd, hh:mm tt")</div>
                        <div><strong>Shoot Start:</strong> @item.EventDateTime.ToString("MMM dd, hh:mm tt")</div>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-lg p-3 text-xs flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <span class="text-slate-500">Total Price:</span> <strong>₱@item.TotalAmount.ToString("N2")</strong>
                            <span class="text-slate-300 mx-2">•</span>
                            <span class="text-slate-500">15% Deposit:</span> <strong class="text-teal-700">₱@item.DepositAmount.ToString("N2")</strong>
                            <span class="text-slate-300 mx-2">•</span>
                            <span class="text-slate-500">85% Balance:</span> <strong>₱@item.RemainingBalance.ToString("N2")</strong>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-slate-500">Customer Status:</span>
                            <span class="bg-green-100 text-green-800 px-2 py-0.5 rounded font-bold">Cleared</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<BookingRow> Assignments = new();

    protected override void OnInitialized()
    {
        Assignments = UserService.GetBookings();
    }
}
