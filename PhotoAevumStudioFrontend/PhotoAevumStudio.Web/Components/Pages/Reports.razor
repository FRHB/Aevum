@page "/admin/reports"
@page "/reports"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SystemAdmin,System Admin,Super Admin,Office Clerk")]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using PhotoAevumStudio.Web.Services
@inject ISalesReportsClient Client
@inject IJSRuntime JS
@inject BiConfig Bi

<PageTitle>Executive Monthly Summary | Photo Aevum Studio</PageTitle>

<style>
    @@media print {
        aside, nav, header, .aev-no-print { display: none !important; }
        body { background-color: white !important; }
        .aev-print-document {
            max-width: 100% !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }
    }
</style>

<div class="space-y-6">
    @* ── Top Toolbar (Hidden on Print) ──────────────────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-3 border-b border-slate-200 aev-no-print">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                <span>Sales &amp; Report</span>
                <span>/</span>
                <span class="text-teal-700 font-bold">Reports</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--text)] tracking-tight">Executive Reporting Hub</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Executive summary and operational breakdown for @(_report?.PeriodLabel ?? "the selected period").
            </p>
        </div>

        <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-600">Report for:</span>
            <input type="month" value="@_period" @onchange="OnPeriodChanged" aria-label="Report period" class="text-xs px-3 py-2 border border-slate-300 rounded-lg bg-white text-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-500 shadow-2xs" />
            <button type="button" @onclick="GenerateSummaryReport" disabled="@(_report is null)" class="inline-flex items-center gap-1.5 px-4 py-2 bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-xs font-bold rounded-lg shadow-2xs transition-colors focus:ring-2 focus:ring-teal-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>Print / PDF</span>
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="max-w-4xl mx-auto bg-white rounded-xl border border-slate-200 p-16 text-center text-xs text-slate-500 shadow-2xs">
            <div class="inline-block w-8 h-8 border-2 border-teal-600 border-t-transparent rounded-full animate-spin mb-3"></div>
            <p>Aggregating executive report metrics from studio records…</p>
        </div>
    }
    else if (_report is null)
    {
        <div class="max-w-4xl mx-auto bg-white rounded-xl border border-rose-200 p-8 text-center text-xs text-rose-700 shadow-2xs">
            @(_error ?? "Unable to load the executive report.")
            <button type="button" @onclick="LoadAsync" class="ml-2 underline font-semibold">Retry</button>
        </div>
    }
    else
    {
        var r = _report;
        @* ── Clean Printable Document-Style "Paper" Card (max-w-4xl, centered) ── *@
        <div class="aev-print-document max-w-4xl mx-auto bg-white rounded-xl border border-slate-200 shadow-2xs p-6 sm:p-10 space-y-8">
            
            @* ── 1. Header Band "Executive Monthly Summary" ──────────────────── *@
            <div class="rounded-xl p-6 sm:p-7 text-white flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 shadow-sm" style="background-color: var(--text);">
                <div>
                    <div class="text-[11px] font-bold uppercase tracking-wider text-teal-300 mb-1">
                        Photo Aevum Studio · Executive Briefing
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Executive Monthly Summary</h2>
                    <p class="text-xs text-slate-300 mt-1">
                        Report Period: <strong class="text-white">@r.PeriodLabel</strong> · Operational &amp; Financial Performance
                    </p>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                    <div class="text-right">
                        <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Gross Booking Value</div>
                        <div class="text-2xl font-extrabold text-white aev-tabular">₱@r.GrossBookingValue.ToString("N0")</div>
                        <div class="text-[11px] text-teal-300 font-medium">@r.ScheduledSessions scheduled @(Bi.EntityLabels.Appointment.ToLower())(s)</div>
                    </div>
                </div>
            </div>

            @* ── 2. Key Highlights: Bullets Generated from Real Data ─────────── *@
            <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-teal-700">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <span>Key Operational Highlights</span>
                </div>

                @{
                    var highlights = GetRealHighlights(r);
                }

                @if (highlights.Count == 0)
                {
                    <p class="text-xs text-slate-400 italic">Not enough data this period.</p>
                }
                else
                {
                    <ul class="space-y-2 text-xs text-slate-700">
                        @foreach (var hl in highlights)
                        {
                            <li class="flex items-start gap-2.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-teal-700 mt-1.5 shrink-0"></span>
                                <span>@hl</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            @* ── 3. Key Performance Indicators ───────────────────────────────── *@
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-2xs">
                    <div class="text-[11px] font-medium uppercase tracking-wider text-slate-500">@Bi.Kpis.GetLabel("reports", "report-gross-value", "Gross Value")</div>
                    <div class="text-xl font-extrabold text-[var(--text)] mt-1 aev-tabular">₱@r.GrossBookingValue.ToString("N0")</div>
                    <div class="text-[11px] text-slate-500 mt-1">
                        @if (r.GrossDeltaPercent is double g)
                        {
                            <span class="@(g >= 0 ? "text-emerald-600 font-semibold" : "text-rose-600 font-semibold")">
                                @(g >= 0 ? "↑" : "↓") @Math.Abs(g).ToString("0.0")%
                            </span>
                            <span> vs prior</span>
                        }
                        else
                        {
                            <span>@r.ScheduledSessions @(Bi.EntityLabels.Appointment.ToLower())(s)</span>
                        }
                    </div>
                </div>

                <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-2xs">
                    <div class="text-[11px] font-medium uppercase tracking-wider text-slate-500">@Bi.Kpis.GetLabel("reports", "report-capacity", "Studio Capacity")</div>
                    <div class="text-xl font-extrabold text-[var(--text)] mt-1 aev-tabular">@r.CapacityUtilizationPercent.ToString("0.0")%</div>
                    <div class="text-[11px] text-slate-500 mt-1">
                        <span class="font-semibold text-teal-700">@r.CapacityBadge</span>
                    </div>
                </div>

                <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-2xs">
                    <div class="text-[11px] font-medium uppercase tracking-wider text-slate-500">@Bi.Kpis.GetLabel("reports", "report-efficiency", "Staff Efficiency")</div>
                    <div class="text-xl font-extrabold text-[var(--text)] mt-1 aev-tabular">@r.TotalLoggedHours.ToString("0.0") hrs</div>
                    <div class="text-[11px] text-slate-500 mt-1">
                        <span>@r.ActiveStaffLogged active @(Bi.EntityLabels.Crew.ToLower())</span>
                    </div>
                </div>

                <div class="p-4 rounded-xl border border-slate-200 bg-white shadow-2xs">
                    <div class="text-[11px] font-medium uppercase tracking-wider text-slate-500">@Bi.Kpis.GetLabel("reports", "report-retention", "Client Retention")</div>
                    <div class="text-xl font-extrabold text-[var(--text)] mt-1 aev-tabular">@(r.RetentionPercent is double p ? $"{p:0.0}%" : "—")</div>
                    <div class="text-[11px] text-slate-500 mt-1">
                        <span>@r.RepeatClients repeat @(Bi.EntityLabels.Client.ToLower())(s)</span>
                    </div>
                </div>
            </div>

            @* ── 4. Financial & Revenue Breakdown (Table + Trend) ───────────── *@
            <div class="space-y-4 pt-4 border-t border-slate-200">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-base font-bold text-[var(--text)]">Financial &amp; Revenue Breakdown</h3>
                        <p class="text-xs text-slate-500">Revenue per @Bi.EntityLabels.Service.ToLower() category, deposit collection rate, and cleared remittances</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                    @* Left: Small Category Table *@
                    <div class="md:col-span-7 overflow-x-auto border border-slate-200 rounded-xl">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                                    <th class="py-2.5 px-3.5">Category</th>
                                    <th class="py-2.5 px-3.5 text-center">Sessions</th>
                                    <th class="py-2.5 px-3.5 text-right">Revenue</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @if (r.RevenueByCategory.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="py-8 text-center text-slate-400 italic">No category revenue recorded.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var c in r.RevenueByCategory)
                                    {
                                        <tr class="hover:bg-slate-50">
                                            <td class="py-2.5 px-3.5 font-semibold text-slate-700">@c.Label</td>
                                            <td class="py-2.5 px-3.5 text-center text-slate-600">@c.Count</td>
                                            <td class="py-2.5 px-3.5 text-right font-bold text-slate-700">₱@c.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="bg-slate-50 border-t border-slate-200 font-semibold text-slate-700">
                                <tr>
                                    <td class="py-2.5 px-3.5">Total Revenue</td>
                                    <td class="py-2.5 px-3.5 text-center">@r.RevenueByCategory.Sum(c => c.Count)</td>
                                    <td class="py-2.5 px-3.5 text-right font-extrabold text-teal-700">₱@r.RevenueByCategory.Sum(c => c.Amount).ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @* Right: Reconciliation & Line Chart *@
                    <div class="md:col-span-5 p-4 rounded-xl border border-slate-200 bg-slate-50 space-y-3">
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Remittance Status</div>
                        <div class="space-y-2 text-xs">
                            <div class="flex justify-between text-slate-600">
                                <span>Deposit collection:</span>
                                <span class="font-bold text-slate-700">@(r.DepositCollectionPercent is double d ? $"{d:0.0}%" : "—")</span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>Cleared payments:</span>
                                <span class="font-bold text-emerald-700">@r.ClearedPayments</span>
                            </div>
                            <div class="flex justify-between text-slate-600">
                                <span>Awaiting reconciliation:</span>
                                <span class="font-bold @(r.UnreconciledPayments > 0 ? "text-amber-700" : "text-slate-700")">@r.UnreconciledPayments</span>
                            </div>
                        </div>

                        @if (r.RevenueByCategory.Count > 1)
                        {
                            var catMax = Math.Max(1m, r.RevenueByCategory.Max(c => c.Amount));
                            var catCount = r.RevenueByCategory.Count;
                            int svgW = 260;
                            int svgH = 80;
                            double step = catCount > 1 ? (svgW - 24.0) / (catCount - 1) : svgW / 2.0;

                            var points = string.Join(" ", r.RevenueByCategory.Select((c, idx) =>
                            {
                                var x = 12 + idx * step;
                                var y = svgH - 12 - (double)(c.Amount / catMax) * (svgH - 24);
                                return $"{x.ToString("0.0", CultureInfo.InvariantCulture)},{y.ToString("0.0", CultureInfo.InvariantCulture)}";
                            }));

                            <div class="pt-2 border-t border-slate-200">
                                <div class="text-[11px] font-semibold text-slate-500 mb-1">Category Curve</div>
                                <svg viewBox="0 0 @svgW @svgH" class="w-full h-16 select-none" role="img" aria-label="Category revenue curve">
                                    <polyline points="@points" fill="none" stroke="var(--chart-1)" stroke-width="2.5" />
                                    @for (int idx = 0; idx < catCount; idx++)
                                    {
                                        var x = 12 + idx * step;
                                        var y = svgH - 12 - (double)(r.RevenueByCategory[idx].Amount / catMax) * (svgH - 24);
                                        <circle cx="@x.ToString("0.0", CultureInfo.InvariantCulture)" cy="@y.ToString("0.0", CultureInfo.InvariantCulture)" r="3" fill="var(--chart-1)" />
                                    }
                                </svg>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ── 5. Appointments & Booking Trends (Heatmap + Trend Line) ─────── *@
            <div class="space-y-4 pt-4 border-t border-slate-200">
                <div>
                    <h3 class="text-base font-bold text-[var(--text)]">@Bi.EntityLabels.Appointment &amp; Booking Trends</h3>
                    <p class="text-xs text-slate-500">Day-of-week cadence and booking concentration matrix</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                    @* Left: Weekday x Time-Slot Heatmap *@
                    <div class="md:col-span-7 border border-slate-200 rounded-xl p-4 bg-white shadow-2xs space-y-3">
                        <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
                            <span>@Bi.EntityLabels.Appointment Concentration Heatmap</span>
                            <div class="flex items-center gap-1.5 text-[10px] text-slate-400">
                                <span>Low</span>
                                <span class="w-2.5 h-2.5 rounded-xs bg-slate-100 border border-slate-200"></span>
                                <span class="w-2.5 h-2.5 rounded-xs bg-teal-100"></span>
                                <span class="w-2.5 h-2.5 rounded-xs bg-teal-300"></span>
                                <span class="w-2.5 h-2.5 rounded-xs bg-teal-600"></span>
                                <span>High</span>
                            </div>
                        </div>

                        @{
                            var dayNames = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
                            var slotNames = new[] { "Morning (8a–12p)", "Afternoon (12p–4p)", "Evening (4p–8p)" };
                            var cells = r.WeekdayTimeSlots ?? [];
                        }

                        <div class="overflow-x-auto">
                            <table class="w-full text-center border-collapse text-xs">
                                <thead>
                                    <tr class="text-[10px] uppercase font-bold text-slate-400 border-b border-slate-100">
                                        <th class="py-2 text-left w-24">Slot</th>
                                        @foreach (var dn in dayNames)
                                        {
                                            <th class="py-2 px-1">@dn</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 text-[11px]">
                                    @for (int slot = 0; slot < 3; slot++)
                                    {
                                        <tr>
                                            <td class="py-2.5 text-left text-slate-500 font-medium whitespace-nowrap">@slotNames[slot]</td>
                                            @for (int day = 0; day < 7; day++)
                                            {
                                                var cellCount = cells.FirstOrDefault(c => c.Weekday == day && c.Slot == slot)?.Count
                                                                ?? (r.BookingsByWeekday.Count > day && r.BookingsByWeekday[day].Count > 0 ? (slot == 1 ? r.BookingsByWeekday[day].Count : 0) : 0);
                                                var heatClass = cellCount == 0 ? "bg-slate-50 text-slate-300" :
                                                                cellCount <= 2 ? "bg-teal-100 text-teal-800 font-semibold" :
                                                                cellCount <= 5 ? "bg-teal-300 text-teal-900 font-bold" :
                                                                "bg-teal-600 text-white font-extrabold";

                                                <td class="p-1">
                                                    <div class="w-full py-1.5 rounded @heatClass transition-colors" title="@dayNames[day] @slotNames[slot]: @cellCount booking(s)">
                                                        @cellCount
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* Right: Weekday Volume Trend Line *@
                    <div class="md:col-span-5 border border-slate-200 rounded-xl p-4 bg-white shadow-2xs space-y-3">
                        <div class="text-xs font-semibold text-slate-600">Day-of-Week Trend Line</div>

                        @{
                            // ── Layout constants ──────────────────────────────────────
                            // Extra top padding so the peak value label never gets clipped.
                            // Extra bottom padding accommodates X-axis labels + Y baseline.
                            // Left padding gives room for the Y-axis tick numbers.
                            int twW    = 300;
                            int twH    = 170;
                            int twPadL = 32;   // room for Y-axis labels
                            int twPadR = 12;
                            int twPadT = 24;   // room for value labels above peak node
                            int twPadB = 32;   // room for X-axis day labels
                            double twPlotW = twW - twPadL - twPadR;
                            double twPlotH = twH - twPadT - twPadB;
                            double twStep  = twPlotW / 6.0;   // 7 days → 6 intervals

                            // ── Data ─────────────────────────────────────────────────
                            // Sum each weekday across all three time-slots (matches heatmap totals).
                            var wdTotals = new int[7];
                            if (r.WeekdayTimeSlots is { Count: > 0 })
                            {
                                foreach (var cell in r.WeekdayTimeSlots)
                                    if (cell.Weekday >= 0 && cell.Weekday < 7)
                                        wdTotals[cell.Weekday] += cell.Count;
                            }
                            else
                            {
                                for (int di = 0; di < 7 && di < r.BookingsByWeekday.Count; di++)
                                    wdTotals[di] = r.BookingsByWeekday[di].Count;
                            }

                            int rawMax = wdTotals.Length > 0 ? wdTotals.Max() : 0;
                            int twMax  = Math.Max(1, rawMax);   // avoid divide-by-zero

                            // ── Y-axis ticks (whole integers only) ───────────────────
                            // Choose a step that gives 3–5 clean ticks.
                            int yTickStep = twMax <= 4 ? 1 : twMax <= 10 ? 2 : twMax <= 20 ? 5 : 10;
                            int yTickCount = twMax / yTickStep;
                            var yTicks = Enumerable.Range(0, yTickCount + 1)
                                                   .Select(t => t * yTickStep)
                                                   .ToList();

                            // Helper: map a booking count value → SVG Y coordinate
                            double YCoord(int count) =>
                                twPadT + twPlotH - (rawMax == 0 ? 0 : (double)count / twMax * twPlotH);

                            // ── Polyline + area fill polygon points ──────────────────
                            var nodeCoords = Enumerable.Range(0, 7).Select(i =>
                            {
                                double nx = twPadL + i * twStep;
                                double ny = YCoord(wdTotals[i]);
                                return (X: nx, Y: ny);
                            }).ToList();

                            var polylinePoints = string.Join(" ", nodeCoords.Select(p =>
                                $"{p.X.ToString("0.00", CultureInfo.InvariantCulture)},{p.Y.ToString("0.00", CultureInfo.InvariantCulture)}"));

                            // Area polygon: line nodes + bottom-right corner + bottom-left corner
                            double baselineY = twPadT + twPlotH;
                            var areaPoints = polylinePoints
                                + $" {nodeCoords[6].X.ToString("0.00", CultureInfo.InvariantCulture)},{baselineY.ToString("0.00", CultureInfo.InvariantCulture)}"
                                + $" {nodeCoords[0].X.ToString("0.00", CultureInfo.InvariantCulture)},{baselineY.ToString("0.00", CultureInfo.InvariantCulture)}";

                            var shortDays = new[] { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" };
                            var fullDays  = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
                        }

                        <div class="overflow-x-auto">
                            <svg viewBox="0 0 @twW @twH" class="w-full select-none" style="height:@(twH)px; display:block;" role="img" aria-label="Day-of-week booking volume trend">
                                <defs>
                                    <linearGradient id="twAreaGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%"   stop-color="var(--chart-2)" stop-opacity="0.18" />
                                        <stop offset="100%" stop-color="var(--chart-2)" stop-opacity="0.02" />
                                    </linearGradient>
                                </defs>

                                @* ── Horizontal gridlines + Y-axis labels ── *@
                                @foreach (var tick in yTicks)
                                {
                                    var gy = YCoord(tick);
                                    var gxLabel = (twPadL - 4).ToString(CultureInfo.InvariantCulture);
                                    var gyStr   = gy.ToString("0.00", CultureInfo.InvariantCulture);
                                    var gyLbl   = (gy + 3.5).ToString("0.00", CultureInfo.InvariantCulture);
                                    var gxRight = (twW - twPadR).ToString(CultureInfo.InvariantCulture);
                                    var gxLeft  = twPadL.ToString(CultureInfo.InvariantCulture);
                                    <line x1="@gxLeft" y1="@gyStr" x2="@gxRight" y2="@gyStr"
                                          stroke="#E2E8F0" stroke-width="1" stroke-dasharray="3 3" />
                                    @:    <text x="@gxLabel" y="@gyLbl" text-anchor="end" fill="#94A3B8" font-size="8" font-family="ui-monospace,monospace">@tick</text>
                                }

                                @* ── Baseline (X-axis) ── *@
                                <line x1="@twPadL.ToString(CultureInfo.InvariantCulture)"
                                      y1="@baselineY.ToString("0.00", CultureInfo.InvariantCulture)"
                                      x2="@((twW - twPadR).ToString(CultureInfo.InvariantCulture))"
                                      y2="@baselineY.ToString("0.00", CultureInfo.InvariantCulture)"
                                      stroke="#CBD5E1" stroke-width="1" />

                                @* ── Gradient area fill ── *@
                                <polygon points="@areaPoints" fill="url(#twAreaGrad)" />

                                @* ── Trend polyline ── *@
                                <polyline points="@polylinePoints"
                                          fill="none"
                                          stroke="var(--chart-2)"
                                          stroke-width="2.5"
                                          stroke-linejoin="round"
                                          stroke-linecap="round" />

                                @* ── Nodes, value labels, X-axis day labels ── *@
                                @for (int i = 0; i < 7; i++)
                                {
                                    var nx    = nodeCoords[i].X;
                                    var ny    = nodeCoords[i].Y;
                                    var cnt   = wdTotals[i];
                                    var nxStr = nx.ToString("0.00", CultureInfo.InvariantCulture);
                                    var nyStr = ny.ToString("0.00", CultureInfo.InvariantCulture);
                                    var nyLbl = (ny - 7).ToString("0.00", CultureInfo.InvariantCulture);
                                    var nyDay = (twH - 6).ToString(CultureInfo.InvariantCulture);
                                    <circle cx="@nxStr" cy="@nyStr" r="3.5"
                                            fill="var(--chart-2)" stroke="white" stroke-width="1.5">
                                        <title>@fullDays[i]: @cnt booking(s)</title>
                                    </circle>
                                    @:    <text x="@nxStr" y="@nyLbl" text-anchor="middle" fill="#475569" font-size="8" font-weight="600" font-family="ui-monospace,monospace">@cnt</text>
                                    @:    <text x="@nxStr" y="@nyDay" text-anchor="middle" fill="#94A3B8" font-size="8" font-weight="600" letter-spacing="0.3" font-family="ui-sans-serif,system-ui,sans-serif">@shortDays[i]</text>
                                }
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            @* ── 6. Equipment Usage & Maintenance Status ─────────────────────── *@
            <div class="space-y-4 pt-4 border-t border-slate-200">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-base font-bold text-[var(--text)]">Equipment Usage &amp; Maintenance Status</h3>
                        <p class="text-xs text-slate-500">Utilization per asset, dispatch counts, and maintenance alerts</p>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
                        <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium">@r.TotalDispatches total dispatches</span>
                        @if (r.OpenMaintenanceTickets > 0 || r.EquipmentOnHold > 0)
                        {
                            <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-bold border border-amber-200">
                                ⚠ @(r.OpenMaintenanceTickets + r.EquipmentOnHold) alerts
                            </span>
                        }
                    </div>
                </div>

                <div class="overflow-x-auto border border-slate-200 rounded-xl">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                                <th class="py-2.5 px-3.5">Asset Name</th>
                                <th class="py-2.5 px-3.5">Type</th>
                                <th class="py-2.5 px-3.5 text-center">Dispatches</th>
                                <th class="py-2.5 px-3.5 text-center">Days Used</th>
                                <th class="py-2.5 px-3.5 text-right">Utilization</th>
                                <th class="py-2.5 px-3.5 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (r.EquipmentUsage.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="py-8 text-center text-slate-400 italic">No equipment inventory registered.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var eq in r.EquipmentUsage)
                                {
                                    <tr class="hover:bg-slate-50">
                                        <td class="py-2.5 px-3.5 font-semibold text-slate-700">@eq.EquipmentName</td>
                                        <td class="py-2.5 px-3.5 text-slate-500">@eq.TypeName</td>
                                        <td class="py-2.5 px-3.5 text-center font-mono text-slate-700">@eq.DispatchCount</td>
                                        <td class="py-2.5 px-3.5 text-center font-mono text-slate-700">@eq.DaysUsed</td>
                                        <td class="py-2.5 px-3.5 text-right font-mono font-bold text-slate-700">@eq.UtilizationPercent.ToString("0.0")%</td>
                                        <td class="py-2.5 px-3.5 text-center">
                                            @if (eq.Status is "Maintenance" or "Needs Replacement")
                                            {
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                    <span>⚠</span>
                                                    <span>@eq.Status</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                    @eq.Status
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* ── 7. Document Footer ──────────────────────────────────────────── *@
            <div class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between text-xs text-slate-400 gap-2">
                <div>Generated by Aevum System · @DateTime.UtcNow.ToString("MMM dd, yyyy HH:mm") UTC</div>
                <div>Confidential · Photo Aevum Studio Internal Management Report</div>
            </div>
        </div>
    }
</div>

@code {
    private string _period = DateTime.Today.ToString("yyyy-MM");
    private ReportSummaryModel? _report;
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var parts = _period.Split('-');
        var res = await Client.GetReportAsync(int.Parse(parts[0]), int.Parse(parts[1]));
        _report = res.IsSuccess ? res.Value : null;
        _error = res.Error?.Message;
        _loading = false;
    }

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(v) || v.Length != 7) return;
        _period = v;
        await LoadAsync();
    }

    private async Task GenerateSummaryReport()
    {
        await JS.InvokeVoidAsync("print");
    }

    private List<string> GetRealHighlights(ReportSummaryModel r)
    {
        var list = new List<string>();

        // 1. Revenue
        if (r.GrossDeltaPercent is double g)
        {
            list.Add($"Gross booking value reached ₱{r.GrossBookingValue:N2} ({(g >= 0 ? "+" : "")}{g:0.0}% vs prior month).");
        }
        else if (r.GrossBookingValue > 0)
        {
            list.Add($"Gross booking value recorded at ₱{r.GrossBookingValue:N2} across {r.ScheduledSessions} {Bi.EntityLabels.Appointment.ToLower()}(s).");
        }

        // 2. Busiest Day
        if (r.BookingsByWeekday.Any(w => w.Count > 0))
        {
            var busiest = r.BookingsByWeekday.OrderByDescending(w => w.Count).First();
            list.Add($"Highest booking volume on {busiest.Label}s with {busiest.Count} {Bi.EntityLabels.Appointment.ToLower()}(s) scheduled.");
        }

        // 3. Top Service
        if (r.PopularServices.Any(s => s.Count > 0))
        {
            var top = r.PopularServices.OrderByDescending(s => s.Count).First();
            list.Add($"Top requested {Bi.EntityLabels.Service.ToLower()} is {top.Label} with {top.Count} session(s) (₱{top.Amount:N2} revenue).");
        }

        // 4. Conversion / Sessions
        if (r.ConsultationConversionPercent.HasValue)
        {
            list.Add($"Consultation conversion rate closed at {r.ConsultationConversionPercent.Value:0.0}% ({r.ConsultationsWon} deals won from {r.ConsultationsTotal} consultations).");
        }
        else if (r.CompletedSessions > 0)
        {
            list.Add($"{r.CompletedSessions} of {r.ScheduledSessions} scheduled {Bi.EntityLabels.Appointment.ToLower()}s fully completed.");
        }

        // 5. Capacity & Peak Hours
        if (!string.IsNullOrWhiteSpace(r.PeakHours))
        {
            list.Add($"Studio capacity utilization is {r.CapacityUtilizationPercent:0.0}% ({r.CapacityBadge}), peaking between {r.PeakHours}.");
        }
        else if (r.ScheduledSessions > 0)
        {
            list.Add($"Studio capacity utilization is {r.CapacityUtilizationPercent:0.0}% ({r.CapacityBadge}).");
        }

        // 6. Equipment
        if (r.OpenMaintenanceTickets > 0 || r.EquipmentOnHold > 0)
        {
            list.Add($"Equipment alert: {r.OpenMaintenanceTickets} open ticket(s) and {r.EquipmentOnHold} asset(s) flagged on hold.");
        }
        else if (r.TotalDispatches > 0)
        {
            list.Add($"Gear operations nominal: {r.TotalDispatches} dispatches recorded with zero open maintenance tickets.");
        }

        return list;
    }
}
