@page "/admin/clients"
@page "/clients"
@layout AdminLayout
@rendermode InteractiveServer
@inject IUserService UserService

<PageTitle>Clients - PhotoAevum</PageTitle>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Clients</h1>
            <p class="text-gray-500 mt-1">Directory of registered studio clients and photography accounts.</p>
        </div>

        <div class="relative w-full sm:w-80">
            <input type="text"
                   value="@_searchQuery"
                   @oninput="OnSearchInput"
                   placeholder="Search clients by name, ID, email, or phone..."
                   class="w-full pl-9 pr-4 py-2 text-xs rounded-lg border border-gray-300 bg-white focus:outline-none focus:ring-2 focus:ring-gray-900" />
            <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
    </div>

    <SystemMessage Message="@_feedbackMessage"
                   Severity="@_feedbackSeverity"
                   Mode="banner"
                   OnDismiss="() => _feedbackMessage = null" />

    @if (_customers.Count == 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
            <div class="max-w-md mx-auto text-gray-500">
                <p class="text-base font-medium text-gray-700 mb-1">No Registered Clients</p>
                <p class="text-sm">No client records were found in the database.</p>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold uppercase tracking-wider text-gray-500">
                            <th class="px-6 py-3.5">Client ID</th>
                            <th class="px-6 py-3.5">Name</th>
                            <th class="px-6 py-3.5">Email</th>
                            <th class="px-6 py-3.5">Phone</th>
                            <th class="px-6 py-3.5">Account Status</th>
                            <th class="px-6 py-3.5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @if (PagedCustomers.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="px-6 py-8 text-center text-xs text-gray-500">
                                    No clients matched your search query.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var client in PagedCustomers)
                            {
                                <tr @key="client.Id" class="hover:bg-gray-50">
                                    <td class="px-6 py-4 font-mono text-xs text-gray-700">@client.Id</td>
                                    <td class="px-6 py-4 font-semibold text-gray-900">@client.Name</td>
                                    <td class="px-6 py-4 text-gray-600">@client.Email</td>
                                    <td class="px-6 py-4 text-gray-600">@(string.IsNullOrWhiteSpace(client.Phone) ? "—" : client.Phone)</td>
                                    <td class="px-6 py-4">
                                        @if (client.HasRequestedDeletion)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                                Deletion Requested
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                Active
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right whitespace-nowrap">
                                        @if (client.HasRequestedDeletion)
                                        {
                                            <button type="button"
                                                    @onclick="() => PromptDeleteClient(client)"
                                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-2xs transition-colors cursor-pointer">
                                                Delete Account
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <TablePagination TotalItems="@FilteredCustomers.Count"
                             PageSize="10"
                             @bind-CurrentPage="_currentPage"
                             ItemLabel="clients" />
        </div>
    }
</div>

@if (_deleteTarget != null)
{
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
         role="dialog" aria-modal="true" aria-labelledby="delete-client-title"
         @onclick="() => _deleteTarget = null">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-md w-full p-6 space-y-4"
             @onclick:stopPropagation="true">
            <h3 id="delete-client-title" class="text-base font-bold text-slate-900">Delete Client Account</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
                This client has requested account deletion. Permanently delete <strong>@_deleteTarget.Name</strong> (<code>@_deleteTarget.Id</code>)? This action cannot be undone.
            </p>
            <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
                <button type="button"
                        @onclick="() => _deleteTarget = null"
                        class="px-4 py-2 text-xs font-semibold rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 cursor-pointer">
                    Cancel
                </button>
                <button type="button"
                        @onclick="ConfirmDeleteClient"
                        class="px-4 py-2 text-xs font-semibold rounded-lg bg-rose-600 hover:bg-rose-700 text-white cursor-pointer">
                    Confirm Delete Account
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<PhotoAevumStudio.Web.Models.Customer> _customers = Array.Empty<PhotoAevumStudio.Web.Models.Customer>();
    private string _searchQuery = string.Empty;
    private int _currentPage = 1;
    private PhotoAevumStudio.Web.Models.Customer? _deleteTarget;
    private string? _feedbackMessage;
    private string _feedbackSeverity = "info";

    private List<PhotoAevumStudio.Web.Models.Customer> FilteredCustomers => _customers
        .Where(c => string.IsNullOrWhiteSpace(_searchQuery) ||
                    c.Name.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    c.Id.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    c.Email.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    (c.Phone != null && c.Phone.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private List<PhotoAevumStudio.Web.Models.Customer> PagedCustomers =>
        TablePagination.Paginate(FilteredCustomers, _currentPage);

    protected override void OnInitialized()
    {
        _customers = UserService.GetCustomers();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    private void PromptDeleteClient(PhotoAevumStudio.Web.Models.Customer client)
    {
        if (!client.HasRequestedDeletion) return;
        _deleteTarget = client;
    }

    private void ConfirmDeleteClient()
    {
        if (_deleteTarget == null || !_deleteTarget.HasRequestedDeletion)
        {
            _deleteTarget = null;
            return;
        }

        var target = _deleteTarget;
        _deleteTarget = null;

        try
        {
            if (UserService.DeleteCustomer(target.Id))
            {
                _customers = UserService.GetCustomers();
                _feedbackSeverity = "success";
                _feedbackMessage = $"Client account '{target.Name}' ({target.Id}) has been permanently deleted.";
            }
            else
            {
                _feedbackSeverity = "error";
                _feedbackMessage = $"Failed to delete client account '{target.Name}' ({target.Id}).";
            }
        }
        catch (Exception ex)
        {
            _feedbackSeverity = "error";
            _feedbackMessage = $"Error deleting client account: {ex.Message}";
        }
    }
}
