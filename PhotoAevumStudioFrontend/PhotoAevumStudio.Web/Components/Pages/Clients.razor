@page "/admin/clients"
@page "/clients"
@layout AdminLayout
@rendermode InteractiveServer
@inject IUserService UserService

<PageTitle>Clients - PhotoAevum</PageTitle>

<div class="flex justify-between items-center mb-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Clients</h1>
        <p class="text-gray-500 mt-1">Directory of registered studio clients and photography accounts.</p>
    </div>
</div>

@if (_customers.Count == 0)
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
        <div class="max-w-md mx-auto text-gray-500">
            <p class="text-base font-medium text-gray-700 mb-1">No Registered Clients</p>
            <p class="text-sm">No client records were found in the database.</p>
        </div>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-left border-collapse text-sm">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold uppercase tracking-wider text-gray-500">
                    <th class="px-6 py-3.5">Client ID</th>
                    <th class="px-6 py-3.5">Name</th>
                    <th class="px-6 py-3.5">Email</th>
                    <th class="px-6 py-3.5">Phone</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var client in _customers)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 font-mono text-xs text-gray-700">@client.Id</td>
                        <td class="px-6 py-4 font-semibold text-gray-900">@client.Name</td>
                        <td class="px-6 py-4 text-gray-600">@client.Email</td>
                        <td class="px-6 py-4 text-gray-600">@(string.IsNullOrWhiteSpace(client.Phone) ? "—" : client.Phone)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<PhotoAevumStudio.Web.Models.Customer> _customers = Array.Empty<PhotoAevumStudio.Web.Models.Customer>();

    protected override void OnInitialized()
    {
        _customers = UserService.GetCustomers();
    }
}
