@page "/change-password"
@layout EmptyLayout
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject NavigationManager NavManager
@inject IAuthService AuthService

<div class="login-page-wrapper">
    <div class="login-card">
        <!-- Logo Section -->
        <div class="logo-wrapper">
            <img src="images/AevumLogo.jpg" alt="Aevum Studio Logo" class="aevum-logo" />
        </div>

        <h2 class="login-header font-bold text-xl tracking-tight uppercase tracking-widest text-gray-900">Change Password</h2>

        @if (isSuccess)
        {
            <div class="success-banner">
                Password changed successfully! You may now sign in with your new password.
            </div>
            <button type="button" class="login-button" @onclick='() => NavManager.NavigateTo("/login")'>
                Go to Login
            </button>
        }
        else
        {
            <p class="change-password-subtitle">
                First-time login detected. You must set a new password before accessing the system.
            </p>

            <EditForm Model="@model" OnValidSubmit="HandleChangePassword">
                <div class="input-group">
                    <label for="userId">ID</label>
                    <input type="text" id="userId" name="userId" autocomplete="username" class="minimal-input" @bind="model.UserId" placeholder="Enter your ID or Email" disabled="@isSubmitting" />
                </div>

                <div class="input-group">
                    <label for="currentPassword">Current Password</label>
                    <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" class="minimal-input" @bind="model.CurrentPassword" placeholder="Enter current password" disabled="@isSubmitting" />
                </div>

                <div class="input-group">
                    <label for="newPassword">New Password</label>
                    <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" class="minimal-input" @bind="model.NewPassword" placeholder="Enter new password (min. 8 characters)" disabled="@isSubmitting" />
                </div>

                <div class="input-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" class="minimal-input" @bind="model.ConfirmPassword" placeholder="Re-enter new password" disabled="@isSubmitting" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-message">
                        @errorMessage
                    </div>
                }

                <button type="submit" class="login-button" disabled="@isSubmitting">
                    @if (isSubmitting) { <span>Updating...</span> } else { <span>Set New Password</span> }
                </button>

                <div class="back-link-container">
                    <a href="/login" class="back-link">Back to Login</a>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    private PasswordChangeModel model = new();
    private string errorMessage = "";
    private bool isSubmitting = false;
    private bool isSuccess = false;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(UserId))
        {
            model.UserId = UserId;
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(UserId))
        {
            model.UserId = UserId;
        }
    }

    private async Task HandleChangePassword()
    {
        isSubmitting = true;
        errorMessage = "";
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(model.UserId) ||
            string.IsNullOrWhiteSpace(model.CurrentPassword) ||
            string.IsNullOrWhiteSpace(model.NewPassword) ||
            string.IsNullOrWhiteSpace(model.ConfirmPassword))
        {
            errorMessage = "All fields are required.";
            isSubmitting = false;
            return;
        }

        if (model.NewPassword.Length < 8)
        {
            errorMessage = "New password must be at least 8 characters long.";
            isSubmitting = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(model.NewPassword, @"[A-Za-z]"))
        {
            errorMessage = "Password must contain at least one letter.";
            isSubmitting = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(model.NewPassword, @"[0-9]"))
        {
            errorMessage = "Password must contain at least one digit.";
            isSubmitting = false;
            return;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "New passwords do not match.";
            isSubmitting = false;
            return;
        }

        if (model.NewPassword == model.CurrentPassword)
        {
            errorMessage = "New password must be different from current password.";
            isSubmitting = false;
            return;
        }

        var result = await AuthService.ChangeInitialPasswordAsync(
            model.UserId, model.CurrentPassword, model.NewPassword, model.ConfirmPassword);

        if (result.Success)
        {
            isSuccess = true;
        }
        else
        {
            errorMessage = result.Error ?? "Failed to change password. Please verify current password and try again.";
        }

        isSubmitting = false;
    }

    public class PasswordChangeModel
    {
        public string UserId { get; set; } = string.Empty;
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
