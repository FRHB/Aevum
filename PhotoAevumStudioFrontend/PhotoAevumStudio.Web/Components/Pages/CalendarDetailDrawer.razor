@using PhotoAevumStudio.Web.Models

@if (Booking != null)
{
    <div class="drawer-backdrop" @onclick="CloseAsync">
        <div class="compact-detail-drawer" @onclick:stopPropagation="true">
            <div class="drawer-header">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="status-pill text-xs @GetDrawerStatusPillClass()">@Booking.DisplayStatus</span>
                        @if (Booking.HasConflict)
                        {
                            <span class="badge-conflict">⚠️ Conflict</span>
                        }
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mt-1">@Booking.ClientName</h3>
                </div>
                <button type="button" @onclick="CloseAsync" class="drawer-close-btn" aria-label="Close details">✕</button>
            </div>

            <div class="drawer-body">
                @if (Booking.IsConsultation)
                {
                    <div class="drawer-field">
                        <span class="drawer-field-label">Type</span>
                        <span class="drawer-field-val inline-flex items-center gap-1 font-bold text-teal-700 bg-teal-50 px-2 py-0.5 rounded border border-teal-200">
                            <span>💬</span> Consultation &amp; Inquiry Call
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Booking.MeetingLink))
                    {
                        <div class="drawer-field">
                            <span class="drawer-field-label">Meeting Room</span>
                            <div class="drawer-field-val">
                                <a href="@Booking.MeetingLink" target="_blank"
                                   class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold rounded-lg transition-colors shadow-xs">
                                    <span>📹</span> Join Video Call
                                </a>
                            </div>
                        </div>
                    }
                }
                <div class="drawer-field">
                    <span class="drawer-field-label">Service@(Booking.AssignedServices.Count > 1 ? "s" : "")</span>
                    <span class="drawer-field-val">@(Booking.AssignedServices.Count > 0 ? string.Join(", ", Booking.AssignedServices) : Booking.ServiceType)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Booking.EventLocation) || !string.IsNullOrWhiteSpace(Booking.StudioSpaceName))
                {
                    <div class="drawer-field">
                        <span class="drawer-field-label">Event Location</span>
                        <span class="drawer-field-val">@(!string.IsNullOrWhiteSpace(Booking.EventLocation) ? Booking.EventLocation : Booking.StudioSpaceName)</span>
                    </div>
                }
                <div class="drawer-field">
                    <span class="drawer-field-label">Schedule</span>
                    <span class="drawer-field-val">@Booking.Date.ToString("ddd, MMM d, yyyy") (@Booking.FormattedTimeRange)</span>
                </div>
                @if (!Booking.IsConsultation)
                {
                    <div class="drawer-field">
                        <span class="drawer-field-label">Buffer Window</span>
                        <span class="drawer-field-val text-xs text-slate-600">
                            Prep: @DateTime.Today.Add(Booking.CombinedStartTime).ToString("h:mm tt") – @DateTime.Today.Add(Booking.StartTime).ToString("h:mm tt") (2h) &bull;
                            Post: @DateTime.Today.Add(Booking.EffectiveEndTime).ToString("h:mm tt") – @DateTime.Today.Add(Booking.CombinedEndTime).ToString("h:mm tt") (1h)
                        </span>
                    </div>
                }
                <div class="drawer-field">
                    <span class="drawer-field-label">@(Booking.IsConsultation ? "Assigned Clerk" : "Assigned Crew")</span>
                    @if (Booking.AssignedCrew.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1 mt-0.5">
                            @foreach (var crew in Booking.AssignedCrew)
                            {
                                <span class="px-2 py-0.5 rounded-full text-xs font-semibold @(crew.IsTeamLeader ? "bg-amber-100 text-amber-900 border border-amber-300" : "bg-slate-100 text-slate-800")">
                                    @crew.FullName@(crew.IsTeamLeader ? " (Lead)" : "")
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="drawer-field-val">@Booking.AssignedPhotographer</span>
                    }
                </div>
                @if (!Booking.IsConsultation)
                {
                    <div class="drawer-field">
                        <span class="drawer-field-label">Booked Equipment</span>
                        @if (Booking.AssignedEquipment.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1 mt-0.5">
                                @foreach (var eq in Booking.AssignedEquipment)
                                {
                                    <span class="px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-800 border border-slate-200">
                                        @eq.EquipmentName (@eq.EquipmentId)
                                    </span>
                                }
                            </div>
                        }
                        else if (Booking.AssignedEquipmentNames.Count > 0)
                        {
                            <span class="drawer-field-val">@string.Join(", ", Booking.AssignedEquipmentNames)</span>
                        }
                        else if (Booking.AssignedEquipmentIds.Count > 0)
                        {
                            <span class="drawer-field-val">@string.Join(", ", Booking.AssignedEquipmentIds)</span>
                        }
                        else
                        {
                            <span class="drawer-field-val text-xs text-gray-400 italic">No equipment assigned</span>
                        }
                    </div>
                }
                @if (!Booking.IsConsultation && !HidePricing)
                {
                    <div class="drawer-field">
                        <span class="drawer-field-label">Price</span>
                        <span class="drawer-field-val font-bold">₱@Booking.EstimatedPrice.ToString("N2")</span>
                    </div>
                }

                @if (Booking.IsConsultation && !string.IsNullOrWhiteSpace(Booking.LinkedEventAppointmentId))
                {
                    <div class="drawer-field bg-emerald-50 border border-emerald-200 rounded-lg p-2.5">
                        <span class="drawer-field-label text-emerald-800">Resulting Event Appointment</span>
                        <div class="flex items-center justify-between gap-2 mt-1">
                            <span class="font-mono text-xs font-bold text-emerald-900">#@Booking.LinkedEventAppointmentId</span>
                            <button type="button"
                                    @onclick="() => OpenLinkedEventAsync(Booking.LinkedEventAppointmentId!)"
                                    class="px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-bold transition-colors">
                                Open Event Appointment →
                            </button>
                        </div>
                    </div>
                }

                @if (!Booking.IsConsultation && !string.IsNullOrWhiteSpace(Booking.LinkedNegotiationId))
                {
                    <div class="drawer-field">
                        <span class="drawer-field-label">Source Consultation</span>
                        <span class="drawer-field-val font-mono text-xs font-bold text-indigo-700">#@Booking.LinkedNegotiationId</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Booking.Notes))
                {
                    <div class="drawer-field">
                        <span class="drawer-field-label">Notes</span>
                        <span class="drawer-field-val italic text-xs">@Booking.Notes</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventBookingModel? Booking { get; set; }
    [Parameter] public bool HidePricing { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnOpenLinkedEvent { get; set; }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task OpenLinkedEventAsync(string linkedId)
    {
        if (OnOpenLinkedEvent.HasDelegate)
        {
            await OnOpenLinkedEvent.InvokeAsync(linkedId);
        }
    }

    private string GetDrawerStatusPillClass()
    {
        if (Booking == null) return string.Empty;
        if (Booking.IsAppointmentBooked) return "appointment-booked bg-emerald-100 text-emerald-800 border border-emerald-300 font-bold";
        if (Booking.IsPendingPayment) return "pending bg-amber-100 text-amber-800 border border-amber-300 font-bold";
        if (Booking.IsCompleted) return "completed bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold";
        return Booking.Status.ToLowerInvariant();
    }
}
