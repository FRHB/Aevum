@implements IDisposable



@page "/admin/negotiations"



@page "/staff/negotiations"



@layout SidebarLayout



@using Microsoft.AspNetCore.Components.Authorization



@using PhotoAevumStudio.Web.Models



@using PhotoAevumStudio.Web.Services



@attribute [Authorize(Roles = "Admin,Employee,Office Clerk")]



@rendermode InteractiveServer



@inject IConsultationClient ConsultationApi



@inject IEmployeeService EmployeeService



@inject IEquipmentService EquipmentService



@inject IUserService UserService



@inject IBookScheduleClient ScheduleApi



@inject AuthenticationStateProvider AuthStateProvider



@inject NavigationManager Nav







<PageTitle>Booking Negotiations &amp; Consultations | Photo Aevum Studio</PageTitle>







<div class="px-6 py-6 max-w-7xl mx-auto space-y-6">







    @* ── Top Header ───────────────────────────────────────────────────────── *@



    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-4 border-b border-slate-200">



        <div>



            <div class="flex items-center gap-2">



                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-100 text-teal-800">



                    Office Clerk Desk



                </span>



                <span class="text-xs text-slate-400 font-mono">Round-Robin Allocation Active</span>



            </div>



            <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Booking Negotiations &amp; Inquiries</h1>



            <p class="text-xs text-slate-500 mt-0.5">



                Manage incoming customer schedule consultations, conduct online video calls, negotiate service packages, and book formal event appointments.



            </p>



        </div>







        <div class="flex items-center gap-2">



            <button type="button" 



                    @onclick="LoadNegotiationsAsync" 



                    disabled="@_loading"



                    class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-700 shadow-xs transition-all">



                <span class="@(_loading ? "animate-spin" : "")">🔄</span>



                <span>Refresh Inbox</span>



            </button>



            <button type="button"



                    @onclick="OpenSimulateInquiryModal"



                    class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-900 hover:bg-black text-white rounded-lg text-xs font-bold shadow-xs transition-all">



                <span>➕</span>



                <span>Simulate Client Inquiry</span>



            </button>



        </div>



    </div>







    @* ── KPI Summary Cards ────────────────────────────────────────────────── *@



    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">



        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-xs">



            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Consultations</div>



            <div class="text-2xl font-black text-slate-900 mt-1">@_negotiations.Count</div>



            <div class="text-[11px] text-slate-500 mt-0.5">Inquiry sessions logged</div>



        </div>



        <div class="bg-white rounded-xl border border-amber-200 bg-amber-50/30 p-4 shadow-xs">



            <div class="text-[11px] font-bold uppercase tracking-wider text-amber-700">Pending Video Calls</div>



            <div class="text-2xl font-black text-amber-800 mt-1">@_negotiations.Count(n => n.NegotiationStatus == "Pending_Call")</div>



            <div class="text-[11px] text-amber-600 mt-0.5">Awaiting clerk negotiation</div>



        </div>



        <div class="bg-white rounded-xl border border-emerald-200 bg-emerald-50/30 p-4 shadow-xs">



            <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-700">Deals Won</div>



            <div class="text-2xl font-black text-emerald-800 mt-1">@_negotiations.Count(n => n.NegotiationStatus == "Deal_Won")</div>



            <div class="text-[11px] text-emerald-600 mt-0.5">Converted to event shoots</div>



        </div>



        <div class="bg-white rounded-xl border border-indigo-200 bg-indigo-50/30 p-4 shadow-xs">



            <div class="text-[11px] font-bold uppercase tracking-wider text-indigo-700">Active Shoot Events</div>



            <div class="text-2xl font-black text-indigo-800 mt-1">@_negotiations.Count(n => !string.IsNullOrWhiteSpace(n.EventAppointmentId))</div>



            <div class="text-[11px] text-indigo-600 mt-0.5">Staff &amp; gear reserved</div>



        </div>



    </div>







    @* ── Filters & Search ─────────────────────────────────────────────────── *@



    <div class="bg-white rounded-xl border border-slate-200 p-3.5 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3">



        <div class="flex flex-wrap items-center gap-1.5 w-full sm:w-auto">



            @foreach (var filter in new[] { "All", "Pending_Call", "Deal_Won", "Deal_Lost", "Rescheduled" })



            {



                var label = filter == "All" ? "All Inquiries" : filter.Replace("_", " ");



                var isSelected = _selectedStatusFilter == filter;



                <button type="button"



                        @onclick="() => SetFilter(filter)"



                        class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all @(isSelected ? "bg-slate-900 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">



                    @label



                </button>



            }



        </div>







        <div class="w-full sm:w-64">



            <input type="text"



                   @bind="_searchTerm"



                   @bind:event="oninput"



                   placeholder="Search client, ID, notes…"



                   class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-slate-900" />



        </div>



    </div>







    @* ── Negotiations Table ───────────────────────────────────────────────── *@



    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">



        <div class="overflow-x-auto">



            <table class="w-full text-left text-xs border-collapse">



                <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase text-[10px] tracking-wider">



                    <tr>



                        <th class="px-4 py-3">Inquiry ID</th>



                        <th class="px-4 py-3">Client Contact</th>



                        <th class="px-4 py-3">Consultation Schedule</th>



                        <th class="px-4 py-3">Assigned Office Clerk</th>



                        <th class="px-4 py-3">Status</th>



                        <th class="px-4 py-3">Meeting Link</th>



                        <th class="px-4 py-3 text-right">Action</th>



                    </tr>



                </thead>



                <tbody class="divide-y divide-slate-100">



                    @if (_loading)



                    {



                        <tr>



                            <td colspan="7" class="px-4 py-12 text-center text-slate-400 italic">



                                Loading consultations inbox…



                            </td>



                        </tr>



                    }



                    else if (!FilteredNegotiations.Any())



                    {



                        <tr>



                            <td colspan="7" class="px-4 py-12 text-center text-slate-500">



                                <div class="text-2xl mb-1">📋</div>



                                <div class="font-bold">No consultations found</div>



                                <p class="text-slate-400 mt-0.5">No inquiries match the active filter criteria.</p>



                            </td>



                        </tr>



                    }



                    else



                    {



                        @foreach (var neg in FilteredNegotiations)



                        {



                            <tr class="hover:bg-slate-50/80 transition-colors @(_selectedNegotiation?.NegotiationId == neg.NegotiationId ? "bg-teal-50/50" : "")">



                                <td class="px-4 py-3 font-mono font-bold text-slate-900">



                                    @neg.NegotiationId



                                    @if (!string.IsNullOrWhiteSpace(neg.EventAppointmentId))



                                    {



                                        <div class="text-[10px] font-mono text-teal-700">↳ @neg.EventAppointmentId</div>



                                    }



                                </td>



                                <td class="px-4 py-3">



                                    <div class="font-bold text-slate-900">@neg.CustomerName</div>



                                    <div class="text-[11px] text-slate-500">@neg.CustomerEmail</div>



                                    @if (!string.IsNullOrWhiteSpace(neg.CustomerPhone))



                                    {



                                        <div class="text-[10px] text-slate-400">@neg.CustomerPhone</div>



                                    }



                                </td>



                                <td class="px-4 py-3">



                                    <div class="font-medium text-slate-900">@neg.ConsultationDate.ToString("MMM dd, yyyy")</div>



                                    <div class="text-[11px] text-slate-500">@neg.ConsultationTime.ToString("h:mm tt")</div>



                                </td>



                                <td class="px-4 py-3">



                                    <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-800">



                                        <span>👤</span>



                                        <span>@neg.EmployeeName</span>



                                    </div>



                                </td>



                                <td class="px-4 py-3">



                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold @GetStatusBadgeClass(neg.NegotiationStatus)">



                                        @neg.NegotiationStatus.Replace("_", " ")



                                    </span>



                                </td>



                                <td class="px-4 py-3">



                                    @if (!string.IsNullOrWhiteSpace(neg.MeetingLink))



                                    {



                                        <a href="@neg.MeetingLink" target="_blank" rel="noopener noreferrer" 



                                           class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-teal-50 hover:bg-teal-100 text-teal-800 font-semibold text-[11px] border border-teal-200 transition-colors">



                                            <span>🎥</span>



                                            <span>Google Meet</span>



                                        </a>



                                    }



                                    else



                                    {



                                        <span class="text-slate-400 italic">No link</span>



                                    }



                                </td>



                                <td class="px-4 py-3 text-right">



                                    <button type="button"



                                            @onclick="() => OpenFloatingPanel(neg)"



                                            class="px-3 py-1.5 bg-slate-900 hover:bg-black text-white rounded-lg text-xs font-semibold shadow-xs transition-colors">



                                        Open Details →



                                    </button>



                                </td>



                            </tr>



                        }



                    }



                </tbody>



            </table>



        </div>



    </div>







</div>







@* ── Floating Drawer / Panel ─────────────────────────────────────────────── *@



@if (_isPanelOpen && _selectedNegotiation != null)



{



    <div class="fixed inset-0 z-50 flex justify-end bg-black/40 backdrop-blur-xs transition-opacity animate-in fade-in duration-200"



         @onclick="CloseFloatingPanel">



        <div class="w-full max-w-xl h-full bg-white shadow-2xl flex flex-col justify-between overflow-y-auto"



             @onclick:stopPropagation="true">



            



            @* Panel Header *@



            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/50">



                <div>



                    <div class="flex items-center gap-2">



                        <span class="font-mono text-xs font-extrabold text-slate-500">@_selectedNegotiation.NegotiationId</span>



                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold @GetStatusBadgeClass(_selectedNegotiation.NegotiationStatus)">



                            @_selectedNegotiation.NegotiationStatus.Replace("_", " ")



                        </span>



                    </div>



                    <h2 class="text-lg font-black text-slate-900 mt-1">@_selectedNegotiation.CustomerName</h2>



                </div>



                <button type="button" @onclick="CloseFloatingPanel" class="p-2 text-slate-400 hover:text-slate-700 rounded-lg">



                    ✕



                </button>



            </div>







            @* Panel Body Content *@



            <div class="p-6 space-y-5 flex-1">



                @* Client Information Box *@



                <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 space-y-2">



                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Client Inquirer Details</h3>



                    <div class="grid grid-cols-2 gap-2 text-xs">



                        <div>



                            <span class="text-slate-400 block text-[10px]">Email</span>



                            <span class="font-semibold text-slate-900">@_selectedNegotiation.CustomerEmail</span>



                        </div>



                        <div>



                            <span class="text-slate-400 block text-[10px]">Phone</span>



                            <span class="font-semibold text-slate-900">@(string.IsNullOrWhiteSpace(_selectedNegotiation.CustomerPhone) ? "—" : _selectedNegotiation.CustomerPhone)</span>



                        </div>



                        <div>



                            <span class="text-slate-400 block text-[10px]">Consultation Date</span>



                            <span class="font-semibold text-slate-900">@_selectedNegotiation.ConsultationDate.ToString("MMMM dd, yyyy")</span>



                        </div>



                        <div>



                            <span class="text-slate-400 block text-[10px]">Consultation Time</span>



                            <span class="font-semibold text-slate-900">@_selectedNegotiation.ConsultationTime.ToString("h:mm tt")</span>



                        </div>



                    </div>



                </div>







                @* Inquiry Notes Box *@



                <div class="bg-white rounded-xl border border-slate-200 p-4 space-y-1.5">



                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Client Inquiry &amp; Desired Services</h3>



                    <p class="text-xs text-slate-700 leading-relaxed whitespace-pre-line">



                        @(string.IsNullOrWhiteSpace(_selectedNegotiation.InquiryNotes) ? "No special inquiry notes specified by client." : _selectedNegotiation.InquiryNotes)



                    </p>



                </div>







                @* Teleconference Card *@



                <div class="bg-teal-50/50 rounded-xl border border-teal-200 p-4 space-y-2.5">



                    <div class="flex items-center justify-between">



                        <h3 class="text-xs font-bold uppercase tracking-wider text-teal-800">Online Teleconference Link</h3>



                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-100 text-teal-800">Google Meet</span>



                    </div>



                    <div class="text-xs font-mono text-slate-600 bg-white p-2 rounded border border-teal-200 break-all select-all">



                        @_selectedNegotiation.MeetingLink



                    </div>



                    <a href="@_selectedNegotiation.MeetingLink" target="_blank" rel="noopener noreferrer"



                       class="inline-flex items-center justify-center gap-2 w-full py-2.5 bg-teal-700 hover:bg-teal-800 text-white rounded-lg text-xs font-bold shadow-xs transition-colors">



                        <span>🎥</span>



                        <span>Join Online Video Consultation</span>



                    </a>



                </div>







                @* If Appointment is already booked for this deal *@



                @if (_selectedNegotiation.Appointment != null)



                {



                    <div class="bg-indigo-50/50 rounded-xl border border-indigo-200 p-4 space-y-2">



                        <div class="flex items-center justify-between">



                            <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-800">Executed Event Appointment</h3>



                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-800">



                                @_selectedNegotiation.Appointment.EventStatus



                            </span>



                        </div>



                        <div class="text-xs font-bold text-slate-900">#@_selectedNegotiation.Appointment.EventAppointmentId - @_selectedNegotiation.Appointment.EventName</div>



                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-600 mt-2">



                            <div>Total: <strong>₱@_selectedNegotiation.Appointment.TotalAmount.ToString("N2")</strong></div>



                            <div>15% Deposit: <strong>₱@_selectedNegotiation.Appointment.DownpaymentAmount.ToString("N2")</strong> (@_selectedNegotiation.Appointment.DownpaymentStatus)</div>



                        </div>



                        @if (_selectedNegotiation.Appointment.HoldExpiresAt != null && _selectedNegotiation.Appointment.DownpaymentStatus == "Pending")



                        {



                            <div class="text-[11px] font-semibold text-amber-700 mt-1">



                                ⏳ Reservation Hold: @_selectedNegotiation.Appointment.HoldExpiresAt.Value.ToLocalTime().ToString("hh:mm tt")



                            </div>



                        }



                    </div>



                }



            </div>







            @* Panel Bottom Action Footer (The 3 Deal Buttons) *@



            <div class="p-6 border-t border-slate-200 bg-slate-50/80 space-y-2">



                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Consultation Outcome</div>



                



                @if (_selectedNegotiation.NegotiationStatus == "Pending_Call" || _selectedNegotiation.NegotiationStatus == "Rescheduled")



                {



                    <div class="grid grid-cols-3 gap-2">



                        <button type="button"



                                @onclick='() => MarkDealOutcomeAsync(_selectedNegotiation.NegotiationId, "Deal_Lost")'



                                class="py-2.5 px-3 bg-red-100 hover:bg-red-200 text-red-700 text-xs font-bold rounded-lg transition-colors text-center">



                            Failed with Deal



                        </button>



                        <button type="button"



                                @onclick="OpenRescheduleModal"



                                class="py-2.5 px-3 bg-amber-100 hover:bg-amber-200 text-amber-800 text-xs font-bold rounded-lg transition-colors text-center">



                            Reschedule



                        </button>



                        <button type="button"



                                @onclick="OpenEventWizard"



                                class="py-2.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold rounded-lg shadow-sm transition-colors text-center">



                            Success with Deal



                        </button>



                    </div>



                }



                else



                {



                    <div class="text-xs text-slate-600 font-medium">



                        Consultation outcome finalized as <strong>@_selectedNegotiation.NegotiationStatus.Replace("_", " ")</strong>.



                    </div>



                }



            </div>







        </div>



    </div>



}







@* ── 5-STEP EVENT APPOINTMENT SETUP WIZARD MODAL ─────────────────────────── *@



@if (_isWizardOpen && _selectedNegotiation != null)



{



    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-in fade-in duration-200">



        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden">



            



            @* Wizard Header *@



            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">



                <div>



                    <span class="text-[11px] font-bold text-teal-700 uppercase tracking-wider">Office Clerk Booking Wizard (5 Steps)</span>



                    <h2 class="text-lg font-black text-slate-900">Setup Event Appointment for @_selectedNegotiation.CustomerName</h2>



                </div>



                <button type="button" @onclick="CloseEventWizard" class="text-slate-400 hover:text-slate-700 p-2">✕</button>



            </div>







            @* Stepper Progress *@



            <div class="px-6 py-3 bg-slate-100/70 border-b border-slate-200 flex items-center justify-between text-xs font-bold overflow-x-auto">



                <div class="flex items-center gap-1.5 shrink-0 @(_wizardStep == 1 ? "text-slate-900 font-black" : (_wizardStep > 1 ? "text-teal-700" : "text-slate-400"))">



                    <span class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] @(_wizardStep == 1 ? "bg-slate-900 text-white" : (_wizardStep > 1 ? "bg-teal-700 text-white" : "bg-slate-300 text-slate-600"))">1</span>



                    <span>Services</span>



                </div>



                <span class="text-slate-300 shrink-0 mx-1">&rarr;</span>



                <div class="flex items-center gap-1.5 shrink-0 @(_wizardStep == 2 ? "text-slate-900 font-black" : (_wizardStep > 2 ? "text-teal-700" : "text-slate-400"))">



                    <span class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] @(_wizardStep == 2 ? "bg-slate-900 text-white" : (_wizardStep > 2 ? "bg-teal-700 text-white" : "bg-slate-300 text-slate-600"))">2</span>



                    <span>Payment &amp; Email</span>



                </div>



                <span class="text-slate-300 shrink-0 mx-1">&rarr;</span>



                <div class="flex items-center gap-1.5 shrink-0 @(_wizardStep == 3 ? "text-slate-900 font-black" : (_wizardStep > 3 ? "text-teal-700" : "text-slate-400"))">



                    <span class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] @(_wizardStep == 3 ? "bg-slate-900 text-white" : (_wizardStep > 3 ? "bg-teal-700 text-white" : "bg-slate-300 text-slate-600"))">3</span>



                    <span>Staff &amp; Leader</span>



                </div>



                <span class="text-slate-300 shrink-0 mx-1">&rarr;</span>



                <div class="flex items-center gap-1.5 shrink-0 @(_wizardStep == 4 ? "text-slate-900 font-black" : (_wizardStep > 4 ? "text-teal-700" : "text-slate-400"))">



                    <span class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] @(_wizardStep == 4 ? "bg-slate-900 text-white" : (_wizardStep > 4 ? "bg-teal-700 text-white" : "bg-slate-300 text-slate-600"))">4</span>



                    <span>Equipment</span>



                </div>



                <span class="text-slate-300 shrink-0 mx-1">&rarr;</span>



                <div class="flex items-center gap-1.5 shrink-0 @(_wizardStep == 5 ? "text-slate-900 font-black" : "text-slate-400")">



                    <span class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] @(_wizardStep == 5 ? "bg-slate-900 text-white" : "bg-slate-300 text-slate-600")">5</span>



                    <span>Await Payment</span>



                </div>



            </div>







            @* Wizard Step Body *@



            <div class="p-6 overflow-y-auto flex-1 space-y-4">



                



                @if (!string.IsNullOrWhiteSpace(_wizardError))



                {



                    <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-xs font-semibold">



                        @_wizardError



                    </div>



                }







                @* STEP 1: Services Selection & Shoot Details *@



                @if (_wizardStep == 1)



                {



                    <div class="space-y-4">



                        <div>



                            <div class="flex items-center justify-between pb-2 border-b border-slate-100">



                                <span class="text-xs font-bold text-slate-700">Select studio packages &amp; creative services (multiple selections allowed):</span>



                                <span class="text-xs font-bold text-teal-700">@_selectedServiceIds.Count selected</span>



                            </div>







                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-52 overflow-y-auto pr-1 mt-2">



                                @foreach (var svc in _availableServices)



                                {



                                    var isChecked = _selectedServiceIds.Contains(svc.ServicesId);



                                    <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer transition-all @(isChecked ? "border-slate-900 bg-slate-50 shadow-xs" : "border-slate-200 hover:border-slate-300")">



                                        <input type="checkbox"



                                               checked="@isChecked"



                                               @onchange="e => ToggleWizardService(svc.ServicesId, (bool)(e.Value ?? false))"



                                               class="mt-1 rounded text-slate-900 focus:ring-0" />



                                        <div class="flex-1">



                                            <div class="flex items-center justify-between">



                                                <span class="text-xs font-bold text-slate-900">@svc.Name</span>



                                                <span class="text-xs font-mono font-bold text-slate-900">₱@svc.Price.ToString("N2")</span>



                                            </div>



                                            <p class="text-[11px] text-slate-500 line-clamp-2 mt-0.5">@svc.Description</p>



                                        </div>



                                    </label>



                                }



                            </div>



                        </div>







                        <div class="pt-2 border-t border-slate-100">



                            <span class="text-xs font-bold text-slate-700 block mb-2">Shoot Details (Auto-populated from consultation inquiry):</span>



                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">



                                <div class="sm:col-span-2">



                                    <label class="block text-[11px] font-bold text-slate-600 mb-1">Event Photoshoot Name *</label>



                                    <input type="text" @bind="_wizardEventName" placeholder="e.g. Graduation &amp; Editorial Session"



                                           class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium focus:outline-none focus:ring-1 focus:ring-slate-900" />



                                </div>



                                <div>



                                    <label class="block text-[11px] font-bold text-slate-600 mb-1">Shoot Date *</label>



                                    <input type="date" @bind="_wizardEventDate"



                                           class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium focus:outline-none focus:ring-1 focus:ring-slate-900" />



                                </div>



                                <div>



