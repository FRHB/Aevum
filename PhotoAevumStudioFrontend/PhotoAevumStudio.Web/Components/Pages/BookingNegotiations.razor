        }



        catch { }



    }







    private IEnumerable<ConsultationNegotiationDto> FilteredNegotiations =>



        _negotiations.Where(n =>



            (_selectedStatusFilter == "All" || n.NegotiationStatus == _selectedStatusFilter) &&



            (string.IsNullOrWhiteSpace(_searchTerm) ||



             n.NegotiationId.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||



             n.CustomerName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||



             n.CustomerEmail.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||



             n.InquiryNotes.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)));







    private void SetFilter(string filter) => _selectedStatusFilter = filter;







    private void OpenFloatingPanel(ConsultationNegotiationDto neg)



    {



