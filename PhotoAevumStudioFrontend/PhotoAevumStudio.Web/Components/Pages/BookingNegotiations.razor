@code {
    private List<ConsultationNegotiationDto> _negotiations = new();
    private bool _loading = true;
    private string _selectedStatusFilter = "All";
    private string _searchTerm = string.Empty;

    // Floating Panel State
    private bool _isPanelOpen = false;
    private ConsultationNegotiationDto? _selectedNegotiation;

    // Wizard State
    private bool _isWizardOpen = false;
    private int _wizardStep = 1;
    private bool _submittingWizard = false;
    private string? _wizardError;

    // Wizard Form Fields
    private string _wizardEventName = string.Empty;
    private string _wizardEventDescription = string.Empty;
    private DateTime _wizardEventDate = DateTime.Today.AddDays(7);
    private DateTime _wizardEventTime = DateTime.Today.AddHours(14);
    private string _wizardEventLocation = string.Empty;
    private HashSet<string> _selectedServiceIds = new();
    private HashSet<string> _selectedEmployeeIds = new();
    private string _teamLeaderId = string.Empty;
    private HashSet<string> _selectedEquipmentIds = new();

    // Catalog Data
    private List<ScheduleServiceOption> _availableServices = new();
    private List<EmployeeViewModel> _availableEmployees = new();
    private List<EquipmentItemModel> _availableEquipment = new();

    // Simulation Modal
    private bool _isSimulateModalOpen = false;
    private string _simCustomerName = "Isabella Cruz";
    private string _simCustomerEmail = "isabella.cruz@example.com";
    private string _simCustomerPhone = "0917-888-9999";
    private string _simInquiryNotes = "Hello, inquiring about outdoor fashion photoshoot & studio editorial rates.";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateProvider != null)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            bool isAdmin = EmployeeRoleHelper.IsAdmin(user) || EmployeeRoleHelper.IsSystemAdmin(user);
            bool isClerk = EmployeeRoleHelper.IsOfficeClerk(user, UserService);

            if (!isAdmin && !isClerk)
            {
                // Access restricted to verified Office Clerks and Admins
                Nav.NavigateTo("/staff");
                return;
            }
        }

        await LoadNegotiationsAsync();
        await LoadCatalogDataAsync();
    }

    private async Task LoadNegotiationsAsync()
    {
        _loading = true;
        try
        {
            var res = await ConsultationApi.GetNegotiationsAsync();
            if (res.IsSuccess && res.Value != null)
            {
                _negotiations = res.Value.ToList();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCatalogDataAsync()
    {
        try
        {
            var svcRes = await ScheduleApi.GetServicesAsync();
            if (svcRes.IsSuccess && svcRes.Value != null)
            {
                _availableServices = svcRes.Value.ToList();
            }

            var emps = await EmployeeService.GetEmployeesAsync();
            _availableEmployees = emps.Where(e => e.Status == "Active").ToList();

            var eqs = await EquipmentService.GetEquipmentsAsync();
            _availableEquipment = eqs.ToList();
        }
        catch { }
    }

    private IEnumerable<ConsultationNegotiationDto> FilteredNegotiations =>
        _negotiations.Where(n =>
            (_selectedStatusFilter == "All" || n.NegotiationStatus == _selectedStatusFilter) &&
            (string.IsNullOrWhiteSpace(_searchTerm) ||
             n.NegotiationId.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             n.CustomerName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             n.CustomerEmail.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             n.InquiryNotes.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)));

    private void SetFilter(string filter) => _selectedStatusFilter = filter;

    private void OpenFloatingPanel(ConsultationNegotiationDto neg)
    {
        _selectedNegotiation = neg;
        _isPanelOpen = true;
    }

    private void CloseFloatingPanel()
    {
        _isPanelOpen = false;
    }

    private async Task MarkDealOutcomeAsync(string negotiationId, string outcome)
    {
        var res = await ConsultationApi.UpdateNegotiationOutcomeAsync(negotiationId, new UpdateNegotiationOutcomeRequest
        {
            NegotiationStatus = outcome,
            Notes = $"Marked as {outcome} by office clerk on {DateTime.Now:g}."
        });

        if (res.IsSuccess)
        {
            await LoadNegotiationsAsync();
            if (_selectedNegotiation?.NegotiationId == negotiationId)
            {
                _selectedNegotiation.NegotiationStatus = outcome;
            }
        }
    }

    private bool _isRescheduleModalOpen = false;
    private DateTime _rescheduleDate = DateTime.Today.AddDays(1);
    private DateTime _rescheduleTime = DateTime.Today.AddHours(10);
    private string _rescheduleNotes = string.Empty;
    private string? _rescheduleError;
    private bool _submittingReschedule = false;

    private void OpenRescheduleModal()
    {
        if (_selectedNegotiation == null) return;
        _rescheduleDate = _selectedNegotiation.ConsultationDate.ToDateTime(TimeOnly.MinValue);
        if (_rescheduleDate < DateTime.Today) _rescheduleDate = DateTime.Today.AddDays(1);
        _rescheduleTime = DateTime.Today.Add(_selectedNegotiation.ConsultationTime.ToTimeSpan());
        _rescheduleNotes = string.Empty;
        _rescheduleError = null;
        _isRescheduleModalOpen = true;
    }

    private async Task ConfirmRescheduleAsync()
    {
        if (_selectedNegotiation == null) return;
        _submittingReschedule = true;
        _rescheduleError = null;
        try
        {
            var res = await ConsultationApi.UpdateNegotiationOutcomeAsync(_selectedNegotiation.NegotiationId, new UpdateNegotiationOutcomeRequest
            {
                NegotiationStatus = "Rescheduled",
                Notes = string.IsNullOrWhiteSpace(_rescheduleNotes) ? "Consultation rescheduled by office clerk." : _rescheduleNotes,
                NewConsultationDate = DateOnly.FromDateTime(_rescheduleDate),
                NewConsultationTime = TimeOnly.FromDateTime(_rescheduleTime)
            });

            if (res.IsSuccess)
            {
                _isRescheduleModalOpen = false;
                await LoadNegotiationsAsync();
                _selectedNegotiation = _negotiations.FirstOrDefault(n => n.NegotiationId == _selectedNegotiation.NegotiationId);
                await DisplayToast("Consultation rescheduled and notification email dispatched to client.");
            }
            else
            {
                _rescheduleError = res.Error?.Message ?? "Failed to reschedule consultation.";
            }
        }
        catch (Exception ex)
        {
            _rescheduleError = ex.Message;
        }
        finally
        {
            _submittingReschedule = false;
        }
    }

    // ── Wizard Management ──────────────────────────────────────────────────
    private void OpenEventWizard()
    {
        if (_selectedNegotiation == null) return;
        _wizardStep = 1;
        _wizardError = null;
        _wizardEventName = $"{_selectedNegotiation.CustomerName} - Photoshoot Event";
        _wizardEventDescription = _selectedNegotiation.InquiryNotes;
        _wizardEventDate = DateTime.Today.AddDays(7);
        _wizardEventTime = DateTime.Today.AddHours(14);
        _wizardEventLocation = "Studio Main Hall";
        _selectedServiceIds.Clear();
        _selectedEmployeeIds.Clear();
        _teamLeaderId = string.Empty;
        _selectedEquipmentIds.Clear();

        // Pre-select first 1-2 services
        if (_availableServices.Count > 0)
        {
            _selectedServiceIds.Add(_availableServices[0].ServicesId);
        }

        // Auto pre-select clerk or active photographer
        if (_availableEmployees.Count > 0)
        {
            _selectedEmployeeIds.Add(_availableEmployees[0].EmployeeId);
            _teamLeaderId = _availableEmployees[0].EmployeeId;
        }

        // Auto pre-select essential equipment
        foreach (var eq in _availableEquipment.Take(3))
        {
            _selectedEquipmentIds.Add(eq.EquipmentID);
        }

        _isWizardOpen = true;
    }

    private void CloseEventWizard()
    {
        _isWizardOpen = false;
    }

    private void NextWizardStep()
    {
        _wizardError = null;
        if (_wizardStep == 1)
        {
            if (string.IsNullOrWhiteSpace(_wizardEventName)) { _wizardError = "Please enter an event photoshoot name."; return; }
            if (string.IsNullOrWhiteSpace(_wizardEventLocation)) { _wizardError = "Please specify the venue or location."; return; }
            _wizardStep = 2;
        }
        else if (_wizardStep == 2)
        {
            if (_selectedServiceIds.Count == 0) { _wizardError = "Please select at least one service package."; return; }
            _wizardStep = 3;
        }
        else if (_wizardStep == 3)
        {
            if (_selectedEmployeeIds.Count == 0) { _wizardError = "Please assign at least one staff member."; return; }
            if (string.IsNullOrWhiteSpace(_teamLeaderId) || !_selectedEmployeeIds.Contains(_teamLeaderId))
            {
                _wizardError = "Please explicitly designate a Team Leader from the assigned crew.";
                return;
            }
            _wizardStep = 4;
        }
    }

    private void PrevWizardStep()
    {
        if (_wizardStep > 1) _wizardStep--;
    }

    private void ToggleWizardService(string serviceId, bool isChecked)
    {
        if (isChecked) _selectedServiceIds.Add(serviceId);
        else _selectedServiceIds.Remove(serviceId);
    }

    private void ToggleWizardEmployee(string employeeId, bool isChecked)
    {
        if (isChecked)
        {
            _selectedEmployeeIds.Add(employeeId);
            if (string.IsNullOrWhiteSpace(_teamLeaderId)) _teamLeaderId = employeeId;
        }
        else
        {
            _selectedEmployeeIds.Remove(employeeId);
            if (_teamLeaderId == employeeId) _teamLeaderId = _selectedEmployeeIds.FirstOrDefault() ?? string.Empty;
        }
    }

    private void ToggleWizardEquipment(string equipmentId, bool isChecked)
    {
        if (isChecked) _selectedEquipmentIds.Add(equipmentId);
        else _selectedEquipmentIds.Remove(equipmentId);
    }

    private decimal CalculateWizardTotal()
    {
        return _availableServices
            .Where(s => _selectedServiceIds.Contains(s.ServicesId))
            .Sum(s => s.Price);
    }

    private decimal CalculateWizardDownpayment() => Math.Round(CalculateWizardTotal() * 0.25m, 2);

    private async Task SaveAndExecuteEventAppointmentAsync()
    {
        if (_selectedNegotiation == null) return;
        _submittingWizard = true;
        _wizardError = null;

        try
        {
            var req = new CreateEventAppointmentFromNegotiationRequest
            {
                NegotiationId = _selectedNegotiation.NegotiationId,
                CustomerId = _selectedNegotiation.CustomerId,
                EventName = _wizardEventName,
                EventDescription = _wizardEventDescription,
                EventDate = DateOnly.FromDateTime(_wizardEventDate),
                EventTime = TimeOnly.FromDateTime(_wizardEventTime),
                EventLocation = _wizardEventLocation,
                ServiceIds = _selectedServiceIds.ToList(),
                EmployeeIds = _selectedEmployeeIds.ToList(),
                TeamLeaderEmployeeId = _teamLeaderId,
                EquipmentIds = _selectedEquipmentIds.ToList()
            };

            var res = await ConsultationApi.CreateEventAppointmentAsync(_selectedNegotiation.NegotiationId, req);
            if (res.IsSuccess && res.Value != null)
            {
                _isWizardOpen = false;
                await LoadNegotiationsAsync();
                _selectedNegotiation = _negotiations.FirstOrDefault(n => n.NegotiationId == _selectedNegotiation.NegotiationId);
            }
            else
            {
                _wizardError = res.Error?.Message ?? "Failed to create appointment.";
            }
        }
        catch (Exception ex)
        {
            _wizardError = ex.Message;
        }
        finally
        {
            _submittingWizard = false;
        }
    }

    // ── Simulated Client Inquiry ───────────────────────────────────────────
    private void OpenSimulateInquiryModal()
    {
        _isSimulateModalOpen = true;
    }

    private async Task SubmitSimulatedInquiryAsync()
    {
        _isSimulateModalOpen = false;
        var req = new CreateConsultationRequest
        {
            CustomerId = "CUST-" + Random.Shared.Next(100, 999),
            CustomerName = _simCustomerName,
            CustomerEmail = _simCustomerEmail,
            CustomerPhone = _simCustomerPhone,
            ConsultationDate = DateOnly.FromDateTime(DateTime.Today.AddDays(2)),
            ConsultationTime = new TimeOnly(14, 0),
            InquiryNotes = _simInquiryNotes,
            Platform = "GoogleMeet"
        };

        var res = await ConsultationApi.ScheduleConsultationAsync(req);
        if (res.IsSuccess)
        {
            await LoadNegotiationsAsync();
            if (res.Value != null)
            {
                OpenFloatingPanel(res.Value);
            }
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Pending_Call" => "bg-amber-100 text-amber-800",
        "Deal_Won" => "bg-emerald-100 text-emerald-800",
        "Deal_Lost" => "bg-red-100 text-red-800",
        "Rescheduled" => "bg-blue-100 text-blue-800",
        _ => "bg-slate-100 text-slate-800"
    };
    private bool showToast = false;
    private string toastMessage = string.Empty;

    private async Task DisplayToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();
        await Task.Delay(3500);
        showToast = false;
        StateHasChanged();
    }

}

@if (showToast)
{
    <div class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl border border-slate-700 text-xs font-semibold flex items-center gap-2 animate-in fade-in slide-in-from-bottom-2 duration-200">
        <span class="text-emerald-400 font-bold text-sm">✓</span> @toastMessage
    </div>
}
