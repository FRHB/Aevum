        var res = await ConsultationApi.UpdateNegotiationOutcomeAsync(negotiationId, new UpdateNegotiationOutcomeRequest



        {



            NegotiationStatus = outcome,



            Notes = $"Marked as {outcome} by office clerk on {DateTime.Now:g}."



