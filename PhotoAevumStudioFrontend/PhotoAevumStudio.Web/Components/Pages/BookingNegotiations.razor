    private bool _isPanelOpen = false;



    private ConsultationNegotiationDto? _selectedNegotiation;







    // Wizard State



    private bool _isWizardOpen = false;



    private int _wizardStep = 1;



    private bool _submittingWizard = false;



    private string? _wizardError;







    // Wizard Form Fields



    private string _wizardEventName = string.Empty;



    private string _wizardEventDescription = string.Empty;



    private DateTime _wizardEventDate = DateTime.Today.AddDays(7);



    private DateTime _wizardEventTime = DateTime.Today.AddHours(14);



    private string _wizardEventLocation = string.Empty;



    private HashSet<string> _selectedServiceIds = new();



    private HashSet<string> _selectedEmployeeIds = new();



    private string _teamLeaderId = string.Empty;



    private HashSet<string> _selectedEquipmentIds = new();







    // Catalog Data



    private List<ScheduleServiceOption> _availableServices = new();



    private List<EmployeeViewModel> _availableEmployees = new();



    private List<EquipmentItemModel> _availableEquipment = new();







    // Simulation Modal



    private bool _isSimulateModalOpen = false;



    private string _simCustomerName = "Isabella Cruz";



    private string _simCustomerEmail = "isabella.cruz@example.com";



    private string _simCustomerPhone = "0917-888-9999";



    private string _simInquiryNotes = "Hello, inquiring about outdoor fashion photoshoot & studio editorial rates.";







    protected override async Task OnInitializedAsync()



    {



        if (AuthStateProvider != null)



        {



            var authState = await AuthStateProvider.GetAuthenticationStateAsync();



            var user = authState.User;



            bool isAdmin = EmployeeRoleHelper.IsAdmin(user) || EmployeeRoleHelper.IsSystemAdmin(user);



            bool isClerk = EmployeeRoleHelper.IsOfficeClerk(user, UserService);







            if (!isAdmin && !isClerk)



            {



                // Access restricted to verified Office Clerks and Admins



                Nav.NavigateTo("/staff");



                return;



            }



        }







        await LoadNegotiationsAsync();



        await LoadCatalogDataAsync();



    }







    private async Task LoadNegotiationsAsync()



    {



        _loading = true;



        try



        {



            var res = await ConsultationApi.GetNegotiationsAsync();



            if (res.IsSuccess && res.Value != null)



            {



                _negotiations = res.Value.ToList();



            }



        }



        finally



        {



            _loading = false;



        }



    }







    private async Task LoadCatalogDataAsync()



    {



        try



        {



            var svcRes = await ScheduleApi.GetServicesAsync();



            if (svcRes.IsSuccess && svcRes.Value != null)



            {



                _availableServices = svcRes.Value.ToList();



            }







