    private bool _isRescheduleModalOpen = false;



    private DateTime _rescheduleDate = DateTime.Today.AddDays(1);



    private DateTime _rescheduleTime = DateTime.Today.AddHours(10);



    private string _rescheduleNotes = string.Empty;



    private string? _rescheduleError;



    private bool _submittingReschedule = false;







    private void OpenRescheduleModal()



    {



        if (_selectedNegotiation == null) return;



        _rescheduleDate = _selectedNegotiation.ConsultationDate.ToDateTime(TimeOnly.MinValue);



        if (_rescheduleDate < DateTime.Today) _rescheduleDate = DateTime.Today.AddDays(1);



        _rescheduleTime = DateTime.Today.Add(_selectedNegotiation.ConsultationTime.ToTimeSpan());



        _rescheduleNotes = string.Empty;



        _rescheduleError = null;



        _isRescheduleModalOpen = true;



    }







    private async Task ConfirmRescheduleAsync()



    {



        if (_selectedNegotiation == null) return;



        _submittingReschedule = true;



        _rescheduleError = null;



        try



        {



            var res = await ConsultationApi.UpdateNegotiationOutcomeAsync(_selectedNegotiation.NegotiationId, new UpdateNegotiationOutcomeRequest



            {



                NegotiationStatus = "Rescheduled",



                Notes = string.IsNullOrWhiteSpace(_rescheduleNotes) ? "Consultation rescheduled by office clerk." : _rescheduleNotes,



                NewConsultationDate = DateOnly.FromDateTime(_rescheduleDate),



                NewConsultationTime = TimeOnly.FromDateTime(_rescheduleTime)



            });







            if (res.IsSuccess)



            {



                _isRescheduleModalOpen = false;



                await LoadNegotiationsAsync();



                _selectedNegotiation = _negotiations.FirstOrDefault(n => n.NegotiationId == _selectedNegotiation.NegotiationId);



                await DisplayToast("Consultation rescheduled and notification email dispatched to client.");



            }



            else



            {



                _rescheduleError = res.Error?.Message ?? "Failed to reschedule consultation.";



            }



        }



        catch (Exception ex)



        {



            _rescheduleError = ex.Message;



        }



        finally



        {



            _submittingReschedule = false;



        }



    }







    // ── Wizard Management (5-Step Deal Flow) ────────────────────────────────



    private string _wizardPaymentMethod = "Online Card";



    private string? _wizardCreatedAppointmentId;



    private string? _wizardInvoiceUrl;



    private DateTime _wizardHoldExpiresAt = DateTime.UtcNow.AddMinutes(30);



    private string _wizardPaymentStatus = "Pending";



    private bool _isVerifyingPayment = false;



    private bool _isRequestingExtension = false;



    private System.Threading.Timer? _countdownTimer;







    private void StartCountdownTimer()



    {



        _countdownTimer?.Dispose();



        _countdownTimer = new System.Threading.Timer(async _ =>



        {



            if (_isWizardOpen && _wizardStep == 5)



            {



                await InvokeAsync(StateHasChanged);



            }



        }, null, 1000, 1000);



    }







    private string GetRemainingHoldText()



    {



        var diff = _wizardHoldExpiresAt - DateTime.UtcNow;



        if (diff <= TimeSpan.Zero)



            return "00:00 (Hold expired - please request another payment)";



        return $"{Math.Floor(diff.TotalMinutes):00}:{diff.Seconds:00} remaining";



    }







    private bool IsHoldExpired() => (_wizardHoldExpiresAt - DateTime.UtcNow) <= TimeSpan.Zero;







    private void OpenEventWizard()



    {



        if (_selectedNegotiation == null) return;



        _wizardStep = 1;



        _wizardError = null;



        _wizardEventName = $"{_selectedNegotiation.CustomerName} - Photoshoot Event";



        _wizardEventDescription = _selectedNegotiation.InquiryNotes;



        _wizardEventDate = DateTime.Today.AddDays(7);



        _wizardEventTime = DateTime.Today.AddHours(14);



        _wizardEventLocation = "Studio A (Main Hall)";



        _wizardPaymentMethod = "Online Card";



        _wizardCreatedAppointmentId = null;



        _wizardInvoiceUrl = null;



        _wizardHoldExpiresAt = DateTime.UtcNow.AddMinutes(30);



        _wizardPaymentStatus = "Pending";



        _selectedServiceIds.Clear();



        _selectedEmployeeIds.Clear();



        _teamLeaderId = string.Empty;



        _selectedEquipmentIds.Clear();







        // Pre-select first service



        if (_availableServices.Count > 0)



        {



            _selectedServiceIds.Add(_availableServices[0].ServicesId);



        }







        // Auto pre-select active creative crew



        if (_availableEmployees.Count > 0)



        {



            _selectedEmployeeIds.Add(_availableEmployees[0].EmployeeId);



            _teamLeaderId = _availableEmployees[0].EmployeeId;



        }







        // Auto pre-select essential equipment



        foreach (var eq in _availableEquipment.Take(3))



        {



            _selectedEquipmentIds.Add(eq.EquipmentID);



        }







        StartCountdownTimer();



        _isWizardOpen = true;



    }







    private void CloseEventWizard()



    {



        _isWizardOpen = false;



        _countdownTimer?.Dispose();



    }







    private void NextWizardStep()



    {



        _wizardError = null;



        if (_wizardStep == 1)



        {



            if (_selectedServiceIds.Count == 0) { _wizardError = "Please select at least one service package."; return; }



            if (string.IsNullOrWhiteSpace(_wizardEventName)) { _wizardError = "Please enter an event photoshoot name."; return; }



            if (string.IsNullOrWhiteSpace(_wizardEventLocation)) { _wizardError = "Please specify the venue or location."; return; }



            _wizardStep = 2;



        }



        else if (_wizardStep == 3)



        {



            if (_selectedEmployeeIds.Count == 0) { _wizardError = "Please assign at least one staff member."; return; }



            if (string.IsNullOrWhiteSpace(_teamLeaderId) || !_selectedEmployeeIds.Contains(_teamLeaderId))



            {



                _wizardError = "Please explicitly designate a Team Leader from the assigned crew.";



                return;



            }



            _wizardStep = 4;



        }



    }







    private void PrevWizardStep()



    {



        if (_wizardStep > 1 && _wizardStep < 5) _wizardStep--;



    }







    private async Task Step2ProceedAndSendEmailAsync()



    {



        if (_selectedNegotiation == null) return;



        _wizardError = null;







        if (string.IsNullOrWhiteSpace(_wizardPaymentMethod))



        {



            _wizardError = "Please select a payment method (Online Card or QR Ph).";



            return;



        }







        _submittingWizard = true;



        try



        {



            var req = new CreateEventAppointmentFromNegotiationRequest



            {



                NegotiationId = _selectedNegotiation.NegotiationId,



                CustomerId = _selectedNegotiation.CustomerId,



                EventName = _wizardEventName,



                EventDescription = _wizardEventDescription,



                EventDate = DateOnly.FromDateTime(_wizardEventDate),



                EventTime = TimeOnly.FromDateTime(_wizardEventTime),



                EventLocation = _wizardEventLocation,



                ServiceIds = _selectedServiceIds.ToList(),



                EmployeeIds = _selectedEmployeeIds.ToList(),



                TeamLeaderEmployeeId = _teamLeaderId,



                EquipmentIds = _selectedEquipmentIds.ToList()



            };







            var res = await ConsultationApi.CreateEventAppointmentAsync(_selectedNegotiation.NegotiationId, req);



            if (res.IsSuccess && res.Value != null)



            {



                _wizardCreatedAppointmentId = res.Value.EventAppointmentId;



                _wizardInvoiceUrl = res.Value.XenditInvoiceUrl;



                _wizardHoldExpiresAt = res.Value.HoldExpiresAt ?? DateTime.UtcNow.AddMinutes(30);



                _wizardPaymentStatus = res.Value.DownpaymentStatus;



                await DisplayToast("Reservation invoice generated & payment email dispatched to customer.");



                _wizardStep = 3;



            }



            else



            {



                _wizardError = res.Error?.Message ?? "Failed to create appointment & send payment email.";



            }



        }



        catch (Exception ex)



        {



            _wizardError = ex.Message;



        }



        finally



        {



            _submittingWizard = false;



        }



    }







    private async Task Step4ProceedToPaymentStatusAsync()



    {



        _wizardError = null;



        _submittingWizard = true;







        try



        {



            if (!string.IsNullOrWhiteSpace(_wizardCreatedAppointmentId))



            {



                var rosterReq = new UpdateAppointmentRosterRequest



                {



                    EmployeeIds = _selectedEmployeeIds.ToList(),



                    TeamLeaderEmployeeId = _teamLeaderId,



                    EquipmentIds = _selectedEquipmentIds.ToList()



                };







                await ConsultationApi.UpdateAppointmentRosterAsync(_wizardCreatedAppointmentId, rosterReq);







                // Check live payment status



                var verifyRes = await ConsultationApi.VerifyDownpaymentAsync(_wizardCreatedAppointmentId);



                if (verifyRes.IsSuccess && verifyRes.Value != null)



                {



                    _wizardPaymentStatus = verifyRes.Value.DownpaymentStatus;



                }



            }







            _wizardStep = 5;



        }



        catch (Exception ex)



        {



            _wizardError = ex.Message;



        }



        finally



        {



            _submittingWizard = false;



        }



    }







    private bool _isSimulatingWebhook = false;



    private string GetWizardCheckoutUrl()
    {
        if (string.IsNullOrWhiteSpace(_wizardInvoiceUrl))
            return !string.IsNullOrWhiteSpace(_wizardCreatedAppointmentId) ? $"/checkout/simulate/{_wizardCreatedAppointmentId}" : "#";
        if (_wizardInvoiceUrl.Contains("mock", StringComparison.OrdinalIgnoreCase) ||
            _wizardInvoiceUrl.Contains("inv_mock_", StringComparison.OrdinalIgnoreCase))
        {
            return !string.IsNullOrWhiteSpace(_wizardCreatedAppointmentId) ? $"/checkout/simulate/{_wizardCreatedAppointmentId}" : _wizardInvoiceUrl;
        }
        return _wizardInvoiceUrl;
    }

    private async Task SimulateWebhookPaymentAsync()

    {

        if (string.IsNullOrWhiteSpace(_wizardCreatedAppointmentId)) return;

        _isSimulatingWebhook = true;

        try

        {

            var res = await ConsultationApi.SimulateWebhookPaymentAsync(_wizardCreatedAppointmentId, _wizardPaymentMethod);

            if (res.IsSuccess && res.Value != null)

            {

                _wizardPaymentStatus = res.Value.DownpaymentStatus;

                await DisplayToast("✓ Simulated Xendit Webhook received! Reservation deposit verified & email sent to customer.");

            }

            else

            {

                await DisplayToast(res.Error?.Message ?? "Could not simulate webhook payment.");

            }

        }

        catch (Exception ex)

        {

            await DisplayToast($"Error: {ex.Message}");

        }

        finally

        {

            _isSimulatingWebhook = false;

        }

    }



    private async Task VerifyWizardPaymentAsync()



    {



        if (string.IsNullOrWhiteSpace(_wizardCreatedAppointmentId)) return;



        _isVerifyingPayment = true;



        try



        {



            var res = await ConsultationApi.VerifyDownpaymentAsync(_wizardCreatedAppointmentId);



            if (res.IsSuccess && res.Value != null)



            {



                _wizardPaymentStatus = res.Value.DownpaymentStatus;



                if (_wizardPaymentStatus == "Paid" || _wizardPaymentStatus == "Confirmed")



                {



                    await DisplayToast("Payment verified! Reservation fee is marked as PAID.");



                }



                else



                {



                    await DisplayToast("Payment is still pending. Client has not yet settled the fee.");



                }



            }



            else



            {



                await DisplayToast("Could not verify payment status at this time.");



            }



        }



        catch (Exception ex)



        {



            await DisplayToast($"Error verifying payment: {ex.Message}");



        }



        finally



        {



            _isVerifyingPayment = false;



        }



    }







    private async Task AskAnotherPaymentAsync()



    {



        if (string.IsNullOrWhiteSpace(_wizardCreatedAppointmentId)) return;



        _isRequestingExtension = true;



        try



        {



            var res = await ConsultationApi.RequestExtensionAsync(_wizardCreatedAppointmentId);



            if (res.IsSuccess)



            {



                _wizardHoldExpiresAt = DateTime.UtcNow.AddMinutes(30);



                await DisplayToast("Hold extended by 30 minutes and payment notification re-sent to client.");



            }



            else



            {



                await DisplayToast(res.Error?.Message ?? "Failed to re-send payment request.");



            }



        }



        catch (Exception ex)



        {



            await DisplayToast($"Error: {ex.Message}");



        }



        finally



        {



            _isRequestingExtension = false;



        }



    }







    private async Task FinalizeBookingAsync()



    {



        if (_wizardPaymentStatus != "Paid" && _wizardPaymentStatus != "Confirmed")



        {



            _wizardError = "The event appointment cannot be confirmed until the reservation fee is paid.";



            return;



        }







        _isWizardOpen = false;



        _countdownTimer?.Dispose();



        await LoadNegotiationsAsync();



        if (_selectedNegotiation != null)



        {



            _selectedNegotiation = _negotiations.FirstOrDefault(n => n.NegotiationId == _selectedNegotiation.NegotiationId);



        }



        await DisplayToast("Event photoshoot confirmed and booked successfully!");



    }







    public void Dispose()



    {



        _countdownTimer?.Dispose();



    }







    private void ToggleWizardService(string serviceId, bool isChecked)



    {



        if (isChecked) _selectedServiceIds.Add(serviceId);



        else _selectedServiceIds.Remove(serviceId);



    }







    private void ToggleWizardEmployee(string employeeId, bool isChecked)



    {



        if (isChecked)



        {



            _selectedEmployeeIds.Add(employeeId);



            if (string.IsNullOrWhiteSpace(_teamLeaderId)) _teamLeaderId = employeeId;



        }



        else



        {



            _selectedEmployeeIds.Remove(employeeId);



            if (_teamLeaderId == employeeId) _teamLeaderId = _selectedEmployeeIds.FirstOrDefault() ?? string.Empty;



        }



    }







    private void ToggleWizardEquipment(string equipmentId, bool isChecked)



    {



        if (isChecked) _selectedEquipmentIds.Add(equipmentId);



        else _selectedEquipmentIds.Remove(equipmentId);



    }







    private decimal CalculateWizardTotal()



    {



        return _availableServices



            .Where(s => _selectedServiceIds.Contains(s.ServicesId))



            .Sum(s => s.Price);



    }







    private decimal CalculateWizardDownpayment() => Math.Round(CalculateWizardTotal() * 0.15m, 2);







