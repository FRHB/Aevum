@page "/admin/services/additional"
@page "/additional-services"
@page "/services/additional"
@layout AdminLayout
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Models

<PageTitle>Additional Services | Photo Aevum Studio</PageTitle>

<div class="space-y-6">
    <!-- Page Header & Action Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">
                <span>Services Module</span>
                <span>/</span>
                <span class="text-gray-900">Additional Services</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Additional Services</h1>
            <p class="text-sm text-gray-500 mt-1">
                Add-ons, expedited delivery, extra retouching, and custom framing.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button"
                    @onclick="OpenCreateModal"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-900 hover:bg-black text-white text-sm font-semibold rounded-lg shadow-sm hover:shadow transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                <span>Add New Add-On</span>
            </button>
        </div>
    </div>

    <!-- Notification Banner for Newly Added Add-On -->
    @if (!string.IsNullOrWhiteSpace(notificationMessage))
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl flex items-center justify-between shadow-xs animate-in fade-in duration-200">
            <div class="flex items-center gap-3">
                <span class="w-7 h-7 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                </span>
                <div>
                    <p class="text-xs font-bold text-emerald-950">Add-On Catalog Updated</p>
                    <p class="text-xs text-emerald-800">@notificationMessage</p>
                </div>
            </div>
            <button type="button" @onclick="() => notificationMessage = null" class="text-emerald-700 hover:text-emerald-950 p-1 text-sm font-bold">&times;</button>
        </div>
    }

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Add-Ons</span>
                <span class="p-1.5 rounded-lg bg-gray-100 text-gray-700">🏷️</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">@addOns.Count</p>
            <p class="text-[11px] text-gray-400 mt-0.5">Available extra items</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Top Attach Rate</span>
                <span class="p-1.5 rounded-lg bg-blue-50 text-blue-700">⚡</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">Express Editing</p>
            <p class="text-[11px] text-gray-400 mt-0.5">75% booking attachment</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Rental Items</span>
                <span class="p-1.5 rounded-lg bg-purple-50 text-purple-700">📦</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">4</p>
            <p class="text-[11px] text-gray-400 mt-0.5">Active wardrobe &amp; props</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Add-On Revenue</span>
                <span class="p-1.5 rounded-lg bg-emerald-50 text-emerald-700">📊</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">$3,450</p>
            <p class="text-[11px] text-gray-400 mt-0.5">Total add-on sales</p>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs space-y-3">
        <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">

            <!-- Search Bar -->
            <div class="relative flex-1 min-w-[240px]">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input type="text"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       placeholder="Search add-ons by title, SKU, or category..."
                       class="w-full pl-10 pr-10 py-2.5 text-sm bg-gray-50/70 border border-gray-200 rounded-lg text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent transition-all" />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button type="button"
                            @onclick="() => searchQuery = string.Empty"
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-700">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                }
            </div>

            @if (IsFiltered)
            {
                <button type="button"
                        @onclick="ResetFilters"
                        class="px-3 py-2.5 text-xs font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors whitespace-nowrap">
                    Reset Filters
                </button>
            }
        </div>

        <!-- Quick Filter Pills -->
        <div class="pt-2 border-t border-gray-100 flex items-center gap-2 flex-wrap">
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mr-1">Quick Filter:</span>
            <button type="button"
                    @onclick='() => selectedQuickFilter = "ALL"'
                    class="px-2.5 py-1 rounded-full text-xs font-medium transition-all @(selectedQuickFilter == "ALL" ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                All (@addOns.Count)
            </button>
            @foreach (var cat in categoryFilters)
            {
                var isSelected = selectedQuickFilter.Equals(cat.Name, StringComparison.OrdinalIgnoreCase);
                var classes = SpecializationColorHelper.GetClasses(cat.ColorTag);
                var count = addOns.Count(a => a.FilterCategory.Equals(cat.Name, StringComparison.OrdinalIgnoreCase));

                <button type="button"
                        @onclick="() => FilterByTag(cat.Name)"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border transition-all duration-150 @(isSelected ? "ring-2 ring-gray-900 border-gray-900 font-bold" : "hover:opacity-80") @classes.BadgeClass">
                    <span class="w-1.5 h-1.5 rounded-full @classes.DotClass"></span>
                    <span>@cat.Name</span>
                    <span class="text-[10px] opacity-75 font-semibold">(@count)</span>
                </button>
            }
        </div>
    </div>

    <!-- Data Table: Additional Services -->
    <div class="bg-white rounded-xl shadow-xs border border-gray-200 overflow-hidden">

        <!-- Table Metadata Bar -->
        <div class="px-6 py-3.5 bg-gray-50/50 border-b border-gray-200 flex items-center justify-between text-xs text-gray-500 font-medium">
            <div>
                Showing <span class="font-bold text-gray-900">@FilteredAddOns.Count()</span> of <span class="font-bold text-gray-900">@addOns.Count</span> additional services
            </div>
            @if (IsFiltered)
            {
                <span class="inline-flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[11px] font-semibold">
                    <span>Active Filters Applied</span>
                </span>
            }
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/80 border-b border-gray-200 text-[11px] font-semibold uppercase tracking-wider text-gray-500">
                        <th scope="col" class="py-3.5 px-6">Add-On Service</th>
                        <th scope="col" class="py-3.5 px-6">Type &amp; Price</th>
                        <th scope="col" class="py-3.5 px-6">Compatible Services</th>
                        <th scope="col" class="py-3.5 px-6">Status</th>
                        <th scope="col" class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (FilteredAddOns.Any())
                    {
                        @foreach (var addon in FilteredAddOns)
                        {
                            <tr class="hover:bg-gray-50/60 transition-colors duration-100">

                                <!-- Add-On Name & Code -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gray-900 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-xs">
                                            AS
                                        </div>
                                        <div>
                                            <div class="font-semibold text-gray-900">@addon.Title</div>
                                            <div class="font-mono text-[11px] text-gray-400">@addon.Code</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Type & Price -->
                                <td class="py-4 px-6">
                                    <div class="text-xs text-gray-700 font-medium">@addon.TypeCategory</div>
                                    <div class="text-[11px] text-gray-400 mt-0.5">+@addon.PriceText</div>
                                </td>

                                <!-- Compatible Services (Color Chips) -->
                                <td class="py-4 px-6">
                                    <div class="flex flex-wrap gap-1.5 max-w-md">
                                        @foreach (var compatible in addon.CompatibleServices)
                                        {
                                            var classes = SpecializationColorHelper.GetClasses(compatible.ColorTag);
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border @classes.BadgeClass shadow-2xs">
                                                <span class="w-1.5 h-1.5 rounded-full @classes.DotClass"></span>
                                                @compatible.Label
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="py-4 px-6">
                                    @if (addon.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 border border-gray-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                            @addon.Status
                                        </span>
                                    }
                                </td>

                                <!-- Action Link -->
                                <td class="py-4 px-6 text-right">
                                    <a href="#" class="text-xs font-semibold text-gray-600 hover:text-gray-900 hover:underline">
                                        Edit Add-On &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Empty Results State -->
                        <tr>
                            <td colspan="5" class="py-12 px-6 text-center">
                                <div class="max-w-sm mx-auto space-y-3">
                                    <div class="w-12 h-12 mx-auto rounded-full bg-gray-100 text-gray-400 flex items-center justify-center">
                                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    </div>
                                    <h4 class="text-sm font-bold text-gray-900">No matching add-ons found</h4>
                                    <p class="text-xs text-gray-500 leading-relaxed">
                                        No add-on services matched the search term <span class="font-semibold text-gray-700">"@searchQuery"</span>
                                        @(selectedQuickFilter != "ALL" ? $" or category \"{selectedQuickFilter}\"" : "").
                                    </p>
                                    <button type="button" @onclick="ResetFilters"
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                                        Reset Search &amp; Filters
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Add-On Multi-Step Modal -->
<AddAddOnModal @bind-IsOpen="isCreateModalOpen" OnAddOnCreated="HandleAddOnCreated" />

@code {
    private bool isCreateModalOpen = false;
    private string? notificationMessage;

    private string searchQuery = string.Empty;
    private string selectedQuickFilter = "ALL";

    private bool IsFiltered =>
        !string.IsNullOrWhiteSpace(searchQuery) ||
        selectedQuickFilter != "ALL";

    private record CategoryFilter(string Name, string ColorTag);

    private readonly List<CategoryFilter> categoryFilters = new()
    {
        new("Expedited Delivery", "Rose"),
        new("Extra Retouching", "Emerald"),
        new("Framing & Prints", "Amber"),
        new("Equipment & Props", "Blue")
    };

    private List<AddOnServiceItem> addOns = new();

    private void OpenCreateModal()
    {
        isCreateModalOpen = true;
    }

    private void HandleAddOnCreated(AddOnServiceItem newItem)
    {
        addOns.Insert(0, newItem);
        notificationMessage = $"Add-On \"{newItem.Title}\" ({newItem.Code}) has been successfully added to the catalog.";
    }

    protected override void OnInitialized()
    {
        addOns = new List<AddOnServiceItem>
        {
            new()
            {
                Code = "AS-101", Title = "Express 24-Hour Delivery",
                TypeCategory = "Post-Processing", PriceText = "$50.00 / session",
                FilterCategory = "Expedited Delivery",
                CompatibleServices = new() { ("Portrait Specialist", "Blue"), ("Lead Retoucher", "Emerald") }
            },
            new()
            {
                Code = "AS-102", Title = "Rush 48-Hour Turnaround",
                TypeCategory = "Post-Processing", PriceText = "$35.00 / session",
                FilterCategory = "Expedited Delivery",
                CompatibleServices = new() { ("Commercial", "Purple") }
            },
            new()
            {
                Code = "AS-103", Title = "Same-Day Preview Gallery",
                TypeCategory = "Post-Processing", PriceText = "$25.00 / session",
                FilterCategory = "Expedited Delivery",
                CompatibleServices = new() { ("Event & Wedding", "Rose") }
            },
            new()
            {
                Code = "AS-201", Title = "Advanced Skin Retouching",
                TypeCategory = "Retouching", PriceText = "$15.00 / photo",
                FilterCategory = "Extra Retouching",
                CompatibleServices = new() { ("Portrait Specialist", "Blue") }
            },
            new()
            {
                Code = "AS-202", Title = "Background Replacement",
                TypeCategory = "Retouching", PriceText = "$20.00 / photo",
                FilterCategory = "Extra Retouching",
                CompatibleServices = new() { ("Product", "Amber") }
            },
            new()
            {
                Code = "AS-203", Title = "Composite Editing",
                TypeCategory = "Retouching", PriceText = "$40.00 / photo",
                FilterCategory = "Extra Retouching",
                CompatibleServices = new() { ("Commercial", "Purple"), ("Portrait Specialist", "Blue") }
            },
            new()
            {
                Code = "AS-301", Title = "Canvas Print 16x20",
                TypeCategory = "Print & Frame", PriceText = "$85.00 / unit",
                FilterCategory = "Framing & Prints",
                CompatibleServices = new() { ("Portrait Specialist", "Blue") }
            },
            new()
            {
                Code = "AS-302", Title = "Gallery Wrap 24x36",
                TypeCategory = "Print & Frame", PriceText = "$120.00 / unit",
                FilterCategory = "Framing & Prints",
                CompatibleServices = new() { ("Event & Wedding", "Rose") }
            },
            new()
            {
                Code = "AS-303", Title = "Custom Wood Frame",
                TypeCategory = "Print & Frame", PriceText = "$95.00 / unit",
                FilterCategory = "Framing & Prints",
                CompatibleServices = new() { ("Portrait Specialist", "Blue"), ("Commercial", "Purple") }
            },
            new()
            {
                Code = "AS-304", Title = "Metal Print 20x30",
                TypeCategory = "Print & Frame", PriceText = "$150.00 / unit",
                FilterCategory = "Framing & Prints",
                CompatibleServices = new() { ("Commercial", "Purple") }
            },
            new()
            {
                Code = "AS-401", Title = "Studio Wardrobe Rental",
                TypeCategory = "Equipment", PriceText = "$30.00 / session",
                FilterCategory = "Equipment & Props",
                CompatibleServices = new() { ("Portrait Specialist", "Blue"), ("Event & Wedding", "Rose") }
            },
            new()
            {
                Code = "AS-402", Title = "Props & Set Pieces",
                TypeCategory = "Equipment", PriceText = "$25.00 / session",
                FilterCategory = "Equipment & Props",
                CompatibleServices = new() { ("Product", "Amber"), ("Commercial", "Purple") }
            }
        };
    }

    private IEnumerable<AddOnServiceItem> FilteredAddOns
    {
        get
        {
            var result = addOns.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                result = result.Where(a =>
                    a.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    a.Code.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    a.TypeCategory.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            if (selectedQuickFilter != "ALL")
            {
                result = result.Where(a => a.FilterCategory.Equals(selectedQuickFilter, StringComparison.OrdinalIgnoreCase));
            }

            return result;
        }
    }

    private void FilterByTag(string tagName)
    {
        if (selectedQuickFilter.Equals(tagName, StringComparison.OrdinalIgnoreCase))
        {
            selectedQuickFilter = "ALL";
        }
        else
        {
            selectedQuickFilter = tagName;
        }
    }

    private void ResetFilters()
    {
        searchQuery = string.Empty;
        selectedQuickFilter = "ALL";
    }
}
