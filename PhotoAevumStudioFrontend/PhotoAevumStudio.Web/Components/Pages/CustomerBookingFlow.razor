@page "/my/book"
@page "/book"
@page "/schedule"
@layout CustomerLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Customer")]
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using PhotoAevumStudio.Web.Components.Shared
@inject IBookScheduleClient Api
@inject BookScheduleState Wizard
@inject BookingEvents Events

<PageTitle>Schedule Your Session | Photo Aevum Studio</PageTitle>

<div class="booking-wizard-container">
    <div class="booking-header">
        <span class="booking-subtitle-chip">Online Scheduling</span>
        <h1 class="booking-title">Book a Studio Session</h1>
        <p class="booking-description">
            Choose your services, pick an available slot, add your event details, and set up your online session.
        </p>

        @if (_result is null)
        {
            <div class="stepper-bar" role="tablist">
                @for (var n = 1; n <= BookScheduleState.LastStep; n++)
                {
                    var step = n;
                    <button type="button"
                            class="step-item @(Wizard.Step == step ? "is-active" : (Wizard.Step > step ? "is-completed" : ""))"
                            disabled="@(step > Wizard.Step || _busy)"
                            @onclick="() => GoBackToAsync(step)">
                        <span class="step-num">@(Wizard.Step > step ? "✓" : step.ToString())</span>
                        <span class="step-label">@StepLabels[step - 1]</span>
                    </button>
                    @if (step < BookScheduleState.LastStep)
                    {
                        <div class="step-divider @(Wizard.Step > step ? "is-completed" : "")"></div>
                    }
                }
            </div>
        }
    </div>

    @if (_error is not null)
    {
        <div class="booking-alert" role="alert">@_error</div>
    }

    @if (_result is not null)
    {
        @* ── Confirmation ─────────────────────────────────────────── *@
        <div class="confirmation-card">
            <div class="confirmation-icon">✨</div>
            <h2 class="confirmation-title">Session Scheduled!</h2>
            <p class="confirmation-lead">Your booking <strong>#@_result.AppointmentId</strong> is confirmed.</p>
            <div class="confirmation-details">
                <div class="detail-row"><span class="detail-label">Services:</span><span class="detail-val">@string.Join(", ", _result.Services.Select(s => s.Name))</span></div>
                <div class="detail-row"><span class="detail-label">Date:</span><span class="detail-val">@_result.Date.ToString("dddd, MMMM d, yyyy")</span></div>
                <div class="detail-row"><span class="detail-label">Time:</span><span class="detail-val">@FormatRange(_result.SlotStart, _result.SlotEnd)</span></div>
                @if (!string.IsNullOrWhiteSpace(_result.EventLocation))
                {
                    <div class="detail-row"><span class="detail-label">Venue:</span><span class="detail-val">@_result.EventLocation</span></div>
                }
                <div class="detail-row"><span class="detail-label">Teleconference:</span><span class="detail-val">@MeetingPlatformInfo.Label(_result.Platform)</span></div>
                <div class="detail-row">
                    <span class="detail-label">Session link:</span>
                    <span class="detail-val">
                        @if (IsHttpUrl(_result.MeetingLink))
                        {
                            <a href="@_result.MeetingLink" target="_blank" rel="noopener noreferrer">Join session</a>
                        }
                        else
                        {
                            @_result.MeetingLink
                        }
                    </span>
                </div>
                <div class="detail-row"><span class="detail-label">Total Package:</span><span class="detail-val">₱@_result.TotalPrice.ToString("N2")</span></div>
                <div class="detail-row"><span class="detail-label">15% Reservation Deposit:</span><span class="detail-val" style="color:#047857; font-weight:700;">₱@_result.DepositFee.ToString("N2")</span></div>
                <div class="detail-row"><span class="detail-label">Remaining Balance (85%):</span><span class="detail-val">₱@_result.BalanceFee.ToString("N2")</span></div>
                <div class="detail-row"><span class="detail-label">Payment Status:</span><span class="detail-val"><span style="background:#dcfce7; color:#15803d; font-weight:700; padding:2px 8px; border-radius:12px; font-size:12px;">Paid / Cleared</span></span></div>
            </div>
            <p class="calendar-hint">
                @(_result.ConfirmationEmailSent
                    ? "A confirmation email with your summary and session link is on its way."
                    : "Your booking is saved, but we couldn't send the confirmation email. Your session link is shown above and in My Bookings.")
            </p>
            <div class="wizard-footer" style="justify-content:center; gap:.75rem;">
                <a href="/my/bookings" class="btn btn-outline-dark">View My Bookings</a>
                <button type="button" class="btn btn-dark" @onclick="BookAnotherAsync">Book Another Session</button>
            </div>
        </div>
    }
    else if (_loadingServices)
    {
        <div class="wizard-panel"><p class="calendar-hint">Loading studio services…</p></div>
    }
    else if (Wizard.Step < 5)
    {
        @* ── Steps 1–4: full width, no Booking Summary ────────────── *@
        <div class="booking-main-col booking-main-col--full">

            @if (Wizard.Step == 1)
            {
                <div class="wizard-panel">
                    <div class="panel-header">
                        <h2>1. Select Services</h2>
                        <p>Choose one or more services or packages for your session.</p>
                    </div>

                    @if (_services.Count == 0)
                    {
                        <p class="calendar-hint">No studio services are currently available.</p>
                    }
                    else
                    {
                        <div class="service-cards-stack">
                            @foreach (var svc in _services)
                            {
                                var id = svc.ServicesId;
                                var selected = Wizard.ServiceIds.Contains(id);
                                <div class="service-card @(selected ? "is-selected" : "")"
                                     role="checkbox" aria-checked="@selected" tabindex="0"
                                     @onclick="() => ToggleService(id)"
                                     @onkeydown="e => OnServiceKey(e, id)">
                                    <div class="service-card__left">
                                        <div class="addon-checkbox @(selected ? "is-active" : "")">@(selected ? "✓" : "")</div>
                                        <div>
                                            <span class="service-title">@svc.Name</span>
                                            <p class="service-desc">@svc.Description</p>
                                        </div>
                                    </div>
                                    <div class="service-card__right">
                                        <div class="service-price">₱@svc.Price.ToString("N2")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="wizard-footer">
                        <span class="calendar-hint">@Wizard.ServiceIds.Count selected</span>
                        <button type="button" class="btn btn-dark btn-lg" disabled="@(Wizard.ServiceIds.Count == 0 || _busy)" @onclick="NextAsync">
                            Next: Date &amp; Time →
                        </button>
                    </div>
                </div>
            }
            else if (Wizard.Step == 2)
            {
                <div class="wizard-panel" data-testid="step2-datetime">
                    <div class="panel-header">
                        <h2>2. Pick a Date &amp; Time</h2>
                        <p>Highlighted dates have open slots. Morning: 9:00 AM – 11:00 AM. Afternoon: 1:00 PM – 5:00 PM.</p>
                    </div>

                    <div class="date-time-picker-grid">
                        <!-- Calendar Column (Left Side) -->
                        <div class="date-col">
                            <div class="calendar-card">
                                <div class="calendar-nav">
                                    <button type="button" class="btn btn-outline-dark" aria-label="Previous month"
                                            disabled="@(!CanGoPrevMonth || _loadingMonth)" @onclick="PrevMonthAsync">
                                        ‹
                                    </button>
                                    <strong>@Wizard.VisibleMonth.ToString("MMMM yyyy")</strong>
                                    <button type="button" class="btn btn-outline-dark" aria-label="Next month"
                                            disabled="@_loadingMonth" @onclick="NextMonthAsync">
                                        ›
                                    </button>
                                </div>
                                <div class="calendar-weekdays">
                                    @foreach (var d in WeekdayNames)
                                    {
                                        <span>@d</span>
                                    }
                                </div>
                                @if (_loadingMonth)
                                {
                                    <div class="py-8">
                                        <LoadingSpinner Message="Checking month availability…" />
                                    </div>
                                }
                                else if (_month is not null)
                                {
                                    <div class="calendar-grid">
                                        @for (var i = 0; i < (int)Wizard.VisibleMonth.DayOfWeek; i++)
                                        {
                                            <span class="calendar-cell calendar-cell--blank"></span>
                                        }
                                        @foreach (var day in _month.Days)
                                        {
                                            var date = day.Date;
                                            var dateTime = date.ToDateTime(TimeOnly.MinValue);
                                            var isSelected = bookingModel.SelectedDate.HasValue &&
                                                             DateOnly.FromDateTime(bookingModel.SelectedDate.Value) == date;
                                            var available = IsDateAvailable(date);

                                            @if (available)
                                            {
                                                <button type="button"
                                                        class="calendar-cell is-available @(isSelected ? "is-selected" : "")"
                                                        @onclick="() => SelectDate(dateTime)"
                                                        aria-label="@date.ToString("MMMM d, yyyy") - Available">
                                                    @date.Day
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="calendar-cell is-disabled is-unavailable"
                                                      style="pointer-events: none; opacity: 0.4;"
                                                      aria-disabled="true"
                                                      aria-label="@date.ToString("MMMM d, yyyy") - Unavailable">
                                                    @date.Day
                                                </span>
                                            }
                                        }
                                    </div>
                                    <p class="mt-3 text-[11px] text-gray-500 flex items-center gap-2">
                                        <span class="inline-block w-2.5 h-2.5 rounded bg-emerald-100 border border-emerald-400"></span>
                                        Green highlighted dates have open slots.
                                    </p>
                                }
                            </div>
                        </div>

                        <!-- Time Slot Selection Panel (Right Side) -->
                        <div class="time-col">
                            @if (!bookingModel.SelectedDate.HasValue)
                            {
                                <div class="empty-selection-placeholder">
                                    <EmptyState Title="Select a Date" Description="Select a highlighted date on the calendar to view morning and afternoon open slots." />
                                </div>
                            }
                            else if (_loadingSlots)
                            {
                                <div class="py-12">
                                    <LoadingSpinner Message="Fetching open time slots for selected date…" />
                                </div>
                            }
                            else
                            {
                                var dateOnly = DateOnly.FromDateTime(bookingModel.SelectedDate.Value);
                                var morningSlots = _selectedDaySlots.Where(s => SessionWindows.IsMorning(s.Start, s.End)).ToList();
                                var afternoonSlots = _selectedDaySlots.Where(s => SessionWindows.IsAfternoon(s.Start, s.End)).ToList();
                                var totalAvailable = morningSlots.Count(s => s.IsAvailable) + afternoonSlots.Count(s => s.IsAvailable);

                                <div class="flex items-center justify-between mb-3">
                                    <label class="picker-label mb-0">Available times for @dateOnly.ToString("dddd, MMMM d, yyyy")</label>
                                    @if (bookingModel.SelectedTimeSlot.HasValue)
                                    {
                                        <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
                                            ✓ Selected: @DateTime.Today.Add(bookingModel.SelectedTimeSlot.Value).ToString("h:mm tt")
                                        </span>
                                    }
                                </div>

                                @if (totalAvailable == 0)
                                {
                                    <EmptyState Title="No Available Slots" Description="No available slots for this date. Please pick another highlighted day." />
                                }
                                else
                                {
                                    @if (morningSlots.Count > 0)
                                    {
                                        <span class="slot-group-header">Morning Sessions (9:00 AM – 11:00 AM)</span>
                                        <div class="slots-grid mb-4">
                                            @foreach (var s in morningSlots)
                                            {
                                                var slot = s;
                                                var slotTimeSpan = slot.Start.ToTimeSpan();
                                                var isChosen = bookingModel.SelectedTimeSlot == slotTimeSpan;
                                                var status = isChosen ? "Selected" : (slot.IsAvailable ? "Available" : "Booked");

                                                <button type="button"
                                                        disabled="@(!slot.IsAvailable)"
                                                        @onclick="() => SelectTimeSlot(slot)"
                                                        class="slot-btn @(isChosen ? "is-selected" : "") @(!slot.IsAvailable ? "is-booked" : "")"
                                                        aria-pressed="@isChosen">
                                                    <span class="slot-time">@slot.Start.ToString("h:mm tt") – @slot.End.ToString("h:mm tt")</span>
                                                    <span class="slot-status-badge @(isChosen ? "badge-selected" : slot.IsAvailable ? "badge-available" : "badge-booked")">
                                                        @status
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    }

                                    @if (afternoonSlots.Count > 0)
                                    {
                                        <span class="slot-group-header slot-group-header--spaced">Afternoon Sessions (1:00 PM – 5:00 PM)</span>
                                        <div class="slots-grid">
                                            @foreach (var s in afternoonSlots)
                                            {
                                                var slot = s;
                                                var slotTimeSpan = slot.Start.ToTimeSpan();
                                                var isChosen = bookingModel.SelectedTimeSlot == slotTimeSpan;
                                                var status = isChosen ? "Selected" : (slot.IsAvailable ? "Available" : "Booked");

                                                <button type="button"
                                                        disabled="@(!slot.IsAvailable)"
                                                        @onclick="() => SelectTimeSlot(slot)"
                                                        class="slot-btn @(isChosen ? "is-selected" : "") @(!slot.IsAvailable ? "is-booked" : "")"
                                                        aria-pressed="@isChosen">
                                                    <span class="slot-time">@slot.Start.ToString("h:mm tt") – @slot.End.ToString("h:mm tt")</span>
                                                    <span class="slot-status-badge @(isChosen ? "badge-selected" : slot.IsAvailable ? "badge-available" : "badge-booked")">
                                                        @status
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>

                    <div class="wizard-footer">
                        <button type="button" class="btn btn-outline-dark" @onclick="BackAsync">← Back</button>
                        <button type="button"
                                id="btnNextToEventDetails"
                                class="btn btn-dark btn-lg"
                                disabled="@(!CanProceedToStep3())"
                                @onclick="NextAsync">
                            Next: Event Details →
                        </button>
                    </div>
                </div>
            }
            else if (Wizard.Step == 3)
            {
                <div class="wizard-panel">
                    <div class="panel-header">
                        <h2>3. Event Details &amp; Location</h2>
                        <p>Confirm your expected schedule and tell us where the event takes place.</p>
                    </div>

                    <div class="review-details-box">
                        <div class="review-row"><span class="review-label">Expected date</span><span class="review-val">@Wizard.Date?.ToString("dddd, MMMM d, yyyy")</span></div>
                        <div class="review-row"><span class="review-label">Expected time</span><span class="review-val">@FormatRange(Wizard.SlotStart, Wizard.SlotEnd)</span></div>
                    </div>
                    <label class="addon-card @(Wizard.DateTimeConfirmed ? "is-checked" : "")" style="margin-bottom:1.5rem;">
                        <input type="checkbox" checked="@Wizard.DateTimeConfirmed"
                               @onchange="e => Wizard.DateTimeConfirmed = (bool)(e.Value ?? false)" />
                        <span class="addon-title">I confirm this date and time</span>
                    </label>

                    <label class="picker-label" for="event-location">Event place / venue (optional)</label>
                    <input id="event-location" type="text" class="negotiation-textarea" maxlength="300"
                           placeholder="e.g. Wedding venue, event hall, outdoor location, studio…"
                           @bind="Wizard.EventLocation" @bind:event="oninput" />

                    <div class="wizard-footer">
                        <button type="button" class="btn btn-outline-dark" @onclick="BackAsync">← Back</button>
                        <button type="button" class="btn btn-dark btn-lg" disabled="@(!Wizard.DateTimeConfirmed || _busy)" @onclick="NextAsync">
                            Next: Teleconference →
                        </button>
                    </div>
                </div>
            }
            else if (Wizard.Step == 4)
            {
                <div class="wizard-panel">
                    <div class="panel-header">
                        <h2>4. Teleconference Setup</h2>
                        <p>Which app would you like to use for your online session?</p>
                    </div>

                    <div class="service-cards-stack" role="radiogroup">
                        @foreach (var p in MeetingPlatformInfo.All)
                        {
                            var platform = p;
                            var selected = Wizard.Platform == platform;
                            <div class="service-card @(selected ? "is-selected" : "")"
                                 role="radio" aria-checked="@selected" tabindex="0"
                                 @onclick="() => Wizard.SelectPlatform(platform)"
                                 @onkeydown="e => OnPlatformKey(e, platform)">
                                <div class="service-card__left">
                                    <div class="service-radio @(selected ? "is-checked" : "")"></div>
                                    <span class="service-title">@MeetingPlatformInfo.Label(platform)</span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="wizard-footer">
                        <button type="button" class="btn btn-outline-dark" @onclick="BackAsync">← Back</button>
                        <button type="button" class="btn btn-dark btn-lg" disabled="@(Wizard.Platform is null || _busy)" @onclick="NextAsync">
                            @(_busy ? "Generating link…" : "Next: Review →")
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @* ── Step 5: review + the only place the Booking Summary appears ── *@
        <div class="booking-grid-layout">
            <div class="booking-main-col">
                <div class="wizard-panel">
                    <div class="panel-header">
                        <h2>5. Summary &amp; Confirmation</h2>
                        <p>Check everything, then confirm your booking.</p>
                    </div>

                    <div class="review-details-box">
                        <div class="review-row"><span class="review-label">Date</span><span class="review-val">@Wizard.Date?.ToString("dddd, MMMM d, yyyy")</span></div>
                        <div class="review-row"><span class="review-label">Time</span><span class="review-val">@FormatRange(Wizard.SlotStart, Wizard.SlotEnd)</span></div>
                        <div class="review-row">
                            <span class="review-label">Event place / venue</span>
                            <span class="review-val">@(string.IsNullOrWhiteSpace(Wizard.EventLocation) ? "Not specified" : Wizard.EventLocation)</span>
                        </div>
                        <div class="review-row">
                            <span class="review-label">Teleconference</span>
                            <span class="review-val">@(Wizard.Platform is { } p ? MeetingPlatformInfo.Label(p) : "—")</span>
                        </div>
                        <div class="review-row">
                            <span class="review-label">Session link</span>
                            <span class="review-val">
                                @if (IsHttpUrl(Wizard.MeetingLink))
                                {
                                    <a href="@Wizard.MeetingLink" target="_blank" rel="noopener noreferrer">@Wizard.MeetingLink</a>
                                }
                                else
                                {
                                    @(Wizard.MeetingLink ?? "—")
                                }
                            </span>
                        </div>
                    </div>

                    <div class="policy-note">
                        <strong>Studio Policy:</strong> Complimentary rescheduling is available up to 24 hours prior to your scheduled session.
                    </div>

                    <!-- Data Privacy & Terms Agreement Section -->
                    <div class="data-privacy-section mt-4 mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h3 style="font-size: 1.05rem; font-weight: 700; margin: 0; color: #111827;">
                                Data Privacy &amp; Terms Agreement
                            </h3>
                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.75rem; font-weight: 600;">
                                Required
                            </span>
                        </div>

                        <!-- Scrollable Card / Box Containing Data Policy -->
                        <div class="border rounded p-3 bg-light" style="max-height: 170px; overflow-y: auto; font-size: 0.85rem; line-height: 1.55; color: #4b5563; border-color: #e5e7eb !important;">
                            <p class="fw-semibold text-dark mb-2">PhotoAevum Studio Client Data Protection &amp; Consultation Policy</p>
                            <p class="mb-2">
                                At PhotoAevum Studio, we prioritize your personal privacy, sensitive schedule information, and digital media assets in accordance with applicable data privacy regulations. By scheduling an appointment or consultation session, you expressly agree to the collection, secure storage, and processing of your personal information.
                            </p>
                            <p class="mb-2">
                                <strong>1. Information Collection &amp; Purpose:</strong> Personal information (including your name, email address, phone number, and event locations) is collected solely for coordinating photo sessions, preparing creative briefs, facilitating teleconference sessions, and generating invoicing statements.
                            </p>
                            <p class="mb-2">
                                <strong>2. Confidentiality &amp; Media Handling:</strong> Raw footage, proofs, and teleconference notes are strictly confidential and stored on encrypted studio infrastructure. PhotoAevum Studio will never distribute or publish your photographs for commercial or marketing purposes without prior written authorization.
                            </p>
                            <p class="mb-2">
                                <strong>3. Teleconference &amp; Session Access:</strong> Generated meeting links (Google Meet, Zoom, or Microsoft Teams) are uniquely assigned to you and our studio personnel. Sharing links with unauthorized external parties is prohibited.
                            </p>
                            <p class="mb-0">
                                <strong>4. Rescheduling &amp; Retention:</strong> Client session records are retained for historical booking tracking and portfolio delivery. Complimentary schedule modifications are honored up to 24 hours before your confirmed time slot.
                            </p>
                        </div>

                        <!-- Consent Checkbox -->
                        <div class="form-check mt-3 d-flex align-items-start">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="chkDataPolicyConsent"
                                   @bind="isPolicyAccepted"
                                   @bind:after="OnPolicyAcceptedChanged"
                                   style="cursor: pointer; margin-top: 0.2rem;" />
                            <label class="form-check-label ms-2 text-dark" for="chkDataPolicyConsent" style="font-size: 0.875rem; cursor: pointer; user-select: none;">
                                I have read and agree to the <strong>PhotoAevum Studio Data Privacy Policy and Terms</strong>.
                            </label>
                        </div>

                        @if (isPolicyAccepted && policyAcceptedAt.HasValue)
                        {
                            <div class="text-muted mt-1 ps-4" style="font-size: 0.75rem;">
                                <span class="text-success fw-semibold">✓ Accepted</span> on @policyAcceptedAt.Value.ToLocalTime().ToString("MMM dd, yyyy 'at' hh:mm:ss tt")
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_policyValidationError))
                        {
                            <div class="alert alert-danger mt-3 d-flex align-items-center py-2 px-3" role="alert" style="font-size: 0.85rem; border-radius: 6px;">
                                <span class="me-2">⚠️</span>
                                <div>@_policyValidationError</div>
                            </div>
                        }
                    </div>

                    <div class="wizard-footer">
                        <button type="button" class="btn btn-outline-dark" disabled="@_submitting" @onclick="BackAsync">← Back</button>
                        <button type="button"
                                id="btnConfirmBooking"
                                class="btn btn-dark btn-lg"
                                disabled="@(!isPolicyAccepted || _submitting)"
                                @onclick="ConfirmAsync">
                            @(_submitting ? "Confirming…" : $"Confirm & Schedule Consultation (15% Deposit: ₱{DepositFee.ToString("N2")})")
                        </button>
                    </div>
                </div>
            </div>

            <aside class="booking-summary-sidebar">
                <div class="summary-card">
                    <h3 class="summary-title">Booking Summary</h3>
                    @foreach (var svc in SelectedServices)
                    {
                        <div class="summary-item">
                            <span class="item-name">@svc.Name</span>
                            <span class="item-price">₱@svc.Price.ToString("N2")</span>
                        </div>
                    }
                    <div class="summary-divider"></div>
                    <div class="summary-schedule-info">
                        <div class="sched-row"><span>📅 Date:</span><strong>@Wizard.Date?.ToString("MMM d, yyyy")</strong></div>
                        <div class="sched-row"><span>⏰ Time:</span><strong>@FormatRange(Wizard.SlotStart, Wizard.SlotEnd)</strong></div>
                        @if (!string.IsNullOrWhiteSpace(Wizard.EventLocation))
                        {
                            <div class="sched-row"><span>📍 Venue:</span><strong>@Wizard.EventLocation</strong></div>
                        }
                        <div class="sched-row"><span>💻 Session:</span><strong>@(Wizard.Platform is { } sp ? MeetingPlatformInfo.Label(sp) : "—")</strong></div>
                    </div>
                    <div class="summary-divider"></div>
                    <div class="summary-total-row">
                        <span>Total:</span>
                        <span class="total-figure">₱@Total.ToString("N2")</span>
                    </div>
                    <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px; padding:10px; margin-top:12px;">
                        <div style="display:flex; justify-content:space-between; font-size:13px; font-weight:700; color:#065f46;">
                            <span>15% Reservation Deposit:</span>
                            <span>₱@DepositFee.ToString("N2")</span>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:12px; color:#475569; margin-top:4px;">
                            <span>Remaining Balance (85%):</span>
                            <span>₱@BalanceFee.ToString("N2")</span>
                        </div>
                        <div style="margin-top:6px; font-size:11px; color:#15803d; font-weight:600;">
                            ✓ Status: Paid / Cleared on submission
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private static readonly string[] StepLabels =
        ["Service", "Date & Time", "Event Details", "Teleconference", "Summary"];
    private static readonly string[] WeekdayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private List<ScheduleServiceOption> _services = new();
    private MonthAvailability? _month;
    private ScheduleBookingResult? _result;
    private string? _error;
    private bool _loadingServices = true;
    private bool _loadingMonth;
    private bool _loadingSlots;
    private bool _busy;
    private bool _submitting;
    private int _loadSeq;
    private bool isPolicyAccepted;
    private DateTime? policyAcceptedAt;
    private string? _policyValidationError;

    // Model properties for Step 2 and booking form binding
    private BookingWizardModel bookingModel = new();
    private List<SlotAvailability> _selectedDaySlots = new();

    private void OnPolicyAcceptedChanged()
    {
        if (isPolicyAccepted)
        {
            policyAcceptedAt = DateTime.UtcNow;
            _policyValidationError = null;
            _error = null;
        }
        else
        {
            policyAcceptedAt = null;
        }
    }

    private IEnumerable<ScheduleServiceOption> SelectedServices =>
        _services.Where(s => Wizard.ServiceIds.Contains(s.ServicesId));
    private decimal Total => SelectedServices.Sum(s => s.Price);
    private decimal DepositFee => Math.Round(Total * 0.15m, 2);
    private decimal BalanceFee => Math.Round(Total - DepositFee, 2);

    private bool CanGoPrevMonth =>
        Wizard.VisibleMonth > BookScheduleState.FirstOfMonth(DateOnly.FromDateTime(DateTime.Now));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var result = await Api.GetServicesAsync();
        if (result.IsSuccess)
        {
            _services = result.Value!.ToList();
            Wizard.ServiceIds.RemoveWhere(id => !_services.Any(s => s.ServicesId.Equals(id, StringComparison.OrdinalIgnoreCase)));
        }
        else
        {
            _error = result.Error!.Message;
        }
        _loadingServices = false;

        if (Wizard.Step == 2)
        {
            SyncModelFromWizard();
            await LoadMonthAsync();
            if (Wizard.Date is { } d)
            {
                await LoadDaySlotsAsync(d);
            }
        }
        StateHasChanged();
    }

    private void SyncModelFromWizard()
    {
        if (Wizard.Date.HasValue)
        {
            bookingModel.SelectedDate = Wizard.Date.Value.ToDateTime(TimeOnly.MinValue);
        }
        else
        {
            bookingModel.SelectedDate = null;
        }

        if (Wizard.SlotStart.HasValue)
        {
            bookingModel.SelectedTimeSlot = Wizard.SlotStart.Value.ToTimeSpan();
        }
        else
        {
            bookingModel.SelectedTimeSlot = null;
        }
    }

    // ── Step 1 ──────────────────────────────────────────────────────
    private void ToggleService(string id)
    {
        if (!Wizard.ServiceIds.Remove(id)) Wizard.ServiceIds.Add(id);
    }

    private void OnServiceKey(KeyboardEventArgs e, string id)
    {
        if (e.Key is "Enter" or " ") ToggleService(id);
    }

    private void OnPlatformKey(KeyboardEventArgs e, MeetingPlatform platform)
    {
        if (e.Key is "Enter" or " ") Wizard.SelectPlatform(platform);
    }

    // ── Step 2 ──────────────────────────────────────────────────────
    private async Task LoadMonthAsync()
    {
        var seq = ++_loadSeq;
        _loadingMonth = true;
        var m = Wizard.VisibleMonth;
        var result = await Api.GetAvailabilityAsync(m.Year, m.Month);
        if (seq != _loadSeq) return;

        _loadingMonth = false;
        if (result.IsSuccess)
        {
            _month = result.Value;
        }
        else
        {
            _month = null;
            _error = result.Error!.Message;
        }
    }

    private async Task PrevMonthAsync()
    {
        Wizard.VisibleMonth = Wizard.VisibleMonth.AddMonths(-1);
        await LoadMonthAsync();
    }

    private async Task NextMonthAsync()
    {
        Wizard.VisibleMonth = Wizard.VisibleMonth.AddMonths(1);
        await LoadMonthAsync();
    }

    public bool IsDateAvailable(DateTime date) => IsDateAvailable(DateOnly.FromDateTime(date));

    public bool IsDateAvailable(DateOnly date)
    {
        return _month?.Days.FirstOrDefault(d => d.Date == date)?.HasAvailability == true;
    }

    public async Task SelectDate(DateTime date)
    {
        await SelectDateInternalAsync(DateOnly.FromDateTime(date));
    }

    public async Task SelectDate(DateOnly date)
    {
        await SelectDateInternalAsync(date);
    }

    private async Task SelectDateInternalAsync(DateOnly date)
    {
        _error = null;
        bookingModel.SelectedDate = date.ToDateTime(TimeOnly.MinValue);
        bookingModel.SelectedTimeSlot = null;
        Wizard.SelectDate(date);

        await LoadDaySlotsAsync(date);
    }

    private async Task LoadDaySlotsAsync(DateOnly date)
    {
        _loadingSlots = true;
        StateHasChanged();
        try
        {
            var res = await Api.GetDayAvailabilityAsync(date);
            if (res.IsSuccess && res.Value is not null)
            {
                _selectedDaySlots = res.Value.Slots.ToList();
            }
            else
            {
                _selectedDaySlots = _month?.Days.FirstOrDefault(d => d.Date == date)?.Slots.ToList() ?? [];
            }
        }
        catch
        {
            _selectedDaySlots = _month?.Days.FirstOrDefault(d => d.Date == date)?.Slots.ToList() ?? [];
        }
        finally
        {
            _loadingSlots = false;
            if (Wizard.SlotStart.HasValue)
            {
                var matchingSlot = _selectedDaySlots.FirstOrDefault(s => s.Start == Wizard.SlotStart.Value && s.IsAvailable);
                if (matchingSlot is not null)
                {
                    bookingModel.SelectedTimeSlot = matchingSlot.Start.ToTimeSpan();
                }
                else
                {
                    bookingModel.SelectedTimeSlot = null;
                    Wizard.ClearSlot();
                }
            }
            StateHasChanged();
        }
    }

    public void SelectTimeSlot(TimeSpan time)
    {
        SelectTimeSlotInternal(TimeOnly.FromTimeSpan(time));
    }

    public void SelectTimeSlot(TimeOnly time)
    {
        SelectTimeSlotInternal(time);
    }

    public void SelectTimeSlot(SlotAvailability slot)
    {
        if (!slot.IsAvailable) return;
        SelectTimeSlotInternal(slot.Start);
    }

    private void SelectTimeSlotInternal(TimeOnly start)
    {
        _error = null;
        bookingModel.SelectedTimeSlot = start.ToTimeSpan();

        var slot = _selectedDaySlots.FirstOrDefault(s => s.Start == start);
        var end = slot?.End ?? start.AddHours(1);
        Wizard.SelectSlot(start, end);
    }

    public bool CanProceedToStep3()
    {
        return bookingModel.SelectedDate.HasValue &&
               bookingModel.SelectedTimeSlot.HasValue &&
               !_loadingSlots &&
               !_busy;
    }

    // Only open slots inside the studio windows, for the selected date.
    private IEnumerable<SlotAvailability> SlotsFor(DateOnly date) =>
        _month?.Days.FirstOrDefault(d => d.Date == date)?.Slots
            .Where(s => s.IsAvailable && SessionWindows.IsInWindow(s.Start, s.End))
        ?? Enumerable.Empty<SlotAvailability>();

    // ── Navigation ──────────────────────────────────────────────────
    private async Task NextAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            switch (Wizard.Step)
            {
                case 1:
                    if (Wizard.ServiceIds.Count == 0) { _error = "Select at least one service."; return; }
                    Wizard.Step = 2;
                    SyncModelFromWizard();
                    await LoadMonthAsync();
                    if (Wizard.Date is { } d1)
                    {
                        await LoadDaySlotsAsync(d1);
                    }
                    break;

                case 2:
                    if (!CanProceedToStep3())
                    {
                        _error = "Please select both an available date and a time slot.";
                        return;
                    }
                    await ContinueFromScheduleAsync();
                    break;

                case 3:
                    if (!Wizard.DateTimeConfirmed) { _error = "Please confirm your date and time."; return; }
                    Wizard.Step = 4;
                    break;

                case 4:
                    await ContinueFromPlatformAsync();
                    break;
            }
        }
        finally { _busy = false; }
    }

    private async Task ContinueFromScheduleAsync()
    {
        if (!CanProceedToStep3() || Wizard.Date is not { } date || Wizard.SlotStart is not { } start)
        {
            _error = "Pick a date and time.";
            return;
        }

        await LoadMonthAsync();
        if (!SlotsFor(date).Any(s => s.Start == start))
        {
            Wizard.ClearSlot();
            bookingModel.SelectedTimeSlot = null;
            _error = "That time slot was just booked by another client. Please choose a different time.";
            return;
        }
        Wizard.Step = 3;
    }

    private async Task ContinueFromPlatformAsync()
    {
        if (Wizard.Platform is not { } platform || Wizard.Date is not { } date || Wizard.SlotStart is not { } start)
        {
            _error = "Choose a teleconference app.";
            return;
        }

        if (string.IsNullOrEmpty(Wizard.MeetingLink))
        {
            var preview = await Api.PreviewMeetingLinkAsync(platform, date, start);
            if (!preview.IsSuccess) { _error = preview.Error!.Message; return; }
            Wizard.MeetingLink = preview.Value!.MeetingLink;
        }
        Wizard.Step = 5;
    }

    private async Task BackAsync() => await GoBackToAsync(Wizard.Step - 1);

    private async Task GoBackToAsync(int step)
    {
        if (step < 1 || step >= Wizard.Step) return;
        _error = null;
        Wizard.Step = step;
        if (step == 2)
        {
            SyncModelFromWizard();
            await LoadMonthAsync();
            if (Wizard.Date is { } d)
            {
                await LoadDaySlotsAsync(d);
            }
        }
    }

    // ── Step 5: submit ──────────────────────────────────────────────
    private async Task ConfirmAsync()
    {
        if (_submitting) return;

        if (!isPolicyAccepted)
        {
            _policyValidationError = "You must read and agree to the PhotoAevum Studio Data Privacy Policy and Terms before confirming.";
            _error = _policyValidationError;
            return;
        }

        if (Wizard.Date is not { } date || Wizard.SlotStart is not { } start ||
            Wizard.Platform is not { } platform || Wizard.ServiceIds.Count == 0)
        {
            _error = "Some booking details are missing. Please go back and complete every step.";
            return;
        }

        _submitting = true;
        _error = null;
        _policyValidationError = null;
        try
        {
            var request = new ScheduleBookingRequest
            {
                ServiceIds = Wizard.ServiceIds.ToList(),
                Date = date,
                SlotStart = start,
                EventLocation = Wizard.EventLocation,
                Platform = platform,
                MeetingLink = Wizard.MeetingLink,
                HasAcceptedDataPolicy = isPolicyAccepted,
                DataPolicyAcceptedAt = policyAcceptedAt
            };

            var result = await Api.BookAsync(request);
            if (result.IsSuccess)
            {
                _result = result.Value;
                Wizard.Reset();
                bookingModel = new();
                Events.NotifyBookingsChanged();
                return;
            }

            _error = result.Error!.Message;
            if (result.Error.Kind == ApiErrorKind.SlotTaken)
            {
                Wizard.ClearSlot();
                bookingModel.SelectedTimeSlot = null;
                Wizard.Step = 2;
                await LoadMonthAsync();
                if (Wizard.Date is { } d)
                {
                    await LoadDaySlotsAsync(d);
                }
            }
        }
        finally { _submitting = false; }
    }

    private async Task BookAnotherAsync()
    {
        _result = null;
        _error = null;
        _policyValidationError = null;
        isPolicyAccepted = false;
        policyAcceptedAt = null;
        bookingModel = new();
        _selectedDaySlots.Clear();
        await LoadMonthAsync();
    }

    // ── Helpers ─────────────────────────────────────────────────────
    private static string FormatRange(TimeOnly? start, TimeOnly? end) =>
        start is { } s && end is { } e ? $"{s:h:mm tt} – {e:h:mm tt}" : "—";

    private static string FormatRange(TimeOnly start, TimeOnly end) => $"{start:h:mm tt} – {end:h:mm tt}";

    private static bool IsHttpUrl(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var u) && (u.Scheme == Uri.UriSchemeHttps || u.Scheme == Uri.UriSchemeHttp);
}
