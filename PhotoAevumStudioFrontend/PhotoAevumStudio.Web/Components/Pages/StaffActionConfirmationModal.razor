@using PhotoAevumStudio.Web.Models

@if (IsOpen && TargetEmployee != null)
{
    <div class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 transition-opacity animate-in fade-in duration-150"
         @onclick="HandleCancel">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-md w-full p-6 space-y-5 animate-in zoom-in-95 duration-150"
             @onclick:stopPropagation="true">
            
            <div class="flex items-start gap-4">
                @if (ActionType == "Archive")
                {
                    <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 border border-amber-200">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                        </svg>
                    </div>
                }
                else if (ActionType == "Restore")
                {
                    <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-200">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                    </div>
                }
                else
                {
                    <div class="w-11 h-11 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center shrink-0 border border-rose-200">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </div>
                }

                <div class="flex-1 min-w-0">
                    <h3 class="text-base font-bold text-slate-900 tracking-tight">
                        @(ActionType switch
                        {
                            "Archive" => "Archive Employee Record",
                            "Restore" => "Restore Employee to Active",
                            "Delete" => "Permanently Delete Employee",
                            _ => "Confirm Employee Action"
                        })
                    </h3>
                    <p class="text-xs text-slate-500 mt-1">
                        @(ActionType switch
                        {
                            "Archive" => "Move employee to the archived staff directory.",
                            "Restore" => "Restore employee back to active duty in the studio roster.",
                            "Delete" => "Permanently remove employee credentials and record.",
                            _ => "Please confirm this action."
                        })
                    </p>
                </div>
            </div>

            <!-- Employee Info Card -->
            <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200 text-xs space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-slate-500">Employee:</span>
                    <span class="font-semibold text-slate-900">@TargetEmployee.FullName</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-500">Employee ID:</span>
                    <span class="font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 text-slate-800 font-medium">@TargetEmployee.EmployeeId</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-500">Department:</span>
                    <span class="text-slate-800 font-medium">@(string.IsNullOrWhiteSpace(TargetEmployee.Department) ? "General" : TargetEmployee.Department)</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-500">Current Status:</span>
                    <span class="font-medium text-slate-800">@TargetEmployee.Status</span>
                </div>
            </div>

            <div class="text-xs text-slate-600 leading-relaxed">
                @if (ActionType == "Archive")
                {
                    <p>
                        Archiving will move <strong>@TargetEmployee.FullName</strong> into the <em>Archived Staff</em> directory. The record will be hidden from the active roster, event scheduling, and timesheet clocks. You can restore this employee at any time.
                    </p>
                }
                else if (ActionType == "Restore")
                {
                    <p>
                        Restoring will return <strong>@TargetEmployee.FullName</strong> to the active staff directory with <strong>Active</strong> status, enabling them for studio assignments and scheduling.
                    </p>
                }
                else
                {
                    <p class="text-rose-700 bg-rose-50 p-2.5 rounded-lg border border-rose-200 font-medium">
                        ⚠️ <strong>Warning:</strong> This action cannot be undone. The employee account, joint specializations, and associated profile data will be permanently purged from the database.
                    </p>
                }
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-100">
                <button type="button"
                        @onclick="HandleCancel"
                        disabled="@IsProcessing"
                        class="px-4 py-2 text-xs font-semibold rounded-lg border border-slate-300 text-slate-700 bg-white hover:bg-slate-50 transition-colors cursor-pointer disabled:opacity-50">
                    Cancel
                </button>

                @if (ActionType == "Archive")
                {
                    <button type="button"
                            @onclick="HandleConfirm"
                            disabled="@IsProcessing"
                            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-amber-600 hover:bg-amber-700 text-white shadow-xs transition-all cursor-pointer disabled:opacity-50">
                        @if (IsProcessing)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                            <span>Archiving...</span>
                        }
                        else
                        {
                            <span>Confirm Archive</span>
                        }
                    </button>
                }
                else if (ActionType == "Restore")
                {
                    <button type="button"
                            @onclick="HandleConfirm"
                            disabled="@IsProcessing"
                            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs transition-all cursor-pointer disabled:opacity-50">
                        @if (IsProcessing)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                            <span>Restoring...</span>
                        }
                        else
                        {
                            <span>Confirm Restore</span>
                        }
                    </button>
                }
                else
                {
                    <button type="button"
                            @onclick="HandleConfirm"
                            disabled="@IsProcessing"
                            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold rounded-lg bg-rose-600 hover:bg-rose-700 text-white shadow-xs transition-all cursor-pointer disabled:opacity-50">
                        @if (IsProcessing)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span>Delete Permanently</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string ActionType { get; set; } = "Archive"; // "Archive", "Restore", "Delete"
    [Parameter] public EmployeeViewModel? TargetEmployee { get; set; }
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }

    private async Task HandleCancel()
    {
        if (IsProcessing) return;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleConfirm()
    {
        if (IsProcessing) return;
        await OnConfirmed.InvokeAsync();
    }
}
