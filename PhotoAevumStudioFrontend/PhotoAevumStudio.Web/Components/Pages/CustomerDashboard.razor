@page "/my"
@attribute [Authorize(Roles = "Customer")]

<PageTitle>My Aevum Portal</PageTitle>

<div class="max-w-4xl mx-auto py-10 px-6">
    <div class="flex justify-between items-center mb-10">
        <h1 class="text-3xl font-bold text-gray-900">Welcome to Aevum</h1>
        <a href="/my/book" class="bg-teal-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-teal-700 shadow-sm transition-colors">
            Book a Session
        </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="/my/bookings" class="block p-8 bg-white rounded-2xl shadow-sm border border-gray-200 hover:border-teal-500 hover:shadow-md transition-all group">
            <div class="w-12 h-12 bg-teal-50 text-teal-600 rounded-full flex items-center justify-center mb-4 group-hover:bg-teal-600 group-hover:text-white transition-colors">
                <i data-lucide="calendar" class="w-6 h-6"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900">My Bookings</h2>
            <p class="text-gray-500 mt-2">Track the status of your upcoming and past shoots.</p>
        </a>

        <a href="/my/gallery/demo-gallery" class="block p-8 bg-white rounded-2xl shadow-sm border border-gray-200 hover:border-teal-500 hover:shadow-md transition-all group">
            <div class="w-12 h-12 bg-teal-50 text-teal-600 rounded-full flex items-center justify-center mb-4 group-hover:bg-teal-600 group-hover:text-white transition-colors">
                <i data-lucide="image" class="w-6 h-6"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900">Private Galleries</h2>
            <p class="text-gray-500 mt-2">View, favorite, and download your delivered photos.</p>
        </a>
    </div>
</div>
