@page "/my"
@layout CustomerLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PhotoAevumStudio.Web.Services
@inject IUserService UserService
@attribute [Authorize(Roles = "Customer")]
@rendermode InteractiveServer

<PageTitle>My Aevum Portal | Photo Aevum Studio</PageTitle>

@* ── Page header ─────────────────────────────────────────────────── *@
<header class="aev-page-header">
    <div>
        <h1 class="aev-page-header__title">Welcome to Aevum</h1>
        <p class="aev-page-header__subtitle">Your photography portal</p>
    </div>
    <div class="flex items-center gap-2">
        <button type="button" class="btn btn--primary" @onclick="() => _showBookScheduleModal = true">Book Schedule</button>
    </div>
</header>

<BookScheduleWizardModal @bind-IsOpen="_showBookScheduleModal" />

@if (PendingCount > 0)
{
    <div class="aev-alert-banner" role="status">
        <span aria-hidden="true">🔔</span>
        You have <strong>@PendingCount pending action(s)</strong> — please review your upcoming session status.
    </div>
}

@* ── Navigation cards ─────────────────────────────────────────────── *@
<div class="aev-content-row aev-content-row--wrap" aria-label="Portal sections">

    <a href="/my/bookings" class="aev-nav-card">
        <span class="aev-nav-card__icon" aria-hidden="true">📋</span>
        <h2 class="aev-nav-card__title">My Appointments</h2>
        <p class="aev-nav-card__desc">Track the status of your upcoming and past shoots.</p>
    </a>

    <button type="button" class="aev-nav-card text-left" @onclick="() => _showBookScheduleModal = true">
        <span class="aev-nav-card__icon" aria-hidden="true">➕</span>
        <h2 class="aev-nav-card__title">Book a Schedule</h2>
        <p class="aev-nav-card__desc">Request a new photography session with our team.</p>
    </button>

    <a href="/my/bookings" class="aev-nav-card">
        <span class="aev-nav-card__icon" aria-hidden="true">🖼</span>
        <h2 class="aev-nav-card__title">Private Galleries</h2>
        <p class="aev-nav-card__desc">View, favourite, and download your delivered photos.</p>
    </a>

</div>

@* ── Upcoming appointments mini-list ─────────────────────────────── *@
<section class="aev-card" aria-label="Upcoming appointments">
    <header class="aev-card__header">
        <h2 class="aev-card__heading">Upcoming Appointments</h2>
        <a href="/my/bookings" class="aev-card__action-link">View All</a>
    </header>
    <div class="aev-table-wrap">
        <table class="aev-table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Date &amp; Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!UpcomingBookings.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-gray-500 py-8">No upcoming appointments found in the database.</td>
                    </tr>
                }
                else
                {
                    @foreach (var booking in UpcomingBookings)
                    {
                        <tr>
                            <td>@booking.ServiceTitle</td>
                            <td>@booking.EventDateTime.ToString("MMM dd, yyyy – h:mm tt")</td>
                            <td>
                                <span class="aev-badge @(booking.Status == "Confirmed" ? "aev-badge--green" : "aev-badge--amber")">
                                    @booking.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private List<BookingRow> UpcomingBookings = new();
    private bool _showBookScheduleModal;
    private int PendingCount => UpcomingBookings.Count(b => string.Equals(b.Status, "Pending", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        string? customerId = null;
        if (AuthState != null)
        {
            var state = await AuthState;
            customerId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                      ?? state.User.FindFirst("sub")?.Value;
        }

        UpcomingBookings = UserService.GetBookings(customerId);
    }
}
