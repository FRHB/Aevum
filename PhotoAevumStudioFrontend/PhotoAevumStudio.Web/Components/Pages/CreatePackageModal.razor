@using System.ComponentModel.DataAnnotations
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IUserService UserService
@inject ILogger<CreatePackageModal> Logger

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-6 overflow-y-auto animate-in fade-in duration-150"
         role="dialog" aria-modal="true" aria-labelledby="package-wizard-title">

        <div class="relative w-full max-w-3xl bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden flex flex-col max-h-[92vh]">

            @* ── Modal Header ────────────────────────────────────────────────────────── *@
            <div class="px-6 py-4.5 border-b border-gray-100 flex items-center justify-between bg-white shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gray-900 text-white flex items-center justify-center font-bold text-sm shadow-xs shrink-0">
                        <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                    </div>
                    <div>
                        <h2 id="package-wizard-title" class="text-lg sm:text-xl font-bold text-gray-900">Create New Package</h2>
                        <p class="text-xs text-gray-500">4-step wizard: bundle details, service selection, media upload, and review</p>
                    </div>
                </div>
                <button type="button"
                        @onclick="HandleClose"
                        disabled="@isSaving"
                        class="text-gray-400 hover:text-gray-700 p-2 rounded-lg hover:bg-gray-100 transition-colors"
                        aria-label="Close modal">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @* ── Stepper Navigation Bar ─────────────────────────────────────────────── *@
            <div class="px-6 pt-3.5 pb-3 bg-gray-50/80 border-b border-gray-100 shrink-0">
                <nav aria-label="Wizard Steps" class="flex items-center justify-between">

                    @* Step 1: Details *@
                    <div class="flex items-center gap-2">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all
                            @(currentStep > 1 ? "bg-emerald-600 text-white shadow-xs" : currentStep == 1 ? "bg-gray-900 text-white shadow-xs ring-4 ring-gray-100" : "bg-gray-200 text-gray-500")">
                            @(currentStep > 1 ? "✓" : "1")
                        </span>
                        <div class="hidden sm:block text-left">
                            <p class="text-xs font-semibold @(currentStep == 1 ? "text-gray-900" : "text-gray-500")">Step 1</p>
                            <p class="text-[11px] text-gray-400">Details</p>
                        </div>
                    </div>

                    <div class="flex-1 h-0.5 mx-2 sm:mx-3 @(currentStep > 1 ? "bg-emerald-500" : "bg-gray-200") transition-colors"></div>

                    @* Step 2: Services *@
                    <div class="flex items-center gap-2">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all
                            @(currentStep > 2 ? "bg-emerald-600 text-white shadow-xs" : currentStep == 2 ? "bg-gray-900 text-white shadow-xs ring-4 ring-gray-100" : "bg-gray-200 text-gray-500")">
                            @(currentStep > 2 ? "✓" : "2")
                        </span>
                        <div class="hidden sm:block text-left">
                            <p class="text-xs font-semibold @(currentStep == 2 ? "text-gray-900" : "text-gray-500")">Step 2</p>
                            <p class="text-[11px] text-gray-400">Services</p>
                        </div>
                    </div>

                    <div class="flex-1 h-0.5 mx-2 sm:mx-3 @(currentStep > 2 ? "bg-emerald-500" : "bg-gray-200") transition-colors"></div>

                    @* Step 3: Media *@
                    <div class="flex items-center gap-2">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all
                            @(currentStep > 3 ? "bg-emerald-600 text-white shadow-xs" : currentStep == 3 ? "bg-gray-900 text-white shadow-xs ring-4 ring-gray-100" : "bg-gray-200 text-gray-500")">
                            @(currentStep > 3 ? "✓" : "3")
                        </span>
                        <div class="hidden sm:block text-left">
                            <p class="text-xs font-semibold @(currentStep == 3 ? "text-gray-900" : "text-gray-500")">Step 3</p>
                            <p class="text-[11px] text-gray-400">Media</p>
                        </div>
                    </div>

                    <div class="flex-1 h-0.5 mx-2 sm:mx-3 @(currentStep > 3 ? "bg-emerald-500" : "bg-gray-200") transition-colors"></div>

                    @* Step 4: Overview & Save *@
                    <div class="flex items-center gap-2">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all
                            @(currentStep == 4 ? "bg-gray-900 text-white shadow-xs ring-4 ring-gray-100" : "bg-gray-200 text-gray-500")">
                            4
                        </span>
                        <div class="hidden sm:block text-left">
                            <p class="text-xs font-semibold @(currentStep == 4 ? "text-gray-900" : "text-gray-500")">Step 4</p>
                            <p class="text-[11px] text-gray-400">Overview &amp; Save</p>
                        </div>
                    </div>

                </nav>
            </div>

            @* ── Modal Body Content ─────────────────────────────────────────────────── *@
            <div class="p-6 overflow-y-auto flex-1 space-y-5">

                @* Validation / Error Banner *@
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="p-3.5 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl flex items-start gap-3 text-xs" role="alert">
                        <svg class="w-4 h-4 text-rose-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <div class="flex-1">
                            <span class="font-bold">Error:</span> @errorMessage
                        </div>
                        <button type="button" @onclick="() => errorMessage = null" class="text-rose-500 hover:text-rose-700 font-bold">&times;</button>
                    </div>
                }

                @* ══════════════════════════════════════════════════════════════════════
                   WIZARD PAGE 1: DETAILS INPUT
                   ══════════════════════════════════════════════════════════════════════ *@
                @if (currentStep == 1)
                {
                    <div class="space-y-4 animate-in fade-in duration-150">
                        <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-100 flex items-center justify-between">
                            <div>
                                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">Package Core Details</h3>
                                <p class="text-xs text-gray-500">Define the combo package title, category classification, pricing, and scope.</p>
                            </div>
                            <span class="text-xs font-semibold px-2 py-0.5 bg-gray-200/70 text-gray-700 rounded-md">Page 1 of 4</span>
                        </div>

                        @* Combo Package Service Name *@
                        <div>
                            <label for="pkg-wizard-name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                                Combo Package Service Name <span class="text-red-500">*</span>
                            </label>
                            <input id="pkg-wizard-name"
                                   type="text"
                                   @bind="formModel.Name"
                                   placeholder="e.g., Ultimate Wedding &amp; Pre-Nup Bundle"
                                   class="w-full px-3.5 py-2.5 text-sm bg-white border @(nameError != null ? "border-rose-400 ring-1 ring-rose-300" : "border-gray-300") rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 transition-colors" />
                            @if (nameError != null)
                            {
                                <p class="text-xs text-rose-600 mt-1 font-medium">@nameError</p>
                            }
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @* Service Category Dropdown *@
                            <div>
                                <label for="pkg-wizard-category" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                                    Service Category <span class="text-red-500">*</span>
                                </label>
                                <select id="pkg-wizard-category"
                                        @bind="formModel.CategoryId"
                                        class="w-full px-3.5 py-2.5 text-sm bg-white border @(categoryError != null ? "border-rose-400 ring-1 ring-rose-300" : "border-gray-300") rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 transition-colors">
                                    <option value="">-- Select Service Category --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                                @if (categoryError != null)
                                {
                                    <p class="text-xs text-rose-600 mt-1 font-medium">@categoryError</p>
                                }
                            </div>

                            @* Combo Package Service Price *@
                            <div>
                                <label for="pkg-wizard-price" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                                    Combo Package Service Price <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500 font-bold text-sm">₱</span>
                                    <input id="pkg-wizard-price"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           @bind="formModel.Price"
                                           class="w-full pl-8 pr-3.5 py-2.5 text-sm bg-white border @(priceError != null ? "border-rose-400 ring-1 ring-rose-300" : "border-gray-300") rounded-xl text-gray-900 font-mono font-semibold focus:outline-none focus:ring-2 focus:ring-gray-900 transition-colors" />
                                </div>
                                @if (priceError != null)
                                {
                                    <p class="text-xs text-rose-600 mt-1 font-medium">@priceError</p>
                                }
                            </div>
                        </div>

                        @* Combo Package Service Description *@
                        <div>
                            <label for="pkg-wizard-desc" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                                Combo Package Service Description <span class="text-red-500">*</span>
                            </label>
                            <textarea id="pkg-wizard-desc"
                                      rows="3"
                                      @bind="formModel.Description"
                                      placeholder="Describe the bundle inclusions, session length, photo delivery timelines, and special perks..."
                                      class="w-full px-3.5 py-2.5 text-sm bg-white border @(descError != null ? "border-rose-400 ring-1 ring-rose-300" : "border-gray-300") rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900 resize-none transition-colors"></textarea>
                            @if (descError != null)
                            {
                                <p class="text-xs text-rose-600 mt-1 font-medium">@descError</p>
                            }
                        </div>
                    </div>
                }

                @* ══════════════════════════════════════════════════════════════════════
                   WIZARD PAGE 2: SERVICE SELECTION (MANY-TO-MANY)
                   ══════════════════════════════════════════════════════════════════════ *@
                @if (currentStep == 2)
                {
                    <div class="space-y-4 animate-in fade-in duration-150">
                        <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-100 flex items-center justify-between">
                            <div>
                                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">Bundle Service Selection</h3>
                                <p class="text-xs text-gray-500">Select multiple Main and Additional services to bundle into this combo package.</p>
                            </div>
                            <span class="text-xs font-semibold px-2 py-0.5 bg-gray-200/70 text-gray-700 rounded-md">Page 2 of 4</span>
                        </div>

                        @* Filter, Search & Bulk Actions Bar *@
                        <div class="flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
                            @* Category Pills *@
                            <div class="inline-flex rounded-lg bg-gray-100 p-0.5 text-xs font-medium">
                                <button type="button"
                                        @onclick='() => serviceFilter = "All"'
                                        class="px-3 py-1.5 rounded-md transition-all @(serviceFilter == "All" ? "bg-white text-gray-900 font-bold shadow-xs" : "text-gray-600 hover:text-gray-900")">
                                    All (@availableServices.Count)
                                </button>
                                <button type="button"
                                        @onclick='() => serviceFilter = "Main"'
                                        class="px-3 py-1.5 rounded-md transition-all @(serviceFilter == "Main" ? "bg-white text-gray-900 font-bold shadow-xs" : "text-gray-600 hover:text-gray-900")">
                                    Main Services (@availableServices.Count(s => s.ServiceType == "Main"))
                                </button>
                                <button type="button"
                                        @onclick='() => serviceFilter = "Additional"'
                                        class="px-3 py-1.5 rounded-md transition-all @(serviceFilter == "Additional" ? "bg-white text-gray-900 font-bold shadow-xs" : "text-gray-600 hover:text-gray-900")">
                                    Additional Services (@availableServices.Count(s => s.ServiceType == "Additional"))
                                </button>
                            </div>

                            @* Search Input *@
                            <div class="relative flex-1 max-w-xs">
                                <input type="text"
                                       @bind="serviceSearch"
                                       @bind:event="oninput"
                                       placeholder="Search services..."
                                       class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-gray-200 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900" />
                                <svg class="w-3.5 h-3.5 text-gray-400 absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                        </div>

                        @* Selected Services Live Summary Bar *@
                        <div class="p-3 bg-emerald-50/70 border border-emerald-200 rounded-xl flex flex-wrap items-center justify-between gap-2 text-xs">
                            <div class="flex items-center gap-2">
                                <span class="w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-[10px]">
                                    @formModel.SelectedServiceIds.Count
                                </span>
                                <span class="font-bold text-emerald-950">
                                    @formModel.SelectedServiceIds.Count services selected
                                </span>
                                <span class="text-emerald-700">
                                    (Combined a la carte value: <strong class="font-mono">₱@CalculateCombinedServicesValue().ToString("N2")</strong>)
                                </span>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button"
                                        @onclick="SelectAllVisible"
                                        class="text-[11px] font-semibold text-emerald-700 hover:text-emerald-900 underline cursor-pointer">
                                    Select All Visible
                                </button>
                                <span class="text-emerald-300">|</span>
                                <button type="button"
                                        @onclick="DeselectAllVisible"
                                        class="text-[11px] font-semibold text-gray-500 hover:text-gray-800 underline cursor-pointer">
                                    Clear Selection
                                </button>
                            </div>
                        </div>

                        @* Selection Error if none selected *@
                        @if (serviceSelectionError != null)
                        {
                            <p class="text-xs text-rose-600 font-medium">@serviceSelectionError</p>
                        }

                        @* Available Services Multi-Select Grid *@
                        <div class="max-h-72 overflow-y-auto space-y-2 pr-1 border border-gray-100 rounded-xl p-2 bg-gray-50/30">
                            @if (FilteredServices.Any())
                            {
                                @foreach (var svc in FilteredServices)
                                {
                                    var isSelected = formModel.SelectedServiceIds.Contains(svc.Id);
                                    <div @onclick="() => ToggleService(svc.Id)"
                                         class="p-3 rounded-xl border transition-all cursor-pointer flex items-center justify-between gap-3 select-none
                                                @(isSelected ? "bg-emerald-50/40 border-emerald-400 ring-1 ring-emerald-300 shadow-xs" : "bg-white border-gray-200 hover:border-gray-300 hover:bg-gray-50/50")">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <input type="checkbox"
                                                   checked="@isSelected"
                                                   @onclick:stopPropagation="true"
                                                   @onchange="() => ToggleService(svc.Id)"
                                                   class="w-4 h-4 text-emerald-600 rounded border-gray-300 focus:ring-emerald-500 cursor-pointer" />
                                            <div class="min-w-0">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-semibold text-xs text-gray-900 truncate">@svc.Name</span>
                                                    @if (svc.ServiceType == "Main")
                                                    {
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                                            Main Service
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">
                                                            Additional Service
                                                        </span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(svc.Description))
                                                {
                                                    <p class="text-[11px] text-gray-500 truncate mt-0.5">@svc.Description</p>
                                                }
                                            </div>
                                        </div>
                                        <div class="text-right shrink-0">
                                            <span class="font-mono text-xs font-bold text-gray-900">₱@svc.Price.ToString("N2")</span>
                                            <span class="block text-[10px] text-gray-400 font-mono">@svc.Id</span>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="py-8 text-center text-xs text-gray-500">
                                    No services found matching current filters.
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ══════════════════════════════════════════════════════════════════════
                   WIZARD PAGE 3: MEDIA (IMAGE UPLOAD)
                   ══════════════════════════════════════════════════════════════════════ *@
                @if (currentStep == 3)
                {
                    <div class="space-y-4 animate-in fade-in duration-150">
                        <div class="bg-gray-50/60 p-3.5 rounded-xl border border-gray-100 flex items-center justify-between">
                            <div>
                                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">Choose an Image</h3>
                                <p class="text-xs text-gray-500">Upload a marketing or hero image for this combo package (multipart/form-data upload).</p>
                            </div>
                            <span class="text-xs font-semibold px-2 py-0.5 bg-gray-200/70 text-gray-700 rounded-md">Page 3 of 4</span>
                        </div>

                        @if (formModel.ImageBytes == null)
                        {
                            <div class="relative border-2 border-dashed border-gray-300 hover:border-gray-500 rounded-2xl p-8 text-center bg-gray-50/40 hover:bg-gray-50 transition-all cursor-pointer group">
                                <InputFile OnChange="HandleFileSelected"
                                           accept="image/png,image/jpeg,image/jpg,image/webp"
                                           class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />

                                <div class="flex flex-col items-center justify-center space-y-3 pointer-events-none">
                                    <div class="w-14 h-14 rounded-full bg-white shadow-sm border border-gray-200 flex items-center justify-center text-gray-400 group-hover:text-gray-900 group-hover:scale-105 transition-all">
                                        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-800">
                                            <span class="text-emerald-600 underline">Click to choose an image</span> or drag and drop
                                        </p>
                                        <p class="text-xs text-gray-400 mt-1">PNG, JPG, or WEBP (Maximum file size: 5 MB)</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-200 space-y-3">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Selected Package Showcase Image</span>
                                    <button type="button"
                                            @onclick="RemoveImage"
                                            class="text-xs font-semibold text-rose-600 hover:text-rose-800 hover:underline flex items-center gap-1 cursor-pointer">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                        Remove Image
                                    </button>
                                </div>

                                <div class="relative rounded-xl overflow-hidden bg-black/5 aspect-video max-h-56 flex items-center justify-center border border-gray-200">
                                    <img src="@formModel.ImagePreviewBase64"
                                         alt="Package Preview"
                                         class="w-full h-full object-contain" />
                                </div>

                                <div class="flex items-center justify-between text-xs text-gray-500 pt-1 border-t border-gray-200/60">
                                    <span class="font-medium truncate max-w-[220px]">@formModel.ImageFileName</span>
                                    <span class="font-mono text-gray-400">@FormatFileSize(formModel.ImageFileSize) &bull; @formModel.ImageMimeType</span>
                                </div>
                            </div>
                        }

                        @if (fileError != null)
                        {
                            <p class="text-xs text-rose-600 font-medium">@fileError</p>
                        }
                    </div>
                }

                @* ══════════════════════════════════════════════════════════════════════
                   WIZARD PAGE 4: OVERVIEW & SAVE
                   ══════════════════════════════════════════════════════════════════════ *@
                @if (currentStep == 4)
                {
                    <div class="space-y-4 animate-in fade-in duration-150">

                        @* Auto-Generated Sequential ID Card (Strictly Read-Only) *@
                        <div class="bg-gradient-to-r from-gray-900 to-gray-800 text-white rounded-xl p-4 shadow-sm flex items-center justify-between">
                            <div>
                                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
                                    </svg>
                                    Custom Combo Package ID (Strictly Read-Only)
                                </span>
                                <p class="text-xs text-gray-300 mt-0.5">
                                    Sequential ID auto-assigned by the backend sequence logic to eliminate race conditions.
                                </p>
                            </div>
                            <div class="text-right">
                                @if (isGeneratingId)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs text-gray-300">
                                        <svg class="animate-spin w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                        </svg>
                                        Generating...
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-block px-3.5 py-1.5 bg-white/10 border border-white/20 rounded-lg font-mono text-sm font-bold text-emerald-300 tracking-wider">
                                        @formModel.GeneratedPackageId
                                    </span>
                                }
                            </div>
                        </div>

                        @* Read-only Package Details Card *@
                        <div class="bg-gray-50/70 rounded-xl border border-gray-200 overflow-hidden text-xs divide-y divide-gray-200">
                            <div class="p-3.5 flex justify-between items-center bg-white">
                                <span class="font-medium text-gray-500 uppercase tracking-wider text-[11px]">Package Name</span>
                                <span class="font-bold text-gray-900 text-sm">@formModel.Name</span>
                            </div>

                            <div class="p-3.5 flex justify-between items-center">
                                <span class="font-medium text-gray-500 uppercase tracking-wider text-[11px]">Service Category</span>
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                    @formModel.CategoryName
                                </span>
                            </div>

                            <div class="p-3.5 flex justify-between items-center bg-white">
                                <span class="font-medium text-gray-500 uppercase tracking-wider text-[11px]">Package Bundle Price</span>
                                <div class="text-right">
                                    <span class="font-mono font-bold text-emerald-700 text-base">₱@formModel.Price.ToString("N2")</span>
                                    @if (CalculateCombinedServicesValue() > formModel.Price)
                                    {
                                        <span class="block text-[10px] text-emerald-600 font-semibold">
                                            Bundle saves ₱@((CalculateCombinedServicesValue() - formModel.Price).ToString("N2"))!
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="p-3.5">
                                <span class="block font-medium text-gray-500 uppercase tracking-wider text-[11px] mb-1">Description</span>
                                <p class="text-gray-700 leading-relaxed bg-white p-2.5 rounded-lg border border-gray-100">
                                    @formModel.Description
                                </p>
                            </div>

                            @* Bundled Services List *@
                            <div class="p-3.5">
                                <span class="block font-medium text-gray-500 uppercase tracking-wider text-[11px] mb-2">
                                    Bundled Services (@SelectedServicesList.Count)
                                </span>
                                <div class="space-y-1.5 max-h-40 overflow-y-auto">
                                    @foreach (var svc in SelectedServicesList)
                                    {
                                        <div class="flex items-center justify-between p-2 rounded-lg bg-white border border-gray-100 text-xs">
                                            <div class="flex items-center gap-2">
                                                @if (svc.ServiceType == "Main")
                                                {
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700">Main</span>
                                                }
                                                else
                                                {
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-purple-50 text-purple-700">Add-on</span>
                                                }
                                                <span class="font-semibold text-gray-800">@svc.Name</span>
                                            </div>
                                            <span class="font-mono text-gray-600">₱@svc.Price.ToString("N2")</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Media Attachment Preview *@
                            <div class="p-3.5">
                                <span class="block font-medium text-gray-500 uppercase tracking-wider text-[11px] mb-2">Showcase Image</span>
                                @if (formModel.ImageBytes != null && !string.IsNullOrEmpty(formModel.ImagePreviewBase64))
                                {
                                    <div class="flex items-center gap-3 bg-white p-2.5 rounded-lg border border-gray-100">
                                        <img src="@formModel.ImagePreviewBase64" alt="Thumbnail" class="w-12 h-12 object-cover rounded-md border border-gray-200 shrink-0" />
                                        <div class="truncate">
                                            <p class="font-semibold text-gray-900 truncate">@formModel.ImageFileName</p>
                                            <p class="text-[11px] text-gray-400">@FormatFileSize(formModel.ImageFileSize) &bull; @formModel.ImageMimeType</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-gray-400 italic py-1">No custom image attached. Default studio cover will be applied.</div>
                                }
                            </div>
                        </div>

                    </div>
                }

            </div>

            @* ── Modal Footer Controls ──────────────────────────────────────────────── *@
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-between shrink-0">
                <div>
                    @if (currentStep > 1)
                    {
                        <button type="button"
                                @onclick="PrevStep"
                                disabled="@isSaving"
                                class="px-4 py-2.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-semibold rounded-lg transition-colors cursor-pointer">
                            &larr; Back
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="HandleClose"
                                disabled="@isSaving"
                                class="px-4 py-2.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-semibold rounded-lg transition-colors cursor-pointer">
                            Cancel
                        </button>
                    }
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-400 mr-2">Step @currentStep of 4</span>

                    @if (currentStep < 4)
                    {
                        <button type="button"
                                @onclick="NextStep"
                                class="inline-flex items-center gap-1.5 px-6 py-2.5 bg-gray-900 hover:bg-black text-white text-xs font-semibold rounded-lg shadow-sm hover:shadow transition-all cursor-pointer">
                            <span>Next Step</span>
                            <span>&rarr;</span>
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick="HandleSaveAsync"
                                disabled="@(isSaving || isGeneratingId)"
                                class="inline-flex items-center gap-2 px-7 py-2.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white text-xs font-bold rounded-lg shadow-sm hover:shadow transition-all disabled:opacity-60 cursor-pointer">
                            @if (isSaving)
                            {
                                <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                </svg>
                                <span>Saving Package...</span>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Save Package</span>
                            }
                        </button>
                    }
                </div>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<PackageServiceItem> OnPackageCreated { get; set; }

    private int currentStep = 1;
    private bool isSaving = false;
    private bool isGeneratingId = false;
