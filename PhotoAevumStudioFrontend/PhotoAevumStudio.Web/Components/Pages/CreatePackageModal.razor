    // Wizard Data State
    private PackageWizardFormModel formModel = new();
    private List<CategoryLookupModel> categories = new();
    private List<BundleServiceOption> availableServices = new();

    // Filters for Step 2
    private string serviceFilter = "All";
    private string serviceSearch = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            if (categories.Count == 0 || availableServices.Count == 0)
            {
                await LoadInitialDataAsync();
            }
        }
    }

    public async Task ResetWizardAsync()
    {
        currentStep = 1;
        isSaving = false;
        isGeneratingId = false;
        errorMessage = null;
        nameError = null;
        categoryError = null;
        priceError = null;
        descError = null;
        serviceSelectionError = null;
        fileError = null;
        serviceFilter = "All";
        serviceSearch = string.Empty;

        formModel = new PackageWizardFormModel();
        await LoadInitialDataAsync();
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            var catTask = UserService.GetServiceCategoriesLookupAsync();
            var svcTask = UserService.GetAvailableServicesForBundlingAsync();
            await Task.WhenAll(catTask, svcTask);

            categories = (await catTask).ToList();
            availableServices = (await svcTask).ToList();

            if (string.IsNullOrWhiteSpace(formModel.CategoryId) && categories.Count > 0)
            {
                formModel.CategoryId = categories[0].Id;
                formModel.CategoryName = categories[0].Name;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load initial categories or services for package wizard.");
        }
    }

    private async Task HandleClose()
    {
        if (isSaving) return;
        await ResetWizardAsync();
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task NextStep()
    {
        errorMessage = null;

        if (currentStep == 1)
        {
            if (!ValidateStep1()) return;
            currentStep = 2;
            return;
        }

        if (currentStep == 2)
        {
            if (!ValidateStep2()) return;
            currentStep = 3;
            return;
        }

        if (currentStep == 3)
        {
            await PrepareOverviewStepAsync();
            currentStep = 4;
            return;
        }
    }

    private void PrevStep()
    {
        errorMessage = null;
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private bool ValidateStep1()
    {
        nameError = null;
        categoryError = null;
        priceError = null;
        descError = null;
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(formModel.Name))
        {
            nameError = "Package name is required.";
            isValid = false;
        }
        else if (formModel.Name.Trim().Length < 3)
        {
            nameError = "Package name must be at least 3 characters.";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(formModel.CategoryId))
        {
            categoryError = "Please select a service category.";
            isValid = false;
        }
        else
        {
            var match = categories.FirstOrDefault(c => c.Id == formModel.CategoryId);
            formModel.CategoryName = match?.Name ?? formModel.CategoryId;
        }

        if (formModel.Price <= 0)
        {
            priceError = "Package price must be greater than zero.";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(formModel.Description))
        {
            descError = "Package description is required.";
            isValid = false;
        }
        else if (formModel.Description.Trim().Length < 5)
        {
            descError = "Description must be at least 5 characters.";
            isValid = false;
        }

        return isValid;
    }

    private bool ValidateStep2()
    {
        serviceSelectionError = null;
        if (formModel.SelectedServiceIds.Count == 0)
        {
            serviceSelectionError = "Please select at least one service to include in this combo package.";
            return false;
        }
        return true;
    }

    private void ToggleService(string id)
    {
        if (formModel.SelectedServiceIds.Contains(id))
        {
            formModel.SelectedServiceIds.Remove(id);
        }
        else
        {
            formModel.SelectedServiceIds.Add(id);
        }
        serviceSelectionError = null;
    }

    private void SelectAllVisible()
    {
        foreach (var svc in FilteredServices)
        {
            formModel.SelectedServiceIds.Add(svc.Id);
        }
        serviceSelectionError = null;
    }

    private void DeselectAllVisible()
    {
        foreach (var svc in FilteredServices)
        {
            formModel.SelectedServiceIds.Remove(svc.Id);
        }
    }

    private IEnumerable<BundleServiceOption> FilteredServices
    {
        get
        {
            var query = availableServices.AsEnumerable();
            if (serviceFilter == "Main")
            {
                query = query.Where(s => s.ServiceType == "Main");
            }
            else if (serviceFilter == "Additional")
            {
                query = query.Where(s => s.ServiceType == "Additional");
            }

            if (!string.IsNullOrWhiteSpace(serviceSearch))
            {
                var term = serviceSearch.Trim();
                query = query.Where(s =>
                    s.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (s.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    s.Id.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private List<BundleServiceOption> SelectedServicesList =>
        availableServices.Where(s => formModel.SelectedServiceIds.Contains(s.Id)).ToList();

    private decimal CalculateCombinedServicesValue() =>
        SelectedServicesList.Sum(s => s.Price);

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        fileError = null;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 5 * 1024 * 1024)
        {
            fileError = "Image file size exceeds the 5MB limit.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            formModel.ImageBytes = ms.ToArray();
            formModel.ImageFileName = file.Name;
            formModel.ImageMimeType = file.ContentType ?? "image/jpeg";
            formModel.ImageFileSize = file.Size;
            formModel.ImagePreviewBase64 = $"data:{formModel.ImageMimeType};base64,{Convert.ToBase64String(formModel.ImageBytes)}";
        }
        catch (Exception ex)
        {
            fileError = $"Error processing image: {ex.Message}";
        }
    }

