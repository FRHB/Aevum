@using System.ComponentModel.DataAnnotations
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@attribute [Authorize(Roles = "Admin,SystemAdmin,Office Clerk")]
@inject IEmployeeService Employees
@implements IDisposable

@if (IsOpen)
{
    <div class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 flex items-center justify-center p-4"
         role="dialog" aria-modal="true" aria-labelledby="wizard-title">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 id="wizard-title" class="text-xl font-bold text-slate-900 tracking-tight">
                        @(IsEditMode ? "Edit Studio Employee" : "Add Studio Employee")
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        @(IsEditMode ? "Photo Aevum Studio • Staff Modification" : "Photo Aevum Studio • Staff Onboarding")
                    </p>
                </div>
                <button type="button" 
                        class="text-slate-400 hover:text-slate-700 p-1.5 rounded-lg hover:bg-slate-100 transition-colors"
                        aria-label="Close"
                        @onclick="HandleCancelClick" 
                        disabled="@isSaving">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Stepper Progress Bar -->
            <div class="px-6 pt-5 pb-2 bg-white">
                <nav aria-label="Progress" class="flex items-center justify-between">
                    <!-- Step 1 -->
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                            @(currentStep >= 1 ? "bg-slate-900 text-white shadow-sm ring-4 ring-slate-100" : "bg-slate-100 text-slate-400")">
                            @(currentStep > 1 ? "✓" : "1")
                        </span>
                        <span class="text-xs font-medium @(currentStep == 1 ? "text-slate-900 font-bold" : "text-slate-500")">
                            Personal Info
                        </span>
                    </div>

                    <div class="flex-1 h-0.5 mx-3 @(currentStep > 1 ? "bg-slate-900" : "bg-slate-200") transition-colors"></div>

                    <!-- Step 2 -->
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                            @(currentStep >= 2 ? "bg-slate-900 text-white shadow-sm ring-4 ring-slate-100" : "bg-slate-100 text-slate-400")">
                            @(currentStep > 2 ? "✓" : "2")
                        </span>
                        <span class="text-xs font-medium @(currentStep == 2 ? "text-slate-900 font-bold" : "text-slate-500")">
                            Specializations
                        </span>
                    </div>

                    <div class="flex-1 h-0.5 mx-3 @(currentStep > 2 ? "bg-slate-900" : "bg-slate-200") transition-colors"></div>

                    <!-- Step 3 -->
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                            @(currentStep >= 3 ? "bg-slate-900 text-white shadow-sm ring-4 ring-slate-100" : "bg-slate-100 text-slate-400")">
                            @(currentStep > 3 ? "✓" : "3")
                        </span>
                        <span class="text-xs font-medium @(currentStep == 3 ? "text-slate-900 font-bold" : "text-slate-500")">
                            Overview &amp; Credentials
                        </span>
                    </div>
                </nav>
            </div>

            <!-- Form Content -->
            <div class="p-6 overflow-y-auto flex-1">
                <EditForm EditContext="_editContext">
                    <DataAnnotationsValidator />

                    @if (currentStep == 1)
                    {
                        <div class="space-y-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="emp-first" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        First Name <span class="text-rose-500">*</span>
                                    </label>
                                    <InputText id="emp-first" @bind-Value="model.FirstName" class="@InputClass" placeholder="e.g. John" autocomplete="off" />
                                    <ValidationMessage For="() => model.FirstName" class="text-xs text-rose-600 mt-1" />
                                </div>
                                <div>
                                    <label for="emp-last" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Last Name <span class="text-rose-500">*</span>
                                    </label>
                                    <InputText id="emp-last" @bind-Value="model.LastName" class="@InputClass" placeholder="e.g. Doe" autocomplete="off" />
                                    <ValidationMessage For="() => model.LastName" class="text-xs text-rose-600 mt-1" />
                                </div>
                            </div>

                            <div>
                                <label for="emp-middle" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                    Middle Name <span class="text-slate-400 font-normal lowercase">(optional)</span>
                                </label>
                                <InputText id="emp-middle" @bind-Value="model.MiddleName" class="@InputClass" placeholder="e.g. Alexander" autocomplete="off" />
                                <ValidationMessage For="() => model.MiddleName" class="text-xs text-rose-600 mt-1" />
                            </div>

                            <div>
                                <label for="emp-email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                    Employee Email <span class="text-rose-500">*</span>
                                </label>
                                <InputText id="emp-email" type="email" @bind-Value="model.Email" class="@InputClass" placeholder="j.doe@photoaevum.com" autocomplete="off" />
                                <ValidationMessage For="() => model.Email" class="text-xs text-rose-600 mt-1" />
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="emp-birthdate" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Birth Date <span class="text-rose-500">*</span>
                                    </label>
                                    <InputDate id="emp-birthdate" @bind-Value="model.BirthDate" class="@InputClass" />
                                    <ValidationMessage For="() => model.BirthDate" class="text-xs text-rose-600 mt-1" />
                                </div>
                                <div>
                                    <label for="emp-address" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Home Address <span class="text-rose-500">*</span>
                                    </label>
                                    <InputText id="emp-address" @bind-Value="model.Address" class="@InputClass" placeholder="e.g. 123 Studio Way, Quezon City" autocomplete="off" />
                                    <ValidationMessage For="() => model.Address" class="text-xs text-rose-600 mt-1" />
                                </div>
                            </div>
                        </div>
                    }

                    @if (currentStep == 2)
                    {
                        <div class="space-y-5">
                            <div>
                                <label for="emp-spec" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                    Specialization <span class="text-rose-500">*</span>
                                </label>
                                @if (!AvailableSpecializations.Any() && (allSpecializationLookups?.Count ?? 0) == 0)
                                {
                                    <div class="flex gap-2">
                                        <input id="emp-spec" type="text" @bind="pendingSpec" class="@InputClass flex-1" placeholder="Enter specialization name (no master records found in DB)..." />
                                        <button type="button" 
                                                class="inline-flex items-center px-4 py-2.5 bg-slate-900 hover:bg-black text-white text-xs font-semibold uppercase tracking-wider rounded-lg transition-colors shadow-sm"
                                                @onclick="AddSpecialization">
                                            Add
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex gap-2">
                                        <div class="relative flex-1">
                                            <select id="emp-spec" @bind="pendingSpec" class="@InputClass cursor-pointer appearance-none pr-8">
                                                <option value="">-- Choose a Specialization --</option>
                                                @foreach (var s in AvailableSpecializations)
                                                {
                                                    <option value="@s.Name">@s.Name (@s.Department)</option>
                                                }
                                            </select>
                                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-500">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                                </svg>
                                            </div>
                                        </div>
                                        <button type="button" 
                                                class="inline-flex items-center px-4 py-2.5 bg-slate-900 hover:bg-black text-white text-xs font-semibold uppercase tracking-wider rounded-lg transition-colors shadow-sm disabled:opacity-50"
                                                @onclick="AddSpecialization"
                                                disabled="@(!AvailableSpecializations.Any())">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                            </svg>
                                            Add
                                        </button>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(ConnectedDepartmentSummary))
                                {
                                    <div class="mt-2.5 p-3 bg-indigo-50/70 border border-indigo-200/60 rounded-xl flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs text-indigo-700 font-medium">Connected Department:</span>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-white text-indigo-900 border border-indigo-200 shadow-2xs">
                                                @ConnectedDepartmentSummary
                                            </span>
                                        </div>
                                        <span class="text-[11px] text-indigo-600">Auto-linked from specialization</span>
                                    </div>
                                }
                                @if (specError is not null)
                                {
                                    <p class="text-xs text-rose-600 mt-2 font-medium" role="alert">@specError</p>
                                }
                            </div>

                            <!-- Dismissible Chips -->
                            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
                                    Assigned Specializations (@model.Specializations.Count)
                                </span>
                                @if (model.Specializations.Count == 0)
                                {
                                    <p class="text-xs text-slate-400 italic">No skills added yet. Select or enter a specialization above and click Add.</p>
                                }
                                else
                                {
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var s in model.Specializations)
                                        {
                                            <span class="inline-flex items-center gap-1.5 bg-slate-900 text-white text-xs font-medium pl-3 pr-2 py-1.5 rounded-full shadow-sm">
                                                @s
                                                <button type="button" 
                                                        class="w-4 h-4 flex items-center justify-center rounded-full hover:bg-slate-700 text-slate-300 hover:text-white transition-colors"
                                                        aria-label="Remove @s" 
                                                        @onclick="() => RemoveSpecialization(s)">&times;</button>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Scheduled Days Off Picker -->
                            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                                    Scheduled Weekly Day(s) Off <span class="text-rose-500">*</span>
                                </span>
                                <p class="text-[11px] text-slate-500 mb-2.5">Employees cannot be booked or assigned work on these days.</p>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var day in AllDaysOfWeek)
                                    {
                                        var isSelected = model.SelectedDaysOff.Contains(day);
                                        <button type="button"
                                                @onclick="() => ToggleDayOff(day)"
                                                class="px-2.5 py-1 text-xs font-semibold rounded-lg border transition-all @(isSelected ? "bg-slate-900 text-white border-slate-900 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-100")">
                                            @(isSelected ? "✓ " : "")@day
                                        </button>
                                    }
                                </div>
                                <p class="text-[10px] text-slate-400 mt-2 font-mono">Assigned: @model.DaysOffString</p>
                            </div>
                        </div>
                    }

                    @if (currentStep == 3)
                    {
                        <div class="space-y-5">
                            <!-- Read-only Summary -->
                            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 divide-y divide-slate-200 text-xs">
                                <div class="pb-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Full Name</span>
                                    <span class="text-slate-900 font-semibold text-right">@model.FullName</span>
                                </div>
                                <div class="py-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Email Address</span>
                                    <span class="text-slate-900 font-semibold text-right">@model.Email</span>
                                </div>
                                <div class="py-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Birth Date &amp; Address</span>
                                    <span class="text-slate-900 font-semibold text-right max-w-xs truncate">
                                        @(model.BirthDate != null ? model.BirthDate.Value.ToString("MMM dd, yyyy") : (model.BirthYear != null ? $"b. {model.BirthYear}" : ""))@((model.BirthDate != null || model.BirthYear != null) && !string.IsNullOrWhiteSpace(model.Address) ? " • " : "")@(string.IsNullOrWhiteSpace(model.Address) ? (model.BirthDate == null && model.BirthYear == null ? "—" : "") : model.Address)
                                    </span>
                                </div>
                                <div class="py-2 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Days Off</span>
                                    <span class="text-slate-900 font-semibold text-right">@model.DaysOffString</span>
                                </div>
                                <div class="py-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Department</span>
                                    <span class="text-slate-900 font-semibold text-right">@(string.IsNullOrWhiteSpace(ConnectedDepartmentSummary) ? "General" : ConnectedDepartmentSummary)</span>
                                </div>
                                <div class="pt-2.5 flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
                                    <span class="text-slate-500 font-medium shrink-0">Specializations</span>
                                    <div class="flex flex-wrap gap-1.5 sm:justify-end">
                                        @foreach (var s in model.Specializations)
                                        {
                                            <span class="bg-white border border-slate-300 text-slate-800 text-[11px] px-2.5 py-0.5 rounded-md font-medium">@s</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Credentials -->
                            <div class="space-y-4 pt-1">
                                <div>
                                    <label for="emp-id" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Employee ID <span class="text-slate-400 font-normal lowercase">(system assigned)</span>
                                    </label>
                                    <input id="emp-id" value="@model.EmployeeId" class="@MonoInputClass bg-slate-100 text-slate-700 cursor-not-allowed font-bold" readonly disabled />
                                    <p class="text-[11px] text-slate-500 mt-1">System-assigned sequential ID. This identifier is permanently locked and cannot be edited.</p>
                                </div>

                                <div>
                                    <label for="emp-pw" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        @(IsEditMode ? "Password" : "Starting Password") 
                                        @if (IsEditMode)
                                        {
                                            <span class="text-slate-400 font-normal lowercase">(leave blank to keep current)</span>
                                        }
                                        else
                                        {
                                            <span class="text-rose-500">*</span>
                                        }
                                    </label>
                                    <div class="relative">
                                        <InputText id="emp-pw" @bind-Value="model.Password" class="@PasswordInputClass"
                                                   type="@(showPassword ? "text" : "password")" placeholder="@(IsEditMode ? "•••••••• (unchanged)" : "••••••••")" autocomplete="new-password" />
                                        <button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-500 hover:text-slate-900 font-medium underline"
                                                @onclick="() => showPassword = !showPassword">@(showPassword ? "Hide" : "Show")</button>
                                    </div>
                                    <ValidationMessage For="() => model.Password" class="text-xs text-rose-600 mt-1" />
                                    <p class="text-[11px] text-slate-400 mt-1">
                                        @(IsEditMode ? "Leave empty to retain existing password, or enter at least 8 characters with letters & numbers." : "Format: LastName + BirthYear + Employee ID No. ### (e.g. Doe1995001).")
                                    </p>
                                </div>
                            </div>

                            @if (saveError is not null)
                            {
                                <div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-xs text-rose-700 font-medium" role="alert">
                                    @saveError
                                </div>
                            }
                        </div>
                    }

                    @if (currentStep == 4)
                    {
                        <div class="py-6 px-4 flex flex-col items-center text-center space-y-4 animate-in fade-in duration-200">
                            <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl font-bold shadow-sm">
                                ✓
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-slate-900">
                                    @(IsEditMode ? "Staff Account Updated Successfully!" : "Staff Account Created Successfully!")
                                </h3>
                                <p class="text-xs text-slate-500 mt-1">
                                    @(IsEditMode ? "The employee record has been updated in the studio database." : "The new employee has been onboarded and successfully recorded in the studio database.")
                                </p>
                            </div>

                            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 w-full text-left text-xs divide-y divide-slate-200">
                                <div class="flex justify-between items-center pb-2">
                                    <span class="text-slate-500 font-medium">Employee ID</span>
                                    <span class="font-mono font-bold text-slate-900 bg-white px-2 py-0.5 rounded border border-slate-200">@model.EmployeeId</span>
                                </div>
                                <div class="flex justify-between items-center py-2">
                                    <span class="text-slate-500 font-medium">Full Name</span>
                                    <span class="font-semibold text-slate-900">@model.FullName</span>
                                </div>
                                <div class="flex justify-between items-center py-2">
                                    <span class="text-slate-500 font-medium">Email Address</span>
                                    <span class="text-slate-800">@model.Email</span>
                                </div>
                                <div class="flex justify-between items-center py-2">
                                    <span class="text-slate-500 font-medium">Department</span>
                                    <span class="text-slate-800 font-semibold">@(string.IsNullOrWhiteSpace(ConnectedDepartmentSummary) ? "General" : ConnectedDepartmentSummary)</span>
                                </div>
                                <div class="flex justify-between items-center py-2">
                                    <span class="text-slate-500 font-medium">Weekly Day(s) Off</span>
                                    <span class="text-slate-800 font-medium">@model.DaysOffString</span>
                                </div>
                                <div class="pt-2">
                                    <span class="text-slate-500 font-medium block mb-1">Assigned Specializations</span>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var s in model.Specializations)
                                        {
                                            <span class="bg-white border border-slate-200 text-slate-800 text-[11px] px-2 py-0.5 rounded font-medium">@s</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Email Sent Banner -->
                            @if (!IsEditMode)
                            {
                                <div class="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-800 text-left w-full flex items-start gap-3 shadow-xs" role="status">
                                    <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                    <div>
                                        <p class="font-bold text-emerald-900">Email Notification Dispatched</p>
                                        <p class="text-[11px] text-emerald-700 mt-0.5">
                                            An automated onboarding email has been sent to <strong>@model.Email</strong> containing their generated Employee ID (<strong>@model.EmployeeId</strong>) and temporary login credentials.
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </EditForm>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                @if (currentStep == 1)
                {
                    <button type="button" class="@GhostBtn" @onclick="HandleCancelClick">Cancel</button>
                    <button type="button" class="@PrimaryBtn flex items-center gap-1.5" @onclick="GoToStep2">
                        Next
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                }
                else if (currentStep == 2)
                {
                    <button type="button" class="@GhostBtn flex items-center gap-1.5" @onclick="() => currentStep = 1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        Back
                    </button>
                    <button type="button" class="@PrimaryBtn flex items-center gap-1.5" @onclick="GoToStep3Async">
                        Next
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                }
                else if (currentStep == 3)
                {
                    <button type="button" class="@GhostBtn" @onclick="() => currentStep = 2" disabled="@(isSaving || saveSuccess)">Back</button>
                    <button type="button" class="px-6 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold uppercase tracking-wider shadow-sm transition-colors disabled:opacity-50 flex items-center gap-2" 
                            @onclick="SubmitCompleteSetup" disabled="@(isSaving || saveSuccess)">
                        @if (isSaving)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                            <span>Saving &amp; Sending Email...</span>
                        }
                        else
                        {
                            <span>Complete Setup</span>
                        }
                    </button>
                }
                else if (currentStep == 4)
                {
                    <div class="w-full flex justify-end">
                        <button type="button" 
                                class="px-6 py-2.5 rounded-lg bg-slate-900 hover:bg-black text-white text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm flex items-center gap-2" 
                                @onclick="HandleExitSuccess">
                            <span>Exit &amp; Return to Staff List</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public EmployeeViewModel? EditEmployee { get; set; }

    private const string InputClass =
        "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 " +
        "focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors";
    private const string MonoInputClass =
        "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 font-mono " +
        "focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors";
    private const string PasswordInputClass =
        "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 pr-16 " +
        "focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors";
    private const string PrimaryBtn =
        "bg-slate-900 hover:bg-black text-white px-6 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm disabled:opacity-50";
    private const string GhostBtn =
        "bg-transparent hover:bg-slate-100 text-slate-700 border border-slate-300 px-5 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider transition-colors disabled:opacity-50";

    private static readonly string[] AllDaysOfWeek = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

    private EmployeeRegistrationModel model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;

    private int currentStep = 1;
    private string? pendingSpec;
    private string? specError;
    private string? saveError;
    private bool isSaving;
    private bool saveSuccess;
    private bool showPassword;
    private bool _previousIsOpen;

    private IReadOnlyList<string> allSpecializations = Array.Empty<string>();
    private IReadOnlyList<SpecializationLookupItem> allSpecializationLookups = Array.Empty<SpecializationLookupItem>();
    private CancellationTokenSource? _cts;

    private IEnumerable<SpecializationLookupItem> AvailableSpecializations =>
        allSpecializationLookups.Where(s => !model.Specializations.Contains(s.Name, StringComparer.OrdinalIgnoreCase));

    private string ConnectedDepartmentSummary
    {
        get
        {
            if (model.Specializations == null || model.Specializations.Count == 0)
                return !string.IsNullOrWhiteSpace(model.Department) ? model.Department : string.Empty;

            var depts = model.Specializations
                .Select(s => allSpecializationLookups.FirstOrDefault(l => string.Equals(l.Name, s, StringComparison.OrdinalIgnoreCase))?.Department)
                .Where(d => !string.IsNullOrWhiteSpace(d))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (depts.Count > 0)
                return string.Join(", ", depts);

            return !string.IsNullOrWhiteSpace(model.Department) ? model.Department : "General";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeContext();
        _cts = new CancellationTokenSource();
        await LoadSpecializationsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_previousIsOpen)
        {
            ResetForm();
            if (IsEditMode && EditEmployee != null)
            {
                model.FirstName = EditEmployee.FirstName;
                model.LastName = EditEmployee.LastName;
                model.MiddleName = EditEmployee.MiddleName;
                model.Email = EditEmployee.Email;
                model.Address = EditEmployee.Address;
                model.BirthDate = EditEmployee.BirthDate ?? (EditEmployee.BirthYear.HasValue ? new DateTime(EditEmployee.BirthYear.Value, 1, 1) : null);
                model.BirthYear = EditEmployee.BirthYear;
                model.DepartmentId = EditEmployee.DepartmentId;
                model.Department = EditEmployee.Department;
                model.EmployeeId = EditEmployee.EmployeeId;
                model.Specializations = new List<string>(EditEmployee.Specializations);
                model.SelectedDaysOff = new List<string>(EditEmployee.SelectedDaysOff.Count > 0 ? EditEmployee.SelectedDaysOff : new List<string> { "Sunday" });
                model.Password = string.Empty;
                SyncDepartmentFromSpecializations();
            }
            await LoadSpecializationsAsync();
        }
        _previousIsOpen = IsOpen;
    }

    private async Task LoadSpecializationsAsync()
    {
        try
        {
            var lookups = await Employees.GetSpecializationLookupsAsync(_cts?.Token ?? CancellationToken.None);
            allSpecializationLookups = lookups ?? Array.Empty<SpecializationLookupItem>();
            allSpecializations = allSpecializationLookups.Select(l => l.Name).ToList();
        }
        catch
        {
            allSpecializationLookups = Array.Empty<SpecializationLookupItem>();
            allSpecializations = Array.Empty<string>();
        }
    }

    private void ResetForm()
    {
        currentStep = 1;
        model = new EmployeeRegistrationModel();
        specError = null;
        saveError = null;
        saveSuccess = false;
        isSaving = false;
        showPassword = false;
        pendingSpec = null;
        InitializeContext();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
    }

    private void InitializeContext()
    {
        _editContext = new EditContext(model);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += (s, e) => _messageStore.Clear(e.FieldIdentifier);
    }

    private async Task CloseModal()
    {
        IsOpen = false;
        ResetForm();
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task HandleExitSuccess()
    {
        await OnSaved.InvokeAsync();
        await CloseModal();
    }

    private async Task HandleCancelClick()
    {
        if (isSaving) return;
        if (currentStep == 4)
        {
            await HandleExitSuccess();
            return;
        }
        await CloseModal();
        await OnCancel.InvokeAsync();
    }

    private void AddSpecialization()
    {
        specError = null;
        if (string.IsNullOrWhiteSpace(pendingSpec))
        {
            specError = "Choose a specialization first.";
            return;
        }

        if (model.Specializations.Contains(pendingSpec, StringComparer.OrdinalIgnoreCase))
        {
            specError = "This specialization has already been added.";
            return;
        }

        model.Specializations.Add(pendingSpec.Trim());
        SyncDepartmentFromSpecializations();
        pendingSpec = null;
    }

    private void RemoveSpecialization(string spec)
    {
        model.Specializations.Remove(spec);
        SyncDepartmentFromSpecializations();
    }

    private void SyncDepartmentFromSpecializations()
    {
        var matched = allSpecializationLookups
            .Where(l => model.Specializations.Contains(l.Name, StringComparer.OrdinalIgnoreCase))
            .ToList();

        if (matched.Count > 0)
        {
            var distinctDepts = matched.Select(m => m.Department).Where(d => !string.IsNullOrWhiteSpace(d)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (distinctDepts.Count > 0)
            {
                model.Department = string.Join(", ", distinctDepts);
            }
            var firstDeptId = matched.FirstOrDefault(m => !string.IsNullOrWhiteSpace(m.DepartmentId))?.DepartmentId;
            if (!string.IsNullOrWhiteSpace(firstDeptId))
            {
                model.DepartmentId = firstDeptId;
            }
        }
    }

    private void ToggleDayOff(string day)
    {
        if (model.SelectedDaysOff.Contains(day))
        {
            if (model.SelectedDaysOff.Count > 1)
                model.SelectedDaysOff.Remove(day);
        }
        else
        {
            model.SelectedDaysOff.Add(day);
        }
    }

    private void GoToStep2()
    {
        _messageStore.Clear();
        bool isValid = true;

        var step1Properties = new[]
        {
            new { Name = nameof(model.FirstName), Value = (object?)model.FirstName },
            new { Name = nameof(model.LastName), Value = (object?)model.LastName },
            new { Name = nameof(model.Email), Value = (object?)model.Email },
            new { Name = nameof(model.BirthDate), Value = (object?)model.BirthDate },
            new { Name = nameof(model.Address), Value = (object?)model.Address }
        };

        foreach (var prop in step1Properties)
        {
            var results = new List<ValidationResult>();
            var context = new ValidationContext(model) { MemberName = prop.Name };
            if (!Validator.TryValidateProperty(prop.Value, context, results))
            {
                isValid = false;
                var fieldId = new FieldIdentifier(model, prop.Name);
                foreach (var res in results)
                {
                    _messageStore.Add(fieldId, res.ErrorMessage ?? "Invalid value.");
                }
            }
        }

        _editContext.NotifyValidationStateChanged();

        if (isValid)
        {
            currentStep = 2;
        }
    }

    private async Task GoToStep3Async()
    {
        if (!string.IsNullOrEmpty(pendingSpec))
        {
            AddSpecialization();
        }

        if (model.Specializations.Count == 0)
        {
            specError = "Add at least one specialization.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.EmployeeId))
        {
            try
            {
                var existing = await Employees.GetEmployeesAsync(_cts?.Token ?? CancellationToken.None);
                model.EmployeeId = EmployeeCredentialGenerator.GenerateEmployeeId(existing.Select(e => e.EmployeeId));
            }
            catch
            {
                model.EmployeeId = "EMP-001";
            }
        }

        if (!IsEditMode)
        {
            model.Password = EmployeeCredentialGenerator.GenerateInitialPassword(
                model.LastName,
                model.BirthDate?.Year ?? model.BirthYear,
                model.EmployeeId);
        }

        specError = null;
        currentStep = 3;
    }

    private async Task SubmitCompleteSetup()
    {
        if (isSaving || saveSuccess) return;

        _messageStore.Clear();
        bool isValid = true;

        var step3Properties = new List<dynamic>
        {
            new { Name = nameof(model.EmployeeId), Value = (object)model.EmployeeId }
        };

        if (!IsEditMode || !string.IsNullOrWhiteSpace(model.Password))
        {
            step3Properties.Add(new { Name = nameof(model.Password), Value = (object)model.Password });
        }

        foreach (var prop in step3Properties)
        {
            var results = new List<ValidationResult>();
            var context = new ValidationContext(model) { MemberName = prop.Name };
            if (!Validator.TryValidateProperty(prop.Value, context, results))
            {
                isValid = false;
                var fieldId = new FieldIdentifier(model, prop.Name);
                foreach (var res in results)
                {
                    _messageStore.Add(fieldId, res.ErrorMessage ?? "Invalid value.");
                }
            }
        }

        _editContext.NotifyValidationStateChanged();

        if (!isValid) return;

        isSaving = true;
        saveError = null;
        saveSuccess = false;
        StateHasChanged();

        try
        {
            SyncDepartmentFromSpecializations();
            var request = new NewEmployeeRequest(
                model.EmployeeId.Trim().ToUpperInvariant(),
                model.FirstName.Trim(),
                model.LastName.Trim(),
                model.MiddleName?.Trim(),
                model.Email.Trim(),
                model.Specializations.ToList(),
                string.IsNullOrWhiteSpace(model.Password) ? string.Empty : model.Password.Trim(),
                model.DaysOffString,
                model.Address?.Trim(),
                model.BirthDate?.Year ?? model.BirthYear,
                model.DepartmentId?.Trim(),
                model.BirthDate);

            var result = IsEditMode
                ? await Employees.UpdateEmployeeAsync(request, _cts?.Token ?? CancellationToken.None)
                : await Employees.CreateEmployeeAsync(request, _cts?.Token ?? CancellationToken.None);

            if (!result.Success)
            {
                saveError = result.Error ?? (IsEditMode ? "Failed to update employee." : "Failed to create employee.");
                return;
            }

            saveSuccess = true;
            currentStep = 4;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Cancelled
        }
        catch (Exception ex)
        {
            saveError = $"Something went wrong while saving: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
