@page "/staff/pipeline"
@attribute [Authorize(Roles = "Employee")]

<PageTitle>Delivery Pipeline Tracker</PageTitle>

<div class="max-w-5xl mx-auto py-10 px-6">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Delivery Pipeline</h1>
        <a href="/staff" class="text-teal-600 hover:underline">Back to Dashboard</a>
    </div>

    <div class="bg-white border rounded-xl overflow-hidden shadow-sm">
        <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase text-xs font-semibold">
                <tr>
                    <th class="px-6 py-4">Booking ID / Event</th>
                    <th class="px-6 py-4 text-center">Stage</th>
                    <th class="px-6 py-4 text-right">Update Stage</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4">
                        <div class="font-bold text-gray-900">#BK-9008 - Grad Shoot</div>
                        <div class="text-gray-500 text-xs">Shot on Oct 01</div>
                    </td>
                    <td class="px-6 py-4 text-center">
                        <span class="bg-purple-100 text-purple-800 text-xs font-bold px-3 py-1 rounded-full">Culling</span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <select class="border rounded-md text-sm p-2 w-32 bg-white">
                            <option>Shot</option>
                            <option selected>Culling</option>
                            <option>Editing</option>
                            <option>Uploaded</option>
                        </select>
                        <button class="bg-slate-900 text-white px-3 py-2 rounded-md ml-2 text-sm font-semibold hover:bg-slate-800">Save</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
