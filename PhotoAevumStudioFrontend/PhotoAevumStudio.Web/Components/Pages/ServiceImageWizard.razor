@page "/admin/services/image-wizard"
@page "/admin/services/wizard"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin,Super Admin,SystemAdmin")]
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using System.Security.Claims
@inject IUserService UserService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Service Image Wizard | Aevum Studio</PageTitle>

<div class="image-wizard-container">
    @* ── Header ───────────────────────────────────────────────────────── *@
    <header class="wizard-header">
        <div>
            <div class="breadcrumb-trail">
                <span>Catalog Management</span>
                <span>/</span>
                <span class="font-bold text-gray-900">Service Image Wizard</span>
            </div>
            <h1 class="wizard-title">Service Image Attachment Wizard</h1>
            <p class="wizard-subtitle">
                Attach and manage high-resolution presentation images for Services, Combo Packages, and Add-ons.
            </p>
        </div>

        <div class="rule-callout">
            <span class="callout-icon">⚡</span>
            <span>Optimized on-demand binary streaming. Images load only on detailed selection.</span>
        </div>
    </header>

    @* ── Catalog Type Switcher Tabs ───────────────────────────────────── *@
    <div class="catalog-tabs" role="tablist">
        <button type="button"
                class="catalog-tab @(ActiveTab == CatalogType.MainService ? "active" : "")"
                @onclick="() => SwitchTab(CatalogType.MainService)">
            <span class="tab-badge">1</span>
            <span>Primary Services (dbo.Services)</span>
            <span class="count-pill">@MainServices.Count</span>
        </button>

        <button type="button"
                class="catalog-tab @(ActiveTab == CatalogType.ComboPackage ? "active" : "")"
                @onclick="() => SwitchTab(CatalogType.ComboPackage)">
            <span class="tab-badge">2</span>
            <span>Combo Packages (dbo.ComboPackage)</span>
            <span class="count-pill">@PackageServices.Count</span>
        </button>

        <button type="button"
                class="catalog-tab @(ActiveTab == CatalogType.AddOnService ? "active" : "")"
                @onclick="() => SwitchTab(CatalogType.AddOnService)">
            <span class="tab-badge">3</span>
            <span>Add-On Services (dbo.AdditionalServices)</span>
            <span class="count-pill">@AddOnServices.Count</span>
        </button>
    </div>

    @* ── Status Alerts ────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success" role="status">
            <span>✓ @SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <span>⚠️ @ErrorMessage</span>
        </div>
    }

    @* ── Main Layout: Lightweight Summary Grid ────────────────────────── *@
    <div class="wizard-content-layout">
        <div class="catalog-grid-card">
            <div class="card-toolbar">
                <span class="font-bold text-xs uppercase tracking-wider text-gray-500">
                    @(ActiveTab switch {
                        CatalogType.MainService => "Primary Services Summary",
                        CatalogType.ComboPackage => "Combo Packages Summary",
                        _ => "Additional Services Summary"
                    })
                </span>
                <span class="text-xs text-gray-400">Click row for full image inspector & upload wizard</span>
            </div>

            @if (ActiveTab == CatalogType.MainService)
            {
                <table class="summary-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Service Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in MainServices)
                        {
                            bool isSelected = SelectedCode == s.Code;
                            <tr class="@(isSelected ? "selected-row" : "") cursor-pointer hover:bg-gray-50"
                                @onclick="() => InspectMainService(s.Code, s.Title, s.Description)">
                                <td class="font-mono font-bold">@s.Code</td>
                                <td class="font-semibold text-gray-900">@s.Title</td>
                                <td>@s.Category</td>
                                <td>₱@s.BasePrice.ToString("N0")</td>
                                <td>
                                    <span class="btn-inspect">@(isSelected ? "Inspecting" : "Select & Upload") &rarr;</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (ActiveTab == CatalogType.ComboPackage)
            {
                <table class="summary-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Package Title</th>
                            <th>Bundle Type</th>
                            <th>Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in PackageServices)
                        {
                            bool isSelected = SelectedCode == p.Code;
                            <tr class="@(isSelected ? "selected-row" : "") cursor-pointer hover:bg-gray-50"
                                @onclick="() => InspectPackageService(p.Code, p.Title, p.Description)">
                                <td class="font-mono font-bold">@p.Code</td>
                                <td class="font-semibold text-gray-900">@p.Title</td>
                                <td>@p.BundleCategory</td>
                                <td>@p.Price</td>
                                <td>
                                    <span class="btn-inspect">@(isSelected ? "Inspecting" : "Select & Upload") &rarr;</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="summary-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Add-On Title</th>
                            <th>Type</th>
                            <th>Rate</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in AddOnServices)
                        {
                            bool isSelected = SelectedCode == a.Code;
                            <tr class="@(isSelected ? "selected-row" : "") cursor-pointer hover:bg-gray-50"
                                @onclick="() => InspectAddOnService(a.Code, a.Title, a.Description)">
                                <td class="font-mono font-bold">@a.Code</td>
                                <td class="font-semibold text-gray-900">@a.Title</td>
                                <td>@a.TypeCategory</td>
                                <td>@a.PriceText</td>
                                <td>
                                    <span class="btn-inspect">@(isSelected ? "Inspecting" : "Select & Upload") &rarr;</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* ── On-Demand Detail View & Upload Panel ──────────────────────── *@
        <aside class="detail-inspector-card">
            @if (string.IsNullOrEmpty(SelectedCode))
            {
                <div class="empty-inspector">
                    <div class="inspector-icon">🖼️</div>
                    <h3 class="font-bold text-sm text-gray-700">No Item Selected</h3>
                    <p class="text-xs text-gray-400 mt-1 max-w-xs">
                        Select any service or package on the left to inspect its presentation image and upload new imagery.
                    </p>
                </div>
            }
            else
            {
                <div class="inspector-body">
                    <div class="inspector-header">
                        <div>
                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
                                @ActiveTab.ToString()
                            </span>
                            <h3 class="text-base font-bold text-gray-900">@SelectedTitle</h3>
                            <span class="font-mono text-xs text-gray-500">ID: @SelectedCode</span>
                        </div>
                        <button type="button" @onclick="ClearSelection" class="text-gray-400 hover:text-gray-600 text-sm">✕</button>
                    </div>

                    @* Image Preview Window *@
                    <div class="image-preview-box">
                        @if (IsLoadingImage)
                        {
                            <div class="loading-state">
                                <span>Loading image binary from SQL Server...</span>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(PreviewImageBase64))
                        {
                            <img src="@PreviewImageBase64" alt="@SelectedTitle" class="preview-img" />
                            <div class="preview-meta-badge">
                                <span>@(PendingUploadBytes != null ? "New Upload Pending" : "Current Database Image")</span>
                                @if (!string.IsNullOrEmpty(CurrentMimeType))
                                {
                                    <span>&bull; @CurrentMimeType</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="no-image-placeholder">
                                <span class="placeholder-icon">📷</span>
                                <span class="text-xs font-semibold text-gray-500">No Image Attached</span>
                                <span class="text-[10px] text-gray-400">Use the form below to attach a photo</span>
                            </div>
                        }
                    </div>

                    @* Upload Dropzone *@
                    <div class="upload-controls">
                        <label class="upload-label">Upload / Replace Image (VARBINARY)</label>
                        <InputFile OnChange="HandleFileSelected"
                                   accept="image/png,image/jpeg,image/webp"
                                   class="file-input-field" />
                        <span class="upload-hint">Supported formats: JPG, PNG, WEBP (Max 5MB)</span>

                        @if (PendingUploadBytes != null)
                        {
                            <button type="button"
                                    @onclick="SaveImageAsync"
                                    disabled="@IsSaving"
                                    class="btn-save-image">
                                @if (IsSaving)
                                {
                                    <span>Committing to Database...</span>
                                }
                                else
                                {
                                    <span>💾 Commit Image to @SelectedCode</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>
</div>

@code {
    private enum CatalogType { MainService, ComboPackage, AddOnService }
    private CatalogType ActiveTab = CatalogType.MainService;

    private List<MainServiceItem> MainServices = new();
    private List<PackageServiceItem> PackageServices = new();
    private List<AddOnServiceItem> AddOnServices = new();

    private string? SelectedCode;
    private string? SelectedTitle;
    private string? SelectedDesc;

    private bool IsLoadingImage = false;
    private bool IsSaving = false;
    private string? PreviewImageBase64;
    private string? CurrentMimeType;
    private byte[]? PendingUploadBytes;

    private string? SuccessMessage;
    private string? ErrorMessage;
    private string CurrentAdminId = "SADM-001";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            CurrentAdminId = user.FindFirst("studio_id")?.Value
                             ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                             ?? user.Identity.Name
                             ?? "Admin";
        }

        LoadCatalogData();
    }

    private void LoadCatalogData()
    {
        try
        {
            MainServices = UserService.GetMainServicesSummary().ToList();
            PackageServices = UserService.GetPackageServicesSummary().ToList();
            AddOnServices = UserService.GetAdditionalServicesSummary().ToList();
        }
        catch
        {
            MainServices = UserService.GetMainServices().ToList();
            PackageServices = UserService.GetPackageServices().ToList();
            AddOnServices = UserService.GetAdditionalServices().ToList();
        }
    }

    private void SwitchTab(CatalogType type)
    {
        ActiveTab = type;
        ClearSelection();
    }

    private void ClearSelection()
    {
        SelectedCode = null;
        SelectedTitle = null;
        SelectedDesc = null;
        PreviewImageBase64 = null;
        PendingUploadBytes = null;
        CurrentMimeType = null;
        SuccessMessage = null;
        ErrorMessage = null;
    }

    private async Task InspectMainService(string code, string title, string? desc)
    {
        SelectedCode = code;
        SelectedTitle = title;
        SelectedDesc = desc;
        PendingUploadBytes = null;
        SuccessMessage = null;
        ErrorMessage = null;
        IsLoadingImage = true;
        StateHasChanged();

        await Task.Yield();
        var (bytes, mime) = UserService.GetServiceImage(code);
        if (bytes != null && bytes.Length > 0)
        {
            CurrentMimeType = mime ?? "image/jpeg";
            PreviewImageBase64 = $"data:{CurrentMimeType};base64,{Convert.ToBase64String(bytes)}";
        }
        else
        {
            PreviewImageBase64 = null;
            CurrentMimeType = null;
        }

        IsLoadingImage = false;
    }

    private async Task InspectPackageService(string code, string title, string? desc)
    {
        SelectedCode = code;
        SelectedTitle = title;
        SelectedDesc = desc;
        PendingUploadBytes = null;
        SuccessMessage = null;
        ErrorMessage = null;
        IsLoadingImage = true;
        StateHasChanged();

        await Task.Yield();
        var (bytes, mime) = UserService.GetComboPackageImage(code);
        if (bytes != null && bytes.Length > 0)
        {
            CurrentMimeType = mime ?? "image/jpeg";
            PreviewImageBase64 = $"data:{CurrentMimeType};base64,{Convert.ToBase64String(bytes)}";
        }
        else
        {
            PreviewImageBase64 = null;
            CurrentMimeType = null;
        }

        IsLoadingImage = false;
    }

    private async Task InspectAddOnService(string code, string title, string? desc)
    {
        SelectedCode = code;
        SelectedTitle = title;
        SelectedDesc = desc;
        PendingUploadBytes = null;
        SuccessMessage = null;
        ErrorMessage = null;
        IsLoadingImage = true;
        StateHasChanged();

        await Task.Yield();
        var (bytes, mime) = UserService.GetAdditionalServiceImage(code);
        if (bytes != null && bytes.Length > 0)
        {
            CurrentMimeType = mime ?? "image/jpeg";
            PreviewImageBase64 = $"data:{CurrentMimeType};base64,{Convert.ToBase64String(bytes)}";
        }
        else
        {
            PreviewImageBase64 = null;
            CurrentMimeType = null;
        }

        IsLoadingImage = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        var file = e.File;
        if (file == null) return;

        if (file.Size > 5 * 1024 * 1024)
        {
            ErrorMessage = "File size exceeds the 5MB maximum limit.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            PendingUploadBytes = ms.ToArray();
            CurrentMimeType = file.ContentType ?? "image/jpeg";
            PreviewImageBase64 = $"data:{CurrentMimeType};base64,{Convert.ToBase64String(PendingUploadBytes)}";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error reading uploaded file: {ex.Message}";
        }
    }

    private async Task SaveImageAsync()
    {
        if (string.IsNullOrEmpty(SelectedCode) || PendingUploadBytes == null)
            return;

        IsSaving = true;
        ErrorMessage = null;
        SuccessMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var savedBytes = PendingUploadBytes;
            var savedMime = CurrentMimeType ?? "image/jpeg";
            var targetCode = SelectedCode;

            if (ActiveTab == CatalogType.MainService)
            {
                await UserService.UpdateServiceImageAsync(targetCode, savedBytes, savedMime, CurrentAdminId);
            }
            else if (ActiveTab == CatalogType.ComboPackage)
            {
                await UserService.UpdateComboPackageImageAsync(targetCode, savedBytes, savedMime, CurrentAdminId);
            }
            else
            {
                await UserService.UpdateAdditionalServiceImageAsync(targetCode, savedBytes, savedMime, CurrentAdminId);
            }

            SuccessMessage = $"Presentation image successfully attached to {targetCode} ({SelectedTitle})!";
            PreviewImageBase64 = $"data:{savedMime};base64,{Convert.ToBase64String(savedBytes)}";
            PendingUploadBytes = null;
            LoadCatalogData();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to save image: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
