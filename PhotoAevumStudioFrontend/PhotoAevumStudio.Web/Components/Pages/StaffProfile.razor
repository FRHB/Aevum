@page "/staff/profile"
@page "/staff/settings"
@layout EmployeeLayout
@rendermode InteractiveServer
@using System.Security.Claims
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService

<PageTitle>Staff Profile | Photo Aevum Studio</PageTitle>

<AccountCenterCard CurrentUser="@currentUser"
                   UserPermissions="@userPermissions"
                   IsLoading="@isLoading"
                   RequireAuthenticatedUser="true"
                   EmptyStateTitle="No Active Staff Profile"
                   EmptyStateMessage="Please sign in to view your staff profile from the database."
                   ThirdAttributeLabel="Department"
                   ThirdAttributeValue="@currentUser.Department"
                   PermissionsDescription="Active studio modules authorized for this staff account.">
    <PasswordChecklistSlot Context="pw">
        <PasswordRequirementsChecklist Password="@pw" CssClass="mt-2" />
    </PasswordChecklistSlot>
</AccountCenterCard>

@code {
    private AppUser currentUser = new();
    private List<Permission> userPermissions = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserDataAsync();
    }

    private async Task LoadUserDataAsync()
    {
        isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var claimId = user.FindFirst("studio_id")?.Value
                          ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("sub")?.Value
                          ?? user.Identity?.Name
                          ?? string.Empty;

            var claimEmail = user.FindFirst(ClaimTypes.Email)?.Value
                            ?? user.FindFirst("email")?.Value
                            ?? (user.Identity?.Name?.Contains("@") == true ? user.Identity.Name : string.Empty);

            var claimName = user.FindFirst("full_name")?.Value
                           ?? user.FindFirst("name")?.Value
                           ?? user.FindFirst(ClaimTypes.Name)?.Value
                           ?? string.Empty;

            var claimRole = user.FindFirst(ClaimTypes.Role)?.Value
                           ?? user.FindFirst("role")?.Value
                           ?? string.Empty;

            currentUser = new AppUser
            {
                Id = claimId,
                Email = claimEmail,
                FullName = claimName,
                Role = !string.IsNullOrWhiteSpace(claimRole) ? claimRole : "Employee",
                Department = "Photography",
                JobTitle = "Staff Photographer",
                Status = "Active"
            };

            if (!string.IsNullOrWhiteSpace(currentUser.Id))
            {
                var employee = UserService.GetEmployeeById(currentUser.Id);
                if (employee != null)
                {
                    if (string.IsNullOrWhiteSpace(currentUser.FullName)) currentUser.FullName = employee.Name;
                    if (string.IsNullOrWhiteSpace(currentUser.Email)) currentUser.Email = employee.Email;
                    if (!string.IsNullOrWhiteSpace(employee.Department)) currentUser.Department = employee.Department;
                    if (!string.IsNullOrWhiteSpace(employee.Position)) currentUser.JobTitle = employee.Position;
                    if (!string.IsNullOrWhiteSpace(employee.Status)) currentUser.Status = employee.Status;
                }
            }

            if (string.IsNullOrWhiteSpace(currentUser.FullName) && !string.IsNullOrWhiteSpace(currentUser.Id))
            {
                currentUser.FullName = !string.IsNullOrWhiteSpace(currentUser.Email)
                    ? currentUser.Email.Split('@')[0]
                    : currentUser.Id;
            }

            bool isClerk = EmployeeRoleHelper.IsOfficeClerk(user, UserService);
            userPermissions = isClerk
                ? new List<Permission>
                {
                    new() { Name = "Overview & Timesheet", IconClass = "fa-clock", IsGranted = true },
                    new() { Name = "Consultations & Deals", IconClass = "fa-comments", IsGranted = true },
                    new() { Name = "Events Calendar & Schedules", IconClass = "fa-calendar-days", IsGranted = true },
                    new() { Name = "Services Catalog", IconClass = "fa-list-check", IsGranted = true },
                    new() { Name = "Employees & Equipment Inventory", IconClass = "fa-boxes-stacked", IsGranted = true },
                    new() { Name = "Studio Portfolio", IconClass = "fa-images", IsGranted = true }
                }
                : new List<Permission>
                {
                    new() { Name = "Staff Overview", IconClass = "fa-table-cells-large", IsGranted = true },
                    new() { Name = "Timesheet & Attendance", IconClass = "fa-clock", IsGranted = true },
                    new() { Name = "My Schedule", IconClass = "fa-calendar-days", IsGranted = true },
                    new() { Name = "Featured Services", IconClass = "fa-layer-group", IsGranted = true },
                    new() { Name = "Studio Portfolio", IconClass = "fa-images", IsGranted = true }
                };
        }
        finally
        {
            isLoading = false;
        }
    }
}
