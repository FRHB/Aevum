@page "/analytics/descriptive"
@page "/admin/analytics/descriptive"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SystemAdmin,System Admin,Super Admin,Office Clerk")]
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<PageTitle>Descriptive Analytics | Photo Aevum Studio</PageTitle>

<div class="space-y-6">
    @* ── Page Header ─────────────────────────────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-3 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                <span>Sales &amp; Report</span>
                <span>/</span>
                <span>Analytics</span>
                <span>/</span>
                <span class="text-teal-700 font-bold">Tier 1: Descriptive</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Descriptive Analytics</h1>
                <span class="px-2.5 py-0.5 bg-teal-50 text-teal-800 border border-teal-200 rounded-full text-[11px] font-bold uppercase tracking-wider">
                    What Happened?
                </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Historical aggregation of booking volume, studio revenue, package popularity, and Hangfire ETL pipeline synchronization status.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <select @bind="_selectedPeriod" class="text-xs px-3 py-2 border border-slate-300 rounded-lg bg-white font-medium text-slate-700 focus:outline-none focus:ring-1 focus:ring-teal-500">
                <option value="30d">Last 30 Days</option>
                <option value="q4">Q4 2026 (Oct – Nov)</option>
                <option value="ytd">Year-to-Date (2026)</option>
            </select>
            <button type="button" @onclick="TriggerEtlSync" disabled="@_isSyncing"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-xs font-bold rounded-lg shadow-2xs transition-colors">
                <span>@(_isSyncing ? "Syncing ETL..." : "Run Hangfire ETL Sync")</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusBanner))
    {
        <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between">
            <span>✓ @_statusBanner</span>
            <button type="button" @onclick="() => _statusBanner = null" class="text-emerald-600 hover:text-emerald-900 font-bold">✕</button>
        </div>
    }

    @* ── KPI Summary Row ─────────────────────────────────────────────── *@
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs">
            <div class="flex items-center justify-between text-slate-500 mb-2">
                <span class="text-xs font-medium uppercase tracking-wider">Settled Revenue</span>
                <span class="text-emerald-600 text-xs font-bold">↑ 18.4%</span>
            </div>
            <h3 class="text-2xl font-extrabold text-slate-900">₱412,850.00</h3>
            <p class="text-[11px] text-slate-400 mt-1">15% deposits + 85% wrap-up settlements</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs">
            <div class="flex items-center justify-between text-slate-500 mb-2">
                <span class="text-xs font-medium uppercase tracking-wider">Completed Shoots</span>
                <span class="text-teal-700 text-xs font-bold">54 Sessions</span>
            </div>
            <h3 class="text-2xl font-extrabold text-slate-900">92.6%</h3>
            <p class="text-[11px] text-slate-400 mt-1">Fulfillment rate across confirmed deals</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs">
            <div class="flex items-center justify-between text-slate-500 mb-2">
                <span class="text-xs font-medium uppercase tracking-wider">QR Ph Adoption</span>
                <span class="text-blue-600 text-xs font-bold">Xendit Gateway</span>
            </div>
            <h3 class="text-2xl font-extrabold text-slate-900">78.0%</h3>
            <p class="text-[11px] text-slate-400 mt-1">GCash, Maya &amp; QR Ph instant settlements</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs">
            <div class="flex items-center justify-between text-slate-500 mb-2">
                <span class="text-xs font-medium uppercase tracking-wider">Hangfire ETL Warehouse</span>
                <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded text-[10px] font-bold">Schema v9</span>
            </div>
            <h3 class="text-2xl font-extrabold text-slate-900">@_lastSyncTime</h3>
            <p class="text-[11px] text-slate-400 mt-1">Job: <code>DailyAnalyticsSyncJob.ExecuteSync</code></p>
        </div>
    </div>

    @* ── Package Breakdown & Channel Distribution ────────────────────── *@
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-7 bg-white rounded-xl border border-slate-200 shadow-2xs p-6">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-sm font-bold text-slate-900">Historical Revenue by Service Category</h2>
                    <p class="text-xs text-slate-500">Aggregated from <code>dbo.EventAppointment</code> &amp; <code>dbo.PaymentTransactions</code></p>
                </div>
                <span class="text-xs font-mono text-slate-500">@_selectedPeriod.ToUpperInvariant()</span>
            </div>
            <div class="space-y-4">
                @foreach (var item in _categoryBreakdown)
                {
                    <div>
                        <div class="flex justify-between text-xs font-semibold text-slate-700 mb-1">
                            <span>@item.Name (@item.Bookings bookings)</span>
                            <span class="font-mono text-slate-900">₱@item.Revenue.ToString("N2") (@item.Share%)</span>
                        </div>
                        <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full bg-teal-600 rounded-full" style="width: @(item.Share)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="lg:col-span-5 bg-white rounded-xl border border-slate-200 shadow-2xs p-6 space-y-4">
            <div>
                <h2 class="text-sm font-bold text-slate-900">Deal Outcome Funnel Summary</h2>
                <p class="text-xs text-slate-500">Consultation to confirmed shoot conversion</p>
            </div>
            <div class="divide-y divide-slate-100 text-xs">
                <div class="py-2.5 flex justify-between items-center">
                    <span class="text-slate-600">Total Consultations Logged</span>
                    <span class="font-bold text-slate-900 font-mono">68</span>
                </div>
                <div class="py-2.5 flex justify-between items-center">
                    <span class="text-slate-600">Proposals Sent (Pending Payment)</span>
                    <span class="font-bold text-amber-700 font-mono">61 (89.7%)</span>
                </div>
                <div class="py-2.5 flex justify-between items-center">
                    <span class="text-slate-600">Deal Won (15% Deposit Cleared)</span>
                    <span class="font-bold text-emerald-700 font-mono">54 (79.4%)</span>
                </div>
                <div class="py-2.5 flex justify-between items-center">
                    <span class="text-slate-600">Rescheduled Within Hold Window</span>
                    <span class="font-bold text-blue-700 font-mono">4 (5.9%)</span>
                </div>
                <div class="py-2.5 flex justify-between items-center">
                    <span class="text-slate-600">Deal Lost / Hold Expired</span>
                    <span class="font-bold text-rose-700 font-mono">7 (10.3%)</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _selectedPeriod = "30d";
    private bool _isSyncing;
    private string _lastSyncTime = "Today, 08:00 AM";
    private string? _statusBanner;

    private record CategoryMetric(string Name, int Bookings, decimal Revenue, int Share);

    private readonly List<CategoryMetric> _categoryBreakdown =
    [
        new("Wedding & Prenuptial Full Coverage", 18, 198000m, 48),
        new("Debut & Milestone Event Packages", 14, 112000m, 27),
        new("Commercial & Brand Lookbook Studio", 11, 64350m, 16),
        new("Executive Portrait & Family Sessions", 11, 38500m, 9)
    ];

    private async Task TriggerEtlSync()
    {
        _isSyncing = true;
        StateHasChanged();
        await Task.Delay(350);
        _lastSyncTime = DateTime.Now.ToString("h:mm:ss tt");
        _statusBanner = $"Hangfire DailyAnalyticsSyncJob.ExecuteSync() dispatched at {_lastSyncTime}. Serilog event 'Analytics sync started' written.";
        _isSyncing = false;
    }
}
