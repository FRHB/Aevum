    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int idx = 0;
        double d = bytes;
        while (d >= 1024 && idx < suffixes.Length - 1)
        {
            d /= 1024;
            idx++;
        }
        return $"{d:0.##} {suffixes[idx]}";
    }
