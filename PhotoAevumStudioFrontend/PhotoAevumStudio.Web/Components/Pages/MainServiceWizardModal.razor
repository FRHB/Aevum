    private bool ValidateStep1()
    {
        nameError = null;
        descError = null;
        priceError = null;
        categoryError = null;

        bool isValid = true;

        if (string.IsNullOrWhiteSpace(model.Name))
        {
            nameError = "Service name is required.";
            isValid = false;
        }
        else if (model.Name.Trim().Length < 2)
        {
            nameError = "Service name must be at least 2 characters.";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(model.Description))
        {
            descError = "Service description is required.";
            isValid = false;
        }

        if (model.Price <= 0)
        {
            priceError = "Price must be a positive decimal value.";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(model.CategoryId))
        {
            categoryError = "Please select a category.";
            isValid = false;
        }
        else
        {
            var match = categories.FirstOrDefault(c => c.Id == model.CategoryId);
            model.CategoryName = match?.Name ?? model.CategoryId;
        }

        return isValid;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        fileError = null;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 5 * 1024 * 1024)
        {
            fileError = "Image file size exceeds the 5MB limit.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            model.ImageBytes = ms.ToArray();
            model.ImageFileName = file.Name;
            model.ImageMimeType = file.ContentType ?? "image/jpeg";
            model.ImageSize = file.Size;
            model.ImagePreviewUrl = $"data:{model.ImageMimeType};base64,{Convert.ToBase64String(model.ImageBytes)}";
        }
        catch (Exception ex)
        {
            fileError = $"Error processing image: {ex.Message}";
        }
    }

    private void RemoveImage()
    {
        model.ImageBytes = null;
        model.ImageFileName = null;
        model.ImageMimeType = null;
        model.ImagePreviewUrl = null;
        model.ImageSize = 0;
        fileError = null;
    }

