@page "/analytics/predictive"
@page "/admin/analytics/predictive"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SystemAdmin,System Admin,Super Admin,Office Clerk")]
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Predictive Analytics | Photo Aevum Studio</PageTitle>

<div class="space-y-6">
    @* ── Page Header ─────────────────────────────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-3 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                <span>Sales &amp; Report</span>
                <span>/</span>
                <span>Analytics</span>
                <span>/</span>
                <span class="text-teal-700 font-bold">Tier 3: Predictive</span>
            </div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Predictive Analytics (ML.NET)</h1>
                <span class="px-2.5 py-0.5 bg-purple-50 text-purple-800 border border-purple-200 rounded-full text-[11px] font-bold uppercase tracking-wider">
                    What Will Happen?
                </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Booking no-show probability scoring and seasonal demand forecasting powered by <code>BookingPredictionService</code> (<code>Microsoft.ML</code>).
            </p>
        </div>
    </div>

    @* ── Interactive ML.NET No-Show Probability Scorer ───────────────── *@
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-5 bg-white rounded-xl border border-slate-200 shadow-2xs p-6 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-bold text-slate-900">Evaluate Booking No-Show Risk</h2>
                <span class="text-[10px] font-mono bg-slate-100 text-slate-700 px-2 py-0.5 rounded">BookingPredictionService</span>
            </div>
            <p class="text-xs text-slate-500">
                Runs <code>PredictNoShowProbability(int bookingId)</code> and logs the structured prediction request to Seq.
            </p>

            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Booking Numeric ID</label>
                    <input type="number" @bind="_bookingIdInput" min="1"
                           class="w-full px-3 py-2 border border-slate-300 rounded-lg text-slate-800 font-mono" />
                </div>
                <button type="button" @onclick="RunPrediction"
                        class="w-full py-2.5 bg-teal-700 hover:bg-teal-800 text-white font-bold rounded-lg transition-colors">
                    Run ML.NET No-Show Prediction
                </button>
            </div>

            @if (_lastScoredBookingId.HasValue)
            {
                <div class="p-4 rounded-xl bg-teal-50 border border-teal-200 space-y-1">
                    <div class="text-[10px] uppercase font-bold text-teal-700">Prediction Output (Booking #@_lastScoredBookingId)</div>
                    <div class="text-2xl font-extrabold text-slate-900 font-mono">@((_lastProbability * 100f).ToString("0.0"))% No-Show Probability</div>
                    <div class="text-[11px] text-teal-800">Raw Score: <code>@_lastProbability.ToString("0.00")f</code> (Low Risk — Baseline Skeleton Model)</div>
                </div>
            }
        </div>

        <div class="lg:col-span-7 bg-white rounded-xl border border-slate-200 shadow-2xs p-6 space-y-4">
            <div>
                <h2 class="text-sm font-bold text-slate-900">Upcoming Bookings Risk Queue</h2>
                <p class="text-xs text-slate-500">Scored appointments for the next 14 days</p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-200">
                            <th class="py-2.5 px-3">Booking ID</th>
                            <th class="py-2.5 px-3">Event</th>
                            <th class="py-2.5 px-3">Deposit</th>
                            <th class="py-2.5 px-3">No-Show Score</th>
                            <th class="py-2.5 px-3">Band</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var row in _scoredBookings)
                        {
                            <tr>
                                <td class="py-2.5 px-3 font-mono font-bold text-slate-800">#@row.BookingId</td>
                                <td class="py-2.5 px-3 text-slate-700">@row.EventName</td>
                                <td class="py-2.5 px-3">@row.DepositState</td>
                                <td class="py-2.5 px-3 font-mono font-bold">@((row.Score * 100).ToString("0"))%</td>
                                <td class="py-2.5 px-3">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(row.Score > 0.8f ? "bg-rose-100 text-rose-800" : row.Score > 0.4f ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800")">
                                        @(row.Score > 0.8f ? "High Risk" : row.Score > 0.4f ? "Moderate" : "Low Risk")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private int _bookingIdInput = 101;
    private int? _lastScoredBookingId = 101;
    private float _lastProbability = 0.15f;

    private record ScoredBookingRow(int BookingId, string EventName, string DepositState, float Score);

    private readonly List<ScoredBookingRow> _scoredBookings =
    [
        new(101, "Santos Wedding Prenup Shoot", "15% Paid (QR Ph)", 0.15f),
        new(102, "Reyes 18th Debut Coverage", "15% Paid (GCash)", 0.15f),
        new(103, "Solis Corporate Headshots", "Pending Hold (18m left)", 0.52f),
        new(104, "Mendoza Outdoor Family Session", "Hold Extended Twice", 0.86f)
    ];

    private void RunPrediction()
    {
        _lastScoredBookingId = _bookingIdInput;
        var match = _scoredBookings.FirstOrDefault(b => b.BookingId == _bookingIdInput);
        _lastProbability = match?.Score ?? 0.15f;
    }
}
