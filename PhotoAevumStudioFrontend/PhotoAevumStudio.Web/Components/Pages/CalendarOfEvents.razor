    private async Task NavigateToDayTimetable(DateTime day)
    {
        _highlightedEventId = null;
        _pendingHighlightEventId = null;
        _selectedDate = day.Date;
        await SetViewMode(ScheduleViewMode.Day);
    }

    private static (int StartHour, int EndHour) GetDayTimelineBounds(List<EventBookingModel> dayBookings)
    {
        int startHour = 8;
        int endHour = 20;

        if (dayBookings.Count > 0)
        {
            var minH = (int)Math.Floor(dayBookings.Min(b => b.StartTime.TotalHours));
            var maxH = (int)Math.Ceiling(dayBookings.Max(b => b.EffectiveEndTime.TotalHours));
            if (minH < startHour) startHour = Math.Max(0, minH);
            if (maxH > endHour) endHour = Math.Min(24, maxH);
        }

        if (endHour <= startHour) endHour = Math.Min(24, startHour + 12);
        return (startHour, endHour);
    }

    private static string FormatHourLabel(int hour)
    {
        var normalized = ((hour % 24) + 24) % 24;
        return DateTime.Today.AddHours(normalized).ToString("h tt");
    }

    private async Task ToggleStaffScheduleSection()
    {
        _isStaffScheduleExpanded = !_isStaffScheduleExpanded;
        if (_isStaffScheduleExpanded && _allLeaves.Count == 0 && _staffDirectory.Count == 0)
        {
            await LoadStaffScheduleDataAsync();
        }
    }

    private async Task LoadStaffScheduleDataAsync()
    {
        if (_isPhotographerOrCreative) return;
        _isLoadingStaffSchedule = true;
        try
        {
            var leavesTask = EmployeeService.GetAllLeavesAsync();
            var staffTask = EmployeeService.GetEmployeesAsync();
            await Task.WhenAll(leavesTask, staffTask);

            _allLeaves = (await leavesTask).ToList();
            _staffDirectory = (await staffTask)
                .Where(e => e.IsActive)
                .OrderBy(e => e.FullName)
                .ToList();
        }
        catch
        {
            // Preserve last known state on transient failure
        }
        finally
        {
            _isLoadingStaffSchedule = false;
        }
    }

    private async Task ApproveLeaveRequestAsync(LeaveItemViewModel leave)
    {
        _isProcessingLeaveAction = true;
        _staffScheduleFeedback = null;
        _staffScheduleIsError = false;
        try
        {
            var ok = await EmployeeService.ApproveLeaveAsync(leave.Id);
            if (ok)
            {
                ScheduleService.InvalidateCache();
                _staffScheduleFeedback = $"Approved {leave.LeaveType} for {leave.EmployeeName} ({leave.StartDate:MMM d} – {leave.EndDate:MMM d, yyyy}). Booking engine will now block assignments during this timeframe.";
                await LoadStaffScheduleDataAsync();
            }
            else
            {
                _staffScheduleIsError = true;
                _staffScheduleFeedback = "Could not approve leave request. Please try again.";
            }
        }
        finally
        {
            _isProcessingLeaveAction = false;
        }
    }

    private void OpenRejectLeaveModal(LeaveItemViewModel leave)
    {
        _rejectTargetLeave = leave;
        _rejectReasonInput = string.Empty;
    }

    private async Task ConfirmRejectLeaveAsync()
    {
        if (_rejectTargetLeave == null) return;
        _isProcessingLeaveAction = true;
        _staffScheduleFeedback = null;
        _staffScheduleIsError = false;
        try
        {
            var target = _rejectTargetLeave;
            var ok = await EmployeeService.RejectLeaveAsync(target.Id, string.IsNullOrWhiteSpace(_rejectReasonInput) ? null : _rejectReasonInput.Trim());
            if (ok)
            {
                _rejectTargetLeave = null;
                ScheduleService.InvalidateCache();
                _staffScheduleFeedback = $"Rejected {target.LeaveType} request for {target.EmployeeName}.";
                await LoadStaffScheduleDataAsync();
            }
            else
            {
                _staffScheduleIsError = true;
                _staffScheduleFeedback = "Could not reject leave request. Please try again.";
            }
        }
        finally
        {
            _isProcessingLeaveAction = false;
        }
    }

    private void OpenAdjustDaysOffModal(EmployeeViewModel emp)
    {
        _daysOffTargetEmployee = emp;
        _isDaysOffModalOpen = true;
    }

    private async Task HandleDaysOffSavedAsync(string updatedDaysOff)
    {
        _isDaysOffModalOpen = false;
        ScheduleService.InvalidateCache();
        _staffScheduleIsError = false;
        _staffScheduleFeedback = $"Updated scheduled Days Off for {_daysOffTargetEmployee?.FullName ?? "staff member"} to: {updatedDaysOff}.";
        await LoadStaffScheduleDataAsync();
    }

    private async Task NavigatePrevious()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(-1),
            ScheduleViewMode.Week => _selectedDate.AddDays(-7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(-1),
            _ => _selectedDate.AddDays(-7)
        };
        await LoadBookingsForCurrentViewAsync();
    }

    private async Task NavigateNext()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(1),
            ScheduleViewMode.Week => _selectedDate.AddDays(7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(1),
            _ => _selectedDate.AddDays(7)
        };
        await LoadBookingsForCurrentViewAsync();
    }

    private async Task JumpToToday()
    {
        _selectedDate = DateTime.Today;
        await LoadBookingsForCurrentViewAsync();
    }

    private void ToggleConflictFilter()
    {
        _filterOnlyConflicts = !_filterOnlyConflicts;
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _selectedStatusFilter = string.Empty;
        _selectedServiceTypeFilter = string.Empty;
        _filterOnlyConflicts = false;
        ApplyFilters();
    }

    private void OpenDetailDrawer(EventBookingModel booking)
    {
        _selectedBooking = booking;
    }

    private void CloseDetailDrawer()
    {
        _selectedBooking = null;
    }

    private async Task OpenLinkedEventAsync(string eventAppointmentId)
    {
        if (string.IsNullOrWhiteSpace(eventAppointmentId)) return;
        var cleanId = eventAppointmentId.Trim();

        var match = _loadedBookings.FirstOrDefault(b =>
            string.Equals(b.Id, cleanId, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(b.LinkedEventAppointmentId, cleanId, StringComparison.OrdinalIgnoreCase));

        if (match == null)
        {
            var all = ScheduleService.GetEventBookings(null, null);
            match = all.FirstOrDefault(b =>
                string.Equals(b.Id, cleanId, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(b.LinkedEventAppointmentId, cleanId, StringComparison.OrdinalIgnoreCase));
        }

        if (match != null)
        {
            _selectedDate = match.Date.Date;
            await LoadBookingsForCurrentViewAsync(forceReload: true);
            var refreshed = _loadedBookings.FirstOrDefault(b =>
                string.Equals(b.Id, match.Id, StringComparison.OrdinalIgnoreCase)) ?? match;
            _selectedBooking = refreshed;
            _highlightedEventId = refreshed.Id;
            if (_currentView == ScheduleViewMode.Day)
            {
                _pendingHighlightEventId = refreshed.Id;
            }
            StateHasChanged();
        }
    }

    private async Task HandleRosterUpdatedAsync()
    {
        var activeId = _selectedBooking?.Id;
        ScheduleService.InvalidateCache();
        await LoadBookingsForCurrentViewAsync(forceReload: true);
        if (!string.IsNullOrWhiteSpace(activeId))
        {
            _selectedBooking = _loadedBookings.FirstOrDefault(b => string.Equals(b.Id, activeId, StringComparison.OrdinalIgnoreCase))
                               ?? _selectedBooking;
        }
    }

