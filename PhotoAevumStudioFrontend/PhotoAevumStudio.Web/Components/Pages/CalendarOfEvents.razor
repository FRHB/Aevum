@page "/calendar-of-events"
@page "/admin/calendar/events"
@page "/admin/calendar-of-events"
@page "/calendar/events"
@layout AdminLayout
@rendermode InteractiveServer
@implements IDisposable
@using PhotoAevumStudio.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IScheduleService ScheduleService
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService

<PageTitle>Calendar of Events | Aevum Studio</PageTitle>

<div class="calendar-compact-container">
    @* ── 1. COMPACT PAGE HEADER & METRICS STRIP ───────────────────────── *@
    @if (_isLoadingBookings)
    {
        <div class="text-xs text-gray-500 px-1 py-1">Loading events schedule...</div>
    }
    <div class="calendar-header-strip">
        <div class="header-left">
            <h1 class="header-title">Calendar of Events</h1>
            <div class="metrics-pill-group">
                <span class="metric-pill">
                    <strong>@_totalBookingsCount</strong> total bookings
                </span>
                <span class="metric-pill highlight">
                    <strong>@_thisWeekBookingsCount</strong> this week (@_thisWeekHoursCount.ToString("0.#")h)
                </span>
                @if (_conflictCount > 0)
                {
                    <button type="button"
                            @onclick="ToggleConflictFilter"
                            class="metric-pill conflict-pill @(_filterOnlyConflicts ? "active" : "")">
                        ⚠️ <strong>@_conflictCount</strong> conflict@(_conflictCount == 1 ? "" : "s")
                    </button>
                }
                else
                {
                    <span class="metric-pill clear-pill">✓ No conflicts</span>
                }
            </div>
        </div>

        <div class="header-right">
            @if (!_isPhotographerOrCreative)
            {
                <button type="button" @onclick="OpenCreateModal" class="btn-create-event">
                    <span class="plus-icon">+</span> New Event
                </button>
            }
        </div>
    </div>

    @* ── 2. COMPACT TOOLBAR (Switchers, Navigator, Filters, Search) ────── *@
    <div class="calendar-toolbar">
        <div class="toolbar-left">
            @* View Mode Selector *@
            <div class="view-mode-tabs" role="tablist">
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Day ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Day)">Day</button>
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Week ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Week)">Week</button>
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Month ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Month)">Month</button>
            </div>

            @* Date Range Navigator *@
            <div class="date-navigator">
                <button type="button" @onclick="NavigatePrevious" class="nav-arrow" title="Previous">‹</button>
                <span class="nav-range-label">@FormattedDateRangeHeader</span>
                <button type="button" @onclick="NavigateNext" class="nav-arrow" title="Next">›</button>
                <button type="button" @onclick="JumpToToday" class="nav-today-btn">Today</button>
            </div>
        </div>

        <div class="toolbar-right">
            @* Dropdown Filters *@
            <select value="@_selectedStatusFilter" @onchange="OnStatusFilterChanged" class="toolbar-select">
                <option value="">All Statuses</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
            </select>

            @* Quick Search with Debounce *@
            <div class="search-box">
                <input type="text"
                       value="@_searchQuery"
                       @oninput="OnSearchInput"
                       placeholder="Filter events..."
                       class="toolbar-search-input" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button type="button" @onclick="ClearSearch" class="search-clear-btn">✕</button>
                }
            </div>

            @if (HasActiveFilters)
            {
                <button type="button" @onclick="ClearFilters" class="clear-filters-link">Reset</button>
            }
        </div>
    </div>

    @* ── 3. MAIN COMPACT SCHEDULE VIEW ────────────────────────────────── *@
    @if (_currentView == ScheduleViewMode.Week)
    {
        @* ── HORIZONTAL ROW WEEK VIEW (Vertical Dates on Left, Horizontal Events on Right) ── *@
        <div class="week-horizontal-card">
            @foreach (var day in WeekDays)
            {
                var isToday = day.Date == DateTime.Today;
                var dayBookings = GetBookingsForDate(day.Date);
                var dayEventsCount = dayBookings.Count;

                <div class="week-day-row @(isToday ? "is-today" : "")">
                    @* Vertical Dates on the Left Side *@
                    <div class="week-day-date-col @(isToday ? "is-today" : "")">
                        <span class="day-name">@day.ToString("ddd")</span>
                        <span class="day-number @(isToday ? "today-badge" : "")">@day.Day</span>
                        <span class="day-count">@dayEventsCount @(dayEventsCount == 1 ? "evt" : "evts")</span>
                    </div>

                    @* Horizontal Event Display on the Right *@
                    <div class="week-day-events-track">
                        @if (!dayBookings.Any())
                        {
                            <div class="week-empty-slot">
                                <span class="empty-hint">No events scheduled</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var booking in dayBookings)
                            {
                                <CalendarEventChip Booking="booking" OnClick="() => OpenDetailDrawer(booking)" />
                            }
                        }

                        @if (!_isPhotographerOrCreative)
                        {
                            <button type="button"
                                    @onclick='() => OpenCreateModalForSlot(FilteredStudioSpaces.FirstOrDefault()?.Id ?? "studio-a", day)'
                                    class="week-add-event-btn"
                                    title='Add event for @day.ToString("ddd, MMM d")'>
                                <span class="plus-icon-sm">+</span>
                                <span>Add Event</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_currentView == ScheduleViewMode.Day)
    {
        @* ── DAY VIEW — Agenda-style chronological list ───────────────── *@
        var dayBookings = GetBookingsForDate(_selectedDate.Date);

        <div class="compact-agenda-card">
            @* Date header row *@
            <div class="agenda-date-divider">
                <span>@_selectedDate.ToString("dddd, MMMM d, yyyy")</span>
                <span class="badge-count">@dayBookings.Count session@(dayBookings.Count == 1 ? "" : "s")</span>
            </div>

            @if (!dayBookings.Any())
            {
                <div class="day-empty-agenda">
                    <div class="day-empty-icon">📅</div>
                    <div class="day-empty-title">No sessions scheduled</div>
                    <div class="day-empty-desc">There are no bookings for this day matching your current filters.</div>
                    @if (!_isPhotographerOrCreative)
                    {
                        <div class="day-empty-action">
                            <button type="button"
                                    @onclick='() => OpenCreateModalForSlot(FilteredStudioSpaces.FirstOrDefault()?.Id ?? "studio-a", _selectedDate)'
                                    class="day-quick-add-link">
                                + Book a Session
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="agenda-items-stack">
                    @foreach (var b in dayBookings)
                    {
                        <div @onclick="() => OpenDetailDrawer(b)"
                             class="agenda-item-row cursor-pointer hover:bg-gray-50 @(b.HasConflict ? "conflict-row" : "") @(b.IsConsultation ? "is-consultation-row" : "")">
                            <div class="agenda-time">@b.FormattedTimeRange</div>
                            <div class="agenda-details">
                                <div class="font-bold text-sm">
                                    @if (b.IsConsultation)
                                    {
                                        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-teal-100 text-teal-800 mr-1">💬 Consultation</span>
                                    }
                                    @b.ClientName
                                </div>
                                <div class="text-xs text-gray-500">
                                    @b.ServiceType &bull; @(b.IsConsultation ? "Clerk: " : "📷 ")@b.AssignedPhotographer
                                </div>
                            </div>
                            <div class="agenda-actions">
                                <span class="status-pill text-xs @b.Status.ToLowerInvariant()">@b.Status</span>
                                @if (!b.IsConsultation)
                                {
                                    <span class="text-xs font-bold text-gray-900">₱@b.EstimatedPrice.ToString("F0")</span>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (!_isPhotographerOrCreative)
                {
                    <div class="pt-2 pb-1 px-1 border-t border-dashed border-gray-200 mt-2">
                        <button type="button"
                                @onclick='() => OpenCreateModalForSlot(FilteredStudioSpaces.FirstOrDefault()?.Id ?? "studio-a", _selectedDate)'
                                class="day-quick-add-link">
                            + Add Another Session
                        </button>
                    </div>
                }
            }
        </div>
    }
    else if (_currentView == ScheduleViewMode.Month)
    {
        @* ── COMPACT MONTH CALENDAR ──────────────────────────────────── *@
        <div class="compact-month-card">
            <div class="month-header-grid">
                <div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div><div>Sun</div>
            </div>
            <div class="month-days-grid">
                @foreach (var day in MonthCalendarDays)
                {
                    var isCurrentMonth = day.Month == _selectedDate.Month;
                    var isToday = day.Date == DateTime.Today;
                    var dayEvents = GetBookingsForDate(day.Date).Take(3).ToList();
                    var totalEvts = GetBookingsForDate(day.Date).Count;

                    <div class="month-day-cell @(isCurrentMonth ? "" : "other-month") @(isToday ? "is-today" : "")"
                         @onclick="async () => { _selectedDate = day; await SetViewMode(ScheduleViewMode.Day); }">
                        <div class="month-cell-header">
                            <span class="month-day-num">@day.Day</span>
                            @if (totalEvts > 0)
                            {
                                <span class="month-day-count">@totalEvts @(totalEvts == 1 ? "evt" : "evts")</span>
                            }
                        </div>
                        <div class="month-events-mini">
                            @foreach (var ev in dayEvents)
                            {
                                <div class="mini-event-pill @GetMiniEventBadgeClass(ev)"
                                     title="@ev.FormattedTimeRange: @ev.ClientName (@ev.ServiceType) with @ev.AssignedPhotographer"
                                     @onclick="() => OpenDetailDrawer(ev)"
                                     @onclick:stopPropagation="true">
                                    @(ev.IsConsultation ? "💬 " : "")@ev.StartTime.ToString(@"hh\:mm") @ev.ClientName
                                </div>
                            }
                            @if (totalEvts > 3)
                            {
                                <div class="mini-more-pill">+@(totalEvts - 3) more</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── MODULAR DETAIL DRAWER ────────────────────────────────────────── *@
    <CalendarDetailDrawer Booking="_selectedBooking" OnClose="CloseDetailDrawer" />

    @* ── MODULAR CREATE NEW EVENT MODAL ───────────────────────────────── *@
    @* Fallback state for services: No services currently available *@
    <CalendarCreateModal IsOpen="_isCreateModalOpen"
                         NewEvent="_newEvent"
                         @bind-EventDate="_newEventDate"
                         @bind-StartTime="_newStartTime"
                         @bind-EndTime="_newEndTime"
                         StudioSpaces="StudioSpaces"
                         AvailableServices="AvailableServices"
                         ErrorMessage="@_modalErrorMessage"
                         OnClose="CloseCreateModal"
                         OnSave="SaveNewEvent"
                         OnServiceSelected="OnServiceTypeSelected" />
</div>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _currentUser;
    private string _currentEmployeeName = string.Empty;
    private string _currentEmployeeId = string.Empty;
    private bool _isPhotographerOrCreative;
    private bool _isOfficeClerk;

    private ScheduleViewMode _currentView = ScheduleViewMode.Week;
    private DateTime _selectedDate = DateTime.Today;
    private string _searchQuery = string.Empty;
    private string _selectedStatusFilter = string.Empty;
    private string _selectedServiceTypeFilter = string.Empty;
    private bool _filterOnlyConflicts = false;

    private EventBookingModel? _selectedBooking;
    private bool _isCreateModalOpen;
    private string? _modalErrorMessage;

    private EventBookingModel _newEvent = new();
    private DateTime _newEventDate = DateTime.Today;
    private TimeOnly _newStartTime = new(9, 0);
    private TimeOnly _newEndTime = new(13, 0);

    private List<MainServiceItem> AvailableServices = new();
    private List<StudioSpaceResource> StudioSpaces = new();

    // In-memory window cache and indexed lookups for $O(1)$ fast rendering
    private List<EventBookingModel> _loadedBookings = new();
    private List<EventBookingModel> _filteredBookings = new();
    private ILookup<DateTime, EventBookingModel> _bookingsByDateLookup = Enumerable.Empty<EventBookingModel>().ToLookup(b => b.Date.Date);

    private DateTime? _loadedWindowStart;
    private DateTime? _loadedWindowEnd;

    private int _totalBookingsCount;
    private int _thisWeekBookingsCount;
    private double _thisWeekHoursCount;
    private int _conflictCount;

    private System.Threading.Timer? _debounceTimer;

    private bool _isLoadingBookings = true;
    private bool _hasLoadedInitialData;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            _currentUser = state.User;
        }
        else if (AuthStateProvider != null)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUser = state.User;
        }

        _isOfficeClerk = EmployeeRoleHelper.IsOfficeClerk(_currentUser, UserService);
        _isPhotographerOrCreative = EmployeeRoleHelper.IsPhotographerOrCreative(_currentUser, UserService);
        _currentEmployeeName = EmployeeRoleHelper.GetCurrentEmployeeName(_currentUser, UserService);
        _currentEmployeeId = EmployeeRoleHelper.GetCurrentEmployeeId(_currentUser);

        StudioSpaces = ScheduleService.GetStudioSpaces();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasLoadedInitialData) return;
        _hasLoadedInitialData = true;

        await Task.Run(() =>
        {
            try
            {
                AvailableServices = UserService.GetMainServices().Where(s => s.IsActive).ToList();
            }
            catch
            {
                AvailableServices = new();
            }
        });

        await LoadBookingsForCurrentViewAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void CalculateCurrentRange(out DateTime rangeStart, out DateTime rangeEnd)
    {
        var today = DateTime.Today;
        int diffToMon = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        var curWeekMonday = today.AddDays(-diffToMon);
        var curWeekSunday = curWeekMonday.AddDays(6);

        DateTime viewStart;
        DateTime viewEnd;

        switch (_currentView)
        {
            case ScheduleViewMode.Day:
                viewStart = _selectedDate.Date;
                viewEnd = _selectedDate.Date;
                break;
            case ScheduleViewMode.Week:
                viewStart = WeekDays.First().Date;
                viewEnd = WeekDays.Last().Date;
                break;
            case ScheduleViewMode.Month:
                viewStart = MonthCalendarDays.First().Date;
                viewEnd = MonthCalendarDays.Last().Date;
                break;
            default:
                viewStart = _selectedDate.Date;
                viewEnd = _selectedDate.Date;
                break;
        }

        // Expand bounds to also encompass the current week for dashboard metric accuracy
        rangeStart = viewStart < curWeekMonday ? viewStart : curWeekMonday;
        rangeEnd = viewEnd > curWeekSunday ? viewEnd : curWeekSunday;
    }

    private async Task LoadBookingsForCurrentViewAsync(bool forceReload = false)
    {
        CalculateCurrentRange(out var rangeStart, out var rangeEnd);

        // Check if current view is already covered by the loaded window
        if (!forceReload && _loadedWindowStart.HasValue && _loadedWindowEnd.HasValue &&
            rangeStart >= _loadedWindowStart.Value && rangeEnd <= _loadedWindowEnd.Value)
        {
            _isLoadingBookings = false;
            ApplyFilters();
            return;
        }

        _isLoadingBookings = true;
        // Add 7 days buffer padding on each side to avoid refetching on minor adjacent date navigation
        var queryStart = rangeStart.AddDays(-7);
        var queryEnd = rangeEnd.AddDays(7);

        var rawBookings = await Task.Run(() => ScheduleService.GetEventBookings(queryStart, queryEnd));

        if (_isPhotographerOrCreative)
        {
            _loadedBookings = rawBookings
                .Where(b => EmployeeRoleHelper.IsEventAssignedToEmployee(b, _currentEmployeeName, _currentEmployeeId))
                .ToList();
        }
        else
        {
            _loadedBookings = rawBookings;
        }

        _loadedWindowStart = queryStart;
        _loadedWindowEnd = queryEnd;
        _isLoadingBookings = false;

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = _loadedBookings.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim().ToLowerInvariant();
            query = query.Where(b =>
                (b.ClientName != null && b.ClientName.ToLowerInvariant().Contains(q)) ||
                (b.ServiceType != null && b.ServiceType.ToLowerInvariant().Contains(q)) ||
                (b.StudioSpaceName != null && b.StudioSpaceName.ToLowerInvariant().Contains(q)) ||
                (b.AssignedPhotographer != null && b.AssignedPhotographer.ToLowerInvariant().Contains(q)) ||
                (b.Notes != null && b.Notes.ToLowerInvariant().Contains(q)));
        }

        if (!string.IsNullOrEmpty(_selectedStatusFilter))
            query = query.Where(b => b.Status.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(_selectedServiceTypeFilter))
            query = query.Where(b => b.ServiceType.Equals(_selectedServiceTypeFilter, StringComparison.OrdinalIgnoreCase));

        if (_filterOnlyConflicts)
            query = query.Where(b => b.HasConflict);

        _filteredBookings = query.ToList();
        _bookingsByDateLookup = _filteredBookings.ToLookup(b => b.Date.Date);

        // Calculate metrics once
        var today = DateTime.Today;
        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        var monday = today.AddDays(-diff);
        var sunday = monday.AddDays(6);

        _totalBookingsCount = _loadedBookings.Count;
        var thisWeekList = _loadedBookings.Where(b => b.Date.Date >= monday && b.Date.Date <= sunday).ToList();
        _thisWeekBookingsCount = thisWeekList.Count;
        _thisWeekHoursCount = thisWeekList.Sum(b => b.DurationHours);
        _conflictCount = _loadedBookings.Count(b => b.HasConflict);
    }

    private List<EventBookingModel> GetBookingsForDate(DateTime date) =>
        _bookingsByDateLookup[date.Date].OrderBy(b => b.StartTime).ToList();

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                ApplyFilters();
                StateHasChanged();
            });
        }, null, 180, Timeout.Infinite);
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        ApplyFilters();
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        _selectedStatusFilter = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private void OnServiceTypeSelected(ChangeEventArgs e)
    {
        var title = e.Value?.ToString() ?? string.Empty;
        _newEvent.ServiceType = title;
        var match = AvailableServices.FirstOrDefault(s => string.Equals(s.Title, title, StringComparison.OrdinalIgnoreCase));
        if (match != null && match.BasePrice > 0)
        {
            _newEvent.EstimatedPrice = match.BasePrice;
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_searchQuery) ||
        !string.IsNullOrEmpty(_selectedStatusFilter) ||
        !string.IsNullOrEmpty(_selectedServiceTypeFilter) ||
        _filterOnlyConflicts;

    private List<DateTime> WeekDays
    {
        get
        {
            int diff = (7 + (_selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
            var monday = _selectedDate.AddDays(-1 * diff);
            return Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
        }
    }

    private List<DateTime> MonthCalendarDays
    {
        get
        {
            var firstOfMonth = new DateTime(_selectedDate.Year, _selectedDate.Month, 1);
            int diff = (7 + (firstOfMonth.DayOfWeek - DayOfWeek.Monday)) % 7;
            var start = firstOfMonth.AddDays(-1 * diff);
            var lastOfMonth = firstOfMonth.AddMonths(1).AddDays(-1);
            int daysNeeded = (lastOfMonth - start).Days + 1;
            int totalDays = (int)Math.Ceiling(daysNeeded / 7.0) * 7;
            if (totalDays < 35) totalDays = 35;
            return Enumerable.Range(0, totalDays).Select(i => start.AddDays(i)).ToList();
        }
    }

    private string GetMiniEventBadgeClass(EventBookingModel ev)
    {
        if (ev.HasConflict) return "conflict";
        if (ev.IsConsultation) return "consultation";
        return ev.Status.ToLowerInvariant() switch
        {
            "confirmed" => "confirmed",
            "pending" => "pending",
            "completed" => "completed",
            _ => ""
        };
    }

    private string FormattedDateRangeHeader => _currentView switch
    {
        ScheduleViewMode.Day => _selectedDate.ToString("MMMM d, yyyy"),
        ScheduleViewMode.Week => $"{WeekDays.First():MMM d} – {WeekDays.Last():MMM d, yyyy}",
        ScheduleViewMode.Month => _selectedDate.ToString("MMMM yyyy"),
        _ => _selectedDate.ToString("MMMM yyyy")
    };

    private IEnumerable<StudioSpaceResource> FilteredStudioSpaces => StudioSpaces;

    private async Task SetViewMode(ScheduleViewMode mode)
    {
        _currentView = mode;
        await LoadBookingsForCurrentViewAsync();
    }

    private async Task NavigatePrevious()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(-1),
            ScheduleViewMode.Week => _selectedDate.AddDays(-7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(-1),
            _ => _selectedDate.AddDays(-7)
        };
        await LoadBookingsForCurrentViewAsync();
    }

    private async Task NavigateNext()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(1),
            ScheduleViewMode.Week => _selectedDate.AddDays(7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(1),
            _ => _selectedDate.AddDays(7)
        };
        await LoadBookingsForCurrentViewAsync();
    }

    private async Task JumpToToday()
    {
        _selectedDate = DateTime.Today;
        await LoadBookingsForCurrentViewAsync();
    }

    private void ToggleConflictFilter()
    {
        _filterOnlyConflicts = !_filterOnlyConflicts;
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _selectedStatusFilter = string.Empty;
        _selectedServiceTypeFilter = string.Empty;
        _filterOnlyConflicts = false;
        ApplyFilters();
    }

    private void OpenDetailDrawer(EventBookingModel booking)
    {
        _selectedBooking = booking;
    }

    private void CloseDetailDrawer()
    {
        _selectedBooking = null;
    }

    private void OpenCreateModal()
    {
        var defaultSvc = AvailableServices.FirstOrDefault();
        _newEvent = new EventBookingModel
        {
            StudioSpaceId = StudioSpaces.FirstOrDefault()?.Id ?? "studio-a",
            ServiceType = defaultSvc?.Title ?? string.Empty,
            Status = "Confirmed",
            AssignedPhotographer = "Elena Rostova",
            EstimatedPrice = defaultSvc?.BasePrice ?? 0.00m
        };
        _newEventDate = _selectedDate;
        _newStartTime = new TimeOnly(9, 0);
        _newEndTime = new TimeOnly(13, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void OpenCreateModalForSlot(string spaceId, DateTime date)
    {
        var defaultSvc = AvailableServices.FirstOrDefault();
        _newEvent = new EventBookingModel
        {
            StudioSpaceId = spaceId,
            Date = date,
            ServiceType = defaultSvc?.Title ?? string.Empty,
            Status = "Confirmed",
            AssignedPhotographer = "Elena Rostova",
            EstimatedPrice = defaultSvc?.BasePrice ?? 0.00m
        };
        _newEventDate = date;
        _newStartTime = new TimeOnly(10, 0);
        _newEndTime = new TimeOnly(13, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private async Task SaveNewEvent()
    {
        if (string.IsNullOrWhiteSpace(_newEvent.ClientName))
        {
            _modalErrorMessage = "Please enter a client or production name.";
            return;
        }

        if (_newEndTime <= _newStartTime)
        {
            _modalErrorMessage = "Session end time must be after start time.";
            return;
        }

        _newEvent.Date = _newEventDate;
        _newEvent.StartTime = _newStartTime.ToTimeSpan();
        _newEvent.EndTime = _newEndTime.ToTimeSpan();

        ScheduleService.AddEventBooking(_newEvent);
        _isCreateModalOpen = false;
        _modalErrorMessage = null;

        await LoadBookingsForCurrentViewAsync(forceReload: true);
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
