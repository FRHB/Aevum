</div>

@code {
    private ScheduleViewMode _currentView = ScheduleViewMode.Week;
    private DateTime _selectedDate = DateTime.Today;
    private string _searchQuery = string.Empty;
    private string _selectedSpaceFilter = string.Empty;
    private string _selectedStatusFilter = string.Empty;
    private string _selectedServiceTypeFilter = string.Empty;
    private bool _filterOnlyConflicts = false;

    private EventBookingModel? _selectedBooking;
    private bool _isCreateModalOpen;
    private string? _modalErrorMessage;

    // Creation model state
    private EventBookingModel _newEvent = new();
    private DateTime _newEventDate = DateTime.Today;
    private TimeOnly _newStartTime = new(9, 0);
    private TimeOnly _newEndTime = new(13, 0);

    private List<StudioSpaceResource> StudioSpaces => ScheduleService.GetStudioSpaces();
    private List<EventBookingModel> AllBookings => ScheduleService.GetEventBookings();

    private int ConflictCount => ScheduleService.GetEventConflictCount();
    private int TotalBookingsCount => AllBookings.Count;
    private int ThisWeekBookingsCount => AllBookings.Count(b => WeekDays.Any(w => w.Date == b.Date.Date));
    private double ThisWeekHoursCount => AllBookings.Where(b => WeekDays.Any(w => w.Date == b.Date.Date)).Sum(b => b.DurationHours);

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_searchQuery) ||
        !string.IsNullOrEmpty(_selectedSpaceFilter) ||
        !string.IsNullOrEmpty(_selectedStatusFilter) ||
        !string.IsNullOrEmpty(_selectedServiceTypeFilter) ||
        _filterOnlyConflicts;

    private List<DateTime> WeekDays
    {
        get
        {
            int diff = (7 + (_selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
            var monday = _selectedDate.AddDays(-1 * diff);
            return Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
        }
    }

    private List<DateTime> MonthCalendarDays
    {
        get
        {
            var firstOfMonth = new DateTime(_selectedDate.Year, _selectedDate.Month, 1);
            int diff = (7 + (firstOfMonth.DayOfWeek - DayOfWeek.Monday)) % 7;
            var start = firstOfMonth.AddDays(-1 * diff);
            return Enumerable.Range(0, 35).Select(i => start.AddDays(i)).ToList();
        }
    }

    private string FormattedDateRangeHeader => _currentView switch
    {
        ScheduleViewMode.Day => _selectedDate.ToString("MMMM d, yyyy"),
        ScheduleViewMode.Week => $"{WeekDays.First():MMM d} – {WeekDays.Last():MMM d, yyyy}",
        ScheduleViewMode.Month => _selectedDate.ToString("MMMM yyyy"),
        ScheduleViewMode.Agenda => $"{_selectedDate:MMM d} – {_selectedDate.AddDays(14):MMM d, yyyy}",
        _ => _selectedDate.ToString("MMMM yyyy")
    };

    private IEnumerable<StudioSpaceResource> FilteredStudioSpaces
    {
        get
        {
            if (string.IsNullOrEmpty(_selectedSpaceFilter))
                return StudioSpaces;
            return StudioSpaces.Where(s => s.Id == _selectedSpaceFilter);
        }
    }

    private IEnumerable<EventBookingModel> FilteredBookings
    {
        get
        {
            var query = AllBookings.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(b =>
                    b.ClientName.ToLowerInvariant().Contains(q) ||
                    b.ServiceType.ToLowerInvariant().Contains(q) ||
                    b.StudioSpaceName.ToLowerInvariant().Contains(q) ||
                    b.AssignedPhotographer.ToLowerInvariant().Contains(q) ||
                    b.Notes.ToLowerInvariant().Contains(q));
            }

            if (!string.IsNullOrEmpty(_selectedSpaceFilter))
                query = query.Where(b => b.StudioSpaceId == _selectedSpaceFilter);

            if (!string.IsNullOrEmpty(_selectedStatusFilter))
                query = query.Where(b => b.Status.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_selectedServiceTypeFilter))
                query = query.Where(b => b.ServiceType.Equals(_selectedServiceTypeFilter, StringComparison.OrdinalIgnoreCase));

            if (_filterOnlyConflicts)
                query = query.Where(b => b.HasConflict);

            return query;
        }
    }

    private IEnumerable<IGrouping<DateTime, EventBookingModel>> AgendaGroupedBookings =>
        FilteredBookings
            .Where(b => b.Date.Date >= _selectedDate.Date && b.Date.Date <= _selectedDate.Date.AddDays(14))
            .OrderBy(b => b.Date)
            .ThenBy(b => b.StartTime)
            .GroupBy(b => b.Date.Date);

    private IEnumerable<EventBookingModel> GetEventsForDay(DateTime day) =>
        FilteredBookings.Where(b => b.Date.Date == day.Date);

    private IEnumerable<EventBookingModel> GetEventsForSpace(string spaceId) =>
        FilteredBookings.Where(b => b.StudioSpaceId == spaceId);

    private void SetViewMode(ScheduleViewMode mode)
    {
        _currentView = mode;
    }

    private void NavigatePrevious()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(-1),
            ScheduleViewMode.Week => _selectedDate.AddDays(-7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(-1),
            ScheduleViewMode.Agenda => _selectedDate.AddDays(-14),
            _ => _selectedDate.AddDays(-7)
        };
    }

    private void NavigateNext()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(1),
            ScheduleViewMode.Week => _selectedDate.AddDays(7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(1),
            ScheduleViewMode.Agenda => _selectedDate.AddDays(14),
            _ => _selectedDate.AddDays(7)
        };
    }

    private void JumpToToday()
    {
        _selectedDate = DateTime.Today;
    }

    private void ToggleConflictFilter()
    {
        _filterOnlyConflicts = !_filterOnlyConflicts;
    }

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _selectedSpaceFilter = string.Empty;
        _selectedStatusFilter = string.Empty;
        _selectedServiceTypeFilter = string.Empty;
        _filterOnlyConflicts = false;
    }

    private void OpenDetailDrawer(EventBookingModel booking)
    {
        _selectedBooking = booking;
    }

    private void CloseDetailDrawer()
    {
        _selectedBooking = null;
    }

    private void UpdateBookingStatus(string newStatus)
    {
        if (_selectedBooking != null)
        {
            _selectedBooking.Status = newStatus;
            ScheduleService.UpdateEventBooking(_selectedBooking);
        }
    }

    private void DeleteSelectedBooking()
    {
        if (_selectedBooking != null)
        {
            ScheduleService.DeleteEventBooking(_selectedBooking.Id);
            _selectedBooking = null;
        }
    }

    private void OpenCreateModal()
    {
        _newEvent = new EventBookingModel
        {
            StudioSpaceId = StudioSpaces.FirstOrDefault()?.Id ?? "studio-a",
            ServiceType = "Full Studio Session",
            Status = "Confirmed",
            AssignedPhotographer = "Elena Rostova",
            EstimatedPrice = 500.00m
        };
        _newEventDate = _selectedDate;
        _newStartTime = new TimeOnly(9, 0);
        _newEndTime = new TimeOnly(13, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void OpenCreateModalForSlot(string spaceId, DateTime date)
    {
        _newEvent = new EventBookingModel
        {
            StudioSpaceId = spaceId,
            Date = date,
            ServiceType = "Express Headshot",
            Status = "Confirmed",
            AssignedPhotographer = "Elena Rostova",
            EstimatedPrice = 350.00m
        };
        _newEventDate = date;
        _newStartTime = new TimeOnly(10, 0);
        _newEndTime = new TimeOnly(13, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private void SaveNewEvent()
    {
        if (string.IsNullOrWhiteSpace(_newEvent.ClientName))
        {
            _modalErrorMessage = "Please enter a client or production name.";
            return;
        }

        if (_newEndTime <= _newStartTime)
        {
            _modalErrorMessage = "Session end time must be after start time.";
            return;
        }

        _newEvent.Date = _newEventDate;
        _newEvent.StartTime = _newStartTime.ToTimeSpan();
        _newEvent.EndTime = _newEndTime.ToTimeSpan();

        ScheduleService.AddEventBooking(_newEvent);
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private string GetBookingCardStyle(EventBookingModel booking)
    {
        if (booking.HasConflict)
            return "bg-rose-50/90 border-rose-300 text-rose-950 ring-1 ring-rose-400";

        return booking.Status.ToLowerInvariant() switch
        {
            "confirmed" => "bg-emerald-50/70 border-emerald-200 text-emerald-950",
            "pending" => "bg-amber-50/70 border-amber-200 text-amber-950",
            "completed" => "bg-gray-100 border-gray-200 text-gray-800",
            _ => "bg-blue-50/70 border-blue-200 text-blue-950"
        };
    }

    private string GetStatusBadgeStyle(string status) => status.ToLowerInvariant() switch
    {
        "confirmed" => "bg-emerald-100 text-emerald-800 border border-emerald-300",
        "pending" => "bg-amber-100 text-amber-800 border border-amber-300",
        "completed" => "bg-gray-200 text-gray-700",
        _ => "bg-blue-100 text-blue-800 border border-blue-300"
    };

    private string GetSpaceDotColor(string spaceId) => spaceId switch
    {
        "studio-a" => "bg-blue-500",
        "studio-b" => "bg-indigo-500",
        "studio-c" => "bg-emerald-500",
        "outdoor-shoot" => "bg-amber-500",
        "wedding-venue" => "bg-purple-500",
        _ => "bg-gray-400"
    };
}
