@page "/calendar-of-events"
@page "/admin/calendar/events"
@page "/admin/calendar-of-events"
@page "/calendar/events"
@layout AdminLayout
@rendermode InteractiveServer
@implements IDisposable
@using PhotoAevumStudio.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IScheduleService ScheduleService
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService
@inject IEmployeeService EmployeeService
@inject IJSRuntime JS

<PageTitle>Calendar of Events | Aevum Studio</PageTitle>

<div class="calendar-compact-container">
    @* ── 1. COMPACT PAGE HEADER & METRICS STRIP ───────────────────────── *@
    @if (_isLoadingBookings)
    {
        <div class="text-xs text-gray-500 px-1 py-1">Loading events schedule...</div>
    }
    <div class="calendar-header-strip">
        <div class="header-left">
            <h1 class="header-title">Calendar of Events</h1>
            <div class="metrics-pill-group">
                <span class="metric-pill">
                    <strong>@_totalBookingsCount</strong> total bookings
                </span>
                <span class="metric-pill highlight">
                    <strong>@_thisWeekBookingsCount</strong> this week (@_thisWeekHoursCount.ToString("0.#")h)
                </span>
                @if (_conflictCount > 0)
                {
                    <button type="button"
                            @onclick="ToggleConflictFilter"
                            class="metric-pill conflict-pill @(_filterOnlyConflicts ? "active" : "")">
                        ⚠️ <strong>@_conflictCount</strong> conflict@(_conflictCount == 1 ? "" : "s")
                    </button>
                }
                else
                {
                    <span class="metric-pill clear-pill">✓ No conflicts</span>
                }
            </div>
        </div>

        <div class="header-right">
            @if (!_isPhotographerOrCreative)
            {
                <button type="button" @onclick="OpenCreateModal" class="btn-create-event">
                    <span class="plus-icon">+</span> New Event
                </button>
            }
        </div>
    </div>

    @* ── 2. COMPACT TOOLBAR (Switchers, Navigator, Filters, Search) ────── *@
    <div class="calendar-toolbar">
        <div class="toolbar-left">
            @* View Mode Selector *@
            <div class="view-mode-tabs" role="tablist">
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Day ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Day)">Day</button>
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Week ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Week)">Week</button>
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Month ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Month)">Month</button>
            </div>

            @* Date Range Navigator *@
            <div class="date-navigator">
                <button type="button" @onclick="NavigatePrevious" class="nav-arrow" title="Previous">‹</button>
                <span class="nav-range-label">@FormattedDateRangeHeader</span>
                <button type="button" @onclick="NavigateNext" class="nav-arrow" title="Next">›</button>
                <button type="button" @onclick="JumpToToday" class="nav-today-btn">Today</button>
            </div>
        </div>

        <div class="toolbar-right">
            @* Dropdown Filters *@
            <select value="@_selectedStatusFilter" @onchange="OnStatusFilterChanged" class="toolbar-select">
                <option value="">All Statuses</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Appointment Booked">Appointment Booked</option>
                <option value="Pending Payment">Pending Payment</option>
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
            </select>

            @* Quick Search with Debounce *@
            <div class="search-box">
                <input type="text"
                       value="@_searchQuery"
                       @oninput="OnSearchInput"
                       placeholder="Filter events..."
                       class="toolbar-search-input" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button type="button" @onclick="ClearSearch" class="search-clear-btn">✕</button>
                }
            </div>

            @if (HasActiveFilters)
            {
                <button type="button" @onclick="ClearFilters" class="clear-filters-link">Reset</button>
            }
        </div>
    </div>

    @* ── 3. MAIN COMPACT SCHEDULE VIEW ────────────────────────────────── *@
    @if (_currentView == ScheduleViewMode.Week)
    {
        @* ── HORIZONTAL ROW WEEK VIEW (Vertical Dates on Left, Horizontal Events on Right) ── *@
        <div class="week-horizontal-card">
            @foreach (var day in WeekDays)
            {
                var isToday = day.Date == DateTime.Today;
                var dayBookings = GetBookingsForDate(day.Date);
                var dayEventsCount = dayBookings.Count;

                <div class="week-day-row @(isToday ? "is-today" : "")">
                    @* Vertical Dates on the Left Side *@
                    <div class="week-day-date-col @(isToday ? "is-today" : "")">
                        <span class="day-name">@day.ToString("ddd")</span>
                        <span class="day-number @(isToday ? "today-badge" : "")">@day.Day</span>
                        <span class="day-count">@dayEventsCount @(dayEventsCount == 1 ? "evt" : "evts")</span>
                    </div>

                    @* Horizontal Event Display on the Right *@
                    <div class="week-day-events-track">
                        @if (!dayBookings.Any())
                        {
                            <div class="week-empty-slot">
                                <span class="empty-hint">No events scheduled</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var booking in dayBookings)
                            {
                                <CalendarEventChip Booking="booking" OnClick="() => HandleWeekEventClick(booking)" />
                            }
                        }

                        @if (!_isPhotographerOrCreative)
                        {
                            <button type="button"
                                    @onclick='() => OpenCreateModalForSlot(FilteredStudioSpaces.FirstOrDefault()?.Id ?? "studio-a", day)'
                                    class="week-add-event-btn"
                                    title='Add event for @day.ToString("ddd, MMM d")'>
                                <span class="plus-icon-sm">+</span>
                                <span>Add Event</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_currentView == ScheduleViewMode.Day)
    {
        @* ── DAY VIEW — Tabular Gantt / Time-Blocked Timetable ─────────── *@
        var dayBookings = GetBookingsForDate(_selectedDate.Date);
        var (startHour, endHour) = GetDayTimelineBounds(dayBookings);
        var timelineHours = Enumerable.Range(startHour, endHour - startHour).ToList();
        var totalMinutes = (endHour - startHour) * 60.0;

        <div class="compact-agenda-card day-timetable-card">
            <div class="agenda-date-divider">
                <div class="flex items-center gap-2 flex-wrap">
                    <span>@_selectedDate.ToString("dddd, MMMM d, yyyy")</span>
                    @if (_selectedDate.Date == DateTime.Today)
                    {
                        <span class="day-today-pill">Today</span>
                    }
                    <span class="badge-count">@dayBookings.Count session@(dayBookings.Count == 1 ? "" : "s")</span>
                </div>
                @if (!_isPhotographerOrCreative)
                {
                    <button type="button"
                            @onclick='() => OpenCreateModalForSlot(FilteredStudioSpaces.FirstOrDefault()?.Id ?? "studio-a", _selectedDate)'
                            class="day-quick-add-link">
                        + Book Session
                    </button>
                }
            </div>

            @if (!dayBookings.Any())
            {
                <div class="day-empty-agenda">
                    <div class="day-empty-icon">📅</div>
                    <div class="day-empty-title">No sessions scheduled</div>
                    <div class="day-empty-desc">There are no bookings for this day matching your current filters.</div>
                    @if (!_isPhotographerOrCreative)
                    {
                        <div class="day-empty-action">
                            <button type="button"
                                    @onclick='() => OpenCreateModalForSlot(FilteredStudioSpaces.FirstOrDefault()?.Id ?? "studio-a", _selectedDate)'
                                    class="day-quick-add-link">
                                + Book a Session
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="day-gantt-wrapper">
                    <table class="day-gantt-table" aria-label="Daily tabular event timetable">
                        <colgroup>
                            <col style="width: 260px;" />
                            @foreach (var _ in timelineHours)
                            {
                                <col />
                            }
                        </colgroup>
                        <thead>
                            <tr>
                                <th class="gantt-event-col-header">Event &amp; Assigned Staff</th>
                                @foreach (var hour in timelineHours)
                                {
                                    <th class="gantt-hour-header">@FormatHourLabel(hour)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in dayBookings)
                            {
                                var startMin = Math.Max(0, (b.StartTime.TotalMinutes - startHour * 60.0));
                                var rawEndMin = b.EffectiveEndTime.TotalMinutes;
                                var endMin = Math.Min(totalMinutes, Math.Max(startMin + 20, rawEndMin - startHour * 60.0));
                                var leftPct = totalMinutes > 0 ? Math.Clamp((startMin / totalMinutes) * 100.0, 0.0, 96.0) : 0;
                                var widthPct = totalMinutes > 0 ? Math.Clamp(((endMin - startMin) / totalMinutes) * 100.0, 4.0, 100.0 - leftPct) : 10.0;
                                var isHighlighted = string.Equals(_highlightedEventId, b.Id, StringComparison.OrdinalIgnoreCase);

                                <tr id="day-event-row-@b.Id"
                                    data-event-id="@b.Id"
                                    @onclick="() => OpenDetailDrawer(b)"
                                    class="day-gantt-row @(b.HasConflict ? "conflict-row" : "") @(b.IsConsultation ? "is-consultation-row" : "") @(isHighlighted ? "event-row-highlighted" : "")">
                                    <td class="gantt-event-meta-cell">
                                        <div class="gantt-meta-top">
                                            <span class="gantt-client-name">
                                                @if (b.IsConsultation)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-teal-100 text-teal-800 mr-1">💬 Consultation</span>
                                                }
                                                @b.ClientName
                                            </span>
                                            <span class="status-pill text-[10px] @GetDayRowStatusPillClass(b)">@b.DisplayStatus</span>
                                        </div>
                                        <div class="gantt-meta-sub">
                                            <span>@b.ServiceType</span>
                                            <span>&bull;</span>
                                            <span>@(b.IsConsultation ? "Clerk: " : "📷 ")@b.AssignedPhotographer</span>
                                            @if (!b.IsConsultation && b.AssignedEquipmentIds.Count > 0)
                                            {
                                                <span>&bull;</span>
                                                <span class="text-slate-600 font-semibold">🎒 @b.AssignedEquipmentIds.Count gear</span>
                                            }
                                        </div>
                                        <div class="gantt-meta-time">
                                            <span>@b.FormattedTimeRange</span>
                                            @if (b.HasConflict)
                                            {
                                                <span class="text-rose-700 font-bold ml-2">⚠️ Conflict</span>
                                            }
                                            @if (!b.IsConsultation && b.EstimatedPrice > 0 && !_isPhotographerOrCreative)
                                            {
                                                <span class="ml-auto font-bold text-gray-800">₱@b.EstimatedPrice.ToString("F0")</span>
                                            }
                                        </div>
                                    </td>
                                    <td colspan="@timelineHours.Count" class="gantt-timeline-cell">
                                        <div class="gantt-timeline-track">
                                            <div class="gantt-grid-backdrop" style="--hour-cols: @timelineHours.Count;">
                                                @foreach (var _ in timelineHours)
                                                {
                                                    <span class="gantt-grid-slot"></span>
                                                }
                                            </div>
                                            <button type="button"
                                                    @onclick="() => OpenDetailDrawer(b)"
                                                    @onclick:stopPropagation="true"
                                                    class="gantt-time-block @GetMiniEventBadgeClass(b)"
                                                    style="left: @leftPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%; width: @widthPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;"
                                                    title="@b.FormattedTimeRange — @b.ClientName (@b.ServiceType) with @b.AssignedPhotographer">
                                                <span class="gantt-block-time">@DateTime.Today.Add(b.StartTime).ToString("h:mm tt") – @DateTime.Today.Add(b.EffectiveEndTime).ToString("h:mm tt")</span>
                                                <span class="gantt-block-label">@b.ClientName (@b.ServiceType)</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!_isPhotographerOrCreative)
                {
                    <div class="pt-2 pb-1 px-1 border-t border-dashed border-gray-200 mt-2">
                        <button type="button"
                                @onclick='() => OpenCreateModalForSlot(FilteredStudioSpaces.FirstOrDefault()?.Id ?? "studio-a", _selectedDate)'
                                class="day-quick-add-link">
                            + Add Another Session
                        </button>
                    </div>
                }
            }
        </div>
    }
    else if (_currentView == ScheduleViewMode.Month)
    {
        @* ── COMPACT MONTH CALENDAR ──────────────────────────────────── *@
        <div class="compact-month-card">
            <div class="month-header-grid">
                <div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div><div>Sun</div>
            </div>
            <div class="month-days-grid">
                @foreach (var day in MonthCalendarDays)
                {
                    var isCurrentMonth = day.Month == _selectedDate.Month;
                    var isToday = day.Date == DateTime.Today;
                    var dayEvents = GetBookingsForDate(day.Date).Take(3).ToList();
                    var totalEvts = GetBookingsForDate(day.Date).Count;

                    <div class="month-day-cell @(isCurrentMonth ? "" : "other-month") @(isToday ? "is-today" : "")">
                        <div class="month-cell-header"
                             @onclick="() => NavigateToDayTimetable(day)"
                             title="View @day.ToString("MMM d") Day timetable">
                            <span class="month-day-num">@day.Day</span>
                            @if (totalEvts > 0)
                            {
                                <span class="month-day-count">@totalEvts @(totalEvts == 1 ? "evt" : "evts")</span>
                            }
                        </div>
                        <div class="month-events-mini">
                            @foreach (var ev in dayEvents)
                            {
                                <button type="button"
                                        class="mini-event-pill @GetMiniEventBadgeClass(ev)"
                                        title="@ev.FormattedTimeRange: @ev.ClientName (@ev.ServiceType) with @ev.AssignedPhotographer"
                                        @onclick="() => OpenDetailDrawer(ev)"
                                        @onclick:stopPropagation="true">
                                    @(ev.IsConsultation ? "💬 " : "")@DateTime.Today.Add(ev.StartTime).ToString("h:mm tt") @ev.ClientName
                                </button>
                            }
                            @if (totalEvts > 3)
                            {
                                <button type="button"
                                        class="mini-more-pill"
                                        @onclick="() => NavigateToDayTimetable(day)"
                                        @onclick:stopPropagation="true">
                                    +@(totalEvts - 3) more
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── 4. COLLAPSIBLE STAFF SCHEDULE & LEAVE ADMIN PANEL ──────────── *@
    @if (!_isPhotographerOrCreative)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var displayedLeaves = _showAllLeavesHistory
            ? _allLeaves
            : _allLeaves
                .Where(l => string.Equals(l.Status, "Pending", StringComparison.OrdinalIgnoreCase)
                         || (string.Equals(l.Status, "Approved", StringComparison.OrdinalIgnoreCase) && l.EndDate >= today))
                .OrderBy(l => string.Equals(l.Status, "Pending", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(l => l.StartDate)
                .ToList();
        var pagedLeaves = TablePagination.Paginate(displayedLeaves, _leavesPage, 10);
        var pagedStaffDirectory = TablePagination.Paginate(_staffDirectory, _daysOffPage, 10);
        var pendingCount = _allLeaves.Count(l => string.Equals(l.Status, "Pending", StringComparison.OrdinalIgnoreCase));
        var activeUpcomingCount = _allLeaves.Count(l => string.Equals(l.Status, "Approved", StringComparison.OrdinalIgnoreCase) && l.EndDate >= today);

        <section class="staff-schedule-collapsible" aria-label="Staff Schedule and Leave Management">
            <button type="button"
                    class="staff-schedule-toggle"
                    @onclick="ToggleStaffScheduleSection"
                    aria-expanded="@_isStaffScheduleExpanded"
                    aria-controls="staff-schedule-admin-body">
                <div class="flex items-center gap-3 flex-wrap">
                    <span class="staff-schedule-chevron @(_isStaffScheduleExpanded ? "is-open" : "")" aria-hidden="true">›</span>
                    <div class="text-left">
                        <div class="text-sm font-extrabold text-gray-900">Staff Schedule</div>
                        <div class="text-[11px] text-gray-500 font-normal">Upcoming &amp; ongoing leaves, leave approvals, and staff scheduled days off</div>
                    </div>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    @if (pendingCount > 0)
                    {
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-200">
                            @pendingCount Pending
                        </span>
                    }
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-teal-50 text-teal-800 border border-teal-200">
                        @activeUpcomingCount Active / Upcoming Leaves
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                        @_staffDirectory.Count Staff
                    </span>
                </div>
            </button>

            @if (_isStaffScheduleExpanded)
            {
                <div id="staff-schedule-admin-body" class="staff-schedule-body">
                    <SystemMessage Message="@_staffScheduleFeedback" Severity="@(_staffScheduleIsError ? "error" : "success")" Mode="banner" OnDismiss="() => _staffScheduleFeedback = null" />

                    @* ── Upcoming & Ongoing Leaves Table ── *@
                    <div class="space-y-2">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                            <div>
                                <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-700">Upcoming &amp; Ongoing Leaves</h3>
                                <p class="text-[11px] text-gray-500">Approved leaves automatically block staff assignment in the booking engine during their timeframe.</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button"
                                        @onclick="() => SetLeavesHistoryFilter(false)"
                                        class="px-2.5 py-1 rounded text-[11px] font-semibold border @(!_showAllLeavesHistory ? "bg-gray-900 text-white border-gray-900" : "bg-white text-gray-600 border-gray-200")">
                                    Upcoming &amp; Pending
                                </button>
                                <button type="button"
                                        @onclick="() => SetLeavesHistoryFilter(true)"
                                        class="px-2.5 py-1 rounded text-[11px] font-semibold border @(_showAllLeavesHistory ? "bg-gray-900 text-white border-gray-900" : "bg-white text-gray-600 border-gray-200")">
                                    All Records (@_allLeaves.Count)
                                </button>
                                <button type="button"
                                        @onclick="LoadStaffScheduleDataAsync"
                                        disabled="@_isLoadingStaffSchedule"
                                        class="px-2.5 py-1 rounded text-[11px] font-semibold bg-gray-100 hover:bg-gray-200 text-gray-700">
                                    @(_isLoadingStaffSchedule ? "Loading..." : "Refresh")
                                </button>
                            </div>
                        </div>

                        <div class="overflow-x-auto border border-gray-200 rounded-lg">
                            <table class="w-full text-left text-xs border-collapse">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-200 text-[11px] font-bold uppercase tracking-wider text-gray-500">
                                        <th class="py-2.5 px-3">Employee</th>
                                        <th class="py-2.5 px-3">Leave Type</th>
                                        <th class="py-2.5 px-3">Timeframe</th>
                                        <th class="py-2.5 px-3">Description</th>
                                        <th class="py-2.5 px-3">Status</th>
                                        <th class="py-2.5 px-3 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 bg-white">
                                    @if (_isLoadingStaffSchedule && displayedLeaves.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" class="py-6 text-center text-gray-400">Loading staff leave schedule...</td>
                                        </tr>
                                    }
                                    else if (displayedLeaves.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" class="py-6 text-center text-gray-400 italic">No upcoming, ongoing, or pending leave requests found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var lv in pagedLeaves)
                                        {
                                            var isOngoing = string.Equals(lv.Status, "Approved", StringComparison.OrdinalIgnoreCase) && lv.StartDate <= today && lv.EndDate >= today;
                                            <tr class="hover:bg-gray-50/70">
                                                <td class="py-2.5 px-3">
                                                    <div class="font-bold text-gray-900">@lv.EmployeeName</div>
                                                    <div class="text-[10px] font-mono text-gray-400">@lv.EmployeeStudioId</div>
                                                </td>
                                                <td class="py-2.5 px-3 font-semibold text-gray-800">@lv.LeaveType</td>
                                                <td class="py-2.5 px-3 font-mono text-gray-700 whitespace-nowrap">
                                                    @lv.StartDate.ToString("MMM d") – @lv.EndDate.ToString("MMM d, yyyy")
                                                </td>
                                                <td class="py-2.5 px-3 text-gray-600 max-w-xs truncate" title="@lv.Reason">
                                                    @(string.IsNullOrWhiteSpace(lv.Reason) ? "—" : lv.Reason)
                                                </td>
                                                <td class="py-2.5 px-3">
                                                    @if (isOngoing)
                                                    {
                                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-100 text-teal-900 border border-teal-200">Ongoing Leave</span>
                                                    }
                                                    else if (string.Equals(lv.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Approved (Upcoming)</span>
                                                    }
                                                    else if (string.Equals(lv.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800" title="@lv.RejectionReason">Rejected</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900">Pending</span>
                                                    }
                                                </td>
                                                <td class="py-2.5 px-3 text-right whitespace-nowrap">
                                                    @if (string.Equals(lv.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <div class="inline-flex items-center gap-1.5">
                                                            <button type="button"
                                                                    disabled="@_isProcessingLeaveAction"
                                                                    @onclick="() => ApproveLeaveRequestAsync(lv)"
                                                                    class="px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-bold disabled:opacity-50">
                                                                Approve
                                                            </button>
                                                            <button type="button"
                                                                    disabled="@_isProcessingLeaveAction"
                                                                    @onclick="() => OpenRejectLeaveModal(lv)"
                                                                    class="px-2.5 py-1 rounded bg-rose-600 hover:bg-rose-700 text-white text-[11px] font-bold disabled:opacity-50">
                                                                Reject
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-[11px] text-gray-400">@(string.IsNullOrWhiteSpace(lv.ApprovedBy) ? "Reviewed" : $"By {lv.ApprovedBy}")</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                            <TablePagination TotalItems="displayedLeaves.Count" PageSize="10" @bind-CurrentPage="_leavesPage" ItemLabel="leave requests" />
                        </div>
                    </div>

                    @* ── Staff Scheduled Days Off Table ── *@
                    <div class="space-y-2 pt-2 border-t border-gray-100">
                        <div>
