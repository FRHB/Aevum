    private async Task HandleWeekEventClick(EventBookingModel booking)
    {
        _selectedDate = booking.Date.Date;
        _highlightedEventId = booking.Id;
        _pendingHighlightEventId = booking.Id;
        _selectedBooking = booking;

        _highlightTimer?.Dispose();
        _highlightTimer = new System.Threading.Timer(_ =>
        {
