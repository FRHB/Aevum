@page "/calendar-of-events"
@page "/admin/calendar/events"
@page "/admin/calendar-of-events"
@page "/calendar/events"
@layout AdminLayout
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IScheduleService ScheduleService
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService

<PageTitle>Calendar of Events | Aevum Studio</PageTitle>

<div class="calendar-compact-container">
    @* ── 1. COMPACT PAGE HEADER & METRICS STRIP ───────────────────────── *@
    <div class="calendar-header-strip">
        <div class="header-left">
            <h1 class="header-title">Calendar of Events</h1>
            <div class="metrics-pill-group">
                <span class="metric-pill">
                    <strong>@TotalBookingsCount</strong> total bookings
                </span>
                <span class="metric-pill highlight">
                    <strong>@ThisWeekBookingsCount</strong> this week (@ThisWeekHoursCount.ToString("0.#")h)
                </span>
                <span class="metric-pill">
                    <strong>@StudioSpaces.Count</strong> spaces
                </span>
                @if (ConflictCount > 0)
                {
                    <button type="button"
                            @onclick="ToggleConflictFilter"
                            class="metric-pill conflict-pill @(_filterOnlyConflicts ? "active" : "")">
                        ⚠️ <strong>@ConflictCount</strong> conflict@(ConflictCount == 1 ? "" : "s")
                    </button>
                }
                else
                {
                    <span class="metric-pill clear-pill">✓ No conflicts</span>
                }
            </div>
        </div>

        <div class="header-right">
            @if (!_isPhotographerOrCreative)
            {
                <button type="button" @onclick="OpenCreateModal" class="btn-create-event">
                    <span class="plus-icon">+</span> New Event
                </button>
            }
        </div>
    </div>

    @* ── 2. COMPACT TOOLBAR (Switchers, Navigator, Filters, Search) ────── *@
    <div class="calendar-toolbar">
        <div class="toolbar-left">
            @* View Mode Selector *@
            <div class="view-mode-tabs" role="tablist">
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Day ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Day)">Day</button>
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Week ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Week)">Week</button>
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Month ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Month)">Month</button>
                <button type="button" class="tab-btn @(_currentView == ScheduleViewMode.Agenda ? "active" : "")"
                        @onclick="() => SetViewMode(ScheduleViewMode.Agenda)">Agenda</button>
            </div>

            @* Date Range Navigator *@
            <div class="date-navigator">
                <button type="button" @onclick="NavigatePrevious" class="nav-arrow" title="Previous">‹</button>
                <span class="nav-range-label">@FormattedDateRangeHeader</span>
                <button type="button" @onclick="NavigateNext" class="nav-arrow" title="Next">›</button>
                <button type="button" @onclick="JumpToToday" class="nav-today-btn">Today</button>
            </div>
        </div>

        <div class="toolbar-right">
            @* Dropdown Filters *@
            <select @bind="_selectedSpaceFilter" class="toolbar-select">
                <option value="">All Spaces</option>
                @foreach (var space in StudioSpaces)
                {
                    <option value="@space.Id">@space.Name</option>
                }
            </select>

            <select @bind="_selectedStatusFilter" class="toolbar-select">
                <option value="">All Statuses</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
            </select>

            @* Quick Search *@
            <div class="search-box">
                <input type="text"
                       @bind="_searchQuery"
                       @bind:event="oninput"
                       placeholder="Filter events..."
                       class="toolbar-search-input" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button type="button" @onclick="() => _searchQuery = string.Empty" class="search-clear-btn">✕</button>
                }
            </div>

            @if (HasActiveFilters)
            {
                <button type="button" @onclick="ClearFilters" class="clear-filters-link">Reset</button>
            }
        </div>
    </div>

    @* ── 3. MAIN COMPACT SCHEDULE VIEW ────────────────────────────────── *@
    @if (_currentView == ScheduleViewMode.Week)
    {
        @* ── HIGH-DENSITY COMPACT WEEK MATRIX ────────────────────────── *@
        <div class="compact-matrix-card">
            <div class="matrix-scroll-wrapper">
                <table class="compact-matrix-table">
                    <thead>
                        <tr>
                            <th class="col-space-header">Studio Space</th>
                            @foreach (var day in WeekDays)
                            {
                                var isToday = day.Date == DateTime.Today;
                                var dayEventsCount = GetEventsForDay(day).Count();
                                <th class="col-day-header @(isToday ? "is-today" : "")">
                                    <div class="day-heading">
                                        <span class="day-name">@day.ToString("ddd")</span>
                                        <span class="day-number @(isToday ? "today-badge" : "")">@day.Day</span>
                                        <span class="day-count">@dayEventsCount @(dayEventsCount == 1 ? "evt" : "evts")</span>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var space in FilteredStudioSpaces)
                        {
                            <tr>
                                @* Space Name Column *@
                                <td class="col-space-info">
                                    <div class="space-title-row">
                                        <span class="space-dot @GetSpaceDotColor(space.Id)"></span>
                                        <span class="space-name">@space.Name</span>
                                    </div>
                                    <div class="space-sub-meta">
                                        <span>@space.Dimensions</span> &bull; <span>Cap @space.MaxCapacity</span>
                                    </div>
                                </td>

                                @* 7 Days Columns *@
                                @foreach (var day in WeekDays)
                                {
                                    var dayBookings = FilteredBookings
                                        .Where(b => b.StudioSpaceId == space.Id && b.Date.Date == day.Date)
                                        .OrderBy(b => b.StartTime)
                                        .ToList();

                                    <td class="col-day-cell">
                                        <div class="cell-events-stack">
                                            @foreach (var booking in dayBookings)
                                            {
                                                <div @onclick="() => OpenDetailDrawer(booking)"
                                                     title="@booking.ClientName (@booking.ServiceType) with @booking.AssignedPhotographer"
                                                     class="compact-event-chip @(booking.IsConsultation ? "is-consultation-chip" : "") @(booking.HasConflict ? "conflict-chip" : "") @(booking.Status.ToLowerInvariant())">
                                                    <div class="chip-top-row">
                                                        <span class="chip-time">@(booking.IsConsultation ? "💬 " : "")@booking.StartTime.ToString(@"hh\:mm")</span>
                                                        <span class="chip-status-dot"></span>
                                                    </div>
                                                    <div class="chip-client">@booking.ClientName</div>
                                                    <div class="chip-photog">@(booking.IsConsultation ? "Clerk: " : "📷 ")@booking.AssignedPhotographer</div>
                                                </div>
                                            }
                                            @if (!_isPhotographerOrCreative)
                                            {
                                                <button type="button"
                                                        @onclick="() => OpenCreateModalForSlot(space.Id, day)"
                                                        class="cell-add-btn" title="Add event in this slot">+</button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (_currentView == ScheduleViewMode.Day)
    {
        @* ── HIGH-DENSITY DAY VIEW ───────────────────────────────────── *@
        <div class="compact-day-grid">
            @foreach (var space in FilteredStudioSpaces)
            {
                var dayEvents = FilteredBookings
                    .Where(b => b.StudioSpaceId == space.Id && b.Date.Date == _selectedDate.Date)
                    .OrderBy(b => b.StartTime)
                    .ToList();

                <div class="compact-space-card">
                    <div class="space-card-header">
                        <div class="flex items-center gap-2">
                            <span class="space-dot @GetSpaceDotColor(space.Id)"></span>
                            <span class="font-bold text-sm">@space.Name</span>
                        </div>
                        <span class="text-xs text-gray-500">@dayEvents.Count event@(dayEvents.Count == 1 ? "" : "s")</span>
                    </div>

                    <div class="space-card-body">
                        @if (dayEvents.Any())
                        {
                            <div class="day-events-list">
                                @foreach (var ev in dayEvents)
                                {
                                    <div @onclick="() => OpenDetailDrawer(ev)"
                                         class="day-event-row @(ev.IsConsultation ? "border-l-4 border-l-teal-600 bg-teal-50/40" : "") @(ev.HasConflict ? "conflict-chip" : "") @(ev.Status.ToLowerInvariant())">
                                        <div class="event-time-badge">@ev.FormattedTimeRange</div>
                                        <div class="event-info">
                                            <div class="font-bold text-xs">
                                                @if (ev.IsConsultation)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-teal-100 text-teal-800 mr-1">Consultation</span>
                                                }
                                                @ev.ClientName
                                            </div>
                                            <div class="text-[11px] text-gray-500">@ev.ServiceType &bull; @(ev.IsConsultation ? "Clerk: " : "")@ev.AssignedPhotographer</div>
                                        </div>
                                        <span class="status-pill text-[10px]">@ev.Status</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-day-slot">
                                <span>No events scheduled</span>
                                @if (!_isPhotographerOrCreative)
                                {
                                    <button type="button" @onclick="() => OpenCreateModalForSlot(space.Id, _selectedDate)" class="text-xs text-blue-600 underline">+ Book</button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_currentView == ScheduleViewMode.Month)
    {
        @* ── COMPACT MONTH CALENDAR ──────────────────────────────────── *@
        <div class="compact-month-card">
            <div class="month-header-grid">
                <div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div><div>Sun</div>
            </div>
            <div class="month-days-grid">
                @foreach (var day in MonthCalendarDays)
                {
                    var isCurrentMonth = day.Month == _selectedDate.Month;
                    var isToday = day.Date == DateTime.Today;
                    var dayEvents = GetEventsForDay(day).Take(3).ToList();
                    var totalEvts = GetEventsForDay(day).Count();

                    <div class="month-day-cell @(isCurrentMonth ? "" : "other-month") @(isToday ? "is-today" : "")"
                         @onclick="() => { _selectedDate = day; SetViewMode(ScheduleViewMode.Day); }">
                        <span class="month-day-num">@day.Day</span>
                        <div class="month-events-mini">
                            @foreach (var ev in dayEvents)
                            {
                                <div class="mini-event-pill @(ev.IsConsultation ? "bg-teal-50 text-teal-800 border border-teal-200" : "") @(ev.HasConflict ? "conflict" : "")">
                                    @(ev.IsConsultation ? "💬 " : "")@ev.StartTime.ToString(@"hh\:mm") @ev.ClientName
                                </div>
                            }
                            @if (totalEvts > 3)
                            {
                                <div class="mini-more-pill">+@(totalEvts - 3) more</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (_currentView == ScheduleViewMode.Agenda)
    {
        @* ── COMPACT AGENDA VIEW ─────────────────────────────────────── *@
        <div class="compact-agenda-card">
            @if (!AgendaGroupedBookings.Any())
            {
                <div class="p-8 text-center text-gray-500 text-sm">
                    No scheduled sessions in this date window matching your filters.
                </div>
            }
            else
            {
                <div class="agenda-list">
                    @foreach (var group in AgendaGroupedBookings)
                    {
                        <div class="agenda-group">
                            <div class="agenda-date-divider">
                                <span>@group.Key.ToString("dddd, MMMM d, yyyy")</span>
                                <span class="badge-count">@group.Count() session(s)</span>
                            </div>
                            <div class="agenda-items-stack">
                                @foreach (var b in group)
                                {
                                    <div @onclick="() => OpenDetailDrawer(b)" class="agenda-item-row cursor-pointer hover:bg-gray-50">
                                        <div class="agenda-time">@b.FormattedTimeRange</div>
                                        <div class="agenda-details">
                                            <div class="font-bold text-sm">@b.ClientName</div>
                                            <div class="text-xs text-gray-500">@b.ServiceType &bull; @b.StudioSpaceName &bull; 📷 @b.AssignedPhotographer</div>
                                        </div>
                                        <div class="agenda-actions">
                                            <span class="status-pill text-xs">@b.Status</span>
                                            <span class="text-xs font-bold text-gray-900">$@b.EstimatedPrice.ToString("F0")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── DETAIL DRAWER (Slide-over for compact details) ───────────────── *@
    @if (_selectedBooking != null)
    {
        <div class="drawer-backdrop" @onclick="CloseDetailDrawer">
            <div class="compact-detail-drawer" @onclick:stopPropagation="true">
                <div class="drawer-header">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="status-pill text-xs">@_selectedBooking.Status</span>
                            @if (_selectedBooking.HasConflict)
                            {
                                <span class="badge-conflict">⚠️ Conflict</span>
                            }
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mt-1">@_selectedBooking.ClientName</h3>
                    </div>
                    <button type="button" @onclick="CloseDetailDrawer" class="drawer-close-btn">✕</button>
                </div>

                <div class="drawer-body">
                    @if (_selectedBooking.IsConsultation)
                    {
                        <div class="drawer-field">
                            <span class="drawer-field-label">Type</span>
                            <span class="drawer-field-val inline-flex items-center gap-1 font-bold text-teal-700 bg-teal-50 px-2 py-0.5 rounded border border-teal-200">
                                <span>💬</span> Consultation &amp; Inquiry Call
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_selectedBooking.MeetingLink))
                        {
                            <div class="drawer-field">
                                <span class="drawer-field-label">Meeting Room</span>
                                <div class="drawer-field-val">
                                    <a href="@_selectedBooking.MeetingLink" target="_blank"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold rounded-lg transition-colors shadow-xs">
                                        <span>📹</span> Join Video Call
                                    </a>
                                </div>
                            </div>
                        }
                    }
                    <div class="drawer-field">
                        <span class="drawer-field-label">Service</span>
                        <span class="drawer-field-val">@_selectedBooking.ServiceType</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-field-label">Studio Bay</span>
                        <span class="drawer-field-val">@_selectedBooking.StudioSpaceName</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-field-label">Schedule</span>
                        <span class="drawer-field-val">@_selectedBooking.Date.ToString("ddd, MMM d, yyyy") (@_selectedBooking.FormattedTimeRange)</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-field-label">Photographer</span>
                        <span class="drawer-field-val">@_selectedBooking.AssignedPhotographer</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-field-label">Price</span>
                        <span class="drawer-field-val font-bold">$@_selectedBooking.EstimatedPrice.ToString("N2")</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_selectedBooking.Notes))
                    {
                        <div class="drawer-field">
                            <span class="drawer-field-label">Notes</span>
                            <span class="drawer-field-val italic text-xs">@_selectedBooking.Notes</span>
                        </div>
                    }

                    @if (!_isPhotographerOrCreative)
                    {
                        <div class="drawer-actions-section mt-4 pt-4 border-t">
                            <span class="text-xs font-bold text-gray-600 block mb-2">Update Status</span>
                            <div class="flex gap-2">
                                <button type="button" @onclick='() => UpdateBookingStatus("Confirmed")' class="btn-status-toggle">Confirm</button>
                                <button type="button" @onclick='() => UpdateBookingStatus("Completed")' class="btn-status-toggle">Complete</button>
                                <button type="button" @onclick="DeleteSelectedBooking" class="btn-status-danger">Cancel Event</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ── CREATE NEW EVENT MODAL ───────────────────────────────────────── *@
    @if (_isCreateModalOpen)
    {
        <div class="drawer-backdrop" @onclick="CloseCreateModal">
            <div class="compact-modal" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3 class="font-bold text-base">Schedule New Event</h3>
                    <button type="button" @onclick="CloseCreateModal" class="drawer-close-btn">✕</button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_modalErrorMessage))
                    {
                        <div class="p-2 mb-3 bg-rose-50 text-rose-800 text-xs rounded border border-rose-200">
                            @_modalErrorMessage
                        </div>
                    }

                    <div class="form-group mb-2">
                        <label class="form-label text-xs">Client / Production Name</label>
                        <input type="text" @bind="_newEvent.ClientName" class="form-control text-xs" placeholder="e.g. Acme Corp Shoot" />
                    </div>

                    <div class="grid grid-cols-2 gap-2 mb-2">
                        <div>
                            <label class="form-label text-xs">Studio Space</label>
                            <select @bind="_newEvent.StudioSpaceId" class="form-control text-xs">
                                @foreach (var s in StudioSpaces)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label text-xs">Service Type</label>
                            <select @bind="_newEvent.ServiceType" class="form-control text-xs">
                                <option value="Express Headshot">Express Headshot</option>
                                <option value="Full Studio Session">Full Studio Session</option>
                                <option value="Commercial Campaign">Commercial Campaign</option>
                                <option value="Bridal Prep">Bridal Prep</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-2 mb-2">
                        <div>
                            <label class="form-label text-xs">Date</label>
                            <input type="date" @bind="_newEventDate" class="form-control text-xs" />
                        </div>
                        <div>
                            <label class="form-label text-xs">Start</label>
                            <input type="time" @bind="_newStartTime" class="form-control text-xs" />
                        </div>
                        <div>
                            <label class="form-label text-xs">End</label>
                            <input type="time" @bind="_newEndTime" class="form-control text-xs" />
                        </div>
                    </div>

                    <div class="modal-footer pt-3 mt-3 border-t flex justify-end gap-2">
                        <button type="button" @onclick="CloseCreateModal" class="btn btn-sm btn-outline-secondary">Cancel</button>
                        <button type="button" @onclick="SaveNewEvent" class="btn btn-sm btn-dark">Save Event</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _currentUser;
    private string _currentEmployeeName = string.Empty;
    private string _currentEmployeeId = string.Empty;
    private bool _isPhotographerOrCreative;
    private bool _isOfficeClerk;

    private ScheduleViewMode _currentView = ScheduleViewMode.Week;
    private DateTime _selectedDate = DateTime.Today;
    private string _searchQuery = string.Empty;
    private string _selectedSpaceFilter = string.Empty;
    private string _selectedStatusFilter = string.Empty;
    private string _selectedServiceTypeFilter = string.Empty;
    private bool _filterOnlyConflicts = false;

    private EventBookingModel? _selectedBooking;
    private bool _isCreateModalOpen;
    private string? _modalErrorMessage;

    private EventBookingModel _newEvent = new();
    private DateTime _newEventDate = DateTime.Today;
    private TimeOnly _newStartTime = new(9, 0);
    private TimeOnly _newEndTime = new(13, 0);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            _currentUser = state.User;
        }
        else if (AuthStateProvider != null)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUser = state.User;
        }

        _isOfficeClerk = EmployeeRoleHelper.IsOfficeClerk(_currentUser, UserService);
        _isPhotographerOrCreative = EmployeeRoleHelper.IsPhotographerOrCreative(_currentUser, UserService);
        _currentEmployeeName = EmployeeRoleHelper.GetCurrentEmployeeName(_currentUser, UserService);
        _currentEmployeeId = EmployeeRoleHelper.GetCurrentEmployeeId(_currentUser);
    }

    private List<StudioSpaceResource> StudioSpaces => ScheduleService.GetStudioSpaces();
    private List<EventBookingModel> AllBookings => _isPhotographerOrCreative
        ? ScheduleService.GetEventBookings().Where(b => EmployeeRoleHelper.IsEventAssignedToEmployee(b, _currentEmployeeName, _currentEmployeeId)).ToList()
        : ScheduleService.GetEventBookings();

    private int ConflictCount => _isPhotographerOrCreative
        ? AllBookings.Count(b => b.HasConflict)
        : ScheduleService.GetEventConflictCount();
    private int TotalBookingsCount => AllBookings.Count;
    private int ThisWeekBookingsCount => AllBookings.Count(b => WeekDays.Any(w => w.Date == b.Date.Date));
    private double ThisWeekHoursCount => AllBookings.Where(b => WeekDays.Any(w => w.Date == b.Date.Date)).Sum(b => b.DurationHours);

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_searchQuery) ||
        !string.IsNullOrEmpty(_selectedSpaceFilter) ||
        !string.IsNullOrEmpty(_selectedStatusFilter) ||
        !string.IsNullOrEmpty(_selectedServiceTypeFilter) ||
        _filterOnlyConflicts;

    private List<DateTime> WeekDays
    {
        get
        {
            int diff = (7 + (_selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
            var monday = _selectedDate.AddDays(-1 * diff);
            return Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
        }
    }

    private List<DateTime> MonthCalendarDays
    {
        get
        {
            var firstOfMonth = new DateTime(_selectedDate.Year, _selectedDate.Month, 1);
            int diff = (7 + (firstOfMonth.DayOfWeek - DayOfWeek.Monday)) % 7;
            var start = firstOfMonth.AddDays(-1 * diff);
            return Enumerable.Range(0, 35).Select(i => start.AddDays(i)).ToList();
        }
    }

    private string FormattedDateRangeHeader => _currentView switch
    {
        ScheduleViewMode.Day => _selectedDate.ToString("MMMM d, yyyy"),
        ScheduleViewMode.Week => $"{WeekDays.First():MMM d} – {WeekDays.Last():MMM d, yyyy}",
        ScheduleViewMode.Month => _selectedDate.ToString("MMMM yyyy"),
        ScheduleViewMode.Agenda => $"{_selectedDate:MMM d} – {_selectedDate.AddDays(14):MMM d, yyyy}",
        _ => _selectedDate.ToString("MMMM yyyy")
    };

    private IEnumerable<StudioSpaceResource> FilteredStudioSpaces
    {
        get
        {
            if (string.IsNullOrEmpty(_selectedSpaceFilter))
                return StudioSpaces;
            return StudioSpaces.Where(s => s.Id == _selectedSpaceFilter);
        }
    }

    private IEnumerable<EventBookingModel> FilteredBookings
    {
        get
        {
            var query = AllBookings.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(b =>
                    b.ClientName.ToLowerInvariant().Contains(q) ||
                    b.ServiceType.ToLowerInvariant().Contains(q) ||
                    b.StudioSpaceName.ToLowerInvariant().Contains(q) ||
                    b.AssignedPhotographer.ToLowerInvariant().Contains(q) ||
                    b.Notes.ToLowerInvariant().Contains(q));
            }

            if (!string.IsNullOrEmpty(_selectedSpaceFilter))
                query = query.Where(b => b.StudioSpaceId == _selectedSpaceFilter);

            if (!string.IsNullOrEmpty(_selectedStatusFilter))
                query = query.Where(b => b.Status.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_selectedServiceTypeFilter))
                query = query.Where(b => b.ServiceType.Equals(_selectedServiceTypeFilter, StringComparison.OrdinalIgnoreCase));

            if (_filterOnlyConflicts)
                query = query.Where(b => b.HasConflict);

            return query;
        }
    }

    private IEnumerable<IGrouping<DateTime, EventBookingModel>> AgendaGroupedBookings =>
        FilteredBookings
            .Where(b => b.Date.Date >= _selectedDate.Date && b.Date.Date <= _selectedDate.Date.AddDays(14))
            .OrderBy(b => b.Date)
            .ThenBy(b => b.StartTime)
            .GroupBy(b => b.Date.Date);

    private IEnumerable<EventBookingModel> GetEventsForDay(DateTime day) =>
        FilteredBookings.Where(b => b.Date.Date == day.Date);

    private void SetViewMode(ScheduleViewMode mode)
    {
        _currentView = mode;
    }

    private void NavigatePrevious()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(-1),
            ScheduleViewMode.Week => _selectedDate.AddDays(-7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(-1),
            ScheduleViewMode.Agenda => _selectedDate.AddDays(-14),
            _ => _selectedDate.AddDays(-7)
        };
    }

    private void NavigateNext()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(1),
            ScheduleViewMode.Week => _selectedDate.AddDays(7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(1),
            ScheduleViewMode.Agenda => _selectedDate.AddDays(14),
            _ => _selectedDate.AddDays(7)
        };
    }

    private void JumpToToday()
    {
        _selectedDate = DateTime.Today;
    }

    private void ToggleConflictFilter()
    {
        _filterOnlyConflicts = !_filterOnlyConflicts;
    }

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _selectedSpaceFilter = string.Empty;
        _selectedStatusFilter = string.Empty;
        _selectedServiceTypeFilter = string.Empty;
        _filterOnlyConflicts = false;
    }

    private void OpenDetailDrawer(EventBookingModel booking)
    {
        _selectedBooking = booking;
    }

    private void CloseDetailDrawer()
    {
        _selectedBooking = null;
    }

    private void UpdateBookingStatus(string newStatus)
    {
        if (_selectedBooking != null)
        {
            _selectedBooking.Status = newStatus;
            ScheduleService.UpdateEventBooking(_selectedBooking);
        }
    }

    private void DeleteSelectedBooking()
    {
        if (_selectedBooking != null)
        {
            ScheduleService.DeleteEventBooking(_selectedBooking.Id);
            _selectedBooking = null;
        }
    }

    private void OpenCreateModal()
    {
        _newEvent = new EventBookingModel
        {
            StudioSpaceId = StudioSpaces.FirstOrDefault()?.Id ?? "studio-a",
            ServiceType = "Full Studio Session",
            Status = "Confirmed",
            AssignedPhotographer = "Elena Rostova",
            EstimatedPrice = 500.00m
        };
        _newEventDate = _selectedDate;
        _newStartTime = new TimeOnly(9, 0);
        _newEndTime = new TimeOnly(13, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void OpenCreateModalForSlot(string spaceId, DateTime date)
    {
        _newEvent = new EventBookingModel
        {
            StudioSpaceId = spaceId,
            Date = date,
            ServiceType = "Express Headshot",
            Status = "Confirmed",
            AssignedPhotographer = "Elena Rostova",
            EstimatedPrice = 350.00m
        };
        _newEventDate = date;
        _newStartTime = new TimeOnly(10, 0);
        _newEndTime = new TimeOnly(13, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private void SaveNewEvent()
    {
        if (string.IsNullOrWhiteSpace(_newEvent.ClientName))
        {
            _modalErrorMessage = "Please enter a client or production name.";
            return;
        }

        if (_newEndTime <= _newStartTime)
        {
            _modalErrorMessage = "Session end time must be after start time.";
            return;
        }

        _newEvent.Date = _newEventDate;
        _newEvent.StartTime = _newStartTime.ToTimeSpan();
        _newEvent.EndTime = _newEndTime.ToTimeSpan();

        ScheduleService.AddEventBooking(_newEvent);
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private string GetSpaceDotColor(string spaceId) => spaceId switch
    {
        "studio-a" => "bg-blue-500",
        "studio-b" => "bg-indigo-500",
        "studio-c" => "bg-emerald-500",
        "outdoor-shoot" => "bg-amber-500",
        "wedding-venue" => "bg-purple-500",
        _ => "bg-gray-400"
    };
