@page "/my/bookings"
@layout CustomerLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PhotoAevumStudio.Web.Services
@inject IUserService UserService
@attribute [Authorize(Roles = "Customer")]

<PageTitle>My Bookings</PageTitle>

<div class="max-w-4xl mx-auto py-10 px-6">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">My Bookings</h1>
        <a href="/my" class="text-teal-600 hover:underline">Back to Portal</a>
    </div>

    @if (!Bookings.Any())
    {
        <div class="bg-white border border-gray-200 rounded-xl p-12 text-center shadow-sm">
            <h2 class="text-lg font-semibold text-gray-800 mb-1">No Bookings Found</h2>
            <p class="text-sm text-gray-500 mb-4">You have not scheduled any photography sessions yet.</p>
            <a href="/my/book" class="inline-block bg-teal-600 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-teal-700">Book a Session</a>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var booking in Bookings)
            {
                <div class="bg-white border rounded-xl p-6 shadow-sm flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-bold text-gray-900">@booking.ServiceTitle</h2>
                        <p class="text-gray-500 text-sm mt-1">@booking.EventDateTime.ToString("MMM dd, yyyy • hh:mm tt") • ₱@booking.TotalPrice.ToString("N2")</p>
                        <div class="mt-3">
                            <span class="@(booking.Status == "Delivered" || booking.Status == "Confirmed" ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800") text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                                @booking.Status
                            </span>
                        </div>
                    </div>
                    @if (string.Equals(booking.Status, "Delivered", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="/my/gallery/@booking.BookingId" class="bg-teal-50 text-teal-700 hover:bg-teal-100 px-4 py-2 rounded-md font-semibold text-sm transition-colors">
                            View Gallery
                        </a>
                    }
                    else if (string.Equals(booking.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <button @onclick='() => CancelBooking(booking.BookingId)' class="text-red-500 hover:bg-red-50 px-4 py-2 rounded-md font-semibold text-sm transition-colors border border-transparent hover:border-red-200">
                            Cancel
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? customerId;
    private List<BookingRow> Bookings = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            customerId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                      ?? state.User.FindFirst("sub")?.Value;
        }
        LoadBookings();
    }

    private void LoadBookings()
    {
        Bookings = UserService.GetBookings(customerId);
    }

    private void CancelBooking(string bookingId)
    {
        UserService.UpdateBookingStatus(bookingId, "Cancelled");
        LoadBookings();
    }
}
