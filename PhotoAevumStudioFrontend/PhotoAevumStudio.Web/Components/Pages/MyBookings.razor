@page "/my/bookings"
@layout CustomerLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@implements IDisposable
@inject IBookScheduleClient Api
@inject IConsultationClient ConsultationApi
@inject IScheduleService ScheduleService
@inject BookingEvents Events
@inject AuthenticationStateProvider AuthStateProvider
@inject PaymentHubClient PaymentHub
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Customer")]

<PageTitle>My Bookings - Photo Aevum Studio</PageTitle>

<div class="max-w-4xl mx-auto py-10 px-6">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900">My Bookings</h1>
            <p class="text-xs text-slate-500 mt-1">Manage your photoshoot sessions, reservation fees, and event schedules.</p>
        </div>
        <a href="/my" class="text-teal-600 hover:underline font-semibold text-sm">Back to Portal &rarr;</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_customerActionFeedback))
    {
        <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-semibold flex items-center justify-between gap-3">
            <span>✓ @_customerActionFeedback</span>
            <button type="button" @onclick="() => _customerActionFeedback = null" class="text-emerald-700 hover:text-emerald-950 font-bold">✕</button>
        </div>
    }

    @* Prominent Awaiting 15% Deposit Notification Cards *@
    @if (_awaitingAppointments.Any())
    {
        <div class="mb-8 space-y-4">
            @foreach (var appt in _awaitingAppointments)
            {
                <div class="bg-amber-50/90 border border-amber-200 rounded-2xl p-6 shadow-sm">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div class="space-y-1.5">
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold @(_isExpired ? "bg-red-200 text-red-900" : "bg-amber-200 text-amber-900")">
                                    @(_isExpired ? "⚠️ Reservation Hold Expired" : "⏳ 30-Min Reservation Hold Active")
                                </span>
                                <span class="font-mono text-xs font-bold @(_isExpired ? "text-red-700" : "text-amber-800")">
                                    #@appt.EventAppointmentId
                                </span>
                            </div>
                            <h2 class="text-lg font-black text-slate-900">
                                15% Reservation Deposit Required for @appt.EventName
                            </h2>
                            <p class="text-xs text-slate-600">
                                Settle your 15% reservation fee within 30 minutes to lock your reserved crew and studio equipment.
                            </p>
                            <div class="flex flex-wrap items-center gap-3 text-xs font-semibold text-slate-700 pt-1">
                                <span>Total Package: <strong>₱@appt.TotalAmount.ToString("N2")</strong></span>
                                <span class="text-slate-300">•</span>
                                <span class="text-emerald-700 font-bold">15% Deposit: <strong>₱@appt.DownpaymentAmount.ToString("N2")</strong></span>
                                <span class="text-slate-300">•</span>
                                <span>Remaining Balance (85%): <strong>₱@appt.FinalBalanceAmount.ToString("N2")</strong> <span class="text-[10px] text-slate-500 font-normal">(due on event date)</span></span>
                            </div>
                        </div>

                        <!-- Hold Countdown & Action Buttons -->
                        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0">
                            <div class="text-center px-4 py-2 rounded-xl bg-white border @(_isExpired ? "border-red-200 text-red-700" : "border-amber-200 text-amber-800") shadow-xs w-full sm:w-auto">
                                <div class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Hold Timer</div>
                                <div class="font-mono text-xl font-black">@_countdownDisplay</div>
                            </div>

                            @if (!_isExpired)
                            {
                                <div class="flex flex-col gap-2 w-full sm:w-auto">
                                    <a href="/payments/@appt.EventAppointmentId"
                                       class="px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold shadow-sm transition-all text-center">
                                        @(appt.ContractAcceptedAtUtc.HasValue ? "💳 Pay 15% Deposit (QR Ph) →" : "📄 Review Contract & Pay Deposit →")
                                    </a>
                                    <button type="button" @onclick='() => OpenDocsModal(appt.EventAppointmentId, "contract", true)'
                                            class="px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 rounded-lg text-[11px] font-bold transition-all">
                                        Preview Agreement &amp; Terms
                                    </button>
                                    <div class="flex gap-2">
                                        <button type="button" @onclick="() => SimulatePaymentSuccessAsync(appt.EventAppointmentId)"
                                                disabled="@_isActionBusy"
                                                class="flex-1 px-3 py-1.5 bg-amber-600 hover:bg-amber-700 disabled:opacity-50 text-white rounded-lg text-[11px] font-bold shadow-xs transition-all text-center">
                                            ⚡ Simulate Webhook
                                        </button>
                                        <button type="button" @onclick="() => VerifyPaymentAsync(appt.EventAppointmentId)"
                                                disabled="@_isActionBusy"
                                                class="px-3 py-1.5 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 rounded-lg text-[11px] font-semibold transition-all">
                                            🔄 Refresh
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" @onclick="() => RequestExtensionAsync(appt.EventAppointmentId)"
                                        disabled="@_isActionBusy"
                                        class="px-4 py-2.5 bg-amber-600 hover:bg-amber-700 disabled:opacity-50 text-white rounded-lg text-xs font-bold shadow-sm transition-all text-center">
                                    Request 30-Min Extension
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* Confirmed & Active Shoot Events (immediately shows "Completed" on Cash Received / QR Paid) *@
    @if (_customerEvents.Any())
    {
        <div class="mb-8 space-y-4">
            <h2 class="text-lg font-bold text-slate-900">Photoshoot Events &amp; Status</h2>
            @foreach (var ev in _customerEvents)
            {
                var displayStatus = GetCustomerEventDisplayStatus(ev);
                <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-mono text-xs font-bold text-slate-500">#@ev.EventAppointmentId</span>
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold @(displayStatus == "Completed" || displayStatus == "Complete" || displayStatus == "Confirmed" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                @displayStatus
                            </span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900">@ev.EventName</h3>
                        <p class="text-xs text-slate-500 mt-0.5">@ev.EventDate.ToString("MMM dd, yyyy") &bull; @DateTime.Today.Add(ev.EventTime.ToTimeSpan()).ToString("h:mm tt")</p>
                    </div>
                    <div class="text-right text-xs flex flex-col items-end gap-2">
                        <div>
                            <div class="text-slate-500">Total: <strong class="text-slate-900">₱@((ev.TotalAmount + ev.OvertimeAmount).ToString("N2"))</strong></div>
                            <div class="text-slate-500">Final Balance: <strong class="text-slate-900">₱@((ev.IsDeliverablesUnlocked ? 0m : (ev.RemainingBalance > 0 ? ev.RemainingBalance : ev.FinalBalanceAmount)).ToString("N2"))</strong></div>
                        </div>
                        <div class="flex flex-wrap items-center justify-end gap-2">
                            <button type="button"
                                    @onclick='() => OpenDocsModal(ev.EventAppointmentId, "receipts", false)'
                                    class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 text-xs font-bold transition-colors">
                                📄 Agreement &amp; Receipts
                            </button>
                            @if (!string.IsNullOrWhiteSpace(ev.FinalPaymentReferenceId) && !ev.IsDeliverablesUnlocked &&
                                 string.Equals(ev.FinalPaymentStatus, "Payment Verification (QR:Pending Payment)", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="/payments/@ev.FinalPaymentReferenceId"
                                   class="px-3 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold transition-colors">
                                    Pay Final Balance &rarr;
                                </a>
                            }
                            @if (CanCustomerModifyEvent(ev))
                            {
                                <button type="button"
                                        @onclick='() => OpenEventActionModal(ev, "reschedule")'
                                        class="px-3 py-1.5 rounded-lg border border-teal-300 bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-bold transition-colors">
                                    Reschedule
                                </button>
                                <button type="button"
                                        @onclick='() => OpenEventActionModal(ev, "cancel")'
                                        class="px-3 py-1.5 rounded-lg border border-rose-300 bg-rose-50 hover:bg-rose-100 text-rose-800 text-xs font-bold transition-colors">
                                    Cancel
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (_loading)
    {
        <div class="py-12 text-center">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-teal-600 border-t-transparent mb-2"></div>
            <p class="text-sm text-gray-500">Loading your bookings…</p>
        </div>
    }
    else if (!Bookings.Any() && !_awaitingAppointments.Any())
    {
        <div class="bg-white border border-gray-200 rounded-xl p-12 text-center shadow-sm">
            <h2 class="text-lg font-semibold text-gray-800 mb-1">No Bookings Found</h2>
            <p class="text-sm text-gray-500 mb-4">You have not scheduled any photography sessions yet.</p>
            <a href="/my/book" class="inline-block bg-teal-600 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-teal-700">Book a Session</a>
        </div>
    }
    else if (Bookings.Any())
    {
        <div class="space-y-4">
            @foreach (var booking in Bookings)
            {
                <div class="bg-white border rounded-xl p-6 shadow-sm flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-bold text-gray-900">@booking.ServiceTitle</h2>
                        @if (!string.IsNullOrWhiteSpace(booking.EventLocation))
                        {
                            <p class="text-gray-500 text-sm mt-1">📍 @booking.EventLocation</p>
                        }
                        <p class="text-gray-500 text-sm mt-1">@booking.Start.ToString("MMM dd, yyyy • h:mm tt") – @booking.SlotEnd.ToString("h:mm tt")</p>
                        <div class="mt-2 text-xs text-gray-600 bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-wrap items-center gap-3">
                            <div><span class="text-gray-500">Pricing &amp; Terms:</span> <span class="font-medium text-slate-700">For Negotiation</span></div>
                            <div class="text-gray-300">•</div>
                            <div><span class="text-gray-500">Payment Status:</span> <span class="bg-amber-100 text-amber-800 text-[11px] font-bold px-2 py-0.5 rounded-full">@booking.PaymentStatus</span></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(booking.AssignedClerkName))
                        {
                            <p class="text-xs text-slate-600 mt-1.5">🧑‍💼 Assigned Office Clerk: <strong class="text-slate-800">@booking.AssignedClerkName</strong></p>
                        }
                        <div class="mt-3">
                            <span class="@(booking.Status == "Delivered" || booking.Status == "Confirmed" || booking.Status == "Completed" ? "bg-green-100 text-green-800" : booking.Status == "Cancelled" ? "bg-rose-100 text-rose-800" : "bg-yellow-100 text-yellow-800") text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                                @booking.Status
                            </span>
                        </div>
                    </div>
                    <div class="flex flex-col sm:flex-row items-end sm:items-center gap-2">
                        @if (string.Equals(booking.Status, "Delivered", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="/my/gallery/@booking.AppointmentId" class="bg-teal-50 text-teal-700 hover:bg-teal-100 px-4 py-2 rounded-md font-semibold text-sm transition-colors">
                                View Gallery
                            </a>
                        }
                        else if (!string.IsNullOrWhiteSpace(booking.MeetingLink) && booking.Start >= DateTime.Today && !string.Equals(booking.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="@booking.MeetingLink" target="_blank" rel="noopener noreferrer" class="bg-teal-50 text-teal-700 hover:bg-teal-100 px-4 py-2 rounded-md font-semibold text-sm transition-colors">
                                Join Session
                            </a>
                        }
                        @if (CanCustomerModifyBooking(booking))
                        {
                            <button type="button"
                                    @onclick='() => OpenBookingActionModal(booking, "reschedule")'
                                    class="px-3.5 py-2 rounded-lg border border-teal-300 bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-bold transition-colors">
                                Reschedule
                            </button>
                            <button type="button"
                                    @onclick='() => OpenBookingActionModal(booking, "cancel")'
                                    class="px-3.5 py-2 rounded-lg border border-rose-300 bg-rose-50 hover:bg-rose-100 text-rose-800 text-xs font-bold transition-colors">
                                Cancel
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <CustomerAppointmentActionModal IsOpen="_isActionModalOpen"
                                    Mode="@_actionModalMode"
                                    IsEventAppointment="_actionModalIsEvent"
                                    EventAppointmentId="@_actionModalEventId"
                                    ScheduleAppointmentId="_actionModalBookingId"
                                    AppointmentTitle="@_actionModalTitle"
                                    CurrentDateTime="_actionModalDateTime"
                                    CurrentClerkId="@_actionModalClerkId"
                                    CurrentClerkName="@_actionModalClerkName"
                                    OnClose="CloseActionModal"
                                    OnCompleted="HandleCustomerActionCompletedAsync" />

    <BookingContractModal IsOpen="_isDocsModalOpen"
                          AppointmentId="@_docsModalAppointmentId"
                          InitialTab="@_docsModalTab"
                          AllowClickwrapAcceptance="_docsModalAllowAccept"
                          OnClosed="() => _isDocsModalOpen = false"
                          OnAccepted="_ => LoadBookingsAsync()" />
</div>

@code {
    private List<MyBooking> Bookings = new();
    private List<EventAppointmentDto> _customerEvents = new();
    private List<EventAppointmentDto> _awaitingAppointments = new();
    private bool _loading = true;
    private bool _isActionBusy = false;
    private string? _customerActionFeedback;
    private bool _isActionModalOpen;
    private string _actionModalMode = "reschedule";
    private bool _actionModalIsEvent;
    private string? _actionModalEventId;
    private int? _actionModalBookingId;
    private string _actionModalTitle = string.Empty;
    private DateTime _actionModalDateTime = DateTime.Today;
    private string? _actionModalClerkId;
    private string? _actionModalClerkName;
    private bool _isExpired = false;
    private string _countdownDisplay = "30:00";
    private System.Threading.Timer? _countdownTimer;
    private bool _isDocsModalOpen;
    private string _docsModalAppointmentId = string.Empty;
    private string _docsModalTab = "contract";
    private bool _docsModalAllowAccept;

    private void OpenDocsModal(string appointmentId, string tab, bool allowAccept)
    {
        _docsModalAppointmentId = appointmentId;
        _docsModalTab = tab;
        _docsModalAllowAccept = allowAccept;
        _isDocsModalOpen = true;
    }

    protected override void OnInitialized() => Events.Changed += OnBookingsChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        PaymentHub.OnEventStatusChanged += HandleHubEventStatusChangedAsync;
        await LoadBookingsAsync();
        await SubscribeCustomerHubAsync();
        StateHasChanged();
    }

    private async Task SubscribeCustomerHubAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var u = auth.User;
            var custId = u.FindFirst("studio_id")?.Value
                ?? u.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? u.FindFirst("sub")?.Value;
            if (string.IsNullOrWhiteSpace(custId))
                custId = _customerEvents.FirstOrDefault()?.CustomerId;

            if (!string.IsNullOrWhiteSpace(custId))
                await PaymentHub.EnsureCustomerMonitorStartedAsync(custId);

            foreach (var ev in _customerEvents)
            {
                if (!string.IsNullOrWhiteSpace(ev.FinalPaymentReferenceId))
                    await PaymentHub.JoinBookingGroupAsync(ev.FinalPaymentReferenceId);
            }
        }
        catch
        {
        }
    }

    private Task HandleHubEventStatusChangedAsync(EventStatusChangedMessage _) => InvokeAsync(async () =>
    {
        ScheduleService.InvalidateCache();
        await LoadBookingsAsync();
        StateHasChanged();
    });

    private async Task LoadBookingsAsync()
    {
        _loading = true;

        var result = await Api.GetMyBookingsAsync();
        if (result.IsSuccess && result.Value != null)
            Bookings = OrderCustomerBookings(result.Value);

        try
        {
            var allRes = await ConsultationApi.GetCustomerAppointmentsAsync();
            if (allRes.IsSuccess && allRes.Value != null)
            {
                _customerEvents = OrderCustomerEvents(allRes.Value);

                _awaitingAppointments = _customerEvents
                    .Where(a => (string.Equals(a.EventStatus, "Pending Payment", StringComparison.OrdinalIgnoreCase) ||
                                 string.Equals(a.EventStatus, "Awaiting_Downpayment", StringComparison.OrdinalIgnoreCase) ||
                                 string.Equals(a.EventStatus, "Rescheduled", StringComparison.OrdinalIgnoreCase)) &&
                                !string.Equals(a.DownpaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                    .ToList();

                if (_awaitingAppointments.Any())
                {
                    StartHoldCountdown();
                }
                else
                {
                    _countdownTimer?.Dispose();
                }
            }
            else
            {
                _customerEvents.Clear();
                _awaitingAppointments.Clear();
                _countdownTimer?.Dispose();
            }
        }
        catch { }

        _loading = false;
    }

    private void StartHoldCountdown()
    {
        _countdownTimer?.Dispose();
        var first = _awaitingAppointments.FirstOrDefault();
        var exp = first?.LockExpiresAt ?? first?.HoldExpiresAt; if (exp == null) return;

        UpdateCountdown();
        _countdownTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                UpdateCountdown();
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void UpdateCountdown()
    {
        var first = _awaitingAppointments.FirstOrDefault();
        var exp = first?.LockExpiresAt ?? first?.HoldExpiresAt; if (exp == null) return;
        var diff = exp.Value - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero)
        {
            _isExpired = true;
            _countdownDisplay = "00:00";
            _countdownTimer?.Dispose();
        }
        else
        {
            _isExpired = false;
            _countdownDisplay = $"{(int)diff.TotalMinutes:D2}:{diff.Seconds:D2}";
        }
    }

    private static string GetCustomerEventDisplayStatus(EventAppointmentDto appt)
    {
        if (string.Equals(appt.EventStatus, "Pending Verification", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "Paid Cash Pending Verification", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "Payment Verification (Cash)", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "Completed", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "Complete", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "Shot", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "Delivered", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.FinalPaymentStatus, "Pending Verification", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.FinalPaymentStatus, "Payment Verification (Cash)", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.FinalPaymentStatus, "Payment Verification (QR:Paid)", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.FinalPaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase))
        {
            return "Completed";
        }
        if (string.Equals(appt.EventStatus, "Preparing", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "Preparation", StringComparison.OrdinalIgnoreCase)) return "Preparation";
        if (string.Equals(appt.EventStatus, "Dispatch", StringComparison.OrdinalIgnoreCase)) return "Dispatched";
        if (string.Equals(appt.EventStatus, "Ready", StringComparison.OrdinalIgnoreCase)) return "Ready";
        if (string.Equals(appt.EventStatus, "On Going", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "Ongoing", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(appt.EventStatus, "In Execution", StringComparison.OrdinalIgnoreCase)) return "Ongoing";
        if (string.Equals(appt.EventStatus, "Post Event", StringComparison.OrdinalIgnoreCase)) return "Post Event";
        if (string.Equals(appt.EventStatus, "Event Done", StringComparison.OrdinalIgnoreCase)) return "Event Done";
        return appt.EventStatus;
    }

    private static bool CanCustomerModifyEvent(EventAppointmentDto ev)
    {
        var display = GetCustomerEventDisplayStatus(ev);
        if (string.Equals(display, "Completed", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(display, "Complete", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(display, "Ongoing", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(display, "Post Event", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(display, "Event Done", StringComparison.OrdinalIgnoreCase))
            return false;

        var raw = (ev.EventStatus ?? string.Empty).Trim();
        return !raw.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Expired", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Deal_Lost", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Shot", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Delivered", StringComparison.OrdinalIgnoreCase);
    }

    private static bool CanCustomerModifyBooking(MyBooking b)
    {
        var raw = (b.Status ?? string.Empty).Trim();
        return !raw.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Completed", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Complete", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Delivered", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Deal_Lost", StringComparison.OrdinalIgnoreCase) &&
               !raw.Equals("Expired", StringComparison.OrdinalIgnoreCase);
    }

    private void OpenEventActionModal(EventAppointmentDto ev, string mode)
    {
        _actionModalMode = mode;
        _actionModalIsEvent = true;
        _actionModalEventId = ev.EventAppointmentId;
        _actionModalBookingId = null;
        _actionModalTitle = $"{ev.EventName} (#{ev.EventAppointmentId})";
        _actionModalDateTime = ev.EventDate.ToDateTime(ev.EventTime);
        var clerk = ev.AssignedEmployees.FirstOrDefault(e =>
            e.Specialization.Contains("Clerk", StringComparison.OrdinalIgnoreCase));
        _actionModalClerkId = clerk?.EmployeeId;
        _actionModalClerkName = clerk?.EmployeeName;
        _isActionModalOpen = true;
    }

    private void OpenBookingActionModal(MyBooking booking, string mode)
    {
        _actionModalMode = mode;
        _actionModalIsEvent = false;
        _actionModalEventId = null;
        _actionModalBookingId = booking.AppointmentId;
        _actionModalTitle = $"{booking.ServiceTitle} (#{booking.AppointmentId})";
        _actionModalDateTime = booking.Start;
        _actionModalClerkId = booking.AssignedClerkId;
        _actionModalClerkName = booking.AssignedClerkName;
        _isActionModalOpen = true;
    }

    private void CloseActionModal()
    {
        _isActionModalOpen = false;
    }

    private async Task HandleCustomerActionCompletedAsync(string message)
    {
        _customerActionFeedback = message;
        ScheduleService.InvalidateCache();
        await LoadBookingsAsync();
        StateHasChanged();
    }

    private string GetCheckoutUrl(EventAppointmentDto appt)
    {
        if (string.IsNullOrWhiteSpace(appt.XenditInvoiceUrl) ||
            appt.XenditInvoiceUrl.Contains("/qr_", StringComparison.OrdinalIgnoreCase) ||
            appt.XenditInvoiceUrl.Contains("qr_", StringComparison.OrdinalIgnoreCase) ||
            appt.XenditInvoiceUrl.Contains("mock", StringComparison.OrdinalIgnoreCase) ||
            appt.XenditInvoiceUrl.Contains("inv_mock_", StringComparison.OrdinalIgnoreCase) ||
            !string.IsNullOrWhiteSpace(appt.QrString))
        {
            return $"/payments/{appt.EventAppointmentId}";
        }
        return appt.XenditInvoiceUrl;
    }

    private async Task SimulatePaymentSuccessAsync(string appointmentId)
    {
        if (_isActionBusy) return;
        _isActionBusy = true;
        try
        {
            var res = await ConsultationApi.SimulateWebhookPaymentAsync(appointmentId, "GCASH");
            if (res.IsSuccess)
            {
                ScheduleService.InvalidateCache();
                _customerActionFeedback = "Reservation payment confirmed!";
                await LoadBookingsAsync();
                return;
            }

            var qrRes = await ConsultationApi.SimulateQrPaymentAsync(appointmentId);
            if (qrRes.IsSuccess)
            {
                ScheduleService.InvalidateCache();
                _customerActionFeedback = "Reservation payment confirmed!";
                await LoadBookingsAsync();
            }
            else
            {
                _customerActionFeedback = qrRes.Error?.Message ?? res.Error?.Message ?? "Payment simulation could not be completed.";
            }
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private async Task VerifyPaymentAsync(string appointmentId)
    {
        if (_isActionBusy) return;
        _isActionBusy = true;
        try
        {
            await ConsultationApi.VerifyDownpaymentAsync(appointmentId);
            ScheduleService.InvalidateCache();
            await LoadBookingsAsync();
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    private async Task RequestExtensionAsync(string appointmentId)
    {
        if (_isActionBusy) return;
        _isActionBusy = true;
        try
        {
            var res = await ConsultationApi.RequestExtensionAsync(appointmentId);
            if (res.IsSuccess && res.Value) await LoadBookingsAsync();
        }
        finally
        {
            _isActionBusy = false;
        }
    }

    public static List<MyBooking> OrderCustomerBookings(IEnumerable<MyBooking> bookings) =>
        bookings
            .OrderBy(b => string.Equals(b.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
            .ThenByDescending(b => b.CreatedAt ?? b.Start)
            .ThenByDescending(b => b.AppointmentId)
            .ThenByDescending(b => b.Start)
            .ToList();

    public static List<EventAppointmentDto> OrderCustomerEvents(IEnumerable<EventAppointmentDto> events) =>
        events
            .OrderBy(e => string.Equals(e.EventStatus, "Cancelled", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
            .ThenByDescending(e => e.CreatedAt)
            .ThenByDescending(e => e.EventDate)
            .ThenByDescending(e => e.EventTime)
            .ToList();

    private void OnBookingsChanged() => _ = InvokeAsync(async () => { await LoadBookingsAsync(); StateHasChanged(); });

    public void Dispose()
    {
        PaymentHub.OnEventStatusChanged -= HandleHubEventStatusChangedAsync;
        Events.Changed -= OnBookingsChanged;
        _countdownTimer?.Dispose();
    }
}
