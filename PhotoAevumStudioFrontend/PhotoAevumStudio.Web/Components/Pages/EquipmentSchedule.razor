@page "/equipment-schedule"
@page "/equipments-schedule"
@page "/admin/calendar/equipment"
@page "/admin/calendar/equipments"
@page "/admin/equipment-schedule"
@page "/admin/equipments-schedule"
@layout AdminLayout
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@implements IAsyncDisposable
@inject IScheduleService ScheduleService
@inject IEquipmentService EquipmentService
@inject PaymentHubClient PaymentHub
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService

<PageTitle>Equipments Schedule | Aevum Studio</PageTitle>

@if (_isUnauthorized)
{
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-8 text-center my-6">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-rose-100 text-rose-600 mb-4">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h2 class="text-xl font-bold text-rose-900 mb-2">Access Denied (403)</h2>
        <p class="text-sm text-rose-700 max-w-md mx-auto">
            You do not have authorization to view the Equipments Schedule. Access to equipment reservation timelines and dispatch schedules is restricted to Office Clerks and Studio Administrators.
        </p>
    </div>
}
else
{
<div class="space-y-4 pb-10">
    @if (_isLoadingSchedule)
    {
        <div class="text-xs text-gray-500 py-1">Loading equipments schedule...</div>
    }
    @* ── 1. COMPACT PAGE HEADER & STATUS STRIP ────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-gray-200 pb-3">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-400">
                <span>Gear Inventory</span>
                <span>/</span>
                <span class="text-gray-900 font-bold">Equipment Schedule</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">Equipment Timeline & Dispatch</h1>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                📷 @EquipmentResources.Count Units
            </span>
            <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                ✓ @ThisWeekReservationsCount Dispatches Active
            </span>
            @if (InMaintenanceCount > 0)
            {
                <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                    🛠 @InMaintenanceCount Bench Tech
                </span>
            }
            @if (NeedsFixReservationsCount > 0)
            {
                <button type="button" @onclick="ToggleNeedsFixFilter" class="px-2.5 py-1 text-xs font-bold rounded-full border cursor-pointer @(_filterOnlyNeedsFix ? "bg-amber-600 text-white border-amber-600" : "bg-amber-100 text-amber-900 border-amber-300")">
                    🔧 @NeedsFixReservationsCount Needs Gear Fix
                </button>
            }
            @if (ConflictCount > 0)
            {
                <button type="button" @onclick="ToggleConflictFilter" class="px-2.5 py-1 text-xs font-bold rounded-full bg-rose-600 text-white cursor-pointer">
                    ⚠️ @ConflictCount Overbooked
                </button>
            }
            else
            {
                <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-teal-50 text-teal-700 border border-teal-200">
                    ✓ All Gear Available
                </span>
            }

            <button type="button" @onclick="OpenCreateModal" class="px-3 py-1.5 bg-gray-900 hover:bg-black text-white text-xs font-semibold rounded-lg shadow-xs ml-2">
                + Reserve Gear
            </button>
        </div>
    </div>

    @* ── 2. COMPACT TOOLBAR & FILTERS ─────────────────────────────────── *@
    <div class="bg-white p-3 rounded-lg border border-gray-200 shadow-2xs flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
            <div class="inline-flex bg-gray-100 p-0.5 rounded-md border border-gray-200">
                <button type="button" @onclick="() => SetViewMode(ScheduleViewMode.Day)" class="px-2.5 py-1 font-semibold rounded @(_currentView == ScheduleViewMode.Day ? "bg-white shadow-2xs text-gray-900" : "text-gray-500")">Day</button>
                <button type="button" @onclick="() => SetViewMode(ScheduleViewMode.Week)" class="px-2.5 py-1 font-semibold rounded @(_currentView == ScheduleViewMode.Week ? "bg-white shadow-2xs text-gray-900" : "text-gray-500")">Week</button>
                <button type="button" @onclick="() => SetViewMode(ScheduleViewMode.Month)" class="px-2.5 py-1 font-semibold rounded @(_currentView == ScheduleViewMode.Month ? "bg-white shadow-2xs text-gray-900" : "text-gray-500")">Month</button>
                <button type="button" @onclick="() => SetViewMode(ScheduleViewMode.Agenda)" class="px-2.5 py-1 font-semibold rounded @(_currentView == ScheduleViewMode.Agenda ? "bg-white shadow-2xs text-gray-900" : "text-gray-500")">Agenda</button>
            </div>

            <div class="flex items-center gap-1">
                <button type="button" @onclick="NavigatePrevious" class="px-2 py-1 bg-white border border-gray-200 rounded font-bold">‹</button>
                <span class="font-bold px-2 text-gray-800">@FormattedDateRangeHeader</span>
                <button type="button" @onclick="NavigateNext" class="px-2 py-1 bg-white border border-gray-200 rounded font-bold">›</button>
                <button type="button" @onclick="JumpToToday" class="px-2 py-1 bg-gray-50 border border-gray-200 rounded font-medium">Today</button>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <select @bind="_selectedCategoryFilter" class="p-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                <option value="">All Categories</option>
                @foreach (var cat in EquipmentResources.Select(e => e.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct())
                {
                    <option value="@cat">@cat</option>
                }
            </select>

            <select @bind="_selectedStatusFilter" class="p-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                <option value="">All Statuses</option>
                <option value="Ready">Ready</option>
                <option value="In-Use">In-Use</option>
                <option value="In-Maintenance">In-Maintenance</option>
                <option value="Needs Replacement">Needs Replacement</option>
            </select>

            <input type="text" @bind="_searchQuery" @bind:event="oninput" class="p-1.5 bg-gray-50 border border-gray-200 rounded text-xs w-36 focus:w-48 transition-all" />

            @if (HasActiveFilters)
            {
                <button type="button" @onclick="ClearFilters" class="text-rose-600 font-semibold underline">Reset</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_bannerMessage))
    {
        <SystemMessage Message="@_bannerMessage" Severity="@(_bannerIsError ? "error" : "success")" Mode="banner" OnDismiss="() => _bannerMessage = null" />
    }

    @if (UpcomingNeedsFixReservations.Count > 0)
    {
        <div class="rounded-xl border border-amber-300 bg-amber-50/90 px-4 py-3 shadow-2xs space-y-2" role="region" aria-label="Upcoming equipment schedules needing replacement">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-200 text-amber-900 text-xs font-bold shrink-0">🔧</span>
                <div>
                    <h2 class="text-xs font-extrabold text-amber-950">
                        Equipment in Maintenance — Upcoming Schedules Need Replacement (@UpcomingNeedsFixReservations.Count)
                    </h2>
                    <p class="text-[11px] text-amber-800">
                        These scheduled reservations reference equipment currently in maintenance or unavailable. Schedule an available replacement unit for the event.
                    </p>
                </div>
            </div>
            <div class="space-y-1.5">
                @foreach (var alertRes in UpcomingNeedsFixReservations)
                {
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-white/90 border border-amber-200 rounded-lg px-3 py-2 text-xs">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-bold text-slate-900">@alertRes.EquipmentName</span>
                                <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-300 text-[10px] font-bold">
                                    @alertRes.MaintenanceStatus@(!string.IsNullOrWhiteSpace(alertRes.MaintenanceSubStatus) ? $" ({alertRes.MaintenanceSubStatus})" : "")
                                </span>
                                <span class="text-slate-400">&bull;</span>
                                <span class="font-semibold text-slate-800">@alertRes.Date.ToString("ddd, MMM d, yyyy") (@alertRes.FormattedTimeRange)</span>
                            </div>
                            <div class="text-[11px] text-slate-600 mt-0.5 truncate">
                                Event: <strong>@alertRes.ProjectOrClient</strong>
                                @if (!string.IsNullOrWhiteSpace(alertRes.MaintenanceNotes))
                                {
                                    <span class="text-amber-800 ml-1">— @alertRes.MaintenanceNotes</span>
                                }
                            </div>
                        </div>
                        <button type="button"
                                @onclick="() => FocusAndOpenReplacementDrawer(alertRes)"
                                class="px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-[11px] font-bold shrink-0 transition-colors">
                            Schedule Replacement
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    @* ── 3. MAIN COMPACT TIMELINE MATRIX ──────────────────────────────── *@
    @if (_currentView == ScheduleViewMode.Week)
    {
        <div class="bg-white rounded-lg border border-gray-200 shadow-2xs overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 font-bold text-gray-500 uppercase">
                            <th class="w-56 p-2.5 border-r border-gray-200">Equipment & Serial</th>
                            @foreach (var day in WeekDays)
                            {
                                var isToday = day.Date == DateTime.Today;
                                <th class="p-2 border-r border-gray-200 text-center @(isToday ? "bg-amber-50" : "")">
                                    <div>@day.ToString("ddd") <span class="font-extrabold text-gray-900">@day.Day</span></div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var eq in FilteredEquipment)
                        {
                            <tr class="hover:bg-gray-50/50">
                                <td class="p-2.5 border-r border-gray-200">
                                    <div class="flex items-center justify-between">
                                        <div class="font-bold text-gray-900">@eq.Name</div>
                                        <span class="text-[9px] px-1.5 py-0.2 rounded font-bold @(eq.Status == "Ready" ? "bg-emerald-100 text-emerald-800" : eq.Status == "In-Use" ? "bg-blue-100 text-blue-800" : eq.Status == "Needs Replacement" ? "bg-rose-100 text-rose-800" : "bg-amber-100 text-amber-800")">
                                            @(eq.Status == "Ready" ? "✓ Ready" : eq.Status)
                                        </span>
                                    </div>
                                    <div class="text-[10px] text-gray-500">
                                        <code>@eq.SerialNumber</code> &bull; @eq.Category
                                    </div>
                                </td>

                                @foreach (var day in WeekDays)
                                {
                                    var dayReservations = FilteredReservations
                                        .Where(r => r.EquipmentId == eq.Id && r.Date.Date == day.Date)
                                        .OrderBy(r => r.StartTime)
                                        .ToList();

                                    <td class="p-1 border-r border-gray-100 align-top">
                                        <div class="space-y-1 min-h-[48px]">
                                            @foreach (var res in dayReservations)
                                            {
                                                <div @onclick="() => OpenDetailDrawer(res)"
                                                     class="p-1.5 rounded border text-[11px] cursor-pointer transition-all @GetReservationCardStyle(res)">
                                                    <div class="flex items-center justify-between font-bold gap-1">
                                                        <span>@res.FormattedTimeRange</span>
                                                        @if (res.NeedsEquipmentFix)
                                                        {
                                                            <span class="text-amber-800 font-extrabold text-[10px]" title="Equipment in Maintenance — Schedule Replacement">🔧 Needs Fix</span>
                                                        }
                                                        else if (res.HasConflict)
                                                        {
                                                            <span class="text-rose-700 font-extrabold text-[10px]" title="Conflict!">⚠️</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-emerald-700 font-bold text-[10px]" title="Booked All Day">🔒 All Day</span>
                                                        }
                                                    </div>
                                                    <div class="text-[10px] truncate">@res.ProjectOrClient &bull; 👤 @res.TechnicianInCharge</div>
                                                    @if (res.NeedsEquipmentFix)
                                                    {
                                                        <div class="text-[9px] font-extrabold text-amber-900 uppercase tracking-wide truncate mt-0.5">
                                                            Schedule replacement →
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        var listReservations = GetReservationsForActiveView().ToList();
        <div class="bg-white p-4 rounded-lg border border-gray-200">
            <h3 class="font-bold text-sm mb-3">Reservations for @FormattedDateRangeHeader</h3>
            @if (listReservations.Count == 0)
            {
                <div class="py-8 text-center text-xs text-gray-400 italic">No equipment reservations scheduled for this period.</div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var res in listReservations)
                    {
                        <div @onclick="() => OpenDetailDrawer(res)" class="p-2.5 border rounded-lg flex flex-wrap items-center justify-between gap-2 cursor-pointer hover:bg-gray-50 @(res.NeedsEquipmentFix ? "border-amber-300 bg-amber-50/50" : res.HasConflict ? "border-rose-300 bg-rose-50/40" : "border-gray-200")">
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-gray-100 text-gray-700 font-semibold">@res.Date.ToString("MMM d")</span>
                                <span class="font-bold text-xs">@res.FormattedTimeRange</span>
                                <span class="font-bold text-xs text-slate-900">@res.EquipmentName</span>
                                <span class="text-xs text-gray-500">@res.ProjectOrClient &bull; 👤 @res.TechnicianInCharge &bull; 📍 @res.Location</span>
                            </div>
                            <span class="text-xs px-2 py-0.5 rounded @(res.NeedsEquipmentFix ? "bg-amber-100 text-amber-900 border border-amber-300" : res.HasConflict ? "bg-rose-100 text-rose-800" : "bg-emerald-50 text-emerald-800") font-semibold">
                                @(res.NeedsEquipmentFix ? $"🔧 {res.MaintenanceStatus} — Needs Fix / Schedule Equipment" : res.HasConflict ? "⚠️ Same-Day Conflict" : "🔒 Booked All Day")
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── DETAIL DRAWER & CREATE MODAL ─────────────────────────────────── *@
    @if (_selectedReservation != null)
    {
        <div class="fixed inset-0 bg-black/40 z-50 flex justify-end" @onclick="CloseDetailDrawer">
            <div class="w-80 bg-white h-full p-5 shadow-xl flex flex-col justify-between" @onclick:stopPropagation="true">
                <div>
                    <div class="flex items-center justify-between border-b pb-3 mb-3">
                        <h3 class="font-bold text-sm">Reservation Details</h3>
                        <button type="button" @onclick="CloseDetailDrawer" class="text-gray-400 font-bold">✕</button>
                    </div>
                    <div class="space-y-2 text-xs">
                        <div>
                            <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-200">
                                🔒 Unavailable All Day (@_selectedReservation.Date.ToString("MMM d, yyyy"))
                            </span>
                        </div>
                        <div><strong class="text-gray-500">Equipment:</strong> @_selectedReservation.EquipmentName (<code class="text-[11px]">@_selectedReservation.EquipmentId</code>)</div>
                        <div><strong class="text-gray-500">Category:</strong> @_selectedReservation.Category</div>
                        <div><strong class="text-gray-500">Project / Client:</strong> @_selectedReservation.ProjectOrClient</div>
                        <div><strong class="text-gray-500">Technician:</strong> @_selectedReservation.TechnicianInCharge</div>
                        <div><strong class="text-gray-500">Schedule:</strong> @_selectedReservation.Date.ToString("ddd, MMM d, yyyy") (@_selectedReservation.FormattedTimeRange)</div>
                        <div><strong class="text-gray-500">Location:</strong> @_selectedReservation.Location</div>
                        <div><strong class="text-gray-500">Event Status:</strong> @_selectedReservation.EventStatus</div>
                        @if (_selectedReservation.NeedsEquipmentFix)
                        {
                            <div class="p-3 rounded-lg bg-amber-50 border border-amber-300 text-amber-950 space-y-2">
                                <div class="font-extrabold flex items-center gap-1.5">
                                    <span>🔧</span>
                                    <span>Equipment in @_selectedReservation.MaintenanceStatus@(!string.IsNullOrWhiteSpace(_selectedReservation.MaintenanceSubStatus) ? $" ({_selectedReservation.MaintenanceSubStatus})" : "")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_selectedReservation.MaintenanceNotes))
                                {
                                    <p class="text-[11px] text-amber-900">@_selectedReservation.MaintenanceNotes</p>
                                }
                                <div class="pt-1 border-t border-amber-200 space-y-1.5">
                                    <label class="block text-[11px] font-bold text-amber-950">Schedule Replacement Equipment</label>
                                    @if (!string.IsNullOrWhiteSpace(_drawerErrorMessage))
                                    {
                                        <div class="p-1.5 rounded bg-rose-50 border border-rose-200 text-rose-700 text-[11px]">@_drawerErrorMessage</div>
                                    }
                                    @{
                                        var replacementOptions = GetReplacementEquipmentOptions(_selectedReservation);
                                    }
                                    <select @bind="_replacementEquipmentId" class="w-full p-1.5 bg-white border border-amber-300 rounded text-xs">
                                        <option value="">Select available replacement gear...</option>
                                        @foreach (var opt in replacementOptions)
                                        {
                                            <option value="@opt.Id" disabled="@opt.IsBooked">
                                                @opt.Name (@opt.SerialNumber)@(opt.IsBooked ? " — Booked Today" : "")
                                            </option>
                                        }
                                    </select>
                                    <button type="button"
                                            disabled="@string.IsNullOrWhiteSpace(_replacementEquipmentId)"
                                            @onclick="ScheduleReplacementForSelectedAsync"
                                            class="w-full py-1.5 rounded bg-amber-600 hover:bg-amber-700 disabled:opacity-40 text-white font-bold text-xs transition-colors">
                                        Schedule Replacement Equipment
                                    </button>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_selectedReservation.Notes))
                        {
                            <div><strong class="text-gray-500">Notes:</strong> <span class="italic text-gray-600">@_selectedReservation.Notes</span></div>
                        }
                    </div>
                </div>
                <div class="pt-3 border-t">
                    <button type="button" @onclick="DeleteSelectedReservation" class="w-full py-1.5 bg-rose-50 text-rose-700 font-semibold rounded text-xs border border-rose-200">Cancel Reservation</button>
                </div>
            </div>
        </div>
    }

    @if (_isCreateModalOpen)
    {
        <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4" @onclick="CloseCreateModal">
            <div class="w-96 bg-white rounded-lg shadow-xl p-5" @onclick:stopPropagation="true">
                <h3 class="font-bold text-sm mb-3">Reserve Equipment</h3>
                @if (!string.IsNullOrEmpty(_modalErrorMessage))
                {
                    <div class="p-2 mb-2 bg-rose-50 text-rose-700 text-xs rounded">@_modalErrorMessage</div>
                }
                <div class="space-y-2 text-xs">
                    <div>
                        <label class="block font-semibold mb-1">Equipment Unit</label>
                        <select @bind="_newReservation.EquipmentId" class="w-full p-1.5 border rounded">
                            <option value="">Select available equipment...</option>
                            @foreach (var eq in EquipmentResources)
                            {
                                var isBooked = IsEquipmentBookedOnDate(eq.Id, _newReservationDate);
                                var isUnavailable = EquipmentItemModel.IsUnavailableStatus(eq.Status);
                                var isDisabled = isBooked || isUnavailable;
                                <option value="@eq.Id" disabled="@isDisabled">
                                    @eq.Name (@eq.SerialNumber)@(isUnavailable ? $" — Unavailable ({eq.Status})" : isBooked ? " — Unavailable (Booked Today)" : "")
                                </option>
                            }
                        </select>
                        <p class="text-[10px] text-gray-400 mt-0.5">Equipment booked on any active event for @_newReservationDate.ToString("MMM d, yyyy") is locked all day.</p>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Project / Production</label>
                        <input type="text" @bind="_newReservation.ProjectOrClient" class="w-full p-1.5 border rounded" />
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block font-semibold mb-1">Date</label>
                            <input type="date" @bind="_newReservationDate" class="w-full p-1.5 border rounded" />
                        </div>
                        <div>
                            <label class="block font-semibold mb-1">Tech in Charge</label>
                            <input type="text" @bind="_newReservation.TechnicianInCharge" class="w-full p-1.5 border rounded" />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block font-semibold mb-1">Start Time</label>
                            <input type="time" @bind="_newStartTime" class="w-full p-1.5 border rounded" />
                        </div>
                        <div>
                            <label class="block font-semibold mb-1">End Time</label>
                            <input type="time" @bind="_newEndTime" class="w-full p-1.5 border rounded" />
                        </div>
                    </div>
                </div>
                <div class="flex justify-end gap-2 mt-4 pt-3 border-t">
                    <button type="button" @onclick="CloseCreateModal" class="px-3 py-1 text-xs border rounded">Cancel</button>
                    <button type="button" @onclick="SaveNewReservation" class="px-3 py-1 text-xs bg-gray-900 text-white rounded font-bold">Reserve</button>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _currentUser;
    private bool _isUnauthorized;
    private bool _isLoadingSchedule = true;
    private bool _hasLoadedInitialData;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            _currentUser = state.User;
        }
        else if (AuthStateProvider != null)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUser = state.User;
        }

        _isUnauthorized = EmployeeRoleHelper.IsPhotographerOrCreative(_currentUser, UserService);
        if (!_isUnauthorized)
        {
            EquipmentService.OnChange += HandleEquipmentServiceChange;
            PaymentHub.OnEventStatusChanged += HandleHubEventStatusChangedAsync;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasLoadedInitialData) return;
        _hasLoadedInitialData = true;
        await RefreshEquipmentDataAsync();
        if (!_isUnauthorized)
        {
            try
            {
                await PaymentHub.EnsureLiveMonitorStartedAsync();
            }
            catch
            {
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private void HandleEquipmentServiceChange()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshEquipmentDataAsync();
            StateHasChanged();
        });
    }

    private Task HandleHubEventStatusChangedAsync(EventStatusChangedMessage _) => InvokeAsync(async () =>
    {
        await RefreshEquipmentDataAsync();
        StateHasChanged();
    });

    private async Task RefreshEquipmentDataAsync()
    {
        if (_isUnauthorized)
        {
            _isLoadingSchedule = false;
            return;
        }

        _isLoadingSchedule = true;
        ScheduleService.InvalidateCache();
        var (equipment, reservations) = await Task.Run(() =>
            (ScheduleService.GetEquipmentResources(), ScheduleService.GetEquipmentReservations()));
        EquipmentResources = equipment;
        AllReservations = reservations;
        if (_selectedReservation != null)
        {
            _selectedReservation = AllReservations.FirstOrDefault(r => string.Equals(r.Id, _selectedReservation.Id, StringComparison.OrdinalIgnoreCase));
        }
        _isLoadingSchedule = false;
    }

    private ScheduleViewMode _currentView = ScheduleViewMode.Week;
    private DateTime _selectedDate = DateTime.Today;
    private string _searchQuery = string.Empty;
    private string _selectedCategoryFilter = string.Empty;
    private string _selectedStatusFilter = string.Empty;
    private bool _filterOnlyConflicts = false;
    private bool _filterOnlyNeedsFix = false;

    private EquipmentReservationModel? _selectedReservation;
    private string _replacementEquipmentId = string.Empty;
    private string? _drawerErrorMessage;
    private string? _bannerMessage;
    private bool _bannerIsError;
    private bool _isCreateModalOpen;
    private string? _modalErrorMessage;

    private EquipmentReservationModel _newReservation = new();
    private DateTime _newReservationDate = DateTime.Today;
    private TimeOnly _newStartTime = new(9, 0);
    private TimeOnly _newEndTime = new(14, 0);

    private List<EquipmentItemResource> EquipmentResources = new();
    private List<EquipmentReservationModel> AllReservations = new();

    private int ConflictCount => AllReservations.Count(r => r.HasConflict);
    private int NeedsFixReservationsCount => UpcomingNeedsFixReservations.Count;
    private List<EquipmentReservationModel> UpcomingNeedsFixReservations =>
        AllReservations
            .Where(r => r.NeedsEquipmentFix && r.Date.Date >= DateTime.Today)
            .OrderBy(r => r.Date.Date)
            .ThenBy(r => r.StartTime)
            .ToList();
    private int InMaintenanceCount => EquipmentResources.Count(e => e.Status == "In-Maintenance" || e.Status == "Calibration Due" || e.Status == "Needs Replacement");
    private int ThisWeekReservationsCount => AllReservations.Count(r => WeekDays.Any(w => w.Date == r.Date.Date));
    private double ThisWeekHoursCount => AllReservations.Where(r => WeekDays.Any(w => w.Date == r.Date.Date)).Sum(r => r.DurationHours);

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_searchQuery) ||
        !string.IsNullOrEmpty(_selectedCategoryFilter) ||
        !string.IsNullOrEmpty(_selectedStatusFilter) ||
        _filterOnlyConflicts ||
        _filterOnlyNeedsFix;

    private List<DateTime> WeekDays
    {
        get
        {
            int diff = (7 + (_selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
            var monday = _selectedDate.AddDays(-1 * diff);
            return Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
        }
    }

    private string FormattedDateRangeHeader => _currentView switch
    {
        ScheduleViewMode.Day => _selectedDate.ToString("MMMM d, yyyy"),
        ScheduleViewMode.Week => $"{WeekDays.First():MMM d} – {WeekDays.Last():MMM d, yyyy}",
        ScheduleViewMode.Month => _selectedDate.ToString("MMMM yyyy"),
        ScheduleViewMode.Agenda => $"{_selectedDate:MMM d} – {_selectedDate.AddDays(14):MMM d, yyyy}",
        _ => _selectedDate.ToString("MMMM yyyy")
    };

    private IEnumerable<EquipmentItemResource> FilteredEquipment
    {
        get
        {
            var query = EquipmentResources.AsEnumerable();
            if (!string.IsNullOrEmpty(_selectedCategoryFilter))
                query = query.Where(e => e.Category.Equals(_selectedCategoryFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(_selectedStatusFilter))
                query = query.Where(e => e.Status.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(e => e.Name.ToLowerInvariant().Contains(q) || e.SerialNumber.ToLowerInvariant().Contains(q));
            }
            return query;
        }
    }

    private IEnumerable<EquipmentReservationModel> FilteredReservations
    {
        get
        {
            var query = AllReservations.AsEnumerable();
            if (!string.IsNullOrEmpty(_selectedStatusFilter))
            {
                query = query.Where(r =>
                    r.MaintenanceStatus.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase) ||
                    (_selectedStatusFilter.Equals("In-Maintenance", StringComparison.OrdinalIgnoreCase) &&
                     r.MaintenanceStatus.Equals("Maintenance", StringComparison.OrdinalIgnoreCase)));
            }
            if (_filterOnlyConflicts)
                query = query.Where(r => r.HasConflict);
            if (_filterOnlyNeedsFix)
                query = query.Where(r => r.NeedsEquipmentFix);
            return query;
        }
    }

    private void SetViewMode(ScheduleViewMode mode) => _currentView = mode;

    private void NavigatePrevious()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(-1),
            ScheduleViewMode.Week => _selectedDate.AddDays(-7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(-1),
            _ => _selectedDate.AddDays(-7)
        };
    }

    private void NavigateNext()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(1),
            ScheduleViewMode.Week => _selectedDate.AddDays(7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(1),
            _ => _selectedDate.AddDays(7)
        };
    }

    private void JumpToToday() => _selectedDate = DateTime.Today;

    private void ToggleConflictFilter() => _filterOnlyConflicts = !_filterOnlyConflicts;
    private void ToggleNeedsFixFilter() => _filterOnlyNeedsFix = !_filterOnlyNeedsFix;

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _selectedCategoryFilter = string.Empty;
        _selectedStatusFilter = string.Empty;
        _filterOnlyConflicts = false;
        _filterOnlyNeedsFix = false;
    }

    private void OpenDetailDrawer(EquipmentReservationModel res)
    {
        _selectedReservation = res;
        _replacementEquipmentId = string.Empty;
        _drawerErrorMessage = null;
    }

    private void FocusAndOpenReplacementDrawer(EquipmentReservationModel res)
    {
        _selectedDate = res.Date.Date;
        OpenDetailDrawer(res);
    }

    private void CloseDetailDrawer()
    {
        _selectedReservation = null;
        _replacementEquipmentId = string.Empty;
        _drawerErrorMessage = null;
    }

    private async Task DeleteSelectedReservation()
    {
        if (_selectedReservation != null)
        {
            ScheduleService.DeleteEquipmentReservation(_selectedReservation.Id);
            _selectedReservation = null;
            EquipmentService.NotifyStateChanged();
            await RefreshEquipmentDataAsync();
        }
    }

    private sealed record ReplacementOption(string Id, string Name, string SerialNumber, bool IsBooked);

    private List<ReplacementOption> GetReplacementEquipmentOptions(EquipmentReservationModel target)
    {
        return EquipmentResources
            .Where(e =>
                !string.Equals(e.Id, target.EquipmentId, StringComparison.OrdinalIgnoreCase) &&
                !EquipmentItemModel.IsUnavailableStatus(e.Status))
            .Select(e => new ReplacementOption(
                e.Id,
                e.Name,
                e.SerialNumber,
                IsEquipmentBookedOnDate(e.Id, target.Date)))
            .ToList();
    }

    private async Task ScheduleReplacementForSelectedAsync()
    {
        if (_selectedReservation == null || string.IsNullOrWhiteSpace(_replacementEquipmentId))
            return;

        _drawerErrorMessage = null;
        var actorId = _currentUser?.FindFirst("studio_id")?.Value
            ?? _currentUser?.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? "ADM-001";

        var oldName = _selectedReservation.EquipmentName;
        var (success, error) = ScheduleService.ReplaceReservationEquipment(
            _selectedReservation.Id,
            _selectedReservation.EventAppointmentId,
            _selectedReservation.EquipmentId,
            _replacementEquipmentId,
            actorId);

        if (!success)
        {
            _drawerErrorMessage = error ?? "Could not schedule replacement equipment.";
            return;
        }

        var replacement = EquipmentResources.FirstOrDefault(e => string.Equals(e.Id, _replacementEquipmentId, StringComparison.OrdinalIgnoreCase));
        _bannerIsError = false;
        _bannerMessage = $"Scheduled '{replacement?.Name ?? _replacementEquipmentId}' in place of '{oldName}' for {_selectedReservation.ProjectOrClient}.";
        _selectedReservation = null;
        _replacementEquipmentId = string.Empty;
        EquipmentService.NotifyStateChanged();
        await RefreshEquipmentDataAsync();
    }

    private IEnumerable<EquipmentReservationModel> GetReservationsForActiveView() => _currentView switch
    {
        ScheduleViewMode.Day => FilteredReservations
            .Where(r => r.Date.Date == _selectedDate.Date)
            .OrderBy(r => r.StartTime),
        ScheduleViewMode.Month => FilteredReservations
            .Where(r => r.Date.Year == _selectedDate.Year && r.Date.Month == _selectedDate.Month)
            .OrderBy(r => r.Date)
            .ThenBy(r => r.StartTime),
        ScheduleViewMode.Agenda => FilteredReservations
            .Where(r => r.Date.Date >= _selectedDate.Date && r.Date.Date <= _selectedDate.Date.AddDays(14))
            .OrderBy(r => r.Date)
            .ThenBy(r => r.StartTime),
        _ => FilteredReservations
            .Where(r => r.Date.Date == _selectedDate.Date)
            .OrderBy(r => r.StartTime)
    };

    private bool IsEquipmentBookedOnDate(string? equipmentId, DateTime date) =>
        !string.IsNullOrWhiteSpace(equipmentId) &&
        AllReservations.Any(r =>
            string.Equals(r.EquipmentId, equipmentId, StringComparison.OrdinalIgnoreCase) &&
            r.Date.Date == date.Date &&
            !string.Equals(r.EventStatus, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(r.EventStatus, "Expired", StringComparison.OrdinalIgnoreCase));

    private void OpenCreateModal()
    {
        _newReservationDate = _selectedDate;
        var firstAvailable = EquipmentResources.FirstOrDefault(e =>
            !EquipmentItemModel.IsUnavailableStatus(e.Status) &&
            !IsEquipmentBookedOnDate(e.Id, _newReservationDate));
        _newReservation = new EquipmentReservationModel
        {
            EquipmentId = firstAvailable?.Id ?? string.Empty,
            TechnicianInCharge = string.Empty,
            Location = string.Empty,
            MaintenanceStatus = "Ready"
        };
        _newStartTime = new TimeOnly(9, 0);
        _newEndTime = new TimeOnly(14, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private async Task SaveNewReservation()
    {
        if (string.IsNullOrWhiteSpace(_newReservation.EquipmentId))
        {
            _modalErrorMessage = "Please select an available equipment unit.";
            return;
        }

        var selectedEq = EquipmentResources.FirstOrDefault(e => string.Equals(e.Id, _newReservation.EquipmentId, StringComparison.OrdinalIgnoreCase));
        if (selectedEq != null && EquipmentItemModel.IsUnavailableStatus(selectedEq.Status))
        {
            _modalErrorMessage = $"Equipment '{selectedEq.Name}' is currently '{selectedEq.Status}' and cannot be reserved.";
            return;
        }

        if (_newEndTime <= _newStartTime)
        {
            _modalErrorMessage = "Reservation end time must be after start time.";
            return;
        }

        if (IsEquipmentBookedOnDate(_newReservation.EquipmentId, _newReservationDate))
        {
            _modalErrorMessage = $"Selected equipment is already booked on {_newReservationDate:MMM d, yyyy} and is unavailable for the entire calendar day.";
            return;
        }

        _newReservation.Date = _newReservationDate;
        _newReservation.StartTime = _newStartTime.ToTimeSpan();
        _newReservation.EndTime = _newEndTime.ToTimeSpan();

        try
        {
            ScheduleService.AddEquipmentReservation(_newReservation);
        }
        catch (InvalidOperationException ex)
        {
            _modalErrorMessage = ex.Message;
            return;
        }

        _isCreateModalOpen = false;
        _modalErrorMessage = null;
        EquipmentService.NotifyStateChanged();
        await RefreshEquipmentDataAsync();
    }

    private string GetReservationCardStyle(EquipmentReservationModel res)
    {
        if (res.NeedsEquipmentFix)
            return "bg-amber-50 border-amber-400 text-amber-950 ring-1 ring-amber-300";
        if (res.HasConflict)
            return "bg-rose-50 border-rose-300 text-rose-950";
        return "bg-blue-50/70 border-blue-200 text-blue-950";
    }

    public ValueTask DisposeAsync()
    {
        EquipmentService.OnChange -= HandleEquipmentServiceChange;
        PaymentHub.OnEventStatusChanged -= HandleHubEventStatusChangedAsync;
        return ValueTask.CompletedTask;
    }
}
