@page "/equipment-schedule"
@page "/equipments-schedule"
@page "/admin/calendar/equipment"
@page "/admin/calendar/equipments"
@page "/admin/equipment-schedule"
@page "/admin/equipments-schedule"
@layout AdminLayout
@rendermode InteractiveServer
@using PhotoAevumStudio.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IScheduleService ScheduleService
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService

<PageTitle>Equipments Schedule | Aevum Studio</PageTitle>

@if (_isUnauthorized)
{
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-8 text-center my-6">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-rose-100 text-rose-600 mb-4">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h2 class="text-xl font-bold text-rose-900 mb-2">Access Denied (403)</h2>
        <p class="text-sm text-rose-700 max-w-md mx-auto">
            You do not have authorization to view the Equipments Schedule. Access to equipment reservation timelines and dispatch schedules is restricted to Office Clerks and Studio Administrators.
        </p>
    </div>
}
else
{
<div class="space-y-4 pb-10">
    @* ── 1. COMPACT PAGE HEADER & STATUS STRIP ────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-gray-200 pb-3">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-400">
                <span>Gear Inventory</span>
                <span>/</span>
                <span class="text-gray-900 font-bold">Equipment Schedule</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">Equipment Timeline & Dispatch</h1>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                📷 @EquipmentResources.Count Units
            </span>
            <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                ✓ @ThisWeekReservationsCount Dispatches Active
            </span>
            @if (InMaintenanceCount > 0)
            {
                <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                    🛠 @InMaintenanceCount Bench Tech
                </span>
            }
            @if (ConflictCount > 0)
            {
                <button type="button" @onclick="ToggleConflictFilter" class="px-2.5 py-1 text-xs font-bold rounded-full bg-rose-600 text-white cursor-pointer">
                    ⚠️ @ConflictCount Overbooked
                </button>
            }
            else
            {
                <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-teal-50 text-teal-700 border border-teal-200">
                    ✓ All Gear Available
                </span>
            }

            <button type="button" @onclick="OpenCreateModal" class="px-3 py-1.5 bg-gray-900 hover:bg-black text-white text-xs font-semibold rounded-lg shadow-xs ml-2">
                + Reserve Gear
            </button>
        </div>
    </div>

    @* ── 2. COMPACT TOOLBAR & FILTERS ─────────────────────────────────── *@
    <div class="bg-white p-3 rounded-lg border border-gray-200 shadow-2xs flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
            <div class="inline-flex bg-gray-100 p-0.5 rounded-md border border-gray-200">
                <button type="button" @onclick="() => SetViewMode(ScheduleViewMode.Day)" class="px-2.5 py-1 font-semibold rounded @(_currentView == ScheduleViewMode.Day ? "bg-white shadow-2xs text-gray-900" : "text-gray-500")">Day</button>
                <button type="button" @onclick="() => SetViewMode(ScheduleViewMode.Week)" class="px-2.5 py-1 font-semibold rounded @(_currentView == ScheduleViewMode.Week ? "bg-white shadow-2xs text-gray-900" : "text-gray-500")">Week</button>
                <button type="button" @onclick="() => SetViewMode(ScheduleViewMode.Month)" class="px-2.5 py-1 font-semibold rounded @(_currentView == ScheduleViewMode.Month ? "bg-white shadow-2xs text-gray-900" : "text-gray-500")">Month</button>
                <button type="button" @onclick="() => SetViewMode(ScheduleViewMode.Agenda)" class="px-2.5 py-1 font-semibold rounded @(_currentView == ScheduleViewMode.Agenda ? "bg-white shadow-2xs text-gray-900" : "text-gray-500")">Agenda</button>
            </div>

            <div class="flex items-center gap-1">
                <button type="button" @onclick="NavigatePrevious" class="px-2 py-1 bg-white border border-gray-200 rounded font-bold">‹</button>
                <span class="font-bold px-2 text-gray-800">@FormattedDateRangeHeader</span>
                <button type="button" @onclick="NavigateNext" class="px-2 py-1 bg-white border border-gray-200 rounded font-bold">›</button>
                <button type="button" @onclick="JumpToToday" class="px-2 py-1 bg-gray-50 border border-gray-200 rounded font-medium">Today</button>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <select @bind="_selectedCategoryFilter" class="p-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                <option value="">All Categories</option>
                <option value="Cameras & Bodies">Cameras & Bodies</option>
                <option value="Lenses & Optics">Lenses & Optics</option>
                <option value="Strobe & Continuous Lighting">Lighting</option>
                <option value="Audio & Microphones">Audio</option>
            </select>

            <select @bind="_selectedStatusFilter" class="p-1.5 bg-gray-50 border border-gray-200 rounded text-xs">
                <option value="">All Statuses</option>
                <option value="Ready">Ready</option>
                <option value="In-Use">In-Use</option>
                <option value="In-Maintenance">In-Maintenance</option>
            </select>

            <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Search gear / serial..." class="p-1.5 bg-gray-50 border border-gray-200 rounded text-xs w-36 focus:w-48 transition-all" />

            @if (HasActiveFilters)
            {
                <button type="button" @onclick="ClearFilters" class="text-rose-600 font-semibold underline">Reset</button>
            }
        </div>
    </div>

    @* ── 3. MAIN COMPACT TIMELINE MATRIX ──────────────────────────────── *@
    @if (_currentView == ScheduleViewMode.Week)
    {
        <div class="bg-white rounded-lg border border-gray-200 shadow-2xs overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 font-bold text-gray-500 uppercase">
                            <th class="w-56 p-2.5 border-r border-gray-200">Equipment & Serial</th>
                            @foreach (var day in WeekDays)
                            {
                                var isToday = day.Date == DateTime.Today;
                                <th class="p-2 border-r border-gray-200 text-center @(isToday ? "bg-amber-50" : "")">
                                    <div>@day.ToString("ddd") <span class="font-extrabold text-gray-900">@day.Day</span></div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var eq in FilteredEquipment)
                        {
                            <tr class="hover:bg-gray-50/50">
                                <td class="p-2.5 border-r border-gray-200">
                                    <div class="flex items-center justify-between">
                                        <div class="font-bold text-gray-900">@eq.Name</div>
                                        <span class="text-[9px] px-1.5 py-0.2 rounded font-bold @(eq.Status == "Ready" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                                            @(eq.Status == "Ready" ? "✓ Ready" : eq.Status)
                                        </span>
                                    </div>
                                    <div class="text-[10px] text-gray-500">
                                        <code>@eq.SerialNumber</code> &bull; @eq.Category
                                    </div>
                                </td>

                                @foreach (var day in WeekDays)
                                {
                                    var dayReservations = FilteredReservations
                                        .Where(r => r.EquipmentId == eq.Id && r.Date.Date == day.Date)
                                        .OrderBy(r => r.StartTime)
                                        .ToList();

                                    <td class="p-1 border-r border-gray-100 align-top">
                                        <div class="space-y-1 min-h-[48px]">
                                            @foreach (var res in dayReservations)
                                            {
                                                <div @onclick="() => OpenDetailDrawer(res)"
                                                     class="p-1.5 rounded border text-[11px] cursor-pointer transition-all @GetReservationCardStyle(res)">
                                                    <div class="flex items-center justify-between font-bold">
                                                        <span>@res.FormattedTimeRange</span>
                                                        @if (res.HasConflict)
                                                        {
                                                            <span class="text-rose-700 font-extrabold text-[10px]" title="Conflict!">⚠️</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-emerald-700 font-bold text-[10px]" title="Verified Booking">✓</span>
                                                        }
                                                    </div>
                                                    <div class="text-[10px] truncate">@res.ProjectOrClient &bull; 👤 @res.TechnicianInCharge</div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white p-4 rounded-lg border border-gray-200">
            <h3 class="font-bold text-sm mb-3">Reservations for @FormattedDateRangeHeader</h3>
            <div class="space-y-2">
                @foreach (var res in FilteredReservations.Where(r => r.Date.Date == _selectedDate.Date))
                {
                    <div @onclick="() => OpenDetailDrawer(res)" class="p-2 border rounded flex items-center justify-between cursor-pointer hover:bg-gray-50">
                        <div class="flex items-center gap-3">
                            <span class="font-bold text-xs">@res.FormattedTimeRange</span>
                            <span class="font-bold text-xs">@res.EquipmentName</span>
                            <span class="text-xs text-gray-500">@res.ProjectOrClient &bull; 👤 @res.TechnicianInCharge</span>
                        </div>
                        <span class="text-xs px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-semibold">✓ Dispatched</span>
                    </div>
                }
            </div>
        </div>
    }

    @* ── DETAIL DRAWER & CREATE MODAL ─────────────────────────────────── *@
    @if (_selectedReservation != null)
    {
        <div class="fixed inset-0 bg-black/40 z-50 flex justify-end" @onclick="CloseDetailDrawer">
            <div class="w-80 bg-white h-full p-5 shadow-xl flex flex-col justify-between" @onclick:stopPropagation="true">
                <div>
                    <div class="flex items-center justify-between border-b pb-3 mb-3">
                        <h3 class="font-bold text-sm">Reservation Details</h3>
                        <button type="button" @onclick="CloseDetailDrawer" class="text-gray-400 font-bold">✕</button>
                    </div>
                    <div class="space-y-2 text-xs">
                        <div><strong class="text-gray-500">Equipment:</strong> @_selectedReservation.EquipmentName</div>
                        <div><strong class="text-gray-500">Project / Client:</strong> @_selectedReservation.ProjectOrClient</div>
                        <div><strong class="text-gray-500">Technician:</strong> @_selectedReservation.TechnicianInCharge</div>
                        <div><strong class="text-gray-500">Schedule:</strong> @_selectedReservation.Date.ToString("ddd, MMM d") (@_selectedReservation.FormattedTimeRange)</div>
                        <div><strong class="text-gray-500">Location:</strong> @_selectedReservation.Location</div>
                    </div>
                </div>
                <div class="pt-3 border-t">
                    <button type="button" @onclick="DeleteSelectedReservation" class="w-full py-1.5 bg-rose-50 text-rose-700 font-semibold rounded text-xs border border-rose-200">Cancel Reservation</button>
                </div>
            </div>
        </div>
    }

    @if (_isCreateModalOpen)
    {
        <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4" @onclick="CloseCreateModal">
            <div class="w-96 bg-white rounded-lg shadow-xl p-5" @onclick:stopPropagation="true">
                <h3 class="font-bold text-sm mb-3">Reserve Equipment</h3>
                @if (!string.IsNullOrEmpty(_modalErrorMessage))
                {
                    <div class="p-2 mb-2 bg-rose-50 text-rose-700 text-xs rounded">@_modalErrorMessage</div>
                }
                <div class="space-y-2 text-xs">
                    <div>
                        <label class="block font-semibold mb-1">Equipment Unit</label>
                        <select @bind="_newReservation.EquipmentId" class="w-full p-1.5 border rounded">
                            @foreach (var eq in EquipmentResources)
                            {
                                <option value="@eq.Id">@eq.Name (@eq.SerialNumber)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1">Project / Production</label>
                        <input type="text" @bind="_newReservation.ProjectOrClient" class="w-full p-1.5 border rounded" placeholder="e.g. Vogue Editorial" />
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block font-semibold mb-1">Date</label>
                            <input type="date" @bind="_newReservationDate" class="w-full p-1.5 border rounded" />
                        </div>
                        <div>
                            <label class="block font-semibold mb-1">Tech in Charge</label>
                            <input type="text" @bind="_newReservation.TechnicianInCharge" class="w-full p-1.5 border rounded" />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block font-semibold mb-1">Start Time</label>
                            <input type="time" @bind="_newStartTime" class="w-full p-1.5 border rounded" />
                        </div>
                        <div>
                            <label class="block font-semibold mb-1">End Time</label>
                            <input type="time" @bind="_newEndTime" class="w-full p-1.5 border rounded" />
                        </div>
                    </div>
                </div>
                <div class="flex justify-end gap-2 mt-4 pt-3 border-t">
                    <button type="button" @onclick="CloseCreateModal" class="px-3 py-1 text-xs border rounded">Cancel</button>
                    <button type="button" @onclick="SaveNewReservation" class="px-3 py-1 text-xs bg-gray-900 text-white rounded font-bold">Reserve</button>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }
    private ClaimsPrincipal? _currentUser;
    private bool _isUnauthorized;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            _currentUser = state.User;
        }
        else if (AuthStateProvider != null)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentUser = state.User;
        }

        _isUnauthorized = EmployeeRoleHelper.IsPhotographerOrCreative(_currentUser, UserService);
    }

    private ScheduleViewMode _currentView = ScheduleViewMode.Week;
    private DateTime _selectedDate = DateTime.Today;
    private string _searchQuery = string.Empty;
    private string _selectedCategoryFilter = string.Empty;
    private string _selectedStatusFilter = string.Empty;
    private bool _filterOnlyConflicts = false;

    private EquipmentReservationModel? _selectedReservation;
    private bool _isCreateModalOpen;
    private string? _modalErrorMessage;

    private EquipmentReservationModel _newReservation = new();
    private DateTime _newReservationDate = DateTime.Today;
    private TimeOnly _newStartTime = new(9, 0);
    private TimeOnly _newEndTime = new(14, 0);

    private List<EquipmentItemResource> EquipmentResources => ScheduleService.GetEquipmentResources();
    private List<EquipmentReservationModel> AllReservations => ScheduleService.GetEquipmentReservations();

    private int ConflictCount => ScheduleService.GetEquipmentConflictCount();
    private int InMaintenanceCount => EquipmentResources.Count(e => e.Status == "In-Maintenance" || e.Status == "Calibration Due");
    private int ThisWeekReservationsCount => AllReservations.Count(r => WeekDays.Any(w => w.Date == r.Date.Date));
    private double ThisWeekHoursCount => AllReservations.Where(r => WeekDays.Any(w => w.Date == r.Date.Date)).Sum(r => r.DurationHours);

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_searchQuery) ||
        !string.IsNullOrEmpty(_selectedCategoryFilter) ||
        !string.IsNullOrEmpty(_selectedStatusFilter) ||
        _filterOnlyConflicts;

    private List<DateTime> WeekDays
    {
        get
        {
            int diff = (7 + (_selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
            var monday = _selectedDate.AddDays(-1 * diff);
            return Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
        }
    }

    private string FormattedDateRangeHeader => _currentView switch
    {
        ScheduleViewMode.Day => _selectedDate.ToString("MMMM d, yyyy"),
        ScheduleViewMode.Week => $"{WeekDays.First():MMM d} – {WeekDays.Last():MMM d, yyyy}",
        ScheduleViewMode.Month => _selectedDate.ToString("MMMM yyyy"),
        ScheduleViewMode.Agenda => $"{_selectedDate:MMM d} – {_selectedDate.AddDays(14):MMM d, yyyy}",
        _ => _selectedDate.ToString("MMMM yyyy")
    };

    private IEnumerable<EquipmentItemResource> FilteredEquipment
    {
        get
        {
            var query = EquipmentResources.AsEnumerable();
            if (!string.IsNullOrEmpty(_selectedCategoryFilter))
                query = query.Where(e => e.Category.Equals(_selectedCategoryFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(_selectedStatusFilter))
                query = query.Where(e => e.Status.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(e => e.Name.ToLowerInvariant().Contains(q) || e.SerialNumber.ToLowerInvariant().Contains(q));
            }
            return query;
        }
    }

    private IEnumerable<EquipmentReservationModel> FilteredReservations
    {
        get
        {
            var query = AllReservations.AsEnumerable();
            if (!string.IsNullOrEmpty(_selectedStatusFilter))
                query = query.Where(r => r.MaintenanceStatus.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase));
            if (_filterOnlyConflicts)
                query = query.Where(r => r.HasConflict);
            return query;
        }
    }

    private void SetViewMode(ScheduleViewMode mode) => _currentView = mode;

    private void NavigatePrevious()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(-1),
            ScheduleViewMode.Week => _selectedDate.AddDays(-7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(-1),
            _ => _selectedDate.AddDays(-7)
        };
    }

    private void NavigateNext()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(1),
            ScheduleViewMode.Week => _selectedDate.AddDays(7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(1),
            _ => _selectedDate.AddDays(7)
        };
    }

    private void JumpToToday() => _selectedDate = DateTime.Today;

    private void ToggleConflictFilter() => _filterOnlyConflicts = !_filterOnlyConflicts;

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _selectedCategoryFilter = string.Empty;
        _selectedStatusFilter = string.Empty;
        _filterOnlyConflicts = false;
    }

    private void OpenDetailDrawer(EquipmentReservationModel res) => _selectedReservation = res;
    private void CloseDetailDrawer() => _selectedReservation = null;

    private void DeleteSelectedReservation()
    {
        if (_selectedReservation != null)
        {
            ScheduleService.DeleteEquipmentReservation(_selectedReservation.Id);
            _selectedReservation = null;
        }
    }

    private void OpenCreateModal()
    {
        _newReservation = new EquipmentReservationModel
        {
            EquipmentId = EquipmentResources.FirstOrDefault()?.Id ?? "eq-01",
            TechnicianInCharge = "Elena Rostova",
            Location = "Studio A",
            MaintenanceStatus = "Ready"
        };
        _newReservationDate = _selectedDate;
        _newStartTime = new TimeOnly(9, 0);
        _newEndTime = new TimeOnly(14, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private void SaveNewReservation()
    {
        if (_newEndTime <= _newStartTime)
        {
            _modalErrorMessage = "Reservation end time must be after start time.";
            return;
        }

        _newReservation.Date = _newReservationDate;
        _newReservation.StartTime = _newStartTime.ToTimeSpan();
        _newReservation.EndTime = _newEndTime.ToTimeSpan();

        ScheduleService.AddEquipmentReservation(_newReservation);
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private string GetReservationCardStyle(EquipmentReservationModel res)
    {
        if (res.HasConflict)
            return "bg-rose-50 border-rose-300 text-rose-950";
        return "bg-blue-50/70 border-blue-200 text-blue-950";
    }
}
