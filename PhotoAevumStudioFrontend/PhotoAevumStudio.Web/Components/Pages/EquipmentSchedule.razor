    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- 7. + RESERVE EQUIPMENT CREATION MODAL                                 -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    @if (_isCreateModalOpen)
