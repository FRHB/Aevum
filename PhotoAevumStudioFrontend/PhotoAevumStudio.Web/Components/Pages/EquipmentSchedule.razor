</div>

@code {
    private ScheduleViewMode _currentView = ScheduleViewMode.Week;
    private DateTime _selectedDate = DateTime.Today;
    private string _searchQuery = string.Empty;
    private string _selectedCategoryFilter = string.Empty;
    private string _selectedStatusFilter = string.Empty;
    private bool _filterOnlyConflicts = false;

    private EquipmentReservationModel? _selectedReservation;
    private bool _isCreateModalOpen;
    private string? _modalErrorMessage;

    // Creation model state
    private EquipmentReservationModel _newReservation = new();
    private DateTime _newReservationDate = DateTime.Today;
    private TimeOnly _newStartTime = new(9, 0);
    private TimeOnly _newEndTime = new(14, 0);

    private List<EquipmentItemResource> EquipmentResources => ScheduleService.GetEquipmentResources();
    private List<EquipmentReservationModel> AllReservations => ScheduleService.GetEquipmentReservations();

    private int ConflictCount => ScheduleService.GetEquipmentConflictCount();
    private int ThisWeekReservationsCount => AllReservations.Count(r => WeekDays.Any(w => w.Date == r.Date.Date));
    private double ThisWeekHoursCount => AllReservations.Where(r => WeekDays.Any(w => w.Date == r.Date.Date)).Sum(r => r.DurationHours);
    private int InMaintenanceCount => EquipmentResources.Count(e => e.Status == "In-Maintenance" || e.Status == "Calibration Due");

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_searchQuery) ||
        !string.IsNullOrEmpty(_selectedCategoryFilter) ||
        !string.IsNullOrEmpty(_selectedStatusFilter) ||
        _filterOnlyConflicts;

    private List<DateTime> WeekDays
    {
        get
        {
            int diff = (7 + (_selectedDate.DayOfWeek - DayOfWeek.Monday)) % 7;
            var monday = _selectedDate.AddDays(-1 * diff);
            return Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
        }
    }

    private List<DateTime> MonthCalendarDays
    {
        get
        {
            var firstOfMonth = new DateTime(_selectedDate.Year, _selectedDate.Month, 1);
            int diff = (7 + (firstOfMonth.DayOfWeek - DayOfWeek.Monday)) % 7;
            var start = firstOfMonth.AddDays(-1 * diff);
            return Enumerable.Range(0, 35).Select(i => start.AddDays(i)).ToList();
        }
    }

    private string FormattedDateRangeHeader => _currentView switch
    {
        ScheduleViewMode.Day => _selectedDate.ToString("MMMM d, yyyy"),
        ScheduleViewMode.Week => $"{WeekDays.First():MMM d} – {WeekDays.Last():MMM d, yyyy}",
        ScheduleViewMode.Month => _selectedDate.ToString("MMMM yyyy"),
        ScheduleViewMode.Agenda => $"{_selectedDate:MMM d} – {_selectedDate.AddDays(14):MMM d, yyyy}",
        _ => _selectedDate.ToString("MMMM yyyy")
    };

    private IEnumerable<EquipmentItemResource> FilteredEquipment
    {
        get
        {
            var query = EquipmentResources.AsEnumerable();

            if (!string.IsNullOrEmpty(_selectedCategoryFilter))
                query = query.Where(e => e.Category.Equals(_selectedCategoryFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_selectedStatusFilter))
                query = query.Where(e => e.Status.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase));

            return query;
        }
    }

    private IEnumerable<EquipmentReservationModel> FilteredReservations
    {
        get
        {
            var query = AllReservations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                query = query.Where(r =>
                    r.EquipmentName.ToLowerInvariant().Contains(q) ||
                    r.Category.ToLowerInvariant().Contains(q) ||
                    r.ProjectOrClient.ToLowerInvariant().Contains(q) ||
                    r.TechnicianInCharge.ToLowerInvariant().Contains(q) ||
                    r.Location.ToLowerInvariant().Contains(q) ||
                    r.Notes.ToLowerInvariant().Contains(q));
            }

            if (!string.IsNullOrEmpty(_selectedCategoryFilter))
                query = query.Where(r => r.Category.Equals(_selectedCategoryFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_selectedStatusFilter))
                query = query.Where(r => r.MaintenanceStatus.Equals(_selectedStatusFilter, StringComparison.OrdinalIgnoreCase));

            if (_filterOnlyConflicts)
                query = query.Where(r => r.HasConflict);

            return query;
        }
    }

    private IEnumerable<IGrouping<DateTime, EquipmentReservationModel>> AgendaGroupedReservations =>
        FilteredReservations
            .Where(r => r.Date.Date >= _selectedDate.Date && r.Date.Date <= _selectedDate.Date.AddDays(14))
            .OrderBy(r => r.Date)
            .ThenBy(r => r.StartTime)
            .GroupBy(r => r.Date.Date);

    private IEnumerable<EquipmentReservationModel> GetReservationsForDay(DateTime day) =>
        FilteredReservations.Where(r => r.Date.Date == day.Date);

    private IEnumerable<EquipmentReservationModel> GetReservationsForEquipment(string eqId) =>
        FilteredReservations.Where(r => r.EquipmentId == eqId);

    private void SetViewMode(ScheduleViewMode mode)
    {
        _currentView = mode;
    }

    private void NavigatePrevious()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(-1),
            ScheduleViewMode.Week => _selectedDate.AddDays(-7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(-1),
            ScheduleViewMode.Agenda => _selectedDate.AddDays(-14),
            _ => _selectedDate.AddDays(-7)
        };
    }

    private void NavigateNext()
    {
        _selectedDate = _currentView switch
        {
            ScheduleViewMode.Day => _selectedDate.AddDays(1),
            ScheduleViewMode.Week => _selectedDate.AddDays(7),
            ScheduleViewMode.Month => _selectedDate.AddMonths(1),
            ScheduleViewMode.Agenda => _selectedDate.AddDays(14),
            _ => _selectedDate.AddDays(7)
        };
    }

    private void JumpToToday()
    {
        _selectedDate = DateTime.Today;
    }

    private void ToggleConflictFilter()
    {
        _filterOnlyConflicts = !_filterOnlyConflicts;
    }

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _selectedCategoryFilter = string.Empty;
        _selectedStatusFilter = string.Empty;
        _filterOnlyConflicts = false;
    }

    private void OpenDetailDrawer(EquipmentReservationModel reservation)
    {
        _selectedReservation = reservation;
    }

    private void CloseDetailDrawer()
    {
        _selectedReservation = null;
    }

    private void UpdateMaintenanceStatus(string newStatus)
    {
        if (_selectedReservation != null)
        {
            _selectedReservation.MaintenanceStatus = newStatus;
            ScheduleService.UpdateEquipmentReservation(_selectedReservation);
        }
    }

    private void DeleteSelectedReservation()
    {
        if (_selectedReservation != null)
        {
            ScheduleService.DeleteEquipmentReservation(_selectedReservation.Id);
            _selectedReservation = null;
        }
    }

    private void OpenCreateModal()
    {
        _newReservation = new EquipmentReservationModel
        {
            EquipmentId = EquipmentResources.FirstOrDefault()?.Id ?? "eq-01",
            TechnicianInCharge = "Elena Rostova",
            Location = "Studio A",
            MaintenanceStatus = "Ready"
        };
        _newReservationDate = _selectedDate;
        _newStartTime = new TimeOnly(9, 0);
        _newEndTime = new TimeOnly(14, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void OpenCreateModalForSlot(string eqId, DateTime date)
    {
        _newReservation = new EquipmentReservationModel
        {
            EquipmentId = eqId,
            Date = date,
            TechnicianInCharge = "Elena Rostova",
            Location = "Studio A",
            MaintenanceStatus = "Ready"
        };
        _newReservationDate = date;
        _newStartTime = new TimeOnly(9, 0);
        _newEndTime = new TimeOnly(14, 0);
        _modalErrorMessage = null;
        _isCreateModalOpen = true;
    }

    private void CloseCreateModal()
    {
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private void SaveNewReservation()
    {
        if (string.IsNullOrWhiteSpace(_newReservation.ProjectOrClient))
        {
            _modalErrorMessage = "Please enter a project, campaign, or client name.";
            return;
        }

        if (_newEndTime <= _newStartTime)
        {
            _modalErrorMessage = "Reservation end time must be after start time.";
            return;
        }

        _newReservation.Date = _newReservationDate;
        _newReservation.StartTime = _newStartTime.ToTimeSpan();
        _newReservation.EndTime = _newEndTime.ToTimeSpan();

        ScheduleService.AddEquipmentReservation(_newReservation);
        _isCreateModalOpen = false;
        _modalErrorMessage = null;
    }

    private string GetReservationCardStyle(EquipmentReservationModel reservation)
    {
        if (reservation.HasConflict)
            return "bg-rose-50/90 border-rose-300 text-rose-950 ring-1 ring-rose-400";

        return reservation.MaintenanceStatus.ToLowerInvariant() switch
        {
            "in-maintenance" => "bg-rose-50/70 border-rose-200 text-rose-950",
            "in-use" => "bg-blue-50/70 border-blue-200 text-blue-950",
            "calibration due" => "bg-amber-50/70 border-amber-200 text-amber-950",
            _ => "bg-emerald-50/70 border-emerald-200 text-emerald-950"
        };
    }

    private string GetMaintenanceBadgeStyle(string status) => status.ToLowerInvariant() switch
    {
        "ready" => "bg-emerald-100 text-emerald-800 border border-emerald-200",
        "in-use" => "bg-blue-100 text-blue-800 border border-blue-200",
        "in-maintenance" => "bg-rose-100 text-rose-800 border border-rose-200",
        "calibration due" => "bg-amber-100 text-amber-800 border border-amber-200",
        _ => "bg-gray-100 text-gray-700"
    };

    private string GetEquipmentStatusDot(string status) => status.ToLowerInvariant() switch
    {
        "ready" => "bg-emerald-500",
        "in-use" => "bg-blue-500",
        "in-maintenance" => "bg-rose-500",
        "calibration due" => "bg-amber-500",
        _ => "bg-gray-400"
    };

    private string GetEquipmentStatusBadge(string status) => status.ToLowerInvariant() switch
    {
        "ready" => "bg-emerald-50 text-emerald-700 border border-emerald-200",
        "in-use" => "bg-blue-50 text-blue-700 border border-blue-200",
        "in-maintenance" => "bg-rose-50 text-rose-700 border border-rose-200",
        "calibration due" => "bg-amber-50 text-amber-700 border border-amber-200",
        _ => "bg-gray-100 text-gray-600 border border-gray-200"
    };
}
