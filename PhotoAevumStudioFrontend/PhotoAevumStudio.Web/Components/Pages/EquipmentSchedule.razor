@page "/equipment-schedule"
@page "/equipments-schedule"
@page "/admin/calendar/equipment"
@page "/admin/calendar/equipments"
@page "/admin/equipment-schedule"
@page "/admin/equipments-schedule"
@layout AdminLayout
@rendermode InteractiveServer
@inject IScheduleService ScheduleService

<PageTitle>Equipments Schedule | Aevum Studio</PageTitle>

<div class="space-y-6 pb-12">
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- 1. PAGE HEADER                                                        -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">
                <span>Events Calendar</span>
                <span class="text-gray-400">/</span>
                <span class="text-gray-900 font-bold">Equipments Schedule</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Equipments Schedule</h1>
            <p class="text-sm text-gray-500 mt-1">
                Timeline, reservations, dispatch, and availability for cameras, lenses, lighting gear, and kits.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button"
                    @onclick="OpenCreateModal"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-900 hover:bg-black text-white text-sm font-semibold rounded-lg shadow-sm hover:shadow transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                <span>Reserve Equipment</span>
            </button>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- 2. CONFLICT INDICATOR BAR (Summary Alert Bar)                        -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    @if (ConflictCount > 0)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl shadow-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 animate-in fade-in duration-200">
            <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0 text-base font-bold">
                    ⚠️
                </span>
                <div>
                    <h3 class="text-sm font-bold text-rose-900">
                        @ConflictCount Equipment Scheduling Conflict(s) Detected
                    </h3>
                    <p class="text-xs text-rose-700 mt-0.5">
                        Double-reservation detected! Gear items have overlapping project schedules and require dispatch resolution.
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
                <button type="button"
                        @onclick="ToggleConflictFilter"
                        class="px-3 py-1.5 text-xs font-semibold rounded-lg border transition-colors @(_filterOnlyConflicts ? "bg-rose-600 text-white border-rose-600" : "bg-white text-rose-800 border-rose-300 hover:bg-rose-100")">
                    @(_filterOnlyConflicts ? "Showing Conflicts Only" : "Filter Conflicts")
                </button>
            </div>
        </div>
    }

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- 3. TOP SUMMARY STATS CARDS                                            -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Gear Inventory</span>
                <span class="p-2 bg-blue-50 text-blue-600 rounded-lg text-sm">📷</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">@EquipmentResources.Count</p>
            <p class="text-xs text-gray-400 mt-1">Cataloged cameras, lighting & optics</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Active Reservations</span>
                <span class="p-2 bg-emerald-50 text-emerald-600 rounded-lg text-sm">📦</span>
            </div>
            <p class="text-2xl font-bold text-gray-900 mt-2">@ThisWeekReservationsCount</p>
            <p class="text-xs text-emerald-600 font-medium mt-1">@ThisWeekHoursCount.ToString("0.#") hrs in production</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Maintenance / Tech</span>
                <span class="p-2 bg-amber-50 text-amber-600 rounded-lg text-sm">🛠️</span>
            </div>
            <p class="text-2xl font-bold text-amber-700 mt-2">@InMaintenanceCount</p>
            <p class="text-xs text-gray-400 mt-1">Units on calibration bench</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Conflict Status</span>
                <span class="p-2 @(ConflictCount > 0 ? "bg-rose-50 text-rose-600" : "bg-emerald-50 text-emerald-600") rounded-lg text-sm">
                    @(ConflictCount > 0 ? "⚠️" : "🛡️")
                </span>
            </div>
            <p class="text-2xl font-bold @(ConflictCount > 0 ? "text-rose-600" : "text-emerald-600") mt-2">
                @(ConflictCount > 0 ? $"{ConflictCount} Overlap(s)" : "Clear")
            </p>
            <p class="text-xs text-gray-400 mt-1">Dispatch overlap check</p>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- 4. CONTROLS HEADER BAR (View Switcher, Navigator, Search, Filters)    -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-xs space-y-4">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            
            <!-- Left: View Mode Switcher -->
            <div class="inline-flex items-center p-1 bg-gray-100 rounded-lg border border-gray-200 self-start">
                <button type="button"
                        @onclick="() => SetViewMode(ScheduleViewMode.Day)"
                        class="px-3 py-1.5 text-xs font-semibold rounded-md transition-all @(_currentView == ScheduleViewMode.Day ? "bg-white text-gray-900 shadow-xs" : "text-gray-600 hover:text-gray-900")">
                    Day
                </button>
                <button type="button"
                        @onclick="() => SetViewMode(ScheduleViewMode.Week)"
                        class="px-3 py-1.5 text-xs font-semibold rounded-md transition-all @(_currentView == ScheduleViewMode.Week ? "bg-white text-gray-900 shadow-xs" : "text-gray-600 hover:text-gray-900")">
                    Week
                </button>
                <button type="button"
                        @onclick="() => SetViewMode(ScheduleViewMode.Month)"
                        class="px-3 py-1.5 text-xs font-semibold rounded-md transition-all @(_currentView == ScheduleViewMode.Month ? "bg-white text-gray-900 shadow-xs" : "text-gray-600 hover:text-gray-900")">
                    Month
                </button>
                <button type="button"
                        @onclick="() => SetViewMode(ScheduleViewMode.Agenda)"
                        class="px-3 py-1.5 text-xs font-semibold rounded-md transition-all @(_currentView == ScheduleViewMode.Agenda ? "bg-white text-gray-900 shadow-xs" : "text-gray-600 hover:text-gray-900")">
                    Agenda
                </button>
            </div>

            <!-- Center: Date Navigator -->
            <div class="flex items-center gap-2 justify-between sm:justify-center">
                <button type="button"
                        @onclick="NavigatePrevious"
                        class="p-2 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 transition-colors shadow-2xs"
                        aria-label="Previous">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>

                <div class="px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-xs sm:text-sm font-bold text-gray-900 min-w-[200px] text-center shadow-2xs">
                    @FormattedDateRangeHeader
                </div>

                <button type="button"
                        @onclick="NavigateNext"
                        class="p-2 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 transition-colors shadow-2xs"
                        aria-label="Next">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>

                <button type="button"
                        @onclick="JumpToToday"
                        class="px-3 py-2 text-xs font-bold rounded-lg border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 transition-colors shadow-2xs">
                    Today
                </button>
            </div>

            <!-- Right: Search Input -->
            <div class="relative w-full lg:w-72">
                <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text"
                       @bind="_searchQuery"
                       @bind:event="oninput"
                       placeholder="Quick search gear, SN, client..."
                       class="w-full pl-9 pr-8 py-2 text-xs bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:bg-white transition-all" />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <button type="button"
                            @onclick="() => _searchQuery = string.Empty"
                            class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 text-xs">
                        ✕
                    </button>
                }
            </div>
        </div>

        <!-- Filter Row (Category & Maintenance Status) -->
        <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-gray-100 text-xs">
            <span class="font-semibold text-gray-500">Filters:</span>

            <!-- Category Dropdown -->
            <select @bind="_selectedCategoryFilter" class="px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-gray-700 font-medium focus:outline-none focus:ring-2 focus:ring-gray-900">
                <option value="">All Categories</option>
                <option value="Camera Bodies">Camera Bodies</option>
                <option value="Cinema Rigs">Cinema Rigs</option>
                <option value="Strobe Lighting">Strobe Lighting</option>
                <option value="Lenses">Lenses</option>
                <option value="Grip & Audio">Grip & Audio</option>
            </select>

            <!-- Status Dropdown -->
            <select @bind="_selectedStatusFilter" class="px-2.5 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-gray-700 font-medium focus:outline-none focus:ring-2 focus:ring-gray-900">
                <option value="">All Hardware Statuses</option>
                <option value="Ready">Ready</option>
                <option value="In-Use">In-Use</option>
                <option value="In-Maintenance">In-Maintenance</option>
            </select>

            @if (HasActiveFilters)
            {
                <button type="button"
                        @onclick="ClearFilters"
                        class="text-xs text-rose-600 hover:text-rose-800 font-semibold underline underline-offset-2 ml-auto">
                    Reset Filters
                </button>
            }
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- 5. MAIN SCHEDULE MATRIX / VIEW RENDERER                               -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    @if (_currentView == ScheduleViewMode.Week)
    {
        @* ── WEEK MATRIX VIEW ───────────────────────────────────────────── *@
        <div class="bg-white rounded-xl border border-gray-200 shadow-xs overflow-hidden">
            <div class="overflow-x-auto relative">
                <table class="w-full text-left border-collapse min-w-[1000px]">
                    <!-- Days Header Row -->
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-xs">
                            <th class="w-64 sm:w-72 shrink-0 sticky left-0 z-20 bg-gray-50 border-r border-gray-200 px-4 py-3 text-gray-500 font-bold uppercase tracking-wider">
                                Equipment Unit & Specs
                            </th>
                            @foreach (var day in WeekDays)
                            {
                                var isToday = day.Date == DateTime.Today;
                                var dayResCount = GetReservationsForDay(day).Count();
                                <th class="px-3 py-3 text-center border-r border-gray-200 min-w-[170px] @(isToday ? "bg-amber-50/40" : "")">
                                    <div class="flex flex-col items-center gap-1">
                                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg @(isToday ? "bg-gray-900 text-white font-bold shadow-xs" : "bg-gray-100 text-gray-700 font-semibold")">
                                            <span>@day.ToString("ddd")</span>
                                            <span class="text-xs">@day.Day</span>
                                        </div>
                                        <span class="text-[10px] text-gray-400 font-normal">
                                            @dayResCount @(dayResCount == 1 ? "reserved" : "reserved")
                                        </span>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>

                    <!-- Matrix Rows -->
                    <tbody class="divide-y divide-gray-200 text-xs">
                        @foreach (var eq in FilteredEquipment)
                        {
                            var eqResThisWeek = GetReservationsForEquipment(eq.Id).Where(r => WeekDays.Any(d => d.Date == r.Date.Date)).ToList();
                            var totalHours = eqResThisWeek.Sum(r => r.DurationHours);

                            <tr class="hover:bg-gray-50/30 transition-colors">
                                <!-- Sticky Left Column: Equipment Resource Info -->
                                <td class="w-64 sm:w-72 shrink-0 sticky left-0 z-10 bg-white border-r border-gray-200 p-4 shadow-[2px_0_5px_rgba(0,0,0,0.03)] align-top">
                                    <div class="space-y-1.5">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2.5 h-2.5 rounded-full @GetEquipmentStatusDot(eq.Status)"></span>
                                            <h4 class="font-bold text-gray-900 text-sm leading-snug">@eq.Name</h4>
                                        </div>

                                        <div class="flex flex-wrap gap-1 text-[11px]">
                                            <span class="px-2 py-0.5 rounded-md @eq.BadgeColor font-medium">
                                                @eq.Category
                                            </span>
                                            <span class="px-2 py-0.5 rounded-md @GetEquipmentStatusBadge(eq.Status) font-medium">
                                                @eq.Status
                                            </span>
                                        </div>

                                        <p class="text-[11px] text-gray-400 font-medium font-mono">
                                            @eq.SerialNumber • @eq.StorageBay
                                        </p>

                                        <div class="pt-1 text-[10px] text-gray-500 font-medium">
                                            @eqResThisWeek.Count booking(s) • @totalHours.ToString("0.#") hrs this week
                                        </div>
                                    </div>
                                </td>

                                <!-- 7 Grid Day Slots -->
                                @foreach (var day in WeekDays)
                                {
                                    var dayReservations = FilteredReservations
                                        .Where(r => r.EquipmentId == eq.Id && r.Date.Date == day.Date)
                                        .OrderBy(r => r.StartTime)
                                        .ToList();

                                    <td class="p-2 border-r border-gray-100 align-top min-w-[170px] relative group hover:bg-gray-50/50 transition-colors">
                                        <div class="space-y-2 min-h-[90px] flex flex-col justify-between">
                                            <div class="space-y-1.5">
                                                @foreach (var res in dayReservations)
                                                {
                                                    <div @onclick="() => OpenDetailDrawer(res)"
                                                         class="p-2.5 rounded-lg border text-left shadow-2xs hover:shadow-md hover:-translate-y-0.5 transition-all cursor-pointer relative @GetReservationCardStyle(res)">
                                                        
                                                        @if (res.HasConflict)
                                                        {
                                                            <div class="flex items-center gap-1 text-[10px] font-bold text-rose-700 bg-rose-100 px-1.5 py-0.5 rounded-sm mb-1 uppercase tracking-tight">
                                                                <span>⚠️ Conflict</span>
                                                            </div>
                                                        }

                                                        <!-- Time Slot -->
                                                        <div class="flex items-center justify-between text-[11px] font-medium mb-1">
                                                            <span class="font-bold text-gray-900">@res.FormattedTimeRange</span>
                                                            <span class="px-1.5 py-0.2 rounded text-[10px] font-semibold @GetMaintenanceBadgeStyle(res.MaintenanceStatus)">
                                                                @res.MaintenanceStatus
                                                            </span>
                                                        </div>

                                                        <!-- Project / Client -->
                                                        <div class="font-bold text-gray-900 text-xs truncate">
                                                            @res.ProjectOrClient
                                                        </div>

                                                        <!-- Technician in Charge -->
                                                        <div class="text-[10px] text-gray-500 truncate mt-0.5 flex items-center gap-1">
                                                            <span>👤</span>
                                                            <span>@res.TechnicianInCharge</span>
                                                        </div>

                                                        <!-- Location tag -->
                                                        <div class="text-[10px] text-gray-400 mt-1 flex items-center gap-1">
                                                            <span>📍</span>
                                                            <span>@res.Location</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Subtle + Button -->
                                            <button type="button"
                                                    @onclick="() => OpenCreateModalForSlot(eq.Id, day)"
                                                    class="w-full py-1 text-center border border-dashed border-gray-200 rounded-md text-[11px] text-gray-400 hover:text-gray-900 hover:border-gray-400 hover:bg-gray-100/70 transition-all opacity-0 group-hover:opacity-100 flex items-center justify-center gap-1">
                                                <span>+</span>
                                                <span>Reserve</span>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (_currentView == ScheduleViewMode.Day)
    {
        @* ── DAY VIEW ────────────────────────────────────────────────────── *@
        <div class="bg-white rounded-xl border border-gray-200 shadow-xs p-6 space-y-6">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Equipment Dispatch: @_selectedDate.ToString("dddd, MMMM d, yyyy")</h3>
                    <p class="text-xs text-gray-500">Live hardware checkout schedule and field equipment assignments.</p>
                </div>
                <button type="button"
                        @onclick="() => OpenCreateModalForSlot(EquipmentResources.FirstOrDefault()?.Id ?? string.Empty, _selectedDate)"
                        class="px-3 py-1.5 bg-gray-900 hover:bg-black text-white text-xs font-semibold rounded-lg shadow-xs">
                    + Reserve Gear
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var eq in FilteredEquipment)
                {
                    var dayRes = FilteredReservations
                        .Where(r => r.EquipmentId == eq.Id && r.Date.Date == _selectedDate.Date)
                        .OrderBy(r => r.StartTime)
                        .ToList();

                    <div class="p-4 rounded-xl border border-gray-200 bg-gray-50/50 space-y-3">
                        <div class="flex items-center justify-between">
                            <div>
                                <h4 class="font-bold text-gray-900 text-sm">@eq.Name</h4>
                                <p class="text-[11px] text-gray-400 font-mono">@eq.SerialNumber</p>
                            </div>
                            <span class="text-xs px-2 py-0.5 rounded-full @GetEquipmentStatusBadge(eq.Status) font-medium">@eq.Status</span>
                        </div>

                        @if (dayRes.Any())
                        {
                            <div class="space-y-2">
                                @foreach (var r in dayRes)
                                {
                                    <div @onclick="() => OpenDetailDrawer(r)"
                                         class="p-3 bg-white rounded-lg border shadow-2xs hover:shadow-md transition-all cursor-pointer @GetReservationCardStyle(r)">
                                        <div class="flex items-center justify-between text-xs font-semibold mb-1">
                                            <span>@r.FormattedTimeRange</span>
                                            <span class="px-2 py-0.5 rounded text-[10px] @GetMaintenanceBadgeStyle(r.MaintenanceStatus)">@r.MaintenanceStatus</span>
                                        </div>
                                        <h5 class="font-bold text-gray-900 text-sm">@r.ProjectOrClient</h5>
                                        <div class="flex items-center justify-between mt-2 pt-2 border-t border-gray-100 text-[11px] text-gray-500">
                                            <span>👤 Tech: @r.TechnicianInCharge</span>
                                            <span>📍 @r.Location</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="py-6 text-center border border-dashed border-gray-200 rounded-lg bg-white/70">
                                <p class="text-xs text-gray-400">Available in locker / storage</p>
                                <button type="button"
                                        @onclick="() => OpenCreateModalForSlot(eq.Id, _selectedDate)"
                                        class="mt-2 text-xs font-semibold text-gray-900 hover:underline">
                                    + Reserve Unit
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (_currentView == ScheduleViewMode.Month)
    {
        @* ── MONTH VIEW ──────────────────────────────────────────────────── *@
        <div class="bg-white rounded-xl border border-gray-200 shadow-xs overflow-hidden">
            <div class="grid grid-cols-7 border-b border-gray-200 bg-gray-50 text-center text-xs font-bold text-gray-500 py-2.5">
                <div>Mon</div>
                <div>Tue</div>
                <div>Wed</div>
                <div>Thu</div>
                <div>Fri</div>
                <div>Sat</div>
                <div>Sun</div>
            </div>

            <div class="grid grid-cols-7 auto-rows-fr divide-x divide-y divide-gray-100">
                @foreach (var day in MonthCalendarDays)
                {
                    var isCurrentMonth = day.Month == _selectedDate.Month;
                    var isToday = day.Date == DateTime.Today;
                    var dayRes = FilteredReservations.Where(r => r.Date.Date == day.Date).ToList();

                    <div class="min-h-[110px] p-2 @(isCurrentMonth ? "bg-white" : "bg-gray-50/50 text-gray-400") hover:bg-gray-50/80 transition-colors flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold @(isToday ? "w-6 h-6 rounded-full bg-gray-900 text-white flex items-center justify-center" : "text-gray-700")">
                                @day.Day
                            </span>
                            @if (dayRes.Count > 0)
                            {
                                <span class="text-[10px] font-bold text-gray-400">@dayRes.Count</span>
                            }
                        </div>

                        <div class="space-y-1 my-1 overflow-hidden">
                            @foreach (var r in dayRes.Take(2))
                            {
                                <div @onclick="() => OpenDetailDrawer(r)"
                                     class="px-1.5 py-0.5 rounded text-[10px] font-medium truncate cursor-pointer @(r.HasConflict ? "bg-rose-100 text-rose-800 border border-rose-300" : "bg-blue-50 text-blue-800 border border-blue-200")">
                                    @r.EquipmentName.Split(' ').FirstOrDefault(): @r.ProjectOrClient
                                </div>
                            }
                            @if (dayRes.Count > 2)
                            {
                                <span class="text-[10px] text-gray-500 font-semibold pl-1">+@(dayRes.Count - 2) more</span>
                            }
                        </div>

                        <button type="button"
                                @onclick="() => OpenCreateModalForSlot(EquipmentResources.FirstOrDefault()?.Id ?? string.Empty, day)"
                                class="text-[10px] text-gray-300 hover:text-gray-900 text-left font-semibold">
                            + Add
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @* ── AGENDA VIEW ─────────────────────────────────────────────────── *@
        <div class="bg-white rounded-xl border border-gray-200 shadow-xs p-6 space-y-6">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Upcoming Equipment Dispatch Agenda</h3>
                    <p class="text-xs text-gray-500">Chronological feed of hardware checkout schedules and project reservations.</p>
                </div>
            </div>

            @if (AgendaGroupedReservations.Any())
            {
                <div class="space-y-6">
                    @foreach (var group in AgendaGroupedReservations)
                    {
                        <div class="space-y-3">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-gray-900"></span>
                                <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700">
                                    @group.Key.ToString("dddd, MMMM d, yyyy")
                                </h4>
                                <span class="text-xs text-gray-400">(@group.Count() reservation@(group.Count() == 1 ? "" : "s"))</span>
                            </div>

                            <div class="space-y-2 pl-5">
                                @foreach (var r in group)
                                {
                                    <div @onclick="() => OpenDetailDrawer(r)"
                                         class="p-4 rounded-xl border bg-white shadow-2xs hover:shadow-md transition-all cursor-pointer flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 @GetReservationCardStyle(r)">
                                        <div class="space-y-1">
                                            <div class="flex items-center gap-2">
                                                <span class="font-bold text-gray-900 text-sm">@r.FormattedTimeRange</span>
                                                <span class="px-2 py-0.5 rounded text-[10px] @GetMaintenanceBadgeStyle(r.MaintenanceStatus)">@r.MaintenanceStatus</span>
                                                @if (r.HasConflict)
                                                {
                                                    <span class="px-2 py-0.5 rounded bg-rose-600 text-white font-bold text-[10px]">⚠️ Conflict</span>
                                                }
                                            </div>
                                            <h5 class="text-base font-bold text-gray-900">@r.EquipmentName</h5>
                                            <p class="text-xs text-gray-500">Project: @r.ProjectOrClient • 📍 @r.Location</p>
                                        </div>

                                        <div class="flex items-center gap-4 text-xs">
                                            <div class="text-right">
                                                <p class="font-bold text-gray-900">👤 @r.TechnicianInCharge</p>
                                                <p class="text-gray-400">@r.DurationHours.ToString("0.#") hrs</p>
                                            </div>
                                            <span class="text-gray-400">›</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12 text-gray-400">
                    <p class="text-sm">No equipment reservations match your search or filter criteria.</p>
                </div>
            }
        </div>
    }

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- 6. SLIDE-OVER DETAIL DRAWER                                           -->
