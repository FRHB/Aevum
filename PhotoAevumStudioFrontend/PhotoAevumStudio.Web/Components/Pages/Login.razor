@page "/login"
@layout EmptyLayout
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using PhotoAevumStudio.Web.Components.Shared
@using PhotoAevumStudio.Web.Components.Layout
@inject NavigationManager NavManager
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Studio Portal Login | Photo Aevum</PageTitle>

<div class="login-page-wrapper">
    <div class="login-card relative">
        <!-- Close / Exit Button returning to Home Page -->
        <a href="/" @onclick="NavigateToHome" class="login-exit-btn" aria-label="Exit to home" title="Exit to Home">
            <svg xmlns="http://www.w3.org/2000/svg" class="exit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </a>

        <!-- Logo Section -->
        <div class="logo-wrapper">
            <img src="images/AevumLogo.jpg" alt="Aevum Studio Logo" class="aevum-logo" />
        </div>

        <div class="portal-badge-container">
            <span class="portal-badge">Photo Aevum Studio</span>
        </div>

        <h2 class="login-header">Sign In</h2>
        <p class="login-subtext">Sign in to access your bookings, gallery, or studio management portal</p>

        <!-- Blazor EditForm for Unified Data Binding -->
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <div class="input-group">
                <label for="userId">Account ID or Email</label>
                <input type="text"
                       id="userId"
                       class="minimal-input"
                       @bind="loginModel.UserId"
                       placeholder="e.g. client email or Staff ID (ADM-001, EMP-001)"
                       required
                       disabled="@isSubmitting" />
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <PasswordInput Id="password"
                               Name="password"
                               Autocomplete="current-password"
                               @bind-Value="loginModel.Password"
                               Placeholder="Enter your account password"
                               Disabled="@isSubmitting" />
                <div class="forgot-password-row">
                    <a href="/forgot-password" class="forgot-password-link">Forgot password?</a>
                </div>
            </div>

            <!-- Display error message if login fails -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="login-error-alert" role="alert">
                    <span class="alert-icon">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <!-- Display success message if account was just created -->
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="login-success-alert" role="status">
                    <span class="alert-icon">✓</span>
                    <span>@successMessage</span>
                </div>
            }

            <button type="submit" class="login-button" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Authenticating...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </EditForm>

        <!-- Client registration prompt for customers -->
        <div class="client-signup-prompt">
            <span>New customer?</span>
            <button type="button" class="signup-link bg-transparent border-0 p-0 text-black font-semibold cursor-pointer underline" @onclick="() => showRegisterModal = true">
                Create an account
            </button>
        </div>

        <!-- Terms & Conditions in-place Modal trigger -->
        <div class="mt-4 text-center text-xs text-gray-500">
            <span>By signing in, you agree to our </span>
            <button type="button" class="text-gray-700 hover:text-black underline font-medium cursor-pointer bg-transparent border-0 p-0" @onclick="() => showTermsModal = true">
                Terms &amp; Conditions
            </button>
        </div>
    </div>
</div>

<!-- Interactive Terms Modal (pop-up rather than a separate page) -->
<TermsModal @bind-IsOpen="showTermsModal" />

<!-- Inline Registration Portal Modal for new client account creation -->
<AuthPortalModal IsVisible="showRegisterModal"
                 OnClose="() => showRegisterModal = false"
                 OnRegistered="HandleCustomerRegistered"
                 InitialView="SignUp" />

@code {
    private LoginCredentials loginModel = new LoginCredentials();
    private string errorMessage = "";
    private string successMessage = "";
    private bool isSubmitting = false;
    private bool showTermsModal = false;
    private bool showRegisterModal = false;

    private void HandleCustomerRegistered(string email)
    {
        showRegisterModal = false;
        loginModel.UserId = email;
        loginModel.Password = string.Empty;
        errorMessage = string.Empty;
        successMessage = "Account created successfully! You can now sign in with your email and password.";
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = "";
        successMessage = "";
        StateHasChanged();

        var result = await AuthService.LoginAsync(loginModel.UserId, loginModel.Password, CancellationToken.None);

        if (result.RequiresPasswordChange)
        {
            NavManager.NavigateTo($"/change-password?userId={Uri.EscapeDataString(result.UserId ?? loginModel.UserId)}");
            return;
        }

        if (result.Success)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            bool isSuper = user.IsInRole("Super Admin") ||
                (!string.IsNullOrEmpty(result.Role) && result.Role.Contains("Super", StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(loginModel.UserId) && loginModel.UserId.StartsWith("SADM-", StringComparison.OrdinalIgnoreCase));

            bool isAdmin = isSuper || user.IsInRole("Admin") ||
                (!string.IsNullOrEmpty(result.Role) && result.Role.Contains("Admin", StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(loginModel.UserId) && loginModel.UserId.StartsWith("ADM-", StringComparison.OrdinalIgnoreCase));

            bool isEmployee = user.IsInRole("Employee") ||
                user.IsInRole("Office Clerk") ||
                (!string.IsNullOrEmpty(result.Role) && (result.Role.Contains("Employee", StringComparison.OrdinalIgnoreCase) || result.Role.Contains("Staff", StringComparison.OrdinalIgnoreCase) || result.Role.Contains("Clerk", StringComparison.OrdinalIgnoreCase))) ||
                (!string.IsNullOrEmpty(loginModel.UserId) && (loginModel.UserId.StartsWith("EMP-", StringComparison.OrdinalIgnoreCase) || loginModel.UserId.StartsWith("CLK-", StringComparison.OrdinalIgnoreCase)));

            if (isAdmin)
                NavManager.NavigateTo("/admin");
            else if (isEmployee)
                NavManager.NavigateTo("/staff");
            else
                NavManager.NavigateTo("/my");
        }
        else
        {
            errorMessage = result.Error ?? "Invalid Account ID, Email, or password. Please check your credentials.";
        }

        isSubmitting = false;
    }

    private void NavigateToHome()
    {
        NavManager.NavigateTo("/");
    }

    public class LoginCredentials
    {
        public string UserId { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
