@page "/staff/team-lead-monitor"
@layout EmployeeLayout
@using PhotoAevumStudio.Web.Services
@using PhotoAevumStudio.Web.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using QRCoder
@implements IAsyncDisposable
@inject IUserService UserService
@inject IEquipmentService EquipmentService
@inject IScheduleService ScheduleService
@inject IConsultationClient ConsultationApi
@inject AuthenticationStateProvider AuthStateProvider
@inject PaymentHubClient PaymentHub
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@attribute [Authorize(Roles = "Employee,Office Clerk,Admin,SystemAdmin")]
@rendermode InteractiveServer

<PageTitle>Team Lead Event Monitor | Photo Aevum Studio</PageTitle>

<header class="aev-page-header">
    <div>
        <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-teal-100 text-teal-800">
                <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
                Team Leader Event Monitor
            </span>
            @if (!string.IsNullOrWhiteSpace(_employeeName))
            {
                <span class="text-xs font-semibold text-slate-500">&bull; @_employeeName (@_employeeId)</span>
            }
        </div>
        <h1 class="aev-page-header__title">My Upcoming &amp; Ongoing Event Monitor</h1>
        <p class="aev-page-header__subtitle">
            Dedicated monitor showing only your upcoming and ongoing Team Lead schedule and live event execution process.
        </p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
        <a href="/staff/calendar/master" class="px-3.5 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700">
            My Calendar &rarr;
        </a>
        <button type="button"
                @onclick="RefreshMonitorAsync"
                disabled="@_loading"
                class="px-3.5 py-2 rounded-lg bg-slate-900 hover:bg-black text-white text-xs font-bold shadow-xs disabled:opacity-50">
            @(_loading ? "Refreshing..." : "🔄 Refresh Monitor")
        </button>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(_actionMessage))
{
    <div class="mb-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-semibold flex items-center justify-between gap-3">
        <span>✓ @_actionMessage</span>
        <button type="button" @onclick="() => _actionMessage = null" class="text-emerald-700 font-bold">✕</button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="mb-4 px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between gap-3">
        <span>⚠ @_errorMessage</span>
        <button type="button" @onclick="() => _errorMessage = null" class="text-rose-700 font-bold">✕</button>
    </div>
}

@if (_loading && !_events.Any())
{
    <div class="bg-white rounded-xl border border-slate-200 p-10 text-center text-xs text-slate-500">
        Loading your upcoming and ongoing Team Lead schedule...
    </div>
}
else if (!_events.Any())
{
    <section class="bg-white rounded-xl border border-slate-200 p-10 text-center shadow-xs">
        <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-xl">
            📋
        </div>
        <h2 class="text-base font-extrabold text-slate-900">No Upcoming or Ongoing Team Lead Events</h2>
        <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
            Once a customer settles the reservation fee for an event where you are designated as Team Leader, your upcoming schedule and event process controls will appear here automatically.
        </p>
        <div class="mt-5 flex items-center justify-center gap-3">
            <a href="/staff" class="px-4 py-2 rounded-lg bg-slate-900 text-white text-xs font-bold hover:bg-black">
                Back to Staff Dashboard
            </a>
            <a href="/staff/calendar/master" class="px-4 py-2 rounded-lg border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-50">
                View My Calendar
            </a>
        </div>
    </section>
}
else
{
    var ongoingCount = _events.Count(e => TeamLeaderMonitorSelector.IsOngoingOrInProcess(e));
    var upcomingCount = _events.Count(e => !TeamLeaderMonitorSelector.IsOngoingOrInProcess(e));
    var displayed = _filter switch
    {
        "Ongoing" => _events.Where(e => TeamLeaderMonitorSelector.IsOngoingOrInProcess(e)).ToList(),
        "Upcoming" => _events.Where(e => !TeamLeaderMonitorSelector.IsOngoingOrInProcess(e)).ToList(),
        _ => _events
    };

    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    @onclick='() => _filter = "All"'
                    class="px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all @(_filter == "All" ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                All My Schedule (@_events.Count)
            </button>
            <button type="button"
                    @onclick='() => _filter = "Ongoing"'
                    class="px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all @(_filter == "Ongoing" ? "bg-teal-700 text-white border-teal-700" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                Ongoing / In Process (@ongoingCount)
            </button>
            <button type="button"
                    @onclick='() => _filter = "Upcoming"'
                    class="px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all @(_filter == "Upcoming" ? "bg-sky-700 text-white border-sky-700" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                Upcoming (@upcomingCount)
            </button>
        </div>
        <span class="text-[11px] text-slate-400">Auto-refreshes every 30s</span>
    </div>

    @if (!displayed.Any())
    {
        <div class="bg-white rounded-xl border border-dashed border-slate-200 p-8 text-center text-xs text-slate-500">
            No @_filter.ToLowerInvariant() events in your Team Lead schedule right now.
        </div>
    }
    else
    {
        <div class="space-y-5">
            @foreach (var tlEv in displayed)
            {
                var isInProcess = TeamLeaderMonitorSelector.IsOngoingOrInProcess(tlEv);
                var processSteps = TeamLeaderMonitorSelector.GetProcessSteps(tlEv);
                var tlEndTime = tlEv.EventEndTime.HasValue && tlEv.EventEndTime.Value > tlEv.EventTime
                    ? tlEv.EventEndTime.Value
                    : tlEv.EventTime.AddMinutes(Math.Max(60, tlEv.DurationMinutes));
                var isPreparing = string.Equals(tlEv.EventStatus, "Preparation", StringComparison.OrdinalIgnoreCase)
                                  || string.Equals(tlEv.EventStatus, "Preparing", StringComparison.OrdinalIgnoreCase)
                                  || string.Equals(tlEv.EventStatus, "Dispatch", StringComparison.OrdinalIgnoreCase);
                var isOngoing = string.Equals(tlEv.EventStatus, "Ongoing", StringComparison.OrdinalIgnoreCase)
                                || string.Equals(tlEv.EventStatus, "On Going", StringComparison.OrdinalIgnoreCase);
                var isEventDone = string.Equals(tlEv.EventStatus, "Event Done", StringComparison.OrdinalIgnoreCase)
                                  || string.Equals(tlEv.EventStatus, "Post Event", StringComparison.OrdinalIgnoreCase);
                var isCashPendingVerif = string.Equals(tlEv.EventStatus, "Payment Verification (Cash)", StringComparison.OrdinalIgnoreCase)
                                         || string.Equals(tlEv.EventStatus, "Pending Verification", StringComparison.OrdinalIgnoreCase)
                                         || string.Equals(tlEv.EventStatus, "Paid Cash Pending Verification", StringComparison.OrdinalIgnoreCase)
                                         || string.Equals(tlEv.FinalPaymentStatus, "Payment Verification (Cash)", StringComparison.OrdinalIgnoreCase)
                                         || string.Equals(tlEv.FinalPaymentStatus, "Pending Verification", StringComparison.OrdinalIgnoreCase);
                var isQrPending = !isCashPendingVerif
                                  && (string.Equals(tlEv.FinalPaymentStatus, "Payment Verification (QR:Pending Payment)", StringComparison.OrdinalIgnoreCase)
                                      || (string.Equals(tlEv.FinalPaymentMethod, "Xendit_QR", StringComparison.OrdinalIgnoreCase)
                                          && !string.IsNullOrWhiteSpace(tlEv.FinalPaymentReferenceId)));
                var isPrePrep = !isPreparing && !isOngoing && !isEventDone && !isCashPendingVerif && !isQrPending;
                var isSettlementUnlocked = (isEventDone || string.Equals(tlEv.EventStatus, "Pending Payment", StringComparison.OrdinalIgnoreCase))
                                           && !isCashPendingVerif && !isQrPending;
                var canSelectArrival = isPrePrep || isPreparing;
                var canStartEvent = isPreparing;
                var canMarkDone = isOngoing;
                _selectedArrivalByEvent.TryGetValue(tlEv.EventAppointmentId, out var selectedArrival);
                var finalRefId = string.IsNullOrWhiteSpace(tlEv.FinalPaymentReferenceId) ? $"{tlEv.EventAppointmentId}-FINAL" : tlEv.FinalPaymentReferenceId;
                var postEventAt = tlEv.PostEventTriggerAt ?? tlEv.EventDate.ToDateTime(tlEv.EventTime).AddHours(1);

                <article class="bg-white rounded-xl border @(isInProcess ? "border-teal-300 ring-1 ring-teal-200" : "border-slate-200") p-6 shadow-xs space-y-4">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
                        <div class="space-y-1.5">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded text-[10px] font-extrabold uppercase @(isInProcess ? "bg-teal-700 text-white" : "bg-sky-100 text-sky-800 border border-sky-200")">
                                    @(isInProcess ? "Ongoing / In Process" : "Upcoming")
                                </span>
                                <span class="font-mono text-[11px] font-bold px-2 py-0.5 rounded bg-slate-900 text-white">#@tlEv.EventAppointmentId</span>
                                <h2 class="text-base font-extrabold text-slate-900">@tlEv.EventName</h2>
                            </div>
                            <div class="text-xs text-slate-600 flex flex-wrap gap-x-4 gap-y-1">
                                <span>Client: <strong class="text-slate-900">@tlEv.CustomerName</strong> @(!string.IsNullOrWhiteSpace(tlEv.CustomerEmail) ? $"({tlEv.CustomerEmail})" : "")</span>
                                @if (!string.IsNullOrWhiteSpace(tlEv.CustomerPhone))
                                {
                                    <span>Phone: <strong class="font-mono">@tlEv.CustomerPhone</strong></span>
                                }
                                <span>Schedule: <strong>@tlEv.EventDate.ToString("MMM dd, yyyy")</strong> &bull; @DateTime.Today.Add(tlEv.EventTime.ToTimeSpan()).ToString("h:mm tt") – @DateTime.Today.Add(tlEndTime.ToTimeSpan()).ToString("h:mm tt")</span>
                                <span>Location: <strong class="text-slate-900">@(!string.IsNullOrWhiteSpace(tlEv.EventLocation) ? tlEv.EventLocation : "Studio A (Main Hall)")</strong></span>
                                <span>Final Balance Due: <strong class="font-mono text-slate-900">₱@tlEv.FinalBalanceAmount.ToString("N2")</strong></span>
                            </div>
                            @if (tlEv.AssignedEmployees.Any())
                            {
                                <div class="text-[11px] text-slate-500 flex flex-wrap gap-1.5 items-center pt-0.5">
                                    <span>Crew:</span>
                                    @foreach (var crew in tlEv.AssignedEmployees)
                                    {
                                        <span class="px-2 py-0.5 rounded bg-slate-50 border border-slate-200 text-slate-700 font-medium">
                                            @crew.EmployeeName @(crew.IsTeamLeader ? "★ Lead" : "")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* ── Event Process Stepper ────────────────────────────────────── *@
                    <div aria-label="Event process progress">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1.5">Event Process</div>
                        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                            @foreach (var step in processSteps)
                            {
                                var boxClass = step.State switch
                                {
                                    "done" => "bg-emerald-100 text-emerald-900 border-emerald-300",
                                    "active-amber" => "bg-amber-200 text-amber-950 border-amber-400 ring-1 ring-amber-400",
                                    "active" => "bg-teal-700 text-white border-teal-700 shadow-2xs",
                                    _ => "bg-slate-50 text-slate-400 border-slate-200"
                                };
                                <div class="px-2.5 py-2 rounded-lg border text-[11px] font-bold text-center flex items-center justify-center gap-1 @boxClass">
                                    @if (step.State == "done")
                                    {
                                        <span>✓</span>
                                    }
                                    <span>@step.Label</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!isCashPendingVerif && !isQrPending)
                    {
                        <div>
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Execution Controls</span>
                                <span class="text-[10px] text-slate-500">
                                    Early / Late &rarr; Preparing &rarr; Event Started &rarr; Event Done &rarr; Settlement (auto-post @postEventAt.ToString("MMM d, h:mm tt"))
                                </span>
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                                <button type="button"
                                        disabled="@(_isUpdating || !canSelectArrival)"
                                        @onclick='() => UpdateStageAsync(tlEv, "Preparing", "Early")'
                                        class="px-3 py-2 rounded-lg border text-xs font-bold transition-all text-center disabled:opacity-45 disabled:cursor-not-allowed @(isPreparing && selectedArrival != "Late" ? "bg-sky-700 text-white border-sky-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:border-sky-400 hover:bg-sky-50/50")">
                                    Early (Preparing)
                                </button>
                                <button type="button"
                                        disabled="@(_isUpdating || !canSelectArrival)"
                                        @onclick='() => UpdateStageAsync(tlEv, "Preparing", "Late")'
                                        class="px-3 py-2 rounded-lg border text-xs font-bold transition-all text-center disabled:opacity-45 disabled:cursor-not-allowed @(isPreparing && selectedArrival == "Late" ? "bg-amber-600 text-white border-amber-600 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:border-amber-400 hover:bg-amber-50/50")">
                                    Late (Preparing)
                                </button>
                                <button type="button"
                                        disabled="@(_isUpdating || !canStartEvent)"
                                        @onclick='() => UpdateStageAsync(tlEv, "Ongoing")'
                                        class="px-3 py-2 rounded-lg border text-xs font-bold transition-all text-center disabled:opacity-45 disabled:cursor-not-allowed @(isOngoing ? "bg-teal-700 text-white border-teal-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:border-teal-400 hover:bg-teal-50/50")">
                                    Event Started
                                </button>
                                <button type="button"
                                        disabled="@(_isUpdating || !canMarkDone)"
                                        @onclick='() => UpdateStageAsync(tlEv, "Event Done")'
                                        class="px-3 py-2 rounded-lg border text-xs font-bold transition-all text-center disabled:opacity-45 disabled:cursor-not-allowed @(isEventDone ? "bg-purple-700 text-white border-purple-700 shadow-xs" : "bg-white text-slate-700 border-slate-200 hover:border-purple-400 hover:bg-purple-50/50")">
                                    Event Done
                                </button>
                            </div>
                        </div>
                    }

                    @if (isPreparing && !isCashPendingVerif && !isQrPending)
                    {
                        <div class="p-4 rounded-xl border border-sky-200 bg-sky-50/30 space-y-3">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                                <div>
                                    <h3 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">📷 Preparation Equipment Checklist</h3>
                                    <p class="text-[11px] text-slate-500">Check each item as taken to dispatch equipment.</p>
                                </div>
                                <button type="button"
                                        disabled="@_isUpdating"
                                        @onclick="() => MarkAllEquipmentTakenAsync(tlEv)"
                                        class="px-3.5 py-2 rounded-lg bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-bold shadow-xs shrink-0">
                                    ✓ Mark Taken &amp; Dispatch
                                </button>
                            </div>

                            @if (!tlEv.AssignedEquipment.Any())
                            {
                                <div class="p-3 rounded-lg bg-white border border-dashed border-slate-200 text-xs text-slate-500 text-center">
                                    No equipment assigned to this event yet.
                                </div>
                            }
                            else
                            {
                                <div class="divide-y divide-slate-100 border border-slate-200 rounded-lg bg-white overflow-hidden">
                                    @foreach (var eq in tlEv.AssignedEquipment)
                                    {
                                        <label class="flex items-center justify-between gap-3 px-3.5 py-2 text-xs hover:bg-slate-50 cursor-pointer">
                                            <div class="flex items-center gap-3">
                                                <input type="checkbox"
                                                       checked="@eq.IsTaken"
                                                       disabled="@_isUpdating"
                                                       @onchange="(ChangeEventArgs e) => ToggleSingleEquipmentTakenAsync(tlEv, eq, e.Value is bool b && b)"
                                                       class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                                <span class="font-bold text-slate-900">@eq.EquipmentName</span>
                                                <span class="text-[11px] text-slate-400 font-mono">(@eq.EquipmentId)</span>
                                            </div>
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(eq.IsTaken ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-500")">
                                                @(eq.IsTaken ? "Taken" : "Pending")
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (isCashPendingVerif)
                    {
                        <div class="p-4 rounded-xl border border-amber-300 bg-amber-50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                            <div>
                                <div class="text-xs font-extrabold text-amber-950">Payment Verification (Cash) — Awaiting Admin / Clerk Verification</div>
                                <p class="text-[11px] text-amber-900 mt-0.5">
                                    Cash payment of <strong>₱@tlEv.FinalBalanceAmount.ToString("N2")</strong> logged. Once verified by Admin/Clerk, this event finishes and leaves your active monitor.
                                </p>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-amber-200 text-amber-950 text-xs font-extrabold shrink-0">Payment Verification (Cash)</span>
                        </div>
                    }
                    else if (isQrPending)
                    {
                        var confirmUrl = ResolveQrConfirmUrl(finalRefId);
                        <div class="p-4 rounded-xl border border-teal-200 bg-teal-50/30 grid grid-cols-1 md:grid-cols-[150px_1fr] gap-4 items-center">
                            <div class="w-36 h-36 mx-auto p-2 bg-white border border-slate-200 rounded-xl shadow-xs">
                                @((MarkupString)BuildQrSvg(confirmUrl))
                            </div>
                            <div class="space-y-2 text-xs">
                                <span class="inline-flex px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-900 font-bold text-[11px]">
                                    Payment Verification (QR:Pending Payment)
                                </span>
                                <div class="font-bold text-slate-900 text-sm">Awaiting Customer Final Balance Scan (₱@tlEv.FinalBalanceAmount.ToString("N2"))</div>
                                <p class="text-slate-600">Reference: <span class="font-mono">@finalRefId</span></p>
                                <div class="flex flex-wrap gap-2">
                                    <a href="/payments/@finalRefId" target="_blank" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 font-bold">
                                        Open Payment Page ↗
                                    </a>
                                    @if (Env.IsDevelopment())
                                    {
                                        <button type="button"
                                                disabled="@_isUpdating"
                                                @onclick="() => SimulateQrPaidAsync(finalRefId)"
                                                class="px-3 py-1.5 rounded-lg border border-dashed border-teal-600 text-teal-800 hover:bg-teal-50 font-bold">
                                            Simulate Customer QR Paid (Dev)
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else if (isSettlementUnlocked)
                    {
                        <div class="p-4 rounded-xl border border-purple-200 bg-purple-50/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div>
                                <div class="text-xs font-extrabold text-slate-900">Final Balance Settlement</div>
                                <p class="text-[11px] text-slate-600">Collect final balance (₱@tlEv.FinalBalanceAmount.ToString("N2")) via Cash or Dynamic Xendit QR.</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <button type="button"
                                        disabled="@_isUpdating"
                                        @onclick='() => SettleEventAsync(tlEv, "Cash_OnHand")'
                                        class="px-3.5 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold shadow-xs">
                                    💵 Cash Received
                                </button>
                                <button type="button"
                                        disabled="@_isUpdating"
                                        @onclick='() => SettleEventAsync(tlEv, "Xendit_QR")'
                                        class="px-3.5 py-2 rounded-lg bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold shadow-xs">
                                    📱 QR Payment
                                </button>
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
    }
}

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }

    private string _employeeId = string.Empty;
    private string _employeeName = string.Empty;
    private List<TeamLeaderEventDto> _events = new();
    private string _filter = "All";
    private bool _loading = true;
    private bool _isUpdating = false;
    private string? _actionMessage;
    private string? _errorMessage;
    private readonly Dictionary<string, string> _selectedArrivalByEvent = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _subscribedHubRefs = new(StringComparer.OrdinalIgnoreCase);
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        ClaimsPrincipal? user = null;
        if (AuthState != null)
        {
            var state = await AuthState;
            user = state.User;
        }
        else
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            user = state.User;
        }

        _employeeId = EmployeeRoleHelper.GetCurrentEmployeeId(user);
        _employeeName = EmployeeRoleHelper.GetCurrentEmployeeName(user, UserService);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshMonitorAsync();
        await SubscribeActiveQrHubAsync();
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                await RefreshMonitorAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        StateHasChanged();
    }

    private async Task RefreshMonitorAsync()
    {
        _loading = true;
        try
        {
            var res = await ConsultationApi.GetTeamLeaderEventsAsync(_employeeId);
            if (res.IsSuccess && res.Value != null)
            {
                _events = TeamLeaderMonitorSelector.SelectUpcomingAndOngoing(res.Value).ToList();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UpdateStageAsync(TeamLeaderEventDto tlEv, string stage, string? arrivalStatus = null)
    {
        _isUpdating = true;
        _actionMessage = null;
        _errorMessage = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(arrivalStatus))
                _selectedArrivalByEvent[tlEv.EventAppointmentId] = arrivalStatus;

            var res = await ConsultationApi.UpdateTeamLeaderEventStatusAsync(tlEv.EventAppointmentId, new UpdateTeamLeaderStatusRequest
            {
                Status = stage,
                ArrivalStatus = arrivalStatus,
                EmployeeId = _employeeId
            });
            if (res.IsSuccess && res.Value != null)
            {
                ScheduleService.InvalidateCache();
                await RefreshMonitorAsync();
                _actionMessage = $"Event #{tlEv.EventAppointmentId} updated to '{res.Value.EventStatus}'.";
            }
            else
            {
                _errorMessage = res.Error?.Message ?? "Failed to update event stage.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
