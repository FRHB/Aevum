    private async Task SettleEventAsync(TeamLeaderEventDto tlEv, string method)
    {
        _isUpdating = true;
        _actionMessage = null;
        _errorMessage = null;
        try
        {
            var req = new CompleteEventRequest
            {
                EventAppointmentId = tlEv.EventAppointmentId,
                ExtraHours = 0m,
                HourlyRate = 1500m,
                SurchargeAmount = 0m,
                OvertimeNotes = string.Empty,
                PaymentMethod = method,
                TeamLeaderEmployeeId = _employeeId,
                Notes = $"Settlement initiated from Team Lead Monitor by {_employeeName} ({_employeeId})."
            };
            var res = await ConsultationApi.CompleteEventAsync(tlEv.EventAppointmentId, req);
            if (res.IsSuccess && res.Value != null)
            {
                ScheduleService.InvalidateCache();
                await RefreshMonitorAsync();
                await SubscribeActiveQrHubAsync();
                _actionMessage = method == "Xendit_QR"
                    ? $"QR payment link generated and emailed to {res.Value.CustomerEmail}."
                    : $"Cash payment of ₱{res.Value.FinalBalanceAmount:N2} logged. Status: Payment Verification (Cash).";
            }
            else
            {
                _errorMessage = res.Error?.Message ?? "Failed to submit event settlement.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isUpdating = false;
        }
    }

