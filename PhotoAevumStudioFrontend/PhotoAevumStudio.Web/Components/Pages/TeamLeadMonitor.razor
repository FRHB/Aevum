@page "/staff/team-lead-monitor"
@layout EmployeeLayout
@using PhotoAevumStudio.Web.Services
@using PhotoAevumStudio.Web.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject IUserService UserService
@inject IEquipmentService EquipmentService
@inject IScheduleService ScheduleService
@inject IConsultationClient ConsultationApi
@inject AuthenticationStateProvider AuthStateProvider
@inject PaymentHubClient PaymentHub
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@attribute [Authorize(Roles = "Employee,Office Clerk,Admin,SystemAdmin")]
@rendermode InteractiveServer

<PageTitle>Team Lead Event Monitor | Photo Aevum Studio</PageTitle>

<header class="aev-page-header">
    <div>
        <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-teal-100 text-teal-800">
                <span class="w-2 h-2 rounded-full bg-teal-600 animate-pulse"></span>
                Team Leader Event Monitor
            </span>
            @if (!string.IsNullOrWhiteSpace(_employeeName))
            {
                <span class="text-xs font-semibold text-slate-500">&bull; @_employeeName (@_employeeId)</span>
            }
        </div>
        <h1 class="aev-page-header__title">My Upcoming &amp; Ongoing Event Monitor</h1>
        <p class="aev-page-header__subtitle">
            Dedicated monitor showing only your upcoming and ongoing Team Lead schedule and live event execution process.
        </p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
        <a href="/staff/calendar/master" class="px-3.5 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700">
            My Calendar &rarr;
        </a>
        <button type="button"
                @onclick="RefreshMonitorAsync"
                disabled="@_loading"
                class="px-3.5 py-2 rounded-lg bg-slate-900 hover:bg-black text-white text-xs font-bold shadow-xs disabled:opacity-50">
            @(_loading ? "Refreshing..." : "🔄 Refresh Monitor")
        </button>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(_actionMessage))
{
    <div class="mb-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-semibold flex items-center justify-between gap-3">
        <span>✓ @_actionMessage</span>
        <button type="button" @onclick="() => _actionMessage = null" class="text-emerald-700 font-bold">✕</button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="mb-4 px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center justify-between gap-3">
        <span>⚠ @_errorMessage</span>
        <button type="button" @onclick="() => _errorMessage = null" class="text-rose-700 font-bold">✕</button>
    </div>
}

@* ── TOP PILL-BOX CONTAINER FOR STARTED / ACTIVE EVENT ──────────────────── *@
<TeamLeaderActiveEventPill ActiveEvents="@_events"
                           RecentlyCompletedEvent="@_recentlyCompletedEvent"
                           EmployeeId="@_employeeId"
                           EmployeeName="@_employeeName"
                           @bind-SelectedEventId="_selectedActiveEventId"
                           StudioEquipments="@_studioEquipments"
                           StaffBookings="@_staffBookings"
                           StaffEquipmentReservations="@_staffEquipmentReservations"
                           OnDismissCompleted="HandleDismissCompletedAsync"
                           OnWorkflowUpdated="HandlePillWorkflowUpdatedAsync" />

@if (_loading && !_events.Any())
{
    <div class="bg-white rounded-xl border border-slate-200 p-10 text-center text-xs text-slate-500">
        Loading your upcoming and ongoing Team Lead schedule...
    </div>
}
else if (!_events.Any())
{
    <section class="bg-white rounded-xl border border-slate-200 p-10 text-center shadow-xs">
        <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-xl">
            📋
        </div>
        <h2 class="text-base font-extrabold text-slate-900">No Upcoming or Ongoing Team Lead Events</h2>
        <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
            Once a customer settles the reservation fee for an event where you are designated as Team Leader, your upcoming schedule and event process controls will appear here automatically.
        </p>
        <div class="mt-5 flex items-center justify-center gap-3">
            <a href="/staff" class="px-4 py-2 rounded-lg bg-slate-900 text-white text-xs font-bold hover:bg-black">
                Back to Staff Dashboard
            </a>
            <a href="/staff/calendar/master" class="px-4 py-2 rounded-lg border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-50">
                View My Calendar
            </a>
        </div>
    </section>
}
else
{
    var ongoingCount = _events.Count(e => TeamLeaderMonitorSelector.IsOngoingOrInProcess(e));
    var upcomingCount = _events.Count(e => !TeamLeaderMonitorSelector.IsOngoingOrInProcess(e));
    var displayed = _filter switch
    {
        "Ongoing" => _events.Where(e => TeamLeaderMonitorSelector.IsOngoingOrInProcess(e)).ToList(),
        "Upcoming" => _events.Where(e => !TeamLeaderMonitorSelector.IsOngoingOrInProcess(e)).ToList(),
        _ => _events
    };

    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    @onclick='() => _filter = "All"'
                    class="px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all @(_filter == "All" ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                All My Schedule (@_events.Count)
            </button>
            <button type="button"
                    @onclick='() => _filter = "Ongoing"'
                    class="px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all @(_filter == "Ongoing" ? "bg-teal-700 text-white border-teal-700" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                Ongoing / In Process (@ongoingCount)
            </button>
            <button type="button"
                    @onclick='() => _filter = "Upcoming"'
                    class="px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all @(_filter == "Upcoming" ? "bg-sky-700 text-white border-sky-700" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">
                Upcoming (@upcomingCount)
            </button>
        </div>
        <span class="text-[11px] text-slate-400">Auto-refreshes every 30s</span>
    </div>

    @if (!displayed.Any())
    {
        <div class="bg-white rounded-xl border border-dashed border-slate-200 p-8 text-center text-xs text-slate-500">
            No @_filter.ToLowerInvariant() events in your Team Lead schedule right now.
        </div>
    }
    else
    {
        var focusedPillEventId = _selectedActiveEventId
            ?? _recentlyCompletedEvent?.EventAppointmentId
            ?? _events.FirstOrDefault()?.EventAppointmentId;

        <div class="space-y-3" aria-label="Scheduled upcoming and ongoing events">
            @foreach (var tlEv in displayed)
            {
                var isInProcess = TeamLeaderMonitorSelector.IsOngoingOrInProcess(tlEv);
                var tlEndTime = tlEv.EventEndTime.HasValue && tlEv.EventEndTime.Value > tlEv.EventTime
                    ? tlEv.EventEndTime.Value
                    : tlEv.EventTime.AddMinutes(Math.Max(60, tlEv.DurationMinutes));
                var isPrePrep = !isInProcess;
                var isCurrentlyFocused = string.Equals(focusedPillEventId, tlEv.EventAppointmentId, StringComparison.OrdinalIgnoreCase);

                <article class="bg-white rounded-xl border @(isCurrentlyFocused ? "border-teal-400 ring-1 ring-teal-300" : isInProcess ? "border-teal-200" : "border-slate-200") p-5 shadow-xs">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                        <div class="space-y-1.5">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded text-[10px] font-extrabold uppercase @(isInProcess ? "bg-teal-700 text-white" : "bg-sky-100 text-sky-800 border border-sky-200")">
                                    @(isInProcess ? tlEv.EventStatus : "Upcoming")
                                </span>
                                @if (tlEv.IsTeamLeader)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-50 text-teal-800 border border-teal-200">
                                        ★ Team Leader
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                                        Crew (View Only)
                                    </span>
                                }
                                <span class="font-mono text-[11px] font-bold px-2 py-0.5 rounded bg-slate-900 text-white">#@tlEv.EventAppointmentId</span>
                                <h2 class="text-base font-extrabold text-slate-900">@tlEv.EventName</h2>
                            </div>
                            <div class="text-xs text-slate-600 flex flex-wrap gap-x-4 gap-y-1">
                                <span>Client: <strong class="text-slate-900">@tlEv.CustomerName</strong> @(!string.IsNullOrWhiteSpace(tlEv.CustomerEmail) ? $"({tlEv.CustomerEmail})" : "")</span>
                                @if (!string.IsNullOrWhiteSpace(tlEv.CustomerPhone))
                                {
                                    <span>Phone: <strong class="font-mono">@tlEv.CustomerPhone</strong></span>
                                }
                                <span>Schedule: <strong>@tlEv.EventDate.ToString("MMM dd, yyyy")</strong> &bull; @DateTime.Today.Add(tlEv.EventTime.ToTimeSpan()).ToString("h:mm tt") – @DateTime.Today.Add(tlEndTime.ToTimeSpan()).ToString("h:mm tt")</span>
                                <span>Location: <strong class="text-slate-900">@(!string.IsNullOrWhiteSpace(tlEv.EventLocation) ? tlEv.EventLocation : "Studio A (Main Hall)")</strong></span>
                                <span>Final Balance Due: <strong class="font-mono text-slate-900">₱@tlEv.FinalBalanceAmount.ToString("N2")</strong></span>
                            </div>
                            @if (tlEv.SelectedServices.Any())
                            {
                                <div class="text-[11px] text-slate-500 flex flex-wrap gap-1.5 items-center pt-0.5">
                                    <span>Services:</span>
                                    @foreach (var svc in tlEv.SelectedServices)
                                    {
                                        <span class="px-2 py-0.5 rounded-full bg-teal-50 border border-teal-200 text-teal-800 font-semibold">
                                            @svc.ServiceName @(svc.Quantity > 1 ? $"×{svc.Quantity}" : "")
                                        </span>
                                    }
                                </div>
                            }
                            @if (tlEv.AssignedEmployees.Any())
                            {
                                <div class="text-[11px] text-slate-500 flex flex-wrap gap-1.5 items-center pt-0.5">
                                    <span>Crew:</span>
                                    @foreach (var crew in tlEv.AssignedEmployees)
                                    {
                                        <span class="px-2 py-0.5 rounded bg-slate-50 border border-slate-200 text-slate-700 font-medium">
                                            @crew.EmployeeName @(crew.IsTeamLeader ? "★ Lead" : "")
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            @if (tlEv.IsTeamLeader && isPrePrep)
                            {
                                <button type="button"
                                        disabled="@_isUpdating"
                                        @onclick="() => StartEventPreparationAsync(tlEv)"
                                        class="px-4 py-2 rounded-full bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-xs font-extrabold shadow-sm transition-all">
                                    ▶ Start Event
                                </button>
                            }
                            @if (isCurrentlyFocused)
                            {
                                <span class="px-3.5 py-1.5 rounded-full bg-teal-50 border border-teal-300 text-teal-900 text-xs font-bold">
                                    Active in Monitor ↑
                                </span>
                            }
                            else
                            {
                                <button type="button"
                                        @onclick="() => FocusEventInPill(tlEv.EventAppointmentId)"
                                        class="px-3.5 py-1.5 rounded-full border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 text-xs font-bold transition-all">
                                    Switch to Event ↑
                                </button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
}

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }

    private string _employeeId = string.Empty;
    private string _employeeName = string.Empty;
    private List<TeamLeaderEventDto> _events = new();
    private TeamLeaderEventDto? _recentlyCompletedEvent;
    private string? _selectedActiveEventId;
    private List<EquipmentItemModel> _studioEquipments = new();
    private List<EventBookingModel> _staffBookings = new();
    private List<EquipmentReservationModel> _staffEquipmentReservations = new();
    private string _filter = "All";
    private bool _loading = true;
    private bool _isUpdating = false;
    private string? _actionMessage;
    private string? _errorMessage;
    private readonly HashSet<string> _subscribedHubRefs = new(StringComparer.OrdinalIgnoreCase);
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        ClaimsPrincipal? user = null;
        if (AuthState != null)
        {
            var state = await AuthState;
            user = state.User;
        }
        else
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            user = state.User;
        }

        _employeeId = EmployeeRoleHelper.GetCurrentEmployeeId(user);
        _employeeName = EmployeeRoleHelper.GetCurrentEmployeeName(user, UserService);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        EquipmentService.OnChange += HandleEquipmentStateChanged;
        PaymentHub.OnEventStatusChanged += HandleHubEventStatusChangedAsync;
        await Task.WhenAll(LoadStudioEquipmentsAsync(), RefreshMonitorAsync());
        await SubscribeLiveMonitorAndQrHubsAsync();
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                await RefreshMonitorAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        StateHasChanged();
    }

    private async Task LoadStudioEquipmentsAsync()
    {
        try
        {
            var list = await EquipmentService.GetEquipmentsAsync();
            _studioEquipments = list
                .Where(e => !string.Equals(e.EquipmentStatus, "Maintenance", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(e.EquipmentStatus, "Retired", StringComparison.OrdinalIgnoreCase))
                .ToList();

            var (bookings, reservations) = await Task.Run(() =>
                (ScheduleService.GetEventBookings(), ScheduleService.GetEquipmentReservations()));
            _staffBookings = bookings;
            _staffEquipmentReservations = reservations;
        }
        catch
        {
        }
    }

    private async Task RefreshMonitorAsync()
    {
        _loading = true;
        try
        {
            var previousEvents = _events.ToList();
            var res = await ConsultationApi.GetTeamLeaderEventsAsync(_employeeId);
            if (res.IsSuccess && res.Value != null)
            {
                _errorMessage = null;
                _events = TeamLeaderMonitorSelector.SelectUpcomingAndOngoing(res.Value).ToList();

                // If an active event that was waiting for QR or Cash verification just transitioned out (Completed/Success),
                // keep a snapshot in _recentlyCompletedEvent so the top pill box shows Success automatically.
                var finished = previousEvents.FirstOrDefault(prev =>
                    TeamLeaderMonitorSelector.IsOngoingOrInProcess(prev) &&
                    !_events.Any(cur => string.Equals(cur.EventAppointmentId, prev.EventAppointmentId, StringComparison.OrdinalIgnoreCase)));
                if (finished != null)
                {
                    var latestRes = await ConsultationApi.GetAppointmentByIdAsync(finished.EventAppointmentId);
                    if (latestRes.IsSuccess && latestRes.Value != null && TeamLeaderMonitorSelector.IsCompletedOrInactive(latestRes.Value))
                    {
                        var d = latestRes.Value;
                        _recentlyCompletedEvent = new TeamLeaderEventDto
                        {
                            EventAppointmentId = d.EventAppointmentId,
                            CustomerId = d.CustomerId,
                            CustomerName = d.CustomerName,
                            CustomerEmail = d.CustomerEmail,
                            CustomerPhone = finished.CustomerPhone,
                            EventName = d.EventName,
                            EventDescription = d.EventDescription,
                            EventDate = d.EventDate,
                            EventTime = d.EventTime,
                            EventEndTime = d.EventEndTime,
                            DurationMinutes = d.DurationMinutes,
                            EventLocation = d.EventLocation,
                            EventStatus = d.EventStatus,
                            TotalAmount = d.TotalAmount,
                            DownpaymentAmount = d.DownpaymentAmount,
                            FinalBalanceAmount = d.FinalBalanceAmount,
                            DownpaymentStatus = d.DownpaymentStatus,
                            FinalPaymentMethod = d.FinalPaymentMethod,
                            FinalPaymentStatus = d.FinalPaymentStatus,
                            FinalPaymentReferenceId = d.FinalPaymentReferenceId,
                            FinalPaymentPaidAt = d.FinalPaymentPaidAt,
                            AssignedEmployees = d.AssignedEmployees,
                            AssignedEquipment = d.AssignedEquipment,
                            SelectedServices = d.SelectedServices,
                            IsTeamLeader = finished.IsTeamLeader
                        };
                        _selectedActiveEventId = d.EventAppointmentId;
                    }
                }
            }
            else if (!res.IsSuccess)
            {
                _errorMessage = res.Error?.Message ?? "Unable to load Team Leader events.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StartEventPreparationAsync(TeamLeaderEventDto tlEv)
    {
        if (!tlEv.IsTeamLeader) return;
        _isUpdating = true;
        _actionMessage = null;
        _errorMessage = null;
        try
        {
            var res = await ConsultationApi.UpdateTeamLeaderEventStatusAsync(tlEv.EventAppointmentId, new UpdateTeamLeaderStatusRequest
            {
                Status = "Preparation",
                EmployeeId = _employeeId
            });
            if (res.IsSuccess && res.Value != null)
            {
                _selectedActiveEventId = tlEv.EventAppointmentId;
                ScheduleService.InvalidateCache();
                await Task.WhenAll(LoadStudioEquipmentsAsync(), RefreshMonitorAsync());
                _actionMessage = $"Event #{tlEv.EventAppointmentId} started! Preparation & Equipment Dispatch opened at top.";
            }
            else
            {
                _errorMessage = res.Error?.Message ?? "Failed to start event preparation.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private void FocusEventInPill(string appointmentId)
    {
        _selectedActiveEventId = appointmentId;
        _actionMessage = $"Focused Event #{appointmentId} in the top pill box.";
    }

    private async Task HandlePillWorkflowUpdatedAsync()
    {
        await Task.WhenAll(LoadStudioEquipmentsAsync(), RefreshMonitorAsync());
        await SubscribeLiveMonitorAndQrHubsAsync();
    }

    private Task HandleDismissCompletedAsync(string id)
    {
        if (_recentlyCompletedEvent != null &&
            string.Equals(_recentlyCompletedEvent.EventAppointmentId, id, StringComparison.OrdinalIgnoreCase))
        {
            _recentlyCompletedEvent = null;
        }
        if (string.Equals(_selectedActiveEventId, id, StringComparison.OrdinalIgnoreCase))
        {
            _selectedActiveEventId = null;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleHubEventStatusChangedAsync(EventStatusChangedMessage msg) => InvokeAsync(async () =>
    {
        ScheduleService.InvalidateCache();
        await Task.WhenAll(LoadStudioEquipmentsAsync(), RefreshMonitorAsync());
        await SubscribeLiveMonitorAndQrHubsAsync();
        if (string.Equals(msg.EventStatus, "Completed", StringComparison.OrdinalIgnoreCase))
        {
            _actionMessage = $"Event #{msg.AppointmentId} updated to Success / Completed across all platforms.";
        }
        else if (string.Equals(msg.EventStatus, "RosterUpdated", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(msg.EventStatus, "Updated", StringComparison.OrdinalIgnoreCase))
        {
            _actionMessage = $"Event #{msg.AppointmentId} crew / Team Leader roster has been updated.";
        }
        StateHasChanged();
    });

    private async Task SubscribeLiveMonitorAndQrHubsAsync()
    {
        try
        {
            await PaymentHub.EnsureLiveMonitorStartedAsync();
            if (!string.IsNullOrWhiteSpace(_employeeId))
            {
                await PaymentHub.EnsureStaffMonitorStartedAsync(_employeeId);
            }
        }
        catch
        {
        }

        foreach (var ev in _events)
        {
            var refId = ev.FinalPaymentReferenceId;
            if (string.IsNullOrWhiteSpace(refId) || _subscribedHubRefs.Contains(refId))
                continue;

            _subscribedHubRefs.Add(refId);
            try
            {
                await PaymentHub.JoinBookingGroupAsync(refId);
            }
            catch
            {
            }
        }
    }

    private void HandleEquipmentStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            ScheduleService.InvalidateCache();
            await Task.WhenAll(LoadStudioEquipmentsAsync(), RefreshMonitorAsync());
            StateHasChanged();
        });
    }

    public ValueTask DisposeAsync()
    {
        EquipmentService.OnChange -= HandleEquipmentStateChanged;
        PaymentHub.OnEventStatusChanged -= HandleHubEventStatusChangedAsync;
        _refreshTimer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
