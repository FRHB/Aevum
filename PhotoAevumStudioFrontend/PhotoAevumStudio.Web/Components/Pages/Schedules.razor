@page "/Dashboard/Schedules"
@rendermode InteractiveServer

<div class="flex min-h-screen bg-gray-50 font-sans text-neutral-900">
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 text-white flex-col hidden md:flex flex-shrink-0">
        <div class="p-6 border-b border-slate-800">
            <h2 class="text-2xl font-bold text-white tracking-tight">PhotoAevum</h2>
            <p class="text-slate-400 text-sm mt-1">Studio Management</p>
        </div>
        <nav class="flex-1 px-4 py-6 space-y-2">
            <a href="/Dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition-all">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                <span class="font-medium">Dashboard</span>
            </a>
            <a href="/Dashboard/Services" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition-all">
                <i data-lucide="layers" class="w-5 h-5"></i>
                <span class="font-medium">Services</span>
            </a>
            <a href="/Dashboard/Equipment" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition-all">
                <i data-lucide="package" class="w-5 h-5"></i>
                <span class="font-medium">Equipment</span>
            </a>
            <a href="/Dashboard/Schedules" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-teal-500/10 text-teal-400 transition-all">
                <i data-lucide="calendar" class="w-5 h-5"></i>
                <span class="font-medium">Schedules</span>
            </a>
            <a href="/Dashboard/Employees" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:bg-slate-800 hover:text-white transition-all">
                <i data-lucide="users" class="w-5 h-5"></i>
                <span class="font-medium">Employees</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col w-full overflow-hidden">
        <header class="bg-white border-b border-gray-200 px-8 py-5 flex items-center justify-between">
            <h1 class="text-2xl font-bold text-neutral-900">Booking Schedules</h1>
            <div class="flex items-center gap-4">
                <button class="p-2 text-gray-400 hover:text-neutral-900 rounded-full hover:bg-gray-100 transition-colors">
                    <i data-lucide="bell" class="w-5 h-5"></i>
                </button>
                <div class="w-10 h-10 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold border-2 border-white shadow-sm">
                    AD
                </div>
            </div>
        </header>

        <div class="p-8 overflow-y-auto flex-1">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div class="relative w-full md:w-96">
                    <i data-lucide="search" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="text" placeholder="Search bookings..." class="w-full pl-10 pr-4 py-2.5 bg-white border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 transition-shadow">
                </div>
                <div class="flex gap-3">
                    <button class="px-4 py-2.5 bg-white border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors flex items-center gap-2">
                        <i data-lucide="calendar-days" class="w-4 h-4"></i> Month View
                    </button>
                    <button class="px-4 py-2.5 bg-teal-600 text-white rounded-lg font-medium hover:bg-teal-700 shadow-sm transition-colors flex items-center gap-2">
                        <i data-lucide="plus" class="w-4 h-4"></i> New Booking
                    </button>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase tracking-wider text-gray-500 font-semibold">
                                <th class="px-6 py-4">Booking ID</th>
                                <th class="px-6 py-4">Client Name</th>
                                <th class="px-6 py-4">Session Title</th>
                                <th class="px-6 py-4">Date & Time</th>
                                <th class="px-6 py-4 text-center">Status</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 text-sm">
                            @foreach (var schedule in SchedulesList)
                            {
                                <tr class="hover:bg-gray-50 transition-colors group">
                                    <td class="px-6 py-4 text-gray-500">#@schedule.Id</td>
                                    <td class="px-6 py-4 font-medium text-neutral-900 flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 text-xs font-bold">
                                            @schedule.ClientName.Substring(0, 1)
                                        </div>
                                        @schedule.ClientName
                                    </td>
                                    <td class="px-6 py-4 text-gray-600">@schedule.Title</td>
                                    <td class="px-6 py-4 text-gray-600">
                                        <div class="flex flex-col">
                                            <span class="font-medium text-neutral-900">@schedule.StartTime.ToString("MMM dd, yyyy")</span>
                                            <span class="text-xs">@schedule.StartTime.ToString("hh:mm tt")</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            Upcoming
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                            <button class="p-1.5 text-gray-400 hover:text-teal-600 hover:bg-teal-50 rounded transition-colors" title="Edit">
                                                <i data-lucide="edit-2" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    // Inline mock data based on ScheduleViewModel
    private List<ScheduleItem> SchedulesList = new()
    {
        new ScheduleItem { Id = 5021, ClientName = "Sarah Jenkins", Title = "Express Headshot Session", StartTime = DateTime.Today.AddHours(14) },
        new ScheduleItem { Id = 5022, ClientName = "Michael Chen", Title = "Studio Lighting Combo", StartTime = DateTime.Today.AddDays(1).AddHours(10) },
        new ScheduleItem { Id = 5023, ClientName = "Emma Watson", Title = "Deep Tissue Massage", StartTime = DateTime.Today.AddDays(3).AddHours(16).AddMinutes(30) }
    };

    public class ScheduleItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public DateTime StartTime { get; set; }
    }
}