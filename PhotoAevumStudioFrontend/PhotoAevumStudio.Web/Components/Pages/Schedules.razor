@page "/admin/schedules"
@layout AdminLayout
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@inject IUserService UserService
@inject IScheduleService ScheduleService
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Schedules - PhotoAevum</PageTitle>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div class="relative w-full md:w-96">
        <i data-lucide="search" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        <input type="text"
               value="@_searchQuery"
               @oninput="OnSearchInput"
               placeholder="Search bookings..."
               class="w-full pl-10 pr-4 py-2.5 bg-white border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 transition-shadow">
    </div>
    <div class="flex gap-3">
        <button class="px-4 py-2.5 bg-white border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-colors flex items-center gap-2">
            <i data-lucide="calendar-days" class="w-4 h-4"></i> Month View
        </button>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200 text-xs uppercase tracking-wider text-gray-500 font-semibold">
                    <th class="px-6 py-4">Booking ID</th>
                    <th class="px-6 py-4">Client Name</th>
                    <th class="px-6 py-4">Session Title</th>
                    <th class="px-6 py-4">Date &amp; Time</th>
                    <th class="px-6 py-4 text-center">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm">
                @if (!FilteredSchedules.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                            @(SchedulesList.Count == 0 ? "No scheduled bookings found in the database." : "No bookings matched your search query.")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var schedule in PagedSchedules)
                    {
                        <tr @onclick="() => OpenBookingOverview(schedule)" class="hover:bg-gray-50 transition-colors group cursor-pointer">
                            <td class="px-6 py-4 text-gray-500">#@schedule.BookingId</td>
                            <td class="px-6 py-4 font-medium text-neutral-900 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 text-xs font-bold">
                                    @(string.IsNullOrWhiteSpace(schedule.ClientName) ? "?" : schedule.ClientName.Substring(0, 1))
                                </div>
                                @schedule.ClientName
                            </td>
                            <td class="px-6 py-4 text-gray-600">@schedule.ServiceTitle</td>
                            <td class="px-6 py-4 text-gray-600">
                                <div class="flex flex-col">
                                    <span class="font-medium text-neutral-900">@schedule.EventDateTime.ToString("MMM dd, yyyy")</span>
                                    <span class="text-xs">@schedule.EventDateTime.ToString("hh:mm tt")</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                    @schedule.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right" @onclick:stopPropagation="true">
                                <button type="button"
                                        @onclick="() => OpenBookingOverview(schedule)"
                                        class="text-gray-500 hover:text-teal-700 transition-colors px-2.5 py-1 rounded border border-gray-200 hover:border-teal-300 text-xs font-semibold">
                                    Overview &amp; Roster
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <TablePagination TotalItems="@FilteredSchedules.Count"
                     PageSize="10"
                     @bind-CurrentPage="_currentPage"
                     ItemLabel="bookings" />
</div>

<BookedEventOverviewModal Booking="_selectedBooking"
                          CanManageRoster="true"
                          AllBookings="_allBookings"
                          EquipmentReservations="_equipmentReservations"
                          OnClose="CloseBookingOverview"
                          OnRosterUpdated="HandleRosterUpdatedAsync" />

@code {
    private List<BookingRow> SchedulesList = new();
    private List<EventBookingModel> _allBookings = new();
    private List<EquipmentReservationModel> _equipmentReservations = new();
    private EventBookingModel? _selectedBooking;
    private string _searchQuery = string.Empty;
    private int _currentPage = 1;

    private List<BookingRow> FilteredSchedules => SchedulesList
        .Where(s => string.IsNullOrWhiteSpace(_searchQuery) ||
                    s.BookingId.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    (s.ClientName?.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (s.ServiceTitle?.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (s.Status?.Contains(_searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    private List<BookingRow> PagedSchedules => TablePagination.Paginate(FilteredSchedules, _currentPage);

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    protected override void OnInitialized()
    {
        SchedulesList = UserService.GetBookings();
        LoadScheduleContext();
    }

    private void LoadScheduleContext()
    {
        try
        {
            _allBookings = ScheduleService.GetEventBookings();
            _equipmentReservations = ScheduleService.GetEquipmentReservations();
        }
        catch
        {
            _allBookings = new();
            _equipmentReservations = new();
        }
    }

    private void OpenBookingOverview(BookingRow schedule)
    {
        var matched = _allBookings.FirstOrDefault(b =>
            string.Equals(b.Id, schedule.BookingId, StringComparison.OrdinalIgnoreCase));

        _selectedBooking = matched ?? new EventBookingModel
        {
            Id = schedule.BookingId,
            ClientName = schedule.ClientName,
            ServiceType = schedule.ServiceTitle,
            AssignedServices = string.IsNullOrWhiteSpace(schedule.ServiceTitle) ? new() : new() { schedule.ServiceTitle },
            Date = schedule.EventDate.Date,
            StartTime = schedule.EventTime,
            EndTime = schedule.EventTime.Add(TimeSpan.FromHours(1)),
            Status = schedule.Status,
            EstimatedPrice = schedule.TotalPrice,
            Notes = schedule.EventDescription,
            EventLocation = "Studio A (Main Hall)",
            AssignedPhotographer = "Unassigned"
        };
    }

    private void CloseBookingOverview()
    {
        _selectedBooking = null;
    }

    private Task HandleRosterUpdatedAsync()
    {
        var activeId = _selectedBooking?.Id;
        ScheduleService.InvalidateCache();
        SchedulesList = UserService.GetBookings();
        LoadScheduleContext();
        if (!string.IsNullOrWhiteSpace(activeId))
        {
            _selectedBooking = _allBookings.FirstOrDefault(b =>
                string.Equals(b.Id, activeId, StringComparison.OrdinalIgnoreCase)) ?? _selectedBooking;
        }
        return Task.CompletedTask;
    }
}
