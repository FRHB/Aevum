@using System.ComponentModel.DataAnnotations
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@attribute [Authorize(Roles = "SystemAdmin,System Admin,Super Admin,Admin")]
@inject IAdminService AdminService
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (IsOpen)
{
    <div class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 flex items-center justify-center p-4"
         role="dialog" aria-modal="true" aria-labelledby="admin-wizard-title">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]">
            
            <!-- Header -->
            <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div>
                    <h2 id="admin-wizard-title" class="text-xl font-bold text-slate-900 tracking-tight">Add Administrator</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Photo Aevum Studio &bull; Access &amp; Role Provisioning</p>
                </div>
                <button type="button" 
                        class="text-slate-400 hover:text-slate-700 p-1.5 rounded-lg hover:bg-slate-100 transition-colors"
                        aria-label="Close"
                        @onclick="CloseModal" 
                        disabled="@isSaving">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Stepper Progress Bar -->
            <div class="px-6 pt-5 pb-2 bg-white">
                <nav aria-label="Progress" class="flex items-center justify-between">
                    
                    <!-- Step 1: Input -->
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                            @(currentStep >= 1 ? "bg-slate-900 text-white shadow-sm ring-4 ring-slate-100" : "bg-slate-100 text-slate-400")">
                            @(currentStep > 1 ? "✓" : "1")
                        </span>
                        <span class="text-xs font-medium @(currentStep == 1 ? "text-slate-900 font-bold" : "text-slate-500")">
                            Admin Details
                        </span>
                    </div>

                    <div class="flex-1 h-0.5 mx-3 @(currentStep > 1 ? "bg-slate-900" : "bg-slate-200") transition-colors"></div>

                    <!-- Step 2: Auto-Provisioning (Skipped/Backend logic) -->
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                            @(currentStep > 1 ? "bg-emerald-600 text-white shadow-sm" : "bg-slate-100 text-slate-400")"
                            title="Auto-generated by backend policy">
                            @(currentStep > 1 ? "✓" : "2")
                        </span>
                        <div class="flex flex-col">
                            <span class="text-xs font-medium text-slate-400 line-through">
                                Backend Logic
                            </span>
                            <span class="text-[10px] text-emerald-600 font-semibold uppercase tracking-wider">
                                Auto-Skipped
                            </span>
                        </div>
                    </div>

                    <div class="flex-1 h-0.5 mx-3 @(currentStep >= 3 ? "bg-slate-900" : "bg-slate-200") transition-colors"></div>

                    <!-- Step 3: Overview & Confirmation -->
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                            @(currentStep >= 3 ? (currentStep > 3 ? "bg-emerald-600 text-white shadow-sm" : "bg-slate-900 text-white shadow-sm ring-4 ring-slate-100") : "bg-slate-100 text-slate-400")">
                            @(currentStep > 3 ? "✓" : "3")
                        </span>
                        <span class="text-xs font-medium @(currentStep == 3 ? "text-slate-900 font-bold" : "text-slate-500")">
                            Overview &amp; Credentials
                        </span>
                    </div>

                    <div class="flex-1 h-0.5 mx-3 @(currentStep == 4 ? "bg-slate-900" : "bg-slate-200") transition-colors"></div>

                    <!-- Step 4: Completion -->
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold transition-all
                            @(currentStep == 4 ? "bg-emerald-600 text-white shadow-sm ring-4 ring-emerald-100" : "bg-slate-100 text-slate-400")">
                            @(currentStep == 4 ? "✓" : "4")
                        </span>
                        <span class="text-xs font-medium @(currentStep == 4 ? "text-emerald-700 font-bold" : "text-slate-500")">
                            Completion
                        </span>
                    </div>
                </nav>
            </div>

            <!-- Form Content -->
            <div class="p-6 overflow-y-auto flex-1">
                <EditForm EditContext="_editContext">
                    <DataAnnotationsValidator />

                    @if (currentStep == 1)
                    {
                        <div class="space-y-4">
                            <!-- Role Selection -->
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2">
                                    Administrative Role <span class="text-rose-500">*</span>
                                </label>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <label class="relative flex flex-col p-3 rounded-xl border cursor-pointer transition-all
                                        @(model.Role == "Admin" ? "border-slate-900 bg-slate-50/75 ring-2 ring-slate-900" : "border-slate-200 hover:border-slate-300 bg-white")">
                                        <div class="flex items-center justify-between mb-1">
                                            <span class="text-xs font-bold text-slate-900">Admin</span>
                                            <input type="radio" name="adminRole" value="Admin"
                                                   checked="@(model.Role == "Admin")"
                                                   @onchange="@(() => SetRole("Admin"))"
                                                   class="text-slate-900 focus:ring-slate-900 h-4 w-4" />
                                        </div>
                                        <p class="text-[11px] text-slate-500">Standard studio operations, staff schedules, and equipment management.</p>
                                        <span class="mt-2 inline-flex items-center text-[10px] font-mono font-medium text-slate-600 bg-slate-200/60 px-1.5 py-0.5 rounded w-fit">
                                            ID Format: ADM-###
                                        </span>
                                    </label>

                                    <label class="relative flex flex-col p-3 rounded-xl border cursor-pointer transition-all
                                        @(model.Role == "System Admin" ? "border-slate-900 bg-slate-50/75 ring-2 ring-slate-900" : "border-slate-200 hover:border-slate-300 bg-white")">
                                        <div class="flex items-center justify-between mb-1">
                                            <span class="text-xs font-bold text-slate-900">System Admin</span>
                                            <input type="radio" name="adminRole" value="System Admin"
                                                   checked="@(model.Role == "System Admin")"
                                                   @onchange="@(() => SetRole("System Admin"))"
                                                   class="text-slate-900 focus:ring-slate-900 h-4 w-4" />
                                        </div>
                                        <p class="text-[11px] text-slate-500">Unrestricted system authority, history logs audit, and admin account management.</p>
                                        <span class="mt-2 inline-flex items-center text-[10px] font-mono font-medium text-purple-700 bg-purple-50 px-1.5 py-0.5 rounded w-fit">
                                            ID Format: SADM-###
                                        </span>
                                    </label>
                                </div>
                            </div>

                            <!-- Name Fields -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="adm-first" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        First Name <span class="text-rose-500">*</span>
                                    </label>
                                    <InputText id="adm-first" @bind-Value="model.FirstName" class="@InputClass" placeholder="e.g. John" autocomplete="off" />
                                    <ValidationMessage For="() => model.FirstName" class="text-xs text-rose-600 mt-1" />
                                </div>
                                <div>
                                    <label for="adm-last" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Last Name <span class="text-rose-500">*</span>
                                    </label>
                                    <InputText id="adm-last" @bind-Value="model.LastName" class="@InputClass" placeholder="e.g. Doe" autocomplete="off" />
                                    <ValidationMessage For="() => model.LastName" class="text-xs text-rose-600 mt-1" />
                                </div>
                            </div>

                            <div>
                                <label for="adm-middle" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                    Middle Name <span class="text-slate-400 font-normal lowercase">(optional)</span>
                                </label>
                                <InputText id="adm-middle" @bind-Value="model.MiddleName" class="@InputClass" placeholder="e.g. Alexander" autocomplete="off" />
                                <ValidationMessage For="() => model.MiddleName" class="text-xs text-rose-600 mt-1" />
                            </div>

                            <div>
                                <label for="adm-email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                    Email Address <span class="text-rose-500">*</span>
                                </label>
                                <InputText id="adm-email" type="email" @bind-Value="model.Email" class="@InputClass" placeholder="admin@photoaevum.com" autocomplete="off" />
                                <ValidationMessage For="() => model.Email" class="text-xs text-rose-600 mt-1" />
                                <p class="text-[11px] text-slate-500 mt-1">Credentials and temporary password will be dispatched to this email upon save.</p>
                            </div>
                        </div>
                    }

                    @if (currentStep == 3)
                    {
                        <div class="space-y-5">
                            <!-- Information Banner -->
                            <div class="p-3 bg-blue-50/75 border border-blue-200 rounded-xl flex items-start gap-3">
                                <div class="text-blue-600 mt-0.5">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div>
                                    <p class="text-xs font-semibold text-blue-900">Step 2 Skipped &bull; Auto-Generation Completed</p>
                                    <p class="text-[11px] text-blue-700 mt-0.5">
                                        The system has generated a compliant custom ID and strong temporary password. Review the details below before saving.
                                    </p>
                                </div>
                            </div>

                            <!-- Read-only Overview of Details -->
                            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 divide-y divide-slate-200 text-xs">
                                <div class="pb-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Assigned Role</span>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold @(model.IsSystemAdmin ? "bg-purple-100 text-purple-800" : "bg-slate-200 text-slate-800")">
                                        @model.Role
                                    </span>
                                </div>
                                <div class="py-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Full Name</span>
                                    <span class="text-slate-900 font-semibold text-right">@model.FullName</span>
                                </div>
                                <div class="pt-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Notification Email</span>
                                    <span class="text-slate-900 font-semibold text-right">@model.Email</span>
                                </div>
                            </div>

                            <!-- Auto-Generated Credentials (Strictly Read-Only) -->
                            <div class="space-y-4 pt-1">
                                <div>
                                    <div class="flex items-center justify-between mb-1.5">
                                        <label for="adm-gen-id" class="block text-xs font-semibold uppercase tracking-wider text-slate-700">
                                            System Generated ID <span class="text-slate-400 font-normal lowercase">(Read-only)</span>
                                        </label>
                                        <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                            </svg>
                                            System Assigned
                                        </span>
                                    </div>
                                    <div class="relative">
                                        <input id="adm-gen-id"
                                               type="text" 
                                               value="@model.GeneratedId" 
                                               readonly 
                                               disabled
                                               class="@MonoReadOnlyInputClass" />
                                        <div class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                            </svg>
                                        </div>
                                    </div>
                                    <p class="text-[11px] text-slate-400 mt-1">
                                        This ID is strictly assigned by system sequence rules (@(model.IsSystemAdmin ? "SADM-###" : "ADM-###")) and cannot be modified.
                                    </p>
                                </div>

                                <div>
                                    <label for="adm-gen-pw" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
                                        Temporary Password <span class="text-slate-400 font-normal lowercase">(Read-only)</span>
                                    </label>
                                    <div class="relative">
                                        <input id="adm-gen-pw"
                                               type="@(showPassword ? "text" : "password")" 
                                               value="@model.TemporaryPassword" 
                                               readonly 
                                               class="@PasswordReadOnlyInputClass" />
                                        <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
                                            <button type="button" 
                                                    class="text-xs px-2 py-1 text-slate-600 hover:text-slate-900 font-medium hover:bg-slate-200/60 rounded"
                                                    @onclick="() => showPassword = !showPassword">
                                                @(showPassword ? "Hide" : "Show")
                                            </button>
                                            <button type="button"
                                                    class="text-xs px-2 py-1 text-slate-600 hover:text-slate-900 font-medium hover:bg-slate-200/60 rounded flex items-center gap-1"
                                                    @onclick="CopyPasswordAsync">
                                                <span>@(copiedPassword ? "Copied!" : "Copy")</span>
                                            </button>
                                        </div>
                                    </div>
                                    <p class="text-[11px] text-slate-400 mt-1">
                                        Meets the studio policy (minimum 8 characters with letters, digits, and symbols).
                                    </p>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(saveError))
                            {
                                <div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-xs text-rose-700 font-medium flex items-center gap-2" role="alert">
                                    <svg class="w-4 h-4 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span>@saveError</span>
                                </div>
                            }

                            @if (saveSuccess)
                            {
                                <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-xs text-emerald-800 font-medium flex items-center gap-2" role="status">
                                    <svg class="w-4 h-4 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span>@(successMessage ?? $"Administrator account created! Credentials have been emailed to {model.Email}.")</span>
                                </div>
                            }
                        </div>
                    }

                    @if (currentStep == 4)
                    {
                        <div class="text-center py-6 px-4 space-y-5 animate-in fade-in duration-200">
                            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold shadow-xs">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Administrator Created Successfully!</h3>
                                <p class="text-xs text-slate-500 mt-1">
                                    The administrator record has been saved and is now active in the studio system.
                                </p>
                            </div>

                            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 divide-y divide-slate-200 text-xs text-left max-w-md mx-auto">
                                <div class="pb-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Administrator</span>
                                    <span class="text-slate-900 font-semibold">@model.FullName</span>
                                </div>
                                <div class="py-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Assigned Admin ID</span>
                                    <span class="font-mono font-bold text-slate-900 bg-slate-200/60 px-2 py-0.5 rounded text-[11px]">@model.GeneratedId</span>
                                </div>
                                <div class="py-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Assigned Role</span>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold @(model.IsSystemAdmin ? "bg-purple-100 text-purple-800" : "bg-slate-200 text-slate-800")">
                                        @model.Role
                                    </span>
                                </div>
                                <div class="pt-2.5 flex justify-between items-center">
                                    <span class="text-slate-500 font-medium">Notification Email</span>
                                    <span class="text-slate-900 font-medium">@model.Email</span>
                                </div>
                            </div>

                            <!-- Success Message Banner -->
                            <div class="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-800 text-left max-w-md mx-auto flex items-start gap-3 shadow-xs" role="status">
                                <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                                <div>
                                    <p class="font-bold text-emerald-900">Email Notification Dispatched</p>
                                    <p class="text-[11px] text-emerald-700 mt-0.5">
                                        An automated onboarding email has been sent to <strong>@model.Email</strong> containing their generated Admin ID (<strong>@model.GeneratedId</strong>) and initial temporary password.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                </EditForm>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                @if (currentStep == 1)
                {
                    <button type="button" class="@GhostBtn" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="@PrimaryBtn flex items-center gap-1.5" @onclick="GoToStep3" disabled="@isGeneratingCredentials">
                        @if (isGeneratingCredentials)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                            <span>Auto-Provisioning...</span>
                        }
                        else
                        {
                            <span>Next</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        }
                    </button>
                }
                else if (currentStep == 3)
                {
                    <button type="button" class="@GhostBtn flex items-center gap-1.5" @onclick="() => currentStep = 1" disabled="@isSaving">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                        Back
                    </button>
                    
                    <button type="button" 
                            class="px-6 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold uppercase tracking-wider shadow-sm transition-colors disabled:opacity-50 flex items-center gap-2" 
                            @onclick="SubmitSaveAsync" 
                            disabled="@(isSaving || saveSuccess)">
                        @if (isSaving)
                        {
                            <span class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                            <span>Saving &amp; Sending Email...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                            </svg>
                            <span>Save &amp; Send Credentials</span>
                        }
                    </button>
                }
                else if (currentStep == 4)
                {
                    <div></div>
                    <button type="button" 
                            class="px-6 py-2.5 rounded-lg bg-slate-900 hover:bg-black text-white text-xs font-semibold uppercase tracking-wider shadow-sm transition-colors flex items-center gap-2" 
                            @onclick="CompleteAndCloseAsync">
                        <span>Done</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </button>
                }
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private const string InputClass =
        "w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 " +
        "focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900 transition-colors";
        
    private const string MonoReadOnlyInputClass =
        "w-full rounded-lg border border-slate-200 bg-slate-100/80 px-3.5 py-2.5 text-sm text-slate-900 font-mono " +
        "cursor-not-allowed select-all pr-10";
        
    private const string PasswordReadOnlyInputClass =
        "w-full rounded-lg border border-slate-200 bg-slate-100/80 px-3.5 py-2.5 text-sm text-slate-900 font-mono " +
        "select-all pr-24";
        
    private const string PrimaryBtn =
        "bg-slate-900 hover:bg-black text-white px-6 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm disabled:opacity-50";
        
    private const string GhostBtn =
        "bg-transparent hover:bg-slate-100 text-slate-700 border border-slate-300 px-5 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider transition-colors disabled:opacity-50";

    private AddAdminWizardModel model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;

    private int currentStep = 1;
    private bool isGeneratingCredentials = false;
    private bool isSaving = false;
    private bool saveSuccess = false;
    private string? successMessage;
    private string? saveError;
    private bool showPassword = false;
    private bool copiedPassword = false;

    private CancellationTokenSource? _cts;
    private bool wasOpen = false;

    protected override void OnInitialized()
    {
        InitializeContext();
        _cts = new CancellationTokenSource();
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen)
        {
            InitializeContext();
        }
        wasOpen = IsOpen;
    }

    private void InitializeContext()
    {
        model = new AddAdminWizardModel { Role = "Admin" };
        _editContext = new EditContext(model);
        _messageStore = new ValidationMessageStore(_editContext);
        currentStep = 1;
        saveError = null;
        saveSuccess = false;
        successMessage = null;
        showPassword = false;
        copiedPassword = false;
    }

    private void SetRole(string role)
    {
        model.Role = role;
    }

    private async Task GoToStep3()
    {
        _messageStore.Clear();
        saveError = null;

        // Validate Step 1 input fields
        var isValid = _editContext.Validate();
        if (!isValid) return;

        isGeneratingCredentials = true;
        StateHasChanged();

        try
        {
            // Execute backend auto-generation logic (Skipping Step 2 directly to Step 3)
            var generatedId = await AdminService.GetNextAdminIdAsync(model.Role, _cts?.Token ?? CancellationToken.None);
            model.GeneratedId = generatedId;

            // Generate temporary password
            model.TemporaryPassword = GenerateTemporaryPassword(12);

            // Transition smoothly to Step 3
            currentStep = 3;
        }
        catch (Exception ex)
        {
            saveError = $"Auto-generation failed: {ex.Message}";
        }
        finally
        {
            isGeneratingCredentials = false;
        }
    }

    private async Task SubmitSaveAsync()
    {
        saveError = null;
        isSaving = true;
        StateHasChanged();

        try
        {
            var result = await AdminService.CreateAdminAsync(model, _cts?.Token ?? CancellationToken.None);
            if (result.Success)
            {
                isSaving = false;
                saveSuccess = true;
                currentStep = 4;
                successMessage = $"Administrator account created! Credentials have been emailed to {model.Email}.";
                StateHasChanged();
            }
            else
            {
                saveError = result.ErrorMessage ?? "Failed to save administrator account.";
                isSaving = false;
            }
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
            isSaving = false;
        }
    }

    private async Task CompleteAndCloseAsync()
    {
        await OnSaved.InvokeAsync();
        InitializeContext();
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task CopyPasswordAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", model.TemporaryPassword);
            copiedPassword = true;
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(2500);
                    copiedPassword = false;
                    await InvokeAsync(StateHasChanged);
                }
                catch { }
            });
        }
        catch
        {
            // Fallback or ignore
        }
    }

    private async Task CloseModal()
    {
        if (isSaving) return;
        if (currentStep == 4)
        {
            await CompleteAndCloseAsync();
            return;
        }
        InitializeContext();
        await IsOpenChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }

    private static string GenerateTemporaryPassword(int length = 12)
    {
        const string validChars = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNOPQRSTUVWXYZ23456789!@#$%^&*";
        var res = new char[length];
        var bytes = System.Security.Cryptography.RandomNumberGenerator.GetBytes(length);
        for (int i = 0; i < length; i++)
        {
            res[i] = validChars[bytes[i] % validChars.Length];
        }
        return new string(res);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
