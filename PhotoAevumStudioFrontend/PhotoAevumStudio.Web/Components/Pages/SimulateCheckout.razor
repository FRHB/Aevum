@page "/checkout/simulate/{AppointmentId}"
@page "/checkout/mock/{AppointmentId}"
@page "/checkout/{AppointmentId}"
@layout MainLayout
@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@using QRCoder
@using ZXingBlazor.Components
@inject IConsultationClient ConsultationApi
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@inject NavigationManager Nav
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Payment Checkout - Photo Aevum Studio</PageTitle>

<div class="min-h-screen bg-slate-50 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <!-- Top Branding & Security Badge -->
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200">
            <div class="flex items-center gap-3">
                <img src="images/AevumLogo.jpg" alt="Photo Aevum Studio" class="h-10 w-10 rounded-full shadow-sm" />
                <div>
                    <h1 class="text-lg font-bold text-slate-900 tracking-tight">Photo Aevum Studio</h1>
                    <p class="text-xs text-slate-500 font-medium">Official Checkout Portal • QR Online Payment Simulation</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>BSP QR Ph Verified • 256-Bit SSL</span>
            </div>
        </div>

        @if (_loading)
        {
            <div class="bg-white rounded-2xl p-12 border border-slate-200 shadow-sm text-center">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-teal-600 border-t-transparent mb-4"></div>
                <h2 class="text-base font-bold text-slate-800">Retrieving Checkout Session…</h2>
                <p class="text-xs text-slate-500 mt-1">Connecting to Photo Aevum Studio payment gateway for #@AppointmentId</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="bg-white rounded-2xl p-8 border border-red-200 shadow-sm">
                <div class="flex items-center gap-3 text-red-600 mb-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <h2 class="text-lg font-bold">Checkout Unavailable</h2>
                </div>
                <p class="text-sm text-slate-600 mb-6">@_errorMessage</p>
                <div class="flex gap-3">
                    <button type="button" @onclick="LoadAppointmentAsync" class="px-4 py-2 bg-slate-900 text-white rounded-lg text-xs font-bold hover:bg-slate-800">
                        Try Again
                    </button>
                    <a href="/my" class="px-4 py-2 bg-slate-100 text-slate-700 rounded-lg text-xs font-bold hover:bg-slate-200">
                        Go to Customer Dashboard
                    </a>
                </div>
            </div>
        }
        else if (_bookingState == "Deal_Won")
        {
            <!-- DYNAMIC STATUS 1: DEAL WON (PAYMENT CONFIRMED) -->
            <div class="bg-white rounded-2xl p-8 sm:p-10 border border-emerald-200 shadow-sm text-center animate-fade-in">
                <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-5 shadow-inner">
                    <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <div class="flex items-center justify-center gap-2 mb-2">
                    <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-800 font-bold text-xs rounded-full uppercase tracking-wider">
                        Status: Deal Won
                    </span>
                    <span class="inline-block px-3 py-1 bg-teal-100 text-teal-800 font-bold text-xs rounded-full uppercase tracking-wider">
                        15% Deposit Verified
                    </span>
                </div>
                <h2 class="text-2xl font-black text-slate-900 mb-2">Deal Won! Reservation Confirmed</h2>
                <p class="text-sm text-slate-600 max-w-lg mx-auto mb-6">
                    Thank you! We have verified your simulated QR Online Payment of
                    <strong class="text-emerald-700">₱@(_appointment?.DownpaymentAmount.ToString("N2"))</strong> for
                    <strong>@(_appointment?.EventName)</strong>. Your assigned creative team and studio slot are now locked.
                </p>

                <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 text-left max-w-md mx-auto mb-8 space-y-2 text-xs">
                    <div class="flex justify-between py-1 border-b border-slate-200">
                        <span class="text-slate-500">Appointment ID:</span>
                        <span class="font-mono font-bold text-slate-800">#@AppointmentId</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-200">
                        <span class="text-slate-500">Event Date &amp; Time:</span>
                        <span class="font-bold text-slate-800">@_appointment?.EventDate.ToString("MMMM dd, yyyy") at @_appointment?.EventTime.ToString("h:mm tt")</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-200">
                        <span class="text-slate-500">Payment Channel:</span>
                        <span class="font-bold text-slate-800">@_selectedChannelName (Simulated QR)</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-200">
                        <span class="text-slate-500">Deposit Paid (15%):</span>
                        <span class="font-bold text-emerald-700">₱@(_appointment?.DownpaymentAmount.ToString("N2"))</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-200">
                        <span class="text-slate-500">Remaining Balance (85%):</span>
                        <span class="font-bold text-slate-800">₱@(_appointment?.FinalBalanceAmount.ToString("N2"))</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-slate-500">Balance Due Date:</span>
                        <span class="font-medium text-slate-700">Upon photoshoot wrap-up</span>
                    </div>
                </div>

                <div class="p-4 bg-teal-50 border border-teal-200 rounded-xl max-w-md mx-auto mb-8 text-xs text-teal-800 text-left flex items-start gap-3">
                    <svg class="w-5 h-5 text-teal-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <div>
                        <strong>Confirmation Notification Dispatched</strong>
                        <p class="text-teal-700 mt-0.5">A receipt and updated event booking confirmation have been recorded for <strong>@_appointment?.CustomerEmail</strong>.</p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/my/bookings" class="w-full sm:w-auto px-6 py-3 bg-teal-700 hover:bg-teal-800 text-white rounded-xl text-xs font-bold transition-all shadow-sm">
                        View My Bookings &rarr;
                    </a>
                    <a href="/my" class="w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all">
                        Customer Portal Dashboard
                    </a>
                </div>
            </div>
        }
        else if (_bookingState == "Deal_Lost")
        {
            <!-- DYNAMIC STATUS 2: DEAL LOST (OFFER DECLINED / TIMEOUT) -->
            <div class="bg-white rounded-2xl p-8 sm:p-10 border border-rose-200 shadow-sm text-center animate-fade-in">
                <div class="w-16 h-16 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-5 shadow-inner">
                    <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </div>
                <div class="flex items-center justify-center gap-2 mb-2">
                    <span class="inline-block px-3 py-1 bg-rose-100 text-rose-800 font-bold text-xs rounded-full uppercase tracking-wider">
                        Status: Deal Lost
                    </span>
                    <span class="inline-block px-3 py-1 bg-slate-100 text-slate-700 font-bold text-xs rounded-full uppercase tracking-wider">
                        Hold Released
                    </span>
                </div>
                <h2 class="text-2xl font-black text-slate-900 mb-2">Booking Proposal Closed (Deal Lost)</h2>
                <p class="text-sm text-slate-600 max-w-lg mx-auto mb-6">
                    This booking negotiation has been closed without payment. The temporary reservation hold for
                    <strong>@(_appointment?.EventName)</strong> on <strong>@(_appointment?.EventDate.ToString("MMMM dd, yyyy"))</strong>
                    has been released.
                </p>

                <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 text-left max-w-md mx-auto mb-8 space-y-2 text-xs">
                    <div class="flex justify-between py-1 border-b border-slate-200">
                        <span class="text-slate-500">Appointment ID:</span>
                        <span class="font-mono font-bold text-slate-800">#@AppointmentId</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-slate-200">
                        <span class="text-slate-500">Negotiation Status:</span>
                        <span class="font-bold text-rose-700">Deal_Lost</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-slate-500">Resolution:</span>
                        <span class="font-medium text-slate-700">Studio slot returned to open availability</span>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/book" class="w-full sm:w-auto px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition-all shadow-sm">
                        Schedule New Consultation &rarr;
                    </a>
                    <a href="/services" class="w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all">
                        Browse Studio Services
                    </a>
                </div>
            </div>
        }
        else if (_bookingState == "Rescheduled")
        {
            <!-- DYNAMIC STATUS 3: RESCHEDULED -->
            <div class="bg-white rounded-2xl p-8 sm:p-10 border border-amber-200 shadow-sm text-center animate-fade-in">
                <div class="w-16 h-16 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-5 shadow-inner">
                    <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div class="flex items-center justify-center gap-2 mb-2">
                    <span class="inline-block px-3 py-1 bg-amber-100 text-amber-800 font-bold text-xs rounded-full uppercase tracking-wider">
                        Status: Rescheduled
                    </span>
                    <span class="inline-block px-3 py-1 bg-teal-100 text-teal-800 font-bold text-xs rounded-full uppercase tracking-wider">
                        Hold Refreshed (+30m)
                    </span>
                </div>
                <h2 class="text-2xl font-black text-slate-900 mb-2">Appointment Successfully Rescheduled!</h2>
                <p class="text-sm text-slate-600 max-w-lg mx-auto mb-6">
                    Your appointment has been adjusted to your newly chosen time. Our Office Clerk has been notified.
                    You may now finalize the 15% deposit to lock the new session slot.
                </p>

                <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 text-left max-w-md mx-auto mb-8 space-y-2 text-xs">
                    <div class="flex justify-between py-1 border-b border-amber-200">
                        <span class="text-slate-500">Appointment ID:</span>
                        <span class="font-mono font-bold text-slate-800">#@AppointmentId</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-amber-200">
                        <span class="text-slate-500">New Event Date:</span>
                        <span class="font-bold text-amber-900">@_appointment?.EventDate.ToString("dddd, MMMM dd, yyyy")</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-amber-200">
                        <span class="text-slate-500">New Event Time:</span>
                        <span class="font-bold text-amber-900">@_appointment?.EventTime.ToString("h:mm tt")</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-slate-500">Deposit Due:</span>
                        <span class="font-bold text-emerald-700">₱@(_appointment?.DownpaymentAmount.ToString("N2"))</span>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                    <button type="button" @onclick='() => _bookingState = "Checkout"'
                            class="w-full sm:w-auto px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-bold transition-all shadow-sm">
                        Proceed to QR Payment for New Slot &rarr;
                    </button>
                    <a href="/my/bookings" class="w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all">
                        View in My Bookings
                    </a>
                </div>
            </div>
        }
        else if (_appointment != null)
        {
            <!-- CHECKOUT & PAYMENT STEP -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Left Column: Simulated QR Online Payment Interface -->
                <div class="lg:col-span-7 space-y-6">
                    <!-- Hold Countdown Alert -->
                    <div class="p-4 rounded-xl border @(_isExpired ? "bg-red-50 border-red-200 text-red-900" : "bg-amber-50 border-amber-200 text-amber-900") flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="text-xl">@(_isExpired ? "⚠️" : "⏳")</span>
                            <div>
                                <h3 class="text-xs font-bold uppercase tracking-wider">
                                    @(_isExpired ? "Reservation Hold Expired" : "Temporary 30-Minute Reservation Hold")
                                </h3>
                                <p class="text-[11px] @(_isExpired ? "text-red-700" : "text-amber-800")">
                                    @(_isExpired
                                        ? "Your hold time has elapsed. Please request an extension or reschedule."
                                        : "Complete payment before the timer expires to secure your assigned creative crew.")
                                </p>
                            </div>
                        </div>
                        <div class="text-right pl-3 shrink-0">
                            <div class="text-[10px] uppercase font-bold text-slate-500">Hold Timer</div>
                            <div class="font-mono text-base font-black @(_isExpired ? "text-red-700" : "text-amber-900")">
                                @_countdownDisplay
                            </div>
                        </div>
                    </div>

                    <!-- Simulated QR Online Payment Box -->
                    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <div>
                                <h2 class="text-sm font-bold text-slate-900">QR Online Payment Simulation</h2>
                                <p class="text-xs text-slate-500">Instant reservation settlement via official Bangko Sentral QR Ph interoperable channels.</p>
                            </div>
                            <span class="px-2.5 py-1 bg-teal-50 text-teal-700 border border-teal-200 rounded-full text-[10px] font-bold uppercase tracking-wider">
                                Instant Verification
                            </span>
                        </div>

                        <!-- Payment Channel Tabs -->
                        <div class="grid grid-cols-3 gap-2 my-4">
                            <button type="button" @onclick='() => SelectChannel("QRPH", "QR Ph National Standard", "#0d9488")'
                                    class="py-2.5 px-3 rounded-xl border text-center transition-all @(_selectedChannel == "QRPH" ? "border-teal-600 bg-teal-50 text-teal-900 font-bold shadow-xs ring-2 ring-teal-500/20" : "border-slate-200 bg-white text-slate-600 hover:border-slate-300 font-medium")">
                                <div class="text-xs">🇵🇭 QR Ph</div>
                                <div class="text-[10px] text-slate-400 mt-0.5">All Banks &amp; Wallets</div>
                            </button>

                            <button type="button" @onclick='() => SelectChannel("GCASH", "GCash QR", "#007dfe")'
                                    class="py-2.5 px-3 rounded-xl border text-center transition-all @(_selectedChannel == "GCASH" ? "border-blue-600 bg-blue-50 text-blue-900 font-bold shadow-xs ring-2 ring-blue-500/20" : "border-slate-200 bg-white text-slate-600 hover:border-slate-300 font-medium")">
                                <div class="text-xs">💙 GCash</div>
                                <div class="text-[10px] text-slate-400 mt-0.5">Scan to Pay</div>
                            </button>

                            <button type="button" @onclick='() => SelectChannel("MAYA", "Maya QR", "#22c55e")'
                                    class="py-2.5 px-3 rounded-xl border text-center transition-all @(_selectedChannel == "MAYA" ? "border-emerald-600 bg-emerald-50 text-emerald-900 font-bold shadow-xs ring-2 ring-emerald-500/20" : "border-slate-200 bg-white text-slate-600 hover:border-slate-300 font-medium")">
                                <div class="text-xs">💚 Maya</div>
                                <div class="text-[10px] text-slate-400 mt-0.5">Wallet / Bank App</div>
                            </button>
                        </div>

                        <!-- Simulated QR Card Graphic -->
                        <div class="p-5 bg-slate-50 rounded-xl border border-slate-200 text-center space-y-3">
                            <div class="inline-block p-4 bg-white rounded-xl border border-slate-200 shadow-sm relative group">
                                @if (!string.IsNullOrEmpty(_qrSvg))
                                {
                                    <div class="w-44 h-44 mx-auto" aria-label="Payment QR code">
                                        @((MarkupString)_qrSvg)
                                    </div>
                                }
                                else
                                {
                                    <!-- Dynamic Channel-Colored QR SVG -->
                                    <svg class="w-44 h-44 mx-auto" viewBox="0 0 100 100" fill="currentColor">
                                        <rect width="100" height="100" fill="white" />
                                        <rect x="8" y="8" width="26" height="26" rx="4" fill="@_channelColor" />
                                        <rect x="12" y="12" width="18" height="18" fill="white" />
                                        <rect x="16" y="16" width="10" height="10" rx="2" fill="@_channelColor" />
                                        <rect x="66" y="8" width="26" height="26" rx="4" fill="@_channelColor" />
                                        <rect x="70" y="12" width="18" height="18" fill="white" />
                                        <rect x="74" y="16" width="10" height="10" rx="2" fill="@_channelColor" />
                                        <rect x="8" y="66" width="26" height="26" rx="4" fill="@_channelColor" />
                                        <rect x="12" y="70" width="18" height="18" fill="white" />
                                        <rect x="16" y="74" width="10" height="10" rx="2" fill="@_channelColor" />
                                        <rect x="36" y="36" width="28" height="28" rx="6" fill="@_channelColor" />
                                        <rect x="38" y="38" width="24" height="24" rx="4" fill="white" />
                                        <circle cx="50" cy="50" r="8" fill="@_channelColor" />
                                        <text x="50" y="53" font-size="8" font-family="sans-serif" font-weight="900" text-anchor="middle" fill="white">A</text>
                                    </svg>
                                }
                                <div class="mt-2 text-[10px] font-mono text-slate-500 tracking-wider">
                                    REF: QRPH-@AppointmentId-@(_appointment.EventDate.ToString("MMdd"))
                                </div>
                            </div>

                            <div>
                                <div class="text-xs font-bold text-slate-900">Photo Aevum Studio Inc. • Official QR Merchant</div>
                                <div class="text-[11px] text-slate-500 mt-0.5">
                                    Scan with GCash, Maya, ShopeePay, or any banking app supporting QR Ph.
                                </div>
                                <div class="text-sm font-black text-emerald-700 mt-1">
                                    Payable: ₱@_appointment.DownpaymentAmount.ToString("N2") <span class="text-[10px] font-normal text-slate-500">(15% Deposit)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Primary Simulated Action: Open Mobile Wallet Simulation Drawer -->
                        <div class="mt-6 space-y-3">
                            <button type="button" @onclick="OpenMobileAuthModal" disabled="@(_isProcessing || _isExpired)"
                                    class="w-full py-3.5 px-4 bg-emerald-700 hover:bg-emerald-800 disabled:opacity-50 disabled:cursor-not-allowed text-white rounded-xl text-sm font-black shadow-md transition-all flex items-center justify-center gap-2">
                                <span>📱 Simulate Mobile QR Scan &amp; Pay (₱@_appointment.DownpaymentAmount.ToString("N2"))</span>
                            </button>
                            <p class="text-[11px] text-slate-500 text-center">
                                Simulates a customer scanning the QR code with their mobile banking or e-wallet app, settling the 15% deposit, and automatically transitioning the deal outcome to <strong>Deal Won</strong>.
                            </p>

                            @if (Env.IsDevelopment())
                            {
                                <div class="pt-3 border-t border-slate-100 text-center space-y-3">
                                    <button type="button"
                                            class="w-full py-2.5 px-4 rounded-xl bg-teal-700 hover:bg-teal-800 disabled:opacity-50 text-white text-xs font-bold shadow-xs transition-colors"
                                            @onclick="() => _showWebcamScanner = !_showWebcamScanner"
                                            disabled="@_webcamScanBusy">
                                        @(_showWebcamScanner ? "Hide Laptop Webcam Scanner" : "Test Scan via Laptop Webcam")
                                    </button>

                                    @if (_showWebcamScanner)
                                    {
                                        <div class="mx-auto max-w-sm overflow-hidden rounded-xl border border-slate-200 bg-slate-900 p-2">
                                            <BarcodeReader ScanResult="OnScanResult" Title="Scan the QR code" />
                                        </div>
                                    }

                                    @if (_webcamScanBusy)
                                    {
                                        <div class="flex items-center justify-center gap-2 text-xs text-slate-600" role="status">
                                            <span class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-teal-600 border-t-transparent"></span>
                                            Simulating QR payment with Xendit&hellip;
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(_webcamScanMessage))
                                    {
                                        <p class="text-xs rounded-lg px-3 py-2 @(_webcamScanFailed ? "bg-red-50 text-red-700 border border-red-200" : "bg-emerald-50 text-emerald-800 border border-emerald-200")" role="status">
                                            @_webcamScanMessage
                                        </p>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Secondary Actions: Reschedule & Deal Lost -->
                        <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row gap-2.5">
                            <button type="button" @onclick="OpenRescheduleModal" disabled="@_isProcessing"
                                    class="flex-1 py-2.5 px-3 border border-amber-300 bg-amber-50 hover:bg-amber-100 text-amber-900 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5">
                                <span>📅 Request Reschedule</span>
                            </button>

                            <button type="button" @onclick="OpenDeclineModal" disabled="@_isProcessing"
                                    class="flex-1 py-2.5 px-3 border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-800 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5">
                                <span>❌ Decline Proposal (Deal Lost)</span>
                            </button>
