@code {
    [Parameter]
    public string AppointmentId { get; set; } = string.Empty;

    private EventAppointmentDto? _appointment;
    private string? _qrSvg;
    private bool _loading = true;
    private bool _isProcessing = false;
    private bool _isExpired = false;
    private string? _errorMessage;
    private string? _modalError;

    // Booking status state: "Checkout", "Deal_Won", "Deal_Lost", "Rescheduled"
    private string _bookingState = "Checkout";

    // QR Payment Channels: "QRPH", "GCASH", "MAYA"
    private string _selectedChannel = "QRPH";
    private string _selectedChannelName = "QR Ph National Standard";
    private string _channelColor = "#0d9488";

    // Modal states
    private bool _showMobileAuthModal = false;
    private bool _showRescheduleModal = false;
    private bool _showDeclineModal = false;

    // Reschedule form
    private DateOnly _rescheduleDate = DateOnly.FromDateTime(DateTime.Today.AddDays(7));
    private string _rescheduleTimeStr = "10:00";
    private string _rescheduleReason = "Schedule adjustment";

    // Decline form
    private string _declineReason = "Client opted not to proceed";

    private string _countdownDisplay = "30:00";
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointmentAsync();
    }

    private async Task LoadAppointmentAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var res = await ConsultationApi.GetAppointmentByIdAsync(AppointmentId);
            if (res.IsSuccess && res.Value != null)
            {
                _appointment = res.Value;
                _rescheduleDate = _appointment.EventDate.AddDays(7);

                var configuredBase = Config["BaseUrl"]?.Trim();
                var effectiveBase = (!string.IsNullOrWhiteSpace(configuredBase) &&
                                     !configuredBase.Contains("localhost", StringComparison.OrdinalIgnoreCase) &&
                                     !configuredBase.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase))
                    ? configuredBase
                    : (Nav.BaseUri.Contains("localhost", StringComparison.OrdinalIgnoreCase) || Nav.BaseUri.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase)
                        ? (string.IsNullOrWhiteSpace(configuredBase) ? Nav.BaseUri : configuredBase)
                        : Nav.BaseUri);

                var confirmUrl = QrPaymentLinks.BuildConfirmUrl(effectiveBase, Nav.BaseUri, AppointmentId);
                using var generator = new QRCodeGenerator();
                using var qrData = generator.CreateQrCode(confirmUrl, QRCodeGenerator.ECCLevel.M);
                _qrSvg = new SvgQRCode(qrData).GetGraphic(6);

                if (string.Equals(_appointment.DownpaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(_appointment.EventStatus, "Confirmed", StringComparison.OrdinalIgnoreCase))
                {
                    _bookingState = "Deal_Won";
                }
                else if (string.Equals(_appointment.EventStatus, "Cancelled", StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(_appointment.DownpaymentStatus, "Cancelled", StringComparison.OrdinalIgnoreCase))
                {
                    _bookingState = "Deal_Lost";
                }
                else
                {
                    _bookingState = "Checkout";
                    StartCountdown();
                }
            }
            else
            {
                _errorMessage = res.Error?.Message ?? $"Event appointment #{AppointmentId} could not be located.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred loading appointment: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectChannel(string channel, string name, string color)
    {
        _selectedChannel = channel;
        _selectedChannelName = name;
        _channelColor = color;
    }

    private void OpenMobileAuthModal()
    {
        _modalError = null;
        _showMobileAuthModal = true;
    }

    private void OpenRescheduleModal()
    {
        _modalError = null;
        _showRescheduleModal = true;
    }

    private void OpenDeclineModal()
    {
        _modalError = null;
        _showDeclineModal = true;
    }

    private async Task ConfirmSimulatedPaymentAsync()
    {
        if (_isProcessing || _appointment == null) return;
        _isProcessing = true;
        _modalError = null;

        try
        {
            // Update booking status to Deal_Won with QR payment
            var req = new UpdatePaymentBookingStatusRequest
            {
                Status = "Deal_Won",
                PaymentMethod = _selectedChannelName
            };

            var res = await ConsultationApi.UpdateBookingStatusAsync(_appointment.EventAppointmentId, req);
            if (res.IsSuccess && res.Value != null)
            {
                _appointment = res.Value;
                _bookingState = "Deal_Won";
                _showMobileAuthModal = false;
                _timer?.Dispose();
            }
            else
            {
                _modalError = res.Error?.Message ?? "Payment verification simulation failed.";
            }
        }
        catch (Exception ex)
        {
            _modalError = $"Simulation error: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SubmitRescheduleAsync()
    {
        if (_isProcessing || _appointment == null) return;
        _isProcessing = true;
        _modalError = null;

        try
        {
            var parsedTime = TimeOnly.Parse(_rescheduleTimeStr);
            var req = new UpdatePaymentBookingStatusRequest
            {
                Status = "Rescheduled",
                NewDate = _rescheduleDate,
                NewTime = parsedTime,
                Reason = _rescheduleReason
            };

            var res = await ConsultationApi.UpdateBookingStatusAsync(_appointment.EventAppointmentId, req);
            if (res.IsSuccess && res.Value != null)
            {
                _appointment = res.Value;
                _bookingState = "Rescheduled";
                _showRescheduleModal = false;
                StartCountdown();
            }
            else
            {
                _modalError = res.Error?.Message ?? "Could not reschedule appointment.";
            }
        }
        catch (Exception ex)
        {
            _modalError = $"Reschedule error: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SubmitDealLostAsync()
    {
        if (_isProcessing || _appointment == null) return;
        _isProcessing = true;
        _modalError = null;

        try
        {
            var req = new UpdatePaymentBookingStatusRequest
            {
                Status = "Deal_Lost",
                Reason = _declineReason
            };

            var res = await ConsultationApi.UpdateBookingStatusAsync(_appointment.EventAppointmentId, req);
            if (res.IsSuccess && res.Value != null)
            {
                _appointment = res.Value;
                _bookingState = "Deal_Lost";
                _showDeclineModal = false;
                _timer?.Dispose();
            }
            else
            {
                _modalError = res.Error?.Message ?? "Could not cancel booking.";
            }
        }
        catch (Exception ex)
        {
            _modalError = $"Error: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void StartCountdown()
    {
        _timer?.Dispose();

        if (_appointment?.HoldExpiresAt == null)
        {
            _countdownDisplay = "30:00";
            return;
        }

        UpdateCountdown();
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                UpdateCountdown();
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void UpdateCountdown()
    {
        if (_appointment?.HoldExpiresAt == null) return;

        var diff = _appointment.HoldExpiresAt.Value - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero)
        {
            _isExpired = true;
            _countdownDisplay = "00:00";
            _timer?.Dispose();
        }
        else
        {
            _isExpired = false;
            _countdownDisplay = $"{(int)diff.TotalMinutes:D2}:{diff.Seconds:D2}";
        }
    }

    private bool _showWebcamScanner;
    private bool _webcamScanBusy;
    private bool _webcamScanFailed;
    private string? _webcamScanMessage;

    private Task OnScanResult(string result) => OnWebcamQrScannedAsync(result);

    private async Task OnWebcamQrScannedAsync(string scanned)
    {
        if (_webcamScanBusy || string.IsNullOrWhiteSpace(scanned)) return;

        if (QrPaymentLinks.TryGetConfirmPath(scanned, out _, out var relativeConfirmPath))
        {
            _showWebcamScanner = false;
            Nav.NavigateTo("/" + relativeConfirmPath.TrimStart('/'));
            return;
        }

        _webcamScanBusy = true;
        _webcamScanFailed = false;
        _webcamScanMessage = null;
        StateHasChanged();
        try
        {
            var externalId = ExtractWebcamExternalId(scanned);
            var res = await ConsultationApi.SimulateQrPaymentAsync(externalId);
            _webcamScanFailed = !res.IsSuccess;
            _webcamScanMessage = res.IsSuccess
                ? "QR scanned and payment simulated. Please wait for the ngrok webhook to confirm this reservation."
                : "Xendit simulation failed. Check the API log for details.";
            if (res.IsSuccess) _showWebcamScanner = false;
        }
        catch (Exception ex)
        {
            _webcamScanFailed = true;
            _webcamScanMessage = "Simulation request failed: " + ex.Message;
        }
        finally
        {
            _webcamScanBusy = false;
            StateHasChanged();
        }
    }

    private string ExtractWebcamExternalId(string scanned)
    {
        var data = scanned.Trim();
        if (QrPaymentLinks.TryGetConfirmPath(data, out var confirmId, out _))
            return confirmId;
        if (Uri.TryCreate(data, UriKind.Absolute, out var scannedUri))
        {
            var lastSegment = Uri.UnescapeDataString(scannedUri.AbsolutePath.Trim('/').Split('/').LastOrDefault() ?? string.Empty);
            if (!string.IsNullOrWhiteSpace(lastSegment)) return lastSegment;
        }
        if (data.StartsWith("MOCK-QRPH|", StringComparison.Ordinal))
        {
            var parts = data.Split('|');
            if (parts.Length > 1 && !string.IsNullOrWhiteSpace(parts[1])) return parts[1];
        }
        if (data.StartsWith('{'))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(data);
                foreach (var name in new[] { "reference_id", "external_id" })
                    if (doc.RootElement.TryGetProperty(name, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String)
                        return v.GetString()!;
            }
            catch (System.Text.Json.JsonException) { }
        }
        return data.StartsWith("000201", StringComparison.Ordinal) ? AppointmentId : data;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
