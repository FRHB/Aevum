@inject NavigationManager NavManager

@code {
    protected override void OnInitialized()
    {
        var relativeUri = NavManager.ToBaseRelativePath(NavManager.Uri);
        if (string.IsNullOrWhiteSpace(relativeUri) || relativeUri.StartsWith("login", StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo("/login");
        }
        else
        {
            NavManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(relativeUri)}");
        }
    }
}
