@inject AppBootInfo BootInfo

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="aevum-boot-id" content="@BootInfo.BootId" />
    <meta name="aevum-build-hash" content="@BootInfo.BuildHash" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <!-- Blazor specific CSS isolation (adjust name to match your assembly) -->
    <link rel="stylesheet" href="@Assets["PhotoAevumStudio.Web.styles.css"]" />
    <ImportMap />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: { brand: { 50: '#f6f6f6', 100: '#e7e7e7', 500: '#1a1a1a', 600: '#000000', 900: '#000000' } }
                }
            }
        }
    </script>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body class="antialiased min-h-screen flex flex-col selection:bg-gray-200 selection:text-black">
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal />
    <script src="_content/ZXing.Blazor/lib/barcodereader/zxing.js"></script>
    <script src="_content/ZXing.Blazor/lib/barcodereader/barcode.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/dropbox-upload.js"></script>
    <script>
        // System Update, Refresh & Circuit Navigation Recovery
        (function () {
            const RECOVERY_KEY = '__aevum_nav_recovery';
            const initialBootId = document.querySelector('meta[name="aevum-boot-id"]')?.getAttribute('content') || '';
            const initialBuildHash = document.querySelector('meta[name="aevum-build-hash"]')?.getAttribute('content') || '';
            let lastCheckAt = 0;

            function readRecoveryState() {
                try {
                    const raw = sessionStorage.getItem(RECOVERY_KEY);
                    return raw ? JSON.parse(raw) : null;
                } catch {
                    return null;
                }
            }

            function writeRecoveryState(state) {
                try {
                    if (!state) {
                        sessionStorage.removeItem(RECOVERY_KEY);
                    } else {
                        sessionStorage.setItem(RECOVERY_KEY, JSON.stringify(state));
                    }
                } catch { }
            }

            const navState = {
                bootId: initialBootId,
                buildHash: initialBuildHash,
                updateAvailable: false,
                circuitBroken: false,
                pendingNav: null,
                reloading: false,

                markCircuitBroken: function (broken) {
                    this.circuitBroken = !!broken;
                    if (!broken) {
                        writeRecoveryState(null);
                    }
                },

                navigateHard: function (targetUrl) {
                    if (this.reloading) return;
                    const dest = targetUrl || window.location.href;
                    this.reloading = true;
                    writeRecoveryState(null);
                    window.location.assign(dest);
                },

                reloadClean: function (targetUrl) {
                    if (this.reloading) return;
                    const dest = targetUrl || window.location.href;
                    const now = Date.now();
                    const prev = readRecoveryState();
                    if (prev && prev.url === dest && (now - prev.ts) < 8000 && prev.count >= 2) {
                        return;
                    }
                    const nextCount = (prev && prev.url === dest && (now - prev.ts) < 8000) ? (prev.count + 1) : 1;
                    writeRecoveryState({ url: dest, count: nextCount, ts: now });
                    this.reloading = true;
                    window.location.replace(dest);
                },

                recoverNavigation: function () {
                    const pending = this.pendingNav;
                    this.pendingNav = null;
                    if (pending && pending.url && (Date.now() - pending.at) <= 15000 && pending.url !== window.location.href) {
                        this.reloadClean(pending.url);
                        return;
                    }
                    this.reloadClean(window.location.href);
                },

                checkForUpdate: async function (force) {
                    if (!this.bootId || this.reloading) return false;
                    const now = Date.now();
                    if (!force && (now - lastCheckAt) < 5000) return this.updateAvailable;
                    lastCheckAt = now;
                    try {
                        const res = await fetch('/version?t=' + now, { cache: 'no-store', credentials: 'same-origin' });
                        if (!res.ok) return false;
                        const data = await res.json();
                        const serverBootId = data?.bootId;
                        const serverBuildHash = data?.buildHash;
                        if ((serverBootId && serverBootId !== this.bootId) ||
                            (serverBuildHash && this.buildHash && serverBuildHash !== this.buildHash)) {
                            this.updateAvailable = true;
                            return true;
                        }
                    } catch {
                        // Server may be momentarily restarting during deployment
                    }
                    return false;
                }
            };

            window.__aevumNav = navState;

            document.addEventListener('click', function (e) {
                if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
                    return;
                }
                const anchor = e.target?.closest?.('a[href]');
                if (!anchor) return;
                if (anchor.hasAttribute('download') || anchor.hasAttribute('data-aevum-modal-link')) return;
                if (anchor.target && anchor.target !== '_self') return;

                const rawHref = anchor.getAttribute('href');
                if (!rawHref || rawHref.startsWith('#') || rawHref.startsWith('mailto:') || rawHref.startsWith('tel:') || rawHref.startsWith('javascript:')) {
                    return;
                }

                let targetUrl;
                try {
                    const parsed = new URL(anchor.href, window.location.href);
                    if (parsed.origin !== window.location.origin) return;
                    targetUrl = parsed.href;
                } catch {
                    return;
                }

                navState.pendingNav = { url: targetUrl, at: Date.now() };

                if (navState.updateAvailable || navState.circuitBroken) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    navState.navigateHard(targetUrl);
                }
            }, true);

            window.addEventListener('popstate', function () {
                navState.pendingNav = null;
                if (navState.updateAvailable || navState.circuitBroken) {
                    navState.reloadClean(window.location.href);
                }
            });

            window.addEventListener('pageshow', function (e) {
                if (e.persisted) {
                    navState.reloadClean(window.location.href);
                }
            });

            document.addEventListener('visibilitychange', function () {
                if (document.visibilityState === 'visible') {
                    navState.checkForUpdate(false);
                }
            });

            window.addEventListener('online', function () {
                navState.checkForUpdate(true);
            });

            setInterval(function () {
                if (document.visibilityState === 'visible') {
                    navState.checkForUpdate(false);
                }
            }, 30000);

            setTimeout(function () {
                if (!navState.circuitBroken) {
                    writeRecoveryState(null);
                }
            }, 10000);

            if (typeof Blazor !== 'undefined' && typeof Blazor.addEventListener === 'function') {
                Blazor.addEventListener('enhancedload', function () {
                    const currentMetaBootId = document.querySelector('meta[name="aevum-boot-id"]')?.getAttribute('content') || '';
                    if ((currentMetaBootId && initialBootId && currentMetaBootId !== initialBootId) || navState.updateAvailable) {
                        navState.reloadClean(window.location.href);
                        return;
                    }
                    if (typeof lucide !== 'undefined' && lucide.createIcons) {
                        lucide.createIcons();
                    }
                });
            }
        })();

        // Global JS initialization
        if (typeof lucide !== 'undefined' && lucide.createIcons) {
            lucide.createIcons();
        }

        // Navbar blur effect on scroll
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (nav) {
                if (window.scrollY > 10) {
                    nav.classList.add('shadow-sm');
                    nav.style.background = 'rgba(255, 255, 255, 0.98)';
                } else {
                    nav.classList.remove('shadow-sm');
                    nav.style.background = 'rgba(255, 255, 255, 0.95)';
                }
            }
        });

        // Inactive Session Inactivity Monitor
        window.aevumSessionMonitor = {
            timer: null,
            lastActivity: Date.now(),
            events: ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'],
            handler: null,
            start: function (dotNetRef, timeoutMs) {
                this.stop();
                this.lastActivity = Date.now();
                this.handler = () => { this.lastActivity = Date.now(); };
                this.events.forEach(e => window.addEventListener(e, this.handler, { passive: true }));
                this.timer = setInterval(() => {
                    if (Date.now() - this.lastActivity >= timeoutMs) {
                        this.stop();
                        dotNetRef.invokeMethodAsync('HandleSessionTimeout');
                    }
                }, 10000);
            },
            stop: function () {
                if (this.timer) {
                    clearInterval(this.timer);
                    this.timer = null;
                }
                if (this.handler) {
                    this.events.forEach(e => window.removeEventListener(e, this.handler));
                    this.handler = null;
                }
            }
        };

        // Modal Scroll-to-End Observer (Terms & Conditions, Privacy Policy)
        window.aevumScrollHelper = {
            observeScrollToEnd: function (elementId, dotNetHelper) {
                const el = document.getElementById(elementId);
                if (!el) return;
                const check = () => {
                    // Trigger when within 30px of bottom or if container does not overflow
                    if (el.scrollHeight - el.scrollTop - el.clientHeight <= 30 || el.scrollHeight <= el.clientHeight) {
                        try {
                            dotNetHelper.invokeMethodAsync('OnScrolledToEnd');
                        } catch (e) { }
                        el.removeEventListener('scroll', check);
                    }
                };
                el.addEventListener('scroll', check, { passive: true });
                requestAnimationFrame(() => setTimeout(check, 100));
            }
        };

        // Calendar Day Timetable Row/Block 10-Second Highlight Helper
        window.aevumCalendar = {
            highlightTimers: {},
            highlightEventRow: function (eventId, durationMs) {
                if (!eventId) return;
                const duration = typeof durationMs === 'number' && durationMs > 0 ? durationMs : 10000;
                const selector = '[data-event-id="' + CSS.escape(eventId) + '"]';

                const attemptHighlight = (retries) => {
                    const el = document.querySelector(selector);
                    if (!el) {
                        if (retries > 0) {
                            setTimeout(() => attemptHighlight(retries - 1), 60);
                        }
                        return;
                    }

                    document.querySelectorAll('.event-row-highlighted').forEach(node => {
                        node.classList.remove('event-row-highlighted');
                    });

                    Object.keys(this.highlightTimers).forEach(k => {
                        clearTimeout(this.highlightTimers[k]);
                        delete this.highlightTimers[k];
                    });

                    el.classList.add('event-row-highlighted');
                    try {
                        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } catch (e) { }

                    this.highlightTimers[eventId] = setTimeout(() => {
                        el.classList.remove('event-row-highlighted');
                        delete this.highlightTimers[eventId];
                    }, duration);
                };

                requestAnimationFrame(() => attemptHighlight(8));
            }
        };

        window.aevumAnalyticsDownload = function (fileName, content, mimeType) {
            try {
                const blob = new Blob([content], { type: mimeType || 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const anchor = document.createElement('a');
                anchor.href = url;
                anchor.download = fileName || 'studio-analytics.csv';
                document.body.appendChild(anchor);
                anchor.click();
                document.body.removeChild(anchor);
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            } catch (e) { }
        };

        window.aevumDownloadBase64 = function (fileName, base64Data, mimeType) {
            try {
                const binary = atob(base64Data);
                const len = binary.length;
                const bytes = new Uint8Array(len);
                for (let i = 0; i < len; i++) bytes[i] = binary.charCodeAt(i);
                const blob = new Blob([bytes], { type: mimeType || 'application/pdf' });
                const url = URL.createObjectURL(blob);
                const anchor = document.createElement('a');
                anchor.href = url;
                anchor.download = fileName || 'document.pdf';
                document.body.appendChild(anchor);
                anchor.click();
                document.body.removeChild(anchor);
                setTimeout(() => URL.revokeObjectURL(url), 1500);
            } catch (e) { }
        };
    </script>
</body>
</html>
