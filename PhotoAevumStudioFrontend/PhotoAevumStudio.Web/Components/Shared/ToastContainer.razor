@if (IsVisible)
{
    <div class="fixed bottom-4 right-4 z-50 transition-opacity duration-300">
        <div class="bg-gray-800 text-white px-6 py-3 rounded-lg shadow-lg flex items-center gap-3">
            @if (IsSuccess) { <i data-lucide="check-circle" class="text-green-400 w-5 h-5"></i> }
            else { <i data-lucide="info" class="text-blue-400 w-5 h-5"></i> }
            <span>@Message</span>
        </div>
    </div>
}

@code {
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public bool IsSuccess { get; set; } = true;
    [Parameter] public bool IsVisible { get; set; } = false;
}
