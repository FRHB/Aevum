@using PhotoAevumStudio.Web.Models

@{
    var lengthMet = PasswordPolicyHelper.HasValidLength(Password);
    var numberMet = PasswordPolicyHelper.HasNumber(Password);
    var specialMet = PasswordPolicyHelper.HasSpecialCharacter(Password);
    var currentLen = Password?.Length ?? 0;
}

<ul class="pw-checklist @(CssClass)" aria-label="Password requirements" aria-live="polite">
    <li class="pw-checklist__item @(lengthMet ? "is-met" : "is-unmet")" data-fulfilled="@(lengthMet ? "true" : "false")">
        <span class="pw-checklist__icon" aria-hidden="true">@(lengthMet ? "✓" : "✕")</span>
        <span>Minimum @PasswordPolicyHelper.MinLength and maximum @PasswordPolicyHelper.MaxLength characters (@currentLen/@PasswordPolicyHelper.MaxLength)</span>
    </li>
    <li class="pw-checklist__item @(numberMet ? "is-met" : "is-unmet")" data-fulfilled="@(numberMet ? "true" : "false")">
        <span class="pw-checklist__icon" aria-hidden="true">@(numberMet ? "✓" : "✕")</span>
        <span>At least one number (0–9)</span>
    </li>
    <li class="pw-checklist__item @(specialMet ? "is-met" : "is-unmet")" data-fulfilled="@(specialMet ? "true" : "false")">
        <span class="pw-checklist__icon" aria-hidden="true">@(specialMet ? "✓" : "✕")</span>
        <span>At least one special character (@@, #, $, %, &amp;)</span>
    </li>
</ul>

@code {
    [Parameter] public string? Password { get; set; }
    [Parameter] public string? CssClass { get; set; }
}
