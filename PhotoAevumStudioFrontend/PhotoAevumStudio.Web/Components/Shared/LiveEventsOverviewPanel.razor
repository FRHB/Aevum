@using PhotoAevumStudio.Web.Models
@using PhotoAevumStudio.Web.Services
@implements IDisposable
@inject IConsultationClient ConsultationApi
@inject IScheduleService ScheduleService

<section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6" aria-label="Live Concurrent Events Overview">
    <div class="px-6 py-4 border-b border-slate-200 bg-gradient-to-r from-slate-50 via-white to-teal-50/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    Live Execution Monitor
                </span>
                <span class="text-xs font-semibold text-slate-500">
                    @_concurrentActiveCount concurrent / active event@(_concurrentActiveCount == 1 ? "" : "s")
                </span>
                @if (_pendingCashCount > 0)
                {
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300">
                        💵 @_pendingCashCount Pending Cash Verification
                    </span>
                }
            </div>
            <h2 class="text-base font-extrabold text-slate-900 mt-1">Active &amp; Concurrent Events Live Progress</h2>
            <p class="text-xs text-slate-500">Stacked real-time progress across Preparation, Ongoing, Post Event, Paid Cash Pending Verification, and Complete.</p>
        </div>

        <button type="button"
                @onclick="RefreshAsync"
                disabled="@_loading"
                class="px-3.5 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-bold text-slate-700 shadow-2xs shrink-0">
            @(_loading ? "Refreshing..." : "🔄 Refresh Live Progress")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <div class="mx-6 mt-4 p-3 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center justify-between">
            <span>✓ @_actionMessage</span>
            <button type="button" @onclick="() => _actionMessage = null" class="text-emerald-700 font-bold">✕</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="mx-6 mt-4 p-3 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold flex items-center justify-between">
            <span>⚠ @_errorMessage</span>
            <button type="button" @onclick="() => _errorMessage = null" class="text-rose-700 font-bold">✕</button>
        </div>
    }

    @* ── Stage Filter Tabs ─────────────────────────────────────────────── *@
    <div class="px-6 pt-4 pb-2 flex flex-wrap items-center gap-2 border-b border-slate-100">
        @foreach (var tab in StageFilters)
        {
            var count = GetStageCount(tab);
            var active = _selectedFilter == tab;
            <button type="button"
                    @onclick="() => _selectedFilter = tab"
                    class="px-3 py-1.5 rounded-full text-[11px] font-bold transition-all border @(active ? "bg-slate-900 text-white border-slate-900" : "bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100")">
                @tab <span class="opacity-75 ml-0.5">(@count)</span>
            </button>
        }
    </div>

    @* ── Stacked Concurrent Events List ────────────────────────────────── *@
    <div class="p-6 space-y-4">
        @if (_loading && !_events.Any())
        {
            <div class="py-8 text-center text-xs text-slate-400">Loading live event progress...</div>
        }
        else if (!FilteredEvents.Any())
        {
            <div class="py-8 text-center text-xs text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                No events matching "@_selectedFilter" at the moment.
            </div>
        }
        else
        {
            @foreach (var ev in FilteredEvents)
            {
                var stage = ev.DisplayStage;
                var isCashPending = string.Equals(stage, "Paid Cash Pending Verification", StringComparison.OrdinalIgnoreCase);
                var isComplete = string.Equals(stage, "Complete", StringComparison.OrdinalIgnoreCase);
                var leader = ev.AssignedEmployees.FirstOrDefault(e => e.IsTeamLeader) ?? ev.AssignedEmployees.FirstOrDefault();

                <article class="rounded-xl border @(isCashPending ? "border-amber-300 bg-amber-50/40" : isComplete ? "border-emerald-200 bg-emerald-50/20" : "border-slate-200 bg-slate-50/60") p-5 space-y-4 shadow-2xs">
                    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-3">
                        <div class="space-y-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-mono text-[11px] font-bold px-2 py-0.5 rounded bg-slate-900 text-white">#@ev.EventAppointmentId</span>
                                <h3 class="text-sm font-extrabold text-slate-900">@ev.EventName</h3>
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold @GetStageBadgeClass(stage)">
                                    @stage
                                </span>
                                @if (string.Equals(ev.EventStatus, "Dispatch", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-100 text-indigo-800 border border-indigo-200">
                                        🚚 Dispatched
                                    </span>
                                }
                            </div>
                            <div class="text-xs text-slate-600 flex flex-wrap gap-x-4 gap-y-1">
                                <span>Client: <strong class="text-slate-900">@ev.CustomerName</strong></span>
                                <span>Schedule: <strong>@ev.EventDate.ToString("MMM d, yyyy")</strong> &bull; @DateTime.Today.Add(ev.EventTime.ToTimeSpan()).ToString("h:mm tt")</span>
                                @if (leader != null)
                                {
                                    <span>Team Leader: <strong class="text-teal-800">@leader.EmployeeName</strong></span>
                                }
                                @if (ev.AssignedEquipment.Any())
                                {
                                    var takenCount = ev.AssignedEquipment.Count(eq => eq.IsTaken);
                                    <span>Equipment: <strong>@takenCount / @ev.AssignedEquipment.Count taken</strong></span>
                                }
                                <span>Balance: <strong class="font-mono text-slate-900">₱@ev.FinalBalanceAmount.ToString("N2")</strong></span>
                            </div>
                        </div>

                        @if (isCashPending)
                        {
                            <div class="flex items-center gap-2 shrink-0">
                                <button type="button"
                                        disabled="@(_verifyingId == ev.EventAppointmentId)"
                                        @onclick="() => VerifyCashAsync(ev)"
                                        class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white text-xs font-extrabold shadow-sm transition-all flex items-center gap-1.5">
                                    <span>✓</span>
                                    <span>@(_verifyingId == ev.EventAppointmentId ? "Verifying..." : "Verify Cash")</span>
                                </button>
                            </div>
                        }
                    </div>

                    @* ── 5-Step Live Workflow Stepper ───────────────────────────── *@
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                        @foreach (var step in WorkflowSteps)
                        {
                            var state = GetStepState(stage, step);
                            var boxClass = state switch
                            {
                                "done" => "bg-emerald-100 text-emerald-900 border-emerald-300",
                                "active-amber" => "bg-amber-200 text-amber-950 border-amber-400 ring-1 ring-amber-400",
                                "active" => "bg-teal-700 text-white border-teal-700 shadow-2xs",
                                _ => "bg-white text-slate-400 border-slate-200"
                            };
                            <div class="px-2.5 py-2 rounded-lg border text-[11px] font-bold text-center flex items-center justify-center gap-1 @boxClass">
                                @if (state == "done")
                                {
                                    <span>✓</span>
                                }
                                <span>@step</span>
                            </div>
                        }
                    </div>
                </article>
            }
        }
    </div>
</section>

@code {
    [Parameter] public string ManagerId { get; set; } = string.Empty;
    [Parameter] public string ManagerName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnCashVerified { get; set; }

    private static readonly string[] StageFilters =
    {
        "All",
        "Preparation",
        "Ongoing",
        "Post Event",
        "Paid Cash Pending Verification",
        "Complete"
    };

    private static readonly string[] WorkflowSteps =
    {
        "Preparation",
        "Ongoing",
        "Post Event",
        "Paid Cash Pending Verification",
        "Complete"
    };

    private List<LiveEventOverviewDto> _events = new();
    private string _selectedFilter = "All";
    private bool _loading = true;
    private string? _verifyingId;
    private string? _actionMessage;
    private string? _errorMessage;
    private System.Threading.Timer? _refreshTimer;

    private int _concurrentActiveCount => _events.Count(e =>
        !string.Equals(e.DisplayStage, "Complete", StringComparison.OrdinalIgnoreCase));

    private int _pendingCashCount => _events.Count(e =>
        string.Equals(e.DisplayStage, "Paid Cash Pending Verification", StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LiveEventOverviewDto> FilteredEvents => _selectedFilter == "All"
        ? _events
        : _events.Where(e =>
            string.Equals(e.DisplayStage, _selectedFilter, StringComparison.OrdinalIgnoreCase) ||
            (_selectedFilter == "Preparation" && string.Equals(e.DisplayStage, "Dispatch", StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshAsync();
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
        StateHasChanged();
    }

    public async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            var res = await ConsultationApi.GetLiveEventsOverviewAsync();
            if (res.IsSuccess && res.Value != null)
            {
                _events = res.Value.ToList();
            }
        }
        catch
        {
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VerifyCashAsync(LiveEventOverviewDto ev)
    {
        if (_verifyingId != null) return;
        _verifyingId = ev.EventAppointmentId;
        _actionMessage = null;
        _errorMessage = null;

        try
        {
            var req = new AdminApproveRemittanceModel
            {
                AdminId = ManagerId,
                AdminName = ManagerName,
                Notes = $"Cash verified for Event #{ev.EventAppointmentId} by {ManagerName}."
            };
            var res = await ConsultationApi.VerifyCashSettlementAsync(ev.EventAppointmentId, req);
            if (res.IsSuccess)
            {
                ScheduleService.InvalidateCache();
                _actionMessage = $"Cash verified for #{ev.EventAppointmentId} ({ev.EventName}). Employee workflow finalized as Complete.";
                await RefreshAsync();
                if (OnCashVerified.HasDelegate)
                {
                    await OnCashVerified.InvokeAsync();
                }
            }
            else
            {
                _errorMessage = res.Error?.Message ?? "Could not verify cash settlement.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _verifyingId = null;
        }
    }

    private int GetStageCount(string tab)
    {
        if (tab == "All") return _events.Count;
        if (tab == "Preparation")
            return _events.Count(e => string.Equals(e.DisplayStage, "Preparation", StringComparison.OrdinalIgnoreCase)
                                   || string.Equals(e.DisplayStage, "Dispatch", StringComparison.OrdinalIgnoreCase));
        return _events.Count(e => string.Equals(e.DisplayStage, tab, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetStageBadgeClass(string stage) => stage switch
    {
        "Complete" => "bg-emerald-100 text-emerald-800 border border-emerald-200",
        "Paid Cash Pending Verification" => "bg-amber-100 text-amber-950 border border-amber-300",
        "Post Event" => "bg-purple-100 text-purple-800 border border-purple-200",
        "Ongoing" => "bg-teal-100 text-teal-800 border border-teal-200",
        "Dispatch" => "bg-indigo-100 text-indigo-800 border border-indigo-200",
        "Preparation" => "bg-sky-100 text-sky-800 border border-sky-200",
        _ => "bg-slate-100 text-slate-700 border border-slate-200"
    };

    private static string GetStepState(string currentStage, string step)
    {
        int currentRank = currentStage switch
        {
            "Preparation" or "Dispatch" => 1,
            "Ongoing" => 2,
            "Post Event" => 3,
            "Paid Cash Pending Verification" => 4,
            "Complete" => 5,
            _ => 0
        };
        int stepRank = step switch
        {
            "Preparation" => 1,
            "Ongoing" => 2,
            "Post Event" => 3,
            "Paid Cash Pending Verification" => 4,
            "Complete" => 5,
            _ => 0
        };

        if (currentRank == 5) return "done";
        if (stepRank < currentRank) return "done";
        if (stepRank == currentRank)
        {
            return currentRank == 4 ? "active-amber" : "active";
        }
        return "pending";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
