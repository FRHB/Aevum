    private string ResolveQrConfirmUrl(string referenceId)
    {
        var configuredBase = Config["BaseUrl"]?.Trim();
        var effectiveBase = (!string.IsNullOrWhiteSpace(configuredBase) &&
                             !configuredBase.Contains("localhost", StringComparison.OrdinalIgnoreCase) &&
                             !configuredBase.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase))
            ? configuredBase
            : (Nav.BaseUri.Contains("localhost", StringComparison.OrdinalIgnoreCase) || Nav.BaseUri.Contains("127.0.0.1", StringComparison.OrdinalIgnoreCase)
                ? (string.IsNullOrWhiteSpace(configuredBase) ? Nav.BaseUri : configuredBase)
                : Nav.BaseUri);
        return QrPaymentLinks.BuildConfirmUrl(effectiveBase, Nav.BaseUri, referenceId);
    }

    private static string BuildQrSvg(string payload)
    {
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(payload, QRCodeGenerator.ECCLevel.M);
        return new SvgQRCode(data).GetGraphic(
            5,
            System.Drawing.Color.Black,
            System.Drawing.Color.White,
            drawQuietZones: true,
            sizingMode: SvgQRCode.SizingMode.ViewBoxAttribute);
    }

    private static string GetStageDisplayLabel(
        TeamLeaderEventDto ev,
        bool isCompletedSuccess,
        bool isCashPendingVerif,
        bool isQrPending,
        bool isQrPaid,
        bool isDispatched,
        bool isOngoing,
        bool isPostEvent,
        bool isUpcoming)
    {
        if (isCompletedSuccess) return isQrPaid ? "Success • QR Paid" : "Success • Completed";
        if (isCashPendingVerif) return "Payment Verification (Cash)";
        if (isQrPending) return "Payment Verification (QR:Pending Payment)";
        if (isPostEvent) return "Post Event";
        if (isOngoing) return "On Going";
        if (isDispatched) return "Dispatched";
        if (isUpcoming) return "Booked (Upcoming)";
        return "Preparation";
    }
