    private async Task ConfirmDispatchedAsync(TeamLeaderEventDto ev)
    {
        if (!ev.IsTeamLeader) return;
        var blocked = ev.AssignedEquipment.FirstOrDefault(eq => EquipmentItemModel.IsUnavailableStatus(eq.EquipmentStatus));
        if (blocked != null)
        {
            _localError = $"Cannot confirm dispatch: '{blocked.EquipmentName}' is currently '{blocked.EquipmentStatus}'. Schedule a replacement first.";
            return;
        }
        if (ev.AssignedEmployees.Count >= 2)
        {
            var unverifiedCrew = ev.AssignedEmployees.Count(c => !c.IsVerified || string.Equals(c.DutyStatus, "Absent", StringComparison.OrdinalIgnoreCase));
            var pendingRep = ev.CrewReplacementRequests.Count(r => string.Equals(r.Status, "Pending", StringComparison.OrdinalIgnoreCase));
            if (unverifiedCrew > 0 || pendingRep > 0)
            {
                _localError = "Crew verification required: verify all assigned crew members are on duty and resolve any pending replacement requests before confirming Dispatched.";
                return;
            }
        }
        _isBusy = true;
        _localSuccess = null;
        _localError = null;
        try
        {
            var res = await ConsultationApi.MarkEquipmentTakenAsync(ev.EventAppointmentId, new MarkEquipmentTakenRequest
            {
                EventEquipmentIds = null,
                IsTaken = true,
                TransitionToDispatch = true,
                EmployeeId = EmployeeId
            });
            if (res.IsSuccess && res.Value != null)
            {
                if (!string.Equals(res.Value.EventStatus, "Dispatch", StringComparison.OrdinalIgnoreCase))
                {
                    var stageRes = await ConsultationApi.UpdateTeamLeaderEventStatusAsync(ev.EventAppointmentId, new UpdateTeamLeaderStatusRequest
                    {
                        Status = "Dispatch",
                        EmployeeId = EmployeeId
                    });
                    if (!stageRes.IsSuccess)
                    {
                        _localError = stageRes.Error?.Message ?? "Failed to transition to Dispatched.";
                        return;
                    }
                }
                ScheduleService.InvalidateCache();
                EquipmentService.NotifyStateChanged();
                _localSuccess = $"Equipment & Crew Dispatched confirmed for #{ev.EventAppointmentId}. Status updated across the system.";
                await OnWorkflowUpdated.InvokeAsync();
            }
            else
            {
                _localError = res.Error?.Message ?? "Failed to confirm dispatch.";
            }
        }
        catch (Exception ex)
        {
            _localError = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

