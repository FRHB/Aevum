@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col bg-[#FAF9F6] text-slate-900 selection:bg-gray-200 selection:text-black">
    <main class="flex-grow">
        @Body
    </main>

    <footer id="contact" class="bg-black text-white pt-24 pb-12 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
                <div class="col-span-1 lg:col-span-2">
                   <div class="flex items-center mb-6">
                     <a href="/" class="flex items-center group">
                         <img src="images/AevumLogo.jpg" alt="Photo Aevum Logo" class="h-10 w-auto rounded-full transition-transform group-hover:scale-105" />
                         <span class="font-bold text-xl tracking-tight uppercase tracking-widest text-white ml-4">Photo Aevum Studio</span>
                     </a>
                   </div>
                    <p class="text-gray-400 text-sm mb-8 max-w-sm font-light leading-relaxed">
                        A modern photography studio dedicated to capturing compelling visual narratives for individuals and brands.
                    </p>
                    <div class="flex space-x-6">
                        <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="Instagram">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                            </svg>
                        </a>
                        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="Twitter">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                            </svg>
                        </a>
                        <a href="https://www.facebook.com/profile.php?id=100095100746143" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="Facebook">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.97h-1.513c-1.491 0-1.956.93-1.956 1.883v2.272h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
                            </svg>
                        </a>
                    </div>
                </div>
                <!--Studio Footer-->
                <div>
                    <h4 class="font-medium text-white mb-6 uppercase tracking-wider text-sm">Studio</h4>
                    <ul class="space-y-4 text-sm text-gray-400 font-light">
                        <li><a href="/#services" class="hover:text-white transition-colors">Services &amp; Pricing</a></li>
                        <li><a href="/#portfolio" class="hover:text-white transition-colors">Portfolio</a></li>
                        <li><a href="/#home" class="hover:text-white transition-colors">About</a></li>
                        <li><a href="/#faq" class="hover:text-white transition-colors">FAQ</a></li>
                    </ul>
                </div>
                <!--Contact Footer-->
                <div>
                    <h4 class="font-medium text-white mb-6 uppercase tracking-wider text-sm">Contact</h4>
                    <ul class="space-y-4 text-sm text-gray-400 font-light">
                        <li class="flex items-center gap-3 group">
                            <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                                </svg>
                            </div>
                            <a href="mailto:photoaevumstudio@gmail.com" class="hover:text-white transition-colors font-normal">photoaevumstudio@gmail.com</a>
                        </li>
                        <li class="flex items-center gap-3 group">
                            <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                </svg>
                            </div>
                            <span class="font-normal">(+63) 919-578-93124</span>
                        </li>
                        <li class="flex items-center gap-3 group">
                            <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.97h-1.513c-1.491 0-1.956.93-1.956 1.883v2.272h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
                                </svg>
                            </div>
                            <a href="https://www.facebook.com/profile.php?id=100095100746143"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="hover:text-white transition-colors font-normal">
                                Photo Aevum Studio
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-xs text-gray-500 uppercase tracking-widest">&copy; 2026 Photo Aevum Studio. All rights reserved.</p>
                <div class="flex gap-6 text-xs text-gray-500 uppercase tracking-widest">
                    <NavLink href="/privacy" class="hover:text-white transition-colors" Match="NavLinkMatch.All">Privacy Policy</NavLink>
                    <a href="/terms" @onclick="OpenTermsModal" @onclick:preventDefault class="hover:text-white transition-colors cursor-pointer">Terms &amp; Conditions</a>
                </div>
            </div>
        </div>
    </footer>

    @* ── Interactive Terms and Conditions Modal Dialog Overlay ──────────────── *@
    <TermsModal @bind-IsOpen="isTermsOpen" OnAgree="HandleTermsAgreed" />
</div>

@code {
    private bool isTermsOpen = false;

    private void OpenTermsModal()
    {
        isTermsOpen = true;
    }

    private void CloseTermsModal()
    {
        isTermsOpen = false;
    }

    private void HandleTermsAgreed()
    {
        isTermsOpen = false;
    }
}
