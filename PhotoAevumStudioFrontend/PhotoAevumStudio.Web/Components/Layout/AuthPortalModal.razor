@* =====================================================================
   AuthPortalModal.razor  –  Customer Account Creation Modal
   
   Manages the 3-step customer registration wizard:
   - Step 1: Account Info (Name, Phone, Email) & Terms + Privacy
   - Step 2: Email Verification Code
   - Step 3: Password  →  commits registration & returns to /login

   ACID Compliance Notes:
   ──────────────────────
   Atomicity   – Each wizard step is individually validated; the final
                 RegisterCustomerWithResultAsync call is the single atomic
                 commit. No partial records are written until all steps complete.
   Consistency – DataAnnotation validators on every field prevent invalid
                 state from advancing to the next step.
   Isolation   – All state is scoped to this component instance; concurrent
                 sessions cannot observe in-progress registration.
   Durability  – Durability is guaranteed by the backend API (HTTP POST to
                 /api/auth/register). The UI side clears all in-memory state
                 on success so a crash cannot re-submit.
   ===================================================================== *@

@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager Nav

@if (IsVisible)
{
    @* ── Backdrop ──────────────────────────────────────────────────── *@
    <div class="apm-backdrop" @onclick="Close" aria-hidden="true"></div>

    @* ── Modal panel ───────────────────────────────────────────────── *@
    <div class="apm-panel" role="dialog" aria-modal="true" aria-labelledby="apm-title">

        @* ── Close button ─────────────────────────────────────────── *@
        <button class="apm-close" @onclick="Close" aria-label="Close">✕</button>

        @* ── Logo ─────────────────────────────────────────────────── *@
        <div class="apm-brand">
            <img src="images/AevumLogo.jpg" alt="Aevum Studio" class="apm-logo" />
            <span class="apm-brand-name">Photo Aevum Studio</span>
        </div>

        @* ════════════════════════════════════════════════════════════
           Sign-Up Wizard  (3 steps)
           Step 1 – Account Info (First, Last, Middle Name, Phone, Email) & Terms + Privacy
           Step 2 – Email Verification Code
           Step 3 – Password  →  commits registration & returns to /login
           ═══════════════════════════════════════════════════════════ *@
        @if (_signUpStep > 1)
        {
            <button class="apm-back" @onclick="SignUpBack" aria-label="Back">‹ Back</button>
        }
        <h2 id="apm-title" class="apm-title">Create Account</h2>

        @* ── Stepper ─────────────────────────────────────────── *@
        <ol class="apm-stepper" aria-label="Registration steps">
            @for (int i = 1; i <= 3; i++)
            {
                var step = i; // capture for closure
                <li class="apm-stepper__item @(step == _signUpStep ? "is-current" : step < _signUpStep ? "is-done" : "")">
                    <span class="apm-stepper__dot">@(step < _signUpStep ? "✓" : step.ToString())</span>
                    <span class="apm-stepper__label">
                        @switch (step)
                        {
                            case 1: <text>Account</text> break;
                            case 2: <text>Verify</text> break;
                            case 3: <text>Password</text> break;
                        }
                    </span>
                </li>
            }
        </ol>

            @* ── Step 1: Personal Info, Contact, Email & Legal Agreements ───────────────────── *@
            @if (_signUpStep == 1)
            {
                <EditForm Model="_suDetails" OnValidSubmit="HandleStep1Submit">
                    <DataAnnotationsValidator />

                    <div class="apm-field">
                        <label for="su-first">First Name <span class="apm-required">*</span></label>
                        <InputText id="su-first" class="apm-input" @bind-Value="_suDetails.FirstName"
                                   placeholder="e.g. Maria" autocomplete="given-name" />
                        <ValidationMessage For="() => _suDetails.FirstName" class="apm-validation" />
                    </div>

                    <div class="apm-field">
                        <label for="su-last">Last Name <span class="apm-required">*</span></label>
                        <InputText id="su-last" class="apm-input" @bind-Value="_suDetails.LastName"
                                   placeholder="e.g. Santos" autocomplete="family-name" />
                        <ValidationMessage For="() => _suDetails.LastName" class="apm-validation" />
                    </div>

                    <div class="apm-field">
                        <label for="su-mid">
                            Middle Name
                            <span class="apm-optional">(optional)</span>
                        </label>
                        <InputText id="su-mid" class="apm-input" @bind-Value="_suDetails.MiddleName"
                                   placeholder="e.g. Reyes" autocomplete="additional-name" />
                        <ValidationMessage For="() => _suDetails.MiddleName" class="apm-validation" />
                    </div>

                    <div class="apm-field">
                        <label for="su-phone">Cellphone No. <span class="apm-required">*</span></label>
                        <InputText id="su-phone" class="apm-input" @bind-Value="_suDetails.PhoneNumber"
                                   placeholder="e.g. 09123456789" autocomplete="tel"
                                   maxlength="11" inputmode="numeric"
                                   @oninput="OnPhoneInput" />
                        <ValidationMessage For="() => _suDetails.PhoneNumber" class="apm-validation" />
                    </div>

                    <div class="apm-field">
                        <label for="su-email">Email Address <span class="apm-required">*</span></label>
                        <InputText id="su-email" type="email" class="apm-input" @bind-Value="_suDetails.Email"
                                   placeholder="you@example.com" autocomplete="email" />
                        <ValidationMessage For="() => _suDetails.Email" class="apm-validation" />
                    </div>

                    @if (!string.IsNullOrEmpty(_suEmailError))
                    {
                        <div class="apm-error" role="alert">@_suEmailError</div>
                    }

                    <div class="apm-legal-group">
                        @* Terms & Conditions Row (clicking row opens modal; only checks upon modal agree) *@
                        <div class="apm-checkbox-row cursor-pointer" @onclick="OpenTermsModal">
                            <div class="apm-checkbox-visual @(_suDetails.AgreeToTerms ? "is-checked" : "")">
                                @if (_suDetails.AgreeToTerms)
                                {
                                    <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                }
                            </div>
                            <span class="text-xs text-gray-700 leading-snug select-none">
                                I agree to the <span class="underline font-semibold text-black">Terms &amp; Conditions</span> <span class="apm-required">*</span>
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(_step1TermsError))
                        {
                            <div class="apm-validation">@_step1TermsError</div>
                        }

                        @* Privacy Policy Row (clicking row opens modal; only checks upon modal agree) *@
                        <div class="apm-checkbox-row cursor-pointer mt-2" @onclick="OpenPrivacyModal">
                            <div class="apm-checkbox-visual @(_suDetails.AgreeToPrivacy ? "is-checked" : "")">
                                @if (_suDetails.AgreeToPrivacy)
                                {
                                    <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                }
                            </div>
                            <span class="text-xs text-gray-700 leading-snug select-none">
                                I agree to the <span class="underline font-semibold text-black">Privacy Policy</span> <span class="apm-required">*</span>
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(_step1PrivacyError))
                        {
                            <div class="apm-validation">@_step1PrivacyError</div>
                        }
                    </div>

                    <button type="submit" class="apm-btn apm-btn--primary" disabled="@(!_suDetails.AgreeToTerms || !_suDetails.AgreeToPrivacy || _isBusy)">
                        @if (_isBusy) { <span>Sending verification code…</span> } else { <span>Continue</span> }
                    </button>
                </EditForm>
            }

            @* ── Step 2: Verify Email ──────────────────────────────────── *@
            @if (_signUpStep == 2)
            {
                <EditForm Model="_suVerify" OnValidSubmit="HandleVerifyCode">
                    <DataAnnotationsValidator />

                    <p class="apm-subtitle">
                        A 6-digit code was sent to <strong>@_suDetails.Email</strong>. Enter it below to verify your email address.
                    </p>

                    <div class="apm-field">
                        <label for="su-code">Verification Code <span class="apm-required">*</span></label>
                        <InputText id="su-code" class="apm-input apm-input--code" @bind-Value="_suVerify.Code"
                                   placeholder="· · · · · ·" maxlength="6" autocomplete="one-time-code"
                                   inputmode="numeric" />
                        <ValidationMessage For="() => _suVerify.Code" class="apm-validation" />
                    </div>

                    @if (!string.IsNullOrEmpty(_suVerifyError))
                    {
                        <div class="apm-error" role="alert">@_suVerifyError</div>
                    }

                    <button type="submit" class="apm-btn apm-btn--primary" disabled="@_isBusy">
                        @if (_isBusy) { <span>Verifying…</span> } else { <span>Verify Code</span> }
                    </button>

                    <button type="button" class="apm-link apm-link--center" @onclick="HandleResendVerification" disabled="@_isBusy">
                        Didn't receive it? Resend code
                    </button>
                </EditForm>
            }

            @* ── Step 3: Password & Commit Registration ─────────────────── *@
            @if (_signUpStep == 3)
            {
                <EditForm Model="_suPassword" OnValidSubmit="HandleSignUp">
                    <DataAnnotationsValidator />

                    <p class="apm-subtitle">Almost done! Set a strong password for your account.</p>

                    @if (!string.IsNullOrEmpty(_suSignUpError))
                    {
                        <div class="apm-error" role="alert">@_suSignUpError</div>
                    }

                    <div class="apm-field">
                        <label for="su-pw">Password <span class="apm-required">*</span></label>
                        <div class="apm-input-wrap">
                            <InputText id="su-pw" type="@(_showSignUpPw ? "text" : "password")"
                                       class="apm-input" @bind-Value="_suPassword.Password"
                                       @oninput='e => _suPassword.Password = e.Value?.ToString() ?? string.Empty'
                                       maxlength="30"
                                       placeholder="8–30 characters" autocomplete="new-password" />
                            <button type="button" class="apm-pw-toggle"
                                    @onclick='() => _showSignUpPw = !_showSignUpPw'
                                    aria-label="@(_showSignUpPw ? "Hide password" : "Show password")"
                                    title="@(_showSignUpPw ? "Hide password" : "Show password")">
                                @if (_showSignUpPw)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                                        <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
                                        <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                                        <line x1="2" x2="22" y1="2" y2="22"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                }
                            </button>
                        </div>
                        <PasswordRequirementsChecklist Password="@_suPassword.Password" CssClass="mt-2" />
                        <ValidationMessage For="() => _suPassword.Password" class="apm-validation" />
                    </div>

                    <div class="apm-field">
                        <label for="su-pw2">Confirm Password <span class="apm-required">*</span></label>
                        <div class="apm-input-wrap">
                            <InputText id="su-pw2" type="@(_showSignUpConfirmPw ? "text" : "password")"
                                       class="apm-input" @bind-Value="_suPassword.ConfirmPassword"
                                       maxlength="30"
                                       placeholder="Repeat your password" autocomplete="new-password" />
                            <button type="button" class="apm-pw-toggle"
                                    @onclick='() => _showSignUpConfirmPw = !_showSignUpConfirmPw'
                                    aria-label="@(_showSignUpConfirmPw ? "Hide password" : "Show password")"
                                    title="@(_showSignUpConfirmPw ? "Hide password" : "Show password")">
                                @if (_showSignUpConfirmPw)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                                        <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
                                        <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                                        <line x1="2" x2="22" y1="2" y2="22"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="() => _suPassword.ConfirmPassword" class="apm-validation" />
                    </div>

                    <button type="submit" class="apm-btn apm-btn--primary" disabled="@_isBusy">
                        @if (_isBusy) { <span>Creating account…</span> } else { <span>Create Account</span> }
                    </button>
                </EditForm>
            }

    </div>

    <!-- Interactive Terms & Conditions pop-up Modal in front of AuthPortalModal -->
    <TermsModal @bind-IsOpen="_showTermsModal" OnAgree="HandleTermsAgreed" />

    <!-- Interactive Privacy Policy pop-up Modal in front of AuthPortalModal -->
    <PrivacyModal @bind-IsOpen="_showPrivacyModal" OnAgree="HandlePrivacyAgreed" />
}

@code {
    // ── Visibility (controlled by parent) ───────────────────────────────────
    [Parameter] public bool IsVisible     { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnRegistered { get; set; }

    private bool _wasVisible = false;
    private bool _isBusy     = false;
    private bool _showSignUpPw = false;
    private bool _showSignUpConfirmPw = false;
    private bool _showTermsModal = false;
    private bool _showPrivacyModal = false;

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            ResetSignUpForms();
            _signUpStep = 1;
        }
        _wasVisible = IsVisible;
    }

    private void OpenTermsModal() => _showTermsModal = true;
    private void OpenPrivacyModal() => _showPrivacyModal = true;

    private void HandleTermsAgreed()
    {
        _suDetails.AgreeToTerms = true;
        _step1TermsError = string.Empty;
        _showTermsModal = false;
        StateHasChanged();
    }

    private void HandlePrivacyAgreed()
    {
        _suDetails.AgreeToPrivacy = true;
        _step1PrivacyError = string.Empty;
        _showPrivacyModal = false;
        StateHasChanged();
    }

    // ── Sign-Up wizard state  (ACID: all in-memory until final commit) ───────
    private int                _signUpStep        = 1;
    private SignUpDetailsForm  _suDetails         = new();
    private SignUpVerifyForm   _suVerify          = new();
    private SignUpPwForm       _suPassword        = new();
    private string             _suEmailError      = string.Empty;
    private string             _suVerifyError     = string.Empty;
    private string             _suSignUpError     = string.Empty;
    private string             _step1TermsError   = string.Empty;
    private string             _step1PrivacyError = string.Empty;

    private async Task HandleStep1Submit()
    {
        _step1TermsError = string.Empty;
        _step1PrivacyError = string.Empty;
        _suEmailError = string.Empty;

        if (!_suDetails.AgreeToTerms)
        {
            _step1TermsError = "You must review and agree to the Terms & Conditions to proceed.";
        }
        if (!_suDetails.AgreeToPrivacy)
        {
            _step1PrivacyError = "You must review and agree to the Privacy Policy to proceed.";
        }

        if (!_suDetails.AgreeToTerms || !_suDetails.AgreeToPrivacy)
        {
            return;
        }

        _isBusy = true;
        StateHasChanged();

        if (await AuthService.IsEmailInUseAsync(_suDetails.Email.Trim().ToLowerInvariant()))
        {
            _suEmailError = "This email address is already registered under another account role. Please use a different email.";
            _isBusy = false;
            return;
        }

        try
        {
            var (ok, error) = await AuthService.RequestVerificationCodeAsync(_suDetails.Email.Trim().ToLowerInvariant());
            if (ok)
            {
                _suVerify = new();
                _signUpStep = 2;
            }
            else
            {
                _suEmailError = error ?? "Could not send verification email. Please check your address.";
            }
        }
        catch
        {
            _suEmailError = "Could not send verification email. Please try again.";
        }

        _isBusy = false;
    }

    private void SignUpBack()
    {
        if (_signUpStep > 1)
            _signUpStep--;
    }

    private void Close()
    {
        ResetSignUpForms();
        _signUpStep = 1;
        _ = OnClose.InvokeAsync();
    }

    // ── Sign-Up Step 2: Resend verification code ─────────────────────────────
    private async Task HandleResendVerification()
    {
        _suVerifyError = string.Empty;
        _isBusy        = true;
        StateHasChanged();

        try
        {
            var ok = await AuthService.SendVerificationCodeAsync(_suDetails.Email.Trim().ToLowerInvariant());
            if (!ok)
            {
                _suVerifyError = "Could not resend verification email. Please try again.";
            }
        }
        catch
        {
            _suVerifyError = "Could not resend verification email. Please try again.";
        }

        _isBusy = false;
    }

    // ── Sign-Up Step 2: Verify code ──────────────────────────────────────────
    // ACID Isolation: code checked with backend cache; no DB write yet.
    private async Task HandleVerifyCode()
    {
        _suVerifyError = string.Empty;
        _isBusy        = true;
        StateHasChanged();

        try
        {
            var ok = await AuthService.VerifyCodeAsync(_suDetails.Email.Trim().ToLowerInvariant(), _suVerify.Code.Trim());
            if (ok)
            {
                _signUpStep = 3;
            }
            else
            {
                _suVerifyError = "That code doesn't match or has expired. Please try again or request a new one.";
            }
        }
        catch
        {
            _suVerifyError = "Could not verify code. Please try again.";
        }

        _isBusy = false;
    }

    // ── Sign-Up Step 3: Commit registration ─────────────────────────────────
    // ACID Atomicity: single RegisterCustomerAsync call. If it fails, nothing is written.
    // ACID Consistency: all fields validated before this is reached.
    // ACID Durability: backend persists the new user record.
    private async Task HandleSignUp()
    {
        _suSignUpError = string.Empty;
        _isBusy        = true;
        StateHasChanged();

        if (!_suDetails.AgreeToTerms || !_suDetails.AgreeToPrivacy)
        {
            _suSignUpError = "You must agree to both the Terms & Conditions and Privacy Policy to create an account.";
            _isBusy = false;
            return;
        }

        var policyError = PasswordPolicyHelper.GetValidationError(_suPassword.Password);
        if (policyError is not null)
        {
            _suSignUpError = policyError;
            _isBusy = false;
            return;
        }

        if (_suPassword.Password != _suPassword.ConfirmPassword)
        {
            _suSignUpError = "Passwords do not match.";
            _isBusy = false;
            return;
        }

        var customerPayload = new
        {
            FirstName = _suDetails.FirstName.Trim(),
            LastName = _suDetails.LastName.Trim(),
            MiddleName = string.IsNullOrWhiteSpace(_suDetails.MiddleName) ? null : _suDetails.MiddleName.Trim(),
            PhoneNumber = _suDetails.PhoneNumber.Trim(),
            Email = _suDetails.Email.Trim().ToLowerInvariant(),
            Password = _suPassword.Password,
            VerificationCode = _suVerify.Code.Trim()
        };

        try
        {
            var result = await AuthService.RegisterCustomerWithResultAsync(customerPayload);
            if (result.Success)
            {
                var registeredEmail = _suDetails.Email.Trim();
                ResetSignUpForms();
                _signUpStep = 1;

                if (OnRegistered.HasDelegate)
                {
                    await OnRegistered.InvokeAsync(registeredEmail);
                }

                await OnClose.InvokeAsync();
                Nav.NavigateTo("/login");
            }
            else
            {
                _suSignUpError = result.Error ?? "Registration failed. Verification code may be invalid or email already registered.";
            }
        }
        catch
        {
            _suSignUpError = "A server error occurred. Please try again.";
        }

        _isBusy = false;
    }

    // ── Phone input masking ─────────────────────────────────────────────────
    private void OnPhoneInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var digits = new string(raw.Where(char.IsDigit).Take(11).ToArray());
        _suDetails.PhoneNumber = digits;
    }

    // ACID: rollback all in-memory wizard state atomically on reset.
    // ── Helpers ─────────────────────────────────────────────────────────────
    private void ResetSignUpForms()
    {
        _suDetails         = new();
        _suVerify          = new();
        _suPassword        = new();
        _suEmailError      = string.Empty;
        _suVerifyError     = string.Empty;
        _suSignUpError     = string.Empty;
        _step1TermsError   = string.Empty;
        _step1PrivacyError = string.Empty;
        _showSignUpPw      = false;
        _showSignUpConfirmPw = false;
    }

    // ── Form models with DataAnnotations ────────────────────────────────────

    private sealed class SignUpDetailsForm
    {
        [Required(ErrorMessage = "First name is required.")]
        [StringLength(50, ErrorMessage = "Maximum 50 characters.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required.")]
        [StringLength(50, ErrorMessage = "Maximum 50 characters.")]
        public string LastName { get; set; } = string.Empty;

        [StringLength(50, ErrorMessage = "Maximum 50 characters.")]
        public string? MiddleName { get; set; }

        private string _phoneNumber = string.Empty;
        [Required(ErrorMessage = "Cellphone number is required.")]
        [RegularExpression(@"^09\d{9}$",
            ErrorMessage = "Cellphone number must be exactly 11 digits starting with 09.")]
        public string PhoneNumber
        {
            get => _phoneNumber;
            set => _phoneNumber = string.IsNullOrWhiteSpace(value)
                ? string.Empty
                : new string(value.Where(char.IsDigit).Take(11).ToArray());
        }

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256)]
        public string Email { get; set; } = string.Empty;

        public bool AgreeToTerms { get; set; }
        public bool AgreeToPrivacy { get; set; }
    }

    private sealed class SignUpVerifyForm
    {
        [Required(ErrorMessage = "Please enter the 6-digit code.")]
        [RegularExpression(@"^\d{6}$", ErrorMessage = "The code must be exactly 6 digits.")]
        public string Code { get; set; } = string.Empty;
    }

    private sealed class SignUpPwForm
    {
        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters long.")]
        [MaxLength(30, ErrorMessage = "Password must not exceed 30 characters.")]
        [RegularExpression(PasswordPolicyHelper.PolicyRegexPattern,
            ErrorMessage = "Password must be 8–30 characters long and contain at least one number (0–9) and one special character (@, #, $, %, &).")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

