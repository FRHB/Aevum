@* =====================================================================
   AuthPortalModal.razor  –  Shared inline auth modal
   
   Manages the full auth flow:
   - View.Chooser        → "Customer Login" / "Admin Login"
   - View.CustomerLogin  → email + password form
   - View.ForgotPassword → email → "code sent" confirmation
   - View.SignUp         → 4-step wizard (Name → Email → Verify → Password)

   ACID Compliance Notes:
   ──────────────────────
   Atomicity   – Each wizard step is individually validated; the final
                 RegisterAsync call is the single atomic commit. No partial
                 records are written until all four pages are complete.
   Consistency – DataAnnotation validators on every field prevent invalid
                 state from advancing to the next step.
   Isolation   – All state is scoped to this component instance; concurrent
                 sessions cannot observe in-progress registration.
   Durability  – Durability is guaranteed by the backend API (the JWT +
                 HTTP POST to /api/auth/register). The UI side clears all
                 in-memory state on success so a crash cannot re-submit.
   ===================================================================== *@

@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

@if (IsVisible)
{
    @* ── Backdrop ──────────────────────────────────────────────────── *@
    <div class="apm-backdrop" @onclick="Close" aria-hidden="true"></div>

    @* ── Modal panel ───────────────────────────────────────────────── *@
    <div class="apm-panel" role="dialog" aria-modal="true" aria-labelledby="apm-title">

        @* ── Close button ─────────────────────────────────────────── *@
        <button class="apm-close" @onclick="Close" aria-label="Close">✕</button>

        @* ── Logo ─────────────────────────────────────────────────── *@
        <div class="apm-brand">
            <img src="images/AevumLogo.jpg" alt="Aevum Studio" class="apm-logo" />
            <span class="apm-brand-name">Photo Aevum Studio</span>
        </div>

        @* ════════════════════════════════════════════════════════════
           VIEW: Chooser
           ═══════════════════════════════════════════════════════════ *@
        @if (_view == ModalView.Chooser)
        {
            <h2 id="apm-title" class="apm-title">Welcome Back</h2>
            <p class="apm-subtitle">How would you like to sign in?</p>

            <div class="apm-chooser-grid">
                <button class="apm-chooser-card" @onclick="GoCustomerLogin">
                    <span class="apm-chooser-icon" aria-hidden="true">👤</span>
                    <span class="apm-chooser-label">Customer Login</span>
                    <span class="apm-chooser-desc">Access your bookings &amp; gallery</span>
                </button>
                <button class="apm-chooser-card" @onclick="GoAdminLogin">
                    <span class="apm-chooser-icon" aria-hidden="true">🔐</span>
                    <span class="apm-chooser-label">Admin / Staff Login</span>
                    <span class="apm-chooser-desc">Studio management portal</span>
                </button>
            </div>
        }

        @* ════════════════════════════════════════════════════════════
           VIEW: Customer Login
           ═══════════════════════════════════════════════════════════ *@
        @if (_view == ModalView.CustomerLogin)
        {
            <button class="apm-back" @onclick="() => _view = ModalView.Chooser" aria-label="Back">‹ Back</button>
            <h2 id="apm-title" class="apm-title">Customer Login</h2>

            @if (!string.IsNullOrEmpty(_loginError))
            {
                <div class="apm-error" role="alert">@_loginError</div>
            }

            <EditForm Model="_loginForm" OnValidSubmit="HandleCustomerLogin">
                <DataAnnotationsValidator />

                <div class="apm-field">
                    <label for="cl-email">Email address</label>
                    <InputText id="cl-email" type="email" class="apm-input" @bind-Value="_loginForm.Email"
                               placeholder="you@example.com" autocomplete="email" />
                    <ValidationMessage For="() => _loginForm.Email" class="apm-validation" />
                </div>

                <div class="apm-field">
                    <label for="cl-password">Password</label>
                    <div class="apm-input-wrap">
                        <InputText id="cl-password" type="@(_showLoginPw ? "text" : "password")"
                                   class="apm-input" @bind-Value="_loginForm.Password"
                                   placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="apm-pw-toggle"
                                @onclick='() => _showLoginPw = !_showLoginPw'
                                aria-label="@(_showLoginPw ? "Hide password" : "Show password")">
                            @(_showLoginPw ? "🙈" : "👁")
                        </button>
                    </div>
                    <ValidationMessage For="() => _loginForm.Password" class="apm-validation" />
                </div>

                <div class="apm-row-between">
                    <button type="button" class="apm-link" @onclick="() => _view = ModalView.ForgotPassword">
                        Forgot password?
                    </button>
                </div>

                <button type="submit" class="apm-btn apm-btn--primary" disabled="@_isBusy">
                    @if (_isBusy) { <span>Signing in…</span> } else { <span>Sign In</span> }
                </button>
            </EditForm>

            <div class="apm-divider"><span>New here?</span></div>
            <button class="apm-btn apm-btn--ghost" @onclick="StartSignUp">
                Create an account
            </button>
        }

        @* ════════════════════════════════════════════════════════════
           VIEW: Forgot Password
           ═══════════════════════════════════════════════════════════ *@
        @if (_view == ModalView.ForgotPassword)
        {
            <button class="apm-back" @onclick="() => _view = ModalView.CustomerLogin" aria-label="Back">‹ Back</button>
            <h2 id="apm-title" class="apm-title">Reset Password</h2>

            @if (_fpSent)
            {
                <div class="apm-success" role="status">
                    <svg class="w-5 h-5 text-emerald-600 shrink-0 inline-block mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    A reset link has been sent to <strong>@_fpForm.Email</strong>.
                    Please check your inbox and follow the instructions.
                </div>
                <button class="apm-btn apm-btn--ghost" @onclick="() => _view = ModalView.CustomerLogin">
                    Back to Login
                </button>
            }
            else
            {
                <p class="apm-subtitle">Enter the email address associated with your account and we'll send you a link to reset your password.</p>

                @if (!string.IsNullOrEmpty(_fpError))
                {
                    <div class="apm-error" role="alert">@_fpError</div>
                }

                <EditForm Model="_fpForm" OnValidSubmit="HandleForgotPassword">
                    <DataAnnotationsValidator />

                    <div class="apm-field">
                        <label for="fp-email">Email address</label>
                        <InputText id="fp-email" type="email" class="apm-input" @bind-Value="_fpForm.Email"
                                   placeholder="you@example.com" autocomplete="email" />
                        <ValidationMessage For="() => _fpForm.Email" class="apm-validation" />
                    </div>

                    <button type="submit" class="apm-btn apm-btn--primary" disabled="@_isBusy">
                        @if (_isBusy) { <span>Sending…</span> } else { <span>Send Reset Link</span> }
                    </button>
                </EditForm>
            }
        }

        @* ════════════════════════════════════════════════════════════
           VIEW: Sign-Up Wizard  (4 steps)
           Step 1 – Personal Info (First, Last, Middle Name)
           Step 2 – Email
           Step 3 – Email Verification Code
           Step 4 – Password  →  commits registration
           ═══════════════════════════════════════════════════════════ *@
        @if (_view == ModalView.SignUp)
        {
            <button class="apm-back" @onclick="SignUpBack" aria-label="Back">‹ Back</button>
            <h2 id="apm-title" class="apm-title">Create Account</h2>

            @* ── Stepper ─────────────────────────────────────────── *@
            <ol class="apm-stepper" aria-label="Registration steps">
                @for (int i = 1; i <= 4; i++)
                {
                    var step = i; // capture for closure
                    <li class="apm-stepper__item @(step == _signUpStep ? "is-current" : step < _signUpStep ? "is-done" : "")">
                        <span class="apm-stepper__dot">@(step < _signUpStep ? "✓" : step.ToString())</span>
                        <span class="apm-stepper__label">
                            @switch (step)
                            {
                                case 1: <text>Name</text> break;
                                case 2: <text>Email</text> break;
                                case 3: <text>Verify</text> break;
                                case 4: <text>Password</text> break;
                            }
                        </span>
                    </li>
                }
            </ol>

            @* ── Step 1: Name, Contact & Legal ───────────────────── *@
            @if (_signUpStep == 1)
            {
                <EditForm Model="_suName" OnValidSubmit="HandleStep1Submit">
                    <DataAnnotationsValidator />

                    <div class="apm-field">
                        <label for="su-first">First Name <span class="apm-required">*</span></label>
                        <InputText id="su-first" class="apm-input" @bind-Value="_suName.FirstName"
                                   placeholder="e.g. Maria" autocomplete="given-name" />
                        <ValidationMessage For="() => _suName.FirstName" class="apm-validation" />
                    </div>

                    <div class="apm-field">
                        <label for="su-last">Last Name <span class="apm-required">*</span></label>
                        <InputText id="su-last" class="apm-input" @bind-Value="_suName.LastName"
                                   placeholder="e.g. Santos" autocomplete="family-name" />
                        <ValidationMessage For="() => _suName.LastName" class="apm-validation" />
                    </div>

                    <div class="apm-field">
                        <label for="su-mid">
                            Middle Name
                            <span class="apm-optional">(optional)</span>
                        </label>
                        <InputText id="su-mid" class="apm-input" @bind-Value="_suName.MiddleName"
                                   placeholder="e.g. Reyes" autocomplete="additional-name" />
                    </div>

                    <div class="apm-field">
                        <label for="su-phone">
                            Cellphone No.
                            <span class="apm-optional">(optional)</span>
                        </label>
                        <InputText id="su-phone" class="apm-input" @bind-Value="_suName.PhoneNumber"
                                   placeholder="e.g. 09123456789 or +63 912 345 6789" autocomplete="tel" />
                        <ValidationMessage For="() => _suName.PhoneNumber" class="apm-validation" />
                    </div>

                    <div class="apm-legal-group">
                        <label class="apm-checkbox-label">
                            <InputCheckbox @bind-Value="_suName.AgreeToTerms" class="apm-checkbox" />
                            <span>I agree to the <a href="/terms" target="_blank" rel="noopener noreferrer" class="apm-link apm-link--inline">Terms &amp; Conditions</a> <span class="apm-required">*</span></span>
                        </label>
                        <ValidationMessage For="() => _suName.AgreeToTerms" class="apm-validation" />
                        @if (!string.IsNullOrEmpty(_step1TermsError))
                        {
                            <div class="apm-validation">@_step1TermsError</div>
                        }

                        <label class="apm-checkbox-label">
                            <InputCheckbox @bind-Value="_suName.AgreeToPrivacy" class="apm-checkbox" />
                            <span>I agree to the <a href="/privacy" target="_blank" rel="noopener noreferrer" class="apm-link apm-link--inline">Privacy Policy</a> <span class="apm-required">*</span></span>
                        </label>
                        <ValidationMessage For="() => _suName.AgreeToPrivacy" class="apm-validation" />
                        @if (!string.IsNullOrEmpty(_step1PrivacyError))
                        {
                            <div class="apm-validation">@_step1PrivacyError</div>
                        }
                    </div>

                    <button type="submit" class="apm-btn apm-btn--primary" disabled="@(!_suName.AgreeToTerms || !_suName.AgreeToPrivacy)">Continue</button>
                </EditForm>
            }

            @* ── Step 2: Email ───────────────────────────────────── *@
            @if (_signUpStep == 2)
            {
                <EditForm Model="_suEmail" OnValidSubmit="HandleSendVerification">
                    <DataAnnotationsValidator />

                    <p class="apm-subtitle">
                        Hi <strong>@_suName.FirstName</strong>! Enter the email address you'd like to use for your account.
                    </p>

                    <div class="apm-field">
                        <label for="su-email">Email address <span class="apm-required">*</span></label>
                        <InputText id="su-email" type="email" class="apm-input" @bind-Value="_suEmail.Email"
                                   placeholder="you@example.com" autocomplete="email" />
                        <ValidationMessage For="() => _suEmail.Email" class="apm-validation" />
                    </div>

                    @if (!string.IsNullOrEmpty(_suEmailError))
                    {
                        <div class="apm-error" role="alert">@_suEmailError</div>
                    }

                    <button type="submit" class="apm-btn apm-btn--primary" disabled="@_isBusy">
                        @if (_isBusy) { <span>Sending code…</span> } else { <span>Send Verification Code</span> }
                    </button>
                </EditForm>
            }

            @* ── Step 3: Verify ──────────────────────────────────── *@
            @if (_signUpStep == 3)
            {
                <EditForm Model="_suVerify" OnValidSubmit="HandleVerifyCode">
                    <DataAnnotationsValidator />

                    <p class="apm-subtitle">
                        A 6-digit code was sent to <strong>@_suEmail.Email</strong>. Enter it below to verify your email address.
                    </p>

                    <div class="apm-field">
                        <label for="su-code">Verification Code <span class="apm-required">*</span></label>
                        <InputText id="su-code" class="apm-input apm-input--code" @bind-Value="_suVerify.Code"
                                   placeholder="· · · · · ·" maxlength="6" autocomplete="one-time-code"
                                   inputmode="numeric" />
                        <ValidationMessage For="() => _suVerify.Code" class="apm-validation" />
                    </div>

                    @if (!string.IsNullOrEmpty(_suVerifyError))
                    {
                        <div class="apm-error" role="alert">@_suVerifyError</div>
                    }

                    <button type="submit" class="apm-btn apm-btn--primary" disabled="@_isBusy">
                        @if (_isBusy) { <span>Verifying…</span> } else { <span>Verify Code</span> }
                    </button>

                    <button type="button" class="apm-link apm-link--center" @onclick="HandleSendVerification" disabled="@_isBusy">
                        Didn't receive it? Resend
                    </button>
                </EditForm>
            }

            @* ── Step 4: Password  ───────────────────────────────── *@
            @if (_signUpStep == 4)
            {
                <EditForm Model="_suPassword" OnValidSubmit="HandleSignUp">
                    <DataAnnotationsValidator />

                    <p class="apm-subtitle">Almost done! Set a strong password for your account.</p>

                    @if (!string.IsNullOrEmpty(_suSignUpError))
                    {
                        <div class="apm-error" role="alert">@_suSignUpError</div>
                    }

                    <div class="apm-field">
                        <label for="su-pw">Password <span class="apm-required">*</span></label>
                        <div class="apm-input-wrap">
                            <InputText id="su-pw" type="@(_showSignUpPw ? "text" : "password")"
                                       class="apm-input" @bind-Value="_suPassword.Password"
                                       placeholder="Min. 8 characters" autocomplete="new-password" />
                            <button type="button" class="apm-pw-toggle"
                                    @onclick='() => _showSignUpPw = !_showSignUpPw'
                                    aria-label="Toggle password visibility">
                                @(_showSignUpPw ? "🙈" : "👁")
                            </button>
                        </div>
                        <ValidationMessage For="() => _suPassword.Password" class="apm-validation" />
                    </div>

                    <div class="apm-field">
                        <label for="su-pw2">Confirm Password <span class="apm-required">*</span></label>
                        <div class="apm-input-wrap">
                            <InputText id="su-pw2" type="@(_showSignUpPw ? "text" : "password")"
                                       class="apm-input" @bind-Value="_suPassword.ConfirmPassword"
                                       placeholder="Repeat your password" autocomplete="new-password" />
                        </div>
                        <ValidationMessage For="() => _suPassword.ConfirmPassword" class="apm-validation" />
                    </div>

                    <button type="submit" class="apm-btn apm-btn--primary" disabled="@_isBusy">
                        @if (_isBusy) { <span>Creating account…</span> } else { <span>Create Account</span> }
                    </button>
                </EditForm>
            }

            @* ── Step 5 (post-success): Welcome ─────────────────── *@
            @if (_signUpStep == 5)
            {
                <div class="apm-success" role="status">
                    <span class="apm-success__icon" aria-hidden="true">🎉</span>
                    <strong>Account created!</strong>
                    Welcome to Photo Aevum Studio, @_suName.FirstName.
                    You can now log in with your credentials.
                </div>
                <button class="apm-btn apm-btn--primary" @onclick="() => { _view = ModalView.CustomerLogin; _signUpStep = 1; ResetSignUpForms(); }">
                    Go to Login
                </button>
            }
        }

    </div>
}

@code {
    // ── Visibility (controlled by parent) ───────────────────────────────────
    [Parameter] public bool IsVisible     { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    // ── Modal state ─────────────────────────────────────────────────────────
    private enum ModalView { Chooser, CustomerLogin, ForgotPassword, SignUp }
    private ModalView _view = ModalView.Chooser;

    private bool _isBusy       = false;
    private bool _showLoginPw  = false;
    private bool _showSignUpPw = false;

    // ── Customer Login form ─────────────────────────────────────────────────
    private CustomerLoginForm  _loginForm  = new();
    private string             _loginError = string.Empty;

    // ── Forgot Password form ────────────────────────────────────────────────
    private ForgotPasswordForm _fpForm  = new();
    private string             _fpError = string.Empty;
    private bool               _fpSent  = false;

    // ── Sign-Up wizard state  (ACID: all in-memory until final commit) ───────
    private int              _signUpStep  = 1;
    private SignUpNameForm   _suName      = new();
    private SignUpEmailForm  _suEmail     = new();
    private SignUpVerifyForm _suVerify    = new();
    private SignUpPwForm     _suPassword  = new();
    private string           _suEmailError  = string.Empty;
    private string           _suVerifyError = string.Empty;
    private string           _suSignUpError = string.Empty;
    private string           _step1TermsError   = string.Empty;
    private string           _step1PrivacyError = string.Empty;

    // Simulated verification code (replace with real API call)
    private string _expectedCode = string.Empty;

    // ── Navigation helpers ──────────────────────────────────────────────────
    private void GoCustomerLogin() => _view = ModalView.CustomerLogin;

    private void GoAdminLogin()
    {
        // Admin login always uses the dedicated /login page
        Nav.NavigateTo("/login");
        _ = OnClose.InvokeAsync();
    }

    private void StartSignUp()
    {
        ResetSignUpForms();
        _signUpStep = 1;
        _view = ModalView.SignUp;
    }

    private void HandleStep1Submit()
    {
        _step1TermsError = string.Empty;
        _step1PrivacyError = string.Empty;

        if (!_suName.AgreeToTerms)
        {
            _step1TermsError = "You must agree to the Terms & Conditions to proceed.";
        }
        if (!_suName.AgreeToPrivacy)
        {
            _step1PrivacyError = "You must agree to the Privacy Policy to proceed.";
        }

        if (_suName.AgreeToTerms && _suName.AgreeToPrivacy)
        {
            _signUpStep = 2;
        }
    }

    private void SignUpBack()
    {
        if (_signUpStep > 1)
            _signUpStep--;
        else
            _view = ModalView.CustomerLogin;
    }

    private void Close()
    {
        _view = ModalView.Chooser;
        _ = OnClose.InvokeAsync();
    }

    // ── Customer Login ──────────────────────────────────────────────────────
    private async Task HandleCustomerLogin()
    {
        _loginError = string.Empty;
        _isBusy = true;
        StateHasChanged();

        // ACID Atomicity: single AuthService.LoginAsync call — all-or-nothing.
        // If it fails, no state is mutated; the user stays on the login view.
        var result = await AuthService.LoginAsync(_loginForm.Email, _loginForm.Password, CancellationToken.None);

        if (result.RequiresPasswordChange)
        {
            Close();
            Nav.NavigateTo($"/change-password?userId={Uri.EscapeDataString(result.UserId ?? _loginForm.Email)}");
            return;
        }

        if (result.Success)
        {
            // ACID Durability: token is persisted by AevumAuthenticationStateProvider.
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user  = state.User;
            Close();
            if (user.IsInRole("Admin"))        Nav.NavigateTo("/admin");
            else if (user.IsInRole("Employee")) Nav.NavigateTo("/staff");
            else                               Nav.NavigateTo("/my");
        }
        else
        {
            _loginError = result.Error ?? "Invalid email or password. Please try again.";
        }

        _isBusy = false;
    }

    // ── Forgot Password ─────────────────────────────────────────────────────
    private async Task HandleForgotPassword()
    {
        _fpError = string.Empty;
        _isBusy  = true;
        StateHasChanged();

        try
        {
            var ok = await AuthService.ForgotPasswordAsync(_fpForm.Email.Trim().ToLowerInvariant());
            if (ok)
            {
                _fpSent = true;
            }
            else
            {
                _fpError = "Could not send the reset email. Please try again.";
            }
        }
        catch
        {
            _fpError = "Could not send the reset email. Please try again.";
        }

        _isBusy = false;
    }

    // ── Sign-Up Step 2: Send verification code ───────────────────────────────
    // ACID Atomicity: only sends the code; does NOT create the account yet.
    private async Task HandleSendVerification()
    {
        _suEmailError = string.Empty;
        _isBusy       = true;
        StateHasChanged();

        try
        {
            var ok = await AuthService.SendVerificationCodeAsync(_suEmail.Email.Trim().ToLowerInvariant());
            if (ok)
            {
                _suVerify     = new();
                _signUpStep   = 3;
            }
            else
            {
                _suEmailError = "Could not send verification email. Please check your address.";
            }
        }
        catch
        {
            _suEmailError = "Could not send the verification email. Please try again.";
        }

        _isBusy = false;
    }

    // ── Sign-Up Step 3: Verify code ──────────────────────────────────────────
    // ACID Isolation: code checked with backend cache; no DB write yet.
    private async Task HandleVerifyCode()
    {
        _suVerifyError = string.Empty;
        _isBusy        = true;
        StateHasChanged();

        try
        {
            var ok = await AuthService.VerifyCodeAsync(_suEmail.Email.Trim().ToLowerInvariant(), _suVerify.Code.Trim());
            if (ok)
            {
                _signUpStep = 4;
            }
            else
            {
                _suVerifyError = "That code doesn't match or has expired. Please try again or request a new one.";
            }
        }
        catch
        {
            _suVerifyError = "Could not verify code. Please try again.";
        }

        _isBusy = false;
    }

    // ── Sign-Up Step 4: Commit registration ─────────────────────────────────
    // ACID Atomicity: single RegisterCustomerAsync call. If it fails, nothing is written.
    // ACID Consistency: all fields validated before this is reached.
    // ACID Durability: backend persists the new user record.
    private async Task HandleSignUp()
    {
        _suSignUpError = string.Empty;
        _isBusy        = true;
        StateHasChanged();

        if (!_suName.AgreeToTerms || !_suName.AgreeToPrivacy)
        {
            _suSignUpError = "You must agree to both the Terms & Conditions and Privacy Policy to create an account.";
            _isBusy = false;
            return;
        }

        if (_suPassword.Password != _suPassword.ConfirmPassword)
        {
            _suSignUpError = "Passwords do not match.";
            _isBusy = false;
            return;
        }

        var customerPayload = new
        {
            FirstName = _suName.FirstName.Trim(),
            LastName = _suName.LastName.Trim(),
            MiddleName = string.IsNullOrWhiteSpace(_suName.MiddleName) ? null : _suName.MiddleName.Trim(),
            PhoneNumber = string.IsNullOrWhiteSpace(_suName.PhoneNumber) ? null : _suName.PhoneNumber.Trim(),
            Email = _suEmail.Email.Trim().ToLowerInvariant(),
            Password = _suPassword.Password,
            VerificationCode = _suVerify.Code.Trim()
        };

        try
        {
            var ok = await AuthService.RegisterCustomerAsync(customerPayload);
            if (ok)
            {
                // ACID Durability: record committed; clear all in-memory wizard state.
                _signUpStep = 5;
                ResetSignUpForms();
            }
            else
            {
                _suSignUpError = "Registration failed. Verification code may be invalid or email already registered.";
            }
        }
        catch
        {
            _suSignUpError = "A server error occurred. Please try again.";
        }

        _isBusy = false;
    }

    // ── Helpers ─────────────────────────────────────────────────────────────
    // ACID: rollback all in-memory wizard state atomically on reset.
    private void ResetSignUpForms()
    {
        _suName        = new();
        _suEmail       = new();
        _suVerify      = new();
        _suPassword    = new();
        _suEmailError  = string.Empty;
        _suVerifyError = string.Empty;
        _suSignUpError = string.Empty;
        _step1TermsError = string.Empty;
        _step1PrivacyError = string.Empty;
        _expectedCode  = string.Empty;
        _showSignUpPw  = false;
    }

    // ── Form models with DataAnnotations ────────────────────────────────────

    private sealed class CustomerLoginForm
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }

    private sealed class ForgotPasswordForm
    {
        [Required(ErrorMessage = "Please enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }

    private sealed class SignUpNameForm
    {
        [Required(ErrorMessage = "First name is required.")]
        [StringLength(50, ErrorMessage = "Maximum 50 characters.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required.")]
        [StringLength(50, ErrorMessage = "Maximum 50 characters.")]
        public string LastName { get; set; } = string.Empty;

        [StringLength(50, ErrorMessage = "Maximum 50 characters.")]
        public string? MiddleName { get; set; }

        [StringLength(30, ErrorMessage = "Maximum 30 characters.")]
        public string? PhoneNumber { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must agree to the Terms & Conditions to proceed.")]
        public bool AgreeToTerms { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must agree to the Privacy Policy to proceed.")]
        public bool AgreeToPrivacy { get; set; }
    }

    private sealed class SignUpEmailForm
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256)]
        public string Email { get; set; } = string.Empty;
    }

    private sealed class SignUpVerifyForm
    {
        [Required(ErrorMessage = "Please enter the 6-digit code.")]
        [RegularExpression(@"^\d{6}$", ErrorMessage = "The code must be exactly 6 digits.")]
        public string Code { get; set; } = string.Empty;
    }

    private sealed class SignUpPwForm
    {
        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        [RegularExpression(@"^(?=.*[A-Za-z])(?=.*\d).+$",
            ErrorMessage = "Password must contain at least one letter and one number.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

