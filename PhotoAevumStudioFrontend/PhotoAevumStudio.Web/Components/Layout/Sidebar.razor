                        </button>
                        <ul id="acc-emp-employees"
                            class="aev-sidebar__sub @(IsOpen("emp-employees") ? "is-expanded" : "")"
                            aria-hidden="@(!IsOpen("emp-employees"))">
                            <li><NavLink href="/admin/employees" class="aev-sidebar__sub-link" Match="NavLinkMatch.All" ActiveClass="aev-sidebar__link--active">Staff List</NavLink></li>
                            <li><NavLink href="/admin/employees/specialization" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Specialization</NavLink></li>
                        </ul>
                    </li>
                }

                @* Equipment Inventory – collapsible (Full management for Office Clerk/Admin, Read-only for Creatives) *@
                <li>
                    <button class="aev-sidebar__link aev-sidebar__accordion-toggle @(IsOpen("emp-equipment") ? "is-open" : "")"
                            @onclick='() => Toggle("emp-equipment")'
                            aria-expanded="@IsOpen("emp-equipment")"
                            aria-controls="acc-emp-equipment">
                        <span class="aev-sidebar__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                <circle cx="12" cy="13" r="4"></circle>
                            </svg>
                        </span>
                        Equipment Inventory
                        <span class="aev-sidebar__chevron" aria-hidden="true">›</span>
                    </button>
                    <ul id="acc-emp-equipment"
                        class="aev-sidebar__sub @(IsOpen("emp-equipment") ? "is-expanded" : "")"
                        aria-hidden="@(!IsOpen("emp-equipment"))">
                        <li><NavLink href="/admin/equipments" class="aev-sidebar__sub-link" Match="NavLinkMatch.All" ActiveClass="aev-sidebar__link--active">Equipments</NavLink></li>
                        <li><NavLink href="/admin/equipment/dispatch" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Dispatch</NavLink></li>
                        <li><NavLink href="/admin/equipment/maintenance" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Maintenance</NavLink></li>
                        <li><NavLink href="/admin/equipment/types" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Equipment Types</NavLink></li>
                    </ul>
                </li>



            </ul>
        </div>

        @* ── ACCOUNT ─────────────────────────────────────────────────────── *@
        <div class="aev-sidebar__section aev-sidebar__section--footer">
            <p class="aev-sidebar__section-label">Account</p>
            <ul class="aev-sidebar__list">
                <li>
                    <NavLink href="/staff/profile" class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active">
                        <span class="aev-sidebar__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                            </svg>
                        </span>
                        Profile
                    </NavLink>
                </li>
                <li>
                    <button type="button" @onclick="HandleLogoutAsync" class="aev-sidebar__link text-rose-600 hover:text-rose-800" style="background:none;border:none;width:100%;text-align:left;cursor:pointer;">
                        <span class="aev-sidebar__icon" aria-hidden="true">🚪</span>
                        Log Out
                    </button>
                </li>
            </ul>
        </div>
    </text>;
    }

