@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager Nav

@* ── Mobile Hamburger Toggle ──────────────────────────────────────────────── *@
<button type="button"
        class="aev-sidebar__mobile-toggle"
        @onclick="ToggleMobile"
        aria-label="Toggle navigation menu"
        aria-expanded="@_isMobileOpen">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
</button>

@* ── Mobile Drawer Backdrop ───────────────────────────────────────────────── *@
@if (_isMobileOpen)
{
    <div class="aev-sidebar__backdrop" @onclick="() => _isMobileOpen = false" aria-hidden="true"></div>
}

<nav class="aev-sidebar @(_isMobileOpen ? "is-open" : "")" aria-label="Primary navigation">

    @* ── Brand ─────────────────────────────────────────────────────────── *@
    <div class="aev-sidebar__brand">
        <img src="images/AevumLogo.jpg" alt="Photo Aevum" class="aev-sidebar__logo" />
        <span class="aev-sidebar__brand-text">Aevum Studio</span>
        <button type="button"
                class="aev-sidebar__mobile-close"
                @onclick="() => _isMobileOpen = false"
                aria-label="Close sidebar">
            ✕
        </button>
    </div>

    @RenderNav()

</nav>

@code {
    [CascadingParameter] Task<AuthenticationState> AuthState { get; set; } = default!;
    [Parameter] public string UserRole { get; set; } = string.Empty;

    private bool _isMobileOpen;
    private readonly HashSet<string> _openAccordions = new();

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserRole) && AuthState != null)
        {
            var state = await AuthState;
            var roleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role) ?? state.User.FindFirst("role");
            UserRole = roleClaim?.Value?.ToLower() ?? string.Empty;
        }

        if (string.IsNullOrWhiteSpace(UserRole))
        {
            UserRole = "admin";
        }

        AutoExpandActiveAccordion();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _isMobileOpen = false;
        AutoExpandActiveAccordion();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void ToggleMobile()
    {
        _isMobileOpen = !_isMobileOpen;
    }

    private void AutoExpandActiveAccordion()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();

        if (path.StartsWith("admin/schedules") || path.StartsWith("admin/calendar") || path.StartsWith("calendar") || path.StartsWith("staff-schedule") || path.StartsWith("equipment-schedule") || path.StartsWith("equipments-schedule"))
            _openAccordions.Add("calendar");
        else if (path.StartsWith("staff/calendar"))
            _openAccordions.Add("emp-calendar");

        if (path.StartsWith("admin/services") || path.StartsWith("services") || path.StartsWith("main-services") || path.StartsWith("package-services") || path.StartsWith("additional-services"))
        {
            _openAccordions.Add("services");
            _openAccordions.Add("emp-services");
        }
        else if (path.StartsWith("staff/services"))
        {
            _openAccordions.Add("emp-services");
        }

        if (path.StartsWith("admin/employees") || path.StartsWith("employees") || path.StartsWith("specialization"))
            _openAccordions.Add("employees");

        if (path.StartsWith("admin/equipment") || path.StartsWith("equipment") || path.StartsWith("equipments") || path.StartsWith("dispatch") || path.StartsWith("maintenance") || path.StartsWith("equipment-types"))
            _openAccordions.Add("equipment");
    }

    private bool IsOpen(string key) => _openAccordions.Contains(key);

    private void Toggle(string key)
    {
        if (!_openAccordions.Remove(key))
            _openAccordions.Add(key);
    }

    // ── Role dispatcher ──────────────────────────────────────────────────────
    private RenderFragment RenderNav() => UserRole switch
    {
        "admin"    => RenderAdminNav(),
        "employee" => RenderEmployeeNav(),
        "customer" => RenderCustomerNav(),
        _          => RenderAdminNav()
    };

    // ════════════════════════════════════════════════════════════════════════
    // ADMIN nav
    // ════════════════════════════════════════════════════════════════════════
    private RenderFragment RenderAdminNav() =>
    @<text>
        @* ── MANAGEMENT ─────────────────────────────────────────────────── *@
        <div class="aev-sidebar__section">
            <p class="aev-sidebar__section-label">Management</p>
            <ul class="aev-sidebar__list">

                <li>
                    <NavLink href="/admin" Match="NavLinkMatch.All"
                             class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active">
                        <span class="aev-sidebar__icon" aria-hidden="true">⊞</span>
                        Overview
                    </NavLink>
                </li>

                @* Events Calendar – collapsible *@
                <li>
                    <button class="aev-sidebar__link aev-sidebar__accordion-toggle @(IsOpen("calendar") ? "is-open" : "")"
                            @onclick='() => Toggle("calendar")'
                            aria-expanded="@IsOpen("calendar")"
                            aria-controls="acc-calendar">
                        <span class="aev-sidebar__icon" aria-hidden="true">📅</span>
                        Events Calendar
                        <span class="aev-sidebar__chevron" aria-hidden="true">›</span>
                    </button>
                    <ul id="acc-calendar"
                        class="aev-sidebar__sub @(IsOpen("calendar") ? "is-expanded" : "")"
                        aria-hidden="@(!IsOpen("calendar"))">
                        <li><NavLink href="/admin/calendar/events" class="aev-sidebar__sub-link" Match="NavLinkMatch.All" ActiveClass="aev-sidebar__link--active">Calendar of Events</NavLink></li>
                        <li><NavLink href="/admin/calendar/staff" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Staff Schedule</NavLink></li>
                        <li><NavLink href="/admin/calendar/equipment" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Equipments schedule</NavLink></li>
                    </ul>
                </li>

                <li>
                    <NavLink href="/admin/clients" class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active">
                        <span class="aev-sidebar__icon" aria-hidden="true">👥</span>
                        Clients
                    </NavLink>
                </li>

                @* Services – collapsible *@
                <li>
                    <button class="aev-sidebar__link aev-sidebar__accordion-toggle @(IsOpen("services") ? "is-open" : "")"
                            @onclick='() => Toggle("services")'
                            aria-expanded="@IsOpen("services")"
                            aria-controls="acc-services">
                        <span class="aev-sidebar__icon" aria-hidden="true">🗂</span>
                        Services
                        <span class="aev-sidebar__chevron" aria-hidden="true">›</span>
                    </button>
                    <ul id="acc-services"
                        class="aev-sidebar__sub @(IsOpen("services") ? "is-expanded" : "")"
                        aria-hidden="@(!IsOpen("services"))">
                        <li><NavLink href="/admin/services/main" class="aev-sidebar__sub-link" Match="NavLinkMatch.All" ActiveClass="aev-sidebar__link--active">Main Services</NavLink></li>
                        <li><NavLink href="/admin/services/packages" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Package Services</NavLink></li>
                        <li><NavLink href="/admin/services/additional" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Additional Services</NavLink></li>
                    </ul>
                </li>

            </ul>
        </div>

        @* ── RESOURCES & LOGISTICS ──────────────────────────────────────── *@
        <div class="aev-sidebar__section">
            <p class="aev-sidebar__section-label">Resources &amp; Logistics</p>
            <ul class="aev-sidebar__list">

                @* Employees – collapsible *@
                <li>
                    <button class="aev-sidebar__link aev-sidebar__accordion-toggle @(IsOpen("employees") ? "is-open" : "")"
                            @onclick='() => Toggle("employees")'
                            aria-expanded="@IsOpen("employees")"
                            aria-controls="acc-employees">
                        <span class="aev-sidebar__icon" aria-hidden="true">👤</span>
                        Employees
                        <span class="aev-sidebar__chevron" aria-hidden="true">›</span>
                    </button>
                    <ul id="acc-employees"
                        class="aev-sidebar__sub @(IsOpen("employees") ? "is-expanded" : "")"
                        aria-hidden="@(!IsOpen("employees"))">
                        <li><NavLink href="/admin/employees" class="aev-sidebar__sub-link" Match="NavLinkMatch.All" ActiveClass="aev-sidebar__link--active">Staff List</NavLink></li>
                        <li><NavLink href="/admin/employees/specialization" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Specialization</NavLink></li>
                    </ul>
                </li>

                @* Equipment Inventory – collapsible *@
                <li>
                    <button class="aev-sidebar__link aev-sidebar__accordion-toggle @(IsOpen("equipment") ? "is-open" : "")"
                            @onclick='() => Toggle("equipment")'
                            aria-expanded="@IsOpen("equipment")"
                            aria-controls="acc-equipment">
                        <span class="aev-sidebar__icon" aria-hidden="true">📷</span>
                        Equipment Inventory
                        <span class="aev-sidebar__chevron" aria-hidden="true">›</span>
                    </button>
                    <ul id="acc-equipment"
                        class="aev-sidebar__sub @(IsOpen("equipment") ? "is-expanded" : "")"
                        aria-hidden="@(!IsOpen("equipment"))">
                        <li><NavLink href="/admin/equipments" class="aev-sidebar__sub-link" Match="NavLinkMatch.All" ActiveClass="aev-sidebar__link--active">Equipments</NavLink></li>
                        <li><NavLink href="/admin/equipment/dispatch" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Dispatch</NavLink></li>
                        <li><NavLink href="/admin/equipment/maintenance" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Maintenance</NavLink></li>
                        <li><NavLink href="/admin/equipment/types" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Equipment Types</NavLink></li>
                    </ul>
                </li>

            </ul>
        </div>

        @* ── ACCOUNT ─────────────────────────────────────────────────────── *@
        <div class="aev-sidebar__section aev-sidebar__section--footer">
            <p class="aev-sidebar__section-label">Account</p>
            <ul class="aev-sidebar__list">
                <li>
                    <NavLink href="/profile" class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active">
                        <span class="aev-sidebar__icon" aria-hidden="true">⚙</span>
                        Profile
                    </NavLink>
                </li>
            </ul>
        </div>
    </text>;

    // ════════════════════════════════════════════════════════════════════════
    // EMPLOYEE nav
    // ════════════════════════════════════════════════════════════════════════
    private RenderFragment RenderEmployeeNav() =>
    @<text>
        @* ── MANAGEMENT ─────────────────────────────────────────────────── *@
        <div class="aev-sidebar__section">
            <p class="aev-sidebar__section-label">Management</p>
            <ul class="aev-sidebar__list">

                <li>
                    <NavLink href="/staff" Match="NavLinkMatch.All"
                             class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active">
                        <span class="aev-sidebar__icon" aria-hidden="true">⊞</span>
                        Overview
                    </NavLink>
                </li>

                @* Events Calendar – collapsible *@
                <li>
                    <button class="aev-sidebar__link aev-sidebar__accordion-toggle @(IsOpen("emp-calendar") ? "is-open" : "")"
                            @onclick='() => Toggle("emp-calendar")'
                            aria-expanded="@IsOpen("emp-calendar")"
                            aria-controls="acc-emp-calendar">
                        <span class="aev-sidebar__icon" aria-hidden="true">📅</span>
                        Events Calendar
                        <span class="aev-sidebar__chevron" aria-hidden="true">›</span>
                    </button>
                    <ul id="acc-emp-calendar"
                        class="aev-sidebar__sub @(IsOpen("emp-calendar") ? "is-expanded" : "")"
                        aria-hidden="@(!IsOpen("emp-calendar"))">
                        <li><NavLink href="/staff/calendar/master" class="aev-sidebar__sub-link" Match="NavLinkMatch.All" ActiveClass="aev-sidebar__link--active">Calendar of Events</NavLink></li>
                        <li><NavLink href="/staff/calendar/staff" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Staff Schedule</NavLink></li>
                        <li><NavLink href="/staff/calendar/equipment" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Equipments schedule</NavLink></li>
                    </ul>
                </li>

                @* Services – collapsible *@
                <li>
                    <button class="aev-sidebar__link aev-sidebar__accordion-toggle @(IsOpen("emp-services") ? "is-open" : "")"
                            @onclick='() => Toggle("emp-services")'
                            aria-expanded="@IsOpen("emp-services")"
                            aria-controls="acc-emp-services">
                        <span class="aev-sidebar__icon" aria-hidden="true">🗂</span>
                        Services
                        <span class="aev-sidebar__chevron" aria-hidden="true">›</span>
                    </button>
                    <ul id="acc-emp-services"
                        class="aev-sidebar__sub @(IsOpen("emp-services") ? "is-expanded" : "")"
                        aria-hidden="@(!IsOpen("emp-services"))">
                        <li><NavLink href="/staff/services" class="aev-sidebar__sub-link" Match="NavLinkMatch.All" ActiveClass="aev-sidebar__link--active">Main Services</NavLink></li>
                        <li><NavLink href="/staff/services/packages" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Package Services</NavLink></li>
                        <li><NavLink href="/staff/services/additional" class="aev-sidebar__sub-link" ActiveClass="aev-sidebar__link--active">Additional Services</NavLink></li>
                    </ul>
                </li>

            </ul>
        </div>

        @* ── ACCOUNT ─────────────────────────────────────────────────────── *@
        <div class="aev-sidebar__section aev-sidebar__section--footer">
            <p class="aev-sidebar__section-label">Account</p>
            <ul class="aev-sidebar__list">
                <li>
                    <NavLink href="/staff/profile" class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active">
                        <span class="aev-sidebar__icon" aria-hidden="true">⚙</span>
                        Profile
                    </NavLink>
                </li>
            </ul>
        </div>
    </text>;

    // ════════════════════════════════════════════════════════════════════════
    // CUSTOMER nav
    // ════════════════════════════════════════════════════════════════════════
    private RenderFragment RenderCustomerNav() =>
    @<text>
        @* ── DASHBOARD ───────────────────────────────────────────────────── *@
        <div class="aev-sidebar__section">
            <p class="aev-sidebar__section-label">Dashboard</p>
            <ul class="aev-sidebar__list">

                <li>
                    <NavLink href="/my" Match="NavLinkMatch.All"
                             class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active"
                             title="Pending tasks and home screen">
                        <span class="aev-sidebar__icon" aria-hidden="true">⊞</span>
                        Overview
                    </NavLink>
                </li>

                <li>
                    <NavLink href="/my/bookings"
                             class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active"
                             title="View existing and past bookings">
                        <span class="aev-sidebar__icon" aria-hidden="true">📋</span>
                        Appointment
                    </NavLink>
                </li>

                <li>
                    <NavLink href="/my/book"
                             class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active"
                             title="Request a new photography session">
                        <span class="aev-sidebar__icon" aria-hidden="true">➕</span>
                        Book Schedule
                    </NavLink>
                </li>

            </ul>
        </div>

        @* ── ACCOUNT ─────────────────────────────────────────────────────── *@
        <div class="aev-sidebar__section aev-sidebar__section--footer">
            <p class="aev-sidebar__section-label">Account</p>
            <ul class="aev-sidebar__list">
                <li>
                    <NavLink href="/my/profile" class="aev-sidebar__link" ActiveClass="aev-sidebar__link--active">
                        <span class="aev-sidebar__icon" aria-hidden="true">⚙</span>
                        Profile
                    </NavLink>
                </li>
            </ul>
        </div>
    </text>;
}
