        <div class="aev-sidebar__section">
            <p class="aev-sidebar__section-label">Resources &amp; Logistics</p>
            <ul class="aev-sidebar__list">

                @* Employees – collapsible (Visible ONLY to Office Clerk; Hidden for all other specializations) *@
                @if (isClerk)
                {
                    <li>
                        <button class="aev-sidebar__link aev-sidebar__accordion-toggle @(IsOpen("emp-employees") ? "is-open" : "")"
                                @onclick='() => Toggle("emp-employees")'
                                aria-expanded="@IsOpen("emp-employees")"
                                aria-controls="acc-emp-employees">
                            <span class="aev-sidebar__icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
