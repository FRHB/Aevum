@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using PhotoAevumStudio.Web.Services
@implements IDisposable
@inject NavigationManager Nav
@inject IAuthService AuthService
@inject IUserService UserService

@* ── Mobile Hamburger Toggle ──────────────────────────────────────────────── *@
<button type="button"
        class="aev-sidebar__mobile-toggle"
        @onclick="ToggleMobile"
        aria-label="Toggle navigation menu"
        aria-expanded="@_isMobileOpen">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
</button>

@* ── Mobile Drawer Backdrop ───────────────────────────────────────────────── *@
@if (_isMobileOpen)
{
    <div class="aev-sidebar__backdrop" @onclick="() => _isMobileOpen = false" aria-hidden="true"></div>
}

<nav class="aev-sidebar @(_isMobileOpen ? "is-open" : "")" aria-label="Primary navigation">

    @* ── Brand ─────────────────────────────────────────────────────────── *@
    <div class="aev-sidebar__brand">
        <img src="images/AevumLogo.jpg" alt="Photo Aevum" class="aev-sidebar__logo" />
        <span class="aev-sidebar__brand-text">Aevum Studio</span>
        <button type="button"
                class="aev-sidebar__mobile-close"
                @onclick="() => _isMobileOpen = false"
                aria-label="Close sidebar">
            ✕
        </button>
    </div>

    @RenderNav()

</nav>

@code {
    [CascadingParameter] Task<AuthenticationState> AuthState { get; set; } = default!;
    [Parameter] public string UserRole { get; set; } = string.Empty;

    private bool _isMobileOpen;
    private readonly HashSet<string> _openAccordions = new();

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private System.Security.Claims.ClaimsPrincipal? _currentUser;

    public bool IsSystemAdmin => EmployeeRoleHelper.IsSystemAdmin(_currentUser) ||
        (_currentUser == null && ((UserRole ?? "").Trim().Equals("systemadmin", StringComparison.OrdinalIgnoreCase) ||
                                  (UserRole ?? "").Trim().Equals("super admin", StringComparison.OrdinalIgnoreCase)));

    public bool IsAdmin => EmployeeRoleHelper.IsAdmin(_currentUser) ||
        IsSystemAdmin ||
        (_currentUser == null && (UserRole ?? "").Trim().Equals("admin", StringComparison.OrdinalIgnoreCase));

    public bool IsOfficeClerk => EmployeeRoleHelper.IsOfficeClerk(_currentUser, UserService) ||
        (_currentUser == null && ((UserRole ?? "").Trim().Equals("office clerk", StringComparison.OrdinalIgnoreCase) ||
                                  (UserRole ?? "").Trim().Equals("officeclerk", StringComparison.OrdinalIgnoreCase) ||
                                  (UserRole ?? "").Trim().Equals("clerk", StringComparison.OrdinalIgnoreCase)));

    public bool IsPhotographerOrCreative => EmployeeRoleHelper.IsPhotographerOrCreative(_currentUser, UserService);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            _currentUser = state.User;
            if (string.IsNullOrWhiteSpace(UserRole))
            {
                var roleClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role) ?? state.User.FindFirst("role");
                UserRole = roleClaim?.Value?.ToLower() ?? string.Empty;
            }
        }

        if (string.IsNullOrWhiteSpace(UserRole))
        {
            UserRole = "admin";
        }

        AutoExpandActiveAccordion();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _isMobileOpen = false;
        AutoExpandActiveAccordion();
        _ = InvokeAsync(() =>
        {
            try { StateHasChanged(); }
            catch { /* Component or circuit may be disposed during rapid navigation */ }
        });
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void ToggleMobile()
    {
        _isMobileOpen = !_isMobileOpen;
    }

    private void AutoExpandActiveAccordion()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();

        if (path.StartsWith("admin/schedules") || path.StartsWith("admin/calendar") || path.StartsWith("calendar") || path.StartsWith("staff-schedule") || path.StartsWith("equipment-schedule") || path.StartsWith("equipments-schedule"))
            _openAccordions.Add("calendar");
        else if (path.StartsWith("staff/calendar"))
            _openAccordions.Add("emp-calendar");

        if (path.StartsWith("admin/services") || path.StartsWith("services") || path.StartsWith("main-services") || path.StartsWith("package-services") || path.StartsWith("additional-services"))
        {
            _openAccordions.Add("services");
        }
        else if (path.StartsWith("staff/services"))
        {
            _openAccordions.Add("emp-services");
        }

        if (path.StartsWith("admin/employees") || path.StartsWith("admin/staff") || path.StartsWith("admin/admins") || path.StartsWith("admin/admin"))
        {
            _openAccordions.Add("employees");
            _openAccordions.Add("emp-employees");
        }

        if (path.StartsWith("admin/equipments") || path.StartsWith("admin/equipment"))
        {
            _openAccordions.Add("equipment");
            _openAccordions.Add("emp-equipment");
        }

        if (path.StartsWith("admin/history-log"))
        {
            _openAccordions.Add("history");
            _openAccordions.Add("emp-history");
        }

        if (path.StartsWith("admin/portfolio") || path.StartsWith("portfolio"))
        {
            _openAccordions.Add("portfolio");
        }
    }

    private bool IsOpen(string key) => _openAccordions.Contains(key);

    private void Toggle(string key)
    {
        if (!_openAccordions.Remove(key))
            _openAccordions.Add(key);
    }

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private RenderFragment RenderNav()
    {
        var role = (UserRole ?? "").Trim().ToLowerInvariant();
        if (role == "customer" || role == "client" || (_currentUser != null && _currentUser.IsInRole("Customer")))
            return RenderCustomerNav();

        // If the user has an employee or clerk identity, show the dedicated Employee nav
        if (IsOfficeClerk ||
            IsPhotographerOrCreative ||
            (!IsAdmin && !IsSystemAdmin && _currentUser?.Identity?.IsAuthenticated == true) ||
            role == "employee" || role == "staff" || role == "office clerk" || role == "officeclerk" || role == "clerk")
        {
            return RenderEmployeeNav();
        }

        return RenderAdminNav();
    }

